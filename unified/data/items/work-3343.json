s://artworks.thetvdb.com/banners/v4/series/416802/banners/62c75f8dd7a16.jpg"},{"source":"anilist","url":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/145468-eh8hH6SA53Tf.jpg"}]}},"related":[],"linkList":[{"title":"Episodes 1-12","titleKey":"Episodes {{start}}-{{end}}","titleParams":{"start":1,"end":12},"availabilityStatus":"available","episodesLink":"3857|1|12"}]},"episodes":[{"title":"Episodio 1","episodeNumber":1,"sourceEpisodeNumber":1,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"17207","scope":"R","episodeNumbers":[1]},{"provider":"anilist","id":"145468","episodeNumbers":[1]},{"provider":"mal","id":"51092","episodeNumbers":[1]},{"provider":"tmdb_show","id":"158131","scope":"s1","seasonNumber":1,"episodeNumbers":[1]},{"provider":"tvdb_show","id":"416802","scope":"s1","seasonNumber":1,"episodeNumbers":[1]}],"link":"63121","synopsis":"Berry is a girl living in the data-managed city of Tom Sawyer Island. Her hobby at the moment is trying to catch Phantom Zero, who's believed to be behind the cases of Love loss known as the Zero Phenomenon. One day, when she heads into town to get the broken Deco in one of her eyes fixed, Berry runs into a kid who seems like a ghost, due to being unable to be seen with Deco. Suspecting she may have finally found the Phantom, Berry begins her chase.","thumbnail":"https://image.tmdb.org/t/p/w300/2zOoA6I6bfyevnVm6dbny262k4c.jpg","metadataSources":{"tmdb":{"title":"Episodio 1","synopsis":"Berry is a girl living in the data-managed city of Tom Sawyer Island. Her hobby at the moment is trying to catch Phantom Zero, who's believed to be behind the cases of Love loss known as the Zero Phenomenon. One day, when she heads into town to get the broken Deco in one of her eyes fixed, Berry runs into a kid who seems like a ghost, due to being unable to be seen with Deco. Suspecting she may have finally found the Phantom, Berry begins her chase.","thumbnail":"https://image.tmdb.org/t/p/w300/2zOoA6I6bfyevnVm6dbny262k4c.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}},{"title":"Episodio 2","episodeNumber":2,"sourceEpisodeNumber":2,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"17207","scope":"R","episodeNumbers":[2]},{"provider":"anilist","id":"145468","episodeNumbers":[2]},{"provider":"mal","id":"51092","episodeNumbers":[2]},{"provider":"tmdb_show","id":"158131","scope":"s1","seasonNumber":1,"episodeNumbers":[2]},{"provider":"tvdb_show","id":"416802","scope":"s1","seasonNumber":1,"episodeNumbers":[2]}],"link":"63211","synopsis":"Berry and Hack are somehow able to escape from the Hyperverse that Phantom Zero pulled them into. But before long, Hack is apprehended by the customer center, who are investigating the Zero Phenomenon. The next day, Berry wakes up on the veranda of her apartment, and after trying to explain what happened, her friends point out to her that there is no evidence of Zero Phenomenon having occurred, much less of the kid she encountered. Not taking no for an answer, Berry decides to dig up proof behind the Zero Phenomenon.","thumbnail":"https://image.tmdb.org/t/p/w300/adHplpyAuCLFguyy8VRBtWM6PcD.jpg","metadataSources":{"tmdb":{"title":"Episodio 2","synopsis":"Berry and Hack are somehow able to escape from the Hyperverse that Phantom Zero pulled them into. But before long, Hack is apprehended by the customer center, who are investigating the Zero Phenomenon. The next day, Berry wakes up on the veranda of her apartment, and after trying to explain what happened, her friends point out to her that there is no evidence of Zero Phenomenon having occurred, much less of the kid she encountered. Not taking no for an answer, Berry decides to dig up proof behind the Zero Phenomenon.","thumbnail":"https://image.tmdb.org/t/p/w300/adHplpyAuCLFguyy8VRBtWM6PcD.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}},{"title":"Episodio 3","episodeNumber":3,"sourceEpisodeNumber":3,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"17207","scope":"R","episodeNumbers":[3]},{"provider":"anilist","id":"145468","episodeNumbers":[3]},{"provider":"mal","id":"51092","episodeNumbers":[3]},{"provider":"tmdb_show","id":"158131","scope":"s1","seasonNumber":1,"episodeNumbers":[3]},{"provider":"tvdb_show","id":"416802","scope":"s1","seasonNumber":1,"episodeNumbers":[3]}],"link":"63271","synopsis":"Hack is being held at the customer center under suspicion of being Phantom Zero, where she's questioned about the crime of forcibly erasing Love. Meanwhile, Berry learns from the mysterious Finn about how he and his comrades are ghosts, citizens who live in the city despite not being registered. Finn is skeptical that a fellow ghost would have helped Berry, and obtains the data on Phantom Zero from the paper plane device of Hack's that Berry brought.","thumbnail":"https://image.tmdb.org/t/p/w300/jHIaGiSUOqQ0uqDgL5awq5Lud8R.jpg","metadataSources":{"tmdb":{"title":"Episodio 3","synopsis":"Hack is being held at the customer center under suspicion of being Phantom Zero, where she's questioned about the crime of forcibly erasing Love. Meanwhile, Berry learns from the mysterious Finn about how he and his comrades are ghosts, citizens who live in the city despite not being registered. Finn is skeptical that a fellow ghost would have helped Berry, and obtains the data on Phantom Zero from the paper plane device of Hack's that Berry brought.","thumbnail":"https://image.tmdb.org/t/p/w300/jHIaGiSUOqQ0uqDgL5awq5Lud8R.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}},{"title":"Episodio 4","episodeNumber":4,"sourceEpisodeNumber":4,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"17207","scope":"R","episodeNumbers":[4]},{"provider":"anilist","id":"145468","episodeNumbers":[4]},{"provider":"mal","id":"51092","episodeNumbers":[4]},{"provider":"tmdb_show","id":"158131","scope":"s1","seasonNumber":1,"episodeNumbers":[4]},{"provider":"tvdb_show","id":"416802","scope":"s1","seasonNumber":1,"episodeNumbers":[4]}],"link":"63413","synopsis":"Four months have passed since the trial. Berry is now a ghost herself, and has joined the detective club alongside Hack and her friends. They're trying to capture Phantom Zero, and discover the truth behind the Zero Phenomenon. And that's when a certain client approaches them. This man wants them to find his missing daughter. But after a bit of digging, it turns out the missing girl isn't his daughter, but the female avatar that he had been using. Not only that, but the timing of the disappearance seems to have something to do with when Berry and Hack were caught in a Zero Phenomenon incident.","thumbnail":"https://image.tmdb.org/t/p/w300/s4fIci37yGdci4XOqeUNL4GFSWs.jpg","metadataSources":{"tmdb":{"title":"Episodio 4","synopsis":"Four months have passed since the trial. Berry is now a ghost herself, and has joined the detective club alongside Hack and her friends. They're trying to capture Phantom Zero, and discover the truth behind the Zero Phenomenon. And that's when a certain client approaches them. This man wants them to find his missing daughter. But after a bit of digging, it turns out the missing girl isn't his daughter, but the female avatar that he had been using. Not only that, but the timing of the disappearance seems to have something to do with when Berry and Hack were caught in a Zero Phenomenon incident.","thumbnail":"https://image.tmdb.org/t/p/w300/s4fIci37yGdci4XOqeUNL4GFSWs.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}},{"title":"Episodio 5","episodeNumber":5,"sourceEpisodeNumber":5,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"17207","scope":"R","episodeNumbers":[5]},{"provider":"anilist","id":"145468","episodeNumbers":[5]},{"provider":"mal","id":"51092","episodeNumbers":[5]},{"provider":"tmdb_show","id":"158131","scope":"s1","seasonNumber":1,"episodeNumbers":[5]},{"provider":"tvdb_show","id":"416802","scope":"s1","seasonNumber":1,"episodeNumbers":[5]}],"link":"63817","synopsis":"The Ghost Detective Club has a new case. The client is a professor that uses Deco overlays to create artificial animal that he has on display at his Neo Animal Museum. His self-proclaimed masterpiece, the Nue, has an appearance that doesn't match the listing on Decopeedia, and hires the detective club hoping to clear up the confusion. After getting a glimpse at the professor's Nue, it looks nothing like the cute creature whose picture is on the Decopedia page. Even so, the professor insists that his Nue is the accurate version.","thumbnail":"https://image.tmdb.org/t/p/w300/o6RglTjlbpn7hN4X6wuhqhooNVm.jpg","metadataSources":{"tmdb":{"title":"Episodio 5","synopsis":"The Ghost Detective Club has a new case. The client is a professor that uses Deco overlays to create artificial animal that he has on display at his Neo Animal Museum. His self-proclaimed masterpiece, the Nue, has an appearance that doesn't match the listing on Decopeedia, and hires the detective club hoping to clear up the confusion. After getting a glimpse at the professor's Nue, it looks nothing like the cute creature whose picture is on the Decopedia page. Even so, the professor insists that his Nue is the accurate version.","thumbnail":"https://image.tmdb.org/t/p/w300/o6RglTjlbpn7hN4X6wuhqhooNVm.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}},{"title":"Episodio 6","episodeNumber":6,"sourceEpisodeNumber":6,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"17207","scope":"R","episodeNumbers":[6]},{"provider":"anilist","id":"145468","episodeNumbers":[6]},{"provider":"mal","id":"51092","episodeNumbers":[6]},{"provider":"tmdb_show","id":"158131","scope":"s1","seasonNumber":1,"episodeNumbers":[6]},{"provider":"tvdb_show","id":"416802","scope":"s1","seasonNumber":1,"episodeNumbers":[6]}],"link":"64046","synopsis":"A new client has arrived. This time it's an AI drone, named Doron, that Smiley dug out of a garbage pile. With it's memory missing, it asks the club to find it's missing owner. After examining Doron, it becomes apparent that Doron is an illegal drone that isn't registered with the customer center. And on top of that, the only camera data still in their files appears to be of an avatar that is fighting against Phantom Zero.","thumbnail":"https://image.tmdb.org/t/p/w300/3kQrpkpz10QSd3O7Wg0BF5YrYW2.jpg","metadataSources":{"tmdb":{"title":"Episodio 6","synopsis":"A new client has arrived. This time it's an AI drone, named Doron, that Smiley dug out of a garbage pile. With it's memory missing, it asks the club to find it's missing owner. After examining Doron, it becomes apparent that Doron is an illegal drone that isn't registered with the customer center. And on top of that, the only camera data still in their files appears to be of an avatar that is fighting against Phantom Zero.","thumbnail":"https://image.tmdb.org/t/p/w300/3kQrpkpz10QSd3O7Wg0BF5YrYW2.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}},{"title":"Episodio 7","episodeNumber":7,"sourceEpisodeNumber":7,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"17207","scope":"R","episodeNumbers":[7]},{"provider":"anilist","id":"145468","episodeNumbers":[7]},{"provider":"mal","id":"51092","episodeNumbers":[7]},{"provider":"tmdb_show","id":"158131","scope":"s1","seasonNumber":1,"episodeNumbers":[7]},{"provider":"tvdb_show","id":"416802","scope":"s1","seasonNumber":1,"episodeNumbers":[7]}],"link":"64210","synopsis":"Berry catches wind of a ramen cart that nobody knows the location of. In order to find it, Watson begins checking rumors from all across the island. Berry suggests that the detective club search for the cart, but the other members aren't interested. As Berry and Watson investigate the rumors, Watson receives a tip on the location of the cart. In pursuit of ramen, Hack, Berry, and Watson set out to find it.","thumbnail":"https://image.tmdb.org/t/p/w300/kFRP0ICTZLNaylSceEDriwGVkQm.jpg","metadataSources":{"tmdb":{"title":"Episodio 7","synopsis":"Berry catches wind of a ramen cart that nobody knows the location of. In order to find it, Watson begins checking rumors from all across the island. Berry suggests that the detective club search for the cart, but the other members aren't interested. As Berry and Watson investigate the rumors, Watson receives a tip on the location of the cart. In pursuit of ramen, Hack, Berry, and Watson set out to find it.","thumbnail":"https://image.tmdb.org/t/p/w300/kFRP0ICTZLNaylSceEDriwGVkQm.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}},{"title":"Episodio 8","episodeNumber":8,"sourceEpisodeNumber":8,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"17207","scope":"R","episodeNumbers":[8]},{"provider":"anilist","id":"145468","episodeNumbers":[8]},{"provider":"mal","id":"51092","episodeNumbers":[8]},{"provider":"tmdb_show","id":"158131","scope":"s1","seasonNumber":1,"episodeNumbers":[8]},{"provider":"tvdb_show","id":"416802","scope":"s1","seasonNumber":1,"episodeNumbers":[8]}],"link":"64534","synopsis":"Berry is helping Hank sort through the junk that he has salvaged at the harbor when they encounter an old friend of Hank's, named Will, who informs them about an older model of satellite that's expected to crash down into the nearby sea. Back at the agency, the peacock feather-like circuit that Watson received from Analytica is being analyzed. When Hank returns, he insists that they all head to the area Will tipped them off about.","thumbnail":"https://image.tmdb.org/t/p/w300/noijC8OVzIxnxgfy0b382v0Rf68.jpg","metadataSources":{"tmdb":{"title":"Episodio 8","synopsis":"Berry is helping Hank sort through the junk that he has salvaged at the harbor when they encounter an old friend of Hank's, named Will, who informs them about an older model of satellite that's expected to crash down into the nearby sea. Back at the agency, the peacock feather-like circuit that Watson received from Analytica is being analyzed. When Hank returns, he insists that they all head to the area Will tipped them off about.","thumbnail":"https://image.tmdb.org/t/p/w300/noijC8OVzIxnxgfy0b382v0Rf68.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}},{"title":"Episodio 9","episodeNumber":9,"sourceEpisodeNumber":9,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"17207","scope":"R","episodeNumbers":[9]},{"provider":"anilist","id":"145468","episodeNumbers":[9]},{"provider":"mal","id":"51092","episodeNumbers":[9]},{"provider":"tmdb_show","id":"158131","scope":"s1","seasonNumber":1,"episodeNumbers":[9]},{"provider":"tvdb_show","id":"416802","scope":"s1","seasonNumber":1,"episodeNumbers":[9]}],"link":"64672","synopsis":"When Finn was young, his family lived in a slum where garbage tended to be dumped. One day, his brother brings him an older model of Deco that should be easier for Finn to use due to his Deco-Sickness. With it, Finn accidentally discovers that the local purification systems are broken. Believing this is what has caused his home to become polluted, he uses the Deco that he got from his brother to request that the customer center fix the purification system. But because he isn't registered as a citizen, his login is flagged as illegal, which leads to his request not being answered.","thumbnail":"https://image.tmdb.org/t/p/w300/oRtFseWYgrqeMCOfTBP2uzrEqBx.jpg","metadataSources":{"tmdb":{"title":"Episodio 9","synopsis":"When Finn was young, his family lived in a slum where garbage tended to be dumped. One day, his brother brings him an older model of Deco that should be easier for Finn to use due to his Deco-Sickness. With it, Finn accidentally discovers that the local purification systems are broken. Believing this is what has caused his home to become polluted, he uses the Deco that he got from his brother to request that the customer center fix the purification system. But because he isn't registered as a citizen, his login is flagged as illegal, which leads to his request not being answered.","thumbnail":"https://image.tmdb.org/t/p/w300/oRtFseWYgrqeMCOfTBP2uzrEqBx.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}},{"title":"Episodio 10","episodeNumber":10,"sourceEpisodeNumber":10,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"17207","scope":"R","episodeNumbers":[10]},{"provider":"anilist","id":"145468","episodeNumbers":[10]},{"provider":"mal","id":"51092","episodeNumbers":[10]},{"provider":"tmdb_show","id":"158131","scope":"s1","seasonNumber":1,"episodeNumbers":[10]},{"provider":"tvdb_show","id":"416802","scope":"s1","seasonNumber":1,"episodeNumbers":[10]}],"link":"65037","synopsis":"After being suspected of being Phantom Zero, Berry and the club use Deco disguises in order to escape. Meanwhile, the customer center is in a frenzy, thanks to reports of Phantom Zero that they're receiving from all over the place. They dispatch a search team to the slums. Finn and the detective club take shelter in one of Finn's secret hideouts, with Finn stating the only way they can clear their names is to head to the mysterious location known as Mark Twain, and apprehend the true Phantom Zero.","thumbnail":"https://image.tmdb.org/t/p/w300/dG9I2Spznm04CDwKh3E6sTjq8z8.jpg","metadataSources":{"tmdb":{"title":"Episodio 10","synopsis":"After being suspected of being Phantom Zero, Berry and the club use Deco disguises in order to escape. Meanwhile, the customer center is in a frenzy, thanks to reports of Phantom Zero that they're receiving from all over the place. They dispatch a search team to the slums. Finn and the detective club take shelter in one of Finn's secret hideouts, with Finn stating the only way they can clear their names is to head to the mysterious location known as Mark Twain, and apprehend the true Phantom Zero.","thumbnail":"https://image.tmdb.org/t/p/w300/dG9I2Spznm04CDwKh3E6sTjq8z8.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}},{"title":"Episodio 11","episodeNumber":11,"sourceEpisodeNumber":11,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"17207","scope":"R","ep