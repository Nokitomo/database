{"id":"work-3343","sourceIds":{"anilist":145468,"mal":51092},"info":{"title":"Yurei Deco","synopsis":"La storia inizia quando Berry, una ragazza normalissima, incontra Hack, una ragazza dall'aspetto molto mascolino che la introduce nel \"Ghost Detectives Club\". Mentre lavora con il gruppo, la protagonista viene a sapere di Zero, un personaggio misterioso che si nasconde nella metropolitana di Tom Sawyer. Lei e Hack decidono di inseguire questa figura per scoprire la verità su ciò che accade nella loro città...","image":"https://image.tmdb.org/t/p/original/8UF0lYS4DCVZaqc6eiBBFjCOFag.jpg","poster":"https://image.tmdb.org/t/p/original/oNfXL2jZBZCuSjrdHoDlBWOLCpa.jpg","logo":"https://image.tmdb.org/t/p/original/sPLmXLxiWuxR4IzcNguIEKykW5x.svg","background":"https://image.tmdb.org/t/p/original/8UF0lYS4DCVZaqc6eiBBFjCOFag.jpg","trailers":["https://www.youtube.com/watch?v=7zmib6hyua8"],"imdbId":"","type":"series","tags":["TV","Terminato","Estate","2022"],"tagKeys":{"TV":"TV","Terminato":"Completed","Estate":"Summer"},"genres":["Mystery","Sci-fi"],"rating":"7.1","studio":"Science SARU","episodesCount":12,"extra":{"ids":{"malId":51092,"anilistId":145468,"crunchyId":null,"disneyId":null,"netflixId":null,"primeId":null,"anilistIds":[145468],"malIds":[51092],"anidbIds":[17207],"imdbMovieIds":[],"imdbShowIds":[],"tmdbMovieIds":[],"tmdbShowIds":[158131],"tvdbMovieIds":[],"tvdbShowIds":[416802]},"stats":{"scoreRaw":"7.14","favorites":2,"members":95,"views":12970,"episodesCountRaw":12,"episodesLength":24},"flags":{"dub":0,"alwaysHome":1},"meta":{"day":"Domenica","season":"Estate","status":"Terminato","type":"TV","createdAt":"2022-07-03 18:26:59","userId":2},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-30T07:57:40Z","sourceDescriptors":["anilist:145468","mal:51092"],"targets":[{"provider":"anidb","id":"17207","scope":"R","ranges":{"1-12":"1-12"}},{"provider":"anilist","id":"145468","ranges":{"1-12":"1-12"}},{"provider":"mal","id":"51092","rang