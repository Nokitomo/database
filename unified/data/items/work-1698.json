3680/posters/5f8977cd06d37.jpg"},{"source":"provider","url":"https://img.animeunity.co/anime/bx112293-UXFSGOfRbBe8.png"},{"source":"cinemeta","url":"https://live.metahub.space/poster/small/tt11428682/img"},{"source":"anizip","url":"https://artworks.thetvdb.com/banners/series/373680/posters/5f89774ab4943.jpg"},{"source":"anilist","url":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/large/bx112293-UXFSGOfRbBe8.png"}],"background":[{"source":"tmdb","url":"https://image.tmdb.org/t/p/original/5B61yRuWToi6DCQhnohwSU6WUp.jpg"},{"source":"cinemeta","url":"https://live.metahub.space/background/medium/tt11428682/img"},{"source":"tvdb","url":"https://artworks.thetvdb.com/banners/series/373680/backgrounds/5f88d84e0457f.jpg"},{"source":"anizip","url":"https://artworks.thetvdb.com/banners/series/373680/backgrounds/62033787.jpg"},{"source":"provider","url":"https://img.animeunity.co/anime/112293-dgnTgHiXyAIc.jpg"},{"source":"anilist","url":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/112293-dgnTgHiXyAIc.jpg"}]}},"related":[],"linkList":[{"title":"Episodes 1-12","titleKey":"Episodes {{start}}-{{end}}","titleParams":{"start":1,"end":12},"availabilityStatus":"available","episodesLink":"1997|1|12"}]},"episodes":[{"title":"Episodio 1","episodeNumber":1,"sourceEpisodeNumber":1,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"15121","scope":"R","episodeNumbers":[1]},{"provider":"anilist","id":"112293","episodeNumbers":[1]},{"provider":"mal","id":"40483","episodeNumbers":[1]},{"provider":"tmdb_show","id":"96150","scope":"s1","seasonNumber":1,"episodeNumbers":[1]},{"provider":"tvdb_show","id":"373680","scope":"s1","seasonNumber":1,"episodeNumbers":[1]}],"link":"36299","synopsis":"I'm Mazama Jin. I just started at Seton Academy this spring. There, I met a sweet, pure, beautiful girl named Hino Hitomi-san. We immediately hit it off and started a cooking club, where we spend every day coming up with new recipes together. Could this be a rehearsal for our future?! That's the healthy, fulfilling school life... that I would be living right now if this wasn't a school for animals.","thumbnail":"https://image.tmdb.org/t/p/w300/pTMsLA19w8a59LpbVZKYqBBXIbL.jpg","metadataSources":{"tmdb":{"title":"Episodio 1","synopsis":"I'm Mazama Jin. I just started at Seton Academy this spring. There, I met a sweet, pure, beautiful girl named Hino Hitomi-san. We immediately hit it off and started a cooking club, where we spend every day coming up with new recipes together. Could this be a rehearsal for our future?! That's the healthy, fulfilling school life... that I would be living right now if this wasn't a school for animals.","thumbnail":"https://image.tmdb.org/t/p/w300/pTMsLA19w8a59LpbVZKYqBBXIbL.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}},{"title":"Episodio 2","episodeNumber":2,"sourceEpisodeNumber":2,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"15121","scope":"R","episodeNumbers":[2]},{"provider":"anilist","id":"112293","episodeNumbers":[2]},{"provider":"mal","id":"40483","episodeNumbers":[2]},{"provider":"tmdb_show","id":"96150","scope":"s1","seasonNumber":1,"episodeNumbers":[2]},{"provider":"tvdb_show","id":"373680","scope":"s1","seasonNumber":1,"episodeNumbers":[2]}],"link":"36486","synopsis":"I'm Mazama Jin. I just started at Seton Academy this year. The cooking club I started up with Hitomi-chan can't stay alive with only two members, so we got some awesome friends to join us, and they're taking a club entrance test so they can help support the two of us. We're living out our own romantic comedy surrounded by our unique friends! Or... that's how it would be if they weren't a dumb dog, a dumb koala, a dumb sloth, and a dumb cat.","thumbnail":"https://image.tmdb.org/t/p/w300/oGnZf4xghpCpYJdkvZNX34aBsB4.jpg","metadataSources":{"tmdb":{"title":"Episodio 2","synopsis":"I'm Mazama Jin. I just started at Seton Academy this year. The cooking club I started up with Hitomi-chan can't stay alive with only two members, so we got some awesome friends to join us, and they're taking a club entrance test so they can help support the two of us. We're living out our own romantic comedy surrounded by our unique friends! Or... that's how it would be if they weren't a dumb dog, a dumb koala, a dumb sloth, and a dumb cat.","thumbnail":"https://image.tmdb.org/t/p/w300/oGnZf4xghpCpYJdkvZNX34aBsB4.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}},{"title":"Episodio 3","episodeNumber":3,"sourceEpisodeNumber":3,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"15121","scope":"R","episodeNumbers":[3]},{"provider":"anilist","id":"112293","episodeNumbers":[3]},{"provider":"mal","id":"40483","episodeNumbers":[3]},{"provider":"tmdb_show","id":"96150","scope":"s1","seasonNumber":1,"episodeNumbers":[3]},{"provider":"tvdb_show","id":"373680","scope":"s1","seasonNumber":1,"episodeNumbers":[3]}],"link":"36750","synopsis":"I'm Mazama Jin, a first-year at Secon Academy. It's been nothing but smooth sailing in the cooking club I started with my beloved Hitomi-chan, and all kinds of rumors have been going around about what we do there! Will this draw in some more new members? Right after I asked that, two unfamiliar students showed up for a surprising reason! An exciting incident is in store for me and Hitomi-chan! Or... that's what would've happened if those two students weren't a dumb lion and a dumb naked mole-rat.","thumbnail":"https://image.tmdb.org/t/p/w300/zxp5li7lkjaUFdR1XvGqJ1FHllG.jpg","metadataSources":{"tmdb":{"title":"Episodio 3","synopsis":"I'm Mazama Jin, a first-year at Secon Academy. It's been nothing but smooth sailing in the cooking club I started with my beloved Hitomi-chan, and all kinds of rumors have been going around about what we do there! Will this draw in some more new members? Right after I asked that, two unfamiliar students showed up for a surprising reason! An exciting incident is in store for me and Hitomi-chan! Or... that's what would've happened if those two students weren't a dumb lion and a dumb naked mole-rat.","thumbnail":"https://image.tmdb.org/t/p/w300/zxp5li7lkjaUFdR1XvGqJ1FHllG.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}},{"title":"Episodio 4","episodeNumber":4,"sourceEpisodeNumber":4,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"15121","scope":"R","episodeNumbers":[4]},{"provider":"anilist","id":"112293","episodeNumbers":[4]},{"provider":"mal","id":"40483","episodeNumbers":[4]},{"provider":"tmdb_show","id":"96150","scope":"s1","seasonNumber":1,"episodeNumbers":[4]},{"provider":"tvdb_show","id":"373680","scope":"s1","seasonNumber":1,"episodeNumbers":[4]}],"link":"37023","synopsis":"Mazama Jin here. I go to school at Seton Academy, and right now, my happening high school life with Hitomi-chan is being threatened with violence! Everyone wants to be strong. I get that. So I told them this: true strength comes not from scaring people, but from loving them. Yep, just like Hitomi-chan and me. At least... I might have been able to say that, if the ones being violent weren't a stupid hyena and a stupid giant dog.","thumbnail":"https://image.tmdb.org/t/p/w300/18rgps5mE02W0612p0EjSun1RG0.jpg","metadataSources":{"tmdb":{"title":"Episodio 4","synopsis":"Mazama Jin here. I go to school at Seton Academy, and right now, my happening high school life with Hitomi-chan is being threatened with violence! Everyone wants to be strong. I get that. So I told them this: true strength comes not from scaring people, but from loving them. Yep, just like Hitomi-chan and me. At least... I might have been able to say that, if the ones being violent weren't a stupid hyena and a stupid giant dog.","thumbnail":"https://image.tmdb.org/t/p/w300/18rgps5mE02W0612p0EjSun1RG0.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}},{"title":"Episodio 5","episodeNumber":5,"sourceEpisodeNumber":5,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"15121","scope":"R","episodeNumbers":[5]},{"provider":"anilist","id":"112293","episodeNumbers":[5]},{"provider":"mal","id":"40483","episodeNumbers":[5]},{"provider":"tmdb_show","id":"96150","scope":"s1","seasonNumber":1,"episodeNumbers":[5]},{"provider":"tvdb_show","id":"373680","scope":"s1","seasonNumber":1,"episodeNumbers":[5]}],"link":"37079","synopsis":"Mazama Jin here. I'm slowly growing accustomed to Seton Academy. It's Field Day, and I'll be running... toward the shining future that awaits the two of us. For me, there's only one goal to run toward, and that's Hitomi-chan. Yes, it's only natural to think that just running isn't enough. I'm no fool. But I can't stop. I'd never last if I did. Because... this is the stupid animals' Field Day.","thumbnail":"https://image.tmdb.org/t/p/w300/zaB9A19wMU8E31rUtUxRjfG2i8v.jpg","metadataSources":{"tmdb":{"title":"Episodio 5","synopsis":"Mazama Jin here. I'm slowly growing accustomed to Seton Academy. It's Field Day, and I'll be running... toward the shining future that awaits the two of us. For me, there's only one goal to run toward, and that's Hitomi-chan. Yes, it's only natural to think that just running isn't enough. I'm no fool. But I can't stop. I'd never last if I did. Because... this is the stupid animals' Field Day.","thumbnail":"https://image.tmdb.org/t/p/w300/zaB9A19wMU8E31rUtUxRjfG2i8v.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}},{"title":"Episodio 6","episodeNumber":6,"sourceEpisodeNumber":6,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"15121","scope":"R","episodeNumbers":[6]},{"provider":"anilist","id":"112293","episodeNumbers":[6]},{"provider":"mal","id":"40483","episodeNumbers":[6]},{"provider":"tmdb_show","id":"96150","scope":"s1","seasonNumber":1,"episodeNumbers":[6]},{"provider":"tvdb_show","id":"373680","scope":"s1","seasonNumber":1,"episodeNumbers":[6]}],"link":"37248","synopsis":"Mazama Jin here. I've been attending Seton Academy for a few months now. Popular people exist everywhere. We may get sick of them sometimes, but there's always a reason for their popularity. We should not feel inferior or envious, but learn what we can from them and emulate the qualities worth emulating. As for me, I'm going to grow as a person for Hitomi-chan's sake. Or... maybe I could've seen it that way if the new popular person wasn't that stupid panda.","thumbnail":"https://image.tmdb.org/t/p/w300/59SNIPSsJF1uLKcKrbsE94Wriem.jpg","metadataSources":{"tmdb":{"title":"Episodio 6","synopsis":"Mazama Jin here. I've been attending Seton Academy for a few months now. Popular people exist everywhere. We may get sick of them sometimes, but there's always a reason for their popularity. We should not feel inferior or envious, but learn what we can from them and emulate the qualities worth emulating. As for me, I'm going to grow as a person for Hitomi-chan's sake. Or... maybe I could've seen it that way if the new popular person wasn't that stupid panda.","thumbnail":"https://image.tmdb.org/t/p/w300/59SNIPSsJF1uLKcKrbsE94Wriem.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}},{"title":"Episodio 7","episodeNumber":7,"sourceEpisodeNumber":7,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"15121","scope":"R","episodeNumbers":[7]},{"provider":"anilist","id":"112293","episodeNumbers":[7]},{"provider":"mal","id":"40483","episodeNumbers":[7]},{"provider":"tmdb_show","id":"96150","scope":"s1","seasonNumber":1,"episodeNumbers":[7]},{"provider":"tvdb_show","id":"373680","scope":"s1","seasonNumber":1,"episodeNumbers":[7]}],"link":"37526","synopsis":"Mazama Jin here. The fact that I'm starting to get used to Seton Academy frightens me. What does it mean to be masculine or feminine? I just want to face Hitomi-chan as I am, without worrying about all that! With strong feelings and an unyielding heart, you can overcome any barrier! Or so I'd like to say, but somehow it's just annoying. Probably because the ones trying to overcome barriers are a stupid hyena and a stupid honey badger.","thumbnail":"https://image.tmdb.org/t/p/w300/wTIdRRMLJFx7BUdhPKBwe0PNZNr.jpg","metadataSources":{"tmdb":{"title":"Episodio 7","synopsis":"Mazama Jin here. The fact that I'm starting to get used to Seton Academy frightens me. What does it mean to be masculine or feminine? I just want to face Hitomi-chan as I am, without worrying about all that! With strong feelings and an unyielding heart, you can overcome any barrier! Or so I'd like to say, but somehow it's just annoying. Probably because the ones trying to overcome barriers are a stupid hyena and a stupid honey badger.","thumbnail":"https://image.tmdb.org/t/p/w300/wTIdRRMLJFx7BUdhPKBwe0PNZNr.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}},{"title":"Episodio 8","episodeNumber":8,"sourceEpisodeNumber":8,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"15121","scope":"R","episodeNumbers":[8]},{"provider":"anilist","id":"112293","episodeNumbers":[8]},{"provider":"mal","id":"40483","episodeNumbers":[8]},{"provider":"tmdb_show","id":"96150","scope":"s1","seasonNumber":1,"episodeNumbers":[8]},{"provider":"tvdb_show","id":"373680","scope":"s1","seasonNumber":1,"episodeNumbers":[8]}],"link":"37687","synopsis":"Mazama Jin here. Seton Academy has a campus by the sea. Just try to picture it: blue sea, white clouds... and the one you care about most by your side. In my case, of course, that's Hitomi-chan. And in Hitomi-chan's case, it's me. I think. Look! The sea creatures are giving us their blessing with a beautiful performance! Maybe I could have immersed myself in that feeling... if the ones performing weren't a stupid beluga whale and a stupid bottlenose dolphin.","thumbnail":"https://image.tmdb.org/t/p/w300/ufDi7cqBKgAlY61h3U6wX7Sq20j.jpg","metadataSources":{"tmdb":{"title":"Episodio 8","synopsis":"Mazama Jin here. Seton Academy has a campus by the sea. Just try to picture it: blue sea, white clouds... and the one you care about most by your side. In my case, of course, that's Hitomi-chan. And in Hitomi-chan's case, it's me. I think. Look! The sea creatures are giving us their blessing with a beautiful performance! Maybe I could have immersed myself in that feeling... if the ones performing weren't a stupid beluga whale and a stupid bottlenose dolphin.","thumbnail":"https://image.tmdb.org/t/p/w300/ufDi7cqBKgAlY61h3U6wX7Sq20j.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}},{"title":"Episodio 9","episodeNumber":9,"sourceEpisodeNumber":9,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"15121","scope":"R","episodeNumbers":[9]},{"provider":"anilist","id":"112293","episodeNumbers":[9]},{"provider":"mal","id":"40483","episodeNumbers":[9]},{"provider":"tmdb_show","id":"96150","scope":"s1","seasonNumber":1,"episodeNumbers":[9]},{"provider":"tvdb_show","id":"373680","scope":"s1","seasonNumber":1,"episodeNumbers":[9]}],"link":"37860","synopsis":"Mazama Jin here. I'm on track to set a perfect attendance record at Seton Academy. It's always difficult to keep yourself at just the right amount of distance, isn't it? Sometimes you're too close, sometimes too far. In my case, Hitomi-chan always comes close to me in front of the others. You shouldn't do that! When you're not sure how much distance is appropriate, one thing you can try is to look from the viewpoint of a third party. I'm a little bewildered at myself for thinking of givng that advice... because the ones struggling with the right distance are a stupid tarsier and a stupid naked mole-rat.","thumbnail":"https://image.tmdb.org/t/p/w300/6lTuW34JbvOxVvP3ZuKuhkkVMAj.jpg","metadataSources":{"tmdb":{"title":"Episodio 9","synopsis":"Mazama Jin here. I'm on track to set a perfect attendance record at Seton Academy. It's always difficult to keep yourself at just the right amount of distance, isn't it? Sometimes you're too close, sometimes too far. In my case, Hitomi-chan always comes close to me in front of the others. You shouldn't do that! When you're not sure how much distance is appropriate, one thing you can try is to look from the viewpoint of a third party. I'm a little bewildered at myself for thinking of givng that advice... because the ones struggling with the right distance are a stupid tarsier and a stupid naked mole-rat.","thumbnail":"https://image.tmdb.org/t/p/w300/6lTuW34JbvOxVvP3ZuKuhkkVMAj.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}},{"title":"Episodio 10","episodeNumber":10,"sourceEpisodeNumber":10,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"15121","scope":"R","episodeNumbers":[10]},{"provider":"anilist","id":"112293","episodeNumbers":[10]},{"provider":"mal","id":"40483","episodeNumbers":[10]},{"provider":"tmdb_show","id":"96150","scope":"s1","seasonNumber":1,"episodeNumbers":[10]},{"provider":"tvdb_show","id":"373680","scope":"s1","seasonNumber":1,"episodeNumbers":[10]}],"link":"38006","synopsis":"Mazama Jin here. I've started to adapt to living in the dorm. I wonder what it's like to be in heat. It's hard for humans to understand, since we can breed at any time. If humans had a heat cycle, would Hitomi-chan be chasing me around all the time? Better hurry and get to me before someone else does! That particular worry might actually become a reality... if that mysterious new girl at school has anything to say about it.","thumbnail":"https://image.tmdb.org/t/p/w300/soP13fZglSnCwkM2qrPxIzs8W3V.jpg","metadataSources":{"tmdb":{"title":"Episodio 10","synopsis":"Mazama Jin here. I've started to adapt to living in the dorm. I wonder what it's like to be in heat. It's hard for humans to understand, since we can breed at any time. If humans had a heat cycle, would Hitomi-chan be chasing me around all the time? Better hurry and get to me before someone else does! That particular worry might actually become a reality... if that mysterious new girl at school has anything to say about it.","thumbnail":"https://image.tmdb.org/t/p/w300/soP13fZglSnCwkM2qrPxIzs8W3V.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}},{"title":"Episodio 11","episodeNumber":11,"sourceEpisodeNumber":11,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"15121","scope":"R","episodeNumbers":[11]},{"provider":"anilist","id":"112293","episodeNumbers":[11]},{"provider":"mal","id":"40483","episodeNumbers":[11]},{"provider":"tmdb_show","id":"96150","scope":"s1","seasonNumber":1,"episodeNumbers":[11]},{"provider":"tvdb_show","id":"373680","scope":"s1","seasonNumber":1,"episodeNumbers":[11]}],"link":"38249","synopsis":"Mazama Jin here. I'm the vice president of Seton Academy's cooking club. They say birth rates have been on the decline, but it's hard to imagine that leading to our extinction. What would happen if humans were on the brink of extinction? The answer is simple: Hitomi-chan and I would have to be the next Adam and Eve! I was having fun imagining it... until a bunch of stupid extinct animals crashed our culture festival.","thumbnail":"https://image.tmdb.org/t/p/w300/hrzInjMAv3VmNYJgFSVv5xewAGG.jpg","metadataSources":{"tmdb":{"title":"Episodio 11","synopsis":"Mazama Jin here. I'm the vice president of Seton Academy's cooking club. They say birth rates have been on the decline, but it's hard to imagine that leading to our extinction. What would happen if humans were on the brink of extinction? The answer is simple: Hitomi-chan and I would have to be the next Adam and Eve! I was having fun imagining it... until a bunch of stupid extinct animals crashed our culture festival.","thumbnail":"https://image.tmdb.org/t/p/w300/hrzInjMAv3VmNYJgFSVv5xewAGG.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}},{"title":"Episodio 12","episodeNumber":12,"sourceEpisodeNumber":12,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"15121","scope":"R","episodeNumbers":[12]},{"provider":"anilist","id":"112293","episodeNumbers":[12]},{"provider":"mal","id":"40483","episodeNumbers":[12]},{"provider":"tmdb_show","id":"96150","scope":"s1","seasonNumber":1,"episodeNumbers":[12]},{"provider":"tvdb_show","id":"373680","scope":"s1","seasonNumber":1,"episodeNumbers":[12]}],"link":"38425","synopsis":"Mazama Jin here. As much as it pains me to admit it, I'm part of a stupid mutt's pack at Seton Academy. Being with someone really is a challenge. It's a different story when two people are bound to each other by fate, like Hitomi-chan and me, but most aren't like that. And going out of one's way to try to accomplish something so difficult is just foolish. But now I've been forced to think that might not always be the case.... after watching all the animals at this school. As much as it pains me to admit it.","thumbnail":"https://image.tmdb.org/t/p/w300/zhnSxjWQvATRbD6sFZdj9UzT15P.jpg","metadataSources":{"tmdb":{"title":"Episodio 12","synopsis":"Mazama Jin here. As much as it pains me to admit it, I'm part of a stupid mutt's pack at Seton Academy. Being with someone really is a challenge. It's a different story when two people are bound to each other by fate, like Hitomi-chan and me, but most aren't like that. And going out of one's way to try to accomplish something so difficult is just foolish. But now I've been forced to think that might not always be the case.... after watching all the animals at this school. As much as it pains me to admit it.","thumbnail":"https://image.tmdb.org/t/p/w300/zhnSxjWQvATRbD6sFZdj9UzT15P.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}}],"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-30T07:57:40Z","sourceDescriptors":["anilist:112293","mal:40483"],"imdbSource":"plexanibridge-v2","targets":[{"provider":"anidb","id":"15121","scope":"R","ranges":{"1-12":"1-12"}},{"provider":"anilist","id":"112293","ranges":{"1-12":"1-12"}},{"provider":"mal","id":"40483","ranges":{"1-12":"1-12"}},{"provider":"tmdb_show","id":"96150","scope":"s1","ranges":{"1-12":"1-12"}},{"provider":"tvdb_show","id":"373680","scope":"s1","ranges":{"1-12":"1-12"}}]},"artworkInventory":{"logo":[{"source":"tmdb","url":"https://image.tmdb.org