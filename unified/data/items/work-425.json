cks":{"logo":[{"source":"tmdb","url":"https://image.tmdb.org/t/p/original/vuAiNfmZ5iXpT0ucX41nFiHto7T.png"},{"source":"cinemeta","url":"https://live.metahub.space/logo/medium/tt8096510/img"},{"source":"tvdb","url":"https://artworks.thetvdb.com/banners/v4/series/357047/clearlogo/61201caca6a5d.png"},{"source":"anizip","url":"https://artworks.thetvdb.com/banners/v4/series/357047/clearlogo/61201caf80c0d.png"}],"poster":[{"source":"tmdb","url":"https://image.tmdb.org/t/p/original/xlChIsX1jfDRsKt3tNgpPsgZiN8.jpg"},{"source":"anizip","url":"https://artworks.thetvdb.com/banners/posters/5c83e72ce92c5.jpg"},{"source":"provider","url":"https://img.animeunity.co/anime/bx101261-83mVHbQIAFDt.jpg"},{"source":"cinemeta","url":"https://live.metahub.space/poster/small/tt8096510/img"},{"source":"anilist","url":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/large/bx101261-lOLwQS45WJm5.jpg"}],"background":[{"source":"tmdb","url":"https://image.tmdb.org/t/p/original/3WUNbJpabQg8i9j1LHUXebn4C7C.jpg"},{"source":"cinemeta","url":"https://live.metahub.space/background/medium/tt8096510/img"},{"source":"anizip","url":"https://artworks.thetvdb.com/banners/fanart/original/5c7ff267ac0c9.jpg"},{"source":"provider","url":"https://img.animeunity.co/anime/101261-BOJuBUfv5xB8.jpg"},{"source":"anilist","url":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/101261-BOJuBUfv5xB8.jpg"}]}},"related":[],"linkList":[{"title":"Episodes 1-11","titleKey":"Episodes {{start}}-{{end}}","titleParams":{"start":1,"end":11},"availabilityStatus":"available","episodesLink":"578|1|11"}]},"episodes":[{"title":"Episodio 1","episodeNumber":1,"sourceEpisodeNumber":1,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"13869","scope":"R","episodeNumbers":[1]},{"provider":"anilist","id":"101261","episodeNumbers":[1]},{"provider":"mal","id":"37426","episodeNumbers":[1]},{"provider":"tmdb_show","id":"86919","scope":"s1","seasonNumber":1,"episodeNumbers":[1]},{"provider":"tvdb_show","id":"357047","scope":"s1","seasonNumber":1,"episodeNumbers":[1]}],"link":"13543","synopsis":"After accidentally breaking a statue of a kappa at a shrine in Asakusa, middle school student Kazuki Yasaka encounters Keppi, heir to the throne of the Kappa Kingdom. He, along with his classmates Toi Kuji and Enta Jinnai, enrage Keppi by calling him a frog; he steals their shirikodama, a mythical organ located in the anus that stores an individual's desires, and transforms them into kappas. Keppi informs them they must defeat a zombie by extracting its shirikodama in order to become human again. They are successful, but the act of \"Sarazanmai\" to transfer the shirikodama to Keppi exposes Kazuki's secret to the group: that he cross-dresses as the idol Sara Azuma. In a post-credits scene, police officers Reo Niiboshi and Mabu Akutsu extract the desires of a man they are questioning.","thumbnail":"https://image.tmdb.org/t/p/w300/vViV3rVQ5ywmqSIqJ7J7TUAXwTA.jpg","metadataSources":{"tmdb":{"title":"Episodio 1","synopsis":"After accidentally breaking a statue of a kappa at a shrine in Asakusa, middle school student Kazuki Yasaka encounters Keppi, heir to the throne of the Kappa Kingdom. He, along with his classmates Toi Kuji and Enta Jinnai, enrage Keppi by calling him a frog; he steals their shirikodama, a mythical organ located in the anus that stores an individual's desires, and transforms them into kappas. Keppi informs them they must defeat a zombie by extracting its shirikodama in order to become human again. They are successful, but the act of \"Sarazanmai\" to transfer the shirikodama to Keppi exposes Kazuki's secret to the group: that he cross-dresses as the idol Sara Azuma. In a post-credits scene, police officers Reo Niiboshi and Mabu Akutsu extract the desires of a man they are questioning.","thumbnail":"https://image.tmdb.org/t/p/w300/vViV3rVQ5ywmqSIqJ7J7TUAXwTA.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}},{"title":"Episodio 2","episodeNumber":2,"sourceEpisodeNumber":2,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"13869","scope":"R","episodeNumbers":[2]},{"provider":"anilist","id":"101261","episodeNumbers":[2]},{"provider":"mal","id":"37426","episodeNumbers":[2]},{"provider":"tmdb_show","id":"86919","scope":"s1","seasonNumber":1,"episodeNumbers":[2]},{"provider":"tvdb_show","id":"357047","scope":"s1","seasonNumber":1,"episodeNumbers":[2]}],"link":"13544","synopsis":"Keppi gives the group a Dish of Hope as thanks for helping him, which grants one wish to whomever possesses it, and informs them that they can earn more plates by defeating more zombies. Kazuki explains that he cross-dresses for his younger brother Haruka, a fan of Sara's, and that he wishes to earn a dish for him. Toi wishes to earn a dish for his older brother Chikai, a yakuza for whom he sells cannabis. Kazuki and Toi are later forced to pursue Nyantaro, a feral cat cared for by Kazuki and Haruka, after he steals a bag of cannabis from Toi's grow-op. Nyantaro is suddenly captured by a kappa zombie who, upon being defeated, exposes Kazuki's secret that Nyantaro is domestic cat that he stole. In a post-credits scene, Enta encounters a sleeping Kazuki dressed as Sara, and kisses him.","thumbnail":"https://image.tmdb.org/t/p/w300/kjBXDjOIMlZGYEhrQCge9kuNeXY.jpg","metadataSources":{"tmdb":{"title":"Episodio 2","synopsis":"Keppi gives the group a Dish of Hope as thanks for helping him, which grants one wish to whomever possesses it, and informs them that they can earn more plates by defeating more zombies. Kazuki explains that he cross-dresses for his younger brother Haruka, a fan of Sara's, and that he wishes to earn a dish for him. Toi wishes to earn a dish for his older brother Chikai, a yakuza for whom he sells cannabis. Kazuki and Toi are later forced to pursue Nyantaro, a feral cat cared for by Kazuki and Haruka, after he steals a bag of cannabis from Toi's grow-op. Nyantaro is suddenly captured by a kappa zombie who, upon being defeated, exposes Kazuki's secret that Nyantaro is domestic cat that he stole. In a post-credits scene, Enta encounters a sleeping Kazuki dressed as Sara, and kisses him.","thumbnail":"https://image.tmdb.org/t/p/w300/kjBXDjOIMlZGYEhrQCge9kuNeXY.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}},{"title":"Episodio 3","episodeNumber":3,"sourceEpisodeNumber":3,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"13869","scope":"R","episodeNumbers":[3]},{"provider":"anilist","id":"101261","episodeNumbers":[3]},{"provider":"mal","id":"37426","episodeNumbers":[3]},{"provider":"tmdb_show","id":"86919","scope":"s1","seasonNumber":1,"episodeNumbers":[3]},{"provider":"tvdb_show","id":"357047","scope":"s1","seasonNumber":1,"episodeNumbers":[3]}],"link":"13545","synopsis":"Enta, who has a crush on Kazuki, wishes to earn a dish so that Kazuki will return to playing soccer with him. Reo and Mabu extract the desires of Otone's boyfriend (who, unbeknownst to her, is a serial killer targeting women) and turn him into a zombie. The group defeats the zombie, exposing the secret of Enta's crush, and causing Otone to forget her boyfriend ever existed. In a post-credits scene, Enta visits Haruka in a hospital, who is revealed to be a wheelchair user.","thumbnail":"https://image.tmdb.org/t/p/w300/yyYI2hwyssBQuqH2oQq6y9Zqb7G.jpg","metadataSources":{"tmdb":{"title":"Episodio 3","synopsis":"Enta, who has a crush on Kazuki, wishes to earn a dish so that Kazuki will return to playing soccer with him. Reo and Mabu extract the desires of Otone's boyfriend (who, unbeknownst to her, is a serial killer targeting women) and turn him into a zombie. The group defeats the zombie, exposing the secret of Enta's crush, and causing Otone to forget her boyfriend ever existed. In a post-credits scene, Enta visits Haruka in a hospital, who is revealed to be a wheelchair user.","thumbnail":"https://image.tmdb.org/t/p/w300/yyYI2hwyssBQuqH2oQq6y9Zqb7G.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}},{"title":"Episodio 4","episodeNumber":4,"sourceEpisodeNumber":4,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"13869","scope":"R","episodeNumbers":[4]},{"provider":"anilist","id":"101261","episodeNumbers":[4]},{"provider":"mal","id":"37426","episodeNumbers":[4]},{"provider":"tmdb_show","id":"86919","scope":"s1","seasonNumber":1,"episodeNumbers":[4]},{"provider":"tvdb_show","id":"357047","scope":"s1","seasonNumber":1,"episodeNumbers":[4]}],"link":"13939","synopsis":"Kazuki asks for Toi's help to kidnap Sara and so that he can take her place during a meet-and-greet that Haruka plans to attend. Toi's backstory is revealed through a flashback – after his parents died from suicide upon being conned into crippling debt, the family's soba shop was saved from closure through Chikai's intervention. When a yakuza came to collect the family's debt, he was shot by Toi, which was subsequently covered up by Chikai.","thumbnail":"https://image.tmdb.org/t/p/w300/dLWBUCHqbG7QbU2xIbbKKGOaZGM.jpg","metadataSources":{"tmdb":{"title":"Episodio 4","synopsis":"Kazuki asks for Toi's help to kidnap Sara and so that he can take her place during a meet-and-greet that Haruka plans to attend. Toi's backstory is revealed through a flashback – after his parents died from suicide upon being conned into crippling debt, the family's soba shop was saved from closure through Chikai's intervention. When a yakuza came to collect the family's debt, he was shot by Toi, which was subsequently covered up by Chikai.","thumbnail":"https://image.tmdb.org/t/p/w300/dLWBUCHqbG7QbU2xIbbKKGOaZGM.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}},{"title":"Episodio 5","episodeNumber":5,"sourceEpisodeNumber":5,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"13869","scope":"R","episodeNumbers":[5]},{"provider":"anilist","id":"101261","episodeNumbers":[5]},{"provider":"mal","id":"37426","episodeNumbers":[5]},{"provider":"tmdb_show","id":"86919","scope":"s1","seasonNumber":1,"episodeNumbers":[5]},{"provider":"tvdb_show","id":"357047","scope":"s1","seasonNumber":1,"episodeNumbers":[5]}],"link":"14790","synopsis":"Toi attempts to kidnap Sara, though she evades him by transforming into a kappa, exposing Kazuki's crossdressing to his family. Kazuki reveals that he is adopted, and that he blames himself for Haruka's disability when he was hit by a car after they had a fight. Kazuki's turmoil causes him to fail in defeating the episode's zombie; an angry Keppi subsequently refuses to transform the group back into their human forms.","thumbnail":"https://image.tmdb.org/t/p/w300/r5nBCNfhGzaUop5Ryy5SwxylyL3.jpg","metadataSources":{"tmdb":{"title":"Episodio 5","synopsis":"Toi attempts to kidnap Sara, though she evades him by transforming into a kappa, exposing Kazuki's crossdressing to his family. Kazuki reveals that he is adopted, and that he blames himself for Haruka's disability when he was hit by a car after they had a fight. Kazuki's turmoil causes him to fail in defeating the episode's zombie; an angry Keppi subsequently refuses to transform the group back into their human forms.","thumbnail":"https://image.tmdb.org/t/p/w300/r5nBCNfhGzaUop5Ryy5SwxylyL3.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}},{"title":"Episodio 6","episodeNumber":6,"sourceEpisodeNumber":6,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"13869","scope":"R","episodeNumbers":[6]},{"provider":"anilist","id":"101261","episodeNumbers":[6]},{"provider":"mal","id":"37426","episodeNumbers":[6]},{"provider":"tmdb_show","id":"86919","scope":"s1","seasonNumber":1,"episodeNumbers":[6]},{"provider":"tvdb_show","id":"357047","scope":"s1","seasonNumber":1,"episodeNumbers":[6]}],"link":"15294","synopsis":"The group rescue Haruka after he is kidnapped by Reo, and are transformed back into human form. Keppi explains that Reo and Mabu are agents of the Otter Empire, who have been at war with the Kappa Kingdom for generations over the energy of the shirikodama; with the Kappa Kingdom now defeated, the Otter Empire has begun to extract the shirikodama of humans. In a post-credits flashback set during the Otter-Kappa war, Mabu sacrifices himself to protect Reo in battle.","thumbnail":"https://image.tmdb.org/t/p/w300/8MC38IxARCgz4Jw9JWWLekNsxMj.jpg","metadataSources":{"tmdb":{"title":"Episodio 6","synopsis":"The group rescue Haruka after he is kidnapped by Reo, and are transformed back into human form. Keppi explains that Reo and Mabu are agents of the Otter Empire, who have been at war with the Kappa Kingdom for generations over the energy of the shirikodama; with the Kappa Kingdom now defeated, the Otter Empire has begun to extract the shirikodama of humans. In a post-credits flashback set during the Otter-Kappa war, Mabu sacrifices himself to protect Reo in battle.","thumbnail":"https://image.tmdb.org/t/p/w300/8MC38IxARCgz4Jw9JWWLekNsxMj.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}},{"title":"Episodio 7","episodeNumber":7,"sourceEpisodeNumber":7,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"13869","scope":"R","episodeNumbers":[7]},{"provider":"anilist","id":"101261","episodeNumbers":[7]},{"provider":"mal","id":"37426","episodeNumbers":[7]},{"provider":"tmdb_show","id":"86919","scope":"s1","seasonNumber":1,"episodeNumbers":[7]},{"provider":"tvdb_show","id":"357047","scope":"s1","seasonNumber":1,"episodeNumbers":[7]}],"link":"15658","synopsis":"In a flashback, Mabu is brought back to life with a mechanical heart transplanted by Otter, though Reo believes that Mabu is merely a re-animated facsimile. Chikai's criminal dealings force him to flee the city, and Toi announces that he intends to join his brother. The group agrees to use the dishes to help Chikai, but discover they have been stolen. Upon defeating a kappa zombie, Enta is exposed as having stolen the dishes out of jealously over Kazuki's concern for Toi.","thumbnail":"https://image.tmdb.org/t/p/w300/1Qiv2rJBXdxZKABGL9HCLg7F4DT.jpg","metadataSources":{"tmdb":{"title":"Episodio 7","synopsis":"In a flashback, Mabu is brought back to life with a mechanical heart transplanted by Otter, though Reo believes that Mabu is merely a re-animated facsimile. Chikai's criminal dealings force him to flee the city, and Toi announces that he intends to join his brother. The group agrees to use the dishes to help Chikai, but discover they have been stolen. Upon defeating a kappa zombie, Enta is exposed as having stolen the dishes out of jealously over Kazuki's concern for Toi.","thumbnail":"https://image.tmdb.org/t/p/w300/1Qiv2rJBXdxZKABGL9HCLg7F4DT.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}},{"title":"Episodio 8","episodeNumber":8,"sourceEpisodeNumber":8,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"13869","scope":"R","episodeNumbers":[8]},{"provider":"anilist","id":"101261","episodeNumbers":[8]},{"provider":"mal","id":"37426","episodeNumbers":[8]},{"provider":"tmdb_show","id":"86919","scope":"s1","seasonNumber":1,"episodeNumbers":[8]},{"provider":"tvdb_show","id":"357047","scope":"s1","seasonNumber":1,"episodeNumbers":[8]}],"link":"16083","synopsis":"Chikai and Toi make preparations to leave the city. Enta returns the Dishes of Hope to Kazuki, but they are confronted by Reo and Mabu, who intend to use the dishes to restore Mabu. Reo shoots Enta, and takes the dishes.","thumbnail":"https://image.tmdb.org/t/p/w300/11u6CPG2JimXNB5lOfRsV3IrSo7.jpg","metadataSources":{"tmdb":{"title":"Episodio 8","synopsis":"Chikai and Toi make preparations to leave the city. Enta returns the Dishes of Hope to Kazuki, but they are confronted by Reo and Mabu, who intend to use the dishes to restore Mabu. Reo shoots Enta, and takes the dishes.","thumbnail":"https://image.tmdb.org/t/p/w300/11u6CPG2JimXNB5lOfRsV3IrSo7.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}},{"title":"Episodio 9","episodeNumber":9,"sourceEpisodeNumber":9,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"13869","scope":"R","episodeNumbers":[9]},{"provider":"anilist","id":"101261","episodeNumbers":[9]},{"provider":"mal","id":"37426","episodeNumbers":[9]},{"provider":"tmdb_show","id":"86919","scope":"s1","seasonNumber":1,"episodeNumbers":[9]},{"provider":"tvdb_show","id":"357047","scope":"s1","seasonNumber":1,"episodeNumbers":[9]}],"link":"17252","synopsis":"Keppi transforms a hospitalized Enta into a kappa so that he and Kazuki can recover the dishes. Reo witnesses Otter performing sexually-charged \"maintenance\" on Mabu's heart; when he intervenes, Otter appears in the form of Reo, and explains that he is a mirror of Reo's inner desires. Meanwhile, Chikai is shot and killed in a confrontation with the yakuza.","thumbnail":"https://image.tmdb.org/t/p/w300/h5T4ti1pLFUWmYPpwCjKYGa2o0p.jpg","metadataSources":{"tmdb":{"title":"Episodio 9","synopsis":"Keppi transforms a hospitalized Enta into a kappa so that he and Kazuki can recover the dishes. Reo witnesses Otter performing sexually-charged \"maintenance\" on Mabu's heart; when he intervenes, Otter appears in the form of Reo, and explains that he is a mirror of Reo's inner desires. Meanwhile, Chikai is shot and killed in a confrontation with the yakuza.","thumbnail":"https://image.tmdb.org/t/p/w300/h5T4ti1pLFUWmYPpwCjKYGa2o0p.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}},{"title":"Episodio 10","episodeNumber":10,"sourceEpisodeNumber":10,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"13869","scope":"R","episodeNumbers":[10]},{"provider":"anilist","id":"101261","episodeNumbers":[10]},{"provider":"mal","id":"37426","episodeNumbers":[10]},{"provider":"tmdb_show","id":"86919","scope":"s1","seasonNumber":1,"episodeNumbers":[10]},{"provider":"tvdb_show","id":"357047","scope":"s1","seasonNumber":1,"episodeNumbers":[10]}],"link":"18220","synopsis":"Kazuki, Enta, and Keppi encounter Dark Keppi, the corporeal form of half of Keppi's shirikodama held by the Otter Empire. Otter, having learned of Reo's plan to use the dishes on Mabu, transforms Mabu into a zombie. Keppi transforms Reo into a kappa, who recovers Mabu's shirikodama and learns that Otter forced Mabu into giving up his connection with Reo in order to live. Mabu tells Reo that he loves him, causing his mechanical heart to explode. A grieving Reo attacks Kazuki, Enta, and Keppi, but is shot and killed by Toi, who wishes to use the dishes to bring Chikai back to life. Kazuki uses the dishes to save Enta's life, and Toi is absorbed by Dark Keppi.","thumbnail":"https://image.tmdb.org/t/p/w300/iA8Nh95ppha945246LHFkmkkoAf.jpg","metadataSources":{"tmdb":{"title":"Episodio 10","synopsis":"Kazuki, Enta, and Keppi encounter Dark Keppi, the corporeal form of half of Keppi's shirikodama held by the Otter Empire. Otter, having learned of Reo's plan to use the dishes on Mabu, transforms Mabu into a zombie. Keppi transforms Reo into a kappa, who recovers Mabu's shirikodama and learns that Otter forced Mabu into giving up his connection with Reo in order to live. Mabu tells Reo that he loves him, causing his mechanical heart to explode. A grieving Reo attacks Kazuki, Enta, and Keppi, but is shot and killed by Toi, who wishes to use the dishes to bring Chikai back to life. Kazuki uses the dishes to save Enta's life, and Toi is absorbed by Dark Keppi.","thumbnail":"https://image.tmdb.org/t/p/w300/iA8Nh95ppha945246LHFkmkkoAf.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}},{"title":"Episodio 11","episodeNumber":11,"sourceEpisodeNumber":11,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"13869","scope":"R","episodeNumbers":[11]},{"provider":"anilist","id":"101261","episodeNumbers":[11]},{"provider":"mal","id":"37426","episodeNumbers":[11]},{"provider":"tmdb_show","id":"86919","scope":"s1","seasonNumber":1,"episodeNumbers":[11]},{"provider":"tvdb_show","id":"357047","scope":"s1","seasonNumber":1,"episodeNumbers":[11]}],"link":"18738","synopsis":"Toi begins to destroy his connection to Kazuki and Enta, but ultimately chooses to preserve it. Keppi fuses with Dark Keppi, with assistance from the group and a revived Reo and Mabu, and defeats Otter and the concepts it represents. Upon performing sarazanmai, Kazuki, Toi, and Enta foresee a potential future in which their connections to each other are eventually severed. In the aftermath, Toi is sent to juvenile detention for three years. Upon his release, he jumps off of the Azuma Bridge, but is rescued by Kazuki and Enta. The three happily run \"off to the future\" together.","thumbnail":"https://image.tmdb.org/t/p/w300/AnOgFOvSQee1fiu8bMbTl7cNET3.jpg","metadataSources":{"tmdb":{"title":"Episodio 11","synopsis":"Toi begins to destroy his connection to Kazuki and Enta, but ultimately chooses to preserve it. Keppi fuses with Dark Keppi, with assistance from the group and a revived Reo and Mabu, and defeats Otter and the concepts it represents. Upon performing sarazanmai, Kazuki, Toi, and Enta foresee a potential future in which their connections to each other are eventually severed. In the aftermath, Toi is sent to juvenile detention for three years. Upon his release, he jumps off of the Azuma Bridge, but is rescued by Kazuki and Enta. The three happily run \"off to the future\" together.","thumbnail":"https://image.tmdb.org/t/p/w300/AnOgFOvSQee1fiu8bMbTl7cNET3.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}}],"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-30T07:57:40Z","sourceDescriptors":["anilist:101261","mal:37426"],"imdbSource":"plexanibridge-v2","targets":[{"provider":"anidb","id":"13869","scope":"R","ranges":{"1-11":"1-11"}},{"provider":"anilist","id":"101261","ranges":{"1-11":"1-11"}},{"provider":"mal","id":"37426","ranges":{"1-11":"1-11"}},{"provider":"tmdb_show","id":"86919","scope":"s1","ranges":{"1-11":"1-11"}},{"provider":"tvdb_show","id":"357047","scope":"s1","ranges":{"1-11":"1-11"}}]},"artworkInventory":{"logo":[{"source":"tmdb","url":"https://image.tmdb.org/t/p/original/vu