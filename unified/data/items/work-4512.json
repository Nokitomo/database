{"id":"work-4512","sourceIds":{"anilist":11755,"mal":11755},"info":{"title":"009 Re:Cyborg","synopsis":"Cosa spinge i Cyborg a riformare la squadra dopo 27 anni di separazione? Come saranno cambiati… O non lo saranno? Perché 009 sembra aver perso la memoria o addirittura essere passato al nemico? Quale motivo possono avere dei misteriosi terroristi per distruggere i grattacieli della Terra, nuove Torri di Babele? E in che modo la cosa è collegata coi misteriosi ritrovamenti archeologici in tutto il mondo? Chi sono gli angeli? Chi è quella misteriosa ragazza, e quella misteriosa bambina? Perché la Voce che alcuni sentono vuole distruggere ogni cosa? Dove si trova il vero Dio, nei cieli o sulla terra? Ma soprattutto… Ce la faranno i Nostri a salvare ancora una volta il mondo?","image":"https://image.tmdb.org/t/p/original/lLQ285DZb8FqvFNVql574KwZ32v.jpg","poster":"https://image.tmdb.org/t/p/original/eBaUVUNAWSOg70TMl7o9K3qSgYO.jpg","logo":"https://image.tmdb.org/t/p/original/gUv6hnli3JS5H7lvKaZyLzGf25h.png","background":"https://image.tmdb.org/t/p/original/lLQ285DZb8FqvFNVql574KwZ32v.jpg","imdbId":"tt2078523","type":"movie","tags":["Movie","Terminato","Autunno","2012"],"tagKeys":{"Movie":"Movie","Terminato":"Completed","Autunno":"Autumn"},"genres":["Action","Adventure","Mecha","Sci-fi"],"rating":"7.5","studio":"Production I.G","episodesCount":1,"extra":{"ids":{"malId":11755,"anilistId":11755,"crunchyId":null,"disneyId":null,"netflixId":null,"primeId":null,"anilistIds":[11755],"malIds":[11755],"anidbIds":[8699],"imdbMovieIds":["tt2078523"],"imdbShowIds":[],"tmdbMovieIds":[127544],"tmdbShowIds":[],"tvdbMovieIds":[],"tvdbShowIds":[]},"stats":{"scoreRaw":"7.48","favorites":25,"members":102,"views":10101,"episodesCountRaw":1,"episodesLength":103},"flags":{"dub":0,"alwaysHome":1},"meta":{"day":"Indeterminato","season":"Autunno","status":"Terminato","type":"Movie","createdAt":"2024-06-20 20:22:13","userId":78495},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","ge