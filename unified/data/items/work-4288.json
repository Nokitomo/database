{"id":"work-4288","sourceIds":{"anilist":171019,"mal":57315},"info":{"title":"Isekai Onsen Paradise","synopsis":"La storia è incentrata su Yoshizō Yukawa, un grande amante delle terme che un giorno scopre una sorgente termale la quale, in poco tempo, rivitalizza l'economia della popolazione locale. Dopo essere morto precipitando da una sporgenza, Yukawa viene riportato in vita e trasportato in un altro mondo da una divinità inari di un piccolo tempio. Insieme all'attendente del tempio, la principessa Mayudama, il giovane continua la sua ricerca di sorgenti termali in questo nuovo mondo, finendo, a mano a mano, a fare bagni con affascinanti elfe e formose ragazze dalle orecchiette animali.","image":"https://image.tmdb.org/t/p/original/f9mq6Kns61qDeKi0UaFVD1dWO1k.jpg","poster":"https://image.tmdb.org/t/p/original/5f0yh62qbcNyhETZgoaihqRIgdR.jpg","logo":"https://image.tmdb.org/t/p/original/3kIRWiS9x5bYaW7SHhaMfSnAr7A.png","background":"https://image.tmdb.org/t/p/original/f9mq6Kns61qDeKi0UaFVD1dWO1k.jpg","imdbId":"","type":"series","tags":["TV Short","Terminato","Inverno","2024"],"tagKeys":{"TV Short":"TV Short","Terminato":"Completed","Inverno":"Winter"},"genres":["Ecchi","Fantasy","Isekai"],"rating":"6.2","studio":"BloomZ","episodesCount":12,"extra":{"ids":{"malId":57315,"anilistId":171019,"crunchyId":null,"disneyId":null,"netflixId":null,"primeId":null,"anilistIds":[171019],"malIds":[57315],"anidbIds":[18288],"imdbMovieIds":[],"imdbShowIds":[],"tmdbMovieIds":[],"tmdbShowIds":[241021],"tvdbMovieIds":[],"tvdbShowIds":[442690]},"stats":{"scoreRaw":"6.17","favorites":149,"members":1034,"views":117459,"episodesCountRaw":12,"episodesLength":5},"flags":{"dub":0,"alwaysHome":1},"meta":{"day":"Indeterminato","season":"Inverno","status":"Terminato","type":"TV Short","createdAt":"2024-01-14 18:31:35","userId":2},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-29T07:54:59Z","sourceDescriptors":["anilist:171019","mal:57315"],"targets":[{"provide