[5]},{"provider":"mal","id":"27655","episodeNumbers":[5]},{"provider":"tmdb_show","id":"61259","scope":"s1","seasonNumber":1,"episodeNumbers":[17]},{"provider":"tvdb_show","id":"279827","scope":"s1","seasonNumber":1,"episodeNumbers":[17]}],"link":"371","synopsis":"Irritated by Slaine’s actions, Count Marylcian works out a new strategy with Count Barouhcruz. Elsewhere, Rayet loses her composure in front of the Mars Knight prisoner, and Inaho deduces her true intentions. Meanwhile, Slaine talks about birds with Eddelrittuo.","thumbnail":"https://image.tmdb.org/t/p/w300/uRDZ5lFzn2uJyAzjRQoBEDr7ZWY.jpg","metadataSources":{"tmdb":{"title":"Episodio 17","synopsis":"Irritated by Slaine’s actions, Count Marylcian works out a new strategy with Count Barouhcruz. Elsewhere, Rayet loses her composure in front of the Mars Knight prisoner, and Inaho deduces her true intentions. Meanwhile, Slaine talks about birds with Eddelrittuo.","thumbnail":"https://image.tmdb.org/t/p/w300/uRDZ5lFzn2uJyAzjRQoBEDr7ZWY.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}},{"title":"Episodio 18","episodeNumber":6,"sourceEpisodeNumber":6,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"10846","scope":"R","episodeNumbers":[6]},{"provider":"anilist","id":"20853","episodeNumbers":[6]},{"provider":"mal","id":"27655","episodeNumbers":[6]},{"provider":"tmdb_show","id":"61259","scope":"s1","seasonNumber":1,"episodeNumbers":[18]},{"provider":"tvdb_show","id":"279827","scope":"s1","seasonNumber":1,"episodeNumbers":[18]}],"link":"372","synopsis":"Princess Lemrina is distraught over an unexpected situation, but Slaine tells her that on the contrary, he will use it to his advantage. But deep down, he gradually feels more and more cornered. Elsewhere, the Deucalion’s crew links up with a UFE company that is engaging a powerful enemy. Then, on the front line, Inaho gets out of his Kataphraktos.","thumbnail":"https://image.tmdb.org/t/p/w300/mTq3VC4BonvYENwBfRA1WleVZvn.jpg","metadataSources":{"