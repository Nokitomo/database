{"id":"work-446","sourceIds":{"anilist":21410,"mal":31764},"info":{"title":"Alderamin on the Sky","synopsis":"L'Impero Katjvarna è in guerra con l'adiacente repubblica di Kioka. Ikta è disgustato dalla guerra, pigro e appassionato di donne e per una serie di ragioni non vuole sottoporsi all'esame per ufficiali di alto grado. Nessuno avrebbe potuto immaginare che proprio tale Ikta sarebbe diventato un soldato conosciuto con l'appellativo di grande comandante.","image":"https://image.tmdb.org/t/p/original/kJ7yfIE0vhL7XpVm8Aq5DR5c84O.jpg","poster":"https://image.tmdb.org/t/p/original/aoRWkHczGMUB490XN9YQKo84xVJ.jpg","logo":"https://image.tmdb.org/t/p/original/9W2dgS6QQ7NzRVOmclGpvUQMhsH.png","background":"https://image.tmdb.org/t/p/original/kJ7yfIE0vhL7XpVm8Aq5DR5c84O.jpg","trailers":["https://www.youtube.com/watch?v=Mq3YB_ueHdo"],"imdbId":"tt5905350","type":"series","tags":["TV","Terminato","Estate","2016"],"tagKeys":{"TV":"TV","Terminato":"Completed","Estate":"Summer"},"genres":["Action","Adventure","Drama","Fantasy","Military"],"rating":"7.9","studio":"MADHOUSE","episodesCount":13,"extra":{"ids":{"malId":31764,"anilistId":21410,"crunchyId":null,"disneyId":null,"netflixId":null,"primeId":null,"anilistIds":[21410],"malIds":[31764],"anidbIds":[11679],"imdbMovieIds":[],"imdbShowIds":[],"tmdbMovieIds":[],"tmdbShowIds":[65954],"tvdbMovieIds":[],"tvdbShowIds":[309206]},"stats":{"scoreRaw":"7.91","favorites":238,"members":1581,"views":170604,"episodesCountRaw":13,"episodesLength":23},"flags":{"dub":0,"alwaysHome":0},"meta":{"day":"Venerdì","season":"Estate","status":"Terminato","type":"TV","createdAt":"2019-05-05 12:38:19","userId":78495},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-30T07:57:40Z","sourceDescriptors":["anilist:21410","mal:31764"],"imdbSource":"plexanibridge-v2","targets":[{"provider":"anidb","id":"11679","scope":"R","ranges":{"1-13":"1-13"}},{"provider":"anilist","id":"21410","ranges":{"1-13":"1-13"}},{"provider":"mal","