{"id":"work-4996","sourceIds":{"anilist":97745,"mal":34088},"info":{"title":"Chiruran 1/2","synopsis":"All’alba di una nuova era, Kyoto era nel caos. Differenti fazioni si muovono con scopi tra loro contrastanti e con lo scontro delle diverse idee, alcuni sono ricorsi alla violenza per imporre la propria visione. Per riportare l’ordine nelle strade di Kyoto, sono stati creati gli Shinsegumi – i guardiani della pace. Un gruppo di giovani e fieri Samurai mercenari che devono riportare la pace e dimostrare il loro valore. Sono vissuti e morti per la spada in un periodo colmo di sconvolgimenti politici. Per loro, un uomo viene definito dal modo in cui esso muore.","image":"https://image.tmdb.org/t/p/original/uCjLBocgK5zYYVAd2GQ2TXQPNp6.jpg","poster":"https://image.tmdb.org/t/p/original/4SokeGnS51engQorL35eg5oaV9g.jpg","background":"https://image.tmdb.org/t/p/original/uCjLBocgK5zYYVAd2GQ2TXQPNp6.jpg","imdbId":"","type":"series","tags":["TV Short","Terminato","Inverno","2017"],"tagKeys":{"TV Short":"TV Short","Terminato":"Completed","Inverno":"Winter"},"genres":["Action","Comedy","Historical"],"rating":"7.0","studio":"LandQ studios","episodesCount":12,"extra":{"ids":{"malId":34088,"anilistId":97745,"crunchyId":null,"disneyId":null,"netflixId":null,"primeId":null,"anilistIds":[97745],"malIds":[34088],"anidbIds":[12418],"imdbMovieIds":[],"imdbShowIds":[],"tmdbMovieIds":[],"tmdbShowIds":[69240],"tvdbMovieIds":[],"tvdbShowIds":[320560]},"stats":{"scoreRaw":"7.00","favorites":1,"members":8,"views":2025,"episodesCountRaw":12,"episodesLength":2},"flags":{"dub":0,"alwaysHome":0},"meta":{"day":"Lunedì","season":"Inverno","status":"Terminato","type":"TV Short","createdAt":"2025-01-27 17:54:25","userId":2},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-29T07:54:59Z","sourceDescriptors":["anilist:97745","mal:34088"],"targets":[{"provider":"anidb","id":"12418","scope":"R","ranges":{"1-12":"1-12"}},{"provider":"anilist","id":"97745","ranges":{"1-12":