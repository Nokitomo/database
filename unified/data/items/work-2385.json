{"id":"work-2385","sourceIds":{"anilist":1913,"mal":1913},"info":{"title":"Shonan Junai Gumi!","synopsis":"Eikichi Onizuka e Ryuji Danma sono due teppisti liceali che, nonostante la loro fama nelle risse, dove sono conosciuti col nome Oni-Baku, non hanno fortuna con le ragazze e sono ancora vergini. Tenteranno così di liberarsi della loro verginità cambiando scuola e stile di vita. Nonostante ciò la loro fama li rende bersagli dei vari teppisti e delle varie bande che tentano di raggiungere il titolo di più forte di Shōnan. Così tra una rissa e l'altra tenteranno di approcciare più ragazze possibili per raggiungere finalmente il loro obiettivo.","image":"https://image.tmdb.org/t/p/original/ab3lYlM9v6nwDpM0lUElZfpU01i.jpg","poster":"https://image.tmdb.org/t/p/original/wxqCamD73nbdaBwu41pPYECrNdC.jpg","logo":"https://image.tmdb.org/t/p/original/5EsSjcltlc6ibiU3FpoylCuItNr.png","background":"https://image.tmdb.org/t/p/original/ab3lYlM9v6nwDpM0lUElZfpU01i.jpg","imdbId":"tt13281798","type":"series","tags":["OVA","Terminato","Inverno","1994"],"tagKeys":{"OVA":"OVA","Terminato":"Completed","Inverno":"Winter"},"genres":["Action","Comedy","School"],"rating":"8.0","studio":"J.C.Staff, Life Work","episodesCount":5,"extra":{"ids":{"malId":1913,"anilistId":1913,"crunchyId":null,"disneyId":null,"netflixId":null,"primeId":null,"anilistIds":[1913],"malIds":[1913],"anidbIds":[4841],"imdbMovieIds":[],"imdbShowIds":[],"tmdbMovieIds":[],"tmdbShowIds":[43017],"tvdbMovieIds":[],"tvdbShowIds":[79071]},"stats":{"scoreRaw":"8.01","favorites":69,"members":437,"views":46396,"episodesCountRaw":5,"episodesLength":50},"flags":{"dub":0,"alwaysHome":0},"meta":{"day":"Indeterminato","season":"Inverno","status":"Terminato","type":"OVA","createdAt":"2020-08-30 13:31:12","userId":78495},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-30T07:57:40Z","sourceDescriptors":["anilist:1913","mal:1913"],"imdbSource":"plexanibridge-v2","targets":[{"provider":"anidb","id":"4841