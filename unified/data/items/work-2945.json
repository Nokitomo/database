{"id":"work-2945","sourceIds":{"anilist":99900,"mal":41361},"info":{"title":"Pompo: The Cinéphile","synopsis":"Joelle Davidovich Pomponette, detta Pompo, è una talentuosa e affermata produttrice cinematografica che, tuttavia, ha l'aspetto di una ragazzina. La sua specialità sono i B-movie, pellicole che Pompo produce una dopo l'altra dagli studi di \"Nyallywood\"; un giorno, però, il suo assistente Gene scopre un nuovo copione scritto da Pompo. Colpito dalla storia, il ragazzo implora Pompo di realizzare il nuovo film; Pompo accetta, ma ad una condizione: sarà Gene a doverlo dirigere! Nel frattempo, una ragazza di nome Natalie arriva in città sognando di fare l'attrice...","image":"https://image.tmdb.org/t/p/original/zH5madtPg4eBnTefaFgvxpubPLN.jpg","poster":"https://image.tmdb.org/t/p/original/6bopq2UUkV46mM9gMyUomQES5Vs.jpg","logo":"https://image.tmdb.org/t/p/original/uAgoyir2vt5jzdns0QjGZqWGOgS.png","background":"https://image.tmdb.org/t/p/original/zH5madtPg4eBnTefaFgvxpubPLN.jpg","trailers":["https://www.youtube.com/watch?v=eVeCQM7MOZk"],"imdbId":"tt12439248","type":"movie","tags":["Movie","Terminato","Primavera","2021"],"tagKeys":{"Movie":"Movie","Terminato":"Completed","Primavera":"Spring"},"genres":["Comedy","Drama"],"rating":"8.5","studio":"CLAP","episodesCount":1,"extra":{"ids":{"malId":41361,"anilistId":99900,"crunchyId":null,"disneyId":null,"netflixId":null,"primeId":null,"anilistIds":[99900],"malIds":[41361],"anidbIds":[13405],"imdbMovieIds":["tt12439248"],"imdbShowIds":[],"tmdbMovieIds":[678458],"tmdbShowIds":[],"tvdbMovieIds":[331608],"tvdbShowIds":[]},"stats":{"scoreRaw":"8.48","favorites":30,"members":331,"views":7773,"episodesCountRaw":1,"episodesLength":94},"flags":{"dub":0,"alwaysHome":1},"meta":{"day":"Giovedì","season":"Primavera","status":"Terminato","type":"Movie","createdAt":"2021-12-31 05:32:24","userId":2},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-11-01T08:31:58Z","sourceDescriptors":["anilist:99900","m