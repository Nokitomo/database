/anime/bx21728-gCMH8hDEqzmx.png","type":"ONA","year":"2016","dubStatus":"subbed","dubStatusKey":"Subbed","variants":[{"status":"subbed","statusKey":"Subbed","title":"Brotherhood Final Fantasy XV","link":"/anime/1319-brotherhood-final-fantasy-xv","image":"https://img.animeunity.co/anime/bx21728-gCMH8hDEqzmx.png"}]},{"title":"Final Fantasy XV: Episode Ardyn - Prologue","link":"/anime/1320-final-fantasy-xv-episode-ardyn-prologue","image":"https://img.animeunity.co/anime/bx107624-FjkOwm6UL6zF.jpg","type":"ONA","year":"2019","dubStatus":"subbed","dubStatusKey":"Subbed","variants":[{"status":"subbed","statusKey":"Subbed","title":"Final Fantasy XV: Episode Ardyn - Prologue","link":"/anime/1320-final-fantasy-xv-episode-ardyn-prologue","image":"https://img.animeunity.co/anime/bx107624-FjkOwm6UL6zF.jpg"}]}],"linkList":[{"title":"Episodes 1-5","titleKey":"Episodes {{start}}-{{end}}","titleParams":{"start":1,"end":5},"availabilityStatus":"available","episodesLink":"1319|1|5"}]},"episodes":[{"title":"Episodio 1","episodeNumber":1,"sourceEpisodeNumber":1,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"12053","scope":"R","episodeNumbers":[1]},{"provider":"anilist","id":"21728","episodeNumbers":[1]},{"provider":"mal","id":"33080","episodeNumbers":[1]},{"provider":"tmdb_show","id":"66987","scope":"s1","seasonNumber":1,"episodeNumbers":[1]},{"provider":"tvdb_show","id":"313185","scope":"s1","seasonNumber":1,"episodeNumbers":[1]}],"link":"25413","synopsis":"Noctis has set out on his journey to meet Lunafreya, during which he hears about the attack on Lucis' capital, Insomnia, and must fight off attacks from Niflheim magitek troops. He also remembers the Daemon attack in his childhood which left him seriously wounded: at the end of the episode, he encounters the Daemon again as part of a Niflheim attack force.","thumbnail":"https://image.tmdb.org/t/p/w300/djCOocdkzUO3Tryjrz6QZ4AZLfN.jpg","metadataSources":{"tmdb":{"title":"Episodio 1","synopsis":"Noctis has set out on his journey to meet Lunafreya, during which he hears about the attack on Lucis' capital, Insomnia, and must fight off attacks from Niflheim magitek troops. He also remembers the Daemon attack in his childhood which left him seriously wounded: at the end of the episode, he encounters the Daemon again as part of a Niflheim attack force.","thumbnail":"https://image.tmdb.org/t/p/w300/djCOocdkzUO3Tryjrz6QZ4AZLfN.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}},{"title":"Episodio 2","episodeNumber":2,"sourceEpisodeNumber":2,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"12053","scope":"R","episodeNumbers":[2]},{"provider":"anilist","id":"21728","episodeNumbers":[2]},{"provider":"mal","id":"33080","episodeNumbers":[2]},{"provider":"tmdb_show","id":"66987","scope":"s1","seasonNumber":1,"episodeNumbers":[2]},{"provider":"tvdb_show","id":"313185","scope":"s1","seasonNumber":1,"episodeNumbers":[2]}],"link":"25414","synopsis":"Prompto's backstory is revealed as he is tending to a wounded wild puppy found on the road. Initially an introverted and obese student at Noctis' school, his chance encounter and care for one of Lunafreya's puppies results in him being asked by her to be Noctis' friend. By the time the two were attending high school, Prompto had slimmed down and gained new confidence, though Noctis still recognized him from an earlier encounter and accepted him as a friend.","thumbnail":"https://image.tmdb.org/t/p/w300/ilZo1WiAPuriQ1KaU2haWPbPYcj.jpg","metadataSources":{"tmdb":{"title":"Episodio 2","synopsis":"Prompto's backstory is revealed as he is tending to a wounded wild puppy found on the road. Initially an introverted and obese student at Noctis' school, his chance encounter and care for one of Lunafreya's puppies results in him being asked by her to be Noctis' friend. By the time the two were attending high school, Prompto had slimmed down and gained new confidence, though Noctis still recognized him from an earlier encounter and accepted him as a friend.","thumbnail":"https://image.tmdb.org/t/p/w300/ilZo1WiAPuriQ1KaU2haWPbPYcj.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}},{"title":"Episodio 3","episodeNumber":3,"sourceEpisodeNumber":3,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"12053","scope":"R","episodeNumbers":[3]},{"provider":"anilist","id":"21728","episodeNumbers":[3]},{"provider":"mal","id":"33080","episodeNumbers":[3]},{"provider":"tmdb_show","id":"66987","scope":"s1","seasonNumber":1,"episodeNumbers":[3]},{"provider":"tvdb_show","id":"313185","scope":"s1","seasonNumber":1,"episodeNumbers":[3]}],"link":"25416","synopsis":"Gladiolus's origins with Noctis are shown within the frame of a monster encounter that turns into a friendly contest between Noctis and Gladiolus. Initially seeing him as a spoiled, self-centered child, Gladiolus's opinion is changed drastically when Noctis helps keep Gladiolus' sister Iris out of trouble by taking the blame for going outside the Citadel grounds with her. The two formed a close bond, which became a firm friendship by the events of XV.","thumbnail":"https://image.tmdb.org/t/p/w300/yaWlFGfxwJs4lJpXci2M92miLur.jpg","metadataSources":{"tmdb":{"title":"Episodio 3","synopsis":"Gladiolus's origins with Noctis are shown within the frame of a monster encounter that turns into a friendly contest between Noctis and Gladiolus. Initially seeing him as a spoiled, self-centered child, Gladiolus's opinion is changed drastically when Noctis helps keep Gladiolus' sister Iris out of trouble by taking the blame for going outside the Citadel grounds with her. The two formed a close bond, which became a firm friendship by the events of XV.","thumbnail":"https://image.tmdb.org/t/p/w300/yaWlFGfxwJs4lJpXci2M92miLur.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}},{"title":"Episodio 4","episodeNumber":4,"sourceEpisodeNumber":4,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"12053","scope":"R","episodeNumbers":[4]},{"provider":"anilist","id":"21728","episodeNumbers":[4]},{"provider":"mal","id":"33080","episodeNumbers":[4]},{"provider":"tmdb_show","id":"66987","scope":"s1","seasonNumber":1,"episodeNumbers":[4]},{"provider":"tvdb_show","id":"313185","scope":"s1","seasonNumber":1,"episodeNumbers":[4]}],"link":"25417","synopsis":"The origins of Ignis' relationship with Noctis is revealed when the group stays in the town of Lestallum, and Ignis attempts to recreate a favorite dessert of Noctis'. As he begins to feel the effects of maintaining Lucis' magical Wall, Regis entrusts Ignis with caring for Noctis. While initially carefree, Noctis becomes disturbed when he sees how far Regis has declined, and has an argument with Ignis when confronted with his future as king. Eventually facing his position, Noctis and Ignis reconcile.","thumbnail":"https://image.tmdb.org/t/p/w300/1Z7eD4TG1lg6NMCgajcYtYgYjIp.jpg","metadataSources":{"tmdb":{"title":"Episodio 4","synopsis":"The origins of Ignis' relationship with Noctis is revealed when the group stays in the town of Lestallum, and Ignis attempts to recreate a favorite dessert of Noctis'. As he begins to feel the effects of maintaining Lucis' magical Wall, Regis entrusts Ignis with caring for Noctis. While initially carefree, Noctis becomes disturbed when he sees how far Regis has declined, and has an argument with Ignis when confronted with his future as king. Eventually facing his position, Noctis and Ignis reconcile.","thumbnail":"https://image.tmdb.org/t/p/w300/1Z7eD4TG1lg6NMCgajcYtYgYjIp.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}},{"title":"Episodio 5","episodeNumber":5,"sourceEpisodeNumber":5,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"12053","scope":"R","episodeNumbers":[5]},{"provider":"anilist","id":"21728","episodeNumbers":[5]},{"provider":"mal","id":"33080","episodeNumbers":[5]},{"provider":"tmdb_show","id":"66987","scope":"s1","seasonNumber":1,"episodeNumbers":[5]},{"provider":"tvdb_show","id":"313185","scope":"s1","seasonNumber":1,"episodeNumbers":[5]}],"link":"25415","synopsis":"The episode picks up where \"Before the Storm\" left off, with Noctis charging at the Daemon that almost killed him. He charges at it alone, and after a fierce battle is beaten back - during the fight, he remembers everything about the first attack, including how his father only managed to drive it away. Noctis finds new resolve in these memories, and kills the Daemon with help from his companions, which causes him great emotion. The four then return to their road trip to Altissia.","thumbnail":"https://image.tmdb.org/t/p/w300/d1c11X1AONguWqcRuldViqqDw2C.jpg","metadataSources":{"tmdb":{"title":"Episodio 5","synopsis":"The episode picks up where \"Before the Storm\" left off, with Noctis charging at the Daemon that almost killed him. He charges at it alone, and after a fierce battle is beaten back - during the fight, he remembers everything about the first attack, including how his father only managed to drive it away. Noctis finds new resolve in these memories, and kills the Daemon with help from his companions, which causes him great emotion. The four then return to their road trip to Altissia.","thumbnail":"https://image.tmdb.org/t/p/w300/d1c11X1AONguWqcRuldViqqDw2C.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}}],"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-30T07:57:40Z","sourceDescriptors":["anilist:21728","mal:33080"],"imdbSource":"plexanibridge-v2","targets":[{"provider":"anidb","id":"12053","scope":"R","ranges":{"1-5":"1-5"}},{"provider":"anilist","id":"21728","ranges":{"1-5":"1-5"}},{"provider":"mal","id":"33080","ranges":{"1-5":"1-5"}},{"provider":"tmdb_show","id":"66987","scope":"s1","ranges":{"1-5":"1-5"}},{"provider":"tvdb_show","id":"313185","scope":"s1","ranges":{"1-5":"1-5"}}]},"artworkInventory":{"logo":[{"source":"cinemeta","url":"https://images.metahub.space/logo/medium/tt5595178/img"}],"poster":[{"source":"tmdb","url":"https://i