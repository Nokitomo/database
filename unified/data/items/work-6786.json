105280","ranges":{"1":"1"}}],"imdbId":"tt0302758","sourceIds":{"anilist":2133,"mal":2133},"tmdb":{"source":"tmdb-api","id":105280,"type":"movie","sourceUrl":"https://www.themoviedb.org/movie/105280","fetchedAt":"2026-11-02T19:15:22.627Z","originalLanguage":"ko-KR","title":{"value":"My Beautiful Girl, Mari","language":"en-US"},"originalTitle":"마리 이야기","overview":{"value":"Two boys find a beautiful world of magic and wonder when they find a magic marble in an old lighthouse. There they meet Mari and can escape from the growing hardships of their home lives.","language":"en-US"},"releaseDate":"2002-01-11","status":"Released","rating":6,"ratingCount":37,"genres":["Animazione","Dramma","Fantasy"],"countries":["South Korea"],"facts":{"Runtime":"86m"},"keywords":[],"networks":[],"socialLinks":{},"cast":[{"id":117377,"name":"Ryu Deok-hwan","role":"Nam-woo (voice)","profile":"https://image.tmdb.org/t/p/original/vtijRyx62mv7ECDiiXQ7tWMxkaN.jpg"},{"id":70338,"name":"Gong Hyung-jin","role":"Jun-ho (voice)","profile":"https://image.tmdb.org/t/p/original/Qr28OEOVsWTkoZOdJo11VSQmQn.jpg"},{"id":17121,"name":"Ahn Sung-ki","role":"Kyung-min (voice)","profile":"https://image.tmdb.org/t/p/original/neVI6dF7ygagu055h5OpHUZax14.jpg"},{"id":1094648,"name":"Bae Jong-ok","role":"Nam-woo's Mother (voice)","profile":"https://image.tmdb.org/t/p/original/sIn8u0JmFNd9MYqW6wgC0Rv52xY.jpg"},{"id":123808,"name":"Na Moon-hee","role":"Nam-woo's Grandmother (voice)","profile":"https://image.tmdb.org/t/p/original/ly5hCJSjgCM0i2JQ0xeWqJZSliR.jpg"},{"id":80459,"name":"Jang Hang-seon","role":"Jun-ho's Father (voice)","profile":"https://image.tmdb.org/t/p/original/lJ1CikV2Vc5LCP1HeNL7tYEz8MS.jpg"},{"id":25002,"name":"Lee Byung-hun","role":"Adult Nam-woo (voice)","profile":"https://image.tmdb.org/t/p/original/5p5LDbZtnKhXDZL5227ExukbnRo.jpg"},{"id":1999952,"name":"Lee Seok-jun","role":"Office Colleague 1 (voice)","profile":"https://image.tmdb.org/t/p/original/qkv85D7wT3C7jzQptDAfgT0gLVb.jpg"},{"id":992631,"name":"Nalie Lee","role":"Sook-i (voice)","profile":"https://image.tmdb.org/t/p/original/mmr3Njbx1r8VcjXIUR1FQReQCjN.jpg"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT"},{"language":"en-US","title":"My Beautiful Girl, Mari","overview":"Two boys find a beautiful world of magic and wonder when they find a magic marble in an old lighthouse. There they meet Mari and can escape from the growing hardships of their home lives."},{"language":"ko-KR","title":"마리 이야기","overview":"바닷가 외딴 마을. 사고로 아버지를 여의고 할머니, 엄마와 사는 열 두 살 소년 남우. 친구라곤 동갑내기 준호와 고양이 요 뿐이다. 어느날 학교 앞 문방구에서 신비한 빛을 내뿜는 구슬을 발견한다. 밤새 고민하다 다음날 사러 달려가지만 구슬은 없다. 실망한 남우. 고양이 요와 함께 등대 주위에서 놀던 남우. 요가 등대 안으로 뛰어들어간다. 고양이를 찾아 등대 안을 헤매던 남우는 선반에서 그 구슬을 발견한다. 구슬 속으로 아름다운 빛이 통과되는 순간, 갑자기 등대 안은 환상의 세계로 변하는데..나락으로 떨어지는 남우를 잡는 하얀 소녀의 손. 그리고 펼쳐지는 아름다운 빛과 소녀의 환상들... 다음날 남우는 그날 일을 준호에게 털어 놓지만 준호는 믿지 않는다. 결국 둘은 함께 등대를 방문하고 환상의 소녀 마리를 만나게 된다. 그날 이후, 둘은 아름다운 비밀을 공유한다. 그러나 두 소년이 마리와 아름다운 만남을 계속하는 동안 남우의 할머니가 병으로 쓰러지고, 마을엔 폭풍이 밀려오면서 준호의 아버지 역시 위험에 빠지는데."}],"images":{"logos":[],"posters":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/siks37YeobnEWiJxgxc3VyHE5nL.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/siks37YeobnEWiJxgxc3VyHE5nL.jpg","language":"en","width":1000,"height":1500},{"type":"poster","url":"https://image.tmdb.org/t/p/original/juDFan5ojopCf729R4mN2TZ6ORN.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/juDFan5ojopCf729R4mN2TZ6ORN.jpg","language":"en","width":1500,"height":2250},{"type":"poster","url":"https://image.tmdb.org/t/p/original/1hscqlphlooWqeh34Rfcv5RVoqB.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/1hscqlphlooWqeh34Rfcv5RVoqB.jpg","language":"ko","width":950,"height":1425}],"backdrops":[{"type":"backdrop","url":"https://image.tmdb.org/t/p/original/23XzTbjPNIrtosCvNlxCUe7gBNM.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/23XzTbjPNIrtosCvNlxCUe7gBNM.jpg","language":"en","width":1280,"height":720},{"type":"backdrop","url":"https://image.tmdb