db.org/t/p/w300/h2SYuIYe7iybaoryCjO4eZPMpOv.jpg","metadataSources":{"tmdb":{"title":"Episodio 3","synopsis":"One of the guests, Aoi, seems to have developed a crush on Natsume. Ren isn't amused.","thumbnail":"https://image.tmdb.org/t/p/w300/h2SYuIYe7iybaoryCjO4eZPMpOv.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}},{"title":"Episodio 4","episodeNumber":4,"sourceEpisodeNumber":4,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"13030","scope":"R","episodeNumbers":[4]},{"provider":"anilist","id":"98506","episodeNumbers":[4]},{"provider":"mal","id":"35241","episodeNumbers":[4]},{"provider":"tmdb_show","id":"74098","scope":"s1","seasonNumber":1,"episodeNumbers":[4]},{"provider":"tvdb_show","id":"332979","scope":"s1","seasonNumber":1,"episodeNumbers":[4]}],"link":"24781","synopsis":"Konohanatei is visited by two strange beings: a mystery egg, to which Ren wakes up found fixed to her belly, and a fast-growing child, and an elderly lady who appears to be her grandmother.","thumbnail":"https://image.tmdb.org/t/p/w300/lVhgRymOnThdovoIKwLrV4DD7i8.jpg","metadataSources":{"tmdb":{"title":"Episodio 4","synopsis":"Konohanatei is visited by two strange beings: a mystery egg, to which Ren wakes up found fixed to her belly, and a fast-growing child, and an elderly lady who appears to be her grandmother.","thumbnail":"https://image.tmdb.org/t/p/w300/lVhgRymOnThdovoIKwLrV4DD7i8.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}},{"title":"Episodio 5","episodeNumber":5,"sourceEpisodeNumber":5,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"13030","scope":"R","episodeNumbers":[5]},{"provider":"anilist","id":"98506","episodeNumbers":[5]},{"provider":"mal","id":"35241","episodeNumbers":[5]},{"provider":"tmdb_show","id":"74098","scope":"s1","seasonNumber":1,"episodeNumbers":[5]},{"provider":"tvdb_show","id":"332979","scope":"s1","seasonNumber":1,"episodeNumbers":[5]}],"link":"24783","synopsis":"A priest brings an odd Japanese doll to Konohanate