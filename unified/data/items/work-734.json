LK6Ucnm7s9Hi8YLENUyeZfFk.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}},{"title":"Episodio 4","episodeNumber":4,"sourceEpisodeNumber":4,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"6780","scope":"R","episodeNumbers":[4]},{"provider":"anilist","id":"6956","episodeNumbers":[4]},{"provider":"mal","id":"6956","episodeNumbers":[4]},{"provider":"tmdb_show","id":"46153","scope":"s1","seasonNumber":1,"episodeNumbers":[4]},{"provider":"tvdb_show","id":"145211","scope":"s1","seasonNumber":1,"episodeNumbers":[4]}],"link":"19827","synopsis":"Takanashi is visited at work by one his 4 sisters. Hiroomi the assistant cook attempts to blackmail the staff of Wagnaria so that he won't have to work. At the same time it becomes apparent that Satou the head cook has a thing for Yachiyo the head waitress.","thumbnail":"https://image.tmdb.org/t/p/w300/aODjhLH93gDTnMVwvL9K4NoHN0n.jpg","metadataSources":{"tmdb":{"title":"Episodio 4","synopsis":"Takanashi is visited at work by one his 4 sisters. Hiroomi the assistant cook attempts to blackmail the staff of Wagnaria so that he won't have to work. At the same time it becomes apparent that Satou the head cook has a thing for Yachiyo the head waitress.","thumbnail":"https://image.tmdb.org/t/p/w300/aODjhLH93gDTnMVwvL9K4NoHN0n.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}},{"title":"Episodio 5","episodeNumber":5,"sourceEpisodeNumber":5,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"6780","scope":"R","episodeNumbers":[5]},{"provider":"anilist","id":"6956","episodeNumbers":[5]},{"provider":"mal","id":"6956","episodeNumbers":[5]},{"provider":"tmdb_show","id":"46153","scope":"s1","seasonNumber":1,"episodeNumbers":[5]},{"provider":"tvdb_show","id":"145211","scope":"s1","seasonNumber":1,"episodeNumbers":[5]}],"link":"19828","synopsis":"Takanashi takes the day off work to take care of his sick sister. The staff attempts to function without them and deal with Mahiru's fear of men with no male server