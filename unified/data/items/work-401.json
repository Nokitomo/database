{"id":"work-401","sourceIds":{"anilist":20741,"mal":24655},"info":{"title":"Date A Live Movie: Mayuri Judgment","synopsis":"Seguito di Date a Live 2. Shido Itsuka, un normalissimo liceale come tanti, viene svegliato da sua sorella Kotori, convinto di affrontare un'altra normale giornata. Lo shock però è grande quando scopre che la città  in cui vive è stata devastata da una forte esplosione. La causa sembra essere una misteriosa ragazza che subito gli appare davanti, chiedendogli se è venuto anche lui per ucciderla. Shido inizia a chiamarla Tohka e scopre anche che si tratta di un essere dalle origini sconosciute, in grado di distruggere l'intera umanità , come già  stava per accadere 30 anni prima. C'è solo un modo per fermarla' uscire con lei!","image":"https://image.tmdb.org/t/p/original/66F3PsT9JzE93WDgp5Ry8KIdM4n.jpg","poster":"https://image.tmdb.org/t/p/original/tHcnoWniDIfjSkLCqLa5GjIpKfs.jpg","logo":"https://image.tmdb.org/t/p/original/fY4WUKcbogoPWrH9GS42PhRFRJr.png","background":"https://image.tmdb.org/t/p/original/66F3PsT9JzE93WDgp5Ry8KIdM4n.jpg","trailers":["https://www.youtube.com/watch?v=A_QgmkUJbd4"],"imdbId":"tt5331768","type":"movie","tags":["Movie","Terminato","Estate","2015"],"tagKeys":{"Movie":"Movie","Terminato":"Completed","Estate":"Summer"},"genres":["Action","Comedy","Ecchi","Fantasy","Harem","Mecha","Romance","Sci-fi"],"rating":"8.1","studio":"Production IMS","episodesCount":1,"extra":{"ids":{"malId":24655,"anilistId":20741,"crunchyId":null,"disneyId":null,"netflixId":null,"primeId":null,"anilistIds":[17641,20741,20767,111852,121034],"malIds":[17641,22961,24655,40416,42423],"anidbIds":[9734,10568,10688,15100],"imdbMovieIds":["tt12350118","tt5331768","tt9353846"],"imdbShowIds":[],"tmdbMovieIds":[331061,378096,685099,1608694],"tmdbShowIds":[46004],"tvdbMovieIds":[67968],"tvdbShowIds":[264663]},"stats":{"scoreRaw":"8.14","favorites":184,"members":1490,"views":37357,"episodesCountRaw":1,"episodesLength":72},"flags":{"dub":0,"alwaysHome":0},"meta