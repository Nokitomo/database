{"id":"work-1240","sourceIds":{"anilist":101382,"mal":37598},"info":{"title":"Phantom in the Twilight","synopsis":"La storia si svolge a Londra, al &quot;Café Forbidden&quot;, un caffè misterioso che apre solo di notte, un posto dove si riuniscono i guardiani del confine tra il mondo umano e quello delle ombre. La protagonista, Kana Hanazawa, è a Londra per un'esperienza di studio all'estero, incontrerà  i bellissimi uomini che lavorano in questo Café.","image":"https://image.tmdb.org/t/p/original/nXL2w7Lvd4fCseWwN46oiO2disF.jpg","poster":"https://image.tmdb.org/t/p/original/nuNAQlnZK2zZA2pZDgaVK8hz1WY.jpg","logo":"https://image.tmdb.org/t/p/original/9V061Ar6kOXeM5YMkKF3oH7gHIn.png","background":"https://image.tmdb.org/t/p/original/nXL2w7Lvd4fCseWwN46oiO2disF.jpg","trailers":["https://www.youtube.com/watch?v=F7MKqY0qJIc"],"imdbId":"tt8189276","type":"series","tags":["TV","Terminato","2018"],"tagKeys":{"TV":"TV","Terminato":"Completed"},"genres":["Action","Romance","Supernatural","Vampire"],"rating":"7.4","studio":"LIDENFILMS","episodesCount":12,"extra":{"ids":{"malId":37598,"anilistId":101382,"anilistIds":[101382],"malIds":[37598],"anidbIds":[13978],"imdbMovieIds":[],"imdbShowIds":[],"tmdbMovieIds":[],"tmdbShowIds":[80561],"tvdbMovieIds":[],"tvdbShowIds":[346945]},"stats":{"scoreRaw":"7.40","episodesCountRaw":12},"flags":{"dub":0},"meta":{"status":"Terminato","type":"TV"},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-30T07:57:40Z","sourceDescriptors":["anilist:101382","mal:37598"],"imdbSource":"plexanibridge-v2","targets":[{"provider":"anidb","id":"13978","scope":"R","ranges":{"1-12":"1-12"}},{"provider":"anilist","id":"101382","ranges":{"1-12":"1-12"}},{"provider":"mal","id":"37598","ranges":{"1-12":"1-12"}},{"provider":"tmdb_show","id":"80561","scope":"s1","ranges":{"1-12":"1-12"}},{"provider":"tvdb_show","id":"346945","scope":"s1","ranges":{"1-12":"1-12"}}]},"artworkSources":{"logo":"tmdb","poster":"tmdb","background":"tmdb"},