ckground/medium/tt8189276/img"},{"source":"anizip","url":"https://artworks.thetvdb.com/banners/fanart/original/346945-1.jpg"},{"source":"provider","url":"https://img.animeunity.co/anime/101382-mowIWyux4Qhr.jpg"},{"source":"anilist","url":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/101382-mowIWyux4Qhr.jpg"}]}},"related":[],"linkList":[{"title":"Episodes 1-12","titleKey":"Episodes {{start}}-{{end}}","titleParams":{"start":1,"end":12},"availabilityStatus":"available","episodesLink":"1497|1|12"}]},"episodes":[{"title":"Episodio 1","episodeNumber":1,"sourceEpisodeNumber":1,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"13978","scope":"R","episodeNumbers":[1]},{"provider":"anilist","id":"101382","episodeNumbers":[1]},{"provider":"mal","id":"37598","episodeNumbers":[1]},{"provider":"tmdb_show","id":"80561","scope":"s1","seasonNumber":1,"episodeNumbers":[1]},{"provider":"tvdb_show","id":"346945","scope":"s1","seasonNumber":1,"episodeNumbers":[1]}],"link":"29345","synopsis":"親友のムー・シンヤオとともにロンドンにきたバイルー・トンは、到着早々、盗難の被害にあう。犯人を追いかけ迷い込んだ店『カフェ・フォービドゥン』は、なんとトンの曽祖母が設立したカフェ。カフェの店員のブラッド、ルーク、トウリュウの3人とトンは犯人を捜すことに。犯人を目の前にした彼らは突如、吸血鬼、人狼、キョンシーという人ならざる者に変貌し…。驚くトン。しかし、いつも身に着けている、曽祖母からもらった指輪にも大きな秘密があることを知る。","thumbnail":"https://image.tmdb.org/t/p/w300/i9l9Ar4fwuRQpC5LZ0NedhBF5De.jpg","metadataSources":{"tmdb":{"title":"Episodio 1","synopsis":"親友のムー・シンヤオとともにロンドンにきたバイルー・トンは、到着早々、盗難の被害にあう。犯人を追いかけ迷い込んだ店『カフェ・フォービドゥン』は、なんとトンの曽祖母が設立したカフェ。カフェの店員のブラッド、ルーク、トウリュウの3人とトンは犯人を捜すことに。犯人を目の前にした彼らは突如、吸血鬼、人狼、キョンシーという人ならざる者に変貌し…。驚くトン。しかし、いつも身に着けている、曽祖母からもらった指輪にも大きな秘密があることを知る。","thumbnail":"https://image.tmdb.org/t/p/w300/i9l9Ar4fwuRQpC5LZ0NedhBF5De.jpg","titleLanguage":"it-IT","synopsisLanguage":"ja-JP"}}},{"title":"Episodio 2","episodeNumber":2,"sourceEpisodeNumber":2,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"13978","scope":"R","episodeNumbers":[2]},{"provider":"anilist","id":"101382","episodeNumbers":[2]},{"provider":"mal","id":"37598","episodeNumbers":[2]},{"provider":"tmdb_show","id":"80561","scope":"s1","seasonNumber":1,"episodeNumbers":[2]},{"provider":"tvdb_show","id":"346945","scope":"s1","seasonNumber":1,"episodeNumbers":[2]}],"link":"29349","synopsis":"盗難事件が解決したのも束の間、今度はシンヤオが誘拐されてしまう。親友を救うため、トンは再び『カフェ・フォービドゥン』を訪れる。カフェの3人は4人目の店員であるゴーストのウェインと刑事グレゴリーの協力で真相を解明していく…。そしてこの事件には人ならざる存在の「アンブラ」と、スマートフォンアプリ「魔法の鏡」が関係していることを知る。3人の帰りを待っていたトン。しかしスマートフォンにシンヤオが危険であることの知らせが入る。トンはひとり、親友を助けに向かうのであった。","thumbnail":"https://image.tmdb.org/t/p/w300/76VdolPBBNSZMOXIW4HkXFtnP1l.jpg","metadataSources":{"tmdb":{"title":"Episodio 2","synopsis":"盗難事件が解決したのも束の間、今度はシンヤオが誘拐されてしまう。親友を救うため、トンは再び『カフェ・フォービドゥン』を訪れる。カフェの3人は4人目の店員であるゴーストのウェインと刑事グレゴリーの協力で真相を解明していく…。そしてこの事件には人ならざる存在の「アンブラ」と、スマートフォンアプリ「魔法の鏡」が関係していることを知る。3人の帰りを待っていたトン。しかしスマートフォンにシンヤオが危険であることの知らせが入る。トンはひとり、親友を助けに向かうのであった。","thumbnail":"https://image.tmdb.org/t/p/w300/76VdolPBBNSZMOXIW4HkXFtnP1l.jpg","titleLanguage":"it-IT","synopsisLanguage":"ja-JP"}}},{"title":"Episodio 3","episodeNumber":3,"sourceEpisodeNumber":3,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"13978","scope":"R","episodeNumbers":[3]},{"provider":"anilist","id":"101382","episodeNumbers":[3]},{"provider":"mal","id":"37598","episodeNumbers":[3]},{"provider":"tmdb_show","id":"80561","scope":"s1","seasonNumber":1,"episodeNumbers":[3]},{"provider":"tvdb_show","id":"346945","scope":"s1","seasonNumber":1,"episodeNumbers":[3]}],"link":"29355","synopsis":"切り裂き魔のアンブラを倒し建物内を探すが、シンヤオの姿は消えていた。彼女の行方を探す中でトンは、カフェの４人が“人と影の共存を目指す組織”「トワイライツ」のメンバーであり、「カフェ・フォービドゥン」はそのロンドン支部であることを知る。シンヤオの行方に関して手探り状態で捜査を続けていたが、ルークだけは犯人の痕跡に見覚えがあった。ルークは秘密裏にシンヤオを攫った犯人の元へ向かう…そこにいたのは彼のよく知る青年、クリスだった。","thumbnail":"https://image.tmdb.org/t/p/w300/a3nukY4GLnB8KYPpArp0Otrdsjq.jpg","metadataSources":{"tmdb":{"title":"Episodio 3","synopsis":"切り裂き魔のアンブラを倒し建物内を探すが、シンヤオの姿は消えていた。彼女の行方を探す中でトンは、カフェの４人が“人と影の共存を目指す組織”「トワイライツ」のメンバーであり、「カフェ・フォービドゥン」はそのロンドン支部であることを知る。シンヤオの行方に関して手探り状態で捜査を続けていたが、ルークだけは犯人の痕跡に見覚えがあった。ルークは秘密裏にシンヤオを攫った犯人の元へ向かう…そこにいたのは彼のよく知る青年、クリスだった。","thumbnail":"https://image.tmdb.org/t/p/w300/a3nukY4GLnB8KYPpArp0Otrdsjq.jpg","titleLanguage":"it-IT","synopsisLanguage":"ja-JP"}}},{"title":"Episodio 4","episodeNumber":4,"sourceEpisodeNumber":4,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"13978","scope":"R","episodeNumbers":[4]},{"provider":"anilist","id":"101382","episodeNumbers":[4]},{"provider":"mal","id":"37598","episodeNumbers":[4]},{"provider":"tmdb_show","id":"80561","scope":"s1","seasonNumber":1,"episodeNumbers":[4]},{"provider":"tvdb_show","id":"346945","scope":"s1","seasonNumber":1,"episodeNumbers":[4]}],"link":"29346","synopsis":"ヘイシンに頼まれシンヤオを攫ったクリスだが、彼女を護るため隠れ家へ身を隠す。一方、トンは誘拐事件を捜査しながらもトワイライツのメンバーと親交を深めていく。そんな中、キョンシーであるトウリュウの札に秘密があることを知る。トウリュウの本来の姿は、札を剥がすことで全てを破壊し尽くし最後は自爆するように設計された「人工兵器」。トウリュウの生みの親・ヘイシンの策略により札を剥がされ暴走するトウリュウに対し、どうにか制止させようとする「トワイライツ」。万策尽きたと思われたその時、トンは指輪の力を使いトウリュウに札を張ることを試みるが…。","thumbnail":"https://image.tmdb.org/t/p/w300/vQ8CAO5CEj4xfzq06RH8BBh02Xj.jpg","metadataSources":{"tmdb":{"title":"Episodio 4","synopsis":"ヘイシンに頼まれシンヤオを攫ったクリスだが、彼女を護るため隠れ家へ身を隠す。一方、トンは誘拐事件を捜査しながらもトワイライツのメンバーと親交を深めていく。そんな中、キョンシーであるトウリュウの札に秘密があることを知る。トウリュウの本来の姿は、札を剥がすことで全てを破壊し尽くし最後は自爆するように設計された「人工兵器」。トウリュウの生みの親・ヘイシンの策略により札を剥がされ暴走するトウリュウに対し、どうにか制止させようとする「トワイライツ」。万策尽きたと思われたその時、トンは指輪の力を使いトウリュウに札を張ることを試みるが…。","thumbnail":"https://image.tmdb.org/t/p/w300/vQ8CAO5CEj4xfzq06RH8BBh02Xj.jpg","titleLanguage":"it-IT","synopsisLanguage":"ja-JP"}}},{"title":"Episodio 5","episodeNumber":5,"sourceEpisodeNumber":5,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"13978","scope":"R","episodeNumbers":[5]},{"provider":"anilist","id":"101382","episodeNumbers":[5]},{"provider":"mal","id":"37598","episodeNumbers":[5]},{"provider":"tmdb_show","id":"80561","scope":"s1","seasonNumber":1,"episodeNumbers":[5]},{"provider":"tvdb_show","id":"346945","scope":"s1","seasonNumber":1,"episodeNumbers":[5]}],"link":"29350","synopsis":"ヘイシンと別れ、クリスはシンヤオとともに隠れ家である廃病院に身を寄せていたクリスはシンヤオに「攫った人間」以上の思いを抱くようになる。一方、トンが店長となった『カフェ・フォービドゥン』にリディアという美女が訪れる。リディアは『リャナンシー』という、決して人間の恋人を作ってはいけないアンブラだった。そうとは知らず、トンは「恋人になってくれる人探し」の依頼を受けてしまう。ウェインはトンのためにリディアの要求に一番合う人を見つけるが…その人物はなんと大人気ミュージシャンのローランド・リー。実は彼はリディアの元恋人であり、未だに彼女を忘れられずいた。ローランドは彼女に会いにカフェに訪れるが…。","thumbnail":"https://image.tmdb.org/t/p/w300/me7qU0MOgExcBnUYUDUoQoEcyT1.jpg","metadataSources":{"tmdb":{"title":"Episodio 5","synopsis":"ヘイシンと別れ、クリスはシンヤオとともに隠れ家である廃病院に身を寄せていたクリスはシンヤオに「攫った人間」以上の思いを抱くようになる。一方、トンが店長となった『カフェ・フォービドゥン』にリディアという美女が訪れる。リディアは『リャナンシー』という、決して人間の恋人を作ってはいけないアンブラだった。そうとは知らず、トンは「恋人になってくれる人探し」の依頼を受けてしまう。ウェインはトンのためにリディアの要求に一番合う人を見つけるが…その人物はなんと大人気ミュージシャンのローランド・リー。実は彼はリディアの元恋人であり、未だに彼女を忘れられずいた。ローランドは彼女に会いにカフェに訪れるが…。","thumbnail":"https://image.tmdb.org/t/p/w300/me7qU0MOgExcBnUYUDUoQoEcyT1.jpg","titleLanguage":"it-IT","synopsisLanguage":"ja-JP"}}},{"title":"Episodio 6","episodeNumber":6,"sourceEpisodeNumber":6,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"13978","scope":"R","episodeNumbers":[6]},{"provider":"anilist","id":"101382","episodeNumbers":[6]},{"provider":"mal","id":"37598","episodeNumbers":[6]},{"provider":"tmdb_show","id":"80561","scope":"s1","seasonNumber":1,"episodeNumbers":[6]},{"provider":"tvdb_show","id":"346945","scope":"s1","seasonNumber":1,"episodeNumbers":[6]}],"link":"29347","synopsis":"ウェインの情報収拾のおかげで、カフェのメンバーはシンヤオの居場所を割り出すことに成功するが、13代目ヴァン・ヘルシング率いるアンブラ殲滅組織『ミッドナイトサン』が、先にシンヤオとクリスを捕えてしまう。またしてもシンヤオを救えなかったトンたち。しかしヘルシングはトンに条件を飲むのであればシンヤオを返すと告げる。その条件とは「アンブラとの交流を断ち、事件のことを全て忘れること」。ヘルシングの言葉に迷うトン…。その日の夜、トンはカフェをあとにする。","thumbnail":"https://image.tmdb.org/t/p/w300/yVgym7ZEZc4yR5P7S1gTu1oAnUu.jpg","metadataSources":{"tmdb":{"title":"Episodio 6","synopsis":"ウェインの情報収拾のおかげで、カフェのメンバーはシンヤオの居場所を割り出すことに成功するが、13代目ヴァン・ヘルシング率いるアンブラ殲滅組織『ミッドナイトサン』が、先にシンヤオとクリスを捕えてしまう。またしてもシンヤオを救えなかったトンたち。しかしヘルシングはトンに条件を飲むのであればシンヤオを返すと告げる。その条件とは「アンブラとの交流を断ち、事件のことを全て忘れること」。ヘルシングの言葉に迷うトン…。その日の夜、トンはカフェをあとにする。","thumbnail":"https://image.tmdb.org/t/p/w300/yVgym7ZEZc4yR5P7S1gTu1oAnUu.jpg","titleLanguage":"it-IT","synopsisLanguage":"ja-JP"}}},{"title":"Episodio 7","episodeNumber":7,"sourceEpisodeNumber":7,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"13978","scope":"R","episodeNumbers":[7]},{"provider":"anilist","id":"101382","episodeNumbers":[7]},{"provider":"mal","id":"37598","episodeNumbers":[7]},{"provider":"tmdb_show","id":"80561","scope":"s1","seasonNumber":1,"episodeNumbers":[7]},{"provider":"tvdb_show","id":"346945","scope":"s1","seasonNumber":1,"episodeNumbers":[7]}],"link":"29351","synopsis":"トンとシンヤオは再会を果たし、カフェへ帰ろうとするが部屋に軟禁されてしまう。ウェインの助力によって、抜け出したものの今度はウェインが「魔法の鏡」の開発者であるバックアップの罠によって、PCの中に閉じ込められてしまう。ヴラッドとヘルシングが交戦している中、逃走中のトンとシンヤオの前にヘイシンが現れる。一連の事件の黒幕は自分だとトンに伝えたヘイシンは、アンブラを使いシンヤオに刃を突き立てる。ビルから落下していくシンヤオを見て、ショックのあまりトンは指輪の力による暴走をはじめる。","thumbnail":"https://image.tmdb.org/t/p/w300/btJIuZgFLoBWEGQz1oQP3BKU2x.jpg","metadataSources":{"tmdb":{"title":"Episodio 7","synopsis":"トンとシンヤオは再会を果たし、カフェへ帰ろうとするが部屋に軟禁されてしまう。ウェインの助力によって、抜け出したものの今度はウェインが「魔法の鏡」の開発者であるバックアップの罠によって、PCの中に閉じ込められてしまう。ヴラッドとヘルシングが交戦している中、逃走中のトンとシンヤオの前にヘイシンが現れる。一連の事件の黒幕は自分だとトンに伝えたヘイシンは、アンブラを使いシンヤオに刃を突き立てる。ビルから落下していくシンヤオを見て、ショックのあまりトンは指輪の力による暴走をはじめる。","thumbnail":"https://image.tmdb.org/t/p/w300/btJIuZgFLoBWEGQz1oQP3BKU2x.jpg","titleLanguage":"it-IT","synopsisLanguage":"ja-JP"}}},{"title":"Episodio 8","episodeNumber":8,"sourceEpisodeNumber":8,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"13978","scope":"R","episodeNumbers":[8]},{"provider":"anilist","id":"101382","episodeNumbers":[8]},{"provider":"mal","id":"37598","episodeNumbers":[8]},{"provider":"tmdb_show","id":"80561","scope":"s1","seasonNumber":1,"episodeNumbers":[8]},{"provider":"tvdb_show","id":"346945","scope":"s1","seasonNumber":1,"episodeNumbers":[8]}],"link":"29352","synopsis":"力の暴走の果てに倒れたトン。数日後ようやく目覚めるが、指輪の能力の使いすぎで「シンヤオ」に関する記憶を失ってしまう。記憶を取り戻し、再び能力を使って友達の為に戦い続けるか、記憶を失ったまま普通の人間として過ごした方がいいのか…。トンの幸せに関して悩むトワイライツのメンバーは、それぞれの思いをトンに吐露していく。一方その頃、一命をとりとめたシンヤオは、クリスともにミッドナイトサンの追跡から逃げていた。ふたりの監視を続けているバックアップは、シンヤオに不思議な能力があることを気づく。シンヤオの能力にも興味を持ったヘイシンに対し、バックアップはある「ゲーム」を提案する。","thumbnail":"https://image.tmdb.org/t/p/w300/qB6j3YCPN0MSyHrfCdgvfkxZtcw.jpg","metadataSources":{"tmdb":{"title":"Episodio 8","synopsis":"力の暴走の果てに倒れたトン。数日後ようやく目覚めるが、指輪の能力の使いすぎで「シンヤオ」に関する記憶を失ってしまう。記憶を取り戻し、再び能力を使って友達の為に戦い続けるか、記憶を失ったまま普通の人間として過ごした方がいいのか…。トンの幸せに関して悩むトワイライツのメンバーは、それぞれの思いをトンに吐露していく。一方その頃、一命をとりとめたシンヤオは、クリスともにミッドナイトサンの追跡から逃げていた。ふたりの監視を続けているバックアップは、シンヤオに不思議な能力があることを気づく。シンヤオの能力にも興味を持ったヘイシンに対し、バックアップはある「ゲーム」を提案する。","thumbnail":"https://image.tmdb.org/t/p/w300/qB6j3YCPN0MSyHrfCdgvfkxZtcw.jpg","titleLanguage":"it-IT","synopsisLanguage":"ja-JP"}}},{"title":"Episodio 9","episodeNumber":9,"sourceEpisodeNumber":9,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"13978","scope":"R","episodeNumbers":[9]},{"provider":"anilist","id":"101382","episodeNumbers":[9]},{"provider":"mal","id":"37598","episodeNumbers":[9]},{"provider":"tmdb_show","id":"80561","scope":"s1","seasonNumber":1,"episodeNumbers":[9]},{"provider":"tvdb_show","id":"346945","scope":"s1","seasonNumber":1,"episodeNumbers":[9]}],"link":"29348","synopsis":"カフェのメンバーとシンヤオとクリスは、街中に監視の目を持つ「ミッドナイトサン」に気づかれないよう密かに落ち合う約束をする。同時にヘイシンとバックアップの「ゲーム」が始まる。それはどちらが先にヘイシンがトンの、バックアップがシンヤオの能力を覚醒させることができるかを競うゲームだった。トンは追っ手を撒きながらシンヤオに近づくも、ヘイシンが街中に放った強大なアンブラによって阻まれ、シンヤオか街の住人の命かを選ぶことを迫られる・・・。そんな中、皆の策も虚しくシンヤオはバックアップが操る傭兵たちに捕らえられ、クリスは銀の弾丸によって川に沈められてしまう…。","thumbnail":"https://image.tmdb.org/t/p/w300/qEITvPAvRvVlKojkq1H9NOIdOUT.jpg","metadataSources":{"tmdb":{"title":"Episodio 9","synopsis":"カフェのメンバーとシンヤオとクリスは、街中に監視の目を持つ「ミッドナイトサン」に気づかれないよう密かに落ち合う約束をする。同時にヘイシンとバックアップの「ゲーム」が始まる。それはどちらが先にヘイシンがトンの、バックアップがシンヤオの能力を覚醒させることができるかを競うゲームだった。トンは追っ手を撒きながらシンヤオに近づくも、ヘイシンが街中に放った強大なアンブラによって阻まれ、シンヤオか街の住人の命かを選ぶことを迫られる・・・。そんな中、皆の策も虚しくシンヤオはバックアップが操る傭兵たちに捕らえられ、クリスは銀の弾丸によって川に沈められてしまう…。","thumbnail":"https://image.tmdb.org/t/p/w300/qEITvPAvRvVlKojkq1H9NOIdOUT.jpg","titleLanguage":"it-IT","synopsisLanguage":"ja-JP"}}},{"title":"Episodio 10","episodeNumber":10,"sourceEpisodeNumber":10,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"13978","scope":"R","episodeNumbers":[10]},{"provider":"anilist","id":"101382","episodeNumbers":[10]},{"provider":"mal","id":"37598","episodeNumbers":[10]},{"provider":"tmdb_show","id":"80561","scope":"s1","seasonNumber":1,"episodeNumbers":[10]},{"provider":"tvdb_show","id":"346945","scope":"s1","seasonNumber":1,"episodeNumbers":[10]}],"link":"29353","synopsis":"人の困りごとを解決するアプリ『魔法の鏡』は実は人を操る為のアプリだった。その開発者、バックアップの手に落ちたシンヤオは、実験の末アンブラを吸収することによって、その能力を自らのものにすることができる身体であることがわかる。その実験結果に満足したヘイシンとバックアップは、トンとシンヤオを賭け最後の勝負をすることになる。一方、隠れ家に身を寄せたカフェメンバーは、ラストバトルに向けて自らの決意を固める。それは、トンを人間のままシンヤオと再会させること――。しかし、「力」を取り戻しアンブラになりつつあるトンは、ヴラッドの静止を振り切りシンヤオを助けに行こうとする…","thumbnail":"https://image.tmdb.org/t/p/w300/mUDroHDa6hw1cdU1yHeEpoIN2Dd.jpg","metadataSources":{"tmdb":{"title":"Episodio 10","synopsis":"人の困りごとを解決するアプリ『魔法の鏡』は実は人を操る為のアプリだった。その開発者、バックアップの手に落ちたシンヤオは、実験の末アンブラを吸収することによって、その能力を自らのものにすることができる身体であることがわかる。その実験結果に満足したヘイシンとバックアップは、トンとシンヤオを賭け最後の勝負をすることになる。一方、隠れ家に身を寄せたカフェメンバーは、ラストバトルに向けて自らの決意を固める。それは、トンを人間のままシンヤオと再会させること――。しかし、「力」を取り戻しアンブラになりつつあるトンは、ヴラッドの静止を振り切りシンヤオを助けに行こうとする…","thumbnail":"https://image.tmdb.org/t/p/w300/mUDroHDa6hw1cdU1yHeEpoIN2Dd.jpg","titleLanguage":"it-IT","synopsisLanguage":"ja-JP"}}},{"title":"Episodio 11","episodeNumber":11,"sourceEpisodeNumber":11,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"13978","scope":"R","episodeNumbers":[11]},{"provider":"anilist","id":"101382","episodeNumbers":[11]},{"provider":"mal","id":"37598","episodeNumbers":[11]},{"provider":"tmdb_show","id":"80561","scope":"s1","seasonNumber":1,"episodeNumbers":[11]},{"provider":"tvdb_show","id":"346945","scope":"s1","seasonNumber":1,"episodeNumbers":[11]}],"link":"29356","synopsis":"シンヤオを救いにアンブラの宝庫、ロンドン塔に向かうトワイライツとトン。トワイライツのメンバーは、迎え撃つヘイシンが用意した無数のアンブラに各々対峙していく。そんな中、ついにウェインとトンはシンヤオの元にたどりつくが、シンヤオはすでに多くのアンブラを吸収し、変わり果てた姿になっていた。親友であるトンにも容赦なく襲いかかるシンヤオ。ついにウェインまでトンを庇って攻撃を受けてしまう。困惑しながら危機に陥るトンを助けにきたのは敵だったはずのヘルシング。彼の助力のもとバックアップを討つことが出来たが、彼のコントロール下にあったシンヤオは暴走。トンはシンヤオを止めるため「最後の力」を使うのだった。","thumbnail":"https://image.tmdb.org/t/p/w300/kBVJwU8eytFbFLcYtPyeDRb0xAi.jpg","metadataSources":{"tmdb":{"title":"Episodio 11","synopsis":"シンヤオを救いにアンブラの宝庫、ロンドン塔に向かうトワイライツとトン。トワイライツのメンバーは、迎え撃つヘイシンが用意した無数のアンブラに各々対峙していく。そんな中、ついにウェインとトンはシンヤオの元にたどりつくが、シンヤオはすでに多くのアンブラを吸収し、変わり果てた姿になっていた。親友であるトンにも容赦なく襲いかかるシンヤオ。ついにウェインまでトンを庇って攻撃を受けてしまう。困惑しながら危機に陥るトンを助けにきたのは敵だったはずのヘルシング。彼の助力のもとバックアップを討つことが出来たが、彼のコントロール下にあったシンヤオは暴走。トンはシンヤオを止めるため「最後の力」を使うのだった。","thumbnail":"https://image.tmdb.org/t/p/w300/kBVJwU8eytFbFLcYtPyeDRb0xAi.jpg","titleLanguage":"it-IT","synopsisLanguage":"ja-JP"}}},{"title":"Episodio 12","episodeNumber":12,"sourceEpisodeNumber":12,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"13978","scope":"R","episodeNumbers":[12]},{"provider":"anilist","id":"101382","episodeNumbers":[12]},{"provider":"mal","id":"37598","episodeNumbers":[12]},{"provider":"tmdb_show","id":"80561","scope":"s1","seasonNumber":1,"episodeNumbers":[12]},{"provider":"tvdb_show","id":"346945","scope":"s1","seasonNumber":1,"episodeNumbers":[12]}],"link":"29354","synopsis":"ルーク、トウリュウ、クリスは、ヘイシンの生命エネルギーで何度も再生を繰り返す巨大ゴーレムとの戦いに挑むことに。一方、トンはシンヤオを止める方法が体内に埋められている装置を破壊することだと知り、破壊を試みるもうまくいかない。諦めそうになったその時、ヴラッドが現れシンヤオから装置を外すことに成功する。しかし戦いで力を使いすぎたトンはすでにアンブラになる一歩手前の状態となっていた。ヴラッドは「私の元に帰ってこい」と長年の禁を解き、トンの首元に鋭い牙を近づけていくーー…。","thumbnail":"https://image.tmdb.org/t/p/w300/mlcA9BLWdT7WFB7HCs2GR6APaWt.jpg","metadataSources":{"tmdb":{"title":"Episodio 12","synopsis":"ルーク、トウリュウ、クリスは、ヘイシンの生命エネルギーで何度も再生を繰り返す巨大ゴーレムとの戦いに挑むことに。一方、トンはシンヤオを止める方法が体内に埋められている装置を破壊することだと知り、破壊を試みるもうまくいかない。諦めそうになったその時、ヴラッドが現れシンヤオから装置を外すことに成功する。しかし戦いで力を使いすぎたトンはすでにアンブラになる一歩手前の状態となっていた。ヴラッドは「私の元に帰ってこい」と長年の禁を解き、トンの首元に鋭い牙を近づけていくーー…。","thumbnail":"https://image.tmdb.org/t/p/w300/mlcA9BLWdT7WFB7HCs2GR6APaWt.jpg","titleLanguage":"it-IT","synopsisLanguage":"ja-JP"}}}],"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-30T07:57:40Z","sourceDescriptors":["anilist:101382","mal:37598"],"imdbSource":"plexanibridge-v2","targets":[{"provider":"anidb","id":"13