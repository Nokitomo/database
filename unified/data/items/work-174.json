{"id":"work-174","sourceIds":{"anilist":20717,"mal":24135},"info":{"title":"Nobunaga Concerto","synopsis":"Dopo una caduta Saburō, uno svogliato studente delle superiori, subisce un salto temporale trovandosi nel passato, nell'epoca Sengoku. Qui incontra un giovane Oda Nobunaga, il futuro condottiero unificatore del Giappone e dall'aspetto identico a lui. Nobunaga, stanco e in fuga dalla noiosa vita di corte, chiede a Saburō di prendere il suo posto. Per trovare un modo per tornare nel presente, Saburō inizia la sua vita da Oda Nobunaga con il compito di unificare il Giappone, cercando di non alterare la storia.","image":"https://image.tmdb.org/t/p/original/6Nls77iKuRKHkRb1OOMenXqKwoR.jpg","poster":"https://image.tmdb.org/t/p/original/9rTkNmQMTS8NldzqFcsZL9RcZEU.jpg","logo":"https://artworks.thetvdb.com/banners/v4/series/281946/clearlogo/612045e8520ec.png","background":"https://image.tmdb.org/t/p/original/6Nls77iKuRKHkRb1OOMenXqKwoR.jpg","imdbId":"","type":"series","tags":["TV","Terminato","Estate","2014"],"tagKeys":{"TV":"TV","Terminato":"Completed","Estate":"Summer"},"genres":["Comedy","Historical","Romance","Shounen"],"rating":"7.4","studio":"Fuji TV","episodesCount":10,"extra":{"ids":{"malId":24135,"anilistId":20717,"crunchyId":null,"disneyId":null,"netflixId":null,"primeId":null,"anilistIds":[20717],"malIds":[24135],"anidbIds":[10624],"imdbMovieIds":[],"imdbShowIds":[],"tmdbMovieIds":[],"tmdbShowIds":[62911],"tvdbMovieIds":[],"tvdbShowIds":[281946]},"stats":{"scoreRaw":"7.36","favorites":30,"members":217,"views":17775,"episodesCountRaw":10,"episodesLength":22},"flags":{"dub":0,"alwaysHome":0},"meta":{"day":"Indeterminato","season":"Estate","status":"Terminato","type":"TV","createdAt":"2018-09-25 11:46:29","userId":78495},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-30T07:57:40Z","sourceDescriptors":["anilist:20717","mal:24135"],"targets":[{"provider":"anidb","id":"10624","scope":"R","ranges":{"1-10":"1-10"}},{"provider":"an