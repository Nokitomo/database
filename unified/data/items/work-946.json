VKUJik4ZYXN4myxHj5dou370.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}},{"title":"Episodio 12","episodeNumber":2,"sourceEpisodeNumber":2,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"10571","scope":"R","episodeNumbers":[2]},{"provider":"anilist","id":"20595","episodeNumbers":[2]},{"provider":"anilist","id":"20751","episodeNumbers":[2]},{"provider":"mal","id":"21939","episodeNumbers":[2]},{"provider":"mal","id":"24701","episodeNumbers":[2]},{"provider":"tmdb_show","id":"26867","scope":"s2","seasonNumber":2,"episodeNumbers":[12]},{"provider":"tvdb_show","id":"79214","scope":"s2","seasonNumber":2,"episodeNumbers":[12]}],"link":"22571","synopsis":"A man feels something vaguely familiar, yet terrifying, as he smells the scent of flowers at night. As an old man, walking through the woods, he finds a tunnel, and is compelled to enter it. While going through it, he reminisces about important events in his life up to that point, but it seems there is something he can't quite recall. Perhaps long ago, the visit of a traveler looking for shelter on a rainy day, might help shed light on the unsettled feeling he has.","thumbnail":"https://image.tmdb.org/t/p/w300/xKPIqYvIDlLmEeI0zrfsALEjhxH.jpg","metadataSources":{"tmdb":{"title":"Episodio 12","synopsis":"A man feels something vaguely familiar, yet terrifying, as he smells the scent of flowers at night. As an old man, walking through the woods, he finds a tunnel, and is compelled to enter it. While going through it, he reminisces about important events in his life up to that point, but it seems there is something he can't quite recall. Perhaps long ago, the visit of a traveler looking for shelter on a rainy day, might help shed light on the unsettled feeling he has.","thumbnail":"https://image.tmdb.org/t/p/w300/xKPIqYvIDlLmEeI0zrfsALEjhxH.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}},{"title":"Episodio 13","episodeNumber":3,"sourceEpisodeNumber":3,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"10571","scope":"R","episodeNumbers":[3]},{"provider":"anilist","id":"20595","episodeNumbers":[3]},{"provider":"anilist","id":"20751","episodeNumbers":[3]},{"provider":"mal","id":"21939","episodeNumbers":[3]},{"provider":"mal","id":"24701","episodeNumbers":[3]},{"provider":"tmdb_show","id":"26867","scope":"s2","seasonNumber":2,"episodeNumbers":[13]},{"provider":"tvdb_show","id":"79214","scope":"s2","seasonNumber":2,"episodeNumbers":[13]}],"link":"22573","synopsis":"At dusk, about to go home after playing with her friends, a young girl named Akane found a shadow without a caster. On that same day, she disappeared. Several years later, Ginko is told the story of Mikage, a girl who appeared with no memories at Akane's village shortly after the vanishing of the latter.","thumbnail":"https://image.tmdb.org/t/p/w300/3AAOHpSPwLXQRb3wyfboby3wEfm.jpg","metadataSources":{"tmdb":{"title":"Episodio 13","synopsis":"At dusk, about to go home after playing with her friends, a young girl named Akane found a shadow without a caster. On that same day, she disappeared. Several years later, Ginko is told the story of Mikage, a girl who appeared with no memories at Akane's village shortly after the vanishing of the latter.","thumbnail":"https://image.tmdb.org/t/p/w300/3AAOHpSPwLXQRb3wyfboby3wEfm.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}},{"title":"Episodio 14","episodeNumber":4,"sourceEpisodeNumber":4,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"10571","scope":"R","episodeNumbers":[4]},{"provider":"anilist","id":"20595","episodeNumbers":[4]},{"provider":"anilist","id":"20751","episodeNumbers":[4]},{"provider":"mal","id":"21939","episodeNumbers":[4]},{"provider":"mal","id":"24701","episodeNumbers":[4]},{"provider":"tmdb_show","id":"26867","scope":"s2","seasonNumber":2,"episodeNumbers":[14]},{"provider":"tvdb_show","id":"79214","scope":"s2","seasonNumber":2,"episodeNumbers":[14]}],"link":"22575","synopsis":"Yura and Sumi, the former's caretaker, were close friends. Eventually, as they were moved apart, Yura could still feel Sumi's presence. However, whenever that happened, she'd become like an empty shell, worrying her father. As Ginko comes to know of the case, he proceeds to offer them advice, as the condition is caused by a mushi that can connect people's minds.","thumbnail":"https://image.tmdb.org/t/p/w300/wopVWoEskAhkM7vLeubIw7ZTrQJ.jpg","metadataSources":{"tmdb":{"title":"Episodio 14","synopsis":"Yura and Sumi, the former's caretaker, were close friends. Eventually, as they were moved apart, Yura could still feel Sumi's presence. However, whenever that happened, she'd become like an empty shell, worrying her father. As Ginko comes to know of the case, he proceeds to offer them advice, as the condition is caused by a mushi that can connect people's minds.","thumbnail":"https://image.tmdb.org/t/p/w300/wopVWoEskAhkM7vLeubIw7ZTrQJ.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}},{"title":"Episodio 15","episodeNumber":5,"sourceEpisodeNumber":5,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"10571","scope":"R","episodeNumbers":[5]},{"provider":"anilist","id":"20595","episodeNumbers":[5]},{"provider":"anilist","id":"20751","episodeNumbers":[5]},{"provider":"mal","id":"21939","episodeNumbers":[5]},{"provider":"mal","id":"24701","episodeNumbers":[5]},{"provider":"tmdb_show","id":"26867","scope":"s2","seasonNumber":2,"episodeNumbers":[15]},{"provider":"tvdb_show","id":"79214","scope":"s2","seasonNumber":2,"episodeNumbers":[15]}],"link":"22574","synopsis":"A young boy named Gen troubles his father by being too rough with other kids, who pick on him due to his absent mother. The child, too strong for his age, also claims to be able to see strange creatures that no one else sees. As Ginko arrives at Gen's place, the story behind Gen's strength is revealed as the mushishi recounts the day he met a woman who'd woven a mysterious seamless garment.","thumbnail":"https://image.tmdb.org/t/p/w300/sDEp6OwSCWIwsJXcRhPlthvYrjY.jpg","metadataSources":{"tmdb":{"title":"Episodio 15","synopsis":"A young boy named Gen troubles his father by being too rough with other kids, who pick on him due to his absent mother. The child, too strong for his age, also claims to be able to see strange creatures that no one else sees. As Ginko arrives at Gen's place, the story behind Gen's strength is revealed as the mushishi recounts the day he met a woman who'd woven a mysterious seamless garment.","thumbnail":"https://image.tmdb.org/t/p/w300/sDEp6OwSCWIwsJXcRhPlthvYrjY.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}},{"title":"Episodio 16","episodeNumber":6,"sourceEpisodeNumber":6,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"10571","scope":"R","episodeNumbers":[6]},{"provider":"anilist","id":"20595","episodeNumbers":[6]},{"provider":"anilist","id":"20751","episodeNumbers":[6]},{"provider":"mal","id":"21939","episodeNumbers":[6]},{"provider":"mal","id":"24701","episodeNumbers":[6]},{"provider":"tmdb_show","id":"26867","scope":"s2","seasonNumber":2,"episodeNumbers":[16]},{"provider":"tvdb_show","id":"79214","scope":"s2","seasonNumber":2,"episodeNumbers":[16]}],"link":"22576","synopsis":"Izumi is alone in a world that mirrors our own. Having forgotten how she came to be there, she remains trapped while her family searches in vain. Her father believes she has been kidnapped, while her mother and sister Mizuho believe that she is still inside the house, even though they cannot see her. Ginko crosses into the other world to try to save her.","thumbnail":"https://image.tmdb.org/t/p/w300/koyfxmbfLQXEhqpe6HAojzsSPHa.jpg","metadataSources":{"tmdb":{"title":"Episodio 16","synopsis":"Izumi is alone in a world that mirrors our own. Having forgotten how she came to be there, she remains trapped while her family searches in vain. Her father believes she has been kidnapped, while her mother and sister Mizuho believe that she is still inside the house, even though they cannot see her. Ginko crosses into the other world to try to save her.","thumbnail":"https://image.tmdb.org/t/p/w300/koyfxmbfLQXEhqpe6HAojzsSPHa.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}},{"title":"Episodio 17","episodeNumber":7,"sourceEpisodeNumber":7,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"10571","scope":"R","episodeNumbers":[7]},{"provider":"anilist","id":"20595","episodeNumbers":[7]},{"provider":"anilist","id":"20751","episodeNumbers":[7]},{"provider":"mal","id":"21939","episodeNumbers":[7]},{"provider":"mal","id":"24701","episodeNumbers":[7]},{"provider":"tmdb_show","id":"26867","scope":"s2","seasonNumber":2,"episodeNumbers":[17]},{"provider":"tvdb_show","id":"79214","scope":"s2","seasonNumber":2,"episodeNumbers":[17]}],"link":"22577","synopsis":"Ginko encounters Yuuta, a boy who is excellent at swimming and fishing but has webbed hands and cold skin. After discovering the boy's unnatural affinity for water, he sets out to treat the rain mushi causing his strange behavior.","thumbnail":"https://image.tmdb.org/t/p/w300/njrvvQHUHzSbuPMFtJrZuRKFb0U.jpg","metadataSources":{"tmdb":{"title":"Episodio 17","synopsis":"Ginko encounters Yuuta, a boy who is excellent at swimming and fishing but has webbed hands and cold skin. After discovering the boy's unnatural affinity for water, he sets out to treat the rain mushi causing his strange behavior.","thumbnail":"https://image.tmdb.org/t/p/w300/njrvvQHUHzSbuPMFtJrZuRKFb0U.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}},{"title":"Episodio 18","episodeNumber":8,"sourceEpisodeNumber":8,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"10571","scope":"R","episodeNumbers":[8]},{"provider":"anilist","id":"20595","episodeNumbers":[8]},{"provider":"anilist","id":"20751","episodeNumbers":[8]},{"provider":"mal","id":"21939","episodeNumbers":[8]},{"provider":"mal","id":"24701","episodeNumbers":[8]},{"provider":"tmdb_show","id":"26867","scope":"s2","seasonNumb