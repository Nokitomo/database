{"id":"work-4215","sourceIds":{"anilist":3835,"mal":3835},"info":{"title":"Cuore (ITA)","synopsis":"Enrico Pocchini è uno scolaro dal cuore gentile e con un forte senso di giustizia che vive nella città italiana di Torino. All'inizio di un nuovo anno scolastico, perde la sua amata insegnante, Miss Delacci, che viene sostituita dal sevoro maestro Pelboni. Alla fine, i ragazzi della classe di Enrico iniziano a seguire e rispettare il nuovo maestro e imparano l'amore, la vita e la gentilezza umana.","image":"https://image.tmdb.org/t/p/original/9wApKJVXJTfsUIGz5vKXnZFiLtR.jpg","poster":"https://image.tmdb.org/t/p/original/tIGwxlUrfndjhgpY0o6CUtF0MWl.jpg","logo":"https://images.metahub.space/logo/medium/tt0296297/img","background":"https://image.tmdb.org/t/p/original/9wApKJVXJTfsUIGz5vKXnZFiLtR.jpg","imdbId":"tt0296297","type":"series","tags":["TV","Terminato","Primavera","1981"],"tagKeys":{"TV":"TV","Terminato":"Completed","Primavera":"Spring"},"genres":["Drama","Historical","School","Slice of Life"],"rating":"8.4","studio":"Nippon Animation","episodesCount":26,"extra":{"ids":{"malId":3835,"anilistId":3835,"crunchyId":null,"disneyId":null,"netflixId":null,"primeId":null,"anilistIds":[3835],"malIds":[3835],"anidbIds":[3057],"imdbMovieIds":[],"imdbShowIds":[],"tmdbMovieIds":[],"tmdbShowIds":[20895],"tvdbMovieIds":[],"tvdbShowIds":[251722]},"stats":{"scoreRaw":"8.44","favorites":18,"members":66,"views":11517,"episodesCountRaw":26,"episodesLength":20},"flags":{"dub":1,"alwaysHome":0},"meta":{"day":"Indeterminato","season":"Primavera","status":"Terminato","type":"TV","createdAt":"2023-12-02 01:38:47","userId":2},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-30T07:57:40Z","sourceDescriptors":["anilist:3835","mal:3835"],"imdbSource":"plexanibridge-v2","targets":[{"provider":"anidb","id":"3057","scope":"R","ranges":{"1-26":"1-26"}},{"provider":"anilist","id":"3835","ranges":{"1-26":"1-26"}},{"provider":"mal","id":"3835","ranges":{"1-26":"1-2