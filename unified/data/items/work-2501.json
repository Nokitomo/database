iants":[{"status":"subbed","statusKey":"Subbed","title":"Chaos;Child: Silent Sky","link":"/anime/3084-chaoschild-silent-sky","image":"https://img.animeunity.co/anime/nx98576-DEb7XbyaP5qh.jpg"}]}],"linkList":[{"title":"Stagione 1","seasonNumber":1,"availabilityStatus":"available","episodesLink":"2868|1|12|tmdb_show%3A69239%3As1"}]},"episodes":[{"link":"48952","sourceEpisodeLabel":"0-1","title":"Episode 0-1","metadataMappingStatus":"unresolved","metadataMappingReason":"provider-episode-identity-required","thumbnailFallback":{"type":"series-background"}},{"title":"Sumo Sticker","episodeNumber":2,"sourceEpisodeNumber":2,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"11166","scope":"R","episodeNumbers":[1,2]},{"provider":"anilist","id":"21126","episodeNumbers":[3]},{"provider":"mal","id":"30485","episodeNumbers":[1]},{"provider":"tmdb_show","id":"69239","scope":"s1","seasonNumber":1,"episodeNumbers":[1,2]},{"provider":"tvdb_show","id":"320459","scope":"s1","seasonNumber":1,"episodeNumbers":[1,2]}],"link":"48953","metadataSources":{"tmdb":{}},"synopsis":"After Takuru is taken in by the police, Kurusu wants him to give up the case. But he's noticed something... the sumo stickers that have been placed all around town have something in common with the murder scenes. He puts up a hidden camera near a wall of sumo stickers that just appeared. But when Kurusu finds out, she leaves in the middle of the night to take it down...","thumbnail":"https://artworks.thetvdb.com/banners/episodes/320459/5933249.jpg"},{"title":"School Festival","episodeNumber":3,"sourceEpisodeNumber":3,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"11166","scope":"R","episodeNumbers":[2,3]},{"provider":"anilist","id":"21126","episodeNumbers":[4]},{"provider":"mal","id":"30485","episodeNumbers":[2]},{"provider":"tmdb_show","id":"69239","scope":"s1","seasonNumber":1,"episodeNumbers":[2,3]},{"provider":"tvdb_show","id":"320459","scope":"s1","seasonNumber":1,"episodeNumbers":[2,3]}],"link":"48954","metadataSources":{"tmdb":{}},"synopsis":"After Kurusu is stabbed, the newspaper club is placed on hiatus. But Watabe, an important reporter with Niconiya News, wants to interview them about the things they've noticed with the sumo stickers and the hotel murder. Watabe's visit to the school, however, takes an unexpected and terrifying turn...","thumbnail":"https://artworks.thetvdb.com/banners/episodes/320459/5933250.jpg"},{"title":"Her Words","episodeNumber":4,"sourceEpisodeNumber":4,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"11166","scope":"R","episodeNumbers":[3,4]},{"provider":"anilist","id":"21126","episodeNumbers":[5]},{"provider":"mal","id":"30485","episodeNumbers":[3]},{"provider":"tmdb_show","id":"69239","scope":"s1","seasonNumber":1,"episodeNumbers":[3,4]},{"provider":"tvdb_show","id":"320459","scope":"s1","seasonNumber":1,"episodeNumbers":[3,4]}],"link":"48955","metadataSources":{"tmdb":{}},"synopsis":"After Kurusu is stabbed, Takuru infiltrates AH Tokyo General Hospital, hoping to find the creator of the sumo stickers. When he gets there, he, Onoe, and Itou are forced to hide in the basement to avoid being spotted. Inside the basement's autopsy room, they find a secret entrance that leads to an underground laboratory where terrible experiments were once conducted. Takuru thinks he's been here before...","thumbnail":"https://artworks.thetvdb.com/banners/episodes/320459/5933251.jpg"},{"title":"Gigalomaniacs","episodeNumber":5,"sourceEpisodeNumber":5,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"11166","scope":"R","episodeNumbers":[4,5]},{"provider":"anilist","id":"21126","episodeNumbers":[6]},{"provider":"mal","id":"30485","episodeNumbers":[4]},{"provider":"tmdb_show","id":"69239","scope":"s1","seasonNumber":1,"episodeNumbers":[4,5]},{"provider":"tvdb_show","id":"320459","scope":"s1","seasonNumber":1,"episodeNumbers":[4,5]}],"link":"48956","metadataSources":{"tmdb":{}},"synopsis":"Takuru and the others find a survivor in the basement of the hospital. Her name is Uki Yamazoe, and she's a young girl who looks to be around 10 years old. After seeing how Takuru was able to infiltrate the hospital, Kunosato realizes that he must be a \"Gigalomaniac\", a psychic with the power to make his delusions reality. But being a psychic doesn't come with just benefits, as one night he runs into someone who is trying to kill him...","thumbnail":"https://artworks.thetvdb.com/banners/episodes/320459/5958941.jpg"},{"title":"Their Resistance","episodeNumber":6,"sourceEpisodeNumber":6,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"11166","scope":"R","episodeNumbers":[5,6]},{"provider":"anilist","id":"21126","episodeNumbers":[7]},{"provider":"mal","id":"30485","episodeNumbers":[5]},{"provider":"tmdb_show","id":"69239","scope":"s1","seasonNumber":1,"episodeNumbers":[5,6]},{"provider":"tvdb_show","id":"320459","scope":"s1","seasonNumber":1,"episodeNumbers":[5,6]}],"link":"48957","metadataSources":{"tmdb":{}},"synopsis":"It's October 23rd, the day of the New Generation Madness incident, and it's time for the next murder. Takuru and his friends are terrified that they're going to be a target, and so they stay up all night at Cafe LAX. But when Takuru opens the cafe menu once last time in the late hours of the evening, he finds a Sumo Sticker stuck to one of the pages...","thumbnail":"https://artworks.thetvdb.com/banners/episodes/320459/5958942.jpg"},{"title":"Episode 7","titleKey":"Episode {{number}}","titleParams":{"number":"7"},"episodeNumber":7,"sourceEpisodeNumber":7,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"11166","scope":"R","episodeNumbers":[6,7]},{"provider":"anilist","id":"21126","episodeNumbers":[8]},{"provider":"mal","id":"30485","episodeNumbers":[6]},{"provider":"tmdb_show","id":"69239","scope":"s1","seasonNumber":1,"episodeNumbers":[6,7]},{"provider":"tvdb_show","id":"320459","scope":"s1","seasonNumber":1,"episodeNumbers":[6,7]}],"link":"48958","metadataSources":{"tmdb":{}},"synopsis":"Senri Minamisawa is dead. She became the fifth victim of the New Generation Madness, commiting suicide by impaling herself on a piece of rebar and then setting herself on fire in her own locked apartment. Takuru and his friends are relieved, but at the same time uncertain that it's really over. Just in case, they decide to stay together on the day of the next murder. Everyone hides out at Aoba Clinic, where it should be safe, but then Yui and Itou go missing...","thumbnail":"https://artworks.thetvdb.com/banners/episodes/320459/5958943.jpg"},{"title":"Heads or Tails","episodeNumber":8,"sourceEpisodeNumber":8,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"11166","scope":"R","episodeNumbers":[7,8]},{"provider":"anilist","id":"21126","episodeNumbers":[9]},{"provider":"mal","id":"30485","episodeNumbers":[7]},{"provider":"tmdb_show","id":"69239","scope":"s1","seasonNumber":1,"episodeNumbers":[7,8]},{"provider":"tvdb_show","id":"320459","scope":"s1","seasonNumber":1,"episodeNumbers":[7,8]}],"link":"48959","metadataSources":{"tmdb":{}},"synopsis":"After Yui's death, Takuru's family tries its best to recover. Kurusu makes a shocking admission to Takuru that she's been hiding something from him ever since he met her. She's willing to do anything to find the killer, and she's getting very, very close...","thumbnail":"https://artworks.thetvdb.com/banners/episodes/320459/5958944.jpg"},{"title":"Duel","episodeNumber":9,"sourceEpisodeNumber":9,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"11166","scope":"R","episodeNumbers":[8,9]},{"provider":"anilist","id":"21126","episodeNumbers":[10]},{"provider":"mal","id":"30485","episodeNumbers":[8]},{"provider":"tmdb_show","id":"69239","scope":"s1","seasonNumber":1,"episodeNumbers":[8,9]},{"provider":"tvdb_show","id":"320459","scope":"s1","seasonNumber":1,"episodeNumbers":[8,9]}],"link":"48960","metadataSources":{"tmdb":{}},"synopsis":"Kurusu has tracked down the identity of the killer, and revealed her secret to Takuru. Now she goes to the school to meet with the one behind all the murders.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/320459/5988988.jpg"},{"title":"Memories Stalk You from the Past","episodeNumber":10,"sourceEpisodeNumber":10,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"11166","scope":"R","episodeNumbers":[9,10]},{"provider":"anilist","id":"21126","episodeNumbers":[11]},{"provider":"mal","id":"30485","episodeNumbers":[9]},{"provider":"tmdb_show","id":"69239","scope":"s1","seasonNumber":1,"episodeNumbers":[9,10]},{"provider":"tvdb_show","id":"320459","scope":"s1","seasonNumber":1,"episodeNumbers":[9,10]}],"link":"48961","metadataSources":{"tmdb":{}},"synopsis":"Takuru is forced to confront his own involvement in the case, and the secrets of his past. He was a neglected and abused child, who turned to an imaginary friend for support. This decision has terrible consequences during the Shibuya Earthquake.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/320459/5988989.jpg"},{"title":"Takuru Miyashiro","episodeNumber":11,"sourceEpisodeNumber":11,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"11166","scope":"R","episodeNumbers":[10,11]},{"provider":"anilist","id":"21126","episodeNumbers":[12]},{"provider":"mal","id":"30485","episodeNumbers":[10]},{"provider":"tmdb_show","id":"69239","scope":"s1","seasonNumber":1,"episodeNumbers":[10,11]},{"provider":"tvdb_show","id":"320459","scope":"s1","seasonNumber":1,"episodeNumbers":[10,11]}],"link":"48962","metadataSources":{"tmdb":{}},"synopsis":"\"Let's meet at the place where it all began.\" The true plot is revealed as Takuru travels to the Hikariwo. There he meets the other person behind the series of brutal killings. But a deeper mystery lurks in the background: what Serika is telling him doesn't make sense, and he's convinced that as horrible as the story is, there's more to it than even he knows.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/320459/5988990.jpg"},{"title":"Serika Onoe","episodeNumber":12,"sourceEpisodeNumber":12,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"11166","scope":"R","episodeNumbers":[11,12]},{"provider":"anilist","id":"21126","episodeNumbers":[13]},{"provider":"mal","id":"30485","episodeNumbers":[11]},{"provider":"tmdb_show","id":"69239","scope":"s1","seasonNumber":1,"episodeNumbers":[11,12]},{"provider":"tvdb_show","id":"320459","scope":"s1","seasonNumber":1,"episodeNumbers":[11,12]}],"link":"48963","metadataSources":{"tmdb":{}},"synopsis":"The final battle takes place in the Hikariwo theater, where Takuru is trapped in a sightless and soundless prison in his own mind. He'll need Onoe's help to break free, but after what he knows about her, can he bring himself to ask for it?","thumbnail":"https://artworks.thetvdb.com/banners/episodes/320459/5988991.jpg"}],"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-30T07:57:40Z","sourceDescriptors":["anilist:21126","mal:30485"],"imdbSource":"plexanibridge-v2","targets":[{"provider":"anidb","id":"11166","scope":"R","ranges":{"2-13":"1-12","1-12":"1-12"}},{"provider":"anidb","id":"13057","scope":"R"},{"provider":"anilist","id":"21126","ranges":{"1-12":"2-13"}},{"provider":"anilist","id":"98576"},{"provider":"imdb_movie","id":"tt7504716"},{"provider":"mal","id":"30485","ranges":{"2-13":"1-12"}},{"provider":"mal","id":"35315"},{"provider":"tmdb_show","id":"69239","scope":"s0","ranges":{"1":"1"}},{"provider":"tmdb_show","id":"69239","scope":"s1","ranges":{"2-13":"1-12","1-12":"1-12"}},{"provider":"tvdb_show","id":"320459","scope":"s0","ranges":{"1":"1"}},{"provider":"tvdb_show","id":"320459","scope":"s1","ranges":{"2-13":"1-12","1-12":"1-12"}}]},"artworkInventory":{"logo":[{"source":"tmdb","url":"https://image.tmdb.org/t/p/original/8EyJD2bsXf5VkpaaTPzWtd21TEl.png"},{"source":"cinemeta","url":"https://images.metahub.space/logo/medium/tt6813314