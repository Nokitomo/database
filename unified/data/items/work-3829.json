{"id":"work-3829","sourceIds":{"anilist":840,"mal":840},"info":{"title":"The World of Narue","synopsis":"Narue è una simpatica ragazzina di quattordici anni figlia di un uomo venuto da un altro pianeta e di una donna terrestre; a causa della sua particolare discendenza, inoltre, Narue è in possesso di super-poteri che può sfruttare per combattere androidi o altri alieni. Un giorno la ragazzina salva il suo compagno Kazuto Izuka dall'aggressione di un cane-alieno; il ragazzo si innamorerà di lei e, nonostante la sua particolare natura, le chiederà di uscire.","image":"https://image.tmdb.org/t/p/original/8qRbpfpGcewRxlM4o5FeQV6B3Yj.jpg","poster":"https://image.tmdb.org/t/p/original/zWQpGMRnSTNiipk0ZfafihDkpo.jpg","logo":"https://image.tmdb.org/t/p/original/qTunG0XXDO47DuKdE0OKcQPFD8.png","background":"https://image.tmdb.org/t/p/original/8qRbpfpGcewRxlM4o5FeQV6B3Yj.jpg","imdbId":"tt0411041","type":"series","tags":["TV","Terminato","Primavera","2003"],"tagKeys":{"TV":"TV","Terminato":"Completed","Primavera":"Spring"},"genres":["Comedy","Romance","Sci-fi","Shounen"],"rating":"7.1","studio":"Studio Live","episodesCount":12,"extra":{"ids":{"malId":840,"anilistId":840,"crunchyId":null,"disneyId":null,"netflixId":null,"primeId":null,"anilistIds":[840],"malIds":[840],"anidbIds":[586],"imdbMovieIds":[],"imdbShowIds":[],"tmdbMovieIds":[],"tmdbShowIds":[34068],"tvdbMovieIds":[],"tvdbShowIds":[111071]},"stats":{"scoreRaw":"7.13","favorites":10,"members":62,"views":10290,"episodesCountRaw":12,"episodesLength":24},"flags":{"dub":0,"alwaysHome":0},"meta":{"day":"Indeterminato","season":"Primavera","status":"Terminato","type":"TV","createdAt":"2023-03-12 17:38:37","userId":2},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-30T07:57:40Z","sourceDescriptors":["anilist:840","mal:840"],"imdbSource":"plexanibridge-v2","targets":[{"provider":"anidb","id":"586","scope":"R","ranges":{"1-12":"1-12"}},{"provider":"anilist","id":"840","ranges":{"1-12":"1-12"}}