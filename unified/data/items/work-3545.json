{"id":"work-3545","sourceIds":{"anilist":107069,"mal":37936},"info":{"title":"Fog Hill of Five Elements","synopsis":"Secondo una leggenda del passato, dei mostri sono in grado di conferire al alcuni prescelti la capacità di controllare i cinque elementi, ma per poter ottenere quest'abilità è necessario attraversare delle pericolose montagne immerse nella nebbia.","image":"https://image.tmdb.org/t/p/original/spVZhtbHTb4aAPiZFu0dPq5IucH.jpg","poster":"https://image.tmdb.org/t/p/original/oigvdCYC4x9pPqJQCmSyA1oHo5P.jpg","logo":"https://image.tmdb.org/t/p/original/vebZ32aeubzLbhIpTCbxQMyeKMi.png","background":"https://image.tmdb.org/t/p/original/spVZhtbHTb4aAPiZFu0dPq5IucH.jpg","trailers":["https://www.youtube.com/watch?v=6GUgHZMXYnw"],"imdbId":"","type":"series","tags":["ONA","Terminato","Inverno","2020"],"tagKeys":{"ONA":"ONA","Terminato":"Completed","Inverno":"Winter"},"genres":["Action","Drama","Fantasy","Historical","Martial Arts"],"rating":"7.6","studio":"Nice Boat Animation, Samsara Animation Studio","episodesCount":3,"extra":{"ids":{"malId":37936,"anilistId":107069,"crunchyId":null,"disneyId":null,"netflixId":null,"primeId":null,"anilistIds":[107069,122585],"malIds":[37936,50407],"anidbIds":[15663,17241],"imdbMovieIds":[],"imdbShowIds":[],"tmdbMovieIds":[],"tmdbShowIds":[102788],"tvdbMovieIds":[],"tvdbShowIds":[383686]},"stats":{"scoreRaw":"7.57","favorites":118,"members":704,"views":48215,"episodesCountRaw":3,"episodesLength":26},"flags":{"dub":0,"alwaysHome":0},"meta":{"day":"Domenica","season":"Inverno","status":"Terminato","type":"ONA","createdAt":"2022-10-27 22:38:16","userId":2},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-30T07:57:40Z","sourceDescriptors":["anilist:107069","mal:37936"],"targets":[{"provider":"anidb","id":"15663","scope":"R","ranges":{"1-3":"1-3"}},{"provider":"anidb","id":"17241","scope":"R"},{"provider":"anilist","id":"107069","ranges":{"1-3":"1-3"}},{"provider":"anilist","id":"122585"},{"provider":"