me/cover/large/bx107069-mABDNDDtWWiW.png"}],"background":[{"source":"tmdb","url":"https://image.tmdb.org/t/p/original/spVZhtbHTb4aAPiZFu0dPq5IucH.jpg"},{"source":"anizip","url":"https://artworks.thetvdb.com/banners/series/383686/backgrounds/5f905e0c8a157.jpg"},{"source":"provider","url":"https://img.animeunity.co/anime/107069-tjm6yI8kud5D.jpg"},{"source":"anilist","url":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/107069-tjm6yI8kud5D.jpg"}]}},"related":[],"linkList":[{"title":"Episodes 1-3","titleKey":"Episodes {{start}}-{{end}}","titleParams":{"start":1,"end":3},"availabilityStatus":"available","episodesLink":"4111|1|3"}]},"episodes":[{"title":"Episodio 1","episodeNumber":1,"sourceEpisodeNumber":1,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"15663","scope":"R","episodeNumbers":[1]},{"provider":"anilist","id":"107069","episodeNumbers":[1]},{"provider":"mal","id":"37936","episodeNumbers":[1]},{"provider":"tmdb_show","id":"102788","scope":"s1","seasonNumber":1,"episodeNumbers":[1]},{"provider":"tvdb_show","id":"383686","scope":"s1","seasonNumber":1,"episodeNumbers":[1]}],"link":"65929","synopsis":"在一片荒芜的平原上，闻人翊悬为救治母亲擅自解开巨阙神盾的封印，放出上古神兽麒麟只为取一物。在与麒麟交手时不敌神兽，便解开五行火焕封印与其打斗，但还是不及麒麟之力。其他五行短暂出手相助，在战斗过程中麒麟的儿子通过巨阙神盾的大门偷偷溜了出去，麒麟便抓住了霖及元姝以示要挟，让闻人翊悬找回麒麟儿便可还他亲人。 某天，苏小安采药回家见父亲，冒冒失失的撞到父亲，打碎了药罐，于是被父亲要求苏小安去酒鬼张那里取新的药罐回来。后山偏远，苏小安在路上遇到了三个神秘人，三人打扮奇异，面目狰狞，害怕的苏小安给他三人随意编了个路线后，就慌慌张张的逃跑了。没有方向乱转的苏小安，闯入了神隐雾山，误打误撞的看到了闻人翊悬在洗澡。说明来意后，闻人带苏小安到酒鬼张家中取陶瓷，返程见神秘三人在与家父等人交手，数人不敌神秘三人死伤严重。千钧一发之际，闻人出手相助，轻松解决了小妖，但一场大战也正在酝酿中。","thumbnail":"https://image.tmdb.org/t/p/w300/j0BrKY7fijLoeA39LxRafXosU04.jpg","metadataSources":{"tmdb":{"title":"Episodio 1","synopsis":"在一片荒芜的平原上，闻人翊悬为救治母亲擅自解开巨阙神盾的封印，放出上古神兽麒麟只为取一物。在与麒麟交手时不敌神兽，便解开五行火焕封印与其打斗，但还是不及麒麟之力。其他五行短暂出手相助，在战斗过程中麒麟的儿子通过巨阙神盾的大门偷偷溜了出去，麒麟便抓住了霖及元姝以示要挟，让闻人翊悬找回麒麟儿便可还他亲人。 某天，苏小安采药回家见父亲，冒冒失失的撞到父亲，打碎了药罐，于是被父亲要求苏小安去酒鬼张那里取新的药罐回来。后山偏远，苏小安在路上遇到了三个神秘人，三人打扮奇异，面目狰狞，害怕的苏小安给他三人随意编了个路线后，就慌慌张张的逃跑了。没有方向乱转的苏小安，闯入了神隐雾山，误打误撞的看到了闻人翊悬在洗澡。说明来意后，闻人带苏小安到酒鬼张家中取陶瓷，返程见神秘三人在与家父等人交手，数人不敌神秘三人死伤严重。千钧一发之际，闻人出手相助，轻松解决了小妖，但一场大战也正在酝酿中。","thumbnail":"https://image.tmdb.org/t/p/w300/j0BrKY7fijLoeA39LxRafXosU04.jpg","titleLanguage":"it-IT","synopsisLanguage":"zh-CN"}}},{"title":"Episodio 2","episodeNumber":2,"sourceEpisodeNumber":2,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"15663","scope":"R","episodeNumbers":[2]},{"provider":"anilist","id":"107069","episodeNumbers":[2]},{"provider":"mal","id":"37936","episodeNumbers":[2]},{"provider":"tmdb_show","id":"102788","scope":"s1","seasonNumber":1,"episodeNumbers":[2]},{"provider":"tvdb_show","id":"383686","scope":"s1","seasonNumber":1,"episodeNumbers":[2]}],"link":"65930","synopsis":"山上小房外，四个小鬼在偷吃晾晒的干货，被羽丹发现后赶走了。见羽青回家，羽丹冲上去拥抱住哥哥并接他回家，打闹的过程中，羽青的包裹里掉出了给苏小安的胭脂，被羽丹调侃起来。听到山庄那边出事，羽青和羽丹起身连忙赶往山庄。山庄门外的桥上，五叔六叔身负重伤，白义命人出去救助伤员，惊魂未定的众人无人敢开门上前，这时苏小安冲上前去，扶起五叔就往门里走。桥外，水冠自告奋勇挑战嗔兽，却一击被秒跌入水中。闻人上前与嗔兽交手，嗔兽不敌闻人，没有几招便败下阵来仓皇逃走。这时，村内白义在聚众人之力想要对抗嗔兽，不料嗔兽突然折返回来。在众人绝望时，闻人及时赶到却为救人不幸受伤，狡猾的嗔兽施展妖术让众人妖化后吸食怨念得意进化。嗔兽读取山婆的记忆，前往承寿堂，闻人解开封印成为火行，赶忙追上去。妖化后的渠黄无法控制自己，随意屠杀村民，却不幸亲手杀死儿子跟羽丹，才短暂控制理智让羽青杀掉自己，羽青抱着已经没有气息的羽丹哭的撕心裂肺，但再也叫不醒他。火行追上嗔兽后两人再次交手，最终火行爆发大招一击打碎嗔兽的心脏。与嗔兽交谈之间，火行闻到聚仙丸中有麒麟血的气味赶忙跑进里屋，只见麒麟儿趴在笼子里奄奄一息。愤怒的火行冒着大雨抱着麒麟儿离开，小安叫住火行欲言又止，但还是什么也说不出口，渐渐地火行的身影在一片雾气中消散了。","thumbnail":"https://image.tmdb.org/t/p/w300/tyvM9Cuh5DiJkDbfrMTHHLw352l.jpg","metadataSources":{"tmdb":{"title":"Episodio 2","synopsis":"山上小房外，四个小鬼在偷吃晾晒的干货，被羽丹发现后赶走了。见羽青回家，羽丹冲上去拥抱住哥哥并接他回家，打闹的过程中，羽青的包裹里掉出了给苏小安的胭脂，被羽丹调侃起来。听到山庄那边出事，羽青和羽丹起身连忙赶往山庄。山庄门外的桥上，五叔六叔身负重伤，白义命人出去救助伤员，惊魂未定的众人无人敢开门上前，这时苏小安冲上前去，扶起五叔就往门里走。桥外，水冠自告奋勇挑战嗔兽，却一击被秒跌入水中。闻人上前与嗔兽交手，嗔兽不敌闻人，没有几招便败下阵来仓皇逃走。这时，村内白义在聚众人之力想要对抗嗔兽，不料嗔兽突然折返回来。在众人绝望时，闻人及时赶到却为救人不幸受伤，狡猾的嗔兽施展妖术让众人妖化后吸食怨念得意进化。嗔兽读取山婆的记忆，前往承寿堂，闻人解开封印成为火行，赶忙追上去。妖化后的渠黄无法控制自己，随意屠杀村民，却不幸亲手杀死儿子跟羽丹，才短暂控制理智让羽青杀掉自己，羽青抱着已经没有气息的羽丹哭的撕心裂肺，但再也叫不醒他。火行追上嗔兽后两人再次交手，最终火行爆发大招一击打碎嗔兽的心脏。与嗔兽交谈之间，火行闻到聚仙丸中有麒麟血的气味赶忙跑进里屋，只见麒麟儿趴在笼子里奄奄一息。愤怒的火行冒着大雨抱着麒麟儿离开，小安叫住火行欲言又止，但还是什么也说不出口，渐渐地火行的身影在一片雾气中消散了。","thumbnail":"https://image.tmdb.org/t/p/w300/tyvM9Cuh5DiJkDbfrMTHHLw352l.jpg","titleLanguage":"it-IT","synopsisLanguage":"zh-CN"}}},{"title":"Episodio 3","episodeNumber":3,"sourceEpisodeNumber":3,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"15663","scope":"R","episodeNumbers":[3]},{"provider":"anilist","id":"107069","episodeNumbers":[3]},{"provider":"mal","id":"37936","episodeNumbers":[3]},{"provider":"tmdb_show","id":"102788","scope":"s1","seasonNumber":1,"episodeNumbers":[3]},{"provider":"tvdb_show","id":"383686","scope":"s1","seasonNumber":1,"episodeNumbers":[3]}],"link":"65931","synopsis":"漫天浓烟下，病床上躺满了奄奄一息的村民们，苏小安一行人上山，目的竟然是为了捕捉麒麟儿？！充满迷雾的朦胧画面是回忆么？惊醒的苏小安眉头紧皱，她不是第一次做这种残忍的梦了。正当她黯然神伤时，父亲苏醒了过来，在苏小安的追问下父亲告诉了村庄里当年发生的悲剧。三年前，村子里爆发了一场大瘟疫，。而苏小安也是在那时失去了自己的记忆。当时村子里一大半的人都染上了瘟疫，就在绝望之际，喝了麒麟儿鳞片泡过的井水的村民竟然奇迹般的痊愈了，于是他们将麒麟儿抓了回来炼制了聚仙丸救了村民们。这时大伯赤骊和二伯盗骊回来了，商量着如何夺回麒麟儿，苏小安为了查清山婆说的话，于是自告奋勇的要去火行那里偷回麒麟儿。与此同时，贪兽也在琢磨着如何得到麒麟儿增强妖力，冲破结界，一场战役即将打响。","thumbnail":"https://image.tmdb.org/t/p/w300/8AUvJCr401pIPfBLRg5vPEyib6l.jpg","metadataSources":{"tmdb":{"title":"Episodio 3","synopsis":"漫天浓烟下，病床上躺满了奄奄一息的村民们，苏小安一行人上山，目的竟然是为了捕捉麒麟儿？！充满迷雾的朦胧画面是回忆么？惊醒的苏小安眉头紧皱，她不是第一次做这种残忍的梦了。正当她黯然神伤时，父亲苏醒了过来，在苏小安的追问下父亲告诉了村庄里当年发生的悲剧。三年前，村子里爆发了一场大瘟疫，。而苏小安也是在那时失去了自己的记忆。当时村子里一大半的人都染上了瘟疫，就在绝望之际，喝了麒麟儿鳞片泡过的井水的村民竟然奇迹般的痊愈了，于是他们将麒麟儿抓了回来炼制了聚仙丸救了村民们。这时大伯赤骊和二伯盗骊回来了，商量着如何夺回麒麟儿，苏小安为了查清山婆说的话，于是自告奋勇的要去火行那里偷回麒麟儿。与此同时，贪兽也在琢磨着如何得到麒麟儿增强妖力，冲破结界，一场战役即将打响。","thumbnail":"https://image.tmdb.org/t/p/w300/8AUvJCr401pIPfBLRg5vPEyib6l.jpg","titleLanguage":"it-IT","synopsisLanguage":"zh-CN"}}}],"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-30T07:57:40Z","sourceDescriptors":["anilist:107069","mal:37936"],"targets":[{"provider":"anidb","id":"15663","scope":"R","ranges":{"1-3":"1-3"}},{"provider":"anidb","id":"17241","scope":"R"},{"provider":"anilist","id":"107069","ranges":{"1-3":"1-3"}},{"provider":"anilist","id":"122585"},{"provider":"mal","id":"37936","ranges":{"1-3":"1-3"}},{"provider":"mal","id":"50407"},{"provider":"tmdb_show","id":"102788","scope":"s1","ranges":{"1-3":"1-3"}},{"prov