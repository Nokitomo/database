appings":[{"provider":"anidb","id":"6285","scope":"R","episodeNumbers":[1]},{"provider":"anilist","id":"3593","episodeNumbers":[1]},{"provider":"mal","id":"3593","episodeNumbers":[1]},{"provider":"tmdb_show","id":"46412","scope":"s0","seasonNumber":0,"episodeNumbers":[1]},{"provider":"tvdb_show","id":"79880","scope":"s0","seasonNumber":0,"episodeNumbers":[1]}],"link":"47476","synopsis":"Hakuoro is working and finds that he is hungry so he sets out to find Erurū, but is unable to locate her. Upon going to the food storage hut, Oboro approaches him and helps him find some food hidden in a secret compartment. Erurū almost catches them and frustratingly remarks how the hidden food was spoiled and leaves. Afterwards, Hakuoro and Oboro are stricken by serious stomach problems and fight to go to the restroom before the other does. However, the situation is further complicated by Aruru, who has shown up ready to dive headfirst into Hakuoro.","thumbnail":"https://image.tmdb.org/t/p/w300/6AFmhYqNlWvhUb8z9h3Wu2jlVIC.jpg","metadataSources":{"tmdb":{"title":"Episodio 1","synopsis":"Hakuoro is working and finds that he is hungry so he sets out to find Erurū, but is unable to locate her. Upon going to the food storage hut, Oboro approaches him and helps him find some food hidden in a secret compartment. Erurū almost catches them and frustratingly remarks how the hidden food was spoiled and leaves. Afterwards, Hakuoro and Oboro are stricken by serious stomach problems and fight to go to the restroom before the other does. However, the situation is further complicated by Aruru, who has shown up ready to dive headfirst into Hakuoro.","thumbnail":"https://image.tmdb.org/t/p/w300/6AFmhYqNlWvhUb8z9h3Wu2jlVIC.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}},{"title":"Episodio 2","episodeNumber":2,"sourceEpisodeNumber":2,"seasonNumber":0,"externalMappings":[{"provider":"anidb","id":"6285","scope":"R","episodeNumbers":[2]},{"provider":"anilist","id":"3593","episodeNumbers":[2]},{"provider":"mal","id":"3593","episodeNumbers":[2]},{"provider":"tmdb_show","id":"46412","scope":"s0","seasonNumber":0,"episodeNumbers":[2]},{"provider":"tvdb_show","id":"79880","scope":"s0","seasonNumber":0,"episodeNumbers":[2]}],"link":"47477","synopsis":"Munto searches around the castle for Kamyu, who has skipped out of her lessons. It is revealed she is playing hide-and-go-seek with Arurū. Hakuoro watches the entire tableau from his balcony, while drinking tea with Erurū and Benawi. Once Arurū is flushed from her \"hiding place\" the girls decide to head to the bath house and clean themselves up.","thumbnail":"https://image.tmdb.org/t/p/w300/pRuFon35mgBnpNgaJQK7F70a3Cs.jpg","metadataSources":{"tmdb":{"title":"Episodio 2","synopsis":"Munto searches around the castle for Kamyu, who has skipped out of her lessons. It is revealed she is playing hide-and-go-seek with Arurū. Hakuoro watches the entire tableau from his balcony, while drinking tea with Erurū and Benawi. Once Arurū is flushed from her \"hiding place\" the girls decide to head to the bath house and clean themselves up.","thumbnail":"https://image.tmdb.org/t/p/w300/pRuFon35mgBnpNgaJQK7F70a3Cs.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}},{"title":"Episodio 3","episodeNumber":3,"sourceEpisodeNumber":3,"seasonNumber":0,"externalMappings":[{"provider":"anidb","id":"6285","scope":"R","episodeNumbers":[3]},{"provider":"anilist","id":"3593","episodeNumbers":[3]},{"provider":"mal","id":"3593","episodeNumbers":[3]},{"provider":"tmdb_show","id":"46412","scope":"s0","seasonNumber":0,"episodeNumbers":[3]},{"provider":"tvdb_show","id":"79880","scope":"s0","seasonNumber":0,"episodeNumbers":[3]}],"link":"47478","synopsis":"Touka is seen caring for a doll that she treasures. She runs off to get some tea for Hakuoro, leaving him alone with the doll. Hakuoro plays with the doll and accidentally breaks it, leading to him running frantically around the castle looking for some way to repair it. He quickly glues it back together, but it's a very sloppy job. Oboro wanders in and starts playing with the already damaged doll, which breaks again. It is at this point that Touka returns, and Hakuoro lays all the blame on Oboro, leading to him taking the brunt of Touka's fury.","thumbnail":"https://image.tmdb.org/t/p/w300/sfpaT1yiuAeRSpYz63j1jW0qeK1.jpg","metadataSources":{"tmdb":{"title":"Episodio 3","synopsis":"Touka is seen caring for a doll that she treasures. She runs off to get some tea for Hakuoro, leaving him alone with the doll. Hakuoro plays with the doll and accidentally breaks it, leading to him running frantically around the castle looking for some way to repair it. He quickly glues it back together, but it's a very sloppy job. Oboro wanders in and starts playing with the already damaged doll, which breaks again. It is at this point that Touka returns, and Hakuoro lays all the blame on Oboro, leading to him taking the brunt of Touka's fury.","thumbnail":"https://image.tmdb.org/t/p/w300/sfpaT1yiuAeRSpYz63j1jW0qeK1.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}}],"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-30T07:57:40Z","sourceDescriptors":["anilist:3593","mal:3593"],"targets":[{"provider":"anidb","id":"13570","scope":"R"},{"provider":"anidb","id":"6285","scope":"R","ranges":{"1-3":"1-3"}},{"provider":"anidb","id":"6285","scope":"S"},{"provider":"anilist","id":"102573"},{"provider":"anilist","id":"1830"},{"provider":"anilist","id":"3593","ranges":{"1-3":"1-3"}},{"provider":"anilist","id":"6743"},{"provider":"anilist","id":"98547"},{"provider":"mal","id":"3593","ranges":{"1-3":"1-3"}},{"provider":"mal","id":"36777"},{"provider":"mal","id":"6743"},{"provider":"tmdb_show","id":"46412","scope":"s0","ranges":{"1-3":"1-3"}},{"provider":"tvdb_show","id":"79880","scope":"s0","ranges":{"1-3":"1-3"}}]},"artworkInventory":{"logo":[{"source":"tmdb","url":"https://image.tmdb.org/t/p/original/fZhE51XBTpmFC2b8anolGVJQbbD.png"},{"source":