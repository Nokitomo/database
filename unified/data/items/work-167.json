{"id":"work-167","sourceIds":{"anilist":101292,"mal":37458},"info":{"title":"Holmes of Kyoto","synopsis":"Aoi si è appena trasferita da Tokyo a Kyoto e si reca in un negozio di antiquariato lungo la via Teramachi per far valutare un vecchio oggetto di suo nonno. In quel negozio, il Kura, lavora Kiyotaka, un giovane studente universitario, che si è guadagnato il soprannome di &quot;Holmes&quot;, grazie alla sua capacità di risolvere piccoli misteri celati dai pezzi di antiquariato. Su suggerimento di Kiyotaka, Aoi inizia a lavorare part-time al Kura e pian piano diventerà il &quot;Watson&quot; della situazione.","image":"https://image.tmdb.org/t/p/original/zWg0Ay06gV7mdRGYSn4PPPokpfq.jpg","poster":"https://image.tmdb.org/t/p/original/dkn6JYT5dluKkJHRN127oUVYQSZ.jpg","logo":"https://image.tmdb.org/t/p/original/kbjpwbFHV8JGyOuxjML15BxXLX0.png","background":"https://image.tmdb.org/t/p/original/zWg0Ay06gV7mdRGYSn4PPPokpfq.jpg","trailers":["https://www.youtube.com/watch?v=gsSTI1d7NLM"],"imdbId":"","type":"series","tags":["TV","Terminato","2018"],"tagKeys":{"TV":"TV","Terminato":"Completed"},"genres":["Drama","Mystery"],"rating":"7.3","studio":"Seven","episodesCount":12,"extra":{"ids":{"malId":37458,"anilistId":101292,"anilistIds":[101292],"malIds":[37458],"anidbIds":[13904],"imdbMovieIds":[],"imdbShowIds":[],"tmdbMovieIds":[],"tmdbShowIds":[80464],"tvdbMovieIds":[],"tvdbShowIds":[348601]},"stats":{"scoreRaw":"7.33","episodesCountRaw":12},"flags":{"dub":0},"meta":{"status":"Terminato","type":"TV"},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-30T07:57:40Z","sourceDescriptors":["anilist:101292","mal:37458"],"targets":[{"provider":"anidb","id":"13904","scope":"R","ranges":{"1-12":"1-12"}},{"provider":"anilist","id":"101292","ranges":{"1-12":"1-12"}},{"provider":"mal","id":"37458","ranges":{"1-12":"1-12"}},{"provider":"tmdb_show","id":"80464","scope":"s1","ranges":{"1-12":"1-12"}},{"provider":"tvdb_show","id":"348601","scope":"s1","ranges"