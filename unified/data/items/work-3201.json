{"id":"work-3201","sourceIds":{"anilist":135384,"mal":49160},"info":{"title":"Miss Shachiku and the Little Baby Ghost","synopsis":"Fushihara è una vera e propria \"schiava\" dell'azienda in cui lavora. Una sera, a mezzanotte, ancora in ufficio sente improvvisamente una voce proveniente dal pavimento: \"Vattene adesso!\". È il piccolo fantasma Yuurei preoccupato per la salute della donna! Fushihara tuttavia non vuole andarsene perché ama troppo la dolcezza del suo nuovo amico Yuurei.","image":"https://image.tmdb.org/t/p/original/cQyl6xHttgzxTWTFIIwACtmwdR4.jpg","poster":"https://image.tmdb.org/t/p/original/4u7YPuV7Yzkzv7EHNm5IPCL1MkC.jpg","logo":"https://image.tmdb.org/t/p/original/ruLcLMUUoYaluV1xXZDPNfkuQuT.png","background":"https://image.tmdb.org/t/p/original/cQyl6xHttgzxTWTFIIwACtmwdR4.jpg","trailers":["https://www.youtube.com/watch?v=hh2kja5qQxE"],"imdbId":"tt15978968","type":"series","tags":["TV","Terminato","Primavera","2022"],"tagKeys":{"TV":"TV","Terminato":"Completed","Primavera":"Spring"},"genres":["Comedy","Shounen","Slice of Life","Supernatural"],"rating":"7.6","studio":"Project No.9","episodesCount":12,"extra":{"ids":{"malId":49160,"anilistId":135384,"crunchyId":null,"disneyId":null,"netflixId":null,"primeId":null,"anilistIds":[135384],"malIds":[49160],"anidbIds":[16376],"imdbMovieIds":[],"imdbShowIds":[],"tmdbMovieIds":[],"tmdbShowIds":[127327],"tvdbMovieIds":[],"tvdbShowIds":[412391]},"stats":{"scoreRaw":"7.58","favorites":33,"members":302,"views":22740,"episodesCountRaw":12,"episodesLength":24},"flags":{"dub":0,"alwaysHome":1},"meta":{"day":"Giovedì","season":"Primavera","status":"Terminato","type":"TV","createdAt":"2022-04-07 16:19:46","userId":78495},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-30T07:57:40Z","sourceDescriptors":["anilist:135384","mal:49160"],"imdbSource":"plexanibridge-v2","targets":[{"provider":"anidb","id":"16376","scope":"R","ranges":{"1-12":"1-12"}},{"provider":"anilist","id":"135384","ran