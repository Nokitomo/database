 out.","thumbnail":"https://image.tmdb.org/t/p/w300/A6lfLggXwUqiSWbaq2QNP5j1uFE.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}},{"title":"Episodio 10","episodeNumber":10,"sourceEpisodeNumber":10,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"9973","scope":"R","episodeNumbers":[10]},{"provider":"anilist","id":"20462","episodeNumbers":[10]},{"provider":"mal","id":"20853","episodeNumbers":[10]},{"provider":"tmdb_show","id":"60825","scope":"s1","seasonNumber":1,"episodeNumbers":[10]},{"provider":"tvdb_show","id":"278127","scope":"s1","seasonNumber":1,"episodeNumbers":[10]}],"link":"22061","synopsis":"Arriving at Iveco, Toru realizes that something is strange about town: there are no young girls. There is also a uprising lack of magic fuel given that this region is famous for its mines of magic fuel. They learn from a shopkeeper that Duke Gavarni has been using all of the town's magic fuel to power the floating fortress Soara and that his soldiers are kidnapping the town's girls and taking them to his fortress where they are never seen again.","thumbnail":"https://image.tmdb.org/t/p/w300/A334GncEeuwxE22EL2o6fqJldYg.jpg","metadataSources":{"tmdb":{"title":"Episodio 10","synopsis":"Arriving at Iveco, Toru realizes that something is strange about town: there are no young girls. There is also a uprising lack of magic fuel given that this region is famous for its mines of magic fuel. They learn from a shopkeeper that Duke Gavarni has been using all of the town's magic fuel to power the floating fortress Soara and that his soldiers are kidnapping the town's girls and taking them to his fortress where they are never seen again.","thumbnail":"https://image.tmdb.org/t/p/w300/A334GncEeuwxE22EL2o6fqJldYg.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}},{"title":"Episodio 11","episodeNumber":11,"sourceEpisodeNumber":11,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"9973","scope":"R","episodeNumbers":[11]},{"provider":"anilist","id