vider":"tvdb_show","id":"352854","scope":"s1","raw":"tvdb_show:352854:s1","ranges":{"1-12":"1-12"}}],"sourceIds":{"anilist":99413,"mal":35835},"tmdb":{"source":"tmdb-api","id":82522,"type":"tv","sourceUrl":"https://www.themoviedb.org/tv/82522","fetchedAt":"2026-11-02T17:25:30.076Z","originalLanguage":"ja-JP","title":{"value":"RErideD Tokigoe no Derrida","language":"it-IT"},"originalTitle":"RErideD－刻越えのデリダ－","overview":{"value":"Quando l'ingegnere Derida si risveglia nel futuro da un sonno criogenetico, scopre che il mondo è stato devastato da una guerra, in cui sono stati impiegati - una volta riconvertiti per uso bellico - gli automi progettati da lui e suo padre per uso civile. La chiave per rimettere tutto a posto è un drive nelle mani di Mage, la figlia di un suo collega, ma dov'è ora Mage, a distanza di un decennio? Come farà Derida a sopravvivere tra le macerie ai letali automi sentinella?","language":"it-IT"},"tagline":{"value":"再会は、“刻” を越えて","language":"ja-JP"},"startDate":"2018-09-22","endDate":"2018-11-22","status":"Ended","rating":5.8,"ratingCount":9,"numberOfEpisodes":12,"numberOfSeasons":1,"genres":["Animazione","Action & Adventure","Sci-Fi & Fantasy","Mistero"],"countries":["Japan"],"facts":{"Runtime":"24m"},"keywords":[],"networks":[{"id":614,"name":"TOKYO MX","logo":"https://image.tmdb.org/t/p/original/hSdroyVthq3CynxTIIY7lnS8w1.png"},{"id":1137,"name":"KBS Kyoto","logo":"https://image.tmdb.org/t/p/original/j12pSWPsDBxE1mmIpB7M8VRzk78.png"}],"socialLinks":{},"cast":[{"id":1065297,"name":"Kensho Ono","role":"Yvain Derrida (voice)","profile":"https://image.tmdb.org/t/p/original/wUYJ3HIeygHfh4rAqupE4RPoG3W.jpg"},{"id":1161472,"name":"Mao Ichimichi","role":"Bilstein Mage (voice)","profile":"https://image.tmdb.org/t/p/original/a3cflYtrlFK0LXfWODgLDO7E7CP.jpg"},{"id":1666292,"name":"Himika Akaneya","role":"Dietrich Yuri (voice)","profile":"https://image.tmdb.org/t/p/original/8MOIUzYhs2Mrflp4ILywvHo2RKU.jpg"},{"id":1123401,"name":"Yu Kobayashi","role":"Donna (voice)","profile":"https://image.tmdb.org/t/p/original/p3OKrnliz2C8ub14Pn5pN3T8Q9B.jpg"},{"id":1264226,"name":"Kenichirou Matsuda","role":"Yvain Jaques (voice)","profile":"https://image.tmdb.org/t/p/original/YCEXgyl763zg62qhsjhWHRzGkL.jpg"},{"id":1779027,"name":"Kaede Hondo","role":"Mayuka (voice)","profile":"https://image.tmdb.org/t/p/original/11BcHnuJYrOZhIftgUiQqfm7TK6.jpg"},{"id":217141,"name":"Minoru Inaba","role":"Bilstein Nathan (voice)","profile":"https://image.tmdb.org/t/p/original/3ZQFNc8cDQMgz6vh8KvGzpV2sNp.jpg"},{"id":1256875,"name":"Hiroo Sasaki","role":"Volker Vidaux (voice)","profile":"https://image.tmdb.org/t/p/original/c0Bo2PvwwqRlnBVP8qixt3Mmdc3.jpg"},{"id":1256906,"name":"Kazutomi Yamamoto","role":"Graham (voice)","profile":"https://image.tmdb.org/t/p/original/4rRICK0YXcneKmPzV7nv3BKGliB.jpg"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","title":"RErideD Tokigoe no Derrida","overview":"Quando l'ingegnere Derida si risveglia nel futuro da un sonno criogenetico, scopre che il mondo è stato devastato da una guerra, in cui sono stati impiegati - una volta riconvertiti per uso bellico - gli automi progettati da lui e suo padre per uso civile. La chiave per rimettere tutto a posto è un drive nelle mani di Mage, la figlia di un suo collega, ma dov'è ora Mage, a distanza di un decennio? Come farà Derida a sopravvivere tra le macerie ai letali automi sentinella?"},{"language":"en-US","title":"RErideD – Derrida, who leaps through time –","overview":"In 2050 engineer Derrida Yvain is famous for his contribution to \"Autonomous Machine DZ,\" at his father's company, Rebuild. But when he and his colleague Nathan discover a dangerous flaw in their creation, their warnings go ignored. The next day after Nathan's daughter Mage's birthday party, the group barely escapes an attack by unknown forces, leading to Derrida's unwitting captivity in cryogenic stasis. Ten years later, he emerges in a world at war with the mechanical lifeforms he helped create. Now, he fights to survive his nightmare future to make good his promise to \"Take care of Mage.\""},{"language":"ja-JP","title":"RErideD -刻越えのデリダ-","overview":"2050年。父の興したメーカー・リビルド社で、「自律機械DZ(ディジィ)」への開発貢献により、若くして名声を得た技術者デリダ・イヴェン（主人公）。デリダは、あるとき同僚のネイサンと共に「DZ」の重大な欠陥に気付くが、忠告に耳を傾けない上司に腹を立て、危険と知りながら対策を先延ばしにし、ネイサンの愛娘・マージュの誕生日を祝うパーティへとむかう。しかし、穏やかなひとときを過ごしたその翌日、デリダとネイサンは謎の部隊に襲われる。逃避行の末、冷凍睡眠装置に落ちたデリダが再び目を開けると、10年の時間が過ぎ、見渡す世界は荒廃し戦争状態になっていた！制御を失った「DZ」の群れに襲われ、何もかもを諦めそうになったそのとき、デリダはネイサンの最期の言葉を思い出す。「マージュを頼む」己に降りかかった運命に戸惑いながらも、マージュを探すため、デリダは歩き出す。","tagline":"再会は、“刻” を越えて"}],"images":{"logos":[],"posters":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/iDsIr8aLDulZnzHNzUJRtsYNjr2.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/iDsIr8aLDulZnzHNzUJRtsYNjr2.jpg","language":"en","width":640,"height":960},{"type":"poster","url":"https://image.tmdb.org/t/p/original/82sA5xt66FdCOCTYWQMZylOJtmG.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/82sA5xt66FdCOCTYWQMZylOJtmG.jpg","language":"en","width":640,"height":960},{"type":"poster","url":"https://image.tmdb.org/t/p/original/skVYJo6Dz5RoIrhJRYHcFf3v7yi.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/skVYJo6Dz5RoIrhJRYHcFf3v7yi.jpg","language":"xx","width":709,"height":1000}],"backdrops":[{"type":"backdrop","url":"https://image.tmdb.org/t/p/original/qZ74186AeLNTV8fEbHgyqS8KQlJ.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/qZ74186AeLNTV8fEbHgyqS8KQlJ.jpg","language":"ja","width":1920,"height":1080},{"type":"backdrop","url":"https://image.tmdb.org/t/p/original/3GyR22VowDibxSzpPSzxhvp8A2q.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/3GyR22VowDibxSzpPSzxhvp8A2q.jpg","language":"ja","width":1280,"height":720},{"type":"backdrop","url":"https://image.tmdb.org/t/p/original/c3mqlWNadaRYKyfZicLMxAIhftX.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/c3mqlWNadaRYKyfZicLMxAIhftX.jpg","language":"xx","width":1280,"height":720}]},"poster":"https://image.tmdb.org/t/p/original/iDs