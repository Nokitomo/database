mbers":[10]},{"provider":"tmdb_show","id":"46153","scope":"s2","seasonNumber":2,"episodeNumbers":[10]},{"provider":"tvdb_show","id":"145211","scope":"s2","seasonNumber":2,"episodeNumbers":[10]}],"link":"19846","synopsis":"Mahiru finds herself a bit too close to Sōta for comfort when he tries to stop a tower of boxes from falling on her, which leads her to become a bit fearful of him the next day. This turns into a complete freakout after she discovers Sota touching her head whilst she was asleep and stops coming into work. Later, Poplar gets locked in the freezer and initially suspects Jun, but soon finds Aoi just did it accidentally. After Mahiru doesn't show up at work all week, Sōta goes to visit her in Kotori-guise to apologise and exchange phone numbers.","thumbnail":"https://image.tmdb.org/t/p/w300/resFt2pFqAWbk1yn5eLZG9KyonH.jpg","metadataSources":{"tmdb":{"title":"Episodio 10","synopsis":"Mahiru finds herself a bit too close to Sōta for comfort when he tries to stop a tower of boxes from falling on her, which leads her to become a bit fearful of him the next day. This turns into a complete freakout after she discovers Sota touching her head whilst she was asleep and stops coming into work. Later, Poplar gets locked in the freezer and initially suspects Jun, but soon finds Aoi just did it accidentally. After Mahiru doesn't show up at work all week, Sōta goes to visit her in Kotori-guise to apologise and exchange phone numbers.","thumbnail":"https://image.tmdb.org/t/p/w300/resFt2pFqAWbk1yn5eLZG9KyonH.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}},{"title":"Episodio 11","episodeNumber":11,"sourceEpisodeNumber":11,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"8364","scope":"R","episodeNumbers":[11]},{"provider":"anilist","id":"10521","episodeNumbers":[11]},{"provider":"mal","id":"10521","episodeNumbers":[11]},{"provider":"tmdb_show","id":"46153","scope":"s2","seasonNumber":2,"episodeNumbers":[11]},{"provider":"tvdb_show","id":"145211","scope":"s2","seasonNumber":2,"episodeNumbers":[11]}],"link":"19844","synopsis":"Aoi searches for her teddy bear, Daisy, only to find that Jun had just put it in her room. Later, Yachiyo overhears a conversation between Jun and Mitsuki and assumes the two are going out with each other. As Jun notices her weird behaviour, he takes some advice from Popura to put some pressure on himself to sort things out with her.","thumbnail":"https://image.tmdb.org/t/p/w300/qr9BruplkOiQ8nPTMO9LJHUDOwi.jpg","metadataSources":{"tmdb":{"title":"Episodio 11","synopsis":"Aoi searches for her teddy bear, Daisy, only to find that Jun had just put it in her room. Later, Yachiyo overhears a conversation between Jun and Mitsuki and assumes the two are going out with each other. As Jun notices her weird behaviour, he takes some advice from Popura to put some pressure on himself to sort things out with her.","thumbnail":"https://image.tmdb.org/t/p/w300/qr9BruplkOiQ8nPTMO9LJHUDOwi.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}},{"title":"Episodio 12","episodeNumber":12,"sourceEpisodeNumber":12,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"8364","scope":"R","episodeNumbers":[12]},{"provider":"anilist","id":"10521","episodeNumbers":[12]},{"provider":"mal","id":"10521","episodeNumbers":[12]},{"provider":"tmdb_show","id":"46153","scope":"s2","seasonNumber":2,"episodeNumbers":[12]},{"provider":"tvdb_show","id":"145211","scope":"s2","seasonNumber":2,"episodeNumbers":[12]}],"link":"19845","synopsis":"Popura and Aoi try to help Mahiru train to cure her androphobia by dressing her up as a guy, but with no such luck. Later, Sōta and Mahiru start exchanging text messages, which causes Izumi to worry. Sōta also runs into Kirio, who manages to deduce that Mahiru has feelings for him. Later one night, Aoi gets locked out of the restaurant, but Jun manages to sort things out for her. Later, Popura and Aoi try to help out Mahiru's progress by exposing her to the other men, only for her to nearly end up punching Hiroomi. Meanwhile, Popura becomes elated when she is finally able to reach the broken items report sheet that was normally out of her reach.","thumbnail":"https://image.tmdb.org/t/p/w300/u3fLI1r0AcpR8NTBJFGjqRcjVT8.jpg","metadataSources":{"tmdb":{"title":"Episodio 12","synopsis":"Popura and Aoi try to help Mahiru train to cure her androphobia by dressing her up as a guy, but with no such luck. Later, Sōta and Mahiru start exchanging text messages, which causes Izumi to worry. Sōta also runs into Kirio, who manages to deduce that Mahiru has feelings for him. Later one night, Aoi gets locked out of the restaurant, but Jun manages to sort things out for her. Later, Popura and Aoi try to help out Mahiru's progress by exposing her to the other men, only for her to nearly end up punching Hiroomi. Meanwhile, Popura becomes elated when she is finally able to reach the broken items report sheet that was normally out of her reach.","thumbnail":"https://image.tmdb.org/t/p/w300/u3fLI1r0AcpR8NTBJFGjqRcjVT8.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}},{"title":"Episodio 13","episodeNumber":13,"sourceEpisodeNumber":13,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"8364","scope":"R","episodeNumbers":[13]},{"provider":"anilist","id":"10521","episodeNumbers":[13]},{"provider":"mal","id":"10521","episodeNumbers":[13]},{"provider":"tmdb_show","id":"46153","scope":"s2","seasonNumber":2,"episodeNumbers":[13]},{"provider":"tvdb_show","id":"145211","scope":"s2","seasonNumber":2,"episodeNumbers":[13]}],"link":"19843","synopsis":"Whilst Popuar is pleased to finally reach the report sheet, Sōta is horrified by the thought of her growing taller. Whilst talking about the future, Aoi ends up turning a statement from Popura that she might have to leave Wagnaria some time in the future to a rumour that she is actually quitting, which she spreads to the other staff members. As the staff have their concerns over this, much to the annoyance of Maya the bird, Popura is confused by their weird reactions to her. After Maya helps Popura with her worries, the truth about Aoi's rumour soon comes out.","thumbnail":"https://image.tmdb.org/t/p/w300/tAGqBfA0Wpbt207npJvbix8aN0X.jpg","metadataSources":{"tmdb":{"title":"Episodio 13","synopsis":"Whilst Popuar is pleased to finally reach the report sheet, Sōta is horrified by the thought of her growing taller. Whilst talking about the future, Aoi ends up turning a statement from Popura that she might have to leave Wagnaria some time in the future to a rumour that she is actually quitting, which she spreads to the other staff members. As the staff have their concerns over this, much to the annoyance of Maya the bird, Popura is confused by their weird reactions to her. After Maya helps Popura with her worries, the truth about Aoi's rumour soon comes out.","thumbnail":"https://image.tmdb.org/t/p/w300/tAGqBfA0Wpbt207npJvbix8aN0X.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}}],"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-30T07:57:40Z","sourceDescriptors":["anilist:10521","mal:10521"],"targets":[{"provider":"anidb","id":"8364","scope":"R","ranges":{"1-13":"1-13"}},{"provider":"anilist","id":"10521","ranges":{"1-13":"1-13"}},{"provider":"mal","id":"10521","ranges":{"1-13":"1-13"}},{"provider":"tmdb_show","id":"46153","scope":"s2","ranges":{"1-13":"1-13"}},{"provider":"tvdb_show","id":"145211","scope":"s2","ranges":{"1-13":"1-13"}}]},"artworkInventory":{"logo":[{"source":"tmdb","url":"https://image.tmdb.org/t/p/original/l7zreoiJFuQY6AfYKVuvaimJ52D.png"},{"source":"anizip","url":"https://artworks.thetvdb.com/banners/v4/series/145211/clearlogo/611c014f5cb5d.png"}],"poster":[{"source":"tmdb","url":"https://image.tmdb.org/t/p/original/khSrC8goKi93aTc4XjXMzyOvcNs.jpg"},{"source":"tvdb","url":"https://artworks.thetvdb.com/banners/posters/145211-1.jpg"},{"source":"provider","url":"https://img.animeunity.co/anime/bx10521-dx9L5dLNJ