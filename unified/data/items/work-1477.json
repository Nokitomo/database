d":null,"disney_id":null,"genres":[{"id":37,"name":"Comedy","pivot":{"anime_id":1742,"genre_id":37}},{"id":22,"name":"Drama","pivot":{"anime_id":1742,"genre_id":22}},{"id":17,"name":"Romance","pivot":{"anime_id":1742,"genre_id":17}}],"related":[{"id":1745,"user_id":2,"title":"Please Teacher!","imageurl":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/195.jpg","plot":"Onegai Teacher è una serie semplice, senza grandi pretese, ma estremamente divertente e mai noiosa. Il protagonista Kei Kusanagi soffre di una malattia, che chiama “Teitai”, che lo costringe ad un arresto totale del suo corpo (qualcosa di simile ad un sonno eterno). Al risveglio da uno dei suoi momenti di “Teitai” Kei vede arrivare dal cielo un’astronave con a bordo una bellissima aliena e scappa a gambe levate. Il giorno dopo però a scuola si viene a sapere che uno degli insegnanti è andato in pensione e il suo posto viene preso dall’aliena stessa ? Durante i 12 episodi si chiarisce il rapporto tra i due protagonisti, rapporto che avrà alti e bassi, condito naturalmente da situazioni imbarazzanti e da equivoci che porterà i due a dichiararsi sposati e vivere nella stessa casa per salvaguardare il buon nome della scuola. Una serie da vedere assolutamente.","date":"2002","episodes_count":12,"episodes_length":25,"author":" ","created_at":"2019-11-03 15:10:30","status":"Terminato","imageurl_cover":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/195-bJP2XyNS08sG.jpg","type":"TV","slug":"onegaiteacher","title_eng":"Onegai☆Teacher","day":"Indeterminato","favorites":133,"score":"7.39","visite":59831,"studio":"Daume","dub":0,"always_home":0,"members":687,"cover":null,"anilist_id":195,"season":"Inverno","title_it":null,"mal_id":195,"crunchy_id":null,"netflix_id":null,"prime_id":null,"disney_id":null,"pivot":{"anime_id":1742,"related_id":1745,"number":1}},{"id":7531,"user_id":2,"title":"Please☆Teacher!: Secret Couple","imageurl":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/me