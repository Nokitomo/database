d":5916,"genre_id":51}},{"id":21,"name":"Adventure","pivot":{"anime_id":5916,"genre_id":21}},{"id":37,"name":"Comedy","pivot":{"anime_id":5916,"genre_id":37}},{"id":9,"name":"Fantasy","pivot":{"anime_id":5916,"genre_id":9}},{"id":34,"name":"Shounen","pivot":{"anime_id":5916,"genre_id":34}}],"related":[{"id":237,"user_id":78495,"title":null,"imageurl":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/bx14513-b4C3J03GF6UT.jpg","plot":"Aladdin è un misterioso ragazzino che vagabonda senza una meta precisa e che sembra non sapere niente del mondo. Nel suo viaggio però non è solo, poiché insieme a lui c'è Ugo, un gigantesco ma timido djinn che risiede all'interno del suo flauto. In uno dei suoi viaggi, Aladdin incontra Alibaba, un ragazzo all'apparenza egoista ed avido, ma che in realtà possiede un grande cuore e non esita a mettere a rischio la sua vita per il bene degli altri. Dopo una serie di disavventure, i due diventano amici e decidono di esplorare insieme un dungeon, ossia una delle leggendarie costruzioni apparse per la prima volta nel mondo 14 anni prima ed al cui interno si nascondono misteriosi tesori.","date":"2012","episodes_count":25,"episodes_length":24,"author":" ","created_at":"2018-07-18 16:35:20","status":"Terminato","imageurl_cover":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/14513-DDBxCumOyPIa.jpg","type":"TV","slug":"magi-the-labyrinth-of-magic","title_eng":"Magi: The Labyrinth of Magic","day":"Indeterminato","favorites":561,"score":"8.12","visite":640905,"studio":"A-1 Pictures","dub":0,"always_home":0,"members":4478,"cover":null,"anilist_id":14513,"season":"Autunno","title_it":null,"mal_id":14513,"crunchy_id":null,"netflix_id":null,"prime_id":null,"disney_id":null,"pivot":{"anime_id":5916,"related_id":237,"number":1}},{"id":238,"user_id":78495,"title":null,"imageurl":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/bx18115-dilbAD4yGMfc.png","plot":"Aladdin è un bambino vagabondo che viaggia di città in città. Non sempre incontra gente generosa disposta a fargli un po’ di carità ma la cosa non lo turba, perché gli basta suonare il suo flauto magico e da una misteriosa lampada fuoriesce una gigantesca creatura pronta a difenderlo da qualunque malintenzionato! C’è un unico problema: quando il gigante viene anche solo sfiorato da una ragazza, sviene all’istante a causa della sua terribile timidezza! La nostra storia inizia quando Aladdin incontra una venditrice ambulante che lo obbliga a lavorare per lei come risarcimento per aver divorato tutti i suoi cocomeri. Poco dopo, tuttavia, sarà proprio la ragazza ad essere accusata di furto! La pena per i ladri? Solo una: la morte!","date":"2013","episodes_count":25,"episodes_length":24,"author":" ","created_at":"2018-07-18 16:37:35","status":"Terminato","imageurl_cover":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/18115-Yj8RSfYwuWhp.jpg","type":"TV","slug":"magi-the-kingdom-of-magic","title_eng":"Magi: The Kingdom of Magic","day":"Indeterminato","favorites":242,"score":"8.41","visite":409274,"studio":"A-1 Pictures","dub":0,"always_home":0,"members":2032,"cover":null,"anilist_id":18115,"season":"Autunno","title_it":null,"mal_id":18115,"crunchy_id":null,"netflix_id":null,"prime_id":null,"disney_id":null,"pivot":{"anime_id":5916,"related_id":238,"number":1}},{"id":5916,"user_id":2,"title":"Magi: Sinbad no Bouken","imageurl":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/bx20609-G6mQO4oF7HfT.png","plot":"Spin-off di \"Magi: The Labyrinth of Magic\". Gli OVA raccontano le avventure di Sinbad, ripercorrendo la sua giovinezza a partire dalla conquista del suo primo dungeon, Baal.","date":"2014","episodes_count":5,"episodes_length":25,"author":" ","created_at":"2025-01-26 13:17:38","status":"Terminato","imageurl_cover":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/20609-9qLYZszeMwAM.jpg","type":"OVA","slug":"magi-adventure-of-sinbad-ova","title_eng":"Magi: Adventure of Sinbad (OVA)","day":"Gi