{"id":"work-4185","sourceIds":{"anilist":99088,"mal":35737},"info":{"title":"Pluto","synopsis":"\"Pluto\" si ispira al personaggio omonimo creato dal grande Osamu Tezuka nella serie \"Tetsuwan Atom\", conosciuta in Italia come \"Astro Boy\". Tutto inizia con la misteriosa morte di Mont Blanc, uno dei robot più potenti della Terra, amato da tutti. A indagare su questo caso e sulla morte di molti altri robot c'è il detective Gesicht. Vincitore nel 2005 del prestigioso “Osamu Tezuka Cultural Award”, e dell'“Excellence Prize” nella divisione manga del Japanese Media Arts Festival, elogiato e apprezzato da tutti, \"Pluto\" è già un capolavoro. Ecco come un genio rilegge l'opera di un altro genio.","image":"https://image.tmdb.org/t/p/original/tOO9tTOEL1l3ZIEZZJn89aE9PMO.jpg","poster":"https://image.tmdb.org/t/p/original/iAepdu9D9fSiic0Lig8sUbLCZn9.jpg","logo":"https://image.tmdb.org/t/p/original/cXlvvza8zQANyuDL66TUnNhLq9M.png","background":"https://image.tmdb.org/t/p/original/tOO9tTOEL1l3ZIEZZJn89aE9PMO.jpg","trailers":["https://www.youtube.com/watch?v=9ez8lm9I26Y"],"imdbId":"tt26737616","type":"series","tags":["ONA","Terminato","Autunno","2023"],"tagKeys":{"ONA":"ONA","Terminato":"Completed","Autunno":"Autumn"},"genres":["Action","Mecha","Mystery","Psychological","Sci-fi","Seinen"],"rating":"8.7","studio":"Studio M2","episodesCount":8,"extra":{"ids":{"malId":35737,"anilistId":99088,"crunchyId":null,"disneyId":null,"netflixId":null,"primeId":null,"anilistIds":[99088],"malIds":[35737],"anidbIds":[13225],"imdbMovieIds":[],"imdbShowIds":[],"tmdbMovieIds":[],"tmdbShowIds":[91997],"tvdbMovieIds":[],"tvdbShowIds":[431093]},"stats":{"scoreRaw":"8.73","favorites":182,"members":1415,"views":88943,"episodesCountRaw":8,"episodesLength":60},"flags":{"dub":0,"alwaysHome":1},"meta":{"day":"Giovedì","season":"Autunno","status":"Terminato","type":"ONA","createdAt":"2023-10-26 14:59:29","userId":2},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-29T07:5