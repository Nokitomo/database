0","ranges":{"1":"1"}},{"provider":"tvdb_show","id":"330308","scope":"s1","raw":"tvdb_show:330308:s1","ranges":{"1-12":"1-12"}}],"imdbId":"tt9724088","sourceIds":{"anilist":101875,"mal":31456},"tmdb":{"source":"tmdb-api","id":74084,"type":"tv","sourceUrl":"https://www.themoviedb.org/tv/74084","fetchedAt":"2026-11-02T18:58:37.283Z","originalLanguage":"ja-JP","title":{"value":"Code:Realize","language":"it-IT"},"originalTitle":"Code:Realize ～創世の姫君～","overview":{"value":"In un'ambientazionee steampunk vi sono figure storiche e letterarie quali: Arsène Lupin, Abraham Van Helsing, Victor Frankenstein, Impey Barbicane e il Counte di Saint-Germain. La protagonista, Cardia, vive isolata dal mondo, esaudendo l’ultima promessa fatta a suo padre. Abita in un palazzo in stato di semi-abbandono, nei pressi di Londra. Il suo corpo produce un veleno letale, il contatto con la sua pelle fa marcire o liquefare ogni cosa, per questo la popolazione locale la considera un mostro. La ragazza ricorda solo di aver avuto una conversazione con suo padre due anni orsono, nella quale il genitore le intimava di restare sempre nascosta e di non innamorarsi mai per nessun motivo. Un giorno il suo isolamento viene interrotto da un’improvvisa irruzione delle guardie reali, venute a catturarla. In quel frangente Cardia conosce Arsène Lupin, un galante ladro, che l’aiuta a fuggire.","language":"it-IT"},"startDate":"2017-10-07","endDate":"2017-12-23","status":"Ended","rating":6.2,"ratingCount":16,"numberOfEpisodes":12,"numberOfSeasons":1,"genres":["Dramma","Animazione","Sci-Fi & Fantasy"],"countries":["Japan"],"facts":{"Runtime":"25m"},"keywords":[],"networks":[{"id":173,"name":"AT-X","logo":"https://image.tmdb.org/t/p/original/fERjndErEpveJmQZccJbJDi93rj.png"}],"socialLinks":{},"cast":[{"id":221773,"name":"Saori Hayami","role":"(voice)","profile":"https://image.tmdb.org/t/p/original/gLv9lO7dlUbIsmyJUvgegqAAXki.jpg"},{"id":1249235,"name":"Tomoaki Maeno","role":"(voice)","profile":"https://image.tmdb.o