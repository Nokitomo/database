{"id":"work-6115","sourceIds":{"anilist":1775,"mal":1775},"info":{"title":"Dimension Movement of Nazca","synopsis":"Alla ricerca di un lontano passato e sulle tracce del suo maestro di Kendo, l'affascinante Masanari Tate, improvvisamente recatosi in Sud America, Kyoji Miura parte con Yuka, promessa sposa di Tate, per il Perù. Qui scopre che gli uomini-anima, reincarnazioni di potenti guerrieri un tempo divisi da vicende di politica e sangue, si stanno risvegliando, mentre in Giappone quelli che da sempre considerava i suoi più cari amici si stanno dividendo in due opposte fazioni. Chi è il guerriero Yawal, e per quale motivo brama la morte del guerriero Vilka? Chi erano, nel passato? E chi sono, in questo presente incapace di offrire certezze?","image":"https://image.tmdb.org/t/p/original/pRpE8ut5S29hRSfCvZxPyR0glY6.jpg","poster":"https://image.tmdb.org/t/p/original/glC8LGEd5BkbzrbfGTUwqSWRZKv.jpg","logo":"https://live.metahub.space/logo/medium/tt0264281/img","background":"https://image.tmdb.org/t/p/original/pRpE8ut5S29hRSfCvZxPyR0glY6.jpg","imdbId":"tt0264281","type":"series","tags":["TV","Terminato","Primavera","1998"],"tagKeys":{"TV":"TV","Terminato":"Completed","Primavera":"Spring"},"genres":["Action","Adventure","Drama","Fantasy","Reincarnation"],"studio":"Genco","episodesCount":12,"extra":{"ids":{"malId":1775,"anilistId":1775,"crunchyId":null,"disneyId":null,"netflixId":null,"primeId":null,"anilistIds":[1775],"malIds":[1775],"anidbIds":[101],"imdbMovieIds":[],"imdbShowIds":[],"tmdbMovieIds":[],"tmdbShowIds":[34170],"tvdbMovieIds":[],"tvdbShowIds":[74539]},"stats":{"favorites":3,"members":15,"views":2515,"episodesCountRaw":12,"episodesLength":24},"flags":{"dub":0,"alwaysHome":0},"meta":{"day":"Indeterminato","season":"Primavera","status":"Terminato","type":"TV","createdAt":"2026-06-18 18:23:58","userId":2},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-29T07:54:59Z","sourceDescriptors":["anilist:1775","mal:1775"],"imdbSource"