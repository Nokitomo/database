umber":3,"episodeNumbers":[1]},{"provider":"tvdb_show","id":"80900","scope":"s3","seasonNumber":3,"episodeNumbers":[1]}],"link":"58959","metadataSources":{"tmdb":{},"tvdb":{"title":"White knights","synopsis":"19-year-old Aika reunites with Eri and Karen to investigate the serial disappearances of school girls at St. Aero academy. Some of the girls have returned but without any memories of what has happened. While going undercover as students, they discover that the student council group called the White Knights have been abducting the students, and that they are in cahoots with an alien force that penetrates and captures the girls using rope-like tendrils of light. Aika is captured by the alien, but is rescued by Risako.","titleLanguage":"ita","synopsisLanguage":"eng"}},"synopsis":"19-year-old Aika reunites with Eri and Karen to investigate the serial disappearances of school girls at St. Aero academy. Some of the girls have returned but without any memories of what has happened. While going undercover as students, they discover that the student council group called the White Knights have been abducting the students, and that they are in cahoots with an alien force that penetrates and captures the girls using rope-like tendrils of light. Aika is captured by the alien, but is rescued by Risako.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/80900/4781537.jpg"},{"title":"E.T.A.I.","episodeNumber":2,"sourceEpisodeNumber":2,"seasonNumber":3,"externalMappings":[{"provider":"anidb","id":"6526","scope":"R","episodeNumbers":[2]},{"provider":"anilist","id":"6443","episodeNumbers":[2]},{"provider":"mal","id":"6443","episodeNumbers":[2]},{"provider":"tmdb_show","id":"43249","scope":"s3","seasonNumber":3,"episodeNumbers":[2]},{"provider":"tvdb_show","id":"80900","scope":"s3","seasonNumber":3,"episodeNumbers":[2]}],"link":"58960","metadataSources":{"tmdb":{},"tvdb":{"title":"E.T.A.I.","synopsis":"Miyu's back story is expanded upon regarding how she encountered the aliens and then influences her classmates to join her in the student council. The army takes over responsibility for the investigation. When Karen goes in undercover, she notices the council has deserted the chapel. Meanwhile, the Hagens have been observing their actions. When the White Knights capture more girls, Aika raids the underground.","titleLanguage":"ita","synopsisLanguage":"eng"}},"synopsis":"Miyu's back story is expanded upon regarding how she encountered the aliens and then influences her classmates to join her in the student council. The army takes over responsibility for the investigation. When Karen goes in undercover, she notices the council has deserted the chapel. Meanwhile, the Hagens have been observing their actions. When the White Knights capture more girls, Aika raids the underground.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/80900/4781538.jpg"},{"title":"Zero","episodeNumber":3,"sourceEpisodeNumber":3,"seasonNumber":3,"externalMappings":[{"provider":"anidb","id":"6526","scope":"R","episodeNumbers":[3]},{"provider":"anilist","id":"6443","episodeNumbers":[3]},{"provider":"mal","id":"6443","episodeNumbers":[3]},{"provider":"tmdb_show","id":"43249","scope":"s3","seasonNumber":3,"episodeNumbers":[3]},{"provider":"tvdb_show","id":"80900","scope":"s3","seasonNumber":3,"episodeNumbers":[3]}],"link":"58961","metadataSources":{"tmdb":{},"tvdb":{"title":"Zero","synopsis":"E.T.A.I. holds Aika captive and attempts to probe her, but the tendrils are broken by Aika's inherent power. E.T.A.I. and Miyu go to the spaceship where E.T.A.I. reveals that Aika has alien powers like her. After Aika defeats Rin and Kana, she reunites with Karen and Risako and they find the captured girls. Aika defeats Miyu and E.T.A.I. and then goes after the spaceship where, with the help of the military, they shoot it down. Aika returns safely. During the closing credits, Miyu and E.T.A.I. are taken in by the Hagens.","titleLanguage":"ita","synopsisLanguage":"eng"}},"synopsis":"E.T.A.I. holds Aika captive and attempts to probe her, but the tendrils are broken by Aika's inherent power. E.T.A.I. and Miyu go to the spaceship where E.T.A.I. reveals that Aika has alien powers like her. After Aika defeats Rin and Kana, she reunites with Karen and Risako and they find the captured girls. Aika defeats Miyu and E.T.A.I. and then goes after the spaceship where, with the help of the military, they shoot it down. Aika returns safely. During the closing credits, Miyu and E.T.A.I. are taken in by the Hagens.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/80900/4781544.jpg"}],"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-11-01T08:31:58Z","sourceDescriptors":["anilist:6443","mal:6443"],"imdbSource":"plexanibridge-v2","targets":[{"provider":"anidb","id":"6526","scope":"R","ranges":{"1-3":"1-3"}},{"provider":"anilist","id":"6443","ranges":{"1-3":"1-3"}},{"provider":"mal","id":"6443","ranges":{"1-3":"1-3"}},{"provider":"tvdb_show","id":"80900","scope":"s3","ranges":{"1-3":"1-3"}}]},"artworkInventory":{"logo":[{"source":"cinemeta","url":"https://live.metahub.space/logo/medium/tt1470843/img"},{"source":"anizip","url":"https://artworks.thetvdb.com/banners/v4/series/80900/clearlogo/611d05dfca2f7.png"}],"poster":[{"source":"anizip","url":"https://artworks.thetvdb.com/banners/posters/80900-1.jpg"},{"source":"provider","url":"https://img.animeunity.co/anime/nx6443-BIUWdiztRIFb.jpg"},{"source":"cinemeta","url":"https://live.metahub.space/poster/small/tt1470843/img"},{"source":"anilist","url":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/large/nx6443-BIUWdiztRIFb.jpg"}],"background":[{"source":"cinemeta","url":"https://live.metahub.space/background/medium/tt1470843/img"},{"source":"tvdb","url":"https://artworks.thetvdb.com/banners/fanart/original/80900-11.jpg"},{"source":"anizip","url":"https://artworks.thetvdb.com/banners/fanart/original/80900-10.jpg"},{"source":"provider","url":"https://img.ani