{"id":"work-1278","sourceIds":{"anilist":97592,"mal":33988},"info":{"title":"Interviews With Monster Girls","synopsis":"Succubi, dullahan (folletti celtici senza testa) e vampiri, sono conosciuti come Ajin e sono leggermente diversi da un comune essere umano. Per secoli sono stati perseguitati, pur convivendo con gli umani, ma di recente sono stati accettati come membri della società . Il manga segue un insegnante di biologia di un liceo, che per gli Ajin ha grande interesse, nelle sue interazioni con quelli che lo circondano a scuola, ognuno coi simpatici problemi.","image":"https://image.tmdb.org/t/p/original/h9tw0s43DMqH3prCCPaYteL0cqk.jpg","poster":"https://image.tmdb.org/t/p/original/8rCPIzcKrXErirG3PswUEhXPr09.jpg","logo":"https://image.tmdb.org/t/p/original/1mKqSyQ1TP9KCbtpows25GuE6tX.png","background":"https://image.tmdb.org/t/p/original/h9tw0s43DMqH3prCCPaYteL0cqk.jpg","trailers":["https://www.youtube.com/watch?v=XaoWL6Lvyjo"],"imdbId":"tt6435350","type":"series","tags":["TV","Terminato","Inverno","2017"],"tagKeys":{"TV":"TV","Terminato":"Completed","Inverno":"Winter"},"genres":["Comedy","Fantasy","School","Seinen","Slice of Life","Supernatural","Vampire"],"rating":"7.7","studio":"A-1 Pictures","episodesCount":12,"extra":{"ids":{"malId":33988,"anilistId":97592,"crunchyId":null,"disneyId":null,"netflixId":null,"primeId":null,"anilistIds":[97592],"malIds":[33988],"anidbIds":[12374],"imdbMovieIds":[],"imdbShowIds":[],"tmdbMovieIds":[],"tmdbShowIds":[69282],"tvdbMovieIds":[],"tvdbShowIds":[316931]},"stats":{"scoreRaw":"7.69","favorites":136,"members":1354,"views":89437,"episodesCountRaw":12,"episodesLength":24},"flags":{"dub":0,"alwaysHome":0},"meta":{"day":"Sabato","season":"Inverno","status":"Terminato","type":"TV","createdAt":"2019-09-19 14:31:46","userId":78495},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-30T07:57:40Z","sourceDescriptors":["anilist:97592","mal:33988"],"imdbSource":"plexanibridge-v2","targets":[{"provid