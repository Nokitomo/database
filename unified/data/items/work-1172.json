{"id":"work-1172","sourceIds":{"anilist":187,"mal":187},"info":{"title":"Initial D Third Stage","synopsis":"Terza Stagione di Initial D. Dopo l'Extra Stage si ritorna alle corse con un film pieno di nuove avvicenti sfide! Ryosuke Takahashi propone a Takumi di entrare in un team composto da tutti i migliori piloti della prefettura di Gunma ma il ragazzo non sa se accettare dal momento che la cosa sarebbe un impegno importante e cambierebbe radicalmente la sua vita. Nel frattempo Takumi ha modo di confrontarsi con Kyouichi Sudo e un ragazzo che guida una Totota MR2 blu e che in qualche modo è collegato ai Fujiwara: Kai Kogashiwa... Nella quotidianità, una Natsuki molto cambiata cerca di riallacciare i rapporti con Takumi approfittando delle festività natalizie, ma le cose verranno complicate dall'arrivo di una vecchia conoscenza dei ragazzi e dalle scelte che entrambi dovranno prendere...","image":"https://image.tmdb.org/t/p/original/itOyIR7Zv7Y91X3eSiNzCc1Jjiu.jpg","poster":"https://image.tmdb.org/t/p/original/8QzB6uLoRQWsTKrg0MdZ9Dfl1rH.jpg","logo":"https://image.tmdb.org/t/p/original/cnGM7pYj5O9T8n2w66Sic4Wra7R.png","background":"https://image.tmdb.org/t/p/original/itOyIR7Zv7Y91X3eSiNzCc1Jjiu.jpg","trailers":["https://www.youtube.com/watch?v=YfdONLhaEBM"],"imdbId":"tt0388130","type":"movie","tags":["Movie","Terminato","2001"],"tagKeys":{"Movie":"Movie","Terminato":"Completed"},"genres":["Action","Drama","Racing","Romance","Seinen","Sports"],"rating":"8.6","studio":"Studio DEEN","episodesCount":1,"extra":{"ids":{"malId":187,"anilistId":187,"anilistIds":[18,187],"malIds":[187],"anidbIds":[625],"imdbMovieIds":["tt0388130"],"imdbShowIds":[],"tmdbMovieIds":[80741],"tmdbShowIds":[40424],"tvdbMovieIds":[42391],"tvdbShowIds":[70900]},"stats":{"scoreRaw":"8.57","episodesCountRaw":1},"flags":{"dub":0},"meta":{"status":"Terminato","type":"Movie"},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-30T07:57:40Z","sourceDescriptors":["anilist:187"