{"id":"work-5110","sourceIds":{"anilist":3154,"mal":3154},"info":{"title":"Gatchaman (OVA)","synopsis":"Remake degli episodi 1, 11 e 105 della serie televisiva del 1972.\r\nNel primo episodio, la squadra di Gachaman dovrà affrontare una razza aliena di nome Galactor intenzionata a distruggere un progetto che prevede l'unificazione delle risorse energetiche del mondo.\r\nNel secondo episodio vedremo nuovamente i Galactor come antagonisti, ma questa volta alla squadra di Gatchaman si uniranno un misterioso guerriero e le persone al suo seguito.\r\nIl terzo e ultimo OAV è dedicato all'ultimo e più pericoloso scontro di Gatchaman in cui verrà deciso una volta per tutte il destino dell'umanità.","image":"https://image.tmdb.org/t/p/original/dDhcybdUI0iGVlNfA6N6Gb7kUYL.jpg","poster":"https://image.tmdb.org/t/p/original/qR0ec3hTZmDZftCaIScjaEFRDE2.jpg","logo":"https://image.tmdb.org/t/p/original/hC9qeC4edRvVBCpGKtSsMKn6Gxu.png","background":"https://image.tmdb.org/t/p/original/dDhcybdUI0iGVlNfA6N6Gb7kUYL.jpg","imdbId":"tt0233780","type":"movie","tags":["Movie","Terminato","Autunno","1994"],"tagKeys":{"Movie":"Movie","Terminato":"Completed","Autunno":"Autumn"},"genres":["Action","Adventure","Martial Arts","Sci-fi","Super Power"],"studio":"Tatsunoko Production","episodesCount":3,"extra":{"ids":{"malId":3154,"anilistId":3154,"crunchyId":null,"disneyId":null,"netflixId":null,"primeId":null,"anilistIds":[3154],"malIds":[3153,3154],"anidbIds":[858,5434],"imdbMovieIds":["tt0415906"],"imdbShowIds":[],"tmdbMovieIds":[310548,331399],"tmdbShowIds":[13549],"tvdbMovieIds":[],"tvdbShowIds":[73887]},"stats":{"favorites":10,"members":32,"views":4381,"episodesCountRaw":3,"episodesLength":45},"flags":{"dub":0,"alwaysHome":0},"meta":{"day":"Indeterminato","season":"Autunno","status":"Terminato","type":"Movie","createdAt":"2025-02-09 18:19:55","userId":2},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-30T07:57:40Z","sourceDescriptors":["anilist:3154","mal:31