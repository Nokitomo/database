{"id":"work-2328","sourceIds":{"anilist":97981,"mal":34541},"info":{"title":"Mary e il fiore della strega (ITA)","synopsis":"Mary Smith ha dieci anni, e si annoia: non è piacevole passare le vacanze nella solitaria casa di campagna di una vecchia zia. Ma basteranno la comparsa di un misterioso gattino nero e la scoperta di un curioso fiore rosso, perché l'estate di Mary cominci a fare scintille, tra lezioni di magia e strabilianti avventure notturne. E in men che non si dica la ragazzina si ritroverà a cavallo di una scopa volante, inseguita da una terribile strega animata dalle peggiori intenzioni.","image":"https://image.tmdb.org/t/p/original/uF6MJjKUxLjJihjN2VEHx2WB9L6.jpg","poster":"https://image.tmdb.org/t/p/original/eSy7JJLsmbnUvTn24IdtTgRdGo2.jpg","logo":"https://image.tmdb.org/t/p/original/hCLnSrNGTG96MmINSBlaFNWTcq.png","background":"https://image.tmdb.org/t/p/original/uF6MJjKUxLjJihjN2VEHx2WB9L6.jpg","trailers":["https://www.youtube.com/watch?v=Cm0YYNgNr7A"],"imdbId":"tt6336356","type":"movie","tags":["Movie","Terminato","Estate","2017"],"tagKeys":{"Movie":"Movie","Terminato":"Completed","Estate":"Summer"},"genres":["Adventure","Fantasy"],"rating":"7.9","studio":"Studio Ponoc","episodesCount":1,"extra":{"ids":{"malId":34541,"anilistId":97981,"crunchyId":null,"disneyId":null,"netflixId":null,"primeId":null,"anilistIds":[97981],"malIds":[34541],"anidbIds":[12649],"imdbMovieIds":["tt6336356"],"imdbShowIds":[],"tmdbMovieIds":[430447],"tmdbShowIds":[],"tvdbMovieIds":[2677],"tvdbShowIds":[]},"stats":{"scoreRaw":"7.92","favorites":56,"members":393,"views":12138,"episodesCountRaw":1,"episodesLength":102},"flags":{"dub":1,"alwaysHome":0},"meta":{"day":"Venerdì","season":"Estate","status":"Terminato","type":"Movie","createdAt":"2020-08-11 16:21:05","userId":78495},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-11-01T08:31:58Z","sourceDescriptors":["anilist:97981","mal:34541"],"imdbSource":"anibridge-v3","targets":[{"provider":"anidb"