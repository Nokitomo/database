{"id":"work-5873","sourceIds":{"anilist":182771,"mal":60071},"info":{"title":"A Gentle Noble's Vacation Recommendation","synopsis":"Quando Lizel si ritrova in una città che ha delle strane somiglianze con la sua ma che chiaramente non lo è, si rassegna rapidamente all'improbabile verità: si ritrova in un mondo completamente diverso. Nonostante ciò, il rilassato Lizel non è un tipo che si fa prendere dal panico. Si mette subito in viaggio per scoprire di più riguardo questo strano mondo e per farlo assume Gin, un avventuriero esperto, come sua guida turistica e protettore. Finché non riesce a trovare la strada per casa, Lizel pensa che questa sia un'ottima opportunità per esplorare un nuovo stile di vita entrando a far parte di una gilda. Dopotutto, lui è sicuro che prima o poi riuscirà a tornare... quindi perchè non godersi questa vacanza in un altro mondo?","image":"https://image.tmdb.org/t/p/original/srtpnBMKPkwYQhQBrvgX1VHRasz.jpg","poster":"https://image.tmdb.org/t/p/original/iUTmnF7QXmiRDTxfGNkL8zjIRhl.jpg","logo":"https://image.tmdb.org/t/p/original/vAILElfWV7IPZ2syUTONqDcSCaU.png","background":"https://image.tmdb.org/t/p/original/srtpnBMKPkwYQhQBrvgX1VHRasz.jpg","trailers":["https://www.youtube.com/watch?v=LKlXRCtlOVY"],"imdbId":"tt36632066","type":"series","tags":["TV","Terminato","Inverno","2026"],"tagKeys":{"TV":"TV","Terminato":"Completed","Inverno":"Winter"},"genres":["Adventure","Fantasy","Slice of Life"],"rating":"7.5","studio":"Ascension","episodesCount":12,"extra":{"ids":{"malId":60071,"anilistId":182771,"crunchyId":"GT00365550","disneyId":null,"netflixId":null,"primeId":null,"anilistIds":[182771],"malIds":[60071],"anidbIds":[18914],"imdbMovieIds":[],"imdbShowIds":[],"tmdbMovieIds":[],"tmdbShowIds":[274141],"tvdbMovieIds":[],"tvdbShowIds":[455309]},"stats":{"scoreRaw":"7.50","favorites":169,"members":1205,"views":141001,"episodesCountRaw":12,"episodesLength":23},"flags":{"dub":0,"alwaysHome":1},"meta":{"day":"Mercoledì","season":"Inverno","status":"T