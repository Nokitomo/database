"episodeNumbers":[6]}],"link":"32188","metadataSources":{"tmdb":{},"tvdb":{"title":"Tsubasa Shunraiki: Kouhen","synopsis":"The episode continues where the previous part left off, with the Clone Syaoran entering the Dream World. Watanuki is then transported away as the battle between the two Syaorans begins. The Clone gains the upper hand, and manages to knock the original Syaoran out. When Sakura attempts to protect him, the Clone stabs her but finds himself unable to kill her. He teleports her out of the way before taking the feather, but Syaoran awakens and stops the Clone as they reappear in Nihon. The two Syaorans attempt to take the feather and kill each other, but Sakura appears in the way and is impaled on Hien. She declares that she too is a Clone, and that the true Sakura is waiting for Syaoran, before dissolving into Sakura petals. Dr. Kyle appears and takes Sakura's soulless body to Fei Wang, and the Clone vanishes in anguish. They learn from Yuko that Fei Wang is in Clow Country, and that Watanuki, Syaoran's other self, paid for this information with his memories. The group then prepares to depart for Clow Country.","titleLanguage":"ita","synopsisLanguage":"eng"}},"synopsis":"The episode continues where the previous part left off, with the Clone Syaoran entering the Dream World. Watanuki is then transported away as the battle between the two Syaorans begins. The Clone gains the upper hand, and manages to knock the original Syaoran out. When Sakura attempts to protect him, the Clone stabs her but finds himself unable to kill her. He teleports her out of the way before taking the feather, but Syaoran awakens and stops the Clone as they reappear in Nihon. The two Syaorans attempt to take the feather and kill each other, but Sakura appears in the way and is impaled on Hien. She declares that she too is a Clone, and that the true Sakura is waiting for Syaoran, before dissolving into Sakura petals. Dr. Kyle appears and takes Sakura's soulless body to Fei Wang, and the Clone vanishes in anguish. They learn from Yuko that Fei Wang is in Clow Country, and that Watanuki, Syaoran's other self, paid for this information with his memories. The group then prepares to depart for Clow Country.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/76023/5049994.jpg"}],"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-30T07:57:40Z","sourceDescriptors":["anilist:4938","mal:4938"],"targets":[{"provider":"anidb","id":"3317","scope":"R"},{"provider":"anidb","id":"5301","scope":"R"},{"provider":"anidb","id":"6191","scope":"R","ranges":{"1-2":"1-2"}},{"provider":"anilist","id":"2685"},{"provider":"anilist","id":"4938","ranges":{"1-2":"1-2"}},{"provider":"anilist","id":"807"},{"provider":"imdb_movie","id":"tt0466551"},{"provider":"mal","id":"2685"},{"provider":"mal","id":"4938","ranges":{"1-2":"1-2"}},{"provider":"mal","id":"807"},{"provider":"tvdb_show","id":"76023","scope":"s0","ranges":{"1-2":"5-6"}}]},"artworkInventory":{"logo":[{"source":"tvdb","url":"https://artworks.thetvdb.com/banners/v4/series/76023/clearlogo/611bcc9516c4d.png"},{"source":"anizip","url":"https://artworks.thetvdb.com/banners/v4/series/76023/clearlogo/672381eea5d0a.png"}],"poster":[{"source":"anizip","url":"https://artworks.thetvdb.com/banners/posters/76023-3.jpg"},{"source":"provider","url":"https://img.animeunity.co/anime/4938.jpg"},{"source":"anilist","url":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/4938.jpg"}],"background":[{"source":"tvdb","url":"https://artworks.thetvdb.com/banners/fanart/original/76023-2.jpg"},{"source":"anizip","url":"https://artworks.thetvdb.com/banners/fanart/original/76023-4.jpg"},{"source":"provider","url":"https://img.animeunity.co/anime/4938-cfKO9S2kFuJz.jpg"},{"source":"anilist","url":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/4938-cfKO9S2kFuJz.jpg"}]},"artworkLibrary":{"schemaVersion":1,"tmdb":{},"tvdb":{"76023":{"schemaVersion":1,"source":"tvdb","id":76023,"m