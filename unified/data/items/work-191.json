{"id":"work-191","sourceIds":{"anilist":101310,"mal":37475},"info":{"title":"Boarding School Juliet","synopsis":"Juliet Percia e Romeo Inudzuka sono a capo di due dormitori rivali in cui risiedono gli studenti appartenenti a due paesi differenti. Le due fazioni sono in guerra tra loro per contendersi il controllo dell'isola in cui vivono. Inudzuka e Percia si dimostrano agli occhi dei loro compagni di dormitorio come acerrimi nemici, ma in realtà sono segretamente innamorati l'uno dell'altra e costretti a mantenere nascosta la loro relazione per non subire ripercussioni.","image":"https://image.tmdb.org/t/p/original/8QjrOKQRmu8jKsoQu69JkvtHZdm.jpg","poster":"https://image.tmdb.org/t/p/original/3gy956BaBswyK1tamnWaqblFlVO.jpg","logo":"https://image.tmdb.org/t/p/original/ekcUdqbqCXNSPxv8rMZrDr9ZaSK.png","background":"https://image.tmdb.org/t/p/original/8QjrOKQRmu8jKsoQu69JkvtHZdm.jpg","trailers":["https://www.youtube.com/watch?v=Z9qlvLoZH8k"],"imdbId":"tt8496638","type":"series","tags":["TV","Terminato","Autunno","2018"],"tagKeys":{"TV":"TV","Terminato":"Completed","Autunno":"Autumn"},"genres":["Action","Comedy","Romance","School","Shounen"],"rating":"8.0","studio":"LIDENFILMS","episodesCount":12,"extra":{"ids":{"malId":37475,"anilistId":101310,"crunchyId":null,"disneyId":null,"netflixId":null,"primeId":null,"anilistIds":[101310],"malIds":[37475],"anidbIds":[13911],"imdbMovieIds":[],"imdbShowIds":[],"tmdbMovieIds":[],"tmdbShowIds":[82823],"tvdbMovieIds":[],"tvdbShowIds":[350555]},"stats":{"scoreRaw":"7.97","favorites":670,"members":4037,"views":297308,"episodesCountRaw":12,"episodesLength":25},"flags":{"dub":0,"alwaysHome":0},"meta":{"day":"Venerdì","season":"Autunno","status":"Terminato","type":"TV","createdAt":"2018-10-06 21:52:40","userId":78495},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-30T07:57:40Z","sourceDescriptors":["anilist:101310","mal:37475"],"imdbSource":"plexanibridge-v2","targets":[{"provider":"anidb","id":"13911