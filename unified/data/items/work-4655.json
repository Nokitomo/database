{"id":"work-4655","sourceIds":{"anilist":1940,"mal":1940},"info":{"title":"Outlanders","synopsis":"Tetsuya Wakatsuki, un giovane fotografo, assiste all'apparizione nel cielo di un gruppo di minacciose astronavi aliene. Queste sono dell'Impero Santovasku, che, nato sul pianeta Terra molto prima della razza umana, ne vuole ora rientrare in possesso. Tetsuya ha un acceso combattimento con Kahm, figlia dell'imperatore e capo della squadra di ricognizione inviata sulla Terra. La superiorità tecnologica del nemico è schiacciante, e l'umanità pare destinata a soccombere. Tuttavia, un'amica fotografa di Tetsuya nasconde un segreto.","image":"https://image.tmdb.org/t/p/original/h7yjhn7xvggHcP0LWY8ynnzRxdc.jpg","poster":"https://image.tmdb.org/t/p/original/tKiIq3RgFOGMiNTj53wa2M68L7L.jpg","logo":"https://image.tmdb.org/t/p/original/aV8l9seAerkCLHVQKj7weNt9Py8.png","background":"https://image.tmdb.org/t/p/original/h7yjhn7xvggHcP0LWY8ynnzRxdc.jpg","imdbId":"tt0151866","type":"movie","tags":["Movie","Terminato","Autunno","1986"],"tagKeys":{"Movie":"Movie","Terminato":"Completed","Autunno":"Autumn"},"genres":["Adventure","Comedy","Ecchi","Romance","Sci-fi","Shounen"],"rating":"6.9","studio":"AIC","episodesCount":1,"extra":{"ids":{"malId":1940,"anilistId":1940,"crunchyId":null,"disneyId":null,"netflixId":null,"primeId":null,"anilistIds":[1940],"malIds":[1940],"anidbIds":[748],"imdbMovieIds":["tt0151866"],"imdbShowIds":[],"tmdbMovieIds":[68828],"tmdbShowIds":[],"tvdbMovieIds":[],"tvdbShowIds":[]},"stats":{"scoreRaw":"6.88","favorites":50,"members":209,"views":10195,"episodesCountRaw":1,"episodesLength":51},"flags":{"dub":0,"alwaysHome":0},"meta":{"day":"Indeterminato","season":"Autunno","status":"Terminato","type":"Movie","createdAt":"2024-08-09 14:42:09","userId":2},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-30T07:57:40Z","sourceDescriptors":["anilist:1940","mal:1940"],"imdbSource":"anibridge-v3","targets":[{"provider":"anidb","id":"748","sc