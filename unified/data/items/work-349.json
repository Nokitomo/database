isodeNumbers":[2]},{"provider":"tmdb_show","id":"16950","scope":"s0","seasonNumber":0,"episodeNumbers":[4]},{"provider":"tvdb_show","id":"305488","scope":"s0","seasonNumber":0,"episodeNumbers":[4]}],"link":"12394","synopsis":"エヴァンジェリンによる地獄の特訓が一段落し、つかの間のバカンスを海で過ごすことになったネギま部と３-Aメンバーたち！\n\nそんな夏の海を楽しんでいたネギ一行の前に、ネギの幼馴染のアーニャが突然現れた。夏休みなのにちっともウェールズに戻る気配の無いネギを連れ戻しにきたのだが、個性豊かな３-Aメンバーに翻弄されっぱなしのアーニャ。ライバル心を燃やすアーニャだが、一方、明日菜たちもネギ先生の幼馴染の存在が気になる様子…？\n\n真夏の海辺に温泉に―、それぞれの思惑とともにネギをめぐる女の熱いバトルは続くのであった！","thumbnail":"https://image.tmdb.org/t/p/w300/md215itAahzFpZgITRBTkmlgpF5.jpg","metadataSources":{"tmdb":{"title":"Episodio 4","synopsis":"エヴァンジェリンによる地獄の特訓が一段落し、つかの間のバカンスを海で過ごすことになったネギま部と３-Aメンバーたち！\n\nそんな夏の海を楽しんでいたネギ一行の前に、ネギの幼馴染のアーニャが突然現れた。夏休みなのにちっともウェールズに戻る気配の無いネギを連れ戻しにきたのだが、個性豊かな３-Aメンバーに翻弄されっぱなしのアーニャ。ライバル心を燃やすアーニャだが、一方、明日菜たちもネギ先生の幼馴染の存在が気になる様子…？\n\n真夏の海辺に温泉に―、それぞれの思惑とともにネギをめぐる女の熱いバトルは続くのであった！","thumbnail":"https://image.tmdb.org/t/p/w300/md215itAahzFpZgITRBTkmlgpF5.jpg","titleLanguage":"it-IT","synopsisLanguage":"ja-JP"}}},{"title":"Episodio 5","episodeNumber":3,"sourceEpisodeNumber":3,"seasonNumber":0,"externalMappings":[{"provider":"anidb","id":"5868","scope":"R","episodeNumbers":[3]},{"provider":"anilist","id":"4188","episodeNumbers":[3]},{"provider":"mal","id":"4188","episodeNumbers":[3]},{"provider":"tmdb_show","id":"16950","scope":"s0","seasonNumber":0,"episodeNumbers":[5]},{"provider":"tvdb_show","id":"305488","scope":"s0","seasonNumber":0,"episodeNumbers":[5]}],"link":"12395","synopsis":"３－Aはつかの間の夏休み―。\n\n千雨は東京ビッグサイトのイベントにコスプレで参加、フケ顔（？）の真名と楓は映画の入場料金で悪戦苦闘、まき絵は新体操競技会にて華麗な技を披露、夕映とのどかは始動キーをめぐって大騒ぎ―、と、生徒たちはそれぞれに楽しい夏休みを過ごしていた。\n\nそして、エヴァとの修業もひと段落し、準備万端のネギパーティーはいよいよウェールズへ！「父さんを捜し出す―」、決意も新たに旅立とうとするネギに、千雨は「本当に親父を捜さなきゃダメなのか？」と問いかけるが…。","thumbnail":"https://image.tmdb.org/t/p/w300/ksDDlS7vmTAtMeBCM4Z6na1hCBT.jpg","metadataSources":{"tmdb":{"title":"Episodio 5","synopsis":"３－Aはつかの間の夏休み―。\n\n千雨は東京ビッグサイトのイベントにコスプレで参加、フケ顔（？）の真名と楓は映画の入場料金で悪戦苦闘、まき絵は新体操競技会にて華麗な技を披露、夕映とのどかは始動キーをめぐって大騒ぎ―、と、生徒たちはそれぞれに楽しい夏休みを過ごしていた。\n\nそして、エヴァとの修業もひと段落し、準備万端のネギパーティーはいよいよウェールズへ！「父さんを捜し出す―」、決意も新たに旅立とうとするネギに、千雨は「本当に親父を捜さなきゃダメなのか？」と問いかけるが…。","thumbnail":"https://image.tmdb.org/t/p/w300/ksDDlS7vmTAtMeBCM4Z6na1hCBT.jpg","titleLanguage":"it-IT","synopsisLanguage":"ja-JP"}}}],"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-30T07:57:40Z","sourceDescriptors":["anilist:4188","mal:4188"],"targets":[{"provider":"anidb","id":"4510","scope":"R"},{"provider":"anidb","id":"4812","scope":"R"},{"provider":"anidb","id":"5868","scope":"R","ranges":{"1-3":"1-3"}},{"provider":"anidb","id":"6489","scope":"R"},{"provider":"anidb","id":"6489","scope":"S"},{"provider":"anidb","id":"8274","scope":"R"},{"provider":"anilist","id":"10628"},{"provider":"anilist","id":"1619"},{"provider":"anilist","id":"1732"},{"provider":"anilist","id":"4188","ranges":{"1-3":"1-3"}},{"provider":"anilist","id":"6050"},{"provider":"anilist","id":"7135"},{"provider":"imdb_movie","id":"tt3818692"},{"provider":"mal","id":"10628"},{"provider":"mal","id":"1619"},{"provider":"mal","id":"1732"},{"provider":"mal","id":"4188","ranges":{"1-3":"1-3"}},{"provider":"mal","id":"6050"},{"provider":"mal","id":"7135"},{"provider":"tvdb_movie","id":"147389"},{"provider":"tvdb_show","id":"305488","scope":"s0","ranges":{"1-3":"3-5"}}]},"artworkInventory":{"logo":[{"source":"tvdb","url":"https://artworks.thetvdb.com/banners/v4/series/305488/clearlogo/611dde074030e.png"},{"source":"anizip","url":"https://artworks.thetvdb.com/banners/v4/series/305488/clearlogo/69b4a0286b8ce.png"}],"poster":[{"source":"tvdb","url":"https://artworks.thetvdb.com/banners/series/305488/posters/5fec28f2ec051.jpg"},{"source":"provider","url":"https://img.animeunity.co/anime/bx4188-Iv82sjbW5V9M.jpg"},{"source":"anizip","url":"https://artworks.thetvdb.com/banners/seasons/305488-0.jpg"},{"source":"anilist","url":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/large/bx4188-Iv82sjbW5V9M.jpg"}],"background":[{"source":"tvdb","url":"https: