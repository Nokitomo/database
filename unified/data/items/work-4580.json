{"id":"work-4580","sourceIds":{"anilist":1064,"mal":1064},"info":{"title":"Mazinkaiser (ITA)","synopsis":"Un'armata di mostri meccanici, guidata dal Barone Ashura, attacca il centro ricerche, situato alla base del monte Fuji, sconfiggendo Mazinga Z pilotato da Koji ed il Grande Mazinga di Tetsuya. Durante la battaglia Koji perde il controllo della sua navicella schiantandosi tra le montagne, qui scopre un laboratorio segreto al cui interno è custodito Mazinkaiser, il più potente robot mai costruito dal professor Kabuto, inventore di Mazinga e nonno di Koji. Sarà grazie a Mazinkaiser che Koji potrà sconfiggere i mostri del Dr. Hell.","image":"https://image.tmdb.org/t/p/original/wTbeBbqbRvUKLs2cYwbqXiTOpHW.jpg","poster":"https://image.tmdb.org/t/p/original/n5YDvG88bKcfTnzlUwuWBsiCxE8.jpg","logo":"https://image.tmdb.org/t/p/original/kuhB6otQ7qO9HsPgw3fHjM1j7Rn.png","background":"https://image.tmdb.org/t/p/original/wTbeBbqbRvUKLs2cYwbqXiTOpHW.jpg","imdbId":"tt0388225","type":"series","tags":["OVA","Terminato","Autunno","2001"],"tagKeys":{"OVA":"OVA","Terminato":"Completed","Autunno":"Autumn"},"genres":["Adventure","Comedy","Mecha","Sci-fi","Shounen"],"rating":"8.7","studio":"Brain's Base","episodesCount":7,"extra":{"ids":{"malId":1064,"anilistId":1064,"crunchyId":null,"disneyId":null,"netflixId":null,"primeId":null,"anilistIds":[1064],"malIds":[1064,2734],"anidbIds":[953,954],"imdbMovieIds":["tt0422702"],"imdbShowIds":[],"tmdbMovieIds":[],"tmdbShowIds":[45154],"tvdbMovieIds":[],"tvdbShowIds":[82387]},"stats":{"scoreRaw":"8.68","favorites":52,"members":151,"views":33239,"episodesCountRaw":7,"episodesLength":30},"flags":{"dub":1,"alwaysHome":0},"meta":{"day":"Indeterminato","season":"Autunno","status":"Terminato","type":"OVA","createdAt":"2024-07-13 02:52:54","userId":2},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-29T07:54:59Z","sourceDescriptors":["anilist:1064","mal:1064"],"imdbSource":"plexanibridge-v2","targets":[{"provider":"ani