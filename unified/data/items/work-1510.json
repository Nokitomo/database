{"id":"work-1510","sourceIds":{"anilist":20736,"mal":21473},"info":{"title":"Persona 3 the Movie 2: Midsummer Knight's Dream","synopsis":"Secondo film tratto dal videogame Atlus. Arriva l'estate e Makoto è sempre più vicino ai suoi compagni di avventura. Al gruppo si uniscono due nuovi elementi: Aegis (un androide anti-shadow), Ken, studente delle scuole medie in cerca di vendetta dopo l'uccisione della madre, e Koromaru, un cane in grado di evocare il suo Persona. Le cose sembrano andare per il meglio, ma a poco a poco, i pezzi della nuova vita di Makoto iniziano a distruggersi e il ragazzo sarà costretto a subire il dolore delle conseguenti perdite.","image":"https://image.tmdb.org/t/p/original/wUJduJu1LY0CFEJwyvrK7fEKCNk.jpg","poster":"https://image.tmdb.org/t/p/original/zkt5xjY2sLBKvdpZ46MBW3baVTk.jpg","logo":"https://image.tmdb.org/t/p/original/iEjnDMo4sBpqxKa5vh3kKUR4yeG.svg","background":"https://image.tmdb.org/t/p/original/wUJduJu1LY0CFEJwyvrK7fEKCNk.jpg","imdbId":"tt3898504","type":"movie","tags":["Movie","Terminato","2014"],"tagKeys":{"Movie":"Movie","Terminato":"Completed"},"genres":["Action","Fantasy","Supernatural"],"rating":"8.2","studio":"A-1 Pictures","episodesCount":1,"extra":{"ids":{"malId":21473,"anilistId":20736,"anilistIds":[20736],"malIds":[21473],"anidbIds":[],"imdbMovieIds":["tt3898504"],"imdbShowIds":[],"tmdbMovieIds":[297189],"tmdbShowIds":[],"tvdbMovieIds":[39582],"tvdbShowIds":[]},"stats":{"scoreRaw":"8.23","episodesCountRaw":1},"flags":{"dub":0},"meta":{"status":"Terminato","type":"Movie"},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-11-01T08:31:58Z","sourceDescriptors":["anilist:20736","mal:21473"],"imdbSource":"anibridge-v3","targets":[{"provider":"anilist","id":"20736","ranges":{"1":"1"}},{"provider":"imdb_movie","id":"tt3898504","ranges":{"1":"1"}},{"provider":"mal","id":"21473","ranges":{"1":"1"}},{"provider":"tmdb_movie","id":"297189","ranges":{"1":"1"}},{"provider":"tvdb_movie","id":"39582","rang