{"id":"work-5933","sourceIds":{"anilist":3461,"mal":3461},"info":{"title":"Ellcia","synopsis":"Il Libro Sacro della terra di Eija è stato riscoperto e, con esso, le leggende di una nave misteriosa e onnipotente. Ora la Principessa Crystal di Megaronia è partita per una missione alla ricerca della nave e delle sue armi supreme. Tutto ciò che si frappone tra lei e la dominazione totale del mondo è un piccolo gruppo di pirati sgangherati. Spade, stregoneria e tecnologia si fondono per dare vita a un racconto affascinante di Bene contro Male a Ellcia.","image":"https://image.tmdb.org/t/p/original/z3e5MxnpooSTDmsbPp7fbP0fgV9.jpg","poster":"https://image.tmdb.org/t/p/original/8yTJWpfPSSfK26VluTqyJ6fWtEr.jpg","logo":"https://artworks.thetvdb.com/banners/v4/series/162971/clearlogo/654513a01676e.png","background":"https://image.tmdb.org/t/p/original/z3e5MxnpooSTDmsbPp7fbP0fgV9.jpg","imdbId":"tt0250358","type":"series","tags":["OVA","Terminato","Autunno","1992"],"tagKeys":{"OVA":"OVA","Terminato":"Completed","Autunno":"Autumn"},"genres":["Adventure","Fantasy"],"studio":"J.C.STAFF","episodesCount":4,"extra":{"ids":{"malId":3461,"anilistId":3461,"crunchyId":null,"disneyId":null,"netflixId":null,"primeId":null,"anilistIds":[3461],"malIds":[3461],"anidbIds":[2331],"imdbMovieIds":[],"imdbShowIds":[],"tmdbMovieIds":[],"tmdbShowIds":[44009],"tvdbMovieIds":[],"tvdbShowIds":[162971]},"stats":{"favorites":1,"members":2,"views":1019,"episodesCountRaw":4,"episodesLength":41},"flags":{"dub":0,"alwaysHome":0},"meta":{"day":"Indeterminato","season":"Autunno","status":"Terminato","type":"OVA","createdAt":"2026-02-14 05:15:16","userId":2},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-29T07:54:59Z","sourceDescriptors":["anilist:3461","mal:3461"],"imdbSource":"plexanibridge-v2","targets":[{"provider":"anidb","id":"2331","scope":"R","ranges":{"1-4":"1-4"}},{"provider":"anilist","id":"3461","ranges":{"1-4":"1-4"}},{"provider":"mal","id":"3461","ranges":{"1-4":