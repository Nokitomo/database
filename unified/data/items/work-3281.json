i là di apparenze e differenze a favore di affetto, fiducia e gentilezza. I misteri dietro a questa maledizione, tuttavia, sembrano minacciare questo rapporto - così come i pregiudizi dei simili di entrambi.","date":"2019","episodes_count":1,"episodes_length":10,"author":" ","created_at":"2022-06-07 02:44:35","status":"Terminato","imageurl_cover":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/108354-ineemjtrxhQy.jpg","type":"OVA","slug":"the-girl-from-the-other-side-siuil-a-run","title_eng":"The Girl From the Other Side: Siúil, a Rún","day":"Lunedì","favorites":72,"score":"7.69","visite":23210,"studio":"Wit Studio","dub":0,"always_home":0,"members":690,"cover":null,"anilist_id":108354,"season":"Estate","title_it":null,"mal_id":39495,"crunchy_id":null,"netflix_id":null,"prime_id":null,"disney_id":null,"pivot":{"anime_id":3785,"related_id":3784,"number":1}},{"id":3785,"user_id":78495,"title":"Totsukuni no Shoujo (2022)","imageurl":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/bx130550-TNuuHlL1BIMZ.jpg","plot":"OVA realizzato tramite crowdfunding su Kickstarter da parte di Wit Studio. È stato allegato ad un volume del manga spin-off uscito in Giappone il 10 marzo 2022.","date":"2022","episodes_count":1,"episodes_length":70,"author":" ","created_at":"2022-06-07 03:51:12","status":"Terminato","imageurl_cover":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/130550-tdYGcblNd8oU.jpg","type":"OVA","slug":"the-girl-from-the-other-side","title_eng":"The Girl From the Other Side","day":"Mercoledì","favorites":78,"score":"8.16","visite":25822,"studio":"Wit Studio","dub":0,"always_home":1,"members":601,"cover":null,"anilist_id":130550,"season":"Inverno","title_it":null,"mal_id":48405,"crunchy_id":null,"netflix_id":null,"prime_id":null,"disney_id":null,"pivot":{"anime_id":3785,"related_id":3785,"number":1}}]},"archive":null}},"availability":"present"}],"animeworld":[{"id":3926,"path":"/play/totsukuni-no-shoujo-ova.ytCrV","sourceIdentity":{"ti