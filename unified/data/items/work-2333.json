{"id":"work-2333","sourceIds":{"anilist":105190,"mal":38656},"info":{"title":"Darwin's Game","synopsis":"Kaname Sudo non aspettava una email del genere. Il contenuto del messaggio lo invitava a provare una nuova app: “Darwin’s Game”. Dopo averla installata e lanciata, Kaname viene coinvolto in un gioco sconvolgente. Nel gioco di Darwin, infatti, bisogna combattere sul serio. Anche se la via di uscita sembra non esistere.","image":"https://image.tmdb.org/t/p/original/2kbBfr1ZGuMETCMf3cC8O5sBlKA.jpg","poster":"https://image.tmdb.org/t/p/original/fue9DW4Z63maRgcY2b4ATxDTx9B.jpg","logo":"https://image.tmdb.org/t/p/original/2W2LZLHKPNGlnbqM41Fg9GNSlMm.png","background":"https://image.tmdb.org/t/p/original/2kbBfr1ZGuMETCMf3cC8O5sBlKA.jpg","trailers":["https://www.youtube.com/watch?v=uyegnzQ1CrM"],"imdbId":"tt11405390","type":"series","tags":["TV","Terminato","Inverno","2020"],"tagKeys":{"TV":"TV","Terminato":"Completed","Inverno":"Winter"},"genres":["Action","Mystery","Sci-fi","Shounen","Super Power","Survival","Thriller"],"rating":"7.8","studio":"Nexus","episodesCount":11,"extra":{"ids":{"malId":38656,"anilistId":105190,"crunchyId":null,"disneyId":null,"netflixId":null,"primeId":null,"anilistIds":[105190],"malIds":[38656],"anidbIds":[14476],"imdbMovieIds":[],"imdbShowIds":[],"tmdbMovieIds":[],"tmdbShowIds":[85942],"tvdbMovieIds":[],"tvdbShowIds":[355220]},"stats":{"scoreRaw":"7.76","favorites":297,"members":2992,"views":130373,"episodesCountRaw":11,"episodesLength":24},"flags":{"dub":0,"alwaysHome":0},"meta":{"day":"Venerdì","season":"Inverno","status":"Terminato","type":"TV","createdAt":"2020-08-12 10:37:50","userId":78495},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-30T07:57:40Z","sourceDescriptors":["anilist:105190","mal:38656"],"imdbSource":"plexanibridge-v2","targets":[{"provider":"anidb","id":"14476","scope":"R","ranges":{"1-11":"1-11"}},{"provider":"anilist","id":"105190","ranges":{"1-11":"1-11"}},{"provider":"mal","id":"3865