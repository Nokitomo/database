{"id":"work-3695","sourceIds":{"anilist":154969,"mal":53132},"info":{"title":"UniteUp!","synopsis":"Akira Kiyose canta su un sito di streaming video con il nome del cantante \"KIKUNOYU\". Un giorno l'agenzia di talenti sMiLea Production lo scova. sMiLea è un'agenzia fondata dalla leggendaria coppia di idol in pensione AneLa per addestrare nuovi idol in erba. Akira forma quindi un gruppo idol con Banri Naoe e Chihiro Isuzugawa, anch'essi scoperti dall'agenzia. Il loro nuovo gruppo, Protostar, farà il suo debutto insieme ad altri nuovi gruppi idol con sMiLea Production: Legit e Jaxx Jaxx.","image":"https://image.tmdb.org/t/p/original/axAMkNIcbyHVJj3B04LElzNmsFd.jpg","poster":"https://image.tmdb.org/t/p/original/7jWi4SppOmtQMfxmviNlEUAY3Tz.jpg","logo":"https://image.tmdb.org/t/p/original/izUB7JdbEk7Zw64B03lZX2bymQV.png","background":"https://image.tmdb.org/t/p/original/axAMkNIcbyHVJj3B04LElzNmsFd.jpg","trailers":["https://www.youtube.com/watch?v=hu1w8Ym_1SM"],"imdbId":"","type":"series","tags":["TV","Terminato","Inverno","2023"],"tagKeys":{"TV":"TV","Terminato":"Completed","Inverno":"Winter"},"genres":["Music","Slice of Life"],"rating":"7.8","studio":"CloverWorks","episodesCount":12,"extra":{"ids":{"malId":53132,"anilistId":154969,"crunchyId":null,"disneyId":null,"netflixId":null,"primeId":null,"anilistIds":[154969],"malIds":[53132],"anidbIds":[17639],"imdbMovieIds":[],"imdbShowIds":[],"tmdbMovieIds":[],"tmdbShowIds":[210899],"tvdbMovieIds":[],"tvdbShowIds":[426861]},"stats":{"scoreRaw":"7.82","favorites":29,"members":206,"views":27751,"episodesCountRaw":12,"episodesLength":24},"flags":{"dub":0,"alwaysHome":1},"meta":{"day":"Sabato","season":"Inverno","status":"Terminato","type":"TV","createdAt":"2023-01-07 18:29:09","userId":2},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-30T07:57:40Z","sourceDescriptors":["anilist:154969","mal:53132"],"targets":[{"provider":"anidb","id":"17639","scope":"R","ranges":{"1-12":"1-12"}},{"provider":"a