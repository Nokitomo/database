:"9043","scope":"R","episodeNumbers":[7]},{"provider":"anilist","id":"14467","episodeNumbers":[7]},{"provider":"mal","id":"14467","episodeNumbers":[7]},{"provider":"tmdb_show","id":"45799","scope":"s1","seasonNumber":1,"episodeNumbers":[7]},{"provider":"tvdb_show","id":"261249","scope":"s1","seasonNumber":1,"episodeNumbers":[7]}],"link":"18016","synopsis":"Unable to find any traces of his own past, Shiro begins to believe that the person known as Yashiro Isana may not have existed. As Shiro and Kurou try to think of what to do next, SCEPTER 4, led by the Blue King Reishi Munakata, arrives to apprehend them.","thumbnail":"https://image.tmdb.org/t/p/w300/vDZXnQhBjcRlUwR6CSuUsM0wIYX.jpg","metadataSources":{"tmdb":{"title":"Episodio 7","synopsis":"Unable to find any traces of his own past, Shiro begins to believe that the person known as Yashiro Isana may not have existed. As Shiro and Kurou try to think of what to do next, SCEPTER 4, led by the Blue King Reishi Munakata, arrives to apprehend them.","thumbnail":"https://image.tmdb.org/t/p/w300/vDZXnQhBjcRlUwR6CSuUsM0wIYX.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}},{"title":"Episodio 8","episodeNumber":8,"sourceEpisodeNumber":8,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"9043","scope":"R","episodeNumbers":[8]},{"provider":"anilist","id":"14467","episodeNumbers":[8]},{"provider":"mal","id":"14467","episodeNumbers":[8]},{"provider":"tmdb_show","id":"45799","scope":"s1","seasonNumber":1,"episodeNumbers":[8]},{"provider":"tvdb_show","id":"261249","scope":"s1","seasonNumber":1,"episodeNumbers":[8]}],"link":"18019","synopsis":"Neko undoes the spell placed on Shiro to help him remember who he is. But other than a brief image of being thrown from an airship by a mysterious man, Shiro remains in the dark. Determined to regain his memories, Shiro takes the risk of contacting Reishi, the Blue King, who could lead them to the mystery man.","thumbnail":"https://image.tmdb.org/t/p/w300/7vk4fU6Bf4SWKKpj0Z2DeRgBl2y.jpg","metadataSources":{"tmdb":{"title":"Episodio 8","synopsis":"Neko undoes the spell placed on Shiro to help him remember who he is. But other than a brief image of being thrown from an airship by a mysterious man, Shiro remains in the dark. Determined to regain his memories, Shiro takes the risk of contacting Reishi, the Blue King, who could lead them to the mystery man.","thumbnail":"https://image.tmdb.org/t/p/w300/7vk4fU6Bf4SWKKpj0Z2DeRgBl2y.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}},{"title":"Episodio 9","episodeNumber":9,"sourceEpisodeNumber":9,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"9043","scope":"R","episodeNumbers":[9]},{"provider":"anilist","id":"14467","episodeNumbers":[9]},{"provider":"mal","id":"14467","episodeNumbers":[9]},{"provider":"tmdb_show","id":"45799","scope":"s1","seasonNumber":1,"episodeNumbers":[9]},{"provider":"tvdb_show","id":"261249","scope":"s1","seasonNumber":1,"episodeNumbers":[9]}],"link":"18010","synopsis":"The Blue King, Reishi, accepts a proposal from Shiro to carry out an air mission to restrain the Silver King, Adolf K. Weismann. However, the mission is abruptly interrupted when the Silver King’s airship self-destructs. The following day, Reishi pays a visit to the Gold King, where he discovers the remains of the Silver King. In the meantime, an unknown force makes contact with the detained Mikoto.","thumbnail":"https://image.tmdb.org/t/p/w300/kW2wjzOYLL9WW7LuSH7rLpBf6To.jpg","metadataSources":{"tmdb":{"title":"Episodio 9","synopsis":"The Blue King, Reishi, accepts a proposal from Shiro to carry out an air mission to restrain the Silver King, Adolf K. Weismann. However, the mission is abruptly interrupted when the Silver King’s airship self-destructs. The following day, Reishi pays a visit to the Gold King, where he discovers the remains of the Silver King. In the meantime, an unknown force makes contact with the detained Mikoto.","thumbnail":"https://image.tmdb.org/t/p/w300/kW