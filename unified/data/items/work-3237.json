101","scope":"s0","seasonNumber":0,"episodeNumbers":[1]},{"provider":"tvdb_show","id":"79101","scope":"s1","seasonNumber":1,"episodeNumbers":[1]}],"link":"60933","synopsis":"Yukito Kunisaki arrives to the town in hopes of making money for food with his puppet show. He meets Misuzu Kamio, a strange girl living in the town. Misuzu manages to lure Yukito to her house with food at which after a discussion she offers him residence. Soon after Haruko Kamio, Misuzu's foster mother, arrives to the house. Haruko initially opposes Yukito's stay but later decides to allow him to stay in the shed.","thumbnail":"https://image.tmdb.org/t/p/w300/ghihhqZbX0GxqR56YLaffMCEBTK.jpg","metadataSources":{"tmdb":{"title":"Episodio 1","synopsis":"Yukito Kunisaki arrives to the town in hopes of making money for food with his puppet show. He meets Misuzu Kamio, a strange girl living in the town. Misuzu manages to lure Yukito to her house with food at which after a discussion she offers him residence. Soon after Haruko Kamio, Misuzu's foster mother, arrives to the house. Haruko initially opposes Yukito's stay but later decides to allow him to stay in the shed.","thumbnail":"https://image.tmdb.org/t/p/w300/ghihhqZbX0GxqR56YLaffMCEBTK.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}},{"title":"Town","episodeNumber":2,"sourceEpisodeNumber":2,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"2002","scope":"R","episodeNumbers":[1,2]},{"provider":"anilist","id":"101","episodeNumbers":[3]},{"provider":"mal","id":"101","episodeNumbers":[1]},{"provider":"tmdb_show","id":"26201","scope":"s1","seasonNumber":1,"episodeNumbers":[1,2]},{"provider":"tvdb_show","id":"79101","scope":"s1","seasonNumber":1,"episodeNumbers":[1,2]}],"link":"60934","metadataSources":{"tmdb":{}},"synopsis":"Yukito explains to Misuzu the quest of the cursed girl with wings that had been in his family for generations. The next day Yukito's puppet show only manages to attract a dog named Potato, while scaring others. Yukito is caught by Hijiri Kirishima while performing in front of her clinic and offers Yukito work doing odd jobs.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/79101/302757.jpg"},{"title":"Whisper","episodeNumber":3,"sourceEpisodeNumber":3,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"2002","scope":"R","episodeNumbers":[2,3]},{"provider":"anilist","id":"101","episodeNumbers":[4]},{"provider":"mal","id":"101","episodeNumbers":[2]},{"provider":"tmdb_show","id":"26201","scope":"s1","seasonNumber":1,"episodeNumbers":[2,3]},{"provider":"tvdb_show","id":"79101","scope":"s1","seasonNumber":1,"episodeNumbers":[2,3]}],"link":"60935","metadataSources":{"tmdb":{}},"synopsis":"Surroundings of Yukito and Misuzu briefly change from the shrine to a cropland as a result of Kano's experience. After a confrontation with Hijiri, Yukito and others briefly go to the clinic. Yukito and Misuzu leave the clinic for home. On their way Yukito realizes he wasn't paid for his part time job and sneaks back into the clinic only to overhear Kano's other personality.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/79101/302758.jpg"},{"title":"Plume","episodeNumber":4,"sourceEpisodeNumber":4,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"2002","scope":"R","episodeNumbers":[3,4]},{"provider":"anilist","id":"101","episodeNumbers":[5]},{"provider":"mal","id":"101","episodeNumbers":[3]},{"provider":"tmdb_show","id":"26201","scope":"s1","seasonNumber":1,"episodeNumbers":[3,4]},{"provider":"tvdb_show","id":"79101","scope":"s1","seasonNumber":1,"episodeNumbers":[3,4]}],"link":"60936","metadataSources":{"tmdb":{}},"synopsis":"Kano strangles Yukito in her zombie-like state near the shrine hard enough to leave a mark before falling unconscious. Back at the clinic, Hijiri apologizes for Kano's behavior and explains when and how Kano's unusual symptoms started, with a single bright feather at the shrine.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/79101/302759.jpg"},{"title":"Wing","episodeNumber":5,"sourceEpisodeNumber":5,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"2002","scope":"R","episodeNumbers":[4,5]},{"provider":"anilist","id":"101","episodeNumbers":[6]},{"provider":"mal","id":"101","episodeNumbers":[4]},{"provider":"tmdb_show","id":"26201","scope":"s1","seasonNumber":1,"episodeNumbers":[4,5]},{"provider":"tvdb_show","id":"79101","scope":"s1","seasonNumber":1,"episodeNumbers":[4,5]}],"link":"60937","metadataSources":{"tmdb":{}},"synopsis":"Yukito ends up spending the day with Minagi and Michiru while Misuzu is at school. Yukito walks Minagi home after being invited to go stargazing on the school's rooftop when he first learns of her mother's mental illness. Later, Misuzu attempts to play cards with Yukito, but is overcome with extreme pain. When Yukito learns of Misuzu's condition he decides to move out of the house.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/79101/302760.jpg"},{"title":"Star","episodeNumber":6,"sourceEpisodeNumber":6,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"2002","scope":"R","episodeNumbers":[5,6]},{"provider":"anilist","id":"101","episodeNumbers":[7]},{"provider":"mal","id":"101","episodeNumbers":[5]},{"provider":"tmdb_show","id":"26201","scope":"s1","seasonNumber":1,"episodeNumbers":[5,6]},{"provider":"tvdb_show","id":"79101","scope":"s1","seasonNumber":1,"episodeNumbers":[5,6]}],"link":"60938","metadataSources":{"tmdb":{}},"synopsis":"After Minagi's mother's mental condition has caused her to forget she has a daughter, Minagi leaves home and joins Yukito. Yukito tells Minagi he's leaving town and wants her to come with him, but instead leads her back home to face her mother. Michiru is invited to eat at Minagi's house. Michiru leaves, having fulfilled her purpose.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/79101/302761.jpg"},{"title":"Dream","episodeNumber":7,"sourceEpisodeNumber":7,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"2002","scope":"R","episodeNumbers":[6,7]},{"provider":"anilist","id":"101","episodeNumbers":[8]},{"provider":"mal","id":"101","episodeNumbers":[6]},{"provider":"tmdb_show","id":"26201","scope":"s1","seasonNumber":1,"episodeNumbers":[6,7]},{"provider":"tvdb_show","id":"79101","scope":"s1","seasonNumber":1,"episodeNumbers":[6,7]}],"link":"60939","metadataSources":{"tmdb":{}},"synopsis":"There are a number of flashbacks that Yukito has of his mother telling him about the girl with wings, about how she will forget everything and die when she dreams her final dream, and about how the person close to her will also die. Misuzu's foster mother leaves, leaving Yukito and Misuzu alone. Misuzu tells Yukito about her last dream, and Yukito comes to the decision to stay by her side, knowing the consequences. Yukito suddenly disappears and after Misuzu wakes up feeling better, she wonders where Yukito has gone or if he will come back.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/79101/305154.jpg"},{"title":"Summer","episodeNumber":8,"sourceEpisodeNumber":8,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"2002","scope":"R","episodeNumbers":[7,8]},{"provider":"anilist","id":"101","episodeNumbers":[9]},{"provider":"mal","id":"101","episodeNumbers":[7]},{"provider":"tmdb_show","id":"26201","scope":"s1","seasonNumber":1,"episodeNumbers":[7,8]},{"provider":"tvdb_show","id":"79101","scope":"s1","seasonNumber":1,"episodeNumbers":[7,8]}],"link":"60940","metadataSources":{"tmdb":{}},"synopsis":"This story takes place 1000 years before the Dream arc. Kanna is a girl with wings confined to a palace with a friend, Uraha, and body guard, Ryūya. When Kanna is to be sent to another temple, the 3 escape and go on a journey to find Kanna's mother. Meanwhile, the palace is attacked and the 3 are pursued. They finally find Kanna's mother but she tells them to leave.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/79101/305155.jpg"},{"title":"Moon","episodeNumber":9,"sourceEpisodeNumber":9,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"2002","scope":"R","episodeNumbers":[8,9]},{"provider":"anilist","id":"101","episodeNumbers":[10]},{"provider":"mal","id":"101","episodeNumbers":[8]},{"provider":"tmdb_show","id":"26201","scope":"s1","seasonNumber":1,"episodeNumbers":[8,9]},{"provider":"tvdb_show","id":"79101","scope":"s1","seasonNumber":1,"episodeNumbers":[8,9]}],"link":"60941","metadataSources":{"tmdb":{}},"synopsis":"Kanna's mother claims to be \"tainted\". They all escape from the mountain but their pursuers manage to kill Kanna's mother. Before she dies, she passes the ancient prayer to Kanna. While the pursuers are closing in, the 3 talk about settling down near the ocean, but Kanna knows this is only a dream. She takes flight but the monks curse her and she gets killed by the soldiers. Ryūya and Uraha learn about the curse and Kanna's suffering and vow to end it by having a child who will break the curse.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/79101/305156.jpg"},{"title":"Light","episodeNumber":10,"sourceEpisodeNumber":10,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"2002","scope":"R","episodeNumbers":[9,10]},{"provider":"anilist","id":"101","episodeNumbers":[11]},{"provider":"mal","id":"101","episodeNumbers":[9]},{"provider":"tmdb_show","id":"26201","scope":"s1","seasonNumber":1,"episodeNumbers":[9,10]},{"provider":"tvdb_show","id":"79101","scope":"s1","seasonNumber":1,"episodeNumbers":[9,10]}],"link":"60942","metadataSources":{"tmdb":{}},"synopsis":"The events of the Dream arc are retold from the point of view of a crow Misuzu found and named Sora.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/79101/305157.jpg"},{"title":"Sea","episodeNumber":11,"sourceEpisodeNumber":11,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"2002","scope":"R","episodeNumbers":[10,11]},{"provider":"anilist","id":"101","episodeNumbers":[12]},{"provider":"mal","id":"101","episodeNumbers":[10]},{"provider":"tmdb_show","id":"26201","scope":"s1","seasonNumber":1,"episodeNumbers":[10,11]},{"provider":"tvdb_show","id":"79101","scope":"s1","seasonNumber":1,"episodeNumbers":[10,11]}],"link":"60943","metadataSources":{"tmdb":{}},"synopsis":"Misuzu's curse is getting more serious. Soon, she has forgotten who Haruko is and begins to act strangely, playing cards by herself and not wanting to go outdoors. Haruko is depressed, but tries hard to restore the memories Misuzu lost. Soon, however, Misuzu's birth father shows up, and tries to claim Misuzu back from Haruko, deciding to let Misuzu decide who she wants to live with. Haruko, desperate because of Misuzu's memory loss, begs him to let her have Misuzu for 3 more days, to which he agrees.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/79101/305158.jpg"},{"title":"Air","episodeNumber":12,"sourceEpisodeNumber":12,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"2002","scope":"R","episodeNumbers":[11,12]},{"provider":"anilist","id":"101","episodeNumbers":[13]},{"provider":"mal","id":"101","episodeNumbers":[11]},{"provider":"tmdb_show","id":"26201","scope":"s1","seasonNumber":1,"episodeNumbers":[11,12]},{"provider":"tvdb_show","id":"79101","scope":"s1","seasonNumber":1,"episodeNumbers":[11,12]}],"link":"60944","metadataSources":{"tmdb":{}},"synopsis":"The summer festival has finally arrived, but unfortunately it rains that day and thus the festival is canceled. Wanting to do anything she can for Misuzu, Haruko brings her to the local shrine. As mother and daughter bond, can Haruko ultimately save Misuzu from returning to her other self in the vast blue sky?","thumbnail":"https://artworks.thetvdb.com/banners/episodes/79101/305159.jpg"}],"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-30T07:57:40Z","sourceDescriptors":["anilist:101","mal:101"],"imdbSource":"plexanibridge-