,{"provider":"tvdb_movie","id":"147389"},{"provider":"tvdb_show","id":"305488","scope":"s0","ranges":{"1":"2"}}]},"metadataTargets":[{"provider":"anidb","id":"4812","scope":"R","raw":"anidb:4812:R","ranges":{"1":"1"}},{"provider":"anilist","id":"1732","raw":"anilist:1732","ranges":{"1":"1"}},{"provider":"mal","id":"1732","raw":"mal:1732","ranges":{"1":"1"}},{"provider":"tmdb_show","id":"16950","scope":"s0","raw":"tmdb_show:16950:s0","ranges":{"1":"2"}},{"provider":"tvdb_show","id":"305488","scope":"s0","raw":"tvdb_show:305488:s0","ranges":{"1":"2"}}],"sourceIds":{"anilist":1732,"mal":1732},"tmdb":{"source":"tmdb-api","id":16950,"type":"tv","sourceUrl":"https://www.themoviedb.org/tv/16950","fetchedAt":"2026-11-02T17:20:25.741Z","originalLanguage":"ja-JP","title":{"value":"Negima!? Magister Negi Magi","language":"it-IT"},"originalTitle":"ネギま!?","overview":{"value":"Negi Springfield è un bambino prodigio di 10 anni, diplomato alla Magic Academy. Completato parte dei suoi studio, viene mandato come insegnante in una scuola in Giappone, conosciuta come Mahora Academy, per continuare il suo addestramento da mago. Un anno dopo, due rappresentanti dell'Accademia Magica si recano a Mahora e comunicano a Negi che un potente artefatto, noto come il Cristallo delle Stelle, è scomparso. Per ragioni sconosciute, il potere del manufatto colpisce Negi e i suoi studenti. Così lui e la sua classe si ritrovano a combattere contro un potere oscuro e ignoto.","language":"it-IT"},"startDate":"2006-10-04","endDate":"2007-03-28","status":"Ended","rating":5.9,"ratingCount":17,"numberOfEpisodes":26,"numberOfSeasons":1,"genres":["Animazione","Action & Adventure","Commedia"],"countries":["Japan"],"facts":{"Runtime":"25m"},"keywords":[],"networks":[{"id":98,"name":"TV Tokyo","logo":"https://image.tmdb.org/t/p/original/jnuO8pZNEBLEq5YaOP1f5OkmG91.png"}],"socialLinks":{},"cast":[{"id":1241566,"name":"Rina Sato","role":"Negi Springfield (voice)","profile":"https://image.tmdb.org/t/p/original/kk0Tir25lDqdqYHHnYCpknGgZCa.jpg"},{"id":1248793,"name":"Masahito Yabe","role":"Albert Chamomile (voice)","profile":"https://image.tmdb.org/t/p/original/gIe6al7n9Ru6tWsjU05sBK12Inw.jpg"},{"id":1241601,"name":"Akemi Kanda","role":"Asuna Kagurazaka (voice)","profile":"https://image.tmdb.org/t/p/original/plEZZj1gMzFXKeq6jtljSygs7wi.jpg"},{"id":220714,"name":"Ai Nonaka","role":"Konoka Konoe (voice)","profile":"https://image.tmdb.org/t/p/original/gEZVaoDeVK04HCmv0dJr6MGO9Se.jpg"},{"id":89903,"name":"Mamiko Noto","role":"Nodoka Miyazaki (voice)","profile":"https://image.tmdb.org/t/p/original/wCSD7Umgzc66p8VGXrrMZtSLSuS.jpg"},{"id":70099,"name":"Yuki Matsuoka","role":"Evangeline A.K. McDowell (voice)","profile":"https://image.tmdb.org/t/p/original/e8rNkMM9O7ULA1RJtLbvkN9789v.jpg"},{"id":587350,"name":"Akeno Watanabe","role":"Chachamaru Karakuri (voice)","profile":"https://image.tmdb.org/t/p/original/4E05IJxvTGNHb2GSaiyxbCZ5nd8.jpg"},{"id":1247655,"name":"Misa Kobayashi","role":"Chizuru Naba (voice)","profile":"https://image.tmdb.org/t/p/original/dyKVv4nBgP0qVd1PhYxzr0LKzjq.jpg"},{"id":216331,"name":"Norihiro Inoue","role":"Takamichi T. Takahata (voice)","profile":"https://image.tmdb.org/t/p/original/khnHP79HA0Gx2dSFa2R2AV5c0Vv.jpg"},{"id":1241503,"name":"Sawa Ishige","role":"Haruna Saotome (voice)","profile":"https://image.tmdb.org/t/p/original/mFcac1VyKfx67nN9zNavNfx43sv.jpg"},{"id":1241599,"name":"Madoka Kimura","role":"Yuuna Akashi (voice)"},{"id":228234,"name":"Junko Minagawa","role":"Ayaka Yukihiro (voice)","profile":"https://image.tmdb.org/t/p/original/vylNOlXVmYFW8TJgq3Dvgoq1dy5.jpg"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","title":"Negima!? Magister Negi Magi","overview":"Negi Springfield è un bambino prodigio di 10 anni, diplomato alla Magic Academy. Completato parte dei suoi studio, viene mandato come insegnante in una scuola in Giappone, conosciuta come Mahora Academy, per continuare il suo addestramento da mago. Un anno dopo, due rappresentanti dell'Accademia Magica si recano a Mahora e comunicano a Negi che un potente artefatto, noto come il Cristallo delle Stelle, è scomparso. Per ragioni sconosciute, il potere del manufatto colpisce Negi e i suoi studenti. Così lui e la sua classe si ritrovano a combattere contro un potere oscuro e ignoto."},{"language":"en-US","title":"Negima!? Magister Negi Magi","overview":"Wizard Negi Springfield may be a boy, but he has a man-sized job to do! Fresh from the Academy of Magic, Negi continues his training as an instructor at Mahora Academy in Japan. But before he can get his Master’s in magic, the 31 schoolgirls of Class 3-A are gonna keep him up all night cramming for a final exam in will power. Temptation aside, Negi has more on his syllabus than flirting and spells. Darkness is closing in, and Negi is gonna need help from his student bodies to drive the ghouls from their school. These girls want to prove that they’re best in class, and extra credit is available to the cuties that aren’t afraid of after hours phantom fighting – especially if it means more time with their favorite professor."},{"language":"ja-JP","overview":"英国・ウェールズの魔法学校を卒業し、魔法使い見習いとなった10歳の少年ネギ・スプリングフィールド。彼は、父親のような最上級の魔法使い｢マギステル・マギ｣になりたいと願い、日本にある麻帆良学園へと修行のために派遣されることになった。生徒数3万人以上、広大な敷地内に大学から幼稚園までのあらゆる教育施設、さらには学生寮、病院、レストラン、巨大アーケードまで、なんでも揃っている巨大学園都市・麻帆良学園。その女子中等部2年A組の担任になったネギだが、さっそくクラスの女の子から｢お子ちゃま先生｣と、先生の威厳もなく子供扱い。それどころか、魔法使いであるとバレると厳罰となってしまうにもかかわらず、初日からいきなり自分のクラスの生徒である神楽坂明日菜に、魔法使いであると感づかれそうになったり、空き部屋がないからと、女子寮にある明日菜と近衛木乃香と相部屋になったりと苦労の連続！さらに謎のドラキュラ事件も勃発。生徒のために戦うことになったネギ先生だが、彼らの信頼を得ることができるのか？ そして、この修行を乗り越え、父親のような｢マギステル・マギ｣へと辿り着くことができるのか？"}],"images":{"logos":[{"type":"logo","url":"https://image.tmdb.org/t/p/original/u33ZHOPaZotLcAavY9Sw3wxKuNN.png","previewUrl":"https://image.tmdb.org/t/p/w300/u33ZHOPaZotLcAavY9Sw3wxKuNN.png","language":"xx","width":1888,"height":1094}],"posters":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/9S2i3Ocbb7WGt94N2m64re5Sh8Q.