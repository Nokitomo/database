er":"https://image.tmdb.org/t/p/original/nCAhR3Y7ybD5Qk372tfnx41AhXA.jpg","posters":[],"backgrounds":[],"sourceUrl":"https://www.themoviedb.org/tv/16950/season/0"},{"seasonNumber":1,"name":{"value":"Stagione 1","language":"it-IT"},"year":2006,"episodeCount":26,"poster":"https://image.tmdb.org/t/p/original/lBB1LInddfesRf8A7YC3uYxb5Dl.jpg","posters":[],"backgrounds":[],"sourceUrl":"https://www.themoviedb.org/tv/16950/season/1"}],"schema":{}}},"background":"https://image.tmdb.org/t/p/original/vdoJh2xCQVEjbmb8Q3NwYFKFDr1.jpg","logo":"https://image.tmdb.org/t/p/original/u33ZHOPaZotLcAavY9Sw3wxKuNN.png"},"episodes":[{"link":"wKFtD:ep-1","sourcePath":"/episode/mahou-sensei-negima-ova-natsu-wKFtD/ep-1","sourceEpisodeNumber":1,"episodeNumber":1,"title":"Episodio 2","synopsis":"Yue and Nodoka are practicing magic, and one spell catches their eye: The Red String of Fate. Supposedly, this spell connects you with your fated partner. Nodoka decides to try it out, and ends up tied to Negi. However, this spell isn't the Red String of Fate at all, but is in fact just a red string that connects two people. A magical red string that happens to be impossible to sever. Delightful. Meanwhile, Ayaka invites the class to a free trip to her family's recently constructed spa resort. Tied together for at least a day, will Negi and Nodoka be able to make the most out of this free trip without going too far...?","thumbnail":"https://image.tmdb.org/t/p/w300/4gWUZAD5IQdh4FZcZjg8v9HA2AL.jpg","externalMappings":[{"provider":"anidb","id":"4812","scope":"R","episodeNumbers":[1]},{"provider":"anilist","id":"1732","episodeNumbers":[1]},{"provider":"mal","id":"1732","episodeNumbers":[1]},{"provider":"tmdb_show","id":"16950","scope":"s0","seasonNumber":0,"episodeNumbers":[2]},{"provider":"tvdb_show","id":"305488","scope":"s0","seasonNumber":0,"episodeNumbers":[2]}],"seasonNumber":0,"metadataSources":{"tmdb":{"title":"Episodio 2","synopsis":"Yue and Nodoka are practicing magic, and one spell catches their eye: The Red String of Fate. Supposedly, this spell connects you with your fated partner. Nodoka decides to try it out, and ends up tied to Negi. However, this spell isn't the Red String of Fate at all, but is in fact just a red string that connects two people. A magical red string that happens to be impossible to sever. Delightful. Meanwhile, Ayaka invites the class to a free trip to her family's recently constructed spa resort. Tied together for at least a day, will Negi and Nodoka be able to make the most out of this free trip without going too far...?","thumbnail":"https://image.tmdb.org/t/p/w300/4gWUZAD5IQdh4FZcZjg8v9HA2AL.jpg"}}}],"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-11-02T08:43:20Z","sourceDescriptors":["anilist:1732","mal:1732"],"targets":[{"provider":"anidb","id":"4510","scope":"R"},{"provider":"anidb","id":"4812","scope":"R","ranges":{"1":"1"}},{"provider":"anidb","id":"5868","scope":"R"},{"provider":"anidb","id":"6489","scope":"R"},{"provider":"anidb","id":"6489","scope":"S"},{"provider":"anidb","id":"8274","scope":"R"},{"provider":"anilist","id":"10628"},{"provider":"anilist","id":"1619"},{"provider":"anilist","id":"1732","ranges":{"1":"1"}},{"provider":"anilist","id":"4188"},{"provider":"anilist","id":"6050"},{"provider":"anilist","id":"7135"},{"provider":"imdb_movie","id":"tt3818692"},{"provider":"mal","id":"10628"},{"provider":"mal","id":"1619"},{"provider":"mal","id":"1732","ranges":{"1":"1"}},{"provider":"mal","id":"4188"},{"provider":"mal","id":"6050"},{"provider":"mal","id":"7135"},{"provider":"tmdb_movie","id":"102070"},{"provider":"tmdb_show","id":"16950","scope":"s0","ranges":{"1":"2"}},{"provider":"tvdb_movie","id":"147389"},{"provider":"tvdb_show","id":"305488","scope":"s0","ranges":{"1":"2"}}]},"artworkInventory":{"logo":[{"source":"tmdb","url":"https://image.tmdb.org/t/p/original/u33ZHOPaZotLcAavY9Sw3wxKuNN.png"},{"source":"tvdb","url":"https://artworks.thetvdb.com/banners/v4/series/305488/clearlo