{"id":"work-3776","sourceIds":{"anilist":106750,"mal":38915},"info":{"title":"The Island of Giant Insects","synopsis":"Gli studenti del liceo Hosho Academy sono a bordo di un aereo quando si schianta a terra in circostanze misteriose. La nostra eroina, Oribe Mutsumi, e le sue compagne di classe nuotano fino alla spiaggia di un'isola. I superstiti decidono di attendere che arrivino gli aiuti, ma l'isola si scopre essere abitata da insetti giganti! Mutsumi si sveglia sulla spiaggia e trova la sua compagna Matsuo Ayumi. Usano il loro acume per procurarsi il cibo. Nella speranza che gli aiuti arrivino entro tre giorni, decidono di sopravvivere fino a quel momento.","image":"https://image.tmdb.org/t/p/original/b42pdUFwRMBFjgHv8FUQrskYeq1.jpg","poster":"https://image.tmdb.org/t/p/original/2gCBTBqrBFjrpmmw4vpGykcnnsf.jpg","logo":"https://image.tmdb.org/t/p/original/85D1ge6gqe7Z1K74748IIg6hmNC.png","background":"https://image.tmdb.org/t/p/original/b42pdUFwRMBFjgHv8FUQrskYeq1.jpg","trailers":["https://www.youtube.com/watch?v=6vY28CqPWYs"],"imdbId":"tt10934758","type":"movie","tags":["Movie","Terminato","Primavera","2019"],"tagKeys":{"Movie":"Movie","Terminato":"Completed","Primavera":"Spring"},"genres":["Action","Drama","Ecchi","Gore","Horror","Mystery","Survival","Thriller"],"rating":"6.1","studio":"Passione","episodesCount":1,"extra":{"ids":{"malId":38915,"anilistId":106750,"crunchyId":null,"disneyId":null,"netflixId":null,"primeId":null,"anilistIds":[106750],"malIds":[38915],"anidbIds":[14568],"imdbMovieIds":["tt10934758"],"imdbShowIds":[],"tmdbMovieIds":[576617],"tmdbShowIds":[],"tvdbMovieIds":[],"tvdbShowIds":[]},"stats":{"scoreRaw":"6.12","favorites":39,"members":261,"views":16894,"episodesCountRaw":1,"episodesLength":25},"flags":{"dub":0,"alwaysHome":0},"meta":{"day":"Indeterminato","season":"Primavera","status":"Terminato","type":"Movie","createdAt":"2023-03-03 02:02:26","userId":2},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-30