08-6sn1vYneDtPc.png","plot":"L’adattamento anime dell’ultimo arco narrativo del manga di Mushishi. Ginko si imbatte su una montagna in una giocane ragazza con rami e foglie che crescono dal suo corpo. Più tardi scopre che lei è la signora della montagna, ma rimane dubbioso sul motivo per cui una ragazza come lei è stata scelta per quel ruolo. Successivamente incontra il vecchio fratello di lei che ha continuato a cercarla fin dalla sua scomparsa durante un giorno di pioggia.\r\n\r\nLa storia riguarda quella ragazza, Kaya, e quanto sia divisa tra il continuare a eseguire il suo dovere da “mushi lord” e il ritornare a casa dalla sua amata famiglia.","date":"2015","episodes_count":1,"episodes_length":47,"author":" ","created_at":"2019-07-16 01:24:19","status":"Terminato","imageurl_cover":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/n21008-pkux60PUKby0.jpg","type":"Movie","slug":"mushishi-zoku-shou-suzu-no-shizuku","title_eng":"Mushishi Zoku Shou: Suzu no Shizuku","day":"Venerdì","favorites":45,"score":"8.33","visite":32290,"studio":"Artland","dub":0,"always_home":0,"members":301,"cover":null,"anilist_id":21008,"season":"Primavera","title_it":null,"mal_id":28957,"crunchy_id":null,"netflix_id":null,"prime_id":null,"disney_id":null,"pivot":{"anime_id":1167,"related_id":1167,"number":1}}]},"archive":null}},"availability":"present"}],"animeworld":[],"animesaturn":[{"id":"GUmsx","path":"/anime/mushishi-zoku-shou-suzu-no-shizuku-GUmsx","sourceIdentity":{"title":"Mushishi Zoku Shou: Suzu no Shizuku","type":"Movie","year":2015},"sourceIds":{"mal":28957,"anilist":21008},"collection":{"mode":"linked","primary":"animeunity","workId":"work-950","fingerprint":"b67c79db36b63a4956c2eddc647ef32c99847a0b6f119c22ec057683e427a3ab","episodeResolution":"live","identityCheckedAt":1794266913323},"audio":"Giapponese","dubbed":false,"episodeResolution":"live","episodes":[{"id":"GUmsx:ep-1","number":"1","label":"1","path":"/episode/mushishi-zoku-shou-suzu-no-shizuku-GUmsx/ep-1","tit