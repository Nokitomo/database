b_show","id":"42855","scope":"s1","seasonNumber":1,"episodeNumbers":[1]},{"provider":"tvdb_show","id":"79108","scope":"s1","seasonNumber":1,"episodeNumbers":[1]}],"link":"39948","synopsis":"High school is almost over, but Haruka has never seen the fruition of her deep crush on Takayuki.  Not to worry.  With her best friend’s help, Haruka is going to learn what it means to find the one person you’ve always felt was your soul mate.  But even best friends can’t control the emotions of a headstrong young man.  Haruka’s world is changing quickly, and soon, it will take a turn she can never take back.","thumbnail":"https://image.tmdb.org/t/p/w300/q9g9oMlg8XfJVggaviKKhffk8Gc.jpg","metadataSources":{"tmdb":{"title":"Episodio 1","synopsis":"High school is almost over, but Haruka has never seen the fruition of her deep crush on Takayuki.  Not to worry.  With her best friend’s help, Haruka is going to learn what it means to find the one person you’ve always felt was your soul mate.  But even best friends can’t control the emotions of a headstrong young man.  Haruka’s world is changing quickly, and soon, it will take a turn she can never take back.","thumbnail":"https://image.tmdb.org/t/p/w300/q9g9oMlg8XfJVggaviKKhffk8Gc.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}},{"title":"Episodio 2","episodeNumber":2,"sourceEpisodeNumber":2,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"896","scope":"R","episodeNumbers":[2]},{"provider":"anilist","id":"147","episodeNumbers":[2]},{"provider":"mal","id":"147","episodeNumbers":[2]},{"provider":"tmdb_show","id":"42855","scope":"s1","seasonNumber":1,"episodeNumbers":[2]},{"provider":"tvdb_show","id":"79108","scope":"s1","seasonNumber":1,"episodeNumbers":[2]}],"link":"39953","synopsis":"Life could not be better for Haruka and Takayuki. But unexpected feelings of jealousy drive Mitsuki to meddle. Running late for his date with Haruka, Takayuki bumps into Mitsuki once again.","thumbnail":"https://image.tmdb.org/t/p/w300/yuhI7Hy7WyNPv9nPlL24HXOoIOI.jpg","metadataSources":{"tmdb":{"title":"Episodio 2","synopsis":"Life could not be better for Haruka and Takayuki. But unexpected feelings of jealousy drive Mitsuki to meddle. Running late for his date with Haruka, Takayuki bumps into Mitsuki once again.","thumbnail":"https://image.tmdb.org/t/p/w300/yuhI7Hy7WyNPv9nPlL24HXOoIOI.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}},{"title":"Episodio 3","episodeNumber":3,"sourceEpisodeNumber":3,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"896","scope":"R","episodeNumbers":[3]},{"provider":"anilist","id":"147","episodeNumbers":[3]},{"provider":"mal","id":"147","episodeNumbers":[3]},{"provider":"tmdb_show","id":"42855","scope":"s1","seasonNumber":1,"episodeNumbers":[3]},{"provider":"tvdb_show","id":"79108","scope":"s1","seasonNumber":1,"episodeNumbers":[3]}],"link":"39958","synopsis":"Three years have passed since the tragic accident.  Even though Takayuki, Mitsuki, and Shinji have continued their lives; Haruka has been stuck in a coma and left in the hospital.  Has the group of friends been separated forever?  Will a love blossom even through these dark times?  Just when things seem to be getting back to normal, there’s a reminder that darkness still waits just around the corner.","thumbnail":"https://image.tmdb.org/t/p/w300/x5hrLWIosTaNKX7liLL5kKA9fpC.jpg","metadataSources":{"tmdb":{"title":"Episodio 3","synopsis":"Three years have passed since the tragic accident.  Even though Takayuki, Mitsuki, and Shinji have continued their lives; Haruka has been stuck in a coma and left in the hospital.  Has the group of friends been separated forever?  Will a love blossom even through these dark times?  Just when things seem to be getting back to normal, there’s a reminder that darkness still waits just around the corner.","thumbnail":"https://image.tmdb.org/t/p/w300/x5hrLWIosTaNKX7liLL5kKA9fpC.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}},{"title":"Episodio 4","episodeNumber":4,"sourceEpisodeNumber":4,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"896","scope":"R","episodeNumbers":[4]},{"provider":"anilist","id":"147","episodeNumbers":[4]},{"provider":"mal","id":"147","episodeNumbers":[4]},{"provider":"tmdb_show","id":"42855","scope":"s1","seasonNumber":1,"episodeNumbers":[4]},{"provider":"tvdb_show","id":"79108","scope":"s1","seasonNumber":1,"episodeNumbers":[4]}],"link":"39947","synopsis":"Takayuki and Mitsuki are a happy couple, so much so that they're planning on moving in together. But all of that happiness and security is put into question when the unthinkable happens... Haruka, Takayuki's first love, awakes from her coma. Now Takayuki is faced with the tought reality of the life he has chosen. Does he continue with his normal life with Mitsuki or return to the woman he left behind?","thumbnail":"https://image.tmdb.org/t/p/w300/3NTTAurvd8jOmHPkk5pWyA05aa3.jpg","metadataSources":{"tmdb":{"title":"Episodio 4","synopsis":"Takayuki and Mitsuki are a happy couple, so much so that they're planning on moving in together. But all of that happiness and security is put into question when the unthinkable happens... Haruka, Takayuki's first love, awakes from her coma. Now Takayuki is faced with the tought reality of the life he has chosen. Does he continue with his normal life with Mitsuki or return to the woman he left behind?","thumbnail":"https://image.tmdb.org/t/p/w300/3NTTAurvd8jOmHPkk5pWyA05aa3.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}},{"title":"Episodio 5","episodeNumber":5,"sourceEpisodeNumber":5,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"896","scope":"R","episodeNumbers":[5]},{"provider":"anilist","id":"147","episodeNumbers":[5]},{"provider":"mal","id":"147","episodeNumbers":[5]},{"provider":"tmdb_show","id":"42855","scope":"s1","seasonNumber":1,"episodeNumbers":[5]},{"provider":"tvdb_show","id":"79108","scope":"s1","seasonNumber":1,"episodeNumbers":[5]}],"link":"39949","synopsis":"It’s been a year since the accident and Takayuki is in a deep rut of grief.  Mitsuki does everything she can to keep his spirits up, but it seems as if nothing can jar him from his dark state.  After a breakdown at the hospital, Takayuki is banned from visiting Haruka by her parents.  In an attempt to comfort him, Mitsuki ends up confessing her love for Takayuki, only to have Akane find out about her betrayal in the worst possible way.","thumbnail":"https://image.tmdb.org/t/p/w300/23YHnQPSrwK0eYFtB7Uz3iV8QgG.jpg","metadataSources":{"tmdb":{"title":"Episodio 5","synopsis":"It’s been a year since the accident and Takayuki is in a deep rut of grief.  Mitsuki does everything she can to keep his spirits up, but it seems as if nothing can jar him from his dark state.  After a breakdown at the hospital, Takayuki is banned from visiting Haruka by her parents.  In an attempt to comfort him, Mitsuki ends up confessing her love for Takayuki, only to have Akane find out about her betrayal in the worst possible way.","thumbnail":"https://image.tmdb.org/t/p/w300/23YHnQPSrwK0eYFtB7Uz3iV8QgG.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}},{"title":"Episodio 6","episodeNumber":6,"sourceEpisodeNumber":6,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"896","scope":"R","episodeNumbers":[6]},{"provider":"anilist","id":"147","episodeNumbers":[6]},{"provider":"mal","id":"147","episodeNumbers":[6]},{"provider":"tmdb_show","id":"42855","scope":"s1","seasonNumber":1,"episodeNumbers":[6]},{"provider":"tvdb_show","id":"79108","scope":"s1","seasonNumber":1,"episodeNumbers":[6]}],"link":"39956","synopsis":"Haruka’s condition has them all living out a warped high school daydream, as they are forced to act as if the past three years haven’t occurred. For the young girl’s sake, Takayuki has vowed to visit her every day at the hospital and continue this façade. Remembering that Haruka was once the most important thing in his life, he wonders if she still is. When Mitsuki attempts to visit Haruka at the hospital, Akane stops her and yells at her for being selfish, chasing her off.","thumbnail":"https://image.tmdb.org/t/p/w300/nAtltS4dmZtAvBMjHY2jrjon7Bk.jpg","metadataSources":{"tmdb":{"title":"Episodio 6","synopsis":"Haruka’s condition has them all living out a warped high school daydream, as they are forced to act as if the past three years haven’t occurred. For the young girl’s sake, Takayuki has vowed to visit her every day at the hospital and continue this façade. Remembering that Haruka was once the most important thing in his life, he wonders if she still is. When Mitsuki attempts to visit Haruka at the hospital, Akane stops her and yells at her for being selfish, chasing her off.","thumbnail":"https://image.tmdb.org/t/p/w300/nAtltS4dmZtAvBMjHY2jrjon7Bk.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}},{"title":"Episodio 7","episodeNumber":7,"sourceEpisodeNumber":7,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"896","scope":"R","episodeNumbers":[7]},{"provider":"anilist","id":"147","episodeNumbers":[7]},{"provider":"mal","id":"147","episodeNumbers":[7]},{"provider":"tmdb_show","id":"42855","scope":"s1","seasonNumber":1,"episodeNumbers":[7]},{"provider":"tvdb_show","id":"79108","scope":"s1","seasonNumber":1,"episodeNumbers":[7]}],"link":"39955","synopsis":"As Takayuki spends more and more time at the hospital, his old feelings for Haruka begin to resurface. When Akane walks in and discovers the two in a romantic embrace, she accuses Takayuki of playing with her sister’s feelings. Mitsuki, upset by her suspicions that the young man still loves his high school sweetheart, makes matters worse with a night out on the town. Both of them distraught and distracted with recent events, words are spoken which cannot be taken back…","thumbnail":"https://image.tmdb.org/t/p/w300/8uvIL5XWhGQVK3VaiSgH8jlJ2WB.jpg","metadataSources":{"tmdb":{"title":"Episodio 7","synopsis":"As Takayuki spends more and more time at the hospital, his old feelings for Haruka begin to resurface. When Akane walks in and discovers the two in a romantic embrace, she accuses Takayuki of playing with her sister’s feelings. Mitsuki, upset by her suspicions that the young man still loves his high school sweetheart, makes matters worse with a night out on the town. Both of them distraught and distracted with recent events, words are spoken which cannot be taken back…","thumbnail":"https://image.tmdb.org/t/p/w300/8uvIL5XWhGQVK3VaiSgH8jlJ2WB.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}},{"title":"Episodio 8","episodeNumber":8,"sourceEpisodeNumber":8,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"896","scope":"R","episodeNumbers":[8]},{"provider":"anilist","id":"147","episodeNumbers":[8]},{"provider":"mal","id":"147","episodeNumbers":[8]},{"provider":"tmdb_show","id":"42855","scope":"s1","seasonNumber":1,"episodeNumbers":[8]},{"provider":"tvdb_show","id":"79108","scope":"s1","seasonNumber":1,"episodeNumbers":[8]}],"link":"39957","synopsis":"As Takayuki begins to enjoy the fantasy more than the reality, Mitsuki becomes suspicious and decides to visit Haruka herself. All the young girl can talk about is their “shared” beau and her love for him. That evening Mitsuki presents Takayuki with an ultimatum, forcing him to end his daily visits. Instead of getting better, their home life gets much, much worse. One rainy evening at the restaurant, Takayuki sees Akane across the street and worried, heads straight to the hospital.","thumbnail":"https://image.tmdb.org/t/p/w300/ubLQXs7YoLPc430PfruhvRFWlJB.jpg","metadataSources":{"tmdb":{"title":"Episodio 8","synopsis":"As Takayuki begins to enjoy the fantasy more than the reality, Mitsuki becomes suspicious and decides to visit Haruka herself. All the young girl can talk about is their “shared” beau and her love for him. That evening Mitsuki presents Takayuki with an ultimatum, forcing him to end his daily visits. Instead of getting better, their home life gets much, much worse. One rainy evening at the restaurant, Takayuki sees Akane across the street and worried, heads straight to the hospital.","thumbnail":"https://image.tmdb.org/t/p/w300/ubLQXs7YoLPc430PfruhvRFWlJB.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}},{"title":"Episodio 9","episodeNumber":9,"sourceEpisodeNumber":9,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"896","scope":"R","episodeNumbers":[9]},{"provider":"anilist","id":"147","episodeNumbers":[9]},{"provider":"mal","id":"147","episodeNumbers":[9]},{"provider":"tmdb_show","id":"42855","scope":"s1","seasonNumber":1,"episodeNumbers":[9]},{"provider":"tvdb_show","id":"79108","scope":"s1","seasonNumber":1,"episodeNumbers":[9]}],"link":"39950","synopsis":"Everyone’s lives are spiraling out of control. Takayuki doesn’t seem to have even the slightest interest in the promotion being offered to him at work, and Mitsuki’s drinking is getting worse.","thumbnail":"https://image.tmdb.org/t/p/w300/5pdXoZQKC2r4fBJKvwmxEqubQ53.jpg","metadataSources":{"tmdb":{"title":"Episodio 9","synopsis":"Everyone’s lives are spiraling out of control. Takayuki doesn’t seem to have even the slightest interest in the promotion being offered to him at work, and Mitsuki’s drinking is getting worse.","thumbnail":"https://image.tmdb.org/t/p/w300/5pdXoZQKC2r4fBJKvwmxEqubQ53.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}},{"title":"Episodio 10","episodeNumber":10,"sourceEpisodeNumber":10,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"896","scope":"R","episodeNumbers":[10]},{"provider":"anilist","id":"147","episodeNumbers":[10]},{"provider":"mal","id":"147","episodeNumbers":[10]},{"provider":"tmdb_show","id":"42855","scope":"s1","seasonNumber":1,"episodeNumbers":[10]},{"provider":"tvdb_show","id":"79108","scope":"s1","seasonNumber":1,"episodeNumbers":[10]}],"link":"39951","synopsis":"Haruka is gaining some awareness of the passage of time, while Takayuki has no idea of where Misuki has disappeared to. When Haruka finally asks what day it is and how much time has passed, she is upset to learn that they have lied to her this entire time. Akane simply cannot take anymore and tells her sister the full, harsh truth, sending everyone into a panic. Meanwhile, Mitsuki has hit rock bottom, believing she has lost it all. With her liquid courage she seeks to damn them all…","thumbnail":"https://image.tmdb.org/t/p/w300/vNgcyqUsu1z2GUXQAE60SmH4rFu.jpg","metadataSources":{"tmdb":{"title":"Episodio 10","synopsis":"Haruka is gaining some awareness of the passage of time, while Takayuki has no idea of where Misuki has disappeared to. When Haruka finally asks what day it is and how much time has passed, she is upset to learn that they have lied to her this entire time. Akane simply cannot take anymore and tells her sister the full, harsh truth, sending everyone into a panic. Meanwhile, Mitsuki has hit rock bottom, believing she has lost it all. With her liquid courage she seeks to damn them all…","thumbnail":"https://image.tmdb.org/t/p/w300/vNgcyqUsu1z2GUXQAE60SmH4rFu.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}},{"title":"Episodio 11","episodeNumber":11,"sourceEpisodeNumber":11,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"896","scope":"R","episodeNumbers":[11]},{"provider":"anilist","id":"147","episodeNumbers":[11]},{"provider":"mal","id":"147","episodeNumbers":[11]},{"provider":"tmdb_show","id":"42855","scope":"s1","seasonNumber":1,"episodeNumbers":[11]},{"provider":"tvdb_show","id":"79108","scope":"s1","seasonNumber":1,"episodeNumbers":[11]}],"link":"39945","synopsis":"The entire world has gone crazy! Mitsuki has seduced Shinji, taking advantage of his feelings for her, and is now faced with regrets. Haruka’s collapsed back into a coma to protect her from the emotional overload, and all they can do at this point is continue to shelter her from the outside world. Akane, taking on the guilt for their combined mistakes, has disappeared and is no where to be found. And Takayuki’s illness has progressed to the point of collapse…","thumbnail":"https://image.tmdb.org/t/p/w300/fdHAbqQsDT0MoqbojeJwnmAov6r.jpg","metadataSources":{"tmdb":{"title":"Episodio 11","synopsis":"The entire world has gone crazy! Mitsuki has seduced Shinji, taking advantage of his feelings for her, and is now faced with regrets. Haruka’s collapsed back into a coma to protect her from the emotional overload, and all they can do at this point is continue to shelter her from the outside world. Akane, taking on the guilt for their combined mistakes, has disappeared and is no where to be found. And Takayuki’s illness has progressed to the point of collapse…","thumbnail":"https://image.tmdb.org/t/p/w300/fdHAbqQsDT0MoqbojeJwnmAov6r.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}},{"title":"Episodio 12","episodeNumber":12,"sourceEpisodeNumber":12,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"896","scope":"R","episodeNumbers":[12]},{"provider":"anilist","id":"147","episodeNumbers":[12]},{"provider":"mal","id":"147","episodeNumbers":[12]},{"provider":"tmdb_show","id":"42855","scope":"s1","seasonNumber":1,"episodeNumbers":[12]},{"provider":"tvdb_show","id":"79108","scope":"s1","seasonNumber":1,"episodeNumbers":[12]}],"link":"39952","synopsis":"Mitsuki cares for Takayuki as he recovers, telling him how she has given up everything in her life to be with him. Confessing to her affair with Shinji, his lack of anger confirms her worst fears. He doesn’t love her. Unable to compete with Haruka any longer, Mitsuki leaves. Haruka wakes back up, this time being nothing like the last awakening. In fact the girl doesn’t even remember her first time awake. And when Shinji approaches Takayuki to make amends, the two have it out.","thumbnail":"https://image.tmdb.org/t/p/w300/6ANbKh6H1IsfhwjabM1TnvY8IdR.jpg","metadataSources":{"tmdb":{"title":"Episodio 12","synopsis":"Mitsuki cares for Takayuki as he recovers, telling him how she has given up everything in her life to be with him. Confessing to her affair with Shinji, his lack of anger confirms her worst fears. He doesn’t love her. Unable to compete with Haruka any longer, Mitsuki leaves. Haruka wakes back up, this time being nothing like the last awakening. In fact the girl doesn’t even remember her first time awake. And when Shinji approaches Takayuki to make amends, the two have it out.","thumbnail":"https://image.tmdb.org/t/p/w300/6ANbKh6H1IsfhwjabM1TnvY8IdR.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}},{"title":"Episodio 13","episodeNumber":13,"sourceEpisodeNumber":13,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"896","scope":"R","episodeNumbers":[13]},{"provider":"anilist","id":"147","episodeNumbers":[13]},{"provider":"mal","id":"147","episodeNumbers":[13]},{"provider":"tmdb_show","id":"42855","scope":"s1","seasonNumber":1,"episodeNumbers":[13]},{"provider":"tvdb_show","id":"79108","scope":"s1","seasonNumber":1,"episodeNumbers":[13]}],"link":"39946","synopsis":"Takayuki visits with Haruka. Realizing that three years have passed and things change, she asks him if he’s dating anyone else. He tells here there’s no one. But when Mitsuki visits at the young girl’s request, Haruka learns the truth. Upset, she throws Mitsuki out of the room. Haruka wants to know why she lost three years, and why she woke up now with everything all screwed up. But most of all, she wants that time back, the three years that she slept through.","thumbnail":"https://image.tmdb.org/t/p/w300/1vPjeBCHKIxzRQS4Xniu4a9SWIo.jpg","metadataSources":{"tmdb":{"title":"Episodio 13","synopsis":"Takayuki visits with Haruka. Realizing that three years have passed and things change, she asks him if he’s dating anyone else. He tells here there’s no one. But when Mitsuki visits at the young girl’s request, Haruka learns the truth. Upset, she throws Mitsuki out of the room. Haruka wants to know why she lost three years, and why she woke up now with everything all screwed up. But most of all, she wants that time back, the three years that she slept through.","thumbnail":"https://image.tmdb.org/t/p/w300/1vPjeBCHKIxzRQS4Xniu4a9SWIo.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}},{"title":"Episodio 14","episodeNumber":14,"sourceEpisodeNumber":14,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"896","scope":"R","episodeNumbers":[14]},{"provider":"anilist","id":"147","episodeNumbers":[14]},{"provider":"mal","id":"147","episodeNumbers":[14]},{"provider":"tmdb_show","id":"42855","scope":"s1","seasonNumber":1,"episodeNumbers":[14]},{"provider":"tvdb_show","id":"79108","scope":"s1","seasonNumber":1,"episodeNumbers":[14]}],"link":"39954","synopsis":"Haruka, having accepted things as they are and dedicated to her rehabilitation, has gained new confidence. She tells Takayuki that they must part ways, thanking him for the memories – their life together was like a dream. The young man resolves to fix things with Mitsuki, realizing that he needs her, that he truly loves her. Having searched everywhere for Mitsuki, Takayuki finally finds her and confesses his love and his desire that she always be by his side.","thumbnail":"https://image.tmdb.org/t/p/w300/dsuyG00bNglBg5stBLu5zn34Bja.jpg","metadataSources":{"tmdb":{"title":"Episodio 14","synopsis":"Haruka, having accepted things as they are and dedicated to her rehabilitation, has gained new confidence. She tells Takayuki that they must part ways, thanking him for the memories – their life together was like a dream. The young man resolves to fix things with Mitsuki, realizing that he needs her, that he truly loves her. Having searched everywhere for Mitsuki, Takayuki finally finds her and confesses his love and his desire that she always be by his side.","thumbnail":"https://image.tmdb.org/t/p/w300/dsuyG00bNglBg5stBLu5zn34Bja.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}}],"mappings":{"source":"anibridge-v3","schemaVersi