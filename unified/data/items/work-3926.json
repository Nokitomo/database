{"id":"work-3926","sourceIds":{"anilist":743,"mal":743},"info":{"title":"Si sente il mare (ITA)","synopsis":"Rikako è una ragazza bella e intelligente, brillante nello studio e nello sport, ma molto viziata. Trasferitasi al secondo anno di liceo nella città di Kochi, fa amicizia con due suoi coetanei: Taku e Matsuno. Alcuni anni dopo, Taku, ormai studente universitario, rievoca attraverso un lungo flashback il suo rapporto con i due amici, fatto di affetto, ma anche di invidia e numerosi litigi a causa di Rikako, della quale lui e Matsuno erano segretamente innamorati.","image":"https://image.tmdb.org/t/p/original/sIRutO4Zbr1a0JKZunJKSytYQ69.jpg","poster":"https://image.tmdb.org/t/p/original/zZ57NCdZbAwpepxTVP40Sh3rj57.jpg","logo":"https://image.tmdb.org/t/p/original/tvGIf7q00VkvYKz8lDC6UzU0C5A.png","background":"https://image.tmdb.org/t/p/original/sIRutO4Zbr1a0JKZunJKSytYQ69.jpg","trailers":["https://www.youtube.com/watch?v=tfkHiHjrqa8"],"imdbId":"tt0108432","type":"movie","tags":["Movie","Terminato","Primavera","1993"],"tagKeys":{"Movie":"Movie","Terminato":"Completed","Primavera":"Spring"},"genres":["Drama","Romance","School","Slice of Life"],"rating":"7.4","studio":"Studio Ghibli","episodesCount":1,"extra":{"ids":{"malId":743,"anilistId":743,"crunchyId":null,"disneyId":null,"netflixId":null,"primeId":null,"anilistIds":[743],"malIds":[743],"anidbIds":[335],"imdbMovieIds":["tt0108432"],"imdbShowIds":[],"tmdbMovieIds":[21057],"tmdbShowIds":[],"tvdbMovieIds":[4600],"tvdbShowIds":[]},"stats":{"scoreRaw":"7.38","favorites":58,"members":347,"views":10208,"episodesCountRaw":1,"episodesLength":72},"flags":{"dub":1,"alwaysHome":0},"meta":{"day":"Indeterminato","season":"Primavera","status":"Terminato","type":"Movie","createdAt":"2023-04-21 15:14:02","userId":2},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-30T07:57:40Z","sourceDescriptors":["anilist:743","mal:743"],"imdbSource":"anibridge-v3","targets":[{"provider":"anidb","id":"335","