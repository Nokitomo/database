it-IT","synopsisLanguage":"en-US"},"tvdb":{"title":"Project Eden","synopsis":"After stopping a group of Vizorium smugglers, Kei and Yuri, the Lovely Angels (more commonly known as the Dirty Pair), are sent on a mission to Agerna, a planet rich with Vizorium, a mineral necessary for space travel. They are sent to stop the mysterious attacks on mining operations that have the governments of the world pointing fingers and blaming each other. While the pair bathe, Carson D. Carson, a former member of the group of smugglers they stopped on their last mission, interrupts their baths by falling through a vent. While Kei and Yuri get out of the bathtubs and question Carson, they are attacked by strange alien monsters that force the Angels to flee, leaving their equipment behind and wearing nothing but towels.","titleLanguage":"eng","synopsisLanguage":"eng"}}}],"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-30T07:57:40Z","sourceDescriptors":["anilist:1796","mal:1796"],"imdbSource":"anibridge-v3","targets":[{"provider":"anidb","id":"1032","scope":"R","ranges":{"1":"1"}},{"provider":"anidb","id":"1174","scope":"R"},{"provider":"anidb","id":"1381","scope":"R"},{"provider":"anidb","id":"882","scope":"R"},{"provider":"anilist","id":"1794"},{"provider":"anilist","id":"1795"},{"provider":"anilist","id":"1796","ranges":{"1":"1"}},{"provider":"anilist","id":"4200"},{"provider":"imdb_movie","id":"tt0099435"},{"provider":"imdb_movie","id":"tt0385668","ranges":{"1":"1"}},{"provider":"imdb_movie","id":"tt0434908"},{"provider":"mal","id":"1794"},{"provider":"mal","id":"1795"},{"provider":"mal","id":"1796","ranges":{"1":"1"}},{"provider":"mal","id":"4200"},{"provider":"tmdb_movie","id":"68368","ranges":{"1":"1"}},{"provider":"tmdb_show","id":"9161","scope":"s0","ranges":{"1":"1"}},{"provider":"tvdb_movie","id":"145826"},{"provider":"tvdb_movie","id":"67788"},{"provider":"tvdb_show","id":"72442","scope":"s0","ranges":{"1":"12"}}]},"artworkInventory":{"log