{"id":"work-4713","sourceIds":{"anilist":1028,"mal":1028},"info":{"title":"Princess Arete","synopsis":"Il movie (della durata di 105 minuti circa) prende spunto dalla classica trama della principessa imprigionata, ma ribalta con un'ironia sottile e pervasiva i vari stereotipi del genere: né i nobili cavalieri, né il potente stregone, né il re saggio e rispettato sono quello che appaiono a prima vista. Arete Hime inserisce nella tipica cornice della fiaba una riflessione sul concetto di virtù come accettazione della realtà. Dai produttori di Kigeki, un racconto coinvolgente che ci porterà assieme ad Arete alla ricerca del \"potere che è in ogni persona\".","image":"https://image.tmdb.org/t/p/original/w5TOLHmwAxMmkyfo71qYVr4AhdQ.jpg","poster":"https://image.tmdb.org/t/p/original/lVngEXEdGUePCQY3G5NOYstYjtB.jpg","logo":"https://image.tmdb.org/t/p/original/z0MkHZOQmAjlJCmjIIAGuMgsbim.png","background":"https://image.tmdb.org/t/p/original/w5TOLHmwAxMmkyfo71qYVr4AhdQ.jpg","trailers":["https://www.youtube.com/watch?v=kobQELVQkNs"],"imdbId":"tt0306474","type":"movie","tags":["Movie","Terminato","Estate","2001"],"tagKeys":{"Movie":"Movie","Terminato":"Completed","Estate":"Summer"},"genres":["Adventure","Fantasy"],"rating":"8.0","studio":"Studio 4°C","episodesCount":1,"extra":{"ids":{"malId":1028,"anilistId":1028,"crunchyId":null,"disneyId":null,"netflixId":null,"primeId":null,"anilistIds":[1028],"malIds":[1028],"anidbIds":[1190],"imdbMovieIds":["tt0306474"],"imdbShowIds":[],"tmdbMovieIds":[59297],"tmdbShowIds":[],"tvdbMovieIds":[17598],"tvdbShowIds":[]},"stats":{"scoreRaw":"8.00","favorites":4,"members":33,"views":2441,"episodesCountRaw":1,"episodesLength":105},"flags":{"dub":0,"alwaysHome":0},"meta":{"day":"Indeterminato","season":"Estate","status":"Terminato","type":"Movie","createdAt":"2024-09-14 17:18:47","userId":2},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-11-01T08:31:58Z","sourceDescriptors":["anilist:1028","mal:1028"],"imdbSource