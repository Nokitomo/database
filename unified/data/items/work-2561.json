{"id":"work-2561","sourceIds":{"anilist":124153,"mal":42923},"info":{"title":"SK8 the Infinity","synopsis":"Le storia segue le vicende di Reki, uno studente del secondo anno del liceo amante dello skateboard, che viene improvvisamente coinvolto nella \"S\", una pericolosa gara underground senza regole che si tiene in una miniera abbandonata. Ranga, che è tornato in Giappone dal Canada e non ha mai fatto skateboard prima, viene coinvolto nella gara insieme a Reki. Partecipanti sleali, intelligenze artificiali e altri individui davvero unici si sfideranno in questa \"battaglia di skate giovanile\".","image":"https://image.tmdb.org/t/p/original/kPE8mQC3fyVpLvcQu0AFpu3J7zI.jpg","poster":"https://image.tmdb.org/t/p/original/3ZhGFQl9186weKzkxoD4aeqgBoz.jpg","logo":"https://image.tmdb.org/t/p/original/xwSJFINp8lT8p99WTRytF4kyefu.png","background":"https://image.tmdb.org/t/p/original/kPE8mQC3fyVpLvcQu0AFpu3J7zI.jpg","trailers":["https://www.youtube.com/watch?v=guStf5P4Js0"],"imdbId":"tt13129190","type":"series","tags":["TV","Terminato","Inverno","2021"],"tagKeys":{"TV":"TV","Terminato":"Completed","Inverno":"Winter"},"genres":["Action","Comedy","Drama","Racing","Sports"],"rating":"8.6","studio":"Bones","episodesCount":12,"extra":{"ids":{"malId":42923,"anilistId":124153,"crunchyId":null,"disneyId":null,"netflixId":null,"primeId":null,"anilistIds":[124153],"malIds":[42923],"anidbIds":[15736],"imdbMovieIds":[],"imdbShowIds":[],"tmdbMovieIds":[],"tmdbShowIds":[110309],"tvdbMovieIds":[],"tvdbShowIds":[388858]},"stats":{"scoreRaw":"8.55","favorites":1115,"members":5577,"views":621888,"episodesCountRaw":12,"episodesLength":24},"flags":{"dub":0,"alwaysHome":1},"meta":{"day":"Sabato","season":"Inverno","status":"Terminato","type":"TV","createdAt":"2021-01-12 01:56:50","userId":78495},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-30T07:57:40Z","sourceDescriptors":["anilist:124153","mal:42923"],"imdbSource":"plexanibridge-v2","targets":[{"provider"