"tvdb_show:276777:s0","ranges":{"1-2":"1-2"}}],"sourceIds":{"anilist":119665,"mal":24469},"tmdb":{"source":"tmdb-api","id":60663,"type":"tv","sourceUrl":"https://www.themoviedb.org/tv/60663","fetchedAt":"2026-11-02T19:12:45.186Z","originalLanguage":"ja-JP","title":{"value":"Buddy Complex","language":"it-IT"},"originalTitle":"バディ・コンプレックス","overview":{"value":"Quando un normale studente di liceo Aoba Watase viene improvvisamente preso di mira da un robot gigante noto come \"Valiancer\", viene salvato dalla sua misteriosa compagna di classe Hina Yumihara. Dopo aver rivelato che lei e il loro nemico robotico provengono dal futuro, Hina spinge improvvisamente Aoba di 70 anni in avanti per prevenire la sua morte. All'arrivo, Aoba si ritrova nell'abitacolo di un Valiancer chiamato \"Luxon\", bloccato nel bel mezzo di uno scontro a fuoco tra le forze militari della Free Pact Alliance (FPA) e la Repubblica di Zogilia. Dopo aver dimostrato un'elevata compatibilità con un pilota FPA di nome Dio Weinberg, i due eseguono un \"accoppiamento\" riuscito, consentendo loro di condividere esperienze e successivamente aumentare le loro capacità e abilità.","language":"it-IT"},"startDate":"2013-12-29","endDate":"2014-03-31","status":"Ended","rating":6.5,"ratingCount":13,"numberOfEpisodes":13,"numberOfSeasons":1,"genres":["Animazione","Sci-Fi & Fantasy","War & Politics"],"countries":["Japan"],"facts":{"Runtime":"25m"},"keywords":[],"networks":[{"id":614,"name":"TOKYO MX","logo":"https://image.tmdb.org/t/p/original/hSdroyVthq3CynxTIIY7lnS8w1.png"}],"socialLinks":{},"cast":[{"id":233590,"name":"Yoshitsugu Matsuoka","role":"Aoba Watase (voice)","profile":"https://image.tmdb.org/t/p/original/ugDwdWEXnmv43jcbnfAi4XwiQ8C.jpg"},{"id":1254052,"name":"Koki Uchiyama","role":"Dio Junyou Weinberg (voice)","profile":"https://image.tmdb.org/t/p/original/sllSm3iZZWVLTBrDZQRtWrZUfEj.jpg"},{"id":221773,"name":"Saori Hayami","role":"Hina Yumihara (voice)","profile":"https://image.tmdb.org/t/p/original/gLv9lO7dlUbIsmyJUvgegqAAXki.jpg"},{"id":936275,"name":"Aoi Yuki","role":"Fiona Junyou Weinberg (voice)","profile":"https://image.tmdb.org/t/p/original/a5Mkd66GV1l3c9bZZtnvjUf33T2.jpg"},{"id":144655,"name":"Tomokazu Sugita","role":"Lee Conrad (voice)","profile":"https://image.tmdb.org/t/p/original/cv5zuPZySNsHXu24pjKLYCRzJ2J.jpg"},{"id":225996,"name":"Hiroyuki Yoshino","role":"Jarl Duran (voice)","profile":"https://image.tmdb.org/t/p/original/nZQbjjvAjPpjGYenY7kLDtW9e7N.jpg"},{"id":1210634,"name":"Nobunaga Shimazaki","role":"Tarjim Vasily (voice)","profile":"https://image.tmdb.org/t/p/original/qke5rZusHsjSlvB0NKlJ5dQF5D.jpg"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","title":"Buddy Complex","overview":"Quando un normale studente di liceo Aoba Watase viene improvvisamente preso di mira da un robot gigante noto come \"Valiancer\", viene salvato dalla sua misteriosa compagna di classe Hina Yumihara. Dopo aver rivelato che lei e il loro nemico robotico provengono dal futuro, Hina spinge improvvisamente Aoba di 70 anni in avanti per prevenire la sua morte. All'arrivo, Aoba si ritrova nell'abitacolo di un Valiancer chiamato \"Luxon\", bloccato nel bel mezzo di uno scontro a fuoco tra le forze militari della Free Pact Alliance (FPA) e la Repubblica di Zogilia. Dopo aver dimostrato un'elevata compatibilità con un pilota FPA di nome Dio Weinberg, i due eseguono un \"accoppiamento\" riuscito, consentendo loro di condividere esperienze e successivamente aumentare le loro capacità e abilità."},{"language":"en-US","title":"Buddy Complex","overview":"When a giant robot suddenly attacks the city, a high-school student named Aoba is saved by a classmate who's piloting her own mecha. After accepting an offer to join the alliance she's is a part of, Aoba is thrust into the middle of high-flying robot warfare."},{"language":"ja-JP","overview":"都内の高校に通う渡瀬青葉は、何気ない日常を送っていた。夏休み明けの始業式の日、いつものように学校へと向かった青葉は、ある出来事をきっかけに一人の少年と出会う。彼の名は隼鷹・ディオ・ウ