{"id":"work-3925","sourceIds":{"anilist":1029,"mal":1029},"info":{"title":"Pioggia di ricordi (ITA)","synopsis":"Taeko è una donna trentenne nata e vissuta in città che decide di passare le vacanze in campagna da dei parenti. Durante il viaggio, inizia a ricordare vari eventi di quando aveva dieci anni. Il film alterna per tutta la sua durata questi due piani temporali, dal presente in cui la Taeko adulta apprezza le gioie della vita di campagna, al passato, in cui la Taeko bambina deve giostrarsi tra scuola elementare e famiglia.","image":"https://image.tmdb.org/t/p/original/jeVmGgpqtsrFqHDS9yqAfil3zJz.jpg","poster":"https://image.tmdb.org/t/p/original/2qqpBK3gmQu7MdQS4HcSphvXAS5.jpg","logo":"https://image.tmdb.org/t/p/original/mCVQ3skzaXH7DHUErFly8dUCabE.png","background":"https://image.tmdb.org/t/p/original/jeVmGgpqtsrFqHDS9yqAfil3zJz.jpg","trailers":["https://www.youtube.com/watch?v=OfkQlZArxw0"],"imdbId":"tt0102587","type":"movie","tags":["Movie","Terminato","Estate","1991"],"tagKeys":{"Movie":"Movie","Terminato":"Completed","Estate":"Summer"},"genres":["Drama","Josei","Romance","Slice of Life"],"rating":"7.7","studio":"Studio Ghibli","episodesCount":1,"extra":{"ids":{"malId":1029,"anilistId":1029,"crunchyId":null,"disneyId":null,"netflixId":null,"primeId":null,"anilistIds":[1029],"malIds":[1029],"anidbIds":[333],"imdbMovieIds":["tt0102587"],"imdbShowIds":[],"tmdbMovieIds":[15080],"tmdbShowIds":[],"tvdbMovieIds":[6540],"tvdbShowIds":[]},"stats":{"scoreRaw":"7.66","favorites":54,"members":302,"views":10094,"episodesCountRaw":1,"episodesLength":118},"flags":{"dub":1,"alwaysHome":0},"meta":{"day":"Indeterminato","season":"Estate","status":"Terminato","type":"Movie","createdAt":"2023-04-21 15:07:19","userId":2},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-11-01T08:31:58Z","sourceDescriptors":["anilist:1029","mal:1029"],"imdbSource":"anibridge-v3","targets":[{"provider":"anidb","id":"333","scope":"R","ranges":{"1":"1"}},{"provider"