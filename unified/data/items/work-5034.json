medium/tt10706734/img"},{"source":"anizip","url":"https://artworks.thetvdb.com/banners/fanart/original/313702-2.jpg"}]}},"related":[],"linkList":[{"title":"Episodes 1-12","titleKey":"Episodes {{start}}-{{end}}","titleParams":{"start":1,"end":12},"availabilityStatus":"available","episodesLink":"6026|1|12"}]},"episodes":[{"title":"Episodio 1","episodeNumber":1,"sourceEpisodeNumber":1,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"12137","scope":"R","episodeNumbers":[1]},{"provider":"anilist","id":"21824","episodeNumbers":[1]},{"provider":"mal","id":"33341","episodeNumbers":[1]},{"provider":"tmdb_show","id":"67677","scope":"s1","seasonNumber":1,"episodeNumbers":[1]},{"provider":"tvdb_show","id":"313702","scope":"s1","seasonNumber":1,"episodeNumbers":[1]}],"link":"89505","synopsis":"中学2年生の早瀬真理は、3年前に失踪した科学者の父・永司の事を気にかけていた。真理の首からは、永司からもらったペンダント・アーミラリーコンパスがぶら下がっている。ある日、真理は、友人・水城和花の兄・旬の部屋で永司の研究所で見かけた『Magnets & Electricity』と題された本を見つける。その本を開くとアーミラリーコンパスが激しく回転し、真理はあふれた出たゆらぎに包まれ、和花の眼前から消えてしまう。","thumbnail":"https://artworks.thetvdb.com/banners/series/313702/episodes/60129ab9c17c4.jpg","metadataSources":{"tmdb":{"title":"Episodio 1","synopsis":"中学2年生の早瀬真理は、3年前に失踪した科学者の父・永司の事を気にかけていた。真理の首からは、永司からもらったペンダント・アーミラリーコンパスがぶら下がっている。ある日、真理は、友人・水城和花の兄・旬の部屋で永司の研究所で見かけた『Magnets & Electricity』と題された本を見つける。その本を開くとアーミラリーコンパスが激しく回転し、真理はあふれた出たゆらぎに包まれ、和花の眼前から消えてしまう。","titleLanguage":"it-IT","synopsisLanguage":"ja-JP"},"tvdb":{"title":"Gilbert il saggio","synopsis":"Mari Hayase è una studentessa delle scuole medie senza particolari doti per l'apprendimento o lo studio, che spende le sue giornate divisa tra la scuola e gli amici, in particolare la coetanea Waka. Di contro suo padre, il professor Hayase, è un illustre scienziato di fama internazionale, che tuttavia manca da casa da tre anni e di cui Mari sente molto la mancanza.","titleLanguage":"ita","synopsisLanguage":"ita"}}},{"title":"Episodio 2","episodeNumber":2,"sourceEpisodeNumber":2,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"12137","scope":"R","episodeNumbers":[2]},{"provider":"anilist","id":"21824","episodeNumbers":[2]},{"provider":"mal","id":"33341","episodeNumbers":[2]},{"provider":"tmdb_show","id":"67677","scope":"s1","seasonNumber":1,"episodeNumbers":[2]},{"provider":"tvdb_show","id":"313702","scope":"s1","seasonNumber":1,"episodeNumbers":[2]}],"link":"89506","synopsis":"1600年のロンドンにタイムスリップした真理。そこで出会ったウィリアム・ギルバートは「地球は大きな磁性体」であることを、方位磁針と伏角計の角度によって証明しようとしていた。一方、真理の行方が掴めぬまま早瀬研究所の周りを探していた旬たちは、見知らぬ警官に声を掛けられる。真理の事を伏せ、警官の職務質問をかわす旬。だが旬たちと別れた後、警官は謎の男・御影に連絡を取るのだった。","thumbnail":"https://artworks.thetvdb.com/banners/series/313702/episodes/60129b6188889.jpg","metadataSources":{"tmdb":{"title":"Episodio 2","synopsis":"1600年のロンドンにタイムスリップした真理。そこで出会ったウィリアム・ギルバートは「地球は大きな磁性体」であることを、方位磁針と伏角計の角度によって証明しようとしていた。一方、真理の行方が掴めぬまま早瀬研究所の周りを探していた旬たちは、見知らぬ警官に声を掛けられる。真理の事を伏せ、警官の職務質問をかわす旬。だが旬たちと別れた後、警官は謎の男・御影に連絡を取るのだった。","titleLanguage":"it-IT","synopsisLanguage":"ja-JP"},"tvdb":{"title":"Gilbert triste","synopsis":"Nel presente, Waka e suo fratello Shun, alla ricerca di una spiegazione per quanto accaduto a Mari, si recano nel vecchio laboratorio del professor Hayase. Intanto, nel XVII secolo, Mari è testimone degli studi condotti da William Gilbert nel campo della fisica e della magnetostatica.","titleLanguage":"ita","synopsisLanguage":"ita"}}},{"title":"Episodio 3","episodeNumber":3,"sourceEpisodeNumber":3,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"12137","scope":"R","episodeNumbers":[3]},{"provider":"anilist","id":"21824","episodeNumbers":[3]},{"provider":"mal","id":"33341","episodeNumbers":[3]},{"provider":"tmdb_show","id":"67677","scope":"s1","seasonNumber":1,"episodeNumbers":[3]},{"provider":"tvdb_show","id":"313702","scope":"s1","seasonNumber":1,"episodeNumbers":[3]}],"link":"89508","synopsis":"早瀬研究所の地下にタイムスリップするためのシステムがある事が判明する。だが、システムの使い方が解らぬまま、真理は再び1752年のアメリカに再びタイムスリップしてしまう。そこで彼女は黒人奴隷のジャンという少年に助けられる。彼の主人は避雷針を発明したベンジャミン・フランクリン。落雷による被害を軽減させようと避雷針の普及に奔走していたフランクリンだったが――。","thumbnail":"https://artworks.thetvdb.com/banners/series/313702/episodes/60129c5981e4c.jpg","metadataSources":{"tmdb":{"title":"Episodio 3","synopsis":"早瀬研究所の地下にタイムスリップするためのシステムがある事が判明する。だが、システムの使い方が解らぬまま、真理は再び1752年のアメリカに再びタイムスリップしてしまう。そこで彼女は黒人奴隷のジャンという少年に助けられる。彼の主人は避雷針を発明したベンジャミン・フランクリン。落雷による被害を軽減させようと避雷針の普及に奔走していたフランクリンだったが――。","titleLanguage":"it-IT","synopsisLanguage":"ja-JP"},"tvdb":{"title":"Franklin il ribelle","synopsis":"Avventuratisi nuovamente nel laboratorio del professor Hayase, Mari, Waka e Shun scoprono una stanza segreta, all'interno della quale trovano un gigantesco orologio a pendolo e un misterioso supercomputer, tutti e due in qualche modo collegati al ciondolo di Mari e ai viaggi nel tempo.","titleLanguage":"ita","synopsisLanguage":"ita"}}},{"title":"Episodio 4","episodeNumber":4,"sourceEpisodeNumber":4,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"12137","scope":"R","episodeNumbers":[4]},{"provider":"anilist","id":"21824","episodeNumbers":[4]},{"provider":"mal","id":"33341","episodeNumbers":[4]},{"provider":"tmdb_show","id":"67677","scope":"s1","seasonNumber":1,"episodeNumbers":[4]},{"provider":"tvdb_show","id":"313702","scope":"s1","seasonNumber":1,"episodeNumbers":[4]}],"link":"89507","synopsis":"本の肖像画に触れるとタイムスリップすると察した真理。跳んだ先は1800年のイタリア・パヴィア。貴族の屋敷で研究資金調達のため、電気銃を使ったデモンストレーションを行っていたアレキサンドロ・ボルタの前だった。突然出現した真理に困惑するボルタ。彼は、父を探していると言う真理に永司らしい人物が何度か自分の大学に尋ねてきている話をするのだった。","thumbnail":"https://artworks.thetvdb.com/banners/series/313702/episodes/60129d6e01446.jpg","metadataSources":{"tmdb":{"title":"Episodio 4","synopsis":"本の肖像画に触れるとタイムスリップすると察した真理。跳んだ先は1800年のイタリア・パヴィア。貴族の屋敷で研究資金調達のため、電気銃を使ったデモンストレーションを行っていたアレキサンドロ・ボルタの前だった。突然出現した真理に困惑するボルタ。彼は、父を探していると言う真理に永司らしい人物が何度か自分の大学に尋ねてきている話をするのだった。","titleLanguage":"it-IT","synopsisLanguage":"ja-JP"},"tvdb":{"title":"Volta sul campo di battaglia","synopsis":"Questa volta il nuovo viaggio nel tempo di Mari la conduce nella Pavia del 1800, nel pieno di una Campagna d'Italia inspiegabilmente ancora in atto, e la città aspramente contesa tra le truppe di occupazione austriache e l'esercito francese guidato da Napoleone.","titleLanguage":"ita","synopsisLanguage":"ita"}}},{"title":"Episodio 5","episodeNumber":5,"sourceEpisodeNumber":5,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"12137","scope":"R","episodeNumbers":[5]},{"provider":"anilist","id":"21824","episodeNumbers":[5]},{"provider":"mal","id":"33341","episodeNumbers":[5]},{"provider":"tmdb_show","id":"67677","scope":"s1","seasonNumber":1,"episodeNumbers":[5]},{"provider":"tvdb_show","id":"313702","scope":"s1","seasonNumber":1,"episodeNumbers":[5]}],"link":"89509","synopsis":"サッカーばかりして成績が上がらない同級生・風太を心配するあまり、苛立って喧嘩をしてしまう和花。言い過ぎたことを後悔した和花は以前に見つけたアーミラリーコンパスでタイムスリップし、数時間前の風太との喧嘩を止めたいと訴え、真理や旬と口論しているうちに真理と共に1821年のロンドンにタイムスリップしてしまう。","thumbnail":"https://artworks.thetvdb.com/banners/series/313702/episodes/60129ea597849.jpg","metadataSources":{"tmdb":{"title":"Episodio 5","synopsis":"サッカーばかりして成績が上がらない同級生・風太を心配するあまり、苛立って喧嘩をしてしまう和花。言い過ぎたことを後悔した和花は以前に見つけたアーミラリーコンパスでタイムスリップし、数時間前の風太との喧嘩を止めたいと訴え、真理や旬と口論しているうちに真理と共に1821年のロンドンにタイムスリップしてしまう。","titleLanguage":"it-IT","synopsisLanguage":"ja-JP"},"tvdb":{"title":"La malinconia di Faraday","synopsis":"Dal momento che Waka ha trovato casualmente un secondo giroscopio dotato del potere di viaggiare nel tempo, stavolta lei e Mari compiono un viaggio insieme, ritrovandosi nella Londra del 1821, agli albori della Rivoluzione Industriale.","titleLanguage":"ita","synopsisLanguage":"ita"}}},{"title":"Episodio 6","episodeNumber":6,"sourceEpisodeNumber":6,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"12137","scope":"R","episodeNumbers":[6]},{"provider":"anilist","id":"21824","episodeNumbers":[6]},{"provider":"mal","id":"33341","episodeNumbers":[6]},{"provider":"tmdb_show","id":"67677","scope":"s1","seasonNumber":1,"episodeNumbers":[6]},{"provider":"tvdb_show","id":"313702","scope":"s1","seasonNumber":1,"episodeNumbers":[6]}],"link":"89510","synopsis":"パティスリー・クワルツに現れた御影は、永司が契約違反を起こしていると晶に告げ、研究成果の引き渡しを要求する。一方、1821年のロンドンに1人取り残された和花は混乱し、ファラデーに八つ当たりしていた。真理はボルタのところで聞いた永司からの伝言を思い出し、旬に伝える。TSSの制御方法が掴めてゆく。","thumbnail":"https://artworks.thetvdb.com/banners/series/313702/episodes/60129f86f3dbd.jpg","metadataSources":{"tmdb":{"title":"Episodio 6","synopsis":"パティスリー・クワルツに現れた御影は、永司が契約違反を起こしていると晶に告げ、研究成果の引き渡しを要求する。一方、1821年のロンドンに1人取り残された和花は混乱し、ファラデーに八つ当たりしていた。真理はボルタのところで聞いた永司からの伝言を思い出し、旬に伝える。TSSの制御方法が掴めてゆく。","titleLanguage":"it-IT","synopsisLanguage":"ja-JP"},"tvdb":{"title":"La risolutezza di Faraday","synopsis":"Waka, rimasta nel passato, si fa per un attimo prendere dallo sconforto, venendo confortata da Faraday, e dopo una notte di riposo lei e Mari riescono finalmente a parlarsi, grazie ad una comunicazione telepatica generata dai medaglioni.","titleLanguage":"ita","synopsisLanguage":"ita"}}},{"title":"Episodio 7","episodeNumber":7,"sourceEpisodeNumber":7,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"12137","scope":"R","episodeNumbers":[7]},{"provider":"anilist","id":"21824","episodeNumbers":[7]},{"provider":"mal","id":"33341","episodeNumbers":[7]},{"provider":"tmdb_show","id":"67677","scope":"s1","seasonNumber":1,"episodeNumbers":[7]},{"provider":"tvdb_show","id":"313702","scope":"s1","seasonNumber":1,"episodeNumbers":[7]}],"link":"89512","synopsis":"TSSがコントロールできるようになり、永司が跳んだ座標を調べようと試みている旬。だが、和花はとりあえず真理を次の科学者の元へ飛ばしてみる事を提案する。かくして、1825年のアメリカ・ニューヘイブンへ跳んだ真理は、妻の死に目に会えず墓所で泣き崩れているサミュエル・モールスと出会う。","thumbnail":"https://artworks.thetvdb.com/banners/series/313702/episodes/6012a07de1f8d.jpg","metadataSources":{"tmdb":{"title":"Episodio 7","synopsis":"TSSがコントロールできるようになり、永司が跳んだ座標を調べようと試みている旬。だが、和花はとりあえず真理を次の科学者の元へ飛ばしてみる事を提案する。かくして、1825年のアメリカ・ニューヘイブンへ跳んだ真理は、妻の死に目に会えず墓所で泣き崩れているサミュエル・モールスと出会う。","titleLanguage":"it-IT","synopsisLanguage":"ja-JP"},"tvdb":{"title":"L'ispirazione di Morse","synopsis":"Grazie alle informazioni ottenute dal dottor Eiji Mari, Shun e Waka hanno ora il controllo assoluto sulla macchina e i viaggi del tempo, e decidono di servirsene per cercare di scoprire il motivo che starebbe dietro alla sua creazione. Mari compie così un nuovo viaggio nel passato, questa volta sulle tracce di Samuel Morse.","titleLanguage":"ita","synopsisLanguage":"ita"}}},{"title":"Episodio 8","episodeNumber":8,"sourceEpisodeNumber":8,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"12137","scope":"R","episodeNumbers":[8]},{"provider":"anilist","id":"21824","episodeNumbers":[8]},{"provider":"mal","id":"33341","episodeNumbers":[8]},{"provider":"tmdb_show","id":"67677","scope":"s1","seasonNumber":1,"episodeNumbers":[8]},{"provider":"tvdb_show","id":"313702","scope":"s1","seasonNumber":1,"episodeNumbers":[8]}],"link":"89511","synopsis":"夏休み。真理たちは豪華な別荘や海を満喫していたが、突然現れた御影に誘われBBQをすることに。一方の永司は1876年のボストンで、聾唖教育と電話機開発を両立しようとするグラハム・ベルの様子を見守っていた。ベルの電話機がフィラデルフィア万博に出品されることになり、彼らは万博会場へと向かう。そのころ夏の浜辺にて真理は、晶に接近する御影と、旬に近寄る黒木にモヤモヤを感じていた。","thumbnail":"https://artworks.thetvdb.com/banners/series/313702/episodes/6012a12711be6.jpg","metadataSources":{"tmdb":{"title":"Episodio 8","synopsis":"夏休み。真理たちは豪華な別荘や海を満喫していたが、突然現れた御影に誘われBBQをすることに。一方の永司は1876年のボストンで、聾唖教育と電話機開発を両立しようとするグラハム・ベルの様子を見守っていた。ベルの電話機がフィラデルフィア万博に出品されることになり、彼らは万博会場へと向かう。そのころ夏の浜辺にて真理は、晶に接近する御影と、旬に近寄る黒木にモヤモヤを感じていた。","titleLanguage":"it-IT","synopsisLanguage":"ja-JP"},"tvdb":{"title":"La decisione di Bell","synopsis":"Boston, 1876. Il professor Hayase è sulle tracce di Alexander Graham Bell, il futuro inventore del telefono, che tuttavia in quest'epoca lavora ancora come semplice insegnante di fonetica e oralistica nella scuola di famiglia.","titleLanguage":"ita","synopsisLanguage":"ita"}}},{"title":"Episodio 9","episodeNumber":9,"sourceEpisodeNumber":9,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"12137","scope":"R","episodeNumbers":[9]},{"provider":"anilist","id":"21824","episodeNumbers":[9]},{"provider":"mal","id":"33341","episodeNumbers":[9]},{"provider":"tmdb_show","id":"67677","scope":"s1","seasonNumber":1,"episodeNumbers":[9]},{"provider":"tvdb_show","id":"313702","scope":"s1","seasonNumber":1,"episodeNumbers":[9]}],"link":"89514","synopsis":"思いがけず1876年のフィラデルフィアにタイムスリップした真理だったが、永司の姿を見掛け追いかけた先でグラハム・ベルと出会う。一方、現代では理香が真理のタイムスリップした様子を晶に話してしまう。焦る和花と旬に、晶はその事が永司の研究と関係あるのではないかと迫る。","thumbnail":"https://artworks.thetvdb.com/banners/series/313702/episodes/6012a1e79835e.jpg","metadataSources":{"tmdb":{"title":"Episodio 9","synopsis":"思いがけず1876年のフィラデルフィアにタイムスリップした真理だったが、永司の姿を見掛け追いかけた先でグラハム・ベルと出会う。一方、現代では理香が真理のタイムスリップした様子を晶に話してしまう。焦る和花と旬に、晶はその事が永司の研究と関係あるのではないかと迫る。","titleLanguage":"it-IT","synopsisLanguage":"ja-JP"},"tvdb":{"title":"Le risposte di Bell","synopsis":"Date le circostanze, Waka e Shun non hanno altra scelta che parlare dell'esistenza del libro e della macchina del tempo alla madre di Mari, quindi il gruppo, disfatosi con un pretesto di Mikage, fa velocemente ritorno al laboratorio nell'attesa che Mari torni indietro.","titleLanguage":"ita","synopsisLanguage":"ita"}}},{"title":"Episodio 10","episodeNumber":10,"sourceEpisodeNumber":10,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"12137","scope":"R","episodeNumbers":[10]},{"provider":"anilist","id":"21824","episodeNumbers":[10]},{"provider":"mal","id":"33341","episodeNumbers":[10]},{"provider":"tmdb_show","id":"67677","scope":"s1","seasonNumber":1,"episodeNumbers":[10]},{"provider":"tvdb_show","id":"313702","scope":"s1","seasonNumber":1,"episodeNumbers":[10]}],"link":"89513","synopsis":"晶に二度とタイムスリップしないと約束した真理だったが、やはり永司の事が心配になり、和花に頼み込んで再び過去の世界へ。1893年のドイツ。ハインリッヒ・ヘルツは病を患いながら電磁波や陰極線の研究に打ち込んでいた。ヘルツの家で永司と再会した真理はタイムスリップの危険性を永司に伝える。","thumbnail":"https://artworks.thetvdb.com/banners/series/313702/episodes/6012a33c87397.jpg","metadataSources":{"tmdb":{"title":"Episodio 10","synopsis":"晶に二度とタイムスリップしないと約束した真理だったが、やはり永司の事が心配になり、和花に頼み込んで再び過去の世界へ。1893年のドイツ。ハインリッヒ・ヘルツは病を患いながら電磁波や陰極線の研究に打ち込んでいた。ヘルツの家で永司と再会した真理はタイムスリップの危険性を永司に伝える。","titleLanguage":"it-IT","synopsisLanguage":"ja-JP"},"tvdb":{"title":"L'orgoglio di Hertz","synopsis":"Mari defies her mother and travels back in time once again. Meanwhile, trouble is brewing back at Hayase's lab.","titleLanguage":"ita","synopsisLanguage":"eng"}}},{"title":"Episodio 11","episodeNumber":11,"sourceEpisodeNumber":11,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"12137","scope":"R","episodeNumbers":[11]},{"provider":"anilist","id":"21824","episodeNumbers":[11]},{"provider":"mal","id":"33341","episodeNumbers":[11]},{"provider":"tmdb_show","id":"67677","scope":"s1","seasonNumber":1,"episodeNumbers":[11]},{"provider":"tvdb_show","id":"313702","scope":"s1","seasonNumber":1,"episodeNumbers":[11]}],"link":"89516","synopsis":"和花たちを人質にとられた真理は、御影たちにTSSの仕組みを話してしまう。時を越える発明は大きなビジネスになると得意げに笑う御影。「そんな悪用は許せない」と主張する晶。だが御影から、既に永司もTSSを使って研究資金の返済を行ったことを聞き、彼女は絶句する。契約上の約束を破った永司と話をつけるため、永司のもとに自分を跳ばせと要求する御影。彼は真理を人質に旬たちを脅すのだった。","thumbnail":"https://artworks.thetvdb.com/banners/series/313702/episodes/6012a4455e6e0.jpg","metadataSources":{"tmdb":{"title":"Episodio 11","synopsis":"和花たちを人質にとられた真理は、御影たちにTSSの仕組みを話してしまう。時を越える発明は大きなビジネスになると得意げに笑う御影。「そんな悪用は許せない」と主張する晶。だが御影から、既に永司もTSSを使って研究資金の返済を行ったことを聞き、彼女は絶句する。契約上の約束を破った永司と話をつけるため、永司のもとに自分を跳ばせと要求する御影。彼は真理を人質に旬たちを脅すのだった。","titleLanguage":"it-IT","synopsisLanguage":"ja-JP"},"tvdb":{"title":"La forza d'animo di Edison","synopsis":"After being caught red-handed at Hayase's lab, Mari is forced to make a difficult decision that could greatly impact her father's future.","titleLanguage":"ita","synopsisLanguage":"eng"}}},{"title":"Episodio 12","episodeNumber":12,"sourceEpisodeNumber":12,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"12137","scope":"R","episodeNumbers":[12]},{"provider":"anilist","id":"21824","episodeNumbers":[12]},{"provider":"mal","id":"33341","episodeNumbers":[12]},{"provider":"tmdb_show","id":"67677","scope":"s1","seasonNumber":1,"episodeNumbers":[12]},{"provider":"tvdb_show","id":"313702","scope":"s1","seasonNumber":1,"episodeNumbers":[12]}],"link":"89515","synopsis":"1879年のアメリカ。時空間の裂け目に吸い込まれるのを必死に抵抗する真理、永司、御影。これは本来、同じ時間軸上には存在しないはずの永司と御影のコンパスが原因で起きたタイムパラドックス・バリエーションだった。 一方、現代側でも、制御不能になったTSSがオーバーロードを起こし電源ユニットが過熱、煙や火花が飛び散り始める。","thumbnail":"https://artworks.thetvdb.com/banners/series/313702/episodes/6012a621a2473.jpg","metadataSources":{"tmdb":{"title":"Episodio 12","synopsis":"1879年のアメリカ。時空間の裂け目に吸い込まれるのを必死に抵抗する真理、永司、御影。これは本来、同じ時間軸上には存在しないはずの永司と御影のコンパスが原因で起きたタイムパラドックス・バリエーションだった。 一方、現代側でも、制御不能になったTSSがオーバーロードを起こし電源ユニットが過熱、煙や火花が飛び散り始める。","titleLanguage":"it-IT","synopsisLanguage":"ja-JP"},"tvdb":{"title":"Egregi scienziati","synopsis":"Poiché il pendente usato da Mikage è lo stesso utilizzato da Eiji, l'esistenza dello stesso oggetto in due diverse forme ha generato un paradosso temporale che ha avuto come risultato una spaccatura nello spaziotempo e determinato un crash della macchina, che comincia a bruciare provocando un incendio che investe tutto il laboratorio.","titleLanguage":"ita","synopsisLanguage":"ita"}}}],"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-29T07:54:59Z","sourceDescriptors":["anilist:21824","mal:33341"],"targets":[{"provider":"anidb","id":"12137","scope":"R","ranges":{"1-12":"1-12"}},{"provider":"anilist","id":"21824","ranges":{"1-12":"1-12"}},{"provider":"mal","id":"33341","ranges":{"1-12":"1-12"}},{"provider":"tmdb_show","id":"67677","scope":"s1","ranges":{"1-12":"1-12"}},{"provider":"tvdb_show","id":"313702","scope":"s1","ranges":{"1-12":"1-12"}}]},"artworkInventory":{"logo":[{"source":"cinemeta","url":"https://live.metahub.space/logo/medium/tt10706734/img"},{"source":"anizip","url":"https://artworks.thetvdb.com/banners/v4/series/313702/clearlogo/6124824044d7c.png"}],"poster":[{"source":"tmdb","url":"https://image.tmdb.org/t/p/original/ehker5Z4LFvgFnn4myXLbcm9ojq.jpg"},{"source":"provider","url":"https://img.animeunity.co/anime/bx21824-HpGRQlvbgLNW.png"},{"source":"cinemeta","url":"https://live.metahub.space/poster/small/tt10706734/img"},{"source":"anizip","url":"https://artworks.thetvdb