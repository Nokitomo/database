{"id":"work-4629","sourceIds":{"anilist":1060,"mal":1060},"info":{"title":"Oruchuban Ebichu","synopsis":"Il criceto Ebichu sembra essere l'animale domestico perfetto: pulisce, fa la spesa, cucina, fa il bucato e qualsiasi cosa per accontentare la sua padrona. In realtà finisce per commettere spessissimo degli errori e viene puntualmente punita. La sua padrona ha grossi problemi sentimentali: è legata, infatti, ad un ragazzo che la tradisce ma da cui non riesce a separarsi. Questo le causerà grande frustrazione e, molto spesso, finirà per sfogarsi con la sua cricetina.","image":"https://image.tmdb.org/t/p/original/bCFmCpNmsND4bZ0ccRdiZL13h0x.jpg","poster":"https://image.tmdb.org/t/p/original/58GsR3iGx2pBGBb4esgbsyrt8Tl.jpg","logo":"https://images.metahub.space/logo/medium/tt0366064/img","background":"https://image.tmdb.org/t/p/original/bCFmCpNmsND4bZ0ccRdiZL13h0x.jpg","imdbId":"tt0366064","type":"series","tags":["TV Short","Terminato","Estate","1999"],"tagKeys":{"TV Short":"TV Short","Terminato":"Completed","Estate":"Summer"},"genres":["Comedy","Ecchi","Seinen","Slice of Life"],"rating":"7.3","studio":"Group TAC","episodesCount":24,"extra":{"ids":{"malId":1060,"anilistId":1060,"crunchyId":null,"disneyId":null,"netflixId":null,"primeId":null,"anilistIds":[1060],"malIds":[1060],"anidbIds":[150],"imdbMovieIds":[],"imdbShowIds":[],"tmdbMovieIds":[],"tmdbShowIds":[19238],"tvdbMovieIds":[],"tvdbShowIds":[73492]},"stats":{"scoreRaw":"7.35","favorites":31,"members":142,"views":27305,"episodesCountRaw":24,"episodesLength":8},"flags":{"dub":0,"alwaysHome":0},"meta":{"day":"Indeterminato","season":"Estate","status":"Terminato","type":"TV Short","createdAt":"2024-08-08 21:41:18","userId":2},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-30T07:57:40Z","sourceDescriptors":["anilist:1060","mal:1060"],"imdbSource":"plexanibridge-v2","targets":[{"provider":"anidb","id":"150","scope":"R","ranges":{"1-24":"1-24"}},{"provider":"anilist","id":"1060","r