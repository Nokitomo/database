{"id":"work-2786","sourceIds":{"anilist":100814,"mal":36976},"info":{"title":"Cutie Honey Universe","synopsis":"Honey Kisaragi è una studentessa all'apparenza normale, che frequenta una scuola cattolica. Ma quando suo padre viene ucciso dall'organizzazione criminale Panther Claw, Honey scopre di essere in realtà  un'androide, dotata dal padre-creatore del potere di trasformarsi in un'invincibile super-eroina. Per la ragazza inizia così una nuova emozionante vita, divisa tra la vendetta contro Panther Claw e il desiderio di conservare la sua quotidianità  da studentessa.","image":"https://image.tmdb.org/t/p/original/9yv9coXfjsRZljFHrGgOkB9XyJ8.jpg","poster":"https://image.tmdb.org/t/p/original/mtVkU0Tf7eFakjwZOGGih29Ugp8.jpg","logo":"https://image.tmdb.org/t/p/original/xxnEfwgvs8oA4dNlGYsc3LwqHyR.png","background":"https://image.tmdb.org/t/p/original/9yv9coXfjsRZljFHrGgOkB9XyJ8.jpg","trailers":["https://www.youtube.com/watch?v=-uH4GXSg5s4"],"imdbId":"tt7826102","type":"series","tags":["TV","Terminato","Primavera","2018"],"tagKeys":{"TV":"TV","Terminato":"Completed","Primavera":"Spring"},"genres":["Action","Adventure","Comedy","Ecchi","Mahou Shoujo","Romance","Sci-fi","Shounen"],"rating":"5.8","studio":"Production Reed","episodesCount":12,"extra":{"ids":{"malId":36976,"anilistId":100814,"crunchyId":null,"disneyId":null,"netflixId":null,"primeId":null,"anilistIds":[100814],"malIds":[36976],"anidbIds":[13676],"imdbMovieIds":[],"imdbShowIds":[],"tmdbMovieIds":[],"tmdbShowIds":[77729],"tvdbMovieIds":[],"tvdbShowIds":[343363]},"stats":{"scoreRaw":"5.83","favorites":17,"members":107,"views":15785,"episodesCountRaw":12,"episodesLength":23},"flags":{"dub":0,"alwaysHome":0},"meta":{"day":"Domenica","season":"Primavera","status":"Terminato","type":"TV","createdAt":"2021-08-07 01:27:02","userId":78495},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-30T07:57:40Z","sourceDescriptors":["anilist:100814","mal:36976"],"imdbSource":"plexanibridge-v2"