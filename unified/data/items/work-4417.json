{"id":"work-4417","sourceIds":{"anilist":21872,"mal":33572},"info":{"title":"Idol Memories","synopsis":"Nel 2035 la tecnologia della realtà virtuale si è talmente evoluta che la gente può sperimentare viaggi in giro per il mondo o qualsiasi evento come se fosse realmente lì, pur restando comodamente seduta sulla poltrona di casa propria. Le idol si esibiscono in eventi live nello spazio di realtà virtuale “VR Rooms” seguite da un pubblico globale ed acquistano sempre maggiore popolarità. L’accademia privata Kanon è stata fondata sull’isola di Beginning per addestrare nuove idol, le idol che la frequentano competono tra loro e lottano per raggiungere la vetta della “World Idol League”. L’anime segue le 6 idol che compongono le due unità “StarRing” e “Shadow”.","image":"https://image.tmdb.org/t/p/original/pnSKyrEkiKbI4Ag0gNNEvly5maZ.jpg","poster":"https://image.tmdb.org/t/p/original/4KzSiSNTYNukXvFhM7gsE3WMeis.jpg","background":"https://image.tmdb.org/t/p/original/pnSKyrEkiKbI4Ag0gNNEvly5maZ.jpg","trailers":["https://www.youtube.com/watch?v=2c8YE_WUV-s"],"imdbId":"","type":"series","tags":["TV","Terminato","Autunno","2016"],"tagKeys":{"TV":"TV","Terminato":"Completed","Autunno":"Autumn"},"genres":["Music"],"rating":"8.5","studio":"Seven Arcs","episodesCount":12,"extra":{"ids":{"malId":33572,"anilistId":21872,"crunchyId":null,"disneyId":null,"netflixId":null,"primeId":null,"anilistIds":[21872],"malIds":[33572],"anidbIds":[12261],"imdbMovieIds":[],"imdbShowIds":[],"tmdbMovieIds":[],"tmdbShowIds":[68555],"tvdbMovieIds":[],"tvdbShowIds":[315095]},"stats":{"scoreRaw":"8.50","favorites":4,"members":20,"views":2695,"episodesCountRaw":12,"episodesLength":26},"flags":{"dub":0,"alwaysHome":0},"meta":{"day":"Domenica","season":"Autunno","status":"Terminato","type":"TV","createdAt":"2024-04-13 09:56:49","userId":2},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-29T07:54:59Z","sourceDescriptors":["anilist:21872","mal:33572"],"targets":[{"provide