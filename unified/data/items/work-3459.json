{"id":"work-3459","sourceIds":{"anilist":1030,"mal":1030},"info":{"title":"Pom Poko (ITA)","synopsis":"Strutturata come un documentario a metà tra lo storico e il naturalistico, con tanto di voce narrante esplicativa, la storia segue le vicissitudini di un gruppo di tanuki, piccoli mammiferi simili a un incrocio tra un cane e un procione. Quando il monte Tama, su cui risiedono alcuni branchi di questi animali, diviene il sito per un grandioso progetto di edilizia residenziale in risposta al fabbisogno abitativo di Tokyo, i tanuki dichiarano aperte le ostilità verso l’invasore umano, contro il quale utilizzeranno azioni di guerriglia e tutti i trucchi di cui dispongono.","image":"https://image.tmdb.org/t/p/original/3YDaDwaB4XnRhYLLdW8qzS9VVoS.jpg","poster":"https://image.tmdb.org/t/p/original/h17I6Kh9GbKUe4t3kSa2ksHyxa0.jpg","logo":"https://image.tmdb.org/t/p/original/vcb5vD06bqJQR0NtJ7ava0fqEd5.png","background":"https://image.tmdb.org/t/p/original/3YDaDwaB4XnRhYLLdW8qzS9VVoS.jpg","trailers":["https://www.youtube.com/watch?v=_7cowIHjCD4"],"imdbId":"tt0110008","type":"movie","tags":["Movie","Terminato","Estate","1994"],"tagKeys":{"Movie":"Movie","Terminato":"Completed","Estate":"Summer"},"genres":["Comedy","Drama","Fantasy","Kids"],"rating":"7.8","studio":"Studio Ghibli","episodesCount":1,"extra":{"ids":{"malId":1030,"anilistId":1030,"crunchyId":null,"disneyId":null,"netflixId":null,"primeId":null,"anilistIds":[1030],"malIds":[1030],"anidbIds":[334],"imdbMovieIds":["tt0110008"],"imdbShowIds":[],"tmdbMovieIds":[15283],"tmdbShowIds":[],"tvdbMovieIds":[2922],"tvdbShowIds":[]},"stats":{"scoreRaw":"7.76","favorites":40,"members":283,"views":8926,"episodesCountRaw":1,"episodesLength":111},"flags":{"dub":1,"alwaysHome":0},"meta":{"day":"Indeterminato","season":"Estate","status":"Terminato","type":"Movie","createdAt":"2022-09-03 23:04:08","userId":2},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-11-01T08:31:58Z","sourceDescriptors":["anilist