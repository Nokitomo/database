eNumbers":[1]},{"provider":"tvdb_movie","id":"358808","episodeNumbers":[1]},{"provider":"tvdb_show","id":"80470","scope":"s0","seasonNumber":0,"episodeNumbers":[5]}],"link":"100155","metadataSources":{"tmdb":{},"tvdb":{"title":"Bakeneko - Part 2","synopsis":"The moment the bride crosses the threshold of the house to leave, she is struck dead. The medicine peddler, being a stranger and looking rather suspicious, is seized as the culprit and bound. After an older retainer is killed while attempting to fetch a doctor, the medicine peddler breaks his bounds, reveals himself to also be a demon-hunter, and claims the true villain is a bakeneko. The medicine peddler sets up a barrier to keep the demon at bay and begins questioning the family and their retainers to learn the shape (katachi), truth (makoto) and reasoning (kotowari) of the demon so that it can be exorcised. At first the family prevaricates, but as the demon grows stronger, breaking through the barriers of the medicine peddler and killing their members, they begin to talk, alluding to the family's dark past. As the demon breaks through his final barrier, the medicine peddler attempts to unsheathe his sword and destroy it, but fails and is shown a vision by the demon itself.","titleLanguage":"eng","synopsisLanguage":"eng"}},"synopsis":"The moment the bride crosses the threshold of the house to leave, she is struck dead. The medicine peddler, being a stranger and looking rather suspicious, is seized as the culprit and bound. After an older retainer is killed while attempting to fetch a doctor, the medicine peddler breaks his bounds, reveals himself to also be a demon-hunter, and claims the true villain is a bakeneko. The medicine peddler sets up a barrier to keep the demon at bay and begins questioning the family and their retainers to learn the shape (katachi), truth (makoto) and reasoning (kotowari) of the demon so that it can be exorcised. At first the family prevaricates, but as the demon grows stronger, breaking through the barriers of the medicine peddler and killing their members, they begin to talk, alluding to the family's dark past. As the demon breaks through his final barrier, the medicine peddler attempts to unsheathe his sword and destroy it, but fails and is shown a vision by the demon itself."}],"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-11-01T08:31:58Z","sourceDescriptors":["anilist:179852","mal:59408"],"imdbSource":"anibridge-v3","targets":[{"provider":"anidb","id":"17466","scope":"R"},{"provider":"anilist","id":"151117"},{"provider":"anilist","id":"179852","ranges":{"1":"1"}},{"provider":"anilist","id":"179874"},{"provider":"imdb_movie","id":"tt32574149"},{"provider":"imdb_movie","id":"tt35301440","ranges":{"1":"1"}},{"provider":"imdb_movie","id":"tt36282134"},{"provider":"mal","id":"52107"},{"provider":"mal","id":"59408","ranges":{"1":"1"}},{"provider":"mal","id":"61202"},{"provider":"tmdb_movie","id":"1322218","ranges":{"1":"1"}},{"provider":"tvdb_movie","id":"348830"},{"provider":"tvdb_movie","id":"358808","ranges":{"1":"1"}},{"provider":"tvdb_movie","id":"358953"},{"provider":"tvdb_show","id":"80470","scope":"s0","ranges":{"1":"5"}}]},"artworkInventory":{"logo":[{"source":"tmdb","url":"https://image.tmdb.org/t/p/original/7FUML4CY5vqbVbV3dicxIGD5EAw.png"},{"source":"cinemeta","url":"https://live.metahub.space/logo/medium/tt35301440/img"}],"poster":[{"source":"tmdb","url":"https://image.tmdb.org/t/p/original/qp630dE7NBUIK5yR5HGQAE2LgxL.jpg"},{"source":"tvdb","url":"https://artworks.thetvdb.com/banners/v4/movie/358808/posters/69bdb941eb3f2.jpg"},{"source":"provider","url":"https://img.animeunity.co/anime/bx179852-tPwGOkCxA8em.jpg"},{"source":"cinemeta","url":"https://live.metahub.space/poster/small/tt35301440/img"},{"source":"anilist","url":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/large/bx179852-tPwGOkCxA8em.jpg"}],"background":[{"source":"tmdb","url":"https://image.tmdb.org/t/p/original/tqxmy6B2Qk9cz