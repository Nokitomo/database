275,"number":1}},{"id":276,"user_id":78495,"title":null,"imageurl":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/bx18097-dAqYhaGafOqS.jpg","plot":"a storia racconta le nuove avventure di Arion Sherwind (Tenma Matsukaze), Riccardo di Rigo (Takuto Shindō) e Victor Blade (Kyōsuke Tsurugi) con indosso la maglia della Shinsei Inazuma Japan, la nuova nazionale giovanile giapponese, che partecipa al Football Frontier International Vision 2. Verranno introdotti nuovi personaggi mai apparsi finora nella serie in veste di loro compagni di squadra. Viene inoltre spiegato che nel nuovo torneo è assolutamente vietato l’uso da parte dei giocatori di Keshin, modalità Keshin Armed e modalità Mixi Trans, per far sì che ogni giocatore sviluppi le proprie capacità individuali","date":"2013","episodes_count":43,"episodes_length":23,"author":" ","created_at":"2018-09-30 15:42:48","status":"Terminato","imageurl_cover":"","type":"TV","slug":"inazuma-eleven-go-galaxy-ita","title_eng":"Inazuma Eleven Go: Galaxy (ITA)","day":"Indeterminato","favorites":288,"score":"8.00","visite":1258337,"studio":"OLM","dub":1,"always_home":0,"members":1569,"cover":null,"anilist_id":18097,"season":"Primavera","title_it":null,"mal_id":18097,"crunchy_id":null,"netflix_id":null,"prime_id":null,"disney_id":null,"pivot":{"anime_id":5933,"related_id":276,"number":1}},{"id":5933,"user_id":2,"title":null,"imageurl":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/bx99059-kA7alh9r8L9Y.jpg","plot":"Spin-Off del franchise dell'anime calcistico di Inazuma Eleven. Il primo episodio presenta i fratelli Fubuki.","date":"2016","episodes_count":6,"episodes_length":5,"author":" ","created_at":"2025-01-27 15:54:49","status":"Terminato","imageurl_cover":"","type":"ONA","slug":"inazuma-eleven-outer-code","title_eng":"Inazuma Eleven: Outer Code","day":"Giovedì","favorites":25,"score":"7.80","visite":20260,"studio":"OLM","dub":0,"always_home":0,"members":115,"cover":null,"anilist_id":99059,"season"