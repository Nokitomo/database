it-IT"},"runtimeMinutes":24,"rating":7,"thumbnail":"https://image.tmdb.org/t/p/w300/aAJY97R9qnWiQM3o3XLUEuFRoyC.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/aAJY97R9qnWiQM3o3XLUEuFRoyC.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/154526/season/1/episode/17"},{"id":"5668662","seasonNumber":1,"episodeNumber":18,"title":{"value":"Episodio 18","language":"it-IT"},"overview":{"value":"As the competitors enter their third and final lap, the rain starts to ease, but the change in weather conditions brings with it something unexpected.","language":"en-US"},"airDateText":{"value":"2024-11-11","language":"it-IT"},"runtimeMinutes":24,"rating":7,"thumbnail":"https://image.tmdb.org/t/p/w300/4EVALw8RhpqNo4teHykL1E0zbUC.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/4EVALw8RhpqNo4teHykL1E0zbUC.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/154526/season/1/episode/18"},{"id":"5692617","seasonNumber":1,"episodeNumber":19,"title":{"value":"Episodio 19","language":"it-IT"},"overview":{"value":"After schooling the rest of the field on how to drive through the fog, Kanata emerges from the white wall with a big gap to the car behind. Can he stay in front? Meanwhile, the two leaders do battle once more.","language":"en-US"},"airDateText":{"value":"2024-11-18","language":"it-IT"},"runtimeMinutes":24,"rating":8,"thumbnail":"https://image.tmdb.org/t/p/w300/zjwOtbhKhnG7EMZLLbJcNj6PwvX.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/zjwOtbhKhnG7EMZLLbJcNj6PwvX.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/154526/season/1/episode/19"},{"id":"5764648","seasonNumber":1,"episodeNumber":20,"title":{"value":"Episodio 20","language":"it-IT"},"overview":{"value":"Taking advantage of the superior horsepower of his Ferrari, Akaba is hunting Kanata down, and with them running out of road, it'll be a desperate dash to the line for both drivers.","language":"en-US"},