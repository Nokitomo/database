/12mYMPE7Jy7rhDv0rn95GEtF94V.jpg","language":"xx","width":1920,"height":1080},{"type":"backdrop","url":"https://image.tmdb.org/t/p/original/bKRI22IDSv5wMuBvcDGtu9JF3oZ.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/bKRI22IDSv5wMuBvcDGtu9JF3oZ.jpg","language":"xx","width":1920,"height":1080},{"type":"backdrop","url":"https://image.tmdb.org/t/p/original/zotzm1IzazadBQOSocTQ8Ta1bCb.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/zotzm1IzazadBQOSocTQ8Ta1bCb.jpg","language":"xx","width":1920,"height":1080},{"type":"backdrop","url":"https://image.tmdb.org/t/p/original/qI2O6WusL0PVHxb8DneKMynX22J.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/qI2O6WusL0PVHxb8DneKMynX22J.jpg","language":"xx","width":1280,"height":720},{"type":"backdrop","url":"https://image.tmdb.org/t/p/original/jCM2t0ENjmIvtiOMXIDJRKs6D0a.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/jCM2t0ENjmIvtiOMXIDJRKs6D0a.jpg","language":"xx","width":1920,"height":1080},{"type":"backdrop","url":"https://image.tmdb.org/t/p/original/3mBtXzyOIzh5zJNEgHqIIYTPb6n.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/3mBtXzyOIzh5zJNEgHqIIYTPb6n.jpg","language":"xx","width":1920,"height":1080},{"type":"backdrop","url":"https://image.tmdb.org/t/p/original/tzF4x1Toclqq1EYBLAlkM5RY7BR.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/tzF4x1Toclqq1EYBLAlkM5RY7BR.jpg","language":"xx","width":1920,"height":1080},{"type":"backdrop","url":"https://image.tmdb.org/t/p/original/59ai66snl0RHlItEJ3tlPp8ahde.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/59ai66snl0RHlItEJ3tlPp8ahde.jpg","language":"xx","width":3840,"height":2160},{"type":"backdrop","url":"https://image.tmdb.org/t/p/original/2VpCHa5RENqhdOPv4NEq8CN89dn.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/2VpCHa5RENqhdOPv4NEq8CN89dn.jpg","language":"xx","width":3840,"height":2160},{"type":"backdrop","url":"https://image.tmdb.org/t/p/original/4cTTQWICQG9haO3Fq6oTvzZPNcP.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/4cTTQWICQG9haO3Fq6oTvzZPNcP.jpg","language":"xx","width":3840,"height":2160},{"type":"backdrop","url":"https://image.tmdb.org/t/p/original/nk94GUbqt7WLVTUDbPi2RMhpj4c.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/nk94GUbqt7WLVTUDbPi2RMhpj4c.jpg","language":"xx","width":1280,"height":720},{"type":"backdrop","url":"https://image.tmdb.org/t/p/original/8FCcGf8L640LCF6y2tj1taiHwtF.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/8FCcGf8L640LCF6y2tj1taiHwtF.jpg","language":"xx","width":1280,"height":720},{"type":"backdrop","url":"https://image.tmdb.org/t/p/original/qhF877a3BzVvw2T0ueHvVegxpok.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/qhF877a3BzVvw2T0ueHvVegxpok.jpg","language":"xx","width":1280,"height":720}]},"logo":"https://image.tmdb.org/t/p/original/zMKPIEDejjOMQLSESdOAu5Dq4zH.png","poster":"https://image.tmdb.org/t/p/original/2SYVA8CA0E65DRFXEg34QpUYUu3.jpg","background":"https://image.tmdb.org/t/p/original/krCvsADpHxISG8df6KD1sdW7ya8.jpg","seasons":[{"seasonNumber":0,"name":{"value":"Speciali","language":"it-IT"},"year":2015,"episodeCount":9,"poster":"https://image.tmdb.org/t/p/original/i7LuGtsez0kA91V3BycxSgtQPPD.jpg","posters":[],"backgrounds":[],"sourceUrl":"https://www.themoviedb.org/tv/60863/season/0"},{"seasonNumber":1,"name":{"value":"Haikyu!!","language":"it-IT"},"overview":{"value":"Dopo aver assistito a una partita di pallavolo, il giovane Shoyo Hinata si pone come personale obiettivo di diventare \"Il piccolo Gigante\" di quello sport. Entrato nel club di pallavolo della sua scuola media, affronta insieme alla squadra il torneo interscolastico ma lui e i suoi compagni devono inchinarsi di fronte a una forte squadra guidata da un formidabile giocatore di nome Tobio Kageyama. Desideroso di arrivare ai vertici e di prendersi la rivincita su Kageyama, Shoyo continua a praticare la pallavolo anche alla sua entrata alle superiori, dove però trova nel club scolastico proprio il suo rivale Kageyama.","language":"it-IT"},"year":2014,"episodeCount":25,"poster":"https://image.tmdb.org/t/p/original/8GpgkSjPlZv4Qr1qlc4elNU8tra.jpg","posters":[],"backgrounds":[],"sourceUrl":"https://www.themoviedb.org/tv/60863/season/1"},{"seasonNumber":2,"name":{"value":"Haikyu!! Seconda Stagione","language":"it-IT"},"overview":{"value":"Hinata, Tobio e compagni cercano di prepararsi al meglio per affrontare i preliminari del torneo interliceale primaverile attraverso nuovi allenamenti e un ritiro con le squadre rivali di Tokyo. Il liceo Karasuno vedrà l'ingresso nel team di una nuova giovane manager e ognuno dei protagonisti ce la metterà tutta per intraprendere un proprio percorso di crescita senza dimenticare, però, l'importanza e lo spirito di squadra.","language":"it-IT"},"year":2015,"episodeCount":25,"poster":"https://image.tmdb.org/t/p/original/4FhLQ9uivEJ3BVWBwU2e6BBqeAi.jpg","posters":[],"backgrounds":[],"sourceUrl":"https://www.themoviedb.org/tv/60863/season/2"},{"seasonNumber":3,"name":{"value":"Haikyu!! Liceo Karasuno VS Accademia Shiratorizawa","language":"it-IT"},"overview":{"value":"Superata la difficile semifinale con l'Aoba Josai nella seconda serie, ora la Karasuno deve vedersela nella finale contro i favoriti della Shiratorizawa per riuscire a qualificarsi al campionato nazionale e sfidare i rivali della Nekoma. A guidare la multicampionessa Shiratorizawa vi è Wakatoshi Ushijima, uno dei più forti attaccanti della nazione a cui Hinata e Kageyama hanno dichiarato guerra in passato. La terza serie si concentra interamente sulla finale, che vede contrapposte le due ideologie degli allenatori: gioco di squadra e diverse strategie per la Karasuno, capacità individuali, altezza e potenza bruta per la Shiratorizawa.","language":"it-IT"},"year":2016,"episodeCount":10,"poster":"https://image.tmdb.org/t/p/original/oZpXPM42i9NUigjCBR1sW9q6eWf.jpg","posters":[],"backgrounds":[],"sourceUrl":"https://www.themoviedb.org/tv/60863/season/3"},{"seasonNumber":4,"name":{"value":"Haikyu!! To the Top","language":"it-IT"},"overview":{"value":"Il club di pallavolo delle scuole superiori di Karasuno avanza nella sua corsa per partecipare al tanto desiderato Torneo Nazionale dopo una feroce battaglia contro la l'accademia Shiratorizawa.\n\nMentre si preparavano per il prossimo torneo, ecco giungere gli inviti per Tobio Kageyama che viene selezionato per nazionale giovanile e viene invitato ai primi allenamenti a Tokyo. Mentre Kei Tsukishima viene invitato ad un ritiro a cui partecipano i migliori giocatori della prefettura di Miyagi. Tuttavia, Hinata ne combina una delle sue presentandosi senza invito al campo d'addestramento di Miyagi. A quanto pare, Hinata, Kageyama e il Karasuno High School Volleyball Club stanno per affrontare molte nuove sfide che li separano dall'ambito Torneo Nazionale a cui puntano.\"","language":"it-IT"},"year":2020,"episodeCount":25,"poster":"https://image.tmdb.org/t/p/original/a6bNLY3F90ldNe6PqPSQGFqOE58.jpg","posters":[],"backgrounds":[],"sourceUrl":"https://www.themoviedb.org/tv/60863/season/4"}],"schema":{}},"failure":null,"fields":{},"episodes":{}}
