{"schemaVersion":1,"source":"tmdb","kind":"media","input":{"id":134667,"type":"tv"},"checkedAt":1793846798875,"status":"ok","retryCount":0,"value":{"source":"tmdb-api","id":134667,"type":"tv","sourceUrl":"https://www.themoviedb.org/tv/134667","fetchedAt":"2026-11-05T02:46:38.874Z","originalLanguage":"ja-JP","title":{"value":"Tenken - Reincarnato in una spada","language":"it-IT"},"originalTitle":"転生したら剣でした","overview":{"value":"Un essere umano si reincarna in un mondo fantasy come spada magica senziente. A trovarlo sarà Fran, una giovane appartenente a una stirpe vessata e discriminata. I due stringono un legame, e lo strano duo parte all'avventura per realizzare il sogno che la ragazza ha ereditato dai suoi defunti genitori: diventare più forte ed evolvere, cosa considerata impossibile per la sua stirpe.","language":"it-IT"},"tagline":{"value":"強さの、そ の 先 へーー","language":"ja-JP"},"startDate":"2022-10-05","endDate":"2026-10-29","status":"Returning Series","rating":7.3,"ratingCount":95,"numberOfEpisodes":24,"numberOfSeasons":2,"genres":["Animazione","Commedia","Sci-Fi & Fantasy"],"countries":["Japan","China"],"facts":{"Runtime":"23m"},"keywords":[],"networks":[{"id":614,"name":"TOKYO MX","logo":"https://image.tmdb.org/t/p/original/hSdroyVthq3CynxTIIY7lnS8w1.png"}],"socialLinks":{},"cast":[{"id":62318,"name":"Shin-ichiro Miki","role":"Master (voice)","profile":"https://image.tmdb.org/t/p/original/yL9Tx2HZgK7t5AssYl6oGE9bjdj.jpg"},{"id":1324646,"name":"Ai Kakuma","role":"Fran (voice)","profile":"https://image.tmdb.org/t/p/original/o3tQSeeJAeafJNvQs2IKvpKY7av.jpg"},{"id":1220947,"name":"Ami Koshimizu","role":"Amanda (voice)","profile":"https://image.tmdb.org/t/p/original/e5sU0stGjTMtFoj0jjHH7OFUqYC.jpg"},{"id":221772,"name":"Wataru Hatano","role":"Klimt (voice)","profile":"https://image.tmdb.org/t/p/original/i1meHlOXLP2ubJZkmyGJONrxikQ.jpg"},{"id":126704,"name":"Tetsu Inada","role":"Donadrond (voice)","profile":"https://image.tmdb.org/t/p/original/hN6WVTxPAd4Jbc9iqWwoWFth