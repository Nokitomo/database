org/t/p/original/mfqYlZHFzIAvW1AsgC8VW0KXuaG.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/mfqYlZHFzIAvW1AsgC8VW0KXuaG.jpg","language":"xx","width":2560,"height":1440},{"type":"backdrop","url":"https://image.tmdb.org/t/p/original/jzfi3CUCPGSQmQOdCEaCVOQlv3g.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/jzfi3CUCPGSQmQOdCEaCVOQlv3g.jpg","language":"xx","width":1920,"height":1080},{"type":"backdrop","url":"https://image.tmdb.org/t/p/original/qHBVwvMmJ2jiS3M4LRf2TRt3VzU.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/qHBVwvMmJ2jiS3M4LRf2TRt3VzU.jpg","language":"xx","width":1920,"height":1080},{"type":"backdrop","url":"https://image.tmdb.org/t/p/original/uE6QPahBMrm1WpIXv1AMrGX0DUM.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/uE6QPahBMrm1WpIXv1AMrGX0DUM.jpg","language":"xx","width":1920,"height":1080}]},"logo":"https://image.tmdb.org/t/p/original/1PloWpJba8A3I0x8Ry92IGYromk.png","poster":"https://image.tmdb.org/t/p/original/zCEjjb1NH3LLsWeZx47wOeqkezf.jpg","background":"https://image.tmdb.org/t/p/original/5WPVvMphD4j696wIm2wCb6lyUsj.jpg","seasons":[{"seasonNumber":0,"name":{"value":"Speciali","language":"it-IT"},"year":2009,"episodeCount":49,"poster":"https://image.tmdb.org/t/p/original/qfyqDAuERlN2afs8f56or1jSALn.jpg","posters":[],"backgrounds":[],"sourceUrl":"https://www.themoviedb.org/tv/46195/season/0"},{"seasonNumber":1,"name":{"value":"Bakemonogatari","language":"it-IT"},"overview":{"value":"La storia è incentrata su Koyomi Araragi, uno studente del terzo anno di liceo che è sopravvissuto di recente all'attacco di un vampiro e si ritrova coinvolto in ogni genere di apparizioni: dei, fantasmi, miti e spiriti.","language":"it-IT"},"year":2009,"episodeCount":12,"poster":"https://image.tmdb.org/t/p/original/qfyqDAuERlN2afs8f56or1jSALn.jpg","posters":[],"backgrounds":[],"sourceUrl":"https://www.themoviedb.org/tv/46195/season/1"},{"seasonNumber":2,"name":{"value":"Stagione 2","language":"it-IT"},"overview":{"value":"Lo studente liceale Koyomi Araragi è sopravvissuto a un attacco di vampiri e non riesce a smettere di essere coinvolto in ogni tipo di apparizione, ma sta per affrontare la sua sfida più grande: proteggere le sue due sorelline! Karen e Tsukihi hanno un debole per la giustizia e tocca a Koyomi proteggerle mentre cercano di scoprire la causa delle loro apparizioni.","language":"it-IT"},"year":2012,"episodeCount":11,"poster":"https://image.tmdb.org/t/p/original/hbLt05yzOMhvV4OcQzmhciFr3Fh.jpg","posters":[],"backgrounds":[],"sourceUrl":"https://www.themoviedb.org/tv/46195/season/2"},{"seasonNumber":3,"name":{"value":"Stagione 3","language":"it-IT"},"overview":{"value":"Tsubasa e Hitagi scoprono che Koyomi è scomparso e li ha esortati in un messaggio di testo a non cercarlo. Tuttavia, in sua assenza, nuove pericolose apparizioni iniziano ad apparire e prendono di mira Tsubasa e Nadeko, che sono costrette a cercare di affrontarle da sole. Nel frattempo, Koyomi, Shinobu e Mayoi sono alle prese con seri problemi personali.","language":"it-IT"},"year":2013,"episodeCount":23,"poster":"https://image.tmdb.org/t/p/original/z0GPizkLzcx2pmyXJJQewg8EvhC.jpg","posters":[],"backgrounds":[],"sourceUrl":"https://www.themoviedb.org/tv/46195/season/3"},{"seasonNumber":4,"name":{"value":"Stagione 4","language":"it-IT"},"overview":{"value":"Durante il mese di ottobre del suo terzo anno di liceo, Koyomi Araragi viene presentato a una studentessa trasferita di nome Ougi Oshino dal suo compagno di classe Kanbaru Suruga. Ougi dice a Koyomi che ha qualcosa che desidera consultarlo: quando disegna la mappa del liceo Naoestu, trova qualcosa di strano. Questa scoperta rivela una storia che non avrebbe dovuto essere raccontata, e questo rende la vita al liceo di Koyomi completamente diversa.","language":"it-IT"},"year":2015,"episodeCount":12,"poster":"https://image.tmdb.org/t/p/original/xn2mGKbYX2SniGoI6iDmi07CMB1.jpg","posters":[],"backgrounds":[],"sourceUrl":"https://www.themoviedb.org/tv/46195/season/4"},{"seasonNumber":5,"name":{"value":"Stagione 5","language":"it-IT"},"overview":{"value":"Dopo il diploma, la storia di Koyomi Araragi si è conclusa. Questa volta, è davvero finita. Tuttavia, la storia delle ragazze salvate da Araragi non è ancora terminata. Questa storia è un prequel, o forse un sequel, delle loro lotte giovanili.","language":"it-IT"},"year":2024,"episodeCount":15,"poster":"https://image.tmdb.org/t/p/original/gUQPpTYCZ18JpCKVFRIX1j4l8s1.jpg","posters":[],"backgrounds":[],"sourceUrl":"https://www.themoviedb.org/tv/46195/season/5"}],"schema":{}},"failure":null,"fields":{},"episodes":{}}
