":[{"seasonNumber":0,"name":{"value":"Speciali","language":"it-IT"},"year":2020,"episodeCount":5,"poster":"https://image.tmdb.org/t/p/original/jdD7oxE8eq2RwscsAub1t68HSoT.jpg","posters":[],"backgrounds":[],"sourceUrl":"https://www.themoviedb.org/tv/72636/season/0"},{"seasonNumber":1,"name":{"value":"Stagione 1","language":"it-IT"},"overview":{"value":"Più di 1900 anni fa fu scoperta una gigantesca fossa. Con un diametro di 1000 metri e una profondità a tutt'oggi sconosciuta, la voragine misteriosa ha ammaliato le persone. Col passare degli anni, attirati dall'aura di mistero e dalle numerose leggende, in tanti sono stati inghiottiti dalla voragine, che è l'ultimo antro inesplorato del mondo. Il suo nome... è Abisso.","language":"it-IT"},"year":2017,"episodeCount":13,"poster":"https://image.tmdb.org/t/p/original/7OZgqYBGfMvo6f5y6h8pVodlkEZ.jpg","posters":[],"backgrounds":[],"sourceUrl":"https://www.themoviedb.org/tv/72636/season/1"},{"seasonNumber":2,"name":{"value":"La città dorata del sole ardente","language":"it-IT"},"overview":{"value":"Dopo aver superato Bondold, Riko, Reg e Nanachi dovranno affrontare il sesto livello. Faranno così tappa nel Villaggio dei Residui, un luogo dove gli abitanti hanno perso ogni parvenza di umanità e ogni violazione della legge comporta conseguenze terribili! I nostri protagonisti si troveranno ad affrontare di nuovo la crudeltà dell'Abisso.","language":"it-IT"},"year":2022,"episodeCount":12,"poster":"https://image.tmdb.org/t/p/original/hKmNHKK1XtdlX4ifMFJJmtTfrOS.jpg","posters":[],"backgrounds":[],"sourceUrl":"https://www.themoviedb.org/tv/72636/season/2"}],"schema":{}},"failure":null,"fields":{},"episodes":{}}
