":"it-IT"},"runtimeMinutes":3,"thumbnail":"https://image.tmdb.org/t/p/w300/gDcnc9RhTLEheM8665u2p2EkDjr.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/gDcnc9RhTLEheM8665u2p2EkDjr.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/84638/season/1/episode/9"},{"id":"1633659","seasonNumber":1,"episodeNumber":10,"title":{"value":"Episodio 10","language":"it-IT"},"overview":{"value":"Chitose has stopped by the Kyoto Aquarium. There's a lot of other penguins here. Chitose tries to sneak into the penguin area, and then...","language":"en-US"},"airDateText":{"value":"2018-12-08","language":"it-IT"},"runtimeMinutes":3,"thumbnail":"https://image.tmdb.org/t/p/w300/eIyvcHXqPTjpcwpWjkD8XDFNmJN.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/eIyvcHXqPTjpcwpWjkD8XDFNmJN.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/84638/season/1/episode/10"},{"id":"1633660","seasonNumber":1,"episodeNumber":11,"title":{"value":"Episodio 11","language":"it-IT"},"overview":{"value":"Chitose's in a bad mood today. Nothing seems to be working out. In spite of it all, she somehow ends up at the very tall Kyoto Tower.","language":"en-US"},"airDateText":{"value":"2018-12-15","language":"it-IT"},"runtimeMinutes":3,"thumbnail":"https://image.tmdb.org/t/p/w300/9OrFndtpMIOsmusXf54ZUmb8XCP.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/9OrFndtpMIOsmusXf54ZUmb8XCP.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/84638/season/1/episode/11"},{"id":"1633661","seasonNumber":1,"episodeNumber":12,"title":{"value":"Episodio 12","language":"it-IT"},"overview":{"value":"Chitose is asked to do some shopping, and finds herself in the bustling December streets of Nishiki Market. She tries to buy the items on the list she was given, but she can't find the list itself!","language":"en-US"},"airDateText":{"value":"2018-12-22","language":"it-IT"},"runtimeMinutes":3,"thumbnail":"https://image.tmdb.o