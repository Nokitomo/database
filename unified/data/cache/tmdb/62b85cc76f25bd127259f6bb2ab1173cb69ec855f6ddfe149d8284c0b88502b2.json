魔法を粉砕する、アブノーマル魔法ファンタジー堂々開幕ーー！！","tagline":"ブッ壊すしかないでしょグーパンで。"}],"images":{"logos":[{"type":"logo","url":"https://image.tmdb.org/t/p/original/f1iybcTUUU0QnPwvFjJvChxss6b.png","previewUrl":"https://image.tmdb.org/t/p/w300/f1iybcTUUU0QnPwvFjJvChxss6b.png","language":"en","width":1274,"height":415},{"type":"logo","url":"https://image.tmdb.org/t/p/original/vNPGGn2bsh5iisOD8rB18p3Iyb.png","previewUrl":"https://image.tmdb.org/t/p/w300/vNPGGn2bsh5iisOD8rB18p3Iyb.png","language":"en","width":1197,"height":390},{"type":"logo","url":"https://image.tmdb.org/t/p/original/oqMulclJPDo9INICsL1YrQ5pD70.png","previewUrl":"https://image.tmdb.org/t/p/w300/oqMulclJPDo9INICsL1YrQ5pD70.png","language":"en","width":928,"height":314},{"type":"logo","url":"https://image.tmdb.org/t/p/original/xetxBfJOnr801Iefure2a4t82ir.svg","previewUrl":"https://image.tmdb.org/t/p/w300/xetxBfJOnr801Iefure2a4t82ir.svg","language":"en","width":1236,"height":416},{"type":"logo","url":"https://image.tmdb.org/t/p/original/9Brw7Sxi25mk0QcT8fY8Vslc8hl.svg","previewUrl":"https://image.tmdb.org/t/p/w300/9Brw7Sxi25mk0QcT8fY8Vslc8hl.svg","language":"en","width":1236,"height":416},{"type":"logo","url":"https://image.tmdb.org/t/p/original/wX9aDCExjhd9aRWMhJ2mLDJM3yM.png","previewUrl":"https://image.tmdb.org/t/p/w300/wX9aDCExjhd9aRWMhJ2mLDJM3yM.png","language":"en","width":2500,"height":813},{"type":"logo","url":"https://image.tmdb.org/t/p/original/1pqH2OZPU7ZUAhXAkcqlaZAOfkL.png","previewUrl":"https://image.tmdb.org/t/p/w300/1pqH2OZPU7ZUAhXAkcqlaZAOfkL.png","language":"ja","width":1222,"height":507},{"type":"logo","url":"https://image.tmdb.org/t/p/original/9WVHWfYJQucQe0HI7BNAFEwy7lt.png","previewUrl":"https://image.tmdb.org/t/p/w300/9WVHWfYJQucQe0HI7BNAFEwy7lt.png","language":"ja","width":905,"height":374},{"type":"logo","url":"https://image.tmdb.org/t/p/original/uBVHS2u8DqD80yoibia6Brt9aoO.png","previewUrl":"https://image.tmdb.org/t/p/w300/uBVHS2u8DqD80yoibia6Brt9aoO.png","language":"ja","width":1222,"height":507}],"po