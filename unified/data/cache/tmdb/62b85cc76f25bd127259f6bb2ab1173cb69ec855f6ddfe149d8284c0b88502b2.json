{"schemaVersion":1,"source":"tmdb","kind":"media","input":{"id":204832,"type":"tv"},"checkedAt":1793613717575,"status":"ok","retryCount":0,"value":{"source":"tmdb-api","id":204832,"type":"tv","sourceUrl":"https://www.themoviedb.org/tv/204832","fetchedAt":"2026-11-02T10:01:57.575Z","originalLanguage":"ja-JP","title":{"value":"MASHLE: MAGIC AND MUSCLES","language":"it-IT"},"originalTitle":"マッシュル-MASHLE-","overview":{"value":"In un mondo dominato dalla magia e presente in ogni aspetto della vita quotidiana, Mash Burnedead vive isolato nella foresta allenando costantemente il proprio corpo. Nonostante l'assoluta incapacità di usare la magia, il ragazzo conduce un'esistenza pacifica con il padre adottivo. Quando la sua vita viene improvvisamente minacciata, Mash utilizzerà la sua straordinaria forza muscolare per contrastare i maghi aggressori.","language":"it-IT"},"tagline":{"value":"ブッ壊すしかないでしょグーパンで。","language":"ja-JP"},"startDate":"2023-04-08","endDate":"2024-03-30","status":"Returning Series","rating":8.3,"ratingCount":691,"numberOfEpisodes":24,"numberOfSeasons":1,"genres":["Animazione","Commedia","Action & Adventure","Sci-Fi & Fantasy"],"countries":["Japan"],"facts":{"Runtime":"24m"},"keywords":[],"networks":[{"id":343,"name":"Gunma TV","logo":"https://image.tmdb.org/t/p/original/9rNqtDYAnD6yTOutvHI3synSEs2.png"},{"id":614,"name":"TOKYO MX","logo":"https://image.tmdb.org/t/p/original/hSdroyVthq3CynxTIIY7lnS8w1.png"},{"id":861,"name":"BS11","logo":"https://image.tmdb.org/t/p/original/JQ5bx6n7Qmdmyqz6sqjo5Fz2iR.png"},{"id":2478,"name":"Tochigi TV","logo":"https://image.tmdb.org/t/p/original/2v82HpzoKRveJEJcGHkeTcktMRM.png"}],"socialLinks":{},"cast":[{"id":2279389,"name":"Chiaki Kobayashi","role":"Mash Burnedead (voice)","profile":"https://image.tmdb.org/t/p/original/o0XZFXc50z28ICUpvfZ1QcTL2Yt.jpg"},{"id":2710568,"name":"Reiji Kawashima","role":"Finn Ames (voice)","profile":"https://image.tmdb.org/t/p/original/tJriYA3tctzKP3ZnAwsxkey9iyU.jpg"},{"id":1324666,"name":"K