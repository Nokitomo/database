{"schemaVersion":1,"source":"tmdb","kind":"media","input":{"id":154526,"type":"tv"},"checkedAt":1793640892320,"status":"ok","retryCount":0,"value":{"source":"tmdb-api","id":154526,"type":"tv","sourceUrl":"https://www.themoviedb.org/tv/154526","fetchedAt":"2026-11-02T17:34:52.320Z","originalLanguage":"ja-JP","title":{"value":"MF GHOST","language":"it-IT"},"originalTitle":"MFゴースト","overview":{"value":"Il Giappone adotta automobili elettriche a guida autonoma e renderà obsoleta la maggior parte dei motori a gas entro il 202X. Le auto più veloci trovano nuova vita nell'MFG, un circuito automobilistico che si svolge sulle autostrade giapponesi. Piloti provenienti da tutto il mondo gareggiano per puntare al titolo. Kanata Rivington torna dalla Gran Bretagna al Giappone per la MFG e per trovare suo padre. Riuscirà a vincere il titolo e trovare risposte? Allaccia le cinture e spingiti al limite!","language":"it-IT"},"tagline":{"value":"新公道最速伝説――ついに開幕！","language":"ja-JP"},"startDate":"2023-10-02","endDate":"2026-03-29","status":"Returning Series","rating":8.2,"ratingCount":40,"numberOfEpisodes":37,"numberOfSeasons":1,"genres":["Animazione","Action & Adventure"],"countries":["Japan"],"facts":{"Runtime":"24m"},"keywords":[],"networks":[{"id":614,"name":"TOKYO MX","logo":"https://image.tmdb.org/t/p/original/hSdroyVthq3CynxTIIY7lnS8w1.png"},{"id":861,"name":"BS11","logo":"https://image.tmdb.org/t/p/original/JQ5bx6n7Qmdmyqz6sqjo5Fz2iR.png"},{"id":3220,"name":"BS Nippon TV","logo":"https://image.tmdb.org/t/p/original/naTpOY8AjRtgBw0JXafrhAD8ZBT.png"}],"socialLinks":{},"cast":[{"id":1492992,"name":"Yuma Uchida","role":"Kanata Rivington (Kanata Katagiri) (voice)","profile":"https://image.tmdb.org/t/p/original/2otstbLfQ7MXuFt1X8MFOb4OIgd.jpg"},{"id":992869,"name":"Ayane Sakura","role":"Ren Saionji / Seven (voice)","profile":"https://image.tmdb.org/t/p/original/yPbTmntASE9psPIMhNGU5oo6vIH.jpg"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":