ら追われる身となってしまう。","tagline":"死ねば、わかる。"}],"images":{"logos":[{"type":"logo","url":"https://image.tmdb.org/t/p/original/mNrohizWpKzAWssh4qpAg9fBQDw.png","previewUrl":"https://image.tmdb.org/t/p/w300/mNrohizWpKzAWssh4qpAg9fBQDw.png","language":"xx","width":520,"height":676}],"posters":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/jUJBKiLv7DkktSzqi1a48tUnWsG.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/jUJBKiLv7DkktSzqi1a48tUnWsG.jpg","language":"en","width":1000,"height":1500},{"type":"poster","url":"https://image.tmdb.org/t/p/original/mzoT3A0cCud2PiVuZcy8wUfXANB.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/mzoT3A0cCud2PiVuZcy8wUfXANB.jpg","language":"ja","width":1381,"height":2071},{"type":"poster","url":"https://image.tmdb.org/t/p/original/6c2iQ7W0dQBiSodz7GXIFTZtMIA.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/6c2iQ7W0dQBiSodz7GXIFTZtMIA.jpg","language":"ja","width":1000,"height":1500}],"backdrops":[{"type":"backdrop","url":"https://image.tmdb.org/t/p/original/yrWXiNuYNOuamJ7co7oSwIGkGzz.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/yrWXiNuYNOuamJ7co7oSwIGkGzz.jpg","language":"xx","width":3840,"height":2160},{"type":"backdrop","url":"https://image.tmdb.org/t/p/original/qjfI1fWva5Ux8cABcCGmb93UYt0.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/qjfI1fWva5Ux8cABcCGmb93UYt0.jpg","language":"xx","width":1280,"height":720}]},"logo":"https://image.tmdb.org/t/p/original/mNrohizWpKzAWssh4qpAg9fBQDw.png","poster":"https://image.tmdb.org/t/p/original/jUJBKiLv7DkktSzqi1a48tUnWsG.jpg","background":"https://image.tmdb.org/t/p/original/yrWXiNuYNOuamJ7co7oSwIGkGzz.jpg","seasons":[],"schema":{}},"failure":null,"fields":{},"episodes":{}}
