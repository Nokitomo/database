ls":[{"type":"still","url":"https://image.tmdb.org/t/p/original/rU2su325P0icpcn6dyaeeTZeBWF.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/56425/season/1/episode/5"},{"id":"939185","seasonNumber":1,"episodeNumber":6,"title":{"value":"Episodio 6","language":"it-IT"},"overview":{"value":"After being knocked down by Baki, Hanayama flies into a rage in his office. Afterward, he visits his sick mother in the hospital. Also, Baki visits Yuri and his sister, Nina in the hospital before his rematch with Hanayama.","language":"en-US"},"airDateText":{"value":"2001-02-12","language":"it-IT"},"runtimeMinutes":25,"rating":10,"thumbnail":"https://image.tmdb.org/t/p/w300/wXYLegk7Ev3CvJthqrf9Vs0oqoV.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/wXYLegk7Ev3CvJthqrf9Vs0oqoV.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/56425/season/1/episode/6"},{"id":"939186","seasonNumber":1,"episodeNumber":7,"title":{"value":"Episodio 7","language":"it-IT"},"overview":{"value":"Baki and Hanayama continue to fight, and Hanayama's tattoo is explained.","language":"en-US"},"airDateText":{"value":"2001-02-19","language":"it-IT"},"runtimeMinutes":25,"rating":10,"thumbnail":"https://image.tmdb.org/t/p/w300/7EcUDHULFLMoxd2X5x3yEOhFx3K.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/7EcUDHULFLMoxd2X5x3yEOhFx3K.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/56425/season/1/episode/7"},{"id":"939187","seasonNumber":1,"episodeNumber":8,"title":{"value":"Episodio 8","language":"it-IT"},"overview":{"value":"Baki's father, Yujiro Hanma, shows up after Baki's fight with Kaoru Hanayama. After the story of how Yujiro met Baki's mother is told, Yujiro and Hanayama fight.","language":"en-US"},"airDateText":{"value":"2001-02-26","language":"it-IT"},"runtimeMinutes":25,"rating":10,"thumbnail":"https://image.tmdb.org/t/p/w300/ioNecJqRv4t7i3ttYt8AQ0lc0If.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/ioNecJqRv4t7i3ttYt8AQ0lc0If.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/56425/season/1/episode/8"},{"id":"939188","seasonNumber":1,"episodeNumber":9,"title":{"value":"Episodio 9","language":"it-IT"},"overview":{"value":"Baki explains to his mother why he fights, visits Hanayama in the hospital, and trains. After a brief encounter with Yujiro, who killed the Yasha Ape, which made Baki angry since Yasha was Baki's friend after their fight, they decide that Baki and Yujiro will fight in one month. Baki then meets Captain Gerry Strydum, who tells him of a mercenary group in Hokkaido, and Baki decides to go there to defeat them.","language":"en-US"},"airDateText":{"value":"2001-03-05","language":"it-IT"},"runtimeMinutes":25,"rating":10,"thumbnail":"https://image.tmdb.org/t/p/w300/rHytteVpRmAf0IWRIQCESTO7iai.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/rHytteVpRmAf0IWRIQCESTO7iai.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/56425/season/1/episode/9"},{"id":"939189","seasonNumber":1,"episodeNumber":10,"title":{"value":"Episodio 10","language":"it-IT"},"overview":{"value":"Captured by the mercenaries as soon as he parachutes in, Baki must free himself and fight his way out against Nomura's jungle warfare team (Copperhead, Kuraishi, and the Chiba twin brothers, Sanada and Chiba). Meanwhile, an old friend warns Strydum of Gaia's fighting ability.","language":"en-US"},"airDateText":{"value":"2001-03-12","language":"it-IT"},"runtimeMinutes":25,"rating":10,"thumbnail":"https://image.tmdb.org/t/p/w300/e0MCJ2ZWrdg2w5KAkEvPLaQFuMz.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/e0MCJ2ZWrdg2w5KAkEvPLaQFuMz.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/56425/season/1/episode/10"},{"id":"939190","seasonNumber":1,"episodeNumber":11,"title":{"value":"Episodio 11","language":"it-IT"},"overview":{"value":"Baki fights Gaia (an alter ego of Nomura).","language":"en-US"},"airDateText":{"value":"2001-03-19","language":"it-IT"},"runtimeMinutes":25,"rating":10,"thumbnail":"https://image.tmdb.org/t/p/w300/l0kap0V0XZWHNflCOzhAVkke029.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/l0kap0V0XZWHNflCOzhAVkke029.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/56425/season/1/episode/11"},{"id":"939191","seasonNumber":1,"episodeNumber":12,"title":{"value":"Episodio 12","language":"it-IT"},"overview":{"value":"Yujiro Hanma breaks into the Prime Minister's office to prove a point; Baki Hanma fights the swordsman Kurokawa; Yujiro forces the archer Kanemoto to shoot an arrow at him; Baki visits his mother after she is rejected by Yujiro.","language":"en-US"},"airDateText":{"value":"2001-03-26","language":"it-IT"},"runtimeMinutes":25,"rating":10,"thumbnail":"https://image.tmdb.org/t/p/w300/4UqSQisQEU7ET23wq8jrpItrSGW.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/4UqSQisQEU7ET23wq8jrpItrSGW.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/56425/season/1/episode/12"},{"id":"939192","seasonNumber":1,"episodeNumber":13,"title":{"value":"Episodio 13","language":"it-IT"},"overview":{"value":"All of Baki's friends show up to watch his fight with Yujiro and to help him warm up; meanwhile, Yujiro fights Gaia. Also, Hanayama opens up to Baki about his mother.","language":"en-US"},"airDateText":{"value":"2001-04-02","language":"it-IT"},"runtimeMinutes":25,"rating":10,"thumbnail":"https://image.tmdb.org/t/p/w300/m0Q0lGGuhFSoeg1ii6wWcpmCcI4.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/m0Q0lGGuhFSoeg1ii6wWcpmCcI4.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/56425/season/1/episode/13"},{"id":"939193","seasonNumber":1,"episodeNumber":14,"title":{"value":"Episodio 14","language":"it-IT"},"overview":{"value":"Baki fights his own father, Yujiro.","language":"en-US"},"airDateText":{"value":"2001-04-09","language":"it-IT"},"rating":10,"thumbnail":"https://image.tmdb.org/t/p/w300/zXtrsj1EvHQtdEiSFjAY50tWWsj.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/zXtrsj1EvHQtdEiSFjAY50tWWsj.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/56425/season/1/episode/14"},{"id":"939194","seasonNumber":1,"episodeNumber":15,"title":{"value":"Episodio 15","language":"it-IT"},"overview":{"value":"A recap episode. Detective Kido reflects upon his experiences with Baki Hanma, and Hitoshi Kuriyagawa tells Kido about Baki's relationship with his mother and his fight with Yujiro.","language":"en-US"},"airDateText":{"value":"2001-04-16","language":"it-IT"},"rating":10,"thumbnail":"https://image.tmdb.org/t/p/w300/igUSWG8nVlx9OzOGYQlnWZXR77T.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/igUSWG8nVlx9OzOGYQlnWZXR77T.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/56425/season/1/episode/15"},{"id":"939195","seasonNumber":1,"episodeNumber":16,"title":{"value":"Episodio 16","language":"it-IT"},"overview":{"value":"Antonio Igari, a pro wrestler, tells Mitsunari Tokugawa, an old man who runs an underground fighting circuit, about Baki Hanma and his recent global travels. In the narrative, Baki is seen training and fighting, and, while in Brazil, he visits a fighting master named Dickson. Learning of the circuit, Baki returns to Japan to meet with Tokugawa, and he fights Tokugawa's bodyguards to earn a chance to enter the circuit.","language":"en-US"},"airDateText":{"value":"2001-04-23","language":"it-IT"},"rating":10,"thumbnail":"https://image.tmdb.org/t/p/w300/5MKqW9SNlYIDna8oPbFAmPcatn.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/5MKqW9SNlYIDna8oPbFAmPcatn.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/56425/season/1/episode/16"},{"id":"939196","seasonNumber":1,"episodeNumber":17,"title":{"value":"Episodio 17","language":"it-IT"},"overview":{"value":"Flash forward three years: Baki Hanma is now the champion of the underground arena. Mitsunari Tokugawa meets with Doppo Orochi, a great Shinshinkai karate fighter, and asks him to enter his son in the arena. Doppo finds Kiyosumi Katou, a former student, at his dojo beating up his fighters, and he introduces Katou to the arena. Baki trains for a fight at the boarding house where he is staying, where Kozue Matsumoto, the daughter of the woman who owns the house, has a crush on him.","language":"en-US"},"airDateText":{"value":"2001-04-30","language":"it-IT"},"rating":10,"thumbnail":"https://image.tmdb.org/t/p/w300/qdKWaYfvSEqg7osMRBHozM6K4XG.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/qdKWaYfvSEqg7osMRBHozM6K4XG.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/56425/season/1/episode/17"},{"id":"939197","seasonNumber":1,"episodeNumber":18,"title":{"value":"Episodio 18","language":"it-IT"},"overview":{"value":"Baki Hanma fights Kousho Shinogi, a master of Cord-Cut Karate.","language":"en-US"},"airDateText":{"value":"2001-05-07","language":"it-IT"},"rating":10,"thumbnail":"https://image.tmdb.org/t/p/w300/jEqTeeEbfgiGnOKh5KgynGnI8s6.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/jEqTeeEbfgiGnOKh5KgynGnI8s6.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/56425/season/1/episode/18"},{"id":"939198","seasonNumber":1,"episodeNumber":19,"title":{"value":"Episodio 19","language":"it-IT"},"overview":{"value":"Kiyosumi Katou spars with the fighters in Doppo Orochi's dojo; Kozue Matsumoto interferes with some bullies that are bothering Baki Hanma, which causes problems for her later; several fighters petition Mitsunari Tokugawa to be Baki's next opponent; Baki trains with Izou Motobe.","language":"en-US"},"airDateText":{"value":"2001-05-14","language":"it-IT"},"rating":10,"thumbnail":"https://image.tmdb.org/t/p/w300/buzvq5OqhCWvnH1us0fZPRMGTSk.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/buzvq5OqhCWvnH1us0fZPRMGTSk.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/56425/season/1/episode/19"},{"id":"939199","seasonNumber":1,"episodeNumber":20,"title":{"value":"Episodio 20","language":"it-IT"},"overview":{"value":"Baki fights Mount Toba, a professional wrestler.","language":"en-US"},"airDateText":{"value":"2001-05-21","language":"it-IT"},"rating":10,"thumbnail":"https://image.tmdb.org/t/p/w300/1ccqxIcayyZUdTFAKFLpnauOg7g.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/1ccqxIcayyZUdTFAKFLpnauOg7g.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/56425/season/1/episode/20"},{"id":"939200","seasonNumber":1,"episodeNumber":21,"title":{"value":"Episodio 21","language":"it-IT"},"overview":{"value":"Yujiro Hanma shows up after Baki's fight and knocks him out, and Doppo Orochi challenges Yujiro to a fight. After watching Doppo spar with his students, Baki spars with him. Yujiro starts a fight with a group of boxers at their gym, and he fights with Izou Motobe and Baki's next opponent is revealed.","language":"en-US"},"airDateText":{"value":"2001-05-28","language":"it-IT"},"rating":10,"thumbnail":"https://image.tmdb.org/t/p/w300/yrM48Fz1XKAlmLnFdWQCuBeErZ0.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/yrM48Fz1XKAlmLnFdWQCuBeErZ0.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/56425/season/1/episode/21"},{"id":"939201","seasonNumber":1,"episodeNumber":22,"title":{"value":"Episodio 22","language":"it-IT"},"overview":{"value":"Dr. Shinogi Kureha reveals to his brother, Kousho Shinogi, the Cord-Cutter, why he is fighting Baki Hanma; Doppo Orochi and Yujiro Hanma fight.","language":"en-US"},"airDateText":{"value":"2001-06-04","language":"it-IT"},"rating":10,"thumbnail":"https://image.tmdb.org/t/p/w300/veC2no18yQHoPNBiBj73Hohfo9j.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/veC2no18yQHoPNBiBj73Hohfo9j.jpg","language":"xx"}],"sourceUrl":"h