l/aERvokEDDfBePtwepzc83pMeIdY.jpg"},{"id":2385848,"name":"Kensuke Sato","role":"Donuke (voice)","profile":"https://image.tmdb.org/t/p/original/qxpx78Scmxp3BOZhLLVDmYd5L67.jpg"},{"id":24651,"name":"Nana Mizuki","role":"Victini (voice)","profile":"https://image.tmdb.org/t/p/original/rQBo7HyjTIqeB7hIofb7uJFhiVs.jpg"},{"id":129701,"name":"Shosuke Tanihara","role":"Reshiram (voice)","profile":"https://image.tmdb.org/t/p/original/vwOOXlVjs5hFeqb19Ky61eNGZdO.jpg"},{"id":390407,"name":"Hideki Takahashi","role":"Zekrom (voice)","profile":"https://image.tmdb.org/t/p/original/uu4nvWWl7e8pEaNOhjDHTAqNtVN.jpg"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","title":"Il film Pokémon: Nero - Victini e Reshiram","overview":"Quando Ash e i suoi amici partecipano al torneo nella città di Eindoak, incontrano il mitico Pokémon Victini che diventa il loro nuovo amico. Ma i problemi iniziano quando il malvagio Damon cattura Victini per i suoi piani.","tagline":"Il coraggio della verità di un eroe"},{"language":"en-US","title":"Pokémon the Movie: Black - Victini and Reshiram","overview":"The Kingdom of the People of the Earth once ruled over the land, but now all that remains is the Sword of the Earth. in the city of Eindoak. Satoshi, Iris, and Dent arrive in Eindoak during a harvest festival's Pokémon Tournament and meet the legendary Pokémon Victini who wishes to share its powers of victory to someone. Elsewhere in the city, a descendant of the People of the Earth named Dred Grangil has arrived who seeks to revive the kingdom's power with the Sword of the Earth, bringing them back into power over the land, and Satoshi and his friends must stop him before he destroys the land along with Victini.","tagline":"A hero must choose: the power of ideals... or the courage of truth?"},{"language":"ja-JP","overview":"イッシュ地方を旅するサトシとピカチュウ、アイリス、デントたちは、「大地の剣」と呼ばれる城を中心に広がる街、アイントオークにやってきた。この街はかつて、「大地の民の王国」として栄えていたが、現在は衰退してしまっていた。サトシたちは、アイントオークの収穫祭の記念バトルに参加し、そこで人やポケモンに不思議なパワーを与えることのできる幻のポケモン・ビクティニと出会い、仲良くなる。王国復活を願う大地の民の末裔、ドレッド・グランギルは、ビクティニのパワーを利用し、「大地の剣」を動かそうと企むが、その影響により、アイントオークはかつてない異変に巻き込まれてしまう。果たして、サトシたちはこの街の危機を救えるのか？ ビクティニの運命は？ レシラムの謎とともに、ポケモン史上最大の冒険と感動が、君に迫る！","tagline":"〈理想の黒〉と〈真実の白〉、キミはどちらを観るか!?"}],"images":{"logos":[{"type":"logo","url":"https://image.tmdb.org/t/p/original/65J2Fss4KL5UX19rWyE5JLnO68l.png","previewUrl":"https://image.tmdb.org/t/p/w300/65J2Fss4KL5UX19rWyE5JLnO68l.png","language":"it","width":1356,"height":588},{"type":"logo","url":"https://image.tmdb.org/t/p/original/sjwNh4by0Kb2KHYRhRBy6wO73rO.png","previewUrl":"https://image.tmdb.org/t/p/w300/sjwNh4by0Kb2KHYRhRBy6wO73rO.png","language":"it","width":208,"height":162},{"type":"logo","url":"https://image.tmdb.org/t/p/original/2GEHHBI9sfkqTssTCnRPUmiCGpc.png","previewUrl":"https://image.tmdb.org/t/p/w300/2GEHHBI9sfkqTssTCnRPUmiCGpc.png","language":"en","width":417,"height":290}],"posters":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/jyk08T4CQLuzxepANXDHI1dKRuq.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/jyk08T4CQLuzxepANXDHI1dKRuq.jpg","language":"it","width":853,"height":1280},{"type":"poster","url":"https://image.tmdb.org/t/p/original/rg9yCwJDxeCYsT4ytnmrjv1JxOy.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/rg9yCwJDxeCYsT4ytnmrjv1JxOy.jpg","language":"it","width":853,"height":1280},{"type":"poster","url":"https://image.tmdb.org/t/p/original/ccWZjAPxZJSu9nNGUKMy41DVY5r.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/ccWZjAPxZJSu9nNGUKMy41DVY5r.jpg","language":"it","width":560,"height":841},{"type":"poster","url":"https://image.tmdb.org/t/p/original/SuIAXmxlbImWHobCkCWCHAeg03.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/SuIAXmxlbImWHobCkCWCHAeg03.jpg","language":"en","width":1400,"height":2100},{"type":"poster","url":"https://image.tmdb.org/t/p/original/qPfo5ooRJWUczk3KXv8CnUmNkTl.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/qPfo5ooRJWUczk3KXv8CnUmNkTl.jpg","language":"en","width":1400,"height":2100},{