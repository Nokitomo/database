ょんなことからある日、クラスメイトで現役中二病患者の小鳥遊六花と半ば強制的に契約を結ぶことになってしまった。","tagline":"共鳴せよ、邪王真眼！ ――――いや、無いから"}],"images":{"logos":[{"type":"logo","url":"https://image.tmdb.org/t/p/original/6fTrl6fjmdCg0aMHYHoozHvP5DO.svg","previewUrl":"https://image.tmdb.org/t/p/w300/6fTrl6fjmdCg0aMHYHoozHvP5DO.svg","language":"en","width":954,"height":262},{"type":"logo","url":"https://image.tmdb.org/t/p/original/423QHy9LDcLSXt2VVVg98JkxRfl.png","previewUrl":"https://image.tmdb.org/t/p/w300/423QHy9LDcLSXt2VVVg98JkxRfl.png","language":"en","width":788,"height":228},{"type":"logo","url":"https://image.tmdb.org/t/p/original/3T6Qnfb0vG3aUTG41McIsgR8iif.png","previewUrl":"https://image.tmdb.org/t/p/w300/3T6Qnfb0vG3aUTG41McIsgR8iif.png","language":"ja","width":708,"height":298}],"posters":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/1IapEqydEiGO0gCgBPVexTFbUCS.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/1IapEqydEiGO0gCgBPVexTFbUCS.jpg","language":"en","width":1000,"height":1500},{"type":"poster","url":"https://image.tmdb.org/t/p/original/mWdIWiI6CioqpWlIl3Ax1LbnCBm.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/mWdIWiI6CioqpWlIl3Ax1LbnCBm.jpg","language":"en","width":1000,"height":1500},{"type":"poster","url":"https://image.tmdb.org/t/p/original/b39LfAde2NEzRn2JMfKaZH2HJn.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/b39LfAde2NEzRn2JMfKaZH2HJn.jpg","language":"en","width":802,"height":1203},{"type":"poster","url":"https://image.tmdb.org/t/p/original/j24xEa8m349ajt5P6WkwolxSJpX.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/j24xEa8m349ajt5P6WkwolxSJpX.jpg","language":"en","width":1000,"height":1500},{"type":"poster","url":"https://image.tmdb.org/t/p/original/lv7Gd8EV2oYJQXRfHDb6eFXCZZg.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/lv7Gd8EV2oYJQXRfHDb6eFXCZZg.jpg","language":"en","width":640,"height":960},{"type":"poster","url":"https://image.tmdb.org/t/p/original/anw0BBKyYQsLtTltDO4xMmpiCW6.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/anw0BBKyYQsLtTltDO4xMmpiCW