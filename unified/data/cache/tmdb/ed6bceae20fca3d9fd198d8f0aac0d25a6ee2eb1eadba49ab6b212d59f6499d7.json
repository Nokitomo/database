{"schemaVersion":1,"source":"tmdb","kind":"media","input":{"id":45501,"type":"tv"},"checkedAt":1793645351980,"status":"ok","retryCount":0,"value":{"source":"tmdb-api","id":45501,"type":"tv","sourceUrl":"https://www.themoviedb.org/tv/45501","fetchedAt":"2026-11-02T18:49:11.980Z","originalLanguage":"ja-JP","title":{"value":"Love, Chunibyo & Other Delusions!","language":"it-IT"},"originalTitle":"中二病でも恋がしたい!","overview":{"value":"Essendo una delle migliaia di studenti giapponesi affetti da \"chunibyo\", uno stato in cui cercano disperatamente di distinguersi da essersi convinti di possedere conoscenze segrete e poteri nascosti, Yuta ha trascorso la maggior parte dei suoi anni di scuola media vivendo in un mondo fantastico completo. Sta finalmente riuscendo a superare le sue delusioni ma il suo chunibyo ha attirato le attenzioni di un altro malato, e lei ha deciso che questo lo rende la sua anima gemella.","language":"it-IT"},"tagline":{"value":"共鳴せよ、邪王真眼！ ――――いや、無いから","language":"ja-JP"},"startDate":"2012-10-04","endDate":"2014-03-27","status":"Ended","rating":8.1,"ratingCount":442,"numberOfEpisodes":24,"numberOfSeasons":2,"genres":["Animazione","Commedia"],"countries":["Japan"],"facts":{"Runtime":"24m"},"keywords":[],"networks":[{"id":614,"name":"TOKYO MX","logo":"https://image.tmdb.org/t/p/original/hSdroyVthq3CynxTIIY7lnS8w1.png"},{"id":817,"name":"Sun TV","logo":"https://image.tmdb.org/t/p/original/wkyNhgg9DDtQMFBGXpAaHilE99N.png"}],"socialLinks":{},"cast":[{"id":131563,"name":"Jun Fukuyama","role":"Yuta Togashi (voice)","profile":"https://image.tmdb.org/t/p/original/eT9eloyIaIkTvTqMmpcsAleP2hM.jpg"},{"id":1296667,"name":"Maaya Uchida","role":"Rikka Takanashi (voice)","profile":"https://image.tmdb.org/t/p/original/lrcxZXkIgHU55dMs8C4DKkUohqJ.jpg"},{"id":1325958,"name":"Azumi Asakura","role":"Kumin Tsuyuri (voice)","profile":"https://image.tmdb.org/t/p/original/wlajvPUtfHY5UAREHdd5uG5jyM3.jpg"},{"id":1296666,"name":"Chinatsu Akasaki","role":"Shinka Nibutani (voice)","