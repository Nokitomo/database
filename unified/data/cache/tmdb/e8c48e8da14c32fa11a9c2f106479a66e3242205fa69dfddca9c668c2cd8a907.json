{"schemaVersion":1,"source":"tmdb","kind":"episodes","input":{"mediaId":80188,"seasonNumber":1},"checkedAt":1793645383853,"status":"ok","retryCount":0,"value":{"seasonNumber":1,"name":{"value":"Stagione 1","language":"it-IT"},"year":1995,"episodeCount":4,"poster":"https://image.tmdb.org/t/p/original/o0SzcTlilsTxbERmY9LLH5o5816.jpg","posters":[],"backgrounds":[],"episodes":[{"id":"1506425","seasonNumber":1,"episodeNumber":1,"title":{"value":"Episodio 1","language":"it-IT"},"overview":{"value":"Map in hand, Fam and Ihrie go after the Proof of Royalty hidden in an ancient castle — running headlong into rival explorers Miguel and Rasha, and the thoroughly untrustworthy merchant Galuff. By the time the dust settles, they've learned the catch: the Ultimate Power takes three relics, not one.","language":"en-US"},"airDateText":{"value":"1995-06-25","language":"it-IT"},"runtimeMinutes":31,"thumbnail":"https://image.tmdb.org/t/p/w300/zZnywf9lB0XzHtRnxrtSeykGZkC.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/zZnywf9lB0XzHtRnxrtSeykGZkC.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/80188/season/1/episode/1"},{"id":"1506434","seasonNumber":1,"episodeNumber":2,"title":{"value":"Episodio 2","language":"it-IT"},"overview":{"value":"On the road, Fam meets Prince Lyle and promptly falls for him. In a ruined city the party runs into Ruguduroll — a sorcerer their attacks simply cannot touch. Lyle then reveals what's driving him: this is the man who destroyed his kingdom.","language":"en-US"},"airDateText":{"value":"1995-08-25","language":"it-IT"},"runtimeMinutes":30,"thumbnail":"https://image.tmdb.org/t/p/w300/zuXSifM6dw0Dyk3uuX6h95NYNfc.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/zuXSifM6dw0Dyk3uuX6h95NYNfc.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/80188/season/1/episode/2"},{"id":"1506435","seasonNumber":1,"episodeNumber":3,"title":{"value":"Episodio 3","language":"it-IT"},"overview":