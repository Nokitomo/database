/t/p/original/5jJgMyFAP3GgQtFxP2qe0oE4LHk.jpg"},{"id":67471,"name":"Hideyuki Tanaka","role":"Shinichi Oohashi","profile":"https://image.tmdb.org/t/p/original/1D1PmELZexM6aod77gbh9GwvvGG.jpg"},{"id":9706,"name":"Toshiyuki Morikawa","role":"Keiichi Maeta","profile":"https://image.tmdb.org/t/p/original/hrzGBe4nokgkBNFekNo5hlXB2Bv.jpg"},{"id":124485,"name":"Yuko Nagashima","role":"Chikako Oohashi","profile":"https://image.tmdb.org/t/p/original/94EGuMnLE8hDuLDbrvbQVJZywSP.jpg"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"en-US","title":"Petopeto-san","overview":"Petopeto-san is a light novel series by Kou Kimura, with illustrations by Yug. An anime adaptation ran from July 9, 2005 to October 1, 2005. The show takes place in a Japanese school where everything is normal, except for students from what are called \"specified races.\" The specified races are based on yōkai from Japanese mythology; for example, one student on the swim team is a kappa, while another, a nurikabe, merges with walls and is popular in the summertime for having a very cool temperature."},{"language":"ja-JP","title":"ぺとぺとさん","overview":"妖怪が“特定種族”として、人間社会にそれなりに溶け込んでいる、のどかな田舎。そこにある、人間と妖怪の一環教育を実践する中学校に、今年の夏、いとしいものと触れあうと「ぺとっ」とくっついてしまう、妖怪「ぺとぺとさん」のぺと子が転校してきて…。","tagline":"かわいい妖怪と人間の、ほのぼの不思議な学園物語"}],"images":{"logos":[],"posters":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/5JuQjIHkNYZk7BLszTgD6SVllAV.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/5JuQjIHkNYZk7BLszTgD6SVllAV.jpg","language":"xx","width":1098,"height":1646}],"backdrops":[{"type":"backdrop","url":"https://image.tmdb.org/t/p/original/yC9DW6Eghi51VwqnxPhbQoAjtFG.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/yC9DW6Eghi51VwqnxPhbQoAjtFG.jpg","language":"xx","width":1407,"height":791}]},"poster":"https://image.tmdb.org/t/p/original/5JuQjIHkNYZk7BLszTgD6SVllAV.jpg","background":"https://image.tmdb.org/t/p/original/yC9DW6Eghi51VwqnxPhbQoAjtFG.jpg","seasons":[{"seasonNumber":1,"name":{"value":"Stagione 1","language":"it-IT"},"year":2005,"episodeCount":13,"posters":[],"backgrounds":[],"sourceUrl":"https://www.themoviedb.org/tv/34737/season/1"}],"schema":{}}},"background":"https://image.tmdb.org/t/p/original/yC9DW6Eghi51VwqnxPhbQoAjtFG.jpg"},"episodes":[{"link":"103486","sourcePath":"/play/petopeto-san.Sodux/5-h1vh","sourceEpisodeNumber":1,"episodeNumber":1,"title":"Episodio 1","synopsis":"妖怪が人間社会に溶け込んでいるのどかな田舎町・鮎川町。夏のある日、人間、妖怪の一環教育を実践する大曲垣峠中等教育総合校に、いとしいものと触れあうと「ぺとっ」とくっついてしまう妖怪「ぺとぺとさん」のぺと子が転校してきた。ぺと子ははりきって水泳の授業に臨むが、クラスメイトのシンゴとぺとってしまい…。","externalMappings":[{"provider":"anidb","id":"3170","scope":"R","episodeNumbers":[1]},{"provider":"anilist","id":"612","episodeNumbers":[1]},{"provider":"mal","id":"612","episodeNumbers":[1]},{"provider":"tmdb_show","id":"34737","scope":"s1","seasonNumber":1,"episodeNumbers":[1]},{"provider":"tvdb_show","id":"84841","scope":"s1","seasonNumber":1,"episodeNumbers":[1]}],"seasonNumber":1,"metadataSources":{"tmdb":{"title":"Episodio 1","synopsis":"妖怪が人間社会に溶け込んでいるのどかな田舎町・鮎川町。夏のある日、人間、妖怪の一環教育を実践する大曲垣峠中等教育総合校に、いとしいものと触れあうと「ぺとっ」とくっついてしまう妖怪「ぺとぺとさん」のぺと子が転校してきた。ぺと子ははりきって水泳の授業に臨むが、クラスメイトのシンゴとぺとってしまい…。"},"tvdb":{"title":"Hello-san","titleLanguage":"eng"}}},{"link":"103487","sourcePath":"/play/petopeto-san.Sodux/5F2hpg","sourceEpisodeNumber":2,"episodeNumber":2,"title":"Episodio 2","synopsis":"ぺと子が抱きついてもぺとらない唯一の友達、ぬりちゃんはぬりかべだけあって夏でもひんやり。そんなぬりちゃんに女子たちが抱きつくなか、ぺと子だけはなぜか様子がおかしい。シンゴがたずねると、ぺと子は最近誰かに後をつけられているという。その日の帰り道、シンゴとぺと子の後ろから怪しい足音が聞こえてきて…。","externalMappings":[{"provider":"anidb","id":"3170","scope":"R","episodeNumbers":[2]},{"provider":"anilist","id":"612","episodeNumbers":[2]},{"provider":"mal","id":"612","episodeNumbers":[2]},{"provider":"tmdb_show","id":"34737","scope":"s1","seasonNumber":1,"episodeNumbers":[2]},{"provider":"tvdb_show","id":"84841","scope":"s1","seasonNumber":1,"episodeNumbers":[2]}],"seasonNumber":1,"metadataSources":{"tmdb":{"title":"Episodio 2","synopsis":"ぺと子が抱きついてもぺとらない唯一の友達、ぬりちゃんはぬりかべだけあって夏でもひんやり。そんなぬりちゃんに女子たちが抱きつくなか、ぺと子だけはなぜか様子がおかしい。シンゴがたずねると、ぺと子は最近誰かに後をつけられているという。その日の帰り道、シンゴとぺと子の後ろから怪しい足音が聞こえてきて…。"},"tvdb":{"title":"A Special Race","titleLanguage":"eng"}}},{"link":"103488","sourcePath":"/play/petopeto-san.Sodux/xVCIbY","sourceEpisodeNumber":3,"episodeNumber":3,"title":"Episodio 3","synopsis":"コンビニでの一件から一夜明けて、シンゴは寝不足気味。そんなシンゴと妖怪れろれろの赤沢のヘンな様子に気付いたくぐるは、シンゴに何があったのかと問い詰める。一方、期末テストの最中、シンゴはある異変に気付く。異変の原因を知ったシンゴは、くぐるやぬりちゃんといっしょに解決のための奮闘を始めるのだった。","externalMappings":[{"provider":"anidb","id":"3170","scope":"R","episodeNumbers":[3]},{"provider":"anilist","id":"612","episodeNumbers":[3]},{"provider":"mal","id":"612","episodeNumbers":[3]},{"provider":"tmdb_show","id":"34737","scope":"s1","seasonNumber":1,"episodeNumbers":[3]},{"provider":"tvdb_show","id":"84841","scope":"s1","seasonNumber":1,"episodeNumbers":[3]}],"seasonNumber":1,"metadataSources":{"tmdb":{"title":"Episodio 3","synopsis":"コンビニでの一件から一夜明けて、シンゴは寝不足気味。そんなシンゴと妖怪れろれろの赤沢のヘンな様子に気付いたくぐるは、シンゴに何があったのかと問い詰める。一方、期末テストの最中、シンゴはある異変に気付く。異変の原因を知ったシンゴは、くぐるやぬりちゃんといっしょに解決のための奮闘を始めるのだった。"},"tvdb":{"title":"Mint or Lavender","titleLanguage":"eng"}}},{"link":"103489","sourcePath":"/play/petopeto-san.Sodux/kzIr9b","sourceEpisodeNumber":4,"episodeNumber":4,"title":"Episodio 4","synopsis":"学校を休んだぺと子に給食のパンを届けに来たシンゴだが、そこにぺと子はいなかった。心配するシンゴの耳に、川の方から奇妙な音が聞こえてくる。音につられてやってきた川で、シンゴはぺと子と同じく学校を休んでいたくぐるに会う。友里先生の家まで案内してほしいと言うくぐる。理由が分からないシンゴだったが…。","externalMappings":[{"provider":"anidb","id":"3170","scope":"R","episodeNumbers":[4]},{"provider":"anilist","id":"612","episodeNumbers":[4]},{"provider":"mal","id":"612","episodeNumbers":[4]},{"provider":"tmdb_show","id":"34737","scope":"s1","seasonNumber":1,"episodeNumbers":[4]},{"provider":"tvdb_show","id":"84841","scope":"s1","seasonNumber":1,"episodeNumbers":[4]}],"seasonNumber":1,"metadataSources":{"tmdb":{"title":"Episodio 4","synopsis":"学校を休んだぺと子に給食のパンを届けに来たシンゴだが、そこにぺと子はいなかった。心配するシンゴの耳に、川の方から奇妙な音が聞こえてくる。音につられてやってきた川で、シンゴはぺと子と同じく学校を休んでいたくぐるに会う。友里先生の家まで案内してほしいと言うくぐる。理由が分からないシンゴだったが…。"},"tvdb":{"title":"Family Matters","titleLanguage":"eng"}}},{"link":"103490","sourcePath":"/play/petopeto-san.Sodux/15Nytl","sourceEpisodeNumber":5,"episodeNumber":5,"title":"Episodio 5","synopsis":"くぐるとその妹・ちょちょ丸による姉妹抗争は、ぺと子の乱入により一旦水入りを迎えた。一方、鮎川町では一大イベントのミスにょみの里コンテスト、略して「ミにょコン」が開催されようとしていた。お祭りムードで盛り上がる会場に、高級車とともに現れたちょちょ丸は、自分も「ミにょコン」に参加すると言い出すが…。","externalMappings":[{"provider":"anidb","id":"3170","scope":"R","episodeNumbers":[5]},{"provider":"anilist","id":"612","episodeNumbers":[5]},{"provider":"mal","id":"612","episodeNumbers":[5]},{"provider":"tmdb_show","id":"34737","scope":"s1","seasonNumber":1,"episodeNumbers":[5]},{"provider":"tvdb_show","id":"84841","scope":"s1","seasonNumber":1,"episodeNumbers":[5]}],"seasonNumber":1,"metadataSources":{"tmdb":{"title":"Episodio 5","synopsis":"くぐるとその妹・ちょちょ丸による姉妹抗争は、ぺと子の乱入により一旦水入りを迎えた。一方、鮎川町では一大イベントのミスにょみの里コンテスト、略して「ミにょコン」が開催されようとしていた。お祭りムードで盛り上がる会場に、高級車とともに現れたちょちょ丸は、自分も「ミにょコン」に参加すると言い出すが…。"},"tvdb":{"title":"Younger Sister Village","titleLanguage":"eng"}}},{"link":"103491","sourcePath":"/play/petopeto-san.Sodux/RodqjH","sourceEpisodeNumber":6,"episodeNumber":6,"title":"Episodio 6","synopsis":"「ミにょコン」で周囲に牙をむいたちょちょ丸を止めるべく、くぐるは舞台上で再びちょちょ丸と対峙する。ぺと子たちが間に割って入ろうとするが、これはあくまでも姉妹の問題だと、二人は周りを寄せ付けず、やがて決闘が始まってしまう。しかし、ちょちょ丸にとってこの闘いは単なる決闘ではなかったのだった。","externalMappings":[{"provider":"anidb","id":"3170","scope":"R","episodeNumbers":[6]},{"provider":"anilist","id":"612","episodeNumbers":[6]},{"provider":"mal","id":"612","episodeNumbers":[6]},{"provider":"tmdb_show","id":"34737","scope":"s1","seasonNumber":1,"episodeNumbers":[6]},{"provider":"tvdb_show","id":"84841","scope":"s1","seasonNumber":1,"episodeNumbers":[6]}],"seasonNumber":1,"metadataSources":{"tmdb":{"title":"Episodio 6","synopsis":"「ミにょコン」で周囲に牙をむいたちょちょ丸を止めるべく、くぐるは舞台上で再びちょちょ丸と対峙する。ぺと子たちが間に割って入ろうとするが、これはあくまでも姉妹の問題だと、二人は周りを寄せ付けず、やがて決闘が始まってしまう。しかし、ちょちょ丸にとってこの闘いは単なる決闘ではなかったのだった。"},"tvdb":{"title":"Older Sister and Younger Sister","titleLanguage":"eng"}}},{"link":"103492","sourcePath":"/play/petopeto-san.Sodux/MzHY4O","sourceEpisodeNumber":7,"episodeNumber":7,"title":"Episodio 7","synopsis":"夏休み。ぺと子とシンゴは朝それぞれ牛乳配達と新聞配達をすることになり、二人で一緒に自転車で配達。そしてラジオ体操にも欠かさず参加し、ゆったりした夏休みを送っていた。そんなある日、ぺと子は東京で開かれる鮎川町物産展にコンパニオンとして行くことになる。東京の大都会ぶりに圧倒されるぺと子だが…。","externalMappings":[{"provider":"anidb","id":"3170","scope":"R","episodeNumbers":[7]},{"provider":"anilist","id":"612","episodeNumbers":[7]},{"provider":"mal","id":"612","episodeNumbers":[7]},{"provider":"tmdb_show","id":"34737","scope":"s1","seasonNumber":1,"episodeNumbers":[7]},{"provider":"tvdb_show","id":"84841","scope":"s1","seasonNumber":1,"episodeNumbers":[7]}],"seasonNumber":1,"metadataSources":{"tmdb":{"title":"Episodio 7","synopsis":"夏休み。ぺと子とシンゴは朝それぞれ牛乳配達と新聞配達をすることになり、二人で一緒に自転車で配達。そしてラジオ体操にも欠かさず参加し、ゆったりした夏休みを送っていた。そんなある日、ぺと子は東京で開かれる鮎川町物産展にコンパニオンとして行くことになる。東京の大都会ぶりに圧倒されるぺと子だが…。"},"tvdb":{"title":"Ding-ling Ding-ling","titleLanguage":"eng"}}},{"link":"103493","sourcePath":"/play/petopeto-san.Sodux/3W333X","sourceEpisodeNumber":8,"episodeNumber":8,"title":"Episodio 8","synopsis":"東京でコンパニオンをしているぺと子たちの帰りを待つシンゴ。なかなか戻ってくる気配のない様子に、シンゴはキャンプの準備も手に付かないまま、ぺと子たちの帰りをひたすら待ち侘びていた。キャンプの日も浮かない顔でフォークダンスの輪に加わろうとするシンゴの目に、車のヘッドライトが飛び込んできて…。","externalMappings":[{"provider":"anidb","id":"3170","scope":"R","episodeNumbers":[8]},{"provider":"anilist","id":"612","episodeNumbers":[8]},{"provider":"mal","id":"612","episodeNumbers":[8]},{"provider":"tmdb_show","id":"34737","scope":"s1","seasonNumber":1,"episodeNumbers":[8]},{"provider":"tvdb_show","id":"84841","scope":"s1","seasonNumber":1,"episodeNumbers":[8]}],"seasonNumber":1,"metadataSources":{"tmdb":{"title":"Episodio 8","synopsis":"東京でコンパニオンをしているぺと子たちの帰りを待つシンゴ。なかなか戻ってくる気配のない様子に、シンゴはキャンプの準備も手に付かないまま、ぺと子たちの帰りをひたすら待ち侘びていた。キャンプの日も浮かない顔でフォークダンスの輪に加わろうとするシンゴの目に、車のヘッドライトが飛び込んできて…。"},"tvdb":{"title":"Summer Camp","titleLanguage":"eng"}}},{"link":"103494","sourcePath":"/play/petopeto-san.Sodux/-su0lG","sourceEpisodeNumber":9,"episodeNumber":9,"title":"Episodio 9","synopsis":"大橋家の周りを取り囲む複数の人相の悪い男たち。聞くところによると、ある男を捜しているというのだが、彼らの口から出た名前に反応したのはぺと子の母まる子だった。一方、ぺと子はイベントで鮎川町の警察署の一日署長を勤めることに。ミニパトに乗ってオニ警官たちと町内を巡回するぺと子だったが…。","externalMappings":[{"provider":"anidb","id":"3170","scope":"R","episodeNumbers":[9]},{"provider":"anilist","id":"612","episodeNumbers":[9]},{"provider":"mal","id":"612","episodeNumbers":[9]},{"provider":"tmdb_show","id":"34737","scope":"s1","seasonNumber":1,"episodeNumbers":[9]},{"provider":"tvdb_show","id":"84841","scope":"s1","seasonNumber":1,"episodeNumbers":[9]}],"seasonNumber":1,"metadataSources":{"tmdb":{"title":"Episodio 9","synopsis":"大橋家の周りを取り囲む複数の人相の悪い男たち。聞くところによると、ある男を捜しているというのだが、彼らの口から出た名前に反応したのはぺと子の母まる子だった。一方、ぺと子はイベントで鮎川町の警察署の一日署長を勤めることに。ミニパトに乗ってオニ警官たちと町内を巡回するぺと子だったが…。"},"tvdb":{"title":"Police Chief for a Day","titleLanguage":"eng"}}},{"link":"103495","sourcePath":"/play/petopeto-san.Sodux/UzSkdi","sourceEpisodeNumber":10,"episodeNumber":10,"title":"Episodio 10","synopsis":"東京でカンナと一緒にいた男が捕まったとの知らせを受け、警察で犯人の到着を待つぺと子。一方カンナは、誘拐されていたという誤解に対しては否定するものの、東京へ行っていた理由はなかなか口にしようとしない。ぺと子たちがカンナから理由を聞き出そうとしたその時、上空から美少年ざしきわらしの和賀八郎が現れる。","externalMappings":[{"provider":"anidb","id":"3170","scope":"R","episodeNumbers":[10]},{"provider":"anilist","id":"612","episodeNumbers":[10]},{"provider":"mal","id":"612","episodeNumbers":[10]},{"provider":"tmdb_show","id":"34737","scope":"s1","seasonNumber":1,"episodeNumbers":[10]},{"provider":"tvdb_show","id":"84841","scope":"s1","seasonNumber":1,"episodeNumbers":[10]}],"seasonNumber":1,"metadataSources":{"tmdb":{"title":"Episodio 10","synopsis":"東京でカンナと一緒にいた男が捕まったとの知らせを受け、警察で犯人の到着を待つぺと子。一方カンナは、誘拐されていたという誤解に対しては否定するものの、東京へ行っていた理由はなかなか口にしようとしない。ぺと子たちがカンナから理由を聞き出そうとしたその時、上空から美少年ざしきわらしの和賀八郎が現れる。"},"tvdb":{"title":"Scout","titleLanguage":"eng"}}},{"link":"103496","sourcePath":"/play/petopeto-san.Sodux/CIXmA1","sourceEpisodeNumber":11,"episodeNumber":11,"title":"Episodio 11","synopsis":"一家三人が揃い、シンゴの家から満福寺へ引っ越すことを決めたぺと子たち一家。しかし、満福寺には大量の“化けダニ”が住みついていたため、虫嫌いのぺと子だけがそのままシンゴの家に居残ることになる。また、“いもてん”プロジェクトの実施に向けて、ちょちょ丸はぺと子に一緒に博多へ来て欲しいと専属契約を申し込む。","externalMappings":[{"provider":"anidb","id":"3170","scope":"R","episodeNumbers":[11]},{"provider":"anilist","id":"612","episodeNumbers":[11]},{"provider":"mal","id":"612","episodeNumbers":[11]},{"provider":"tmdb_show","id":"34737","scope":"s1","seasonNumber":1,"episodeNumbers":[11]},{"provider":"tvdb_show","id":"84841","scope":"s1","seasonNumber":1,"episodeNumbers":[11]}],"seasonNumber":1,"metadataSources":{"tmdb":{"title":"Episodio 11","synopsis":"一家三人が揃い、シンゴの家から満福寺へ引っ越すことを決めたぺと子たち一家。しかし、満福寺には大量の“化けダニ”が住みついていたため、虫嫌いのぺと子だけがそのままシンゴの家に居残ることになる。また、“いもてん”プロジェクトの実施に向けて、ちょちょ丸はぺと子に一緒に博多へ来て欲しいと専属契約を申し込む。"},"tvdb":{"title":"\"Imo-ten\" Test Trial Version","titleLanguage":"eng"}}},{"link":"103497","sourcePath":"/play/petopeto-san.Sodux/KuchQw","sourceEpisodeNumber":12,"episodeNumber":12,"title":"Episodio 12","synopsis":"夏休みも残りあとわずか。ぺと子はシンゴに博多へ行くことを告げる。お別れパーティーをやろうと言うシンゴだが、その顔はちょっと寂しい。一方、ぺと子はくぐるにある相談をもちかける。ぺと子の秘密の大作戦「プロジェクト・アケガラス」、それは自分が引っ越す前に、くぐるとシンゴをラブラブにするという作戦だった。","externalMappings":[{"provider":"anidb","id":"3170","scope":"R","episodeNumbers":[12]},{"provider":"anilist","id":"612","episodeNumbers":[12]},{"provider":"mal","id":"612","episodeNumbers":[12]},{"provider":"tmdb_show","id":"34737","scope":"s1","seasonNumber":1,"episodeNumbers":[12]},{"provider":"tvdb_show","id":"84841","scope":"s1","seasonNumber":1,"episodeNumbers":[12]}],"seasonNumber":1,"metadataSources":{"tmdb":{"title":"Episodio 12","synopsis":"夏休みも残りあとわずか。ぺと子はシンゴに博多へ行くことを告げる。お別れパーティーをやろうと言うシンゴだが、その顔はちょっと寂しい。一方、ぺと子はくぐるにある相談をもちかける。ぺと子の秘密の大作戦「プロジェクト・アケガラス」、それは自分が引っ越す前に、くぐるとシンゴをラブラブにするという作戦だった。"},"tvdb":{"title":"Project Daybreak","titleLanguage":"eng"}}},{"link":"103498","sourcePath":"/play/petopeto-san.Sodux/PZQzfg","sourceEpisodeNumber":13,"episodeNumber":13,"title":"Episodio 13","synopsis":"夏休み最後の日、ぺと子のお別れパーティー当日を迎える。ぺと子とちょちょ丸は夕方に行われる“いもてん”のイベントをもって、ミス・にょみの里としての役目を終えることになる。寂しさを紛らわすかのように努めて明るく振舞う一同。そんな中“いもてん”が終了し、遂に「プロジェクト・アケガラス」が始動する…。","externalMappings":[{"provider":"anidb","id":