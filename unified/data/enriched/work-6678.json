{"info":{"title":"Hand Maid May (ITA)","originalTitle":"Hand Maid May (ITA)","synopsis":"Saotome Kazuya è un genio del computer. Un giorno, il suo amico Nanbara lo minaccia con un virus informatico. Cercando di fermare il virus, Kazuya finisce per fare un ordine speciale. May è una cyberdoll che arriva alla sua porta pochi minuti dopo, ed è grande solo un sesto di una persona normale, cosa che porta a molte situazioni imbarazzanti. Senza contare che Kazuya non può nemmeno permettersi di mantenere May. La Cyberdyne non è soddisfatta dei mancati pagamenti di Kazuya e farà di tutto per recuperare la CBD May.","type":"series","status":"completed","statusLabel":"Finito","audio":"Italiano","dubbed":true,"releaseDateLabel":"26 Luglio 2000","year":2000,"season":"Estate 2000","studios":["TNK"],"genres":["Commedia","Ecchi","Harem","Romantico","Sci-Fi","Sentimentale"],"durationLabel":"20 min/ep","declaredEpisodeCount":10,"availableEpisodeCount":10,"rating":7.74,"ratingCount":19,"views":2819,"poster":"https://image.tmdb.org/t/p/original/aOORfUBZ41Lsn93Sg8B2dWoYQN7.jpg","shareImage":{"base":"img","path":"/copertine/WmKpC.png"},"sourceType":"Anime","tags":["Anime","Finito","2000"],"extra":{"ids":{"anilistIds":[318],"malIds":[318],"anidbIds":[60],"imdbMovieIds":[],"imdbShowIds":[],"tmdbMovieIds":[],"tmdbShowIds":[34749],"tvdbMovieIds":[],"tvdbShowIds":[72470]},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-11-02T08:43:20Z","sourceDescriptors":["anilist:318","mal:318"],"imdbSource":"plexanibridge-v2","targets":[{"provider":"anidb","id":"60","scope":"R","ranges":{"1-10":"1-10"}},{"provider":"anilist","id":"318","ranges":{"1-10":"1-10"}},{"provider":"mal","id":"318","ranges":{"1-10":"1-10"}},{"provider":"tmdb_show","id":"34749","scope":"s1","ranges":{"1-10":"1-10"}},{"provider":"tvdb_show","id":"72470","scope":"s1","ranges":{"1-10":"1-10"}}]},"metadataTargets":[{"provider":"anidb","id":"60","scope":"R","raw":"anidb:60:R","ranges":{"1-10":"1-10"}},{"pr