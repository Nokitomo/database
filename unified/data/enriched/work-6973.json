,"poster":"https://image.tmdb.org/t/p/original/d9L8XCOr6nK7fsKjX2iL2eVWstS.jpg","posters":[],"backgrounds":[],"sourceUrl":"https://www.themoviedb.org/tv/68482/season/3"},{"seasonNumber":4,"name":{"value":"Stagione 4","language":"it-IT"},"year":2017,"episodeCount":12,"poster":"https://image.tmdb.org/t/p/original/bgEK6Y0fbEHRygN1CKzm1sOQLEi.jpg","posters":[],"backgrounds":[],"sourceUrl":"https://www.themoviedb.org/tv/68482/season/4"},{"seasonNumber":5,"name":{"value":"Stagione 5","language":"it-IT"},"year":2019,"episodeCount":12,"poster":"https://image.tmdb.org/t/p/original/4iHtICzNqEQgyYwg2JWbEQEDEAY.jpg","posters":[],"backgrounds":[],"sourceUrl":"https://www.themoviedb.org/tv/68482/season/5"}],"schema":{}}},"background":"https://image.tmdb.org/t/p/original/y106aFMcHV8yHvxwya0oWL5gh6y.jpg","logo":"https://image.tmdb.org/t/p/original/fO3WDmWCXvPzw04gz4lt16DqPRy.png"},"episodes":[{"link":"26147","sourcePath":"/play/ame-iro-cocoa-side-g.GXX-c/8thBO","sourceEpisodeNumber":1,"episodeNumber":1,"title":"Episodio 1","synopsis":"夏の眩しい日差し、きらめく海の水面。そこに不釣あいな土下座する女子高生。顔を上げた彼女・天見ヨーコは友人のマリナ、ノンへ一緒にバイトをしようと頼み込む。そこへ見知らぬ2人組の女子高生が通りかかり……。","thumbnail":"https://artworks.thetvdb.com/banners/episodes/293647/6878572.jpg","externalMappings":[{"provider":"anidb","id":"14039","scope":"R","episodeNumbers":[1]},{"provider":"anilist","id":"104712","episodeNumbers":[1]},{"provider":"mal","id":"37747","episodeNumbers":[1]},{"provider":"tmdb_show","id":"68482","scope":"s5","seasonNumber":5,"episodeNumbers":[1]},{"provider":"tvdb_show","id":"293647","scope":"s5","seasonNumber":5,"episodeNumbers":[1]}],"seasonNumber":5,"metadataSources":{"tmdb":{"title":"Episodio 1","synopsis":"夏の眩しい日差し、きらめく海の水面。そこに不釣あいな土下座する女子高生。顔を上げた彼女・天見ヨーコは友人のマリナ、ノンへ一緒にバイトをしようと頼み込む。そこへ見知らぬ2人組の女子高生が通りかかり……。"},"tvdb":{"title":"Episode 1","synopsis":"Nozomu is ready to open up the new Rainy Color branch... in Waikiki!","titleLanguage":"eng","synopsisLanguage":"eng"}}},{"link":"26280","sourcePath":"/play/ame-iro-cocoa-side-g.GXX-c/QI3cj","sourceEpisodeNumber":2,"episodeNumber":2,"title":"Episodio 2","synopsis":"数日前、ヨーコはうだる空気の中、足早にとある場所へ向かっていた。そこはレイニーカラー。父親の天見浩司が経営する小さな喫茶店だ。旅行準備中の父へ猛烈な勢いで抗議するヨーコだったが、現れたレインに驚き――。","thumbnail":"https://artworks.thetvdb.com/banners/series/293647/episodes/602ae053f1dd6.jpg","externalMappings":[{"provider":"anidb","id":"14039","scope":"R","episodeNumbers":[2]},{"provider":"anilist","id":"104712","episodeNumbers":[2]},{"provider":"mal","id":"37747","episodeNumbers":[2]},{"provider":"tmdb_show","id":"68482","scope":"s5","seasonNumber":5,"episodeNumbers":[2]},{"provider":"tvdb_show","id":"293647","scope":"s5","seasonNumber":5,"episodeNumbers":[2]}],"seasonNumber":5,"metadataSources":{"tmdb":{"title":"Episodio 2","synopsis":"数日前、ヨーコはうだる空気の中、足早にとある場所へ向かっていた。そこはレイニーカラー。父親の天見浩司が経営する小さな喫茶店だ。旅行準備中の父へ猛烈な勢いで抗議するヨーコだったが、現れたレインに驚き――。"},"tvdb":{"title":"Episode 2","synopsis":"While cleaning up the new cafe location, Nozomu finds a ghost.","titleLanguage":"eng","synopsisLanguage":"eng"}}},{"link":"26479","sourcePath":"/play/ame-iro-cocoa-side-g.GXX-c/kv7qy","sourceEpisodeNumber":3,"episodeNumber":3,"title":"Episodio 3","synopsis":"レイニーカラーの店内で父・天見浩司から説教を受けているヨーコ。珍しく怒っている浩司は、ヨーコへ「レイニーカラーで働きながら人の役にたて」と課題をだす。そしてヨーコは店の常連である女の子・芽留と出会うのだった。","thumbnail":"https://artworks.thetvdb.com/banners/series/293647/episodes/602ae061ebcaa.jpg","externalMappings":[{"provider":"anidb","id":"14039","scope":"R","episodeNumbers":[3]},{"provider":"anilist","id":"104712","episodeNumbers":[3]},{"provider":"mal","id":"37747","episodeNumbers":[3]},{"provider":"tmdb_show","id":"68482","scope":"s5","seasonNumber":5,"episodeNumbers":[3]},{"provider":"tvdb_show","id":"293647","scope":"s5","seasonNumber":5,"episodeNumbers":[3]}],"seasonNumber":5,"metadataSources":{"tmdb":{"title":"Episodio 3","synopsis":"レイニーカラーの店内で父・天見浩司から説教を受けているヨーコ。珍しく怒っている浩司は、ヨーコへ「レイニーカラーで働きながら人の役にたて」と課題をだす。そしてヨーコは店の常連である女の子・芽留と出会うのだった。"},"tvdb":{"title":"Episode 3","synopsis":"Nozomu and his new helper Shank try Hawaiian-grown chocolate and fin