t6.jpg","background":"https://image.tmdb.org/t/p/original/t4gRq2ttmeX0H4iwN4B0KJ2ejM3.jpg","seasons":[],"schema":{}}},"background":"https://image.tmdb.org/t/p/original/t4gRq2ttmeX0H4iwN4B0KJ2ejM3.jpg"},"episodes":[{"link":"52093","sourcePath":"/play/pia-carrot-e-youkoso-sayaka-no-koi-monogatari.t-Pmc/8cLBmL","sourceEpisodeNumber":1,"episodeNumber":1,"title":"Welcome to Pia Carrot! - The Movie ~Sayaka's Love Story~","synopsis":"High schoolers Sayaka Takai and Akihiko Kannazuki work together at a restaurant chain \"Pia Carrot.\" Both are interested in each other, but before either could make a move Sayaka was temporarily rotated to the newly established branch at a beach resort. While waitress girls at this new location did their best to confront harassment, make new friends, and attract new customers by attending a beauty contest, Sayaka's feeling for Akihiko never stops and has become stronger and stronger.","externalMappings":[{"provider":"anidb","id":"856","scope":"R","episodeNumbers":[1]},{"provider":"anilist","id":"216","episodeNumbers":[1]},{"provider":"imdb_movie","id":"tt1178592","episodeNumbers":[1]},{"provider":"mal","id":"216","episodeNumbers":[1]},{"provider":"tmdb_movie","id":"258802","episodeNumbers":[1]},{"provider":"tvdb_show","id":"349691","scope":"s0","seasonNumber":0,"episodeNumbers":[7]}],"metadataSources":{"tvdb":{"title":"Welcome to Pia Carrot! - The Movie ~Sayaka's Love Story~","synopsis":"High schoolers Sayaka Takai and Akihiko Kannazuki work together at a restaurant chain \"Pia Carrot.\" Both are interested in each other, but before either could make a move Sayaka was temporarily rotated to the newly established branch at a beach resort. While waitress girls at this new location did their best to confront harassment, make new friends, and attract new customers by attending a beauty contest, Sayaka's feeling for Akihiko never stops and has become stronger and stronger.","titleLanguage":"eng","synopsisLanguage":"eng"}}}],"mappings":{"source":"a