{"info":{"title":"Naruto Shippuden Movie 07: The Last (ITA)","originalTitle":"The Last: Naruto the Movie (ITA)","synopsis":"Decimo film della saga di Naruto, ambientato due anni dopo la fine della guerra (tra il capitolo 699 e 700 del manga), incentrato sul rapporto tra Hinata e Naruto. La luna si sta avvicinando pericolosamente alla terra e Hanabi, la sorella minore di Hinata, viene rapita. I due faranno parte della squadra di salvataggio, durante la missione Naruto si renderà conto dei sentimenti della ragazza per lui e dei suoi per lei.","type":"movie","status":"completed","statusLabel":"Finito","audio":"Italiano","dubbed":true,"season":"Autunno 2014","year":2014,"releaseDateLabel":"06 Dicembre 2014","studios":["Studio Pierrot"],"genres":["Arti Marziali","Azione","Romantico","Sentimentale","Shounen","Superpoteri"],"declaredEpisodeCount":1,"availableEpisodeCount":1,"durationLabel":"1h e 52 min","rating":7,"ratingCount":4,"views":43312,"poster":"https://image.tmdb.org/t/p/original/qzcHTNTqcq5chJamRmRVnhJTWus.jpg","sourceType":"Movie","tags":["Movie","Finito","2014"],"extra":{"ids":{"anilistIds":[2472,4134,4437,6325,8246,10075,10589,10659,10686,13667,16870,19511,21220,21579],"malIds":[2472,4134,4437,6325,8246,10075,10589,10659,10686,13667,16870,19511,28755,32365],"anidbIds":[5178,5914,6503,7483,8159,8312,8384,8387,9023,9588,10961],"imdbMovieIds":["tt0988982","tt1160524","tt1481363","tt1703048","tt1999167","tt2290828","tt3717532","tt4618398","tt6163050"],"imdbShowIds":[],"tmdbMovieIds":[17581,20982,36728,50723,75624,118406,189349,317442,347201,609197],"tmdbShowIds":[31910],"tvdbMovieIds":[6255,6385,7690,9317],"tvdbShowIds":[79824]},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-11-14T08:25:00Z","sourceDescriptors":["anilist:16870","mal:16870"],"imdbSource":"anibridge-v3","targets":[{"provider":"anidb","id":"10961","scope":"R"},{"provider":"anidb","id":"10961","scope":"S"},{"provider":"anidb","id":"5178","scope":"R"},{"provider":"anidb