{"info":{"title":"Marginal#4: Kiss kara Tsukuru Big Bang","originalTitle":"MARGINAL #4 the Animation","synopsis":"Il 13 febbraio, mentre i fiocchi di neve danzano nell'aria, alla Pythagoras Production nasce un nuovo gruppo di idol che porterà i loro baci ai confini della galassia: i Marginal #4. Atom Kirihara, Rui Aiba, L Nomura e R Nomura concentrano i loro sforzi nella loro carriera per la gioia delle fan! Continuano a maturare come idol assieme al gruppo più anziano che domina la scena dell'intrattenimento, Lagrange Point, e quello più giovane che prepara il proprio debutto, Unicorn Jr. Quando scendono dal palco, però, sono normali studenti delle superiori con una caotica vita scolastica!","type":"series","status":"completed","statusLabel":"Finito","audio":"Giapponese","dubbed":false,"releaseDateLabel":"12 Gennaio 2017","year":2017,"season":"Inverno 2017","studios":["J.C.Staff"],"genres":["Commedia","Musicale","Scolastico"],"durationLabel":"23 min/ep","declaredEpisodeCount":12,"availableEpisodeCount":12,"rating":6.68,"ratingCount":50,"views":12056,"poster":"https://image.tmdb.org/t/p/original/1fDK0pOq11iFeQSzIE4wD3jhm0r.jpg","shareImage":{"base":"img","path":"/locandine/83799.jpg"},"sourceType":"Anime","tags":["Anime","Finito","2017"],"extra":{"ids":{"anilistIds":[21645],"malIds":[33788],"anidbIds":[11928],"imdbMovieIds":[],"imdbShowIds":[],"tmdbMovieIds":[],"tmdbShowIds":[69294],"tvdbMovieIds":[],"tvdbShowIds":[321440]},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-11-02T08:43:20Z","sourceDescriptors":["anilist:21645","mal:33788"],"targets":[{"provider":"anidb","id":"11928","scope":"R","ranges":{"1-12":"1-12"}},{"provider":"anilist","id":"21645","ranges":{"1-12":"1-12"}},{"provider":"mal","id":"33788","ranges":{"1-12":"1-12"}},{"provider":"tmdb_show","id":"69294","scope":"s1","ranges":{"1-12":"1-12"}},{"provider":"tvdb_show","id":"321440","scope":"s1","ranges":{"1-12":"1-12"}}]},"metadataTargets":[{"provider":"anidb","id":"11928