"1-24"}}],"imdbId":"tt12094170","sourceIds":{"anilist":115186,"mal":41266},"tmdb":{"source":"tmdb-api","id":102282,"type":"tv","sourceUrl":"https://www.themoviedb.org/tv/102282","fetchedAt":"2026-11-02T17:58:27.554Z","originalLanguage":"ja-JP","title":{"value":"Extra Olympia Kyklos","language":"en-US"},"originalTitle":"オリンピア・キュクロス","overview":{"value":"Demetrios was a young man in Ancient Greece who was a potter's apprentice, but also a rather timid otaku. Despite pursuing the arts, he was blessed with natural athletic talent. One day, he gets dragged into a village conflict. Demetrios contemplates how helpless he is, but then is struck by lightning! When he comes to, he is no longer in Greece, but a strange land where he can't understand the language and people look rather different. Yes, he somehow ended up 1964 Tokyo! Of course, Demetrios has no idea what Japan even is. What will become of him?!!","language":"en-US"},"startDate":"2020-04-20","endDate":"2020-11-02","status":"Ended","rating":5.8,"ratingCount":5,"numberOfEpisodes":24,"numberOfSeasons":1,"genres":["Animazione","Commedia"],"countries":["Japan"],"facts":{"Runtime":"5m"},"keywords":[],"networks":[{"id":614,"name":"TOKYO MX","logo":"https://image.tmdb.org/t/p/original/hSdroyVthq3CynxTIIY7lnS8w1.png"}],"socialLinks":{},"cast":[{"id":1060297,"name":"Jin Katagiri","role":"Theophilus","profile":"https://image.tmdb.org/t/p/original/8iOjbaGaKeHXIlqxj2rfc1EBwbM.jpg"},{"id":1739026,"name":"Takashi Sato","role":"Professor Iwatani","profile":"https://image.tmdb.org/t/p/original/8sFPozBOF2K8D0RRkZgKsERkZP6.jpg"},{"id":1241498,"name":"Daisuke Ono","role":"Demetrios","profile":"https://image.tmdb.org/t/p/original/5rjl28lx84JjRS0hzq3Ajvx2dhp.jpg"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"en-US","title":"Extra Olympia Kyklos","overview":"Demetrios was a young man in Ancient Greece who was a potter's apprentice, but also a rather timid otaku. Despite pursuing the arts, h