{"info":{"title":"Beryl and Sapphire","originalTitle":"Xiao Lu He Xiao Lan","synopsis":"\" \"Ho trattenuto alcune parole per molto tempo — Mi piaci!\" \"Beryl & Sapphire\" è un manhua popolare creato dall'artista Ocarina. Qui sono inclusi i protagonisti con i nomi più casuali della storia — il mite Beryl (Verde) e il facilmente imbarazzante Sapphire (Blu). A volte amici intimi, altre acerrimi nemici... In questo donghua dove ogni episodio è fatto in un mondo diverso, come si incontrerebbero ancora e ancora? Solo angst? Troppo doloroso! Nient'altro che soffice? Troppo dolce! Vieni e guarda B&S, lo show dove non indovinerai mai la fine...\"","type":"series","status":"completed","statusLabel":"Finito","audio":"Cinese","dubbed":false,"releaseDateLabel":"27 Agosto 2018","year":2018,"season":"Estate 2018","studios":["Haoliners Animation League"],"genres":["Commedia","Drammatico","Gioco","Magia","Sci-Fi","Scolastico","Shounen Ai","Slice of Life"],"durationLabel":"8 min","declaredEpisodeCount":72,"availableEpisodeCount":73,"rating":6.73,"ratingCount":154,"views":49849,"poster":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/large/nx104074-ke8nzp7YOav4.jpg","shareImage":{"base":"img","path":"/copertine/B7woa.jpg"},"sourceType":"ONA","tags":["ONA","Finito","2018"],"extra":{"ids":{"anilistIds":[104074],"malIds":[38250],"anidbIds":[14373],"imdbMovieIds":[],"imdbShowIds":[],"tmdbMovieIds":[],"tmdbShowIds":[],"tvdbMovieIds":[],"tvdbShowIds":[]},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-11-02T08:43:20Z","sourceDescriptors":["anilist:104074","mal:38250"],"targets":[{"provider":"anidb","id":"14373","scope":"R","ranges":{"1-72":"1-72"}},{"provider":"anilist","id":"104074","ranges":{"1-72":"1-72"}},{"provider":"mal","id":"38250","ranges":{"1-72":"1-72"}}]},"metadataTargets":[{"provider":"anidb","id":"14373","scope":"R","raw":"anidb:14373:R","ranges":{"1-72":"1-72"}},{"provider":"anilist","id":"104074","raw":"anilist:104074","ranges":{"1-7