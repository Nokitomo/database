9267,"mal":16005},"tmdb":{"source":"tmdb-api","id":55065,"type":"tv","sourceUrl":"https://www.themoviedb.org/tv/55065","fetchedAt":"2026-11-02T19:54:03.556Z","originalLanguage":"ja-JP","title":{"value":"Unlimited Psychic Squad","language":"it-IT"},"originalTitle":"THE UNLIMITED 兵部京介","overview":{"value":"Una brezza agita i bei capelli argentati sulla testa di un giovane che indossa un'uniforme così nera che sembra essere in lutto per qualcosa. Il suo nome è Hyoubu Kyousuke. Comanda l'organizzazione criminale esper P.A.N.D.R.A. e continua a librarsi su ali nere come la mezzanotte nel cielo scuro, arrivando al punto di iniziare una rivoluzione per il bene dei suoi fratelli che condividono i suoi poteri psichici. L'eroe antagonista dell'opera originale di Shiina Takashi, Zettai Karen Children, è il protagonista della storia originale in questo nuovo anime spin-off! Combatti contro il destino del tempo stesso e libera l'infinito!","language":"it-IT"},"startDate":"2013-01-08","endDate":"2013-03-26","status":"Ended","rating":6.7,"ratingCount":14,"numberOfEpisodes":12,"numberOfSeasons":1,"genres":["Animazione","Action & Adventure","Sci-Fi & Fantasy"],"countries":["Japan"],"facts":{"Runtime":"25m"},"keywords":[],"networks":[{"id":98,"name":"TV Tokyo","logo":"https://image.tmdb.org/t/p/original/jnuO8pZNEBLEq5YaOP1f5OkmG91.png"}],"socialLinks":{},"cast":[{"id":9721,"name":"Junichi Suwabe","role":"Andy Hinomiya (voice)","profile":"https://image.tmdb.org/t/p/original/4S7c3n3r07A83HvkLrnWZGVhiHg.jpg"},{"id":555099,"name":"Koji Yusa","role":"Kyousuke Hyoubu (voice)","profile":"https://image.tmdb.org/t/p/original/vBo8dHvZvbG4kax0LcaWvrXUZuX.jpg"},{"id":221772,"name":"Wataru Hatano","role":"You Fujiura (voice)","profile":"https://image.tmdb.org/t/p/original/i1meHlOXLP2ubJZkmyGJONrxikQ.jpg"},{"id":148447,"name":"Sayaka Ohara","role":"Momiji Kanou (voice)","profile":"https://image.tmdb.org/t/p/original/4lAqrOmkOP3U9Owwijtvc8PaCDx.jpg"},{"id":1247776,"name":"Koji Ochiai","role":"Shiro