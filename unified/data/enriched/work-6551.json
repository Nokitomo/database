{"info":{"title":"Kaifeng Strange Tales: This Lord Bao is Not That Great","originalTitle":"Kai Feng Qitan: Zhege Baogong Bu Taixing","synopsis":"Dinastia dei Song Settentrionali dell'antica Cina. Una figura leggendaria emerse nella capitale Kai Feng: è il governatore Zheng Bao. I paesani lo chiamano Bao Gong (Lord Bao). In un governo corrotto, egli si distingue dimostrando estrema onestà, rettitudine, imparzialità ed ha il coraggio di difendere la giustizia, che gli è valsa il titolo di \"Giudice Bao\". Nel folklore cinese, Zheng Bao è la reincarnazione di Megrez (dio cinese della saggezza) e possiede poteri soprannaturali. \"Kai Feng Story\" racconta la leggenda del Bao Gong in un nuovo tipo di personalità.","type":"series","status":"completed","statusLabel":"Finito","audio":"Cinese","dubbed":false,"releaseDateLabel":"19 Marzo 2017","year":2017,"season":"Primavera 2017","studios":["Studio LAN","UKA"],"genres":["Azione","Commedia","Storico"],"durationLabel":"12 min","declaredEpisodeCount":9,"availableEpisodeCount":9,"rating":7.04,"ratingCount":28,"views":6108,"poster":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/large/nx103340-v9VnUAQtd3XB.png","shareImage":{"base":"img","path":"/locandine/210821.jpg"},"sourceType":"ONA","tags":["ONA","Finito","2017"],"extra":{"ids":{"anilistIds":[103340],"malIds":[36226],"anidbIds":[],"imdbMovieIds":[],"imdbShowIds":[],"tmdbMovieIds":[],"tmdbShowIds":[],"tvdbMovieIds":[],"tvdbShowIds":[]},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-11-02T08:43:20Z","sourceDescriptors":["anilist:103340","mal:36226"],"targets":[{"provider":"anilist","id":"103340","ranges":{"1-10":"1-10"}},{"provider":"mal","id":"36226","ranges":{"1-10":"1-10"}}]},"metadataTargets":[{"provider":"anilist","id":"103340","raw":"anilist:103340","ranges":{"1-10":"1-10"}},{"provider":"mal","id":"36226","raw":"mal:36226","ranges":{"1-10":"1-10"}}],"sourceIds":{"anilist":103340,"mal":36226}}},"episodes":[{"link":"34014","sourceP