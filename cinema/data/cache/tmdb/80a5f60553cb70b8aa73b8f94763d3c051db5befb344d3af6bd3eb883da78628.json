db.org/t/p/w300/ncnbpdqC8GlRI8xNVHRHvZKCekJ.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/ncnbpdqC8GlRI8xNVHRHvZKCekJ.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/61720/season/1/episode/5"},{"id":"1025607","seasonNumber":1,"episodeNumber":6,"title":{"value":"Episodio 6","language":"it-IT"},"overview":{"value":"Violetta convinces her father to let her have private piano lessons with Roberto Benvenuto \"Beto\". What Violetta doesn't tell her father is that she will be taking the lessons at Studio 21.","language":"en-US"},"airDateText":{"value":"2012-05-21","language":"it-IT"},"runtimeMinutes":45,"thumbnail":"https://image.tmdb.org/t/p/w300/hpwmZej0fZmKyBnnXtCJ2Q7O7Lt.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/hpwmZej0fZmKyBnnXtCJ2Q7O7Lt.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/61720/season/1/episode/6"},{"id":"1025608","seasonNumber":1,"episodeNumber":7,"title":{"value":"Episodio 7","language":"it-IT"},"overview":{"value":"A jealous Ludmilla tries to humiliate Violetta by convincing her there is a costume party at Studio 21.","language":"en-US"},"airDateText":{"value":"2012-05-22","language":"it-IT"},"runtimeMinutes":45,"thumbnail":"https://image.tmdb.org/t/p/w300/nrdW42iXZVVuHFh3cbRRmJO0geh.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/nrdW42iXZVVuHFh3cbRRmJO0geh.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/61720/season/1/episode/7"},{"id":"1025609","seasonNumber":1,"episodeNumber":8,"title":{"value":"Episodio 8","language":"it-IT"},"overview":{"value":"After she showed up in an angel costume, Violetta is laughed at by the Studio's students. León then brought her home. In an attempt to split Violetta and Tomás up, Ludmila edits the video from her recent conversation with Tomás.","language":"en-US"},"airDateText":{"value":"2012-05-23","language":"it-IT"},"runtimeMinutes":45,"thumbnail":"https://image.tmdb.org/t/p/w30