{"fingerprint":"4125717c0cc81df7a61d8a81d593975ba422ced2efdf4a1288aa6f2945134279","startedAt":1793995116643,"progress":{"__components":{"tvdb:artwork":{"attempts":1,"nextCheckAt":1793998716643,"status":"retry","httpStatus":null}},"wikidata:ids":{"source":"wikidata","sourceUrl":"https://www.wikidata.org/wiki/Q116817363","wikidataId":"Q116817363","tmdbId":219600,"type":"tv","imdbId":"tt22325698","tvdbId":429783},"tmdb:media":{"source":"tmdb-api","id":219600,"type":"tv","sourceUrl":"https://www.themoviedb.org/tv/219600","fetchedAt":"2026-11-06T19:59:11.119Z","originalLanguage":"ro-RO","title":{"value":"Spy/Master","language":"ro-RO"},"originalTitle":"Spy/Master","overview":{"value":"During the height of the Cold War, Victor Godeanu, the right-hand man and closest advisor to Romanian dictator Nicolae Ceaușescu, and secret agent for the KGB, must escape Romania and Ceaușescu before his cover is blown. Helped by an undercover Stasi agent and an up-and-coming CIA agent, Godeanu must elude the KGB and his own country’s spooks, fully aware that his defection is putting his family back home in mortal danger.","language":"en-US"},"tagline":{"value":"Power is a hungry animal.","language":"en-US"},"startDate":"2023-05-19","endDate":"2023-06-16","status":"Ended","rating":6.7,"ratingCount":42,"numberOfEpisodes":6,"numberOfSeasons":1,"genres":["Dramma","Action & Adventure"],"countries":["Hungary","Romania"],"facts":{"Runtime":"50m"},"keywords":[],"networks":[{"id":3186,"name":"HBO Max","logo":"https://image.tmdb.org/t/p/original/nmU0UMDJB3dRRQSTUqawzF2Od1a.png"}],"socialLinks":{},"cast":[{"id":1672241,"name":"Alec Secăreanu","role":"Victor Godeanu","profile":"https://image.tmdb.org/t/p/original/faV10C9gsWfF7E5HwKoqymhbDPb.jpg"},{"id":1561755,"name":"Svenja Jung","role":"Ingrid Von Weizendorff","profile":"https://image.tmdb.org/t/p/original/j8x2jGFNf3gDDhIKqmrgAt4S6kH.jpg"},{"id":1349720,"name":"Parker Sawyers","role":"Frank Jackson","profile":"https://image.tmdb.org/t/p/original/9YonM2rlIEV9rwGbIcX6uB8bJZW.jpg"},{"id":971726,"name":"Ana Ularu","role":"Carmen Popescu","profile":"https://image.tmdb.org/t/p/original/ZIRcuu7SEhZXBUFH8W5Yfe1r27.jpg"},{"id":47653,"name":"Aidan McArdle","role":"Walter Simpson","profile":"https://image.tmdb.org/t/p/original/u4WvfQQ89EgsRJCz4lKduO6avC7.jpg"},{"id":1075321,"name":"Nico Mirallegro","role":"John Miller","profile":"https://image.tmdb.org/t/p/original/zcrGmKeabSpL5ftVwyRBCeBxjsF.jpg"},{"id":4403309,"name":"Alexandra Bob","role":"Ileana Godeanu","profile":"https://image.tmdb.org/t/p/original/yuJJ8LEYBgwYRn5CBAiAEFHD73k.jpg"},{"id":2862877,"name":"Conor Lowson","role":"Scott Dunlop"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"en-US","overview":"During the height of the Cold War, Victor Godeanu, the right-hand man and closest advisor to Romanian dictator Nicolae Ceaușescu, and secret agent for the KGB, must escape Romania and Ceaușescu before his cover is blown. Helped by an undercover Stasi agent and an up-and-coming CIA agent, Godeanu must elude the KGB and his own country’s spooks, fully aware that his defection is putting his family back home in mortal danger.","tagline":"Power is a hungry animal."},{"language":"ro-RO","overview":"Spy/Master este plasat la apogeul Războiului Rece şi prezintă o săptămână din viaţa lui Victor Godeanu (Alec Secăreanu), mâna dreaptă a lui Nicolae Ceaușescu (Claudiu Bleonț) și cel mai important consilier al acestuia. Totuși, Godeanu are un secret: este agent dublu și trebuie să fugă din România și să scape de Ceaușescu înainte ca acoperirea lui să fie compromisă. Având doar o șansă pentru a rămâne în viață, el se folosește de o călătorie diplomatică în Germania pentru a fugi în SUA. Ajutat de o agentă Stasi sub acoperire și fostă iubită (Svenja Jung), dar și de un agent CIA (Parker Sawyers), Godeanu trebuie să evite agenții KGB și spionii propriei țări (Ana Ularu, Laurențiu Bănescu), pe deplin conștient că dezertarea îi pune soția (Andreea Vasile) și fiica (Alexandra Bob) în pericol de moarte."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/cJjwSnJjR32oPCe33USvRR8S5FA.jpg","background":"https://image.tmdb.org/t/p/original/zBHUYLQtWbr8D2TzUGSOTPoTPpW.jpg","seasons":[{"seasonNumber":1,"name":{"value":"Stagione 1","language":"it-IT"},"year":2023,"episodeCount":6,"poster":"https://image.tmdb.org/t/p/original/cJjwSnJjR32oPCe33USvRR8S5FA.jpg","posters":[],"backgrounds":[],"sourceUrl":"https://www.themoviedb.org/tv/219600/season/1"}],"schema":{}},"tmdb:inventory-v2:series":{"originalLanguage":"ro-RO","images":{"posters":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/cJjwSnJjR32oPCe33USvRR8S5FA.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/cJjwSnJjR32oPCe33USvRR8S5FA.jpg","language":"ro","width":2000,"height":3000},{"type":"poster","url":"https://image.tmdb.org/t/p/original/8lJ6vnPbpydIwU80iy0RwhuxsaE.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/8lJ6vnPbpydIwU80iy0RwhuxsaE.jpg","language":"en","width":2000,"height":3000},{"type":"poster","url":"https://image.tmdb.org/t/p/original/wD5LSVOY30yXyCgK32CJolCugul.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/wD5LSVOY30yXyCgK32CJolCugul.jpg","language":"en","width":1500,"height":2250},{"type":"poster","url":"https://image.tmdb.org/t/p/original/9zwli38MHQ4ujbOVN7VqOg6qFrL.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/9zwli38MHQ4ujbOVN7VqOg6qFrL.jpg","language":"ro","width":1500,"height":2250},{"type":"poster","url":"https://image.tmdb.org/t/p/original/5QizxiPm65YZzfsDxvknqw8HRGW.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/5QizxiPm65YZzfsDxvknqw8HRGW.jpg","language":"xx","width":2000,"height":3000},{"type":"poster","url":"https://image.tmdb.org/t/p/original/tGC8NlhVm90i6XKDcLSidZ5fqqx.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/tGC8NlhVm90i6XKDcLSidZ5fqqx.jpg","language":"ro","width":1476,"height":2197}],"backdrops":[{"type":"backdrop","url":"https://image.tm