db.org/t/p/w300/8fDNylWId04YnJMho3VSTWFT7sc.png","language":"en","width":6940,"height":934},{"type":"logo","url":"https://image.tmdb.org/t/p/original/y8sMloFALQu8FT3wvhm5gseZXNY.png","previewUrl":"https://image.tmdb.org/t/p/w300/y8sMloFALQu8FT3wvhm5gseZXNY.png","language":"en","width":6829,"height":726},{"type":"logo","url":"https://image.tmdb.org/t/p/original/sxSZAF5VdYpP7uF3RK9ffmDrYY2.png","previewUrl":"https://image.tmdb.org/t/p/w300/sxSZAF5VdYpP7uF3RK9ffmDrYY2.png","language":"en","width":6829,"height":726}]}},"tmdb:layout-v2":[{"seasonNumber":1,"name":{"value":"Stagione 1","language":"it-IT"},"overview":{"value":"Jason Dessen, fisico, professore e padre di famiglia, viene catapultato in una versione alternativa della sua vita. Lo stupore si trasforma rapidamente in un incubo quando cerca di tornare alla sua realtà, in mezzo a un panorama sconcertante fatto di vite che avrebbe potuto vivere.","language":"it-IT"},"year":2024,"episodeCount":9,"poster":"https://image.tmdb.org/t/p/original/c6MRUtPk0nEPQ9FBD9RdRKt2rIm.jpg","posters":[],"backgrounds":[],"sourceUrl":"https://www.themoviedb.org/tv/196322/season/1"},{"seasonNumber":2,"name":{"value":"Stagione 2","language":"it-IT"},"overview":{"value":"Nella seconda stagione, la famiglia Dessen si gode una vita tranquilla in un mondo che sembra finalmente sicuro, finché l’inimmaginabile li costringe a fuggire ancora una volta. Mentre l’ossessione di Jason per la Scatola si fa sempre più intensa, la crescente paranoia di Daniela la spinge al limite, minacciando di distruggere la loro fragile stabilità. Nel frattempo, Amanda e Ryan uniscono le forze in un tentativo disperato di ritrovare la strada di casa. Con Blair determinata a fermarlo, Leighton insegue senza sosta la sua grande visione di creare un mondo perfetto.","language":"it-IT"},"year":2026,"episodeCount":10,"poster":"https://image.tmdb.org/t/p/original/2DPmTlv8F0V1TQBPmlsGOVOhtWk.jpg","posters":[],"backgrounds":[],"sourceUrl":"https://www.themoviedb.org/tv/196322/season/2"}]}}
