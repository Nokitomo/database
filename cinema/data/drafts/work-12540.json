apher he had to transmit Morse signals with sunlight. His life would be profoundly changed by his encounter with a young illiterate man, with the enemy, and with a series of individuals from various parts of Italy."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/vkVtSisfyX7ZSpyGu2UmsDPXjzR.jpg","background":"https://image.tmdb.org/t/p/original/vFIcRu3SdXV5eOwJK93ZkRqhehG.jpg","seasons":[],"schema":{}},"tmdb:inventory-v2:series":{"originalLanguage":"it-IT","images":{"posters":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/vkVtSisfyX7ZSpyGu2UmsDPXjzR.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/vkVtSisfyX7ZSpyGu2UmsDPXjzR.jpg","language":"it","width":1000,"height":1500},{"type":"poster","url":"https://image.tmdb.org/t/p/original/6j2IV6800oDnK19E5ydbrExUNDg.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/6j2IV6800oDnK19E5ydbrExUNDg.jpg","language":"xx","width":1024,"height":1462},{"type":"poster","url":"https://image.tmdb.org/t/p/original/jNL92Gt9eqXq7tnWv0BYwNLd0nm.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/jNL92Gt9eqXq7tnWv0BYwNLd0nm.jpg","language":"it","width":1400,"height":2100}],"backdrops":[{"type":"backdrop","url":"https://image.tmdb.org/t/p/original/yduEDzLNQTNTCr7lkYPV9tnLI6b.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/yduEDzLNQTNTCr7lkYPV9tnLI6b.jpg","language":"it","width":1280,"height":720},{"type":"backdrop","url":"https://image.tmdb.org/t/p/original/vFIcRu3SdXV5eOwJK93ZkRqhehG.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/vFIcRu3SdXV5eOwJK93ZkRqhehG.jpg","language":"xx","width":1280,"height":720}],"logos":[{"type":"logo","url":"https://image.tmdb.org/t/p/original/osrgjcLfjOJn2P7B6yR9DrFUbgW.png","previewUrl":"https://image.tmdb.org/t/p/w300/osrgjcLfjOJn2P7B6yR9DrFUbgW.png","language":"it","width":1633,"height":678}]}},"tmdb:artwork":{"schemaVersion":1,"source":"tmdb","id":333891,"type":"movie","originalLanguage":"it-IT","series":{"poster":{"it":{"status":"availa