味原产地·潮汕》为该纪录片系列的第一部，将通过短片每集发掘一种“养在深闺人不识”的潮汕独特食材、食品和味道。在潮汕地区，食物有着明显的地域标记，从潮汕物食中可以清晰地看到潮汕人的迁徙、生根和繁衍，看到潮汕人身上独特的性格特点和精神。"}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/f8mJE43IpCzyKDsgJSULYlVKR2z.jpg","background":"https://image.tmdb.org/t/p/original/suthwX2CEwsEy8sI6OtGxdGfn4Y.jpg","seasons":[{"seasonNumber":1,"name":{"value":"Stagione 1","language":"it-IT"},"year":2019,"episodeCount":20,"poster":"https://image.tmdb.org/t/p/original/cNKOYARfeI0tVbz9ZyG6IiuYmxz.jpg","posters":[],"backgrounds":[],"sourceUrl":"https://www.themoviedb.org/tv/86742/season/1"},{"seasonNumber":2,"name":{"value":"Stagione 2","language":"it-IT"},"year":2019,"episodeCount":10,"poster":"https://image.tmdb.org/t/p/original/ijYaoKtjjMOZMfr2omJc5fQC9Kt.jpg","posters":[],"backgrounds":[],"sourceUrl":"https://www.themoviedb.org/tv/86742/season/2"},{"seasonNumber":3,"name":{"value":"La cucina del Gansu","language":"it-IT"},"year":2020,"episodeCount":10,"poster":"https://image.tmdb.org/t/p/original/wMX4aAhAUs7dvGvY3O7XsolL3Cs.jpg","posters":[],"backgrounds":[],"sourceUrl":"https://www.themoviedb.org/tv/86742/season/3"},{"seasonNumber":4,"name":{"value":"Stagione 4","language":"it-IT"},"year":2021,"episodeCount":10,"poster":"https://image.tmdb.org/t/p/original/2DrpW7LyFm5bwCaNMlBfo9w1NO5.jpg","posters":[],"backgrounds":[],"sourceUrl":"https://www.themoviedb.org/tv/86742/season/4"},{"seasonNumber":5,"name":{"value":"Stagione 5","language":"it-IT"},"year":2023,"episodeCount":10,"poster":"https://image.tmdb.org/t/p/original/zkAHidz52RyBlxbUseGkaD3L8Ny.jpg","posters":[],"backgrounds":[],"sourceUrl":"https://www.themoviedb.org/tv/86742/season/5"}],"schema":{}},"tmdb:inventory-v2:series":{"originalLanguage":"zh-CN","images":{"posters":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/xgoiOgmQ0zi3Eq5q3FxxGy8gBbF.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/xgoiOgmQ0zi3Eq5q3FxxGy8gBbF.jpg","language":"en","width":500,"height":774},{"type":"poste