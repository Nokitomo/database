{"fingerprint":"53f1486d0e759e366f961c7f6097da458e58bd1b8c2e12f996f5ef69e5541737","startedAt":1794082025695,"progress":{"__components":{"wikidata:ids":{"attempts":1,"nextCheckAt":1794085625695,"status":"retry","httpStatus":null}},"tmdb:media":{"source":"tmdb-api","id":84644,"type":"movie","sourceUrl":"https://www.themoviedb.org/movie/84644","fetchedAt":"2026-11-07T20:09:03.638Z","originalLanguage":"fr-FR","title":{"value":"The Cousin","language":"en-US"},"originalTitle":"Le Cousin","overview":{"value":"Nounours is the nickname of a \"cousin\" an informer with a special arrangement with the police: he gets 10% of the drugs seized thanks to his help. When his personal contact, inspector Maurin, commits suicide, inspector Gérard Delvaux takes over. Meanwhile, judge Lambert is uncovering the illegal practices of the policemen. Her persistent investigations, which had cornered Maurin, are leading to Gérard, and also to Nounours as the source of heroin that led to recent cases of deadly overdoses. Nounours promises Gérard increasingly bigger catches which he is intent on realising before he is forced to reveal who Nounours is to judge Lambert.","language":"en-US"},"releaseDate":"1997-12-10","status":"Released","rating":6.3,"ratingCount":68,"genres":["Crime"],"countries":["France"],"facts":{"Runtime":"112m"},"keywords":[],"networks":[],"socialLinks":{},"cast":[{"id":41526,"name":"Patrick Timsit","role":"Nounours","profile":"https://image.tmdb.org/t/p/original/lS22SWFT4jo4mgfC0HsbgMstPf2.jpg"},{"id":4275,"name":"Alain Chabat","role":"Gérard Delvaux","profile":"https://image.tmdb.org/t/p/original/xRjymE6LIJd0useKWN2R1WgKDRy.jpg"},{"id":49025,"name":"Samuel Le Bihan","role":"Francis","profile":"https://image.tmdb.org/t/p/original/jN4hwWfhFaE8v5TGiS6cg9HKOxe.jpg"},{"id":76967,"name":"Caroline Proust","role":"Fanny","profile":"https://image.tmdb.org/t/p/original/5cTUI6EGnpnBqe3dyNQouLM5aIz.jpg"},{"id":35217,"name":"Mehdi El Glaoui","role":"Jeannot","profile":"https://image.tmdb.org/t/p/original/bHG4xvf7WpHn4MIuSZvSsb6oBHx.jpg"},{"id":881562,"name":"Christophe Peyroux","role":"Michel","profile":"https://image.tmdb.org/t/p/original/67G4W75xhxG2X3LnfTsbcmbQaZO.jpg"},{"id":39689,"name":"Marie Trintignant","role":"Judge Lambert","profile":"https://image.tmdb.org/t/p/original/7jgksCx4EcrZsDmPfPzAZkriya8.jpg"},{"id":28279,"name":"Agnès Jaoui","role":"Claudine Delvaux","profile":"https://image.tmdb.org/t/p/original/8QORX3JozZ9eyHN4VyXPqWza9qV.jpg"},{"id":28679,"name":"Béatrice Michel","role":"Woman of the couple at the Ebony Club","profile":"https://image.tmdb.org/t/p/original/ns1ow4AU9nBOUG4lduTEDN4FV6W.jpg"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"en-US","title":"The Cousin","overview":"Nounours is the nickname of a \"cousin\" an informer with a special arrangement with the police: he gets 10% of the drugs seized thanks to his help. When his personal contact, inspector Maurin, commits suicide, inspector Gérard Delvaux takes over. Meanwhile, judge Lambert is uncovering the illegal practices of the policemen. Her persistent investigations, which had cornered Maurin, are leading to Gérard, and also to Nounours as the source of heroin that led to recent cases of deadly overdoses. Nounours promises Gérard increasingly bigger catches which he is intent on realising before he is forced to reveal who Nounours is to judge Lambert."},{"language":"fr-FR","overview":"Un flic ne peut être bon s’il n’a pas un cousin. Partant de ce postulat, Delvaux cherche, même en s’arrangeant avec la loi, à garder Nounours, son indic, avec lequel il a fini par entretenir de bons rapports."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/yzqzpOelUkcpChoo3g4tDlet1PF.jpg","background":"https://image.tmdb.org/t/p/original/gOXSTrLUItkw1ke8ZRZY9cQN1p3.jpg","seasons":[],"schema":{}},"tmdb:inventory-v2:series":{"originalLanguage":"fr-FR","images":{"posters":[{"type":"poster","url":