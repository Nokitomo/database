ogo"}}}}},"externalMedia":{"tmdb":{"source":"tmdb-api","id":72615,"type":"tv","sourceUrl":"https://www.themoviedb.org/tv/72615","fetchedAt":"2026-11-14T17:14:29.784Z","originalLanguage":"en-US","title":{"value":"L'altra Grace","language":"it-IT"},"originalTitle":"Alias Grace","overview":{"value":"Nel Canada dell'800, uno psichiatra si trova a valutare se un'assassina deve essere assolta per infermità mentale in questa storia tratta dal romanzo di Margaret Atwood.","language":"it-IT"},"tagline":{"value":"Adattamento di Sarah Polley del cupo libro della Atwood che s'ispira a una storia vera. Regia di Mary Harron.","language":"it-IT"},"startDate":"2017-09-25","endDate":"2017-10-30","status":"Ended","rating":7.215,"ratingCount":384,"numberOfEpisodes":6,"numberOfSeasons":1,"genres":["Crime","Dramma"],"countries":["Canada","United States of America"],"facts":{"Runtime":"46m"},"keywords":[],"networks":[{"id":23,"name":"CBC Television","logo":"https://image.tmdb.org/t/p/original/zjgqkIvBURbwoHbHhmnzaTFyZgR.png"}],"socialLinks":{},"cast":[{"id":190895,"name":"Sarah Gadon","role":"Grace Marks","profile":"https://image.tmdb.org/t/p/original/sWBMkqjRiszNrvaLE2SSedG9szT.jpg"},{"id":1322314,"name":"Edward Holcroft","role":"Dr. Simon Jordan","profile":"https://image.tmdb.org/t/p/original/hLsZyePiRMTrqlHalPh8f5dLRIE.jpg"},{"id":1477962,"name":"Rebecca Liddiard","role":"Mary Whitney","profile":"https://image.tmdb.org/t/p/original/dfwY1zEow2VD51cK5J5XZmN0GnS.jpg"},{"id":69899,"name":"Zachary Levi","role":"Jeremiah Pontelli","profile":"https://image.tmdb.org/t/p/original/1W8L3kEMMPF9umT3ZGaNIiCYKfZ.jpg"},{"id":1864983,"name":"Kerr Logan","role":"James McDermott","profile":"https://image.tmdb.org/t/p/original/ksjtfChbfbgfmo4QWCfeuBYc4kT.jpg"},{"id":224,"name":"David Cronenberg","role":"Reverend Verrenger","profile":"https://image.tmdb.org/t/p/original/3xh4e2gWHDilMLtucHzDGsmJMuQ.jpg"},{"id":84021,"name":"Paul Gross","role":"Thomas Kinnear","profile":"https://image.tmdb.org/t/p/original/fqpHv6pMb7OnAB6PKSMX23Pvrzi.jpg"},{"id":10690,"name":"Anna Paquin","role":"Nancy Montgomery","profile":"https://image.tmdb.org/t/p/original/5FjBCsn3kujldP8LizoCrc3hsHp.jpg"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","title":"L'altra Grace","overview":"Nel Canada dell'800, uno psichiatra si trova a valutare se un'assassina deve essere assolta per infermità mentale in questa storia tratta dal romanzo di Margaret Atwood.","tagline":"Adattamento di Sarah Polley del cupo libro della Atwood che s'ispira a una storia vera. Regia di Mary Harron."},{"language":"en-US","overview":"Based on the true story of Grace Marks, a housemaid and immigrant from Ireland who was imprisoned in 1843, perhaps wrongly, for the murder of her employer Thomas Kinnear. Grace claims to have no memory of the murder yet the facts are irrefutable. A decade after, Dr. Simon Jordan tries to help Grace recall her past."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/bZfy00f4brEcl7Z352EzuSwrRHD.jpg","background":"https://image.tmdb.org/t/p/original/870FbfjWlt98dcSarTbYH0X0tje.jpg","seasons":[{"seasonNumber":1,"name":{"value":"Stagione 1","language":"it-IT"},"overview":{"value":"Grace Marks è una giovane domestica irlandese di umili origini emigrata nell'Alto Canada che, insieme con lo stalliere James McDermott, si ritrova accusata e condannata per il famigerato doppio omicidio del suo datore di lavoro, il ricco fattore Thomas Kinnear, e della governante Nancy Montgomery, avvenuto nel 1843. Diventata una delle donne più note ed enigmatiche nel Canada dell'epoca, la storia di Grace apre un dibattito sulla possibilità che abbia realmente contribuito agli assassinii o ne sia stata coinvolta solo inconsapevolmente.","language":"it-IT"},"year":2017,"episodeCount":6,"poster":"https://image.tmdb.org/t/p/original/m6ChYjCPMpzAPzR7jm0omLbu9hS.jpg","posters":[],"backgrounds":[],"sourceUrl":"https://www.themovi