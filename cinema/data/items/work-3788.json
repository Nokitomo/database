9tKcVgM53VRW11dZZuHbK7l.jpg"},{"id":1829639,"name":"Etienne Beurier","role":"The Mayor's driver"},{"id":2766304,"name":"Olivier Borle","role":"An advisor","profile":"https://image.tmdb.org/t/p/original/7m6w4V4p6vDOQna12UDJnkoLfKa.jpg"},{"id":1808482,"name":"Pierre-Benoist Varoclier","role":"The debate leader","profile":"https://image.tmdb.org/t/p/original/1ogV7gn2M3nNzJMt4xMWN7TAMH4.jpg"},{"id":1372040,"name":"Eric Soubelet","role":"A professor","profile":"https://image.tmdb.org/t/p/original/v3PTLzfHsgXzwAvIOyWaScYtij9.jpg"},{"id":1620400,"name":"Carinne Koeppel","role":"An active woman","profile":"https://image.tmdb.org/t/p/original/q9N5GHmWbwvsdSQHzFMsQjIU9ey.jpg"},{"id":1417367,"name":"Sébastien Autret","role":"An advisor","profile":"https://image.tmdb.org/t/p/original/yRpz3HvkfVPfBPIz0ObRUYn4yC5.jpg"},{"id":2561978,"name":"Pierre Cuq","role":"Yvan","profile":"https://image.tmdb.org/t/p/original/2L9SRY1RHqKNZ0Hvx7zmw1NHQl7.jpg"},{"id":2229289,"name":"Franck Fargier","role":"An advisor","profile":"https://image.tmdb.org/t/p/original/v1ZI0ewnLKx5rMUnvTWwjnGX2Hm.jpg"},{"id":3662679,"name":"Nadia Larbiouene","role":"Une femme voilée","profile":"https://image.tmdb.org/t/p/original/kHDCcfKmuywTCFe8Id52Pgs6UK6.jpg"},{"id":38919,"name":"Tatiana Vialle","role":"L'ex femme de Théraneau","profile":"https://image.tmdb.org/t/p/original/at3VSfksxHXdpNQ9GJFuxw2JAYB.jpg"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","title":"Alice e il sindaco","overview":"Paul Théraneau, il sindaco di Lione, si trova in una situazione delicata. Dopo trent'anni in politica, è a corto di idee e attraversa una fase di vuoto esistenziale. Per uscire dall'impasse, assume Alice Heimann, una giovane e brillante filosofa. Dalle personalità diametralmente opposte, i due finiranno per rimettere in discussione le reciproche certezze.","tagline":"Lui non aveva più idee... poi è arrivata Alice"},{"language":"en-US","title":"Alice and the Mayor","overview":"The mayor of Lyon, Paul Théraneau, is in a delicate position. After 30 years in politics, he is running out of ideas and is faced with a feeling of existential emptiness. To overcome this, Paul hires a young and brilliant philosopher, Alice Heimann. Then follows a dialogue between two diametrically opposed personalities who will turn their certainties upside down."},{"language":"fr-FR","overview":"Le maire de Lyon, qui est au bout du rouleau. Il n'a plus une seule idée. Après trente ans de vie politique, il se sent complètement vide. Pour remédier à ce problème, ses équipes décident de lui adjoindre une jeune et brillante philosophe… Un dialogue se noue, qui rapproche Alice et le maire et ébranle leurs certitudes. Peu à peu, une question se pose : la pensée et la pratique politique sont-elles compatibles ?"}],"images":{"logos":[{"type":"logo","url":"https://image.tmdb.org/t/p/original/bLTqToiUVEaFxfwiZzgG10xNufN.png","previewUrl":"https://image.tmdb.org/t/p/w300/bLTqToiUVEaFxfwiZzgG10xNufN.png","language":"fr","width":782,"height":74},{"type":"logo","url":"https://image.tmdb.org/t/p/original/mLedW61UqgFP6cyCLZYJdO9ztB8.png","previewUrl":"https://image.tmdb.org/t/p/w300/mLedW61UqgFP6cyCLZYJdO9ztB8.png","language":"fr","width":2276,"height":199}],"posters":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/ttnrBKYHX3BJDhtiUzVzVRcgk5k.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/ttnrBKYHX3BJDhtiUzVzVRcgk5k.jpg","language":"it","width":2000,"height":3000},{"type":"poster","url":"https://image.tmdb.org/t/p/original/4EbzkwSILwBR0qotbUXh8P5sxsY.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/4EbzkwSILwBR0qotbUXh8P5sxsY.jpg","language":"it","width":2000,"height":3000},{"type":"poster","url":"https://image.tmdb.org/t/p/original/i6dlspGA6PS7eM2lOj4BMY65ndS.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/i6dlspGA6PS7eM2lOj4BMY65ndS.jpg","language":"en","width":2000,"height":3000},{"type":"poster","url":"https://image.tmdb.org/t/p/original/O7vbzSGmP7nl0m