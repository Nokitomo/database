":"streamingunity"}],"episodeMappingUncertain":false,"seasons":[{"number":1,"episodes":[{"number":1,"title":"Kodoku","synopsis":"Non potendo provvedere alla sua famiglia malata, Shujiro, un samurai del moderno periodo Meiji, partecipa a un pericoloso torneo che promette un ingente premio in denaro.","thumbnail":{"base":"streamingunity:images","path":"/images/28d2fb0e-d607-4105-ad3e-39e110c84d71.webp"},"metadataSources":{"streamingunity:37678":{"title":"Kodoku","synopsis":"Non potendo provvedere alla sua famiglia malata, Shujiro, un samurai del moderno periodo Meiji, partecipa a un pericoloso torneo che promette un ingente premio in denaro.","thumbnail":{"base":"streamingunity:images","path":"/images/28d2fb0e-d607-4105-ad3e-39e110c84d71.webp"}}}},{"number":2,"title":"Risveglio","synopsis":"Kyojin, un ex ninja, propone un'alleanza con Shujiro e Futaba. Intanto un alto funzionario governativo teme una possibile rivolta dei samurai.","thumbnail":{"base":"streamingunity:images","path":"/images/f106a5b0-9ce6-41a9-b1d5-752d082b3a6b.webp"},"metadataSources":{"streamingunity:37678":{"title":"Risveglio","synopsis":"Kyojin, un ex ninja, propone un'alleanza con Shujiro e Futaba. Intanto un alto funzionario governativo teme una possibile rivolta dei samurai.","thumbnail":{"base":"streamingunity:images","path":"/images/f106a5b0-9ce6-41a9-b1d5-752d082b3a6b.webp"}}}},{"number":3,"title":"Destino","synopsis":"Gli organizzatori scommettono su chi arriverà per primo alla tappa successiva. Shujiro racconta il suo passato a Futaba, poi ritrova la sorella che non vedeva da tempo.","thumbnail":{"base":"streamingunity:images","path":"/images/bab1bbb0-949e-4f0e-b5db-688e1a654191.webp"},"metadataSources":{"streamingunity:37678":{"title":"Destino","synopsis":"Gli organizzatori scommettono su chi arriverà per primo alla tappa successiva. Shujiro racconta il suo passato a Futaba, poi ritrova la sorella che non vedeva da tempo.","thumbnail":{"base":"streamingunity:images","path":"/images/bab1bbb