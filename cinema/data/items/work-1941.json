DgxwuKkjJkfmX.png","language":"it","width":751,"height":535},"candidates":[{"type":"logo","url":"https://image.tmdb.org/t/p/original/7gj2bDrYT0XX6xDgxwuKkjJkfmX.png","previewUrl":"https://image.tmdb.org/t/p/w300/7gj2bDrYT0XX6xDgxwuKkjJkfmX.png","language":"it","width":751,"height":535}]},"en":{"status":"missing","candidates":[]},"xx":{"status":"missing","candidates":[]}}},"seasons":{}},"tvdb":{"schemaVersion":1,"source":"tvdb","id":13664,"mediaType":"movie","series":{"source":"tvdb-web","sourceUrl":"https://www.thetvdb.com/movies/natale-da-chef","tvdbId":13664,"mediaType":"movie","tvdbMovieId":13664,"title":"Natale da chef","originalLanguage":"it","poster":"https://artworks.thetvdb.com/banners/movies/13664/posters/13664.jpg"},"seasons":{}}},"externalMedia":{"tmdb":{"source":"tmdb-api","id":487562,"type":"movie","sourceUrl":"https://www.themoviedb.org/movie/487562","fetchedAt":"2026-11-06T10:36:42.993Z","originalLanguage":"it-IT","title":{"value":"Natale da chef","language":"it-IT"},"originalTitle":"Natale da chef","overview":{"value":"Gualtiero Saporito è un grande chef... ma solo nella sua testa! Infatti con i suoi arditi mix di ingredienti, cucina solo schifezze! Gualtiero però non demorde e insiste a proporre la sua cucina in ogni occasione, ricevendo solo insulti e porte in faccia. Ma la sua tenacia, un giorno, viene premiata. Sarà il Natale alle porte? Furio Galli, proprietario di una famosissima ditta di catering, gli offre il posto di capo cuoco nella brigata che parteciperà alla gara d'appalto indetta per \"sfamare\" il prossimo G7. Finalmente il sogno diventa realtà! Ma il disegno di Furio ovviamente è losco. Per salvare la sua azienda sul\"orlo della bancarotta infatti, ha promesso al suo avversario di lasciarlo vincere in cambio di un \"cospicuo regalo\". Gualtiero si troverà così alle prese con un aiuto cuoco che non sente i sapori, un sommelier astemio e una pasticcera che esce dalle torte... anziché prepararle! Tra scambi di persona, di piatto e \"dissapori\" il mal di pancia è garantito... dalle risate!","language":"it-IT"},"releaseDate":"2017-12-14","status":"Released","rating":5.1,"ratingCount":179,"genres":["Commedia"],"countries":["Italy"],"facts":{"Runtime":"97m"},"keywords":[],"networks":[],"socialLinks":{},"cast":[{"id":69037,"name":"Massimo Boldi","role":"Gualtiero Saporito","profile":"https://image.tmdb.org/t/p/original/qFixq8McPG8E3JN7hN6G8FWEjGa.jpg"},{"id":138721,"name":"Dario Bandiera","role":"Filippo Tosti","profile":"https://image.tmdb.org/t/p/original/maywdHPWiRMSPHW1HC59ZYaJsT7.jpg"},{"id":1623194,"name":"Rocío Muñoz Morales","role":"Perla","profile":"https://image.tmdb.org/t/p/original/ffDnjk9ZvHyZnV2srln6A2hMWBj.jpg"},{"id":1030690,"name":"Paolo Conticini","role":"Felice Becco","profile":"https://image.tmdb.org/t/p/original/t1dpr7qWOddmmVHDEwqLSTiqLx7.jpg"},{"id":120138,"name":"Francesca Chillemi","role":"Laura Micheletti","profile":"https://image.tmdb.org/t/p/original/kQ3DBqxDDC1GVIeOzIzq7I7cj6D.jpg"},{"id":130877,"name":"Enzo Salvi","role":"Mario Linatucci","profile":"https://image.tmdb.org/t/p/original/AsIrWxVVLrK8l4fey8tLr4bxPU.jpg"},{"id":2201062,"name":"Barbara Foria","role":"Beata","profile":"https://image.tmdb.org/t/p/original/yiFYqwHk5B7XoAzGZpB34JdAU9K.jpg"},{"id":141114,"name":"Maurizio Casagrande","role":"Furio Galli","profile":"https://image.tmdb.org/t/p/original/ZOP0XzKfLIVvJy2uUckykQC8OP.jpg"},{"id":44104,"name":"Milena Vukotić","role":"Lina Renghi","profile":"https://image.tmdb.org/t/p/original/k4dsiarmq3s5kryz7MxSIQcrPRR.jpg"},{"id":1534903,"name":"Loredana De Nardis","role":"Caterina","profile":"https://image.tmdb.org/t/p/original/l7OvQQm0fuamopaLTOcafY4b957.jpg"},{"id":2501974,"name":"Rishad Noorani","role":"Ragù","profile":"https://image.tmdb.org/t/p/original/vmjP52tLA12ITlXeWWgEyU1rFvo.jpg"},{"id":129649,"name":"Massimo De Lorenzo","role":"Gentiletti","profile":"https://image.tmdb.org/t/p/original/coFLDs22kQr81MphsePilpLADoe.jpg"},{"id":1385591,"name":"Fabrizio Buompastore","role":"Nicola","profile":"https://image.tmdb.org/t/p/original/uJdoemETi8C2aerFmJck16PYVXs.jpg"},{"id":1875898,"name":"Jacopo Sarno","role":"Lorenzo","profile":"https://image.tmdb.org/t/p/original/xN6zktQl8C7PeLsDh8E0RRy58Bd.jpg"},{"id":92094,"name":"Paolo De Vita","role":"Sudato","profile":"https://image.tmdb.org/t/p/original/cNMP0Dkl8WMZBbtcXJzIf4pk8D7.jpg"},{"id":2501980,"name":"Gianfranco Vissani","role":"Self","profile":"https://image.tmdb.org/t/p/original/6rqzhX11pPgHVHY9u9j1cnmzjvH.jpg"},{"id":66815,"name":"Armando De Razza","role":"Maestro di cerimonie","profile":"https://image.tmdb.org/t/p/original/cc6jUaH7fTfcqASSmARdDUb0RaL.jpg"},{"id":119354,"name":"Luis Molteni","role":"Ubaldo Cerri"},{"id":141111,"name":"Biagio Izzo","role":"Tony Cacace","profile":"https://image.tmdb.org/t/p/original/tWdLTzbn895Yq8yiTNyW6FKVYYx.jpg"},{"id":3816133,"name":"Denis Fontanari","role":"Trasportatore"},{"id":2702335,"name":"Barbara Gioli","role":"Cameriera al piano","profile":"https://image.tmdb.org/t/p/original/4A7wUBNAVSuqadyRua6OR186ahV.jpg"},{"id":2501981,"name":"Eleonora Martini","role":"Cliente hotel"},{"id":128754,"name":"Diego Pagotto","role":"Portiere di notte","profile":"https://image.tmdb.org/t/p/original/ua1jgVh15RDK2CLpTe1m8XdtQMd.jpg"},{"id":1192145,"name":"Sylvia Panacione","role":"Flavia","profile":"https://image.tmdb.org/t/p/original/bzEWWgTQWHTn7zLruqG7d3rYY9X.jpg"},{"id":3816137,"name":"Tushar","role":"Chintan"},{"id":1851042,"name":"Erica Zambelli","role":"Receptionist","profile":"https://image.tmdb.org/t/p/original/bX1LqsS7B4E4RC9aljIziJlX6U6.jpg"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","title":"Natale da chef","overview":"Gualtiero Saporito è un grande chef... ma solo nella sua testa! Infatti con i suoi arditi mix di ingredienti, cucina solo schifezze! Gualtiero però non demorde e insiste a proporre la sua cucina in ogni occasione, ricevendo solo insulti e porte in faccia. Ma la sua tenacia, un giorno, viene premiata. Sarà il Natale alle porte? Furio Galli, proprietario di una famosissima ditta di catering, gli offre il posto di capo cuoco nella brigata che parteciperà alla gara d'appalto indetta per \"sfamare\" il prossimo G7. Finalmente il sogno diventa realtà! Ma il disegno di Furio ovviamente è losco. Per salvare la sua azienda sul\"orlo della bancarotta infatti, ha promesso al suo avversario di lasciarlo vincere in cambio di un \"cospicuo regalo\". Gualtiero si troverà così alle prese con un aiuto cuoco che non sente i sapori, un sommelier astemio e una pasticcera che esce dalle torte... anziché prepararle! Tra scambi di persona, di piatto e \"dissapori\" il mal di pancia è garantito... dalle risate!"},{"language":"en-US","overview":"A bizarre group consisting of a refined chef with unusual recipes, an assistant cook with taste disturbances and an improvised pastry chef takes part in a competition between chefs to win the contract for the G7."}],"images":{"logos":[{"type":"logo","url":"https://image.tmdb.org/t/p/original/7gj2bDrYT0XX6xDgxwuKkjJkfmX.png","previewUrl":"https://image.tmdb.org/t/p/w300/7gj2bDrYT0XX6xDgxwuKkjJkfmX.png","language":"it","width":751,"height":535}],"posters":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/sRlKlHrozyhdwDGc26tV7uKUXNA.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/sRlKlHrozyhdwDGc26tV7uKUXNA.jpg","language":"it","width":699,"height":1000},{"type":"poster","url":"https://image.tmdb.org/t/p/original/60psKQ3kOsMladtW7yQw9Zz3NM.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/60psKQ3kOsMladtW7yQw9Zz3NM.jpg","language":"en","width":1247,"height":1870},{"type":"poster","url":"https://image.tmdb.org/t/p/original/wKTsUGw9pNyvrxGztj66bkcDO32.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/wKTsUGw9pNyvrxGztj66bkcDO32.jpg","language":"xx","width":699,"height":1000}],"backdrops":[{"type":"backdrop","url":"https://image.tmdb.org/t/p/original/5VtFfvbLK3IvZS5GqXjs6YiduKA.jpg","previewUrl":"https://image.