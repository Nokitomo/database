:"tvdb","id":332655,"mediaType":"movie","series":{"source":"tvdb-web","sourceUrl":"https://www.thetvdb.com/movies/flukten-over-grensen","tvdbId":332655,"mediaType":"movie","tvdbMovieId":332655,"title":"Flukten over grensen","originalLanguage":"Norwegian"},"seasons":{}}},"externalMedia":{"tmdb":{"source":"tmdb-api","id":646106,"type":"movie","sourceUrl":"https://www.themoviedb.org/movie/646106","fetchedAt":"2026-11-14T02:53:33.538Z","originalLanguage":"no-NO","title":{"value":"The Crossing - Oltre il confine","language":"it-IT"},"originalTitle":"Flukten over grensen","overview":{"value":"Norvegia, dicembre 1942. Sarah e Daniel, due fratellini ebrei, vengono aiutati a fuggire in Svezia da Gerda e Otto, che li trovano nello scantinato di casa.","language":"it-IT"},"tagline":{"value":"Finalmente un film sulla guerra per tutta la famiglia!","language":"it-IT"},"releaseDate":"2020-02-14","status":"Released","rating":6.2,"ratingCount":48,"genres":["Famiglia","Guerra","Thriller"],"countries":["Norway"],"facts":{"Runtime":"96m"},"keywords":[],"networks":[],"socialLinks":{},"cast":[{"id":2451933,"name":"Anna Sofie Skarholt","role":"Gerda"},{"id":2451934,"name":"Bo Lindquist-Ellingsen","role":"Otto"},{"id":2451935,"name":"Samson Steine","role":"Daniel","profile":"https://image.tmdb.org/t/p/original/k5DFXLIAFlA8okenWBlyNuWwitz.jpg"},{"id":2451936,"name":"Bianca Ghilardi-Hellesten","role":"Sarah"},{"id":2671779,"name":"Henrik Siger Woldene","role":"Per","profile":"https://image.tmdb.org/t/p/original/hRpUSYwAxNFXzpnw4yrIb0bkk0Q.jpg"},{"id":2303351,"name":"Luke Neite","role":"Herman"},{"id":2002964,"name":"Julius Robin Weigel","role":"Hans"},{"id":73552,"name":"Kari Simonsen","role":"Wilhelmine","profile":"https://image.tmdb.org/t/p/original/6rMV5Aq3voOcmAdo6MGNn2BFqJj.jpg"},{"id":1989208,"name":"Morten Svartveit","role":"Egil","profile":"https://image.tmdb.org/t/p/original/d6OuyyT784UVwAM4bGY3ON6GbDJ.jpg"},{"id":1479740,"name":"Thea Borring Lande","role":"Agathe"},{"id":563063,"name":"Silje Breivik","role":"Vigdis","profile":"https://image.tmdb.org/t/p/original/1YF8671oiTta70aOgAOZo0Qibcx.jpg"},{"id":139935,"name":"Frode Winther","role":"Dypvik","profile":"https://image.tmdb.org/t/p/original/drYutVU7qAcN1BSFdhIc83FAQrV.jpg"},{"id":107357,"name":"Svein Roger Karlsen","role":"Konduktør","profile":"https://image.tmdb.org/t/p/original/9TVxpCpYUl4m4djfN0lUMqG4Jj0.jpg"},{"id":2209178,"name":"Jonas Kippersund","role":"Grev Svartblod"},{"id":76612,"name":"Trond Høvik","role":"Lensmannen","profile":"https://image.tmdb.org/t/p/original/6S6IMcRUF5J23EoF2sk2V9k2eEA.jpg"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","title":"The Crossing - Oltre il confine","overview":"Norvegia, dicembre 1942. Sarah e Daniel, due fratellini ebrei, vengono aiutati a fuggire in Svezia da Gerda e Otto, che li trovano nello scantinato di casa.","tagline":"Finalmente un film sulla guerra per tutta la famiglia!"},{"language":"en-US","title":"The Crossing","overview":"One day, just before Christmas in 1942, Gerda's and Otto's parents are arrested for being part of the Norwegian resistance movement during the  Second World War, leaving the siblings on their own. Following the arrest, they discover two Jewish children, Sarah and Daniel, hidden in a secret cupboard in their basement at home. It is now up to Gerda and Otto to finish what their parents started: To help Sarah and Daniel flee from the Nazis cross the border to neutral Sweden and reunite them with their parents.","tagline":"Finally there's a film about the war for the entire family!"},{"language":"no-NO","overview":"Det er desember 1942, og fire barn er på flukt. Sarah og Daniel er jøder og skal sendes ut av landet. De har gjemt seg i kjelleren til Otto og Gerdas familie, men nå er de oppdaget og foreldrene arrestert. Otto og Gerda bestemmer seg for å hjelpe sine nye venner. Gjennom snøtunge skoger flykter de fire barna fra tyske soldater. Målet er å komme seg til Sverige. Det blir en flukt på liv og død. Heldigvis møter de gode hjelpere underveis. Men hvem kan de egentlig stole på?  Vi har fortalt historiene igjen og igjen, på film, bøker i aviser, men alltid for voksne. Endelig kommer en film fra krigen for hele familien. Flukten over grensen er en spenningsfilm om tillit og vennskap, om frykt og om stort mot hos små mennesker.  Suksessforfatter Maja Lunde har selv skrevet manus til Flukten over grensen. Filmen er basert på hennes prisvinnende bok fra 2012 og er spennende, rørende og tankevekkende historie basert på historiske hendelser.","tagline":"En spenningsfilm for hele familien fra suksessforfatter Maja Lunde"}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/x2gi261egmQ1pVs5CRly2AIgWAs.jpg","background":"https://image.tmdb.org/t/p/original/ooATGkHxlPXE1CTSAdeaHscuon6.jpg","seasons":[],"schema":{}}},"enrichment":{"status":"ready","hasMissingEpisodeMetadata":false}}
