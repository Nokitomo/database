/w300/an8GDr2Pn0aVkHqFCl1PZP0uOzN.png","language":"en","width":1455,"height":700},"candidates":[{"type":"logo","url":"https://image.tmdb.org/t/p/original/an8GDr2Pn0aVkHqFCl1PZP0uOzN.png","previewUrl":"https://image.tmdb.org/t/p/w300/an8GDr2Pn0aVkHqFCl1PZP0uOzN.png","language":"en","width":1455,"height":700}]},"xx":{"status":"missing","candidates":[]}}},"seasons":{}},"tvdb":{"schemaVersion":1,"source":"tvdb","id":9181,"mediaType":"movie","series":{"source":"tvdb-web","sourceUrl":"https://www.thetvdb.com/movies/the-englishman-who-went-up-a-hill-but-came-down-a-mountain","tvdbId":9181,"mediaType":"movie","tvdbMovieId":9181,"title":"The Englishman Who Went Up a Hill But Came Down a Mountain","originalLanguage":"en","poster":"https://artworks.thetvdb.com/banners/movies/9181/posters/9181.jpg"},"seasons":{}}},"externalMedia":{"tmdb":{"source":"tmdb-api","id":10612,"type":"movie","sourceUrl":"https://www.themoviedb.org/movie/10612","fetchedAt":"2026-11-06T16:34:56.885Z","originalLanguage":"en-US","title":{"value":"L'inglese che salì la collina e scese da una montagna","language":"it-IT"},"originalTitle":"The Englishman Who Went Up a Hill But Came Down a Mountain","overview":{"value":"Siamo nel Galles nel 1917, durante la Prima guerra mondiale, quando due cartografi inglesi, il superbo Garrad ed il suo giovane apprendista Anson, arrivano nel piccolo villaggio rurale di Taff's Well per misurare la sua montagna, per scoprire, con grande oltraggio della popolazione locale, che essa è solo una collina perché non raggiunge i 1.000 piedi di altezza. I locali, capitanati dal vecchio Morgan il Montone e dal Reverendo Jones, complottano con l'aiuto del giovane Anson, per ritardare la partenza di Garrad ed elevare artificialmente la vetta della loro collina per renderla appunto più alta del richiesto. I due cartografi resteranno così ostaggi del villaggio fino a quando non si decideranno ad assecondare il campanilismo locale dichiarando che quella di Taff's Well è in realtà una montagna e non una semplice collina.","language":"it-IT"},"tagline":{"value":"A romantic comedy about a town that wouldn't give up. A man who couldn't get out. And the mountain that brought them together.","language":"en-US"},"releaseDate":"1995-05-12","status":"Released","rating":6.4,"ratingCount":329,"genres":["Dramma","Commedia","Romance"],"countries":["United Kingdom"],"facts":{"Runtime":"91m"},"keywords":[],"networks":[],"socialLinks":{},"cast":[{"id":3291,"name":"Hugh Grant","role":"Reginald Anson","profile":"https://image.tmdb.org/t/p/original/dvV843fOuzsEPXHtFvdzsHpy1rC.jpg"},{"id":47615,"name":"Tara Fitzgerald","role":"Betty","profile":"https://image.tmdb.org/t/p/original/tMnBeLckuioclUR5KmlqUm49nCz.jpg"},{"id":17782,"name":"Colm Meaney","role":"Morgan the Goat","profile":"https://image.tmdb.org/t/p/original/guL6RJdlRMtOJN3LoaY3G8hG4Rd.jpg"},{"id":3547,"name":"Ian McNeice","role":"George Garrad","profile":"https://image.tmdb.org/t/p/original/v5WuiYuKmKxWZRDn3XnGJh7nCUC.jpg"},{"id":10985,"name":"Ian Hart","role":"Johnny Shellshocked","profile":"https://image.tmdb.org/t/p/original/xMC8aPDwhEZcjRHEFcgytSr3BzM.jpg"},{"id":51879,"name":"Kenneth Griffith","role":"Reverend Jones","profile":"https://image.tmdb.org/t/p/original/7SYr4jbF7HdA37XviMhwio2jb3m.jpg"},{"id":1127836,"name":"Tudor Vaughan","role":"Thomas Twp"},{"id":1127837,"name":"Hugh Vaughan","role":"Thomas Twp Two"},{"id":47643,"name":"Robert Pugh","role":"Williams the Petroleum","profile":"https://image.tmdb.org/t/p/original/rHThJc9AxpeoOkPuAHixVfN9AqV.jpg"},{"id":142744,"name":"Robert Blythe","role":"Ivor","profile":"https://image.tmdb.org/t/p/original/7Mhfa9lauoGkBB1t4jTYIEUuyfJ.jpg"},{"id":170257,"name":"Garfield Morgan","role":"Davies the School","profile":"https://image.tmdb.org/t/p/original/pvd7ywPKSSF4yprHnvQII3jbpfC.jpg"},{"id":111658,"name":"Lisa Palfrey","role":"Blod Jones","profile":"https://image.tmdb.org/t/p/original/iwZrsJhsuiqep5zEyh4b7lhYTs5.jpg"},{"id":134910,"name":"Dafydd Wyn Roberts","role":"Tommy Twostroke"},{"id":1095908,"name":"Ieuan Rhys","role":"Sergeant Thomas","profile":"https://image.tmdb.org/t/p/original/WWG4gIzahyxZZEGOCDWigpXJQq.jpg"},{"id":126543,"name":"Anwen Williams","role":"Mavis","profile":"https://image.tmdb.org/t/p/original/ey1w1IjLGmK9GPHo0hoQWl2wCmG.jpg"},{"id":200562,"name":"David Lloyd Meredith","role":"Jones the JP","profile":"https://image.tmdb.org/t/p/original/kH2TiDsc9BPIIsYmakXJe3ZUkOr.jpg"},{"id":134905,"name":"Howell Evans","role":"Thomas the Trains","profile":"https://image.tmdb.org/t/p/original/aMsI8hCje6fo3ZOhdxLMUKyJWyB.jpg"},{"id":186030,"name":"Fraser Cains","role":"Evans the End of the World","profile":"https://image.tmdb.org/t/p/original/eXthT1aha5Szy5kLvOL2YaffSz6.jpg"},{"id":2148085,"name":"Jack Walters","role":"Grandfather"},{"id":2056833,"name":"Harry Kretchmer","role":"Young Boy"},{"id":1821240,"name":"Maisie McNeice","role":"Girl in classroom","profile":"https://image.tmdb.org/t/p/original/mK3qn3SQbkQHDBCxiF2v0CgZThn.jpg"},{"id":80368,"name":"Nicholas McGaughey","role":"Narrator (voice)","profile":"https://image.tmdb.org/t/p/original/uKhCZeIOWNT8u5tXpIG4QbeC9Wu.jpg"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","title":"L'inglese che salì la collina e scese da una montagna","overview":"Siamo nel Galles nel 1917, durante la Prima guerra mondiale, quando due cartografi inglesi, il superbo Garrad ed il suo giovane apprendista Anson, arrivano nel piccolo villaggio rurale di Taff's Well per misurare la sua montagna, per scoprire, con grande oltraggio della popolazione locale, che essa è solo una collina perché non raggiunge i 1.000 piedi di altezza. I locali, capitanati dal vecchio Morgan il Montone e dal Reverendo Jones, complottano con l'aiuto del giovane Anson, per ritardare la partenza di Garrad ed elevare artificialmente la vetta della loro collina per renderla appunto più alta del richiesto. I due cartografi resteranno così ostaggi del villaggio fino a quando non si decideranno ad assecondare il campanilismo locale dichiarando che quella di Taff's Well è in realtà una montagna e non una semplice collina."},{"language":"en-US","overview":"When an English cartographer arrives in Wales to tell the residents of the Welsh village of Ffynnon Garw  that their 'mountain' is only a hill, the offended community sets out to remedy the situation.","tagline":"A romantic comedy about a town that wouldn't give up. A man who couldn't get out. And the mountain that brought them together."}],"images":{"logos":[{"type":"logo","url":"https://image.tmdb.org/t/p/original/an8GDr2Pn0aVkHqFCl1PZP0uOzN.png","previewUrl":"https://image.tmdb.org/t/p/w300/an8GDr2Pn0aVkHqFCl1PZP0uOzN.png","language":"en","width":1455,"height":700}],"posters":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/s96XNz6eBsYDK3A9nVyEuHdv7BG.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/s96XNz6eBsYDK3A9nVyEuHdv7BG.jpg","language":"en","width":1000,"height":1500},{"type":"poster","url":"https://image.tmdb.org/t/p/original/dnatrgiXFf6BLfb2IKHVmg9tCi7.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/dnatrgiXFf6BLfb2IKHVmg9tCi7.jpg","language":"en","width":1000,"height":1500},{"type":"poster","url":"https://image.tmdb.org/t/p/original/zeDiKW9sGnWj0wIzzO4u8uMXeMw.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/zeDiKW9sGnWj0wIzzO4u8uMXeMw.jpg","language":"en","width":1000,"height":1500},{"type":"poster","url":"https://image.tmdb.org/t/p/original/yMDWvjpRZMZS6XP0Z7J4gzXfTlW.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/yMDWvjpRZMZS6XP0Z7J4gzXfTlW.jpg","language":"en","width":1029,"height":1500},{"type":"poster","url":"https://image.tmdb.org/t/p/original/94L0F6Iaqq2nejNrdgmvs8G4akH.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/94L0F6Iaqq2nejNrdgmvs8G4akH.jpg","language":"en","width":529,"height":750},{"type":"poster","url":"https://image.tmdb.org/t/p/original/58ZZmF0YY0WAaTYvc2GE42HfO4d.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/58ZZmF0Y