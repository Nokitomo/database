:"xx","width":1920,"height":1080},{"type":"backdrop","url":"https://image.tmdb.org/t/p/original/4QGwGsfuxx2iyxqBE2grdxh1DQn.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/4QGwGsfuxx2iyxqBE2grdxh1DQn.jpg","language":"xx","width":1920,"height":1080},{"type":"backdrop","url":"https://image.tmdb.org/t/p/original/rcXQqBpbnG8JVPfYSWtoJ9xEOOw.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/rcXQqBpbnG8JVPfYSWtoJ9xEOOw.jpg","language":"xx","width":1920,"height":1080},{"type":"backdrop","url":"https://image.tmdb.org/t/p/original/vhXpGPaOLcOcvKJqyGxqmiBWQd6.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/vhXpGPaOLcOcvKJqyGxqmiBWQd6.jpg","language":"xx","width":1920,"height":1080}]}},"logo":{"it":{"status":"missing","candidates":[]},"en":{"status":"missing","candidates":[]},"xx":{"status":"missing","candidates":[]}}},"seasons":{}},"tvdb":{"schemaVersion":1,"source":"tvdb","id":11151,"mediaType":"movie","series":{"source":"tvdb-web","sourceUrl":"https://www.thetvdb.com/movies/the-broken-circle-breakdown","tvdbId":11151,"mediaType":"movie","tvdbMovieId":11151,"title":"The Broken Circle Breakdown","originalLanguage":"Dutch","poster":"https://artworks.thetvdb.com/banners/v4/movie/11151/posters/68d701c00eb47.jpg"},"seasons":{}}},"externalMedia":{"tmdb":{"source":"tmdb-api","id":137182,"type":"movie","sourceUrl":"https://www.themoviedb.org/movie/137182","fetchedAt":"2026-11-14T17:59:25.223Z","originalLanguage":"nl-NL","title":{"value":"Alabama Monroe - Una storia d'amore","language":"it-IT"},"originalTitle":"The Broken Circle Breakdown","overview":{"value":"Elise e Didier vivono una travolgente e appassionata storia d’amore, al ritmo dalla musica bluegrass. Elise gestisce uno studio di tatuaggi, sua grande passione. Per lei “c’è sempre qualcosa nella vita che vale la pena mettere sul proprio corpo”: ogni tatuaggio accompagna il suo cuore e le sue emozioni ed Elise lo sfoggia con orgoglio sul suo corpo delicato. Didier è invece da sempre innamorato dell’America, che identifica come la terra delle infinite opportunità. Per lui è un Paese per sognatori ma, soprattutto, la patria della sua amatissima musica bluegrass, “il country nella versione più pura”, che Didier interpreta suonando il banjo in un gruppo musicale. Ed è proprio questa comune passione per la musica ad esaltare l’unione di Elise e Didier: insieme si esibiscono in irresistibili performance dove ogni interpretazione trasuda amore, complicità e passione. A coronare questo cerchio perfetto di felicità è l’arrivo di Maybelle, la loro bellissima bambina.","language":"it-IT"},"releaseDate":"2012-10-09","status":"Released","rating":7.674,"ratingCount":1167,"genres":["Dramma"],"countries":["Belgium","Netherlands"],"facts":{"Runtime":"111m"},"keywords":[],"networks":[],"socialLinks":{},"cast":[{"id":82423,"name":"Veerle Baetens","role":"Elise","profile":"https://image.tmdb.org/t/p/original/zYx89q29LGBLRJ7FwLUyB5bgl2N.jpg"},{"id":115742,"name":"Johan Heldenbergh","role":"Didier","profile":"https://image.tmdb.org/t/p/original/57IOlWiDfDzBvzMAD3VnwuO60R.jpg"},{"id":1106961,"name":"Nell Cattrysse","role":"Maybelle","profile":"https://image.tmdb.org/t/p/original/gjH7kNWdXHbAmRn0TsskYPE8Kvo.jpg"},{"id":220295,"name":"Geert Van Rampelberg","role":"William","profile":"https://image.tmdb.org/t/p/original/jECzjJvrJdBrh6xf3aRpTOu3Qxi.jpg"},{"id":1106962,"name":"Nils De Caster","role":"Jock"},{"id":88806,"name":"Robbie Cleiren","role":"Jimmy","profile":"https://image.tmdb.org/t/p/original/rWbsJK8Y86xi6MzIHBLqzxUACDZ.jpg"},{"id":1106963,"name":"Bert Huysentruyt","role":"Jef","profile":"https://image.tmdb.org/t/p/original/8VOE3u7jTFRzniWFAA9nTrY5un.jpg"},{"id":1106964,"name":"Jan Bijvoet","role":"Koen","profile":"https://image.tmdb.org/t/p/original/vEiLdWybj3tt92KN67JCIvYj6vP.jpg"},{"id":1106965,"name":"Blanka Heirman","role":"Denise","profile":"https://image.tmdb.org/t/p/original/21R7XEmFGfaLav9R3WGDP5lUDJM.jpg"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","title":"Alabama Monroe - Una storia d'amore","overview":"Elise e Didier vivono una travolgente e appassionata storia d’amore, al ritmo dalla musica bluegrass. Elise gestisce uno studio di tatuaggi, sua grande passione. Per lei “c’è sempre qualcosa nella vita che vale la pena mettere sul proprio corpo”: ogni tatuaggio accompagna il suo cuore e le sue emozioni ed Elise lo sfoggia con orgoglio sul suo corpo delicato. Didier è invece da sempre innamorato dell’America, che identifica come la terra delle infinite opportunità. Per lui è un Paese per sognatori ma, soprattutto, la patria della sua amatissima musica bluegrass, “il country nella versione più pura”, che Didier interpreta suonando il banjo in un gruppo musicale. Ed è proprio questa comune passione per la musica ad esaltare l’unione di Elise e Didier: insieme si esibiscono in irresistibili performance dove ogni interpretazione trasuda amore, complicità e passione. A coronare questo cerchio perfetto di felicità è l’arrivo di Maybelle, la loro bellissima bambina."},{"language":"en-US","overview":"The loss of their young daughter threatens to destroy the love and faith of two married musicians."},{"language":"nl-NL","overview":"The Broken Circle Breakdown' vertelt de intense love story tussen Elise (28) en Didier (36). Zij heeft haar eigen tattooshop, hij is een Vlaamse cowboy die banjo speelt in een bandje. Het is liefde op het eerste gezicht... al zijn de verschillen groot."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/9kozq6PSE0jqIIO5xPcvpydzV4n.jpg","background":"https://image.tmdb.org/t/p/original/gjoZgt6jErl2p3VXIzBvvZY7Taw.jpg","seasons":[],"schema":{}}},"enrichment":{"status":"ready","hasMissingEpisodeMetadata":false}}
