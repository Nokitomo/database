.thetvdb.com/movies/16-wishes","tvdbId":4126,"mediaType":"movie","tvdbMovieId":4126,"title":"16 Wishes","originalLanguage":"en","poster":"https://artworks.thetvdb.com/banners/movies/4126/posters/4126.jpg"},"seasons":{}}},"externalMedia":{"tmdb":{"source":"tmdb-api","id":40205,"type":"movie","sourceUrl":"https://www.themoviedb.org/movie/40205","fetchedAt":"2026-11-14T17:33:59.664Z","originalLanguage":"en-US","title":{"value":"I 16 desideri","language":"it-IT"},"originalTitle":"16 Wishes","overview":{"value":"La mattina del sedicesimo compleanno, Abby (Debby Ryan) riceve in dono una scatola che contiene sedici magiche candeline, ognuna capace di realizzare un desiderio. In poco tempo, grazie al loro aiuto, diviene la ragazza più popolare e invidiata della scuola ma scopre che ogni cosa ottenuta ha comportato un elevato prezzo da pagare, perdendo gli ultimi anni di spensieratezza adolescenziale. Riuscirà a riavere indietro il suo mondo solo grazie all’aiuto dell’amico Jay (Jean-Luc Bilodeau).","language":"it-IT"},"tagline":{"value":"Everyone's sweet 16 is special, Abby's is magical.","language":"en-US"},"releaseDate":"2010-10-02","status":"Released","rating":6.322,"ratingCount":1390,"genres":["Fantasy","Dramma","Famiglia"],"countries":["United States of America"],"facts":{"Runtime":"94m"},"keywords":[],"networks":[],"socialLinks":{},"cast":[{"id":123846,"name":"Debby Ryan","role":"Abby Jensen","profile":"https://image.tmdb.org/t/p/original/hYMnrAO1fZx9tPmIM8xajliVT1N.jpg"},{"id":205204,"name":"Jean-Luc Bilodeau","role":"Jay Kepler","profile":"https://image.tmdb.org/t/p/original/nGm9uRDwYbGaQpoOk0Z6sigzdBP.jpg"},{"id":219998,"name":"Keenan Tracey","role":"Logan Buchanan","profile":"https://image.tmdb.org/t/p/original/uXZLXdjGEFck8DlHGDsnHezX8qV.jpg"},{"id":143329,"name":"Anna Mae Wills","role":"Celeste","profile":"https://image.tmdb.org/t/p/original/btugkYUpA0oppoKKFn2025ELCp0.jpg"},{"id":144853,"name":"Karissa Tynes","role":"Krista Cook","profile":"https://image.tmdb.o