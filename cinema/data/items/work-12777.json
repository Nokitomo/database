orno a casa dalla guerra e rivela alle due donne che Kichi è morto in battaglia; dopo averle aiutate contro due soldati si propone di aiutarle nei loro attacchi ma l'anziana donna rifiuta, non fidandosi. Con il passare del tempo, nasce un rapporto fra Hachi e la nuora; i due, spinti dalla passione, si incontrano ogni notte.","language":"it-IT"},"tagline":{"value":"The most daring film import ever...From Japan!","language":"en-US"},"releaseDate":"1964-11-21","status":"Released","rating":7.7,"ratingCount":515,"genres":["Horror"],"countries":["Japan"],"facts":{"Runtime":"105m"},"keywords":[],"networks":[],"socialLinks":{},"cast":[{"id":33728,"name":"Nobuko Otowa","role":"Woman","profile":"https://image.tmdb.org/t/p/original/6vcByiFlOE9JiLGWNKRtN8k0uil.jpg"},{"id":33729,"name":"Jitsuko Yoshimura","role":"Young Woman","profile":"https://image.tmdb.org/t/p/original/wlH7kdIzQuTwOJDLmM9Qw43uf5z.jpg"},{"id":33730,"name":"Kei Satō","role":"Hachi","profile":"https://image.tmdb.org/t/p/original/xyb1DI4HViq1aEvc3pgJV5Xw2Sn.jpg"},{"id":33731,"name":"Jūkichi Uno","role":"The Samurai","profile":"https://image.tmdb.org/t/p/original/jxXsvpNQDo0AOG3fippKtlZHQUm.jpg"},{"id":33732,"name":"Taiji Tonoyama","role":"Ushi","profile":"https://image.tmdb.org/t/p/original/k88bvJ91SiL2Nn6QtQf7hB8U4iv.jpg"},{"id":1429146,"name":"Someshō Matsumoto","role":"Runaway Warrior"},{"id":1274449,"name":"Kentarô Kaji","role":"Runaway Warrior"},{"id":1177410,"name":"Fudeko Tanaka","role":"Old Woman","profile":"https://image.tmdb.org/t/p/original/95L5bDgQfYTnp4b25KVNguwV9Q5.jpg"},{"id":552183,"name":"Hiroyoshi Yamaguchi","role":"Horse Riding Samurai"},{"id":118998,"name":"Hiroshi Tanaka","role":"Horse Riding Samurai","profile":"https://image.tmdb.org/t/p/original/syy1wzPDojswjSMznKNwGLV2x91.jpg"},{"id":1482646,"name":"Kanzō Uni","role":"Horse Riding Samurai","profile":"https://image.tmdb.org/t/p/original/nszpp25PKI4RxxH0O3mYHBgqGT2.jpg"},{"id":2476987,"name":"Hosui Araya","role":"Ushi's Follower"},{"id":2627