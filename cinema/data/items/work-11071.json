l uncertainty, Arturo decides to take a stand."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/fliDojAYPtosZrKSlXmTMaQ37zN.jpg","background":"https://image.tmdb.org/t/p/original/mVdQlzKKLXlErVSqmBwgtwAqF4D.jpg","seasons":[],"schema":{}}},"enrichment":{"status":"ready","hasMissingEpisodeMetadata":false}}
