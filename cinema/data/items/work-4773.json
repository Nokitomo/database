t her completely due to the magic of the Black Queen."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/9eNx0yBUOgKJmTvXmAkaMRNBWa2.jpg","background":"https://image.tmdb.org/t/p/original/cRJr0mkrUayr42Z8qNlsprWqL3Z.jpg","seasons":[],"schema":{}}},"enrichment":{"status":"ready","hasMissingEpisodeMetadata":false}}
