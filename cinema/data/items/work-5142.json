8:51.000000Z","original_url_field":null,"reference":{"base":"streamingunity:images","path":"/images/748dccc8-1567-4b87-9c24-262ddaee82ab.webp"}}],"translations":[{"id":405283,"translatable_type":"episode","translatable_id":139801,"locale":"it","key":"name","value":"Episodio 1"},{"id":405284,"translatable_type":"episode","translatable_id":139801,"locale":"it","key":"plot","value":"In mare aperto al largo della costa nord-occidentale remota dell'Australia, un luogo di acque profonde brulicante di fauna marina ha catturato l'immaginazione dei cacciatori di relitti. Ossessionati dal potenziale di trovare un sito di relitto storico, la loro attenzione si rivolge alla storia dei marinai persi in mare e delle famiglie che hanno lasciato indietro. È un'avventura piena di sorprese che cambierà per sempre le loro vite."}]},{"id":139802,"number":2,"name":"Episodio 2","plot":"I cacciatori di relitti cercano un lussuoso transatlantico di linea chiamato Koombana, che si infilò dritto sulla traiettoria di un ciclone mortale al largo della remota costa nord-occidentale dell'Australia e non fu mai più visto. Oltre 150 persone furono perse in mare e le comunità furono lasciate devastate. La squadra è determinata ad aiutare a risolvere questo enigmatico mistero oceanico.","duration":49,"scws_id":400678,"season_id":11119,"created_at":"2025-10-03T10:38:54.000000Z","updated_at":"2025-11-05T08:42:16.000000Z","quality":"HD","audio_orig":1,"dub_ita":0,"sub_ita":1,"uploaded_at":"2025-10-03 12:38:54","images":[{"id":319059,"filename":"16e29a5a-c076-4c1b-8b26-9622889e3f97.webp","type":"cover","lang":null,"imageable_type":"episode","imageable_id":139802,"created_at":"2025-10-03T10:38:55.000000Z","updated_at":"2025-10-03T10:38:55.000000Z","original_url_field":null,"reference":{"base":"streamingunity:images","path":"/images/16e29a5a-c076-4c1b-8b26-9622889e3f97.webp"}}],"translations":[{"id":405285,"translatable_type":"episode","translatable_id":139802,"locale":"it","key":"name","value":"Episodio 