al/3IdvrzXEu8Jubzkb4AN5uFmg91c.jpg"},{"id":1929509,"name":"Aleksandra Serebryakova","role":"сестра-анастезистка","profile":"https://image.tmdb.org/t/p/original/8sAm4cRoFkJ3bns5HHyfdIOU63z.jpg"},{"id":235110,"name":"Artur Vakha","role":"врач","profile":"https://image.tmdb.org/t/p/original/lsCQzI1Ecb3nCrB030wC5Hy3u6F.jpg"},{"id":2034786,"name":"Aleksandr Zaitsev","role":"Камбузник","profile":"https://image.tmdb.org/t/p/original/hJ3RtLw44sdWThDtWUD5GSsyVA5.jpg"},{"id":558009,"name":"Boris Kamorzin","role":"Беляев","profile":"https://image.tmdb.org/t/p/original/6F19I0gOAQkfx4N7DZLbpACjepG.jpg"},{"id":1491724,"name":"Aleksandr Oblasov","role":"Лева","profile":"https://image.tmdb.org/t/p/original/vA06TXZ0yr2rDRHLJIyEIjjiNg5.jpg"},{"id":2216668,"name":"Beso Gataev","role":"кок","profile":"https://image.tmdb.org/t/p/original/7E5Cv5no2OCl46oINpWbYVJ9jXU.jpg"},{"id":1849012,"name":"Alexey Ilyin","role":"полярник","profile":"https://image.tmdb.org/t/p/original/3eKnD7XxGmBBFeEH8syh8RjKVBK.jpg"},{"id":1018870,"name":"Margarita Bychkova","role":"Нина, соседка","profile":"https://image.tmdb.org/t/p/original/q0shRjxDC9JXQF4lWobgq3vSdAV.jpg"},{"id":1034698,"name":"Igor Khripunov","role":"Тихонов","profile":"https://image.tmdb.org/t/p/original/k9Nw2mZlLAtbZOJdTmnbX4Vj8hK.jpg"},{"id":2312141,"name":"Igor Sergeev","role":"капитан судна «Новороссийск»","profile":"https://image.tmdb.org/t/p/original/aOnrJqPvjc03QqcI5fwZSE5ELt.jpg"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","title":"The Icebreaker - Terrore tra i ghiacci","overview":"Antartide, 1985. La nave rompighiaccio Gromov rimane bloccata tra i ghiacci nel tentativo di schivare un iceberg gigante. Per 133 giorni, tra il freddo e l'agghiacciante silenzio della zona, l'equipaggio proverà a trovare una via di uscita a una situazione in cui ogni passo falso potrebbe portare alla morte..."},{"language":"en-US","title":"The Icebreaker","overview":"The story is based on the real events of 1985. The team of a Russian polar icebreaker “Mikhail Gromov” discovered a giant iceberg. The ship came into collision while attempting to take cover from the weather and is forced to drift with ice along the Amundsen Sea coast. The crew of “Gromov” spent 133 days of polar night trying to find a way out of their icy trap. They have no room for mistakes; one wrong move and the vessel is crushed by ice."},{"language":"ru-RU","title":"Ледокол","overview":"1985 год. Навстречу ледоколу «Михаил Громов» движется огромный айсберг. Уходя от столкновения с ним, судно попадает в ледовый плен и оказывается в вынужденном дрейфе вблизи побережья Антарктиды. Вокруг зловещая тишина и жуткий холод. Горючее на исходе... Нервы на пределе... И даже если можно было бы уйти - деваться всё равно некуда. У командования ледокола нет права на ошибку. Одно неверное решение - и тяжёлые льды раздавят судно..."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/yckBykSSBxnccY9iiQD5YywZDKv.jpg","background":"https://image.tmdb.org/t/p/original/kxkLO3qhmvoJhIT76nUQdoVhb3Y.jpg","seasons":[],"schema":{}}},"enrichment":{"status":"ready","hasMissingEpisodeMetadata":false}}
