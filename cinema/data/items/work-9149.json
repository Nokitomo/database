":37,"scws_id":75743,"season_id":1895,"created_at":"2023-05-18T13:03:18.000000Z","updated_at":"2025-11-05T08:38:45.000000Z","quality":"HD","audio_orig":0,"dub_ita":1,"sub_ita":0,"uploaded_at":"2023-05-18 15:03:18","images":[{"id":40552,"filename":"e9de46b3-8742-436d-acc0-ff69b2448635.webp","type":"cover","lang":null,"imageable_type":"episode","imageable_id":25586,"created_at":"2023-05-18T13:03:18.000000Z","updated_at":"2023-05-18T16:56:36.000000Z","original_url_field":null,"reference":{"base":"streamingunity:images","path":"/images/e9de46b3-8742-436d-acc0-ff69b2448635.webp"}}],"translations":[{"id":93919,"translatable_type":"episode","translatable_id":25586,"locale":"it","key":"name","value":"Episode 2"},{"id":93920,"translatable_type":"episode","translatable_id":25586,"locale":"it","key":"plot","value":"The courtesan Meg, who became a spy on behalf of Puybaraud, head of the police and sworn enemy of the Prefect, infiltrates the Guérins. At the Surêté of Paris, Jouin investigates with Commissioner Cochefert the case of the bloody suitcase and the disappearance of Joséphine Berger. Fiersi is assigned to the investigation."}]},{"id":25587,"number":3,"name":"Episode 3","plot":"Inspector Jouin fells in love with Jeanne Chauvin, a young lawyer with a strong character, who could not practice but served as an assistant to Master Weidmann in the Jewish district of La Vilette.  Jeanne decides to help him in the Berger case. For her part, Meg receives Madame Lépine, the prefect's wife, at home, whose penchant for artificial paradises has not escaped Commissioner Puybaraud.","duration":26,"scws_id":79165,"season_id":1895,"created_at":"2023-05-18T13:03:18.000000Z","updated_at":"2025-11-05T08:38:45.000000Z","quality":"HD","audio_orig":0,"dub_ita":1,"sub_ita":0,"uploaded_at":"2023-05-18 15:03:18","images":[{"id":40553,"filename":"316ae5f8-6bf8-48b9-bd59-a61c8e695a71.webp","type":"cover","lang":null,"imageable_type":"episode","imageable_id":25587,"created_at":"2023-05-18T13:03:18.