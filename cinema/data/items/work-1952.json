 dog."}],"images":{"logos":[{"type":"logo","url":"https://image.tmdb.org/t/p/original/mc1IveQvzjcsrcpFrnY5OYtYmaM.png","previewUrl":"https://image.tmdb.org/t/p/w300/mc1IveQvzjcsrcpFrnY5OYtYmaM.png","language":"en","width":780,"height":219},{"type":"logo","url":"https://image.tmdb.org/t/p/original/3e9OJWmltNACpQVja4YfLEkuMiv.png","previewUrl":"https://image.tmdb.org/t/p/w300/3e9OJWmltNACpQVja4YfLEkuMiv.png","language":"en","width":1274,"height":359}],"posters":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/fAbfTCRpjHe2rprXBly55KL1dL9.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/fAbfTCRpjHe2rprXBly55KL1dL9.jpg","language":"en","width":1307,"height":1960},{"type":"poster","url":"https://image.tmdb.org/t/p/original/9NXuW79YTscQZbgcvDZADGuieUW.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/9NXuW79YTscQZbgcvDZADGuieUW.jpg","language":"en","width":1000,"height":1500},{"type":"poster","url":"https://image.tmdb.org/t/p/original/qi6Kw0cRL6FTkW86o2teLAV2OWL.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/qi6Kw0cRL6FTkW86o2teLAV2OWL.jpg","language":"en","width":1700,"height":2550},{"type":"poster","url":"https://image.tmdb.org/t/p/original/WwR2TNisgQCCqpnaNfC7RrSKuL.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/WwR2TNisgQCCqpnaNfC7RrSKuL.jpg","language":"en","width":1000,"height":1500},{"type":"poster","url":"https://image.tmdb.org/t/p/original/kYiPQ0Es9nQsRcO4wzyPohMg3u1.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/kYiPQ0Es9nQsRcO4wzyPohMg3u1.jpg","language":"en","width":2000,"height":2963},{"type":"poster","url":"https://image.tmdb.org/t/p/original/cw6YhduvFG0tXa8dZacchzpkTDe.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/cw6YhduvFG0tXa8dZacchzpkTDe.jpg","language":"en","width":575,"height":862},{"type":"poster","url":"https://image.tmdb.org/t/p/original/3ePfNMS2SKZvt0JvBBCzB7tuNJz.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/3ePfNMS2SKZvt0JvBBCzB7tuNJz.jpg","language":"en","width":1000,"height":1500},{"type":"poster","url":"htt