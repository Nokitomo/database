 essere perfetti è sinonimo di felicità.","language":"it-IT"},"tagline":{"value":"Ognuno è speciale","language":"it-IT"},"releaseDate":"2019-05-01","status":"Released","rating":6.63,"ratingCount":489,"genres":["Animazione","Musica","Famiglia","Commedia"],"countries":["Canada","China","United States of America"],"facts":{"Runtime":"87m"},"keywords":[],"networks":[],"socialLinks":{},"cast":[{"id":155488,"name":"Kelly Clarkson","role":"Moxy (voice)","profile":"https://image.tmdb.org/t/p/original/mfqjGz99cMbZLLg1eHwU2OUsOjK.jpg"},{"id":1005852,"name":"Janelle Monáe","role":"Mandy (voice)","profile":"https://image.tmdb.org/t/p/original/eTYG6eBH1LzLWcdQJaH72Wzxemm.jpg"},{"id":292445,"name":"Blake Shelton","role":"Ox (voice)","profile":"https://image.tmdb.org/t/p/original/fXgQ4O20f49wJHgTHUIM9T3XBAQ.jpg"},{"id":27102,"name":"Wanda Sykes","role":"Wage (voice)","profile":"https://image.tmdb.org/t/p/original/toPTeiRGN1Ha0DaXl8587i9aHUi.jpg"},{"id":86498,"name":"Gabriel Iglesias","role":"Babo (voice)","profile":"https://image.tmdb.org/t/p/original/8Bjy3RZ5TfNs3oUOUpxTv84G01f.jpg"},{"id":134184,"name":"Leehom Wang","role":"Lucky Bat (voice)","profile":"https://image.tmdb.org/t/p/original/mDdI6E8blhw9ga5S4hyIRPsKnwd.jpg"},{"id":2167419,"name":"Bebe Rexha","role":"Tuesday (voice)","profile":"https://image.tmdb.org/t/p/original/cpzK852JtDLJf3zd0RuVd1giOeX.jpg"},{"id":1529997,"name":"Charli xcx","role":"Kitty (voice)","profile":"https://image.tmdb.org/t/p/original/xnYIKjdP2anSMmDlFbJN3zZQMkC.jpg"},{"id":1661465,"name":"Lizzo","role":"Lydia (voice)","profile":"https://image.tmdb.org/t/p/original/wYPEw07PGNht66ziBEuF4DoArQj.jpg"},{"id":130565,"name":"Nick Jonas","role":"Lou (voice)","profile":"https://image.tmdb.org/t/p/original/y79k7wrDeyRbrGFs2Z3XHU5mq0o.jpg"},{"id":1009740,"name":"Pitbull","role":"Ugly Dog (voice)","profile":"https://image.tmdb.org/t/p/original/zc5QAIekRKZ3shR3CdAQTmd1qLg.jpg"},{"id":34847,"name":"Emma Roberts","role":"Wedgehead (voice)","profile":"https://image.t