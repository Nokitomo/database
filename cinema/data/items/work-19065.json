OkaTymhKbh6C.png"}],"socialLinks":{},"cast":[{"id":42604,"name":"John Simm","role":"DS Roy Grace","profile":"https://image.tmdb.org/t/p/original/tTiUpHt2raPRjEIeFvIh12cRGAt.jpg"},{"id":553273,"name":"Richie Campbell","role":"DS Glenn Branson","profile":"https://image.tmdb.org/t/p/original/8eIzjzRFMiTztLrw7hVbGAIb1nv.jpg"},{"id":1776235,"name":"Brad Morrison","role":"DC Nick Nicholl","profile":"https://image.tmdb.org/t/p/original/paozOVxibY7qwDGRcFs4Ze6inht.jpg"},{"id":1761275,"name":"Laura Elphinstone","role":"DS Bella Moy","profile":"https://image.tmdb.org/t/p/original/yPsWPEF7NXbmUyO5O2PGB7JqGuB.jpg"},{"id":47733,"name":"Zoë Tapper","role":"Cleo Morey","profile":"https://image.tmdb.org/t/p/original/qLJ4jYVTV0MMMiu3XRlmQrh5AxQ.jpg"},{"id":2738814,"name":"Juliette Motamed","role":"DC Vee Wilde","profile":"https://image.tmdb.org/t/p/original/iUUqmwBPRVBFOD5OMwtxZsUMZ9G.jpg"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","title":"Le indagini di Roy Grace","overview":"La storia del sovrintendente investigativo Roy Grace, che vive a Brighton, un funzionario di polizia che lavora sodo e che ha dedicato la vita al lavoro."},{"language":"en-US","overview":"Brighton based Detective Superintendent Roy Grace is a hard-working police officer who has given his life to the job, but his career is currently at rock bottom. He’s fixated by the disappearance of his beloved wife, Sandy, and running enquiries into long forgotten cold cases with little prospect of success. Following another reprimand for his unorthodox police methods, Grace is walking a career tightrope and risks being moved from the job he loves most.","tagline":"Bright lights, dark secrets."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/r9hE4eF8IGbcoyl419Nfllkv6Ag.jpg","background":"https://image.tmdb.org/t/p/original/uR2qF4WHN3pnCHUvuELKHcwDVio.jpg","seasons":[{"seasonNumber":1,"name":{"value":"Stagione 1","langua