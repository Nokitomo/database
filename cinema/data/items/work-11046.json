anguage":"en-US","title":{"value":"Firestarter","language":"en-US"},"originalTitle":"Firestarter","overview":{"value":"Con l'aiuto dei genitori, Charlie trascorre un'infanzia in fuga, costretta a tenere sotto controllo i suoi straordinari poteri pirocinetici. Ora che sta per compiere 11 anni però, controllare le fiamme diventa sempre più difficile, mentre fugge da forze sinistre che cercano di catturarla. Per proteggere la famiglia e conquistare la libertà, Charlie dovrà lottare per controllare il suo potere e imparare a gestire il fuoco.","language":"it-IT"},"tagline":{"value":"Non giocare col fuoco","language":"it-IT"},"releaseDate":"2022-05-12","status":"Released","rating":5.42,"ratingCount":846,"genres":["Horror","Fantascienza"],"countries":["United States of America"],"facts":{"Runtime":"94m"},"keywords":[],"networks":[],"socialLinks":{},"cast":[{"id":2072566,"name":"Ryan Kiera Armstrong","role":"Charlie McGee","profile":"https://image.tmdb.org/t/p/original/fBToPwwvEWHw9MhRzZP1packFDi.jpg"},{"id":29222,"name":"Zac Efron","role":"Andy McGee","profile":"https://image.tmdb.org/t/p/original/pdWXP7XG6qqOoxoLid1DWYwmaMY.jpg"},{"id":1303156,"name":"Sydney Lemmon","role":"Vicky McGee","profile":"https://image.tmdb.org/t/p/original/heGyUuth1HInFdywZ6y8gqjf0q6.jpg"},{"id":2115,"name":"Kurtwood Smith","role":"Dr. Joseph Wanless","profile":"https://image.tmdb.org/t/p/original/7dqsk4NYbNZNnmppv2zPuf1hKBn.jpg"},{"id":154647,"name":"Michael Greyeyes","role":"Rainbird","profile":"https://image.tmdb.org/t/p/original/jy45vhkNT0s7gtf1dRIfFL77YWg.jpg"},{"id":21369,"name":"Gloria Reuben","role":"Captain Hollister","profile":"https://image.tmdb.org/t/p/original/7Ttd3nj1M9P8YE9LzCvGZcvPUQR.jpg"},{"id":38571,"name":"John Beasley","role":"Irv Manders","profile":"https://image.tmdb.org/t/p/original/tpZQojv2UfelPHr1eSphcp0iEpJ.jpg"},{"id":1776255,"name":"Tina Jung","role":"Ms. Gardner","profile":"https://image.tmdb.org/t/p/original/eQG7U6ZMys4wJ0RhPGq72t3VcpC.jpg"},{"id":2663787,"name":"