.tmdb.org/t/p/original/z8ZtenrxsOwXE7YbD9tVyq02DYH.jpg"},{"id":2454554,"name":"David Sheridan","role":"Convulsing Man"},{"id":1371862,"name":"Miranda Millar","role":"Dancing Woman","profile":"https://image.tmdb.org/t/p/original/dm39XiGD1ffuavob3bBOZipiH8t.jpg"},{"id":1587774,"name":"Xavier Lopez","role":"Research Assistant","profile":"https://image.tmdb.org/t/p/original/rDzLnImMXgoo2YqWIW9UbaiPdP2.jpg"},{"id":139622,"name":"Darryl Scheelar","role":"Lead Agent","profile":"https://image.tmdb.org/t/p/original/ee7Mr2N7eKIQEZ9XhlFyElZgDs0.jpg"},{"id":1316786,"name":"Zion Forrest Lee","role":"Agent"},{"id":207818,"name":"Patrick Kerton","role":"Lead SWAT","profile":"https://image.tmdb.org/t/p/original/jj9uVCBSSUFvOi663jMbs7YJ3G3.jpg"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","overview":"Con l'aiuto dei genitori, Charlie trascorre un'infanzia in fuga, costretta a tenere sotto controllo i suoi straordinari poteri pirocinetici. Ora che sta per compiere 11 anni però, controllare le fiamme diventa sempre più difficile, mentre fugge da forze sinistre che cercano di catturarla. Per proteggere la famiglia e conquistare la libertà, Charlie dovrà lottare per controllare il suo potere e imparare a gestire il fuoco.","tagline":"Non giocare col fuoco"},{"language":"en-US","overview":"For more than a decade, parents Andy and Vicky have been on the run, desperate to hide their daughter Charlie from a shadowy federal agency that wants to harness her unprecedented gift for creating fire into a weapon of mass destruction. Andy has taught Charlie how to defuse her power, which is triggered by anger or pain. But as Charlie turns 11, the fire becomes harder and harder to control. After an incident reveals the family's location, a mysterious operative is deployed to hunt down the family and seize Charlie once and for all. Charlie has other plans.","tagline":"Never play with fire."}],"images":{"logos":[],"posters":[],"backdrops":[]},"post