/pqg5goNhKh371m4ULYApeEtKuQj.png","language":"en","width":1276,"height":331},"candidates":[{"type":"logo","url":"https://image.tmdb.org/t/p/original/pqg5goNhKh371m4ULYApeEtKuQj.png","previewUrl":"https://image.tmdb.org/t/p/w300/pqg5goNhKh371m4ULYApeEtKuQj.png","language":"en","width":1276,"height":331},{"type":"logo","url":"https://image.tmdb.org/t/p/original/r7JHjoPeB9em4ZtSCeZdGX4XFlV.png","previewUrl":"https://image.tmdb.org/t/p/w300/r7JHjoPeB9em4ZtSCeZdGX4XFlV.png","language":"en","width":3840,"height":1032}]},"xx":{"status":"available","selected":{"type":"logo","url":"https://image.tmdb.org/t/p/original/nLGIfvKizepB94kvmmvDb1pjowZ.png","previewUrl":"https://image.tmdb.org/t/p/w300/nLGIfvKizepB94kvmmvDb1pjowZ.png","language":"xx","width":1311,"height":330},"candidates":[{"type":"logo","url":"https://image.tmdb.org/t/p/original/nLGIfvKizepB94kvmmvDb1pjowZ.png","previewUrl":"https://image.tmdb.org/t/p/w300/nLGIfvKizepB94kvmmvDb1pjowZ.png","language":"xx","width":1311,"height":330}]}}},"seasons":{}},"tvdb":{"schemaVersion":1,"source":"tvdb","id":1210,"mediaType":"movie","series":{"source":"tvdb-web","sourceUrl":"https://www.thetvdb.com/movies/the-man-from-uncle","tvdbId":1210,"mediaType":"movie","tvdbMovieId":1210,"title":"The Man from U.N.C.L.E.","originalLanguage":"en","poster":"https://artworks.thetvdb.com/banners/movies/1210/posters/1210.jpg"},"seasons":{}}},"externalMedia":{"tmdb":{"source":"tmdb-api","id":203801,"type":"movie","sourceUrl":"https://www.themoviedb.org/movie/203801","fetchedAt":"2026-11-14T17:03:41.406Z","originalLanguage":"en-US","title":{"value":"Operazione U.N.C.L.E.","language":"it-IT"},"originalTitle":"The Man from U.N.C.L.E.","overview":{"value":"Agli inizi degli anni Sessanta del Novecento, in piena guerra fredda, l'agente della Cia Napoleon Solo (Henry Cavill) e l'agente del KGB Ilya Kuryakin (Armie Hammer) sono costretti a mettere da parte il tradizionale antagonismo per impegnarsi in una missione comune. Il loro obiettivo è quello di mettere fuori dai giochi un'organizzazione criminale internazionale che minaccia di scuotere il già precario equilibrio globale con la proliferazione di armi e tecnologia nucleari. Solo e Kuryakin hanno una traccia da cui partire: il contatto con la figlia di uno scienziato tedesco scomparso, l'unico in grado di infiltrarsi nell'organizzazione. Finiranno così con l'essere impegnati in una corsa contro il tempo per ritrovare l'uomo e prevenire una catastrofe mondiale.","language":"it-IT"},"tagline":{"value":"Salvare il mondo è una questione di stile","language":"it-IT"},"releaseDate":"2015-08-13","status":"Released","rating":7.079,"ratingCount":7160,"genres":["Commedia","Azione","Avventura"],"countries":["United States of America"],"facts":{"Runtime":"116m"},"keywords":[],"networks":[],"socialLinks":{},"cast":[{"id":73968,"name":"Henry Cavill","role":"Napoleon Solo","profile":"https://image.tmdb.org/t/p/original/dgTD7Q9owL3DyX9uYoSX9KZeUUz.jpg"},{"id":53807,"name":"Armie Hammer","role":"Illya Kuryakin","profile":"https://image.tmdb.org/t/p/original/4Z5nLW2biRjqstDMKqSaeQYAesK.jpg"},{"id":227454,"name":"Alicia Vikander","role":"Gaby Teller","profile":"https://image.tmdb.org/t/p/original/lZu8qiTwiQIN96cuptgqMCCaUtg.jpg"},{"id":1133349,"name":"Elizabeth Debicki","role":"Victoria Vinciguerra","profile":"https://image.tmdb.org/t/p/original/nTTnQVTn13Ve4ifjRY9v8kVc99w.jpg"},{"id":90325,"name":"Luca Calvani","role":"Alexander","profile":"https://image.tmdb.org/t/p/original/Aq9mc0x3orFxmBT9cXpbUUtihUW.jpg"},{"id":41965,"name":"Sylvester Groth","role":"Uncle Rudi","profile":"https://image.tmdb.org/t/p/original/fmmWf9lOWmIsJX7IxroTuyiyTtQ.jpg"},{"id":3291,"name":"Hugh Grant","role":"Waverly","profile":"https://image.tmdb.org/t/p/original/dvV843fOuzsEPXHtFvdzsHpy1rC.jpg"},{"id":15440,"name":"Jared Harris","role":"Sanders","profile":"https://image.tmdb.org/t/p/original/r9nIq0jPz1oBm4WwtlZhqlsX8p0.jpg"},{"id":7803,"name":"Christian Berkel","role":"Udo","profile":"https://image.tmd