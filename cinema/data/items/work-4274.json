를 손에 쥐려는 무덕까지, 저마다 다른 꿈을 품은 사람들이 마포나루를 둘러싸고 얽히기 시작한다. 돈과 권력이 뒤엉킨 탁류 한가운데에서 시율은 살아남기 위해 주먹을 쥐고, 그의 이름은 점차 조선 전역에 알려지기 시작한다.","tagline":"탁한 물살 위에서, 한 남자가 전설이 되어 간다"}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/8F9lwJueqM3xPQJnXW2bQOqMGf7.jpg","background":"https://image.tmdb.org/t/p/original/nipbnsKUPLeylYhYdW0DwMtSmFt.jpg","seasons":[{"seasonNumber":1,"name":{"value":"Stagione 1","language":"it-IT"},"year":2025,"episodeCount":9,"poster":"https://image.tmdb.org/t/p/original/mc93wPwIQNFhlB9v5rJ68kbgTf1.jpg","posters":[],"backgrounds":[],"sourceUrl":"https://www.themoviedb.org/tv/230926/season/1"}],"schema":{"@context":"https://schema.org","@type":"TVSeries","dateCreated":"2023-07-19T08:43:06Z","dateModified":"2026-09-27T15:54:14Z","description":"The fates of a man with a hidden past, a wise and just woman, and an upright man intertwine.","isFamilyFriendly":true,"name":"The Murky Stream","numberOfEpisodes":9,"url":"https://www.themoviedb.org/tv/230926","aggregateRating":{"@type":"AggregateRating","bestRating":10,"ratingValue":7.9,"ratingCount":31,"worstRating":0},"countryOfOrigin":[{"@type":"Country","name":"Corea del Sud"}],"endDate":"2025-10-17T00:00:00Z","genre":["Dramma","Action & Adventure"],"image":"https://image.tmdb.org/t/p/w500/gj1Qde71tlF5ylNCfOHuanWw48J.jpg","startDate":"2025-09-26T00:00:00Z","actor":[{"@type":"Person","name":"Rowoon","url":"https://www.themoviedb.org/person/1613836-loun"},{"@type":"Person","name":"Shin Ye-eun","url":"https://www.themoviedb.org/person/2256407-sinyeeun"},{"@type":"Person","name":"Park Seo-ham","url":"https://www.themoviedb.org/person/3212104-bagseoham"},{"@type":"Person","name":"Park Ji-hwan","url":"https://www.themoviedb.org/person/1078674-bagjihwan"},{"@type":"Person","name":"Jeon Bae-soo","url":"https://www.themoviedb.org/person/1572347-jeonbaesu"},{"@type":"Person","name":"Choi Won-young","url":"https://www.themoviedb.org/person/1258630-choewonyeong"},{"@type":"Person","