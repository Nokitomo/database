guage":"en","poster":"https://artworks.thetvdb.com/banners/movies/3831/posters/3831.jpg"},"seasons":{}}},"externalMedia":{"tmdb":{"source":"tmdb-api","id":18533,"type":"movie","sourceUrl":"https://www.themoviedb.org/movie/18533","fetchedAt":"2026-11-08T23:52:55.245Z","originalLanguage":"en-US","title":{"value":"Bronson","language":"it-IT"},"originalTitle":"Bronson","overview":{"value":"Bronson è basato sulla vita di uno dei più famosi criminali inglesi, Michael Gordon Peterson. Nel 1974, a 19 anni, Peterson era un teppistello che per farsi un nome, tentò di rapinare un ufficio postale con un fucile a canne mozze. Arrestato, fu condannato a sette anni di carcere: ma in prigione, ossessionato dall'idea di diventare famoso, iniziò ad attaccare con violenza gli altri detenuti e i secondini, ottenendo così prolungamenti di pena che lo fanno rimanere in prigione ancora oggi. 34 anni passati dietro le sbarre, 30 dei quali in isolamento: nel corso di questi 34 anni, Michael Gordon Peterson ha assunto il \"nome d'arte\" di Charles Bronson.","language":"it-IT"},"tagline":{"value":"The Man. The Myth. The Celebrity.","language":"en-US"},"releaseDate":"2009-03-13","status":"Released","rating":6.935,"ratingCount":2815,"genres":["Dramma","Azione","Crime"],"countries":["United Kingdom","Denmark"],"facts":{"Runtime":"92m"},"keywords":[],"networks":[],"socialLinks":{},"cast":[{"id":2524,"name":"Tom Hardy","role":"Michael Peterson / Charles Bronson","profile":"https://image.tmdb.org/t/p/original/d81K0RH8UX7tZj49tZaQhZ9ewH.jpg"},{"id":23776,"name":"Matt King","role":"Paul Daniels","profile":"https://image.tmdb.org/t/p/original/1WGWqW8j9bCG6YwnLPF8N4CZDjY.jpg"},{"id":19775,"name":"James Lance","role":"Phil","profile":"https://image.tmdb.org/t/p/original/xlcpKyVjwRR7RLrviI7Olo5S6FM.jpg"},{"id":125718,"name":"Kelly Adams","role":"Irene","profile":"https://image.tmdb.org/t/p/original/aVRV5X7ybuukICtuixfw1XI4h7O.jpg"},{"id":1117431,"name":"Katy Barker","role":"Julie"},{"id":190405,"name":"A