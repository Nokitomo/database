s://image.tmdb.org/t/p/original/fupE6nEyqvqqPvEVk5rBFyPgh8A.jpg"},{"id":39163,"name":"Andrea Bosic","role":"Yanez","profile":"https://image.tmdb.org/t/p/original/xNCpKXIkQPYZVckgrIOZOZg66Ug.jpg"},{"id":567994,"name":"Nando Gazzolo","role":"Lt. Clintock","profile":"https://image.tmdb.org/t/p/original/ol5p4OkFzMuzluHRniuKYUrI3Z6.jpg"},{"id":101113,"name":"Leo Anchóriz","role":"Lord Brook","profile":"https://image.tmdb.org/t/p/original/ehsFz2ClooM5bhuWkFBc9m23PBq.jpg"},{"id":29431,"name":"Franco Balducci","role":"Sambigliong","profile":"https://image.tmdb.org/t/p/original/5VmgaIPAMZpjVvngaiaFpzdg2Pm.jpg"},{"id":49898,"name":"Pierre Cressoy","role":"Captain of the Young India","profile":"https://image.tmdb.org/t/p/original/5AAPiR3WrRJ6JAkr36k14u1eRcL.jpg"},{"id":101551,"name":"Giuseppe Addobbati","role":"Muda Hassin","profile":"https://image.tmdb.org/t/p/original/oQ2D4hduKRGhLyYpnTpobaAo6AE.jpg"},{"id":89283,"name":"Nando Angelini","profile":"https://image.tmdb.org/t/p/original/9yBtY2sS1QnFha3Y9rxF7OuGnSs.jpg"},{"id":136393,"name":"Dakar","role":"Kammamuuri","profile":"https://image.tmdb.org/t/p/original/5JysgNhUZheFTNYEJ9XLRYKP3hW.jpg"},{"id":976293,"name":"George Wang","role":"Sho Pa","profile":"https://image.tmdb.org/t/p/original/bNP7g7Fgw0PgO4OfGOJcLF1YV8U.jpg"},{"id":138180,"name":"Sujata Rubener","role":"Dancer"},{"id":1778833,"name":"Asoka Rubener","role":"Dancer"},{"id":72662,"name":"Nazzareno Zamperla","profile":"https://image.tmdb.org/t/p/original/2MJm2Oq7yUaIOhKaOyMIxYnvDRQ.jpg"},{"id":1091540,"name":"Domenico Cianfriglia","profile":"https://image.tmdb.org/t/p/original/msjUpZMft7ie4FZ0bFLpL4ZMxXu.jpg"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","overview":"A Sarawak occupata dagli inglesi, domina Lord Brooke che, spodestato ed imprigionato il rajah Mura Hassin, gli si è sostituito come sovrano del paese. Però Ada, la figlia di Hassin, è sfuggita alla cattura imbarcandosi su un mercantile olandese che al largo viene abbordato dalla nave pirata di Sandokan. Dopo un breve assalto i pirati hanno la meglio e Sandokan conosce dalla diretta testimonianza di Ada le dolorose vicende di Sarawak e di Mura Hassin. La decisione non si fa attendere: i pirati della Malesia si batteranno per cacciare l'usurpatore."},{"language":"en-US","title":"The Pirates of Malaysia","overview":"Filmed in Singapore it tells the story of Sandokan who is a Malaysian rebel who, with a group of renegades, goes up against a British General who is trying to force the King to resign."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/6wC7Of28pNxAyAMJfvBcydE5HZ7.jpg","background":"https://image.tmdb.org/t/p/original/g9eveG1Hi0qVXnCJAT7PGVL1Wx4.jpg","seasons":[],"schema":{}}},"enrichment":{"status":"ready","hasMissingEpisodeMetadata":false}}
