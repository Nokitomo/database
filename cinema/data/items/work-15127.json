previewUrl":"https://image.tmdb.org/t/p/w300/mNF5zIqq9d9aqgAaiQyvJAnuSnw.png","language":"en","width":3466,"height":1918}]},"xx":{"status":"missing","candidates":[]}}},"seasons":{}},"tvdb":{"schemaVersion":1,"source":"tvdb","id":374199,"mediaType":"movie","series":{"source":"tvdb-web","sourceUrl":"https://www.thetvdb.com/movies/lenfant-du-desert","tvdbId":374199,"mediaType":"movie","tvdbMovieId":374199,"title":"L'enfant du désert","originalLanguage":"fr","poster":"https://artworks.thetvdb.com/banners/v4/movie/374199/posters/69edee05a1f80.jpg"},"seasons":{}}},"externalMedia":{"tmdb":{"source":"tmdb-api","id":1266800,"type":"movie","sourceUrl":"https://www.themoviedb.org/movie/1266800","fetchedAt":"2026-11-14T17:56:08.631Z","originalLanguage":"fr-FR","title":{"value":"Il figlio del deserto","language":"it-IT"},"originalTitle":"L'enfant du désert","overview":{"value":"La quattordicenne Sun ha pubblicato un libro ispirato a una storia che suo nonno le raccontava sempre: l'incredibile storia di Hadara, una bambina nomade persa dalla sua famiglia all'età di due anni in una tempesta di sabbia nel deserto, che fu poi salvata e cresciuta da una coppia di struzzi. Ma quando Sun viene invitata a visitare il Sahara, si rende conto che Hadara potrebbe essere molto più di una semplice favola della buonanotte.","language":"it-IT"},"tagline":{"value":"Lost in the Sahara, raised in the wild.","language":"en-US"},"releaseDate":"2026-04-08","status":"Released","rating":7.3,"ratingCount":34,"genres":["Avventura","Famiglia"],"countries":["France","Belgium"],"facts":{"Runtime":"92m"},"keywords":[],"networks":[],"socialLinks":{},"cast":[{"id":1165008,"name":"Kev Adams","role":"Christian","profile":"https://image.tmdb.org/t/p/original/jTqAH5n7CfPkolBIe0Bp6AfPYhZ.jpg"},{"id":5255023,"name":"Nahel Tran"},{"id":5255024,"name":"Nahïl Bouazzaoui"},{"id":2878562,"name":"Neige de Maistre","role":"Sun"},{"id":1418653,"name":"Adriane Gradziel","profile":"https://image.tmdb.org/t/p/original/ft2iqM3kTfVZORfVKvVCyxOLX0N.jpg"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","title":"Il figlio del deserto","overview":"La quattordicenne Sun ha pubblicato un libro ispirato a una storia che suo nonno le raccontava sempre: l'incredibile storia di Hadara, una bambina nomade persa dalla sua famiglia all'età di due anni in una tempesta di sabbia nel deserto, che fu poi salvata e cresciuta da una coppia di struzzi. Ma quando Sun viene invitata a visitare il Sahara, si rende conto che Hadara potrebbe essere molto più di una semplice favola della buonanotte."},{"language":"en-US","title":"The Desert Child","overview":"14-year-old Sun has written and successfully published a story based on an incredible story told by her late grandfather about a wild child called Hadara, who is saved by a group of ostriches when he becomes separated from his family in a storm, and is then raised in the desert amid a host of wild animals, including his best friend, a desert fox. When Sun is invited to travel to the Sahara by a local community who has heard about her book, she meets Kharouba, a Nomad girl of her own age, and realizes there may be much more to Hadara than just a character in a bedtime story.","tagline":"Lost in the Sahara, raised in the wild."},{"language":"fr-FR","overview":"Sun, âgée de 14 ans, a publié un livre inspiré d'une histoire que son grand-père lui racontait : l'incroyable histoire d'Hadara, un enfant nomade perdu par sa famille à l’âge de 2 ans dans une tempête de sable dans le désert, qui a ensuite été recueilli et élevé par un couple d’autruches. Mais lorsque Sun est invitée à visiter le Sahara, elle se rend compte qu'Hadara est peut-être plus qu'une simple histoire pour s'endormir."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/mnbJSXLJGegbwl05TASP7WorxB4.jpg","background":"https://image.tmdb.org/t/p/original/raTby3MY67GCHiF1S0VSwq01fds.jpg","seasons":[],"schema":{}}},"enrichment":{"status":"ready","hasMissingEpisodeMetadata":false}}
