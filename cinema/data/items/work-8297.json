hat it is better to make love instead of war"}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/wfJ2flMchZPQCSdt8h3ZQNSW7Ym.jpg","background":"https://image.tmdb.org/t/p/original/o2alIK1pBH0xVQIswPXWJwLGy48.jpg","seasons":[],"schema":{}}},"enrichment":{"status":"ready","hasMissingEpisodeMetadata":false}}
