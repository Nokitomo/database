nerazione, quella del regista, formata da Marrakech Express e Turné. Un bel gioco di squadra attoriale e un'accattivante mistura di buffo e patetico con molti stereotipi e qualche leziosaggine ruffiana. Girato nell'isola di Kastellorizo (Megisti in greco). Oscar per il film straniero.","language":"it-IT"},"tagline":{"value":"Su una splendida isola greca, un soldato sta per scoprire che è meglio fare l'amore che la guerra.","language":"it-IT"},"releaseDate":"1991-02-02","status":"Released","rating":7.605,"ratingCount":1100,"genres":["Commedia","Romance","Guerra"],"countries":["Italy"],"facts":{"Runtime":"95m"},"keywords":[],"networks":[],"socialLinks":{},"cast":[{"id":55912,"name":"Diego Abatantuono","role":"Sgt. Nicola Lo Russo","profile":"https://image.tmdb.org/t/p/original/i7idHOw21i3RNO8IrVKkGlcAyOd.jpg"},{"id":119950,"name":"Claudio Bigagli","role":"Lt. Raffaele Montini","profile":"https://image.tmdb.org/t/p/original/Au3H49qjanQA2hYIrN6tNyyirxy.jpg"},{"id":106350,"name":"Giuseppe Cederna","role":"Antonio Farina","profile":"https://image.tmdb.org/t/p/original/c38oQexxu4ItKbN8RYDD01cGtan.jpg"},{"id":55914,"name":"Claudio Bisio","role":"Corrado Noventa","profile":"https://image.tmdb.org/t/p/original/cDhzyPQ3446zpRmP523rPFkkl4h.jpg"},{"id":55915,"name":"Gigio Alberti","role":"Eliseo Strazzabosco","profile":"https://image.tmdb.org/t/p/original/eCvbiGXFuiW478BZwQODTuD4UNb.jpg"},{"id":71296,"name":"Ugo Conti","role":"Luciano Colasanti","profile":"https://image.tmdb.org/t/p/original/sYPGa0VgYobdQkiJ3ELevIfm7lj.jpg"},{"id":1488531,"name":"Memo Dini","role":"Libero Munaron","profile":"https://image.tmdb.org/t/p/original/rarFYLGBjNi2RCRyawKq8sTdXNa.jpg"},{"id":1385127,"name":"Vasco Mirandola","role":"Felice Munaron","profile":"https://image.tmdb.org/t/p/original/yXiTL6N75wV43oTfBhaDa3rZFBN.jpg"},{"id":103609,"name":"Luigi Montini","role":"Orthodox priest","profile":"https://image.tmdb.org/t/p/original/gk90p8FdY4vFnrGK1h9jlXjhQ70.jpg"},{"id":141715,"name":"Irene Grazioli","