,"width":1610,"height":539},{"type":"logo","url":"https://image.tmdb.org/t/p/original/xlaXuWyjsJbnnv9Fmq6QWp5tsfc.png","previewUrl":"https://image.tmdb.org/t/p/w300/xlaXuWyjsJbnnv9Fmq6QWp5tsfc.png","language":"xx","width":1692,"height":478}]}}},"seasons":{}},"tvdb":{"schemaVersion":1,"source":"tvdb","id":131446,"mediaType":"movie","series":{"source":"tvdb-web","sourceUrl":"https://www.thetvdb.com/movies/dauntless-the-battle-of-midway","tvdbId":131446,"mediaType":"movie","tvdbMovieId":131446,"title":"Dauntless: The Battle of Midway","originalLanguage":"en","poster":"https://artworks.thetvdb.com/banners/v4/movie/131446/posters/6373e155285fd.jpg"},"seasons":{}}},"externalMedia":{"tmdb":{"source":"tmdb-api","id":604837,"type":"movie","sourceUrl":"https://www.themoviedb.org/movie/604837","fetchedAt":"2026-11-06T18:08:56.279Z","originalLanguage":"en-US","title":{"value":"Dauntless - La Battaglia di Midway","language":"it-IT"},"originalTitle":"Dauntless: The Battle of Midway","overview":{"value":"Nel giugno del 1942, la Marina giapponese oltrepassa il Pacifico. Nel tentativo di cambiare il corso della guerra, un gruppo di portaerei degli Stati Uniti viene posizionato al largo della costa di Midway con il compito di tendere una trappola al nemico. Nel corso del cruento scontro che ne seguirà, i due uomini che compongono l'equipaggio di un bombardiere della Marina degli Stati Uniti, sono costretti ad abbandonare l'aereo. Ormai alla deriva, agli uomini non resta che sperare che l'equipaggio di un PBY Catalina, inviato in loro soccorso, riesca a metterli in salvo. Di fronte alla vastità del Pacifico, con il passare dei giorni e la sempre più flebile possibilità di essere salvati, gli uomini sono costretti a fare i conti con la propria mortalità.","language":"it-IT"},"tagline":{"value":"Basato su una storia vera.","language":"it-IT"},"releaseDate":"2019-10-22","status":"Released","rating":4.3,"ratingCount":52,"genres":["Guerra","Azione","Dramma","Storia","Avventura"],"countries":["United States of America"],"facts":{"Runtime":"98m"},"keywords":[],"networks":[],"socialLinks":{},"cast":[{"id":21624,"name":"Judd Nelson","role":"Rear Admirial Raymond Spruance","profile":"https://image.tmdb.org/t/p/original/7kRf8vE0ZjMuunh8BaD50B3EhS5.jpg"},{"id":2878,"name":"C. Thomas Howell","role":"Captain Miles Browning","profile":"https://image.tmdb.org/t/p/original/739YbFWpAYyo9neHvBGThgmT4YH.jpg"},{"id":2154228,"name":"Mendel Fogelman","role":"Doc","profile":"https://image.tmdb.org/t/p/original/znDd936iNcaa9dHZHeBUOYDALt7.jpg"},{"id":565339,"name":"Aidan Bristow","role":"Pags","profile":"https://image.tmdb.org/t/p/original/ilCwCIuN3EDXn2UQYioa1oOpYlN.jpg"},{"id":1517269,"name":"James Austin Kerr","role":"Banks","profile":"https://image.tmdb.org/t/p/original/11ntHOXkZvJpsMhO2zxfX2ZiNyL.jpg"},{"id":1483272,"name":"Jade Willey","role":"Norman Vandiver"},{"id":2408262,"name":"John Enick","role":"Lee Keaney"},{"id":1213732,"name":"Byrne Offutt","role":"Captain Murray","profile":"https://image.tmdb.org/t/p/original/521qY2heEvI30lorK2euQ4SchGV.jpg"},{"id":2408271,"name":"Paul Kennedy Jr.","role":"Jackson"},{"id":2408275,"name":"Chris Roark","role":"Ensign Ramsay"},{"id":1235307,"name":"Drew Garrett","role":"Commander Wade McClusky","profile":"https://image.tmdb.org/t/p/original/1umYeyBD3mWPuqqZGyEiXmMufOL.jpg"},{"id":2465750,"name":"David Snyder","role":"Thompson","profile":"https://image.tmdb.org/t/p/original/2vcewh6aqXLPGiDOsS2gxJ0Fhtl.jpg"},{"id":2551675,"name":"Will Ropp","role":"Mansfield","profile":"https://image.tmdb.org/t/p/original/hoe1bibgruxCGBNxkPyH4f9E7Jy.jpg"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","title":"Dauntless - La Battaglia di Midway","overview":"Nel giugno del 1942, la Marina giapponese oltrepassa il Pacifico. Nel tentativo di cambiare il corso della guerra, un gruppo di portaerei degli Stati Uniti viene posizionato al largo della costa di Midway con il compito di tendere una trappola al nemico. Nel corso del cruento scontro che ne seguirà, i due uomini che compongono l'equipaggio di un bombardiere della Marina degli Stati Uniti, sono costretti ad abbandonare l'aereo. Ormai alla deriva, agli uomini non resta che sperare che l'equipaggio di un PBY Catalina, inviato in loro soccorso, riesca a metterli in salvo. Di fronte alla vastità del Pacifico, con il passare dei giorni e la sempre più flebile possibilità di essere salvati, gli uomini sono costretti a fare i conti con la propria mortalità.","tagline":"Basato su una storia vera."},{"language":"en-US","overview":"By June 1942, the Japanese Navy has swept across the Pacific. In an effort to change the course of the war, a United States carrier group is positioned off the coast of Midway, tasked with springing a trap on the enemy. During this pivotal battle, the two-man crew of a U.S. Navy dive bomber is forced to ditch in the sea. Set adrift, the men look towards their comrades for rescue; namely, the ragtag crew of a PBY Catalina, who are sent to search for survivors. Amid the vast openness of the Pacific, with days passing and the chance of rescue fading, the men are forced to face their own mortality.","tagline":"Based on a true story"}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/e183YUr7D4kvvi2DUKvUAPrlv47.jpg","background":"https://image.tmdb.org/t/p/original/cuqPNhNZkkdxghPagU2FeltiEKN.jpg","seasons":[],"schema":{}}},"enrichment":{"status":"ready","hasMissingEpisodeMetadata":false}}
