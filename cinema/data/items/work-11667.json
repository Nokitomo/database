db.com/banners/movies/18011/posters/18011.jpg"},"seasons":{}}},"externalMedia":{"tmdb":{"source":"tmdb-api","id":27099,"type":"movie","sourceUrl":"https://www.themoviedb.org/movie/27099","fetchedAt":"2026-11-14T17:39:57.453Z","originalLanguage":"fr-FR","title":{"value":"Quasi niente","language":"it-IT"},"originalTitle":"Presque rien","overview":{"value":"Mathieu è un diciottenne che sta trascorrendo con la madre e la sorella le vacanze estive in una località balneare. Assieme a loro c’è Annick che si occupa della donna, scioccata dopo la morte del figlio minore. Sul bagnasciuga Mathieu fa amicizia con Cédric, un ragazzo della sua età. Tra i due inizia un’amicizia che diventa giorno dopo giorno sempre più intensa.","language":"it-IT"},"releaseDate":"2000-06-07","status":"Released","rating":6.4,"ratingCount":90,"genres":["Romance","Dramma"],"countries":["Belgium","France"],"facts":{"Runtime":"94m"},"keywords":[],"networks":[],"socialLinks":{},"cast":[{"id":79033,"name":"Jérémie Elkaïm","role":"Mathieu","profile":"https://image.tmdb.org/t/p/original/3jiO7c8wSXRzxvxP7LSs3xVMUXD.jpg"},{"id":49859,"name":"Stéphane Rideau","role":"Cédric","profile":"https://image.tmdb.org/t/p/original/78VnBXkHRUT13JOg5NJnZmjisE9.jpg"},{"id":19363,"name":"Dominique Reymond","role":"Mathieu's Mother","profile":"https://image.tmdb.org/t/p/original/7FFvvt6s1M0R0edQLA1hjaeNCXE.jpg"},{"id":69150,"name":"Marie Matheron","role":"Annick","profile":"https://image.tmdb.org/t/p/original/om3lHCzEjyYBymOL4K4C1A1GcUC.jpg"},{"id":96942,"name":"Laetitia Legrix","role":"Sarah","profile":"https://image.tmdb.org/t/p/original/pf4JHghlUAWg14bKlvTIMkAHPl6.jpg"},{"id":96943,"name":"Nils Ohlund","role":"Pierre"},{"id":96944,"name":"Réjane Kerdaffrec","role":"Psychiatrist"},{"id":96945,"name":"Guy Houssier","role":"Cédric's Father"},{"id":96946,"name":"Violeta Ferrer","role":"Pierre's Mother","profile":"https://image.tmdb.org/t/p/original/nn7PfXqMIov6fVzrdTm1gGw0mmu.jpg"},{"id":96947,"name":"Robert Darmel","role":"Bar Owner"},{"id":136438,"name":"Éric Savin","role":"Annick's Boyfriend","profile":"https://image.tmdb.org/t/p/original/kqFxXjJs4LX1SwtNzRsSEffr4xr.jpg"},{"id":19937,"name":"Valérie Donzelli","profile":"https://image.tmdb.org/t/p/original/avBnRouRIl6ynhyDU5EXNa9k4iR.jpg"},{"id":38865,"name":"Salim Kéchiouche","profile":"https://image.tmdb.org/t/p/original/e5Esg19sYhwgS0ekbqTXwxvKWMo.jpg"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","title":"Quasi niente","overview":"Mathieu è un diciottenne che sta trascorrendo con la madre e la sorella le vacanze estive in una località balneare. Assieme a loro c’è Annick che si occupa della donna, scioccata dopo la morte del figlio minore. Sul bagnasciuga Mathieu fa amicizia con Cédric, un ragazzo della sua età. Tra i due inizia un’amicizia che diventa giorno dopo giorno sempre più intensa."},{"language":"en-US","title":"Come Undone","overview":"Story of two gorgeous, young French boys who begin a passionate relationship that boils over and threatens to destroy both their lives. Shy 18-year-old Mathieu is on summer vacation in the south of France. He spends his days lazily sunning himself at the beach, until he spies the handsome Cédric and falls in love."},{"language":"fr-FR","overview":"Mathieu, dix-huit ans, est en vacances avec sa mère et sa sœur dans un village de bord de mer. Avec eux, il y a aussi Annick, qui s'occupe du quotidien et veille surtout sur la mère, désemparée depuis la mort de son dernier enfant. Sur la plage, Mathieu rencontre Cédric, un garçon de son âge. Commence alors ce qui ressemble à une aventure de vacances mais, jour après jour, de petits conflits en étreintes, d'insouciances en provocations, l'affection grandit et devient intense..."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/ooUxNQk6yd287eQaElF68tpQmgv.jpg","background":"https://image.tmdb.org/t/p/original/Ae1NxtazIheNso8MC0va80pbjnK.jpg","seas