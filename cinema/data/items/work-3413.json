idth":2000,"height":3000},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/gYGx8XC7lXzKeS2yUVbUnBNguxg.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/gYGx8XC7lXzKeS2yUVbUnBNguxg.jpg","language":"xx","width":2000,"height":3000}]}}},"logo":{"status":"unsupported","inheritedFrom":"series.logo"},"background":{"status":"unsupported","inheritedFrom":"series.background"}}}}},"externalMedia":{"tmdb":{"source":"tmdb-api","id":218275,"type":"tv","sourceUrl":"https://www.themoviedb.org/tv/218275","fetchedAt":"2026-11-13T22:22:30.648Z","originalLanguage":"en-US","title":{"value":"I segreti dei pinguini","language":"it-IT"},"originalTitle":"Secrets of the Penguins","overview":{"value":"Nel corso di due anni straordinari, l'esploratore di National Geographic Bertie Gregory ha scoperto tradizioni segrete mai filmate prima, un'intelligenza sorprendente e società affiatate di pinguini. Questa incredibile serie rivela che sono molto più simili a noi di quanto avessimo mai immaginato: dalle loro profonde amicizie ai coraggiosi avventurieri che, con ingegno e creatività, affrontano alcuni dei luoghi più estremi del pianeta.","language":"it-IT"},"startDate":"2025-04-20","endDate":"2025-04-20","certification":"TV-PG","status":"Ended","mediaType":"Miniserie","rating":7.6,"ratingCount":23,"contentScore":71,"numberOfEpisodes":3,"numberOfSeasons":1,"genres":["Documentario"],"countries":["United States of America","United Kingdom"],"facts":{"Nome Originale":"Secrets of the Penguins","Stato":"Terminato","Tipo":"Miniserie","Lingua Originale":"Inglese"},"keywords":["penguin","miniseries","nature documentary"],"networks":[{"id":43,"name":"National Geographic","logo":"https://image.tmdb.org/t/p/original/q9rPBG1rHbUjII1Qn98VG2v7cFa.png"}],"socialLinks":{"justwatch":"https://www.justwatch.com/us/tv-show/secrets-of-the-penguins"},"cast":[{"id":59175,"name":"Blake Lively","role":"Self - Narrator (voice)","episodeCount":3,"profile":"https://image.tmdb.org/t/p/original/rkGVj