eight":1926}]}},"logo":{"it":{"status":"missing","candidates":[]},"en":{"status":"available","selected":{"type":"logo","url":"https://image.tmdb.org/t/p/original/nn98vtGzLPlyacZBEXdf0fgSoXC.png","previewUrl":"https://image.tmdb.org/t/p/w300/nn98vtGzLPlyacZBEXdf0fgSoXC.png","language":"en","width":3050,"height":1815},"candidates":[{"type":"logo","url":"https://image.tmdb.org/t/p/original/nn98vtGzLPlyacZBEXdf0fgSoXC.png","previewUrl":"https://image.tmdb.org/t/p/w300/nn98vtGzLPlyacZBEXdf0fgSoXC.png","language":"en","width":3050,"height":1815}]},"xx":{"status":"missing","candidates":[]}}},"seasons":{}},"tvdb":{"schemaVersion":1,"source":"tvdb","id":340580,"mediaType":"movie","series":{"source":"tvdb-web","sourceUrl":"https://www.thetvdb.com/movies/die-schule-der-magischen-tiere","tvdbId":340580,"mediaType":"movie","tvdbMovieId":340580,"title":"Die Schule der magischen Tiere","originalLanguage":"de","poster":"https://artworks.thetvdb.com/banners/v4/movie/340580/posters/633a181058c7b.jpg"},"seasons":{}}},"externalMedia":{"tmdb":{"source":"tmdb-api","id":793937,"type":"movie","sourceUrl":"https://www.themoviedb.org/movie/793937","fetchedAt":"2026-11-14T17:35:31.959Z","originalLanguage":"de-DE","title":{"value":"La scuola degli animali magici","language":"it-IT"},"originalTitle":"Die Schule der magischen Tiere","overview":{"value":"Ida si è trasferita da poco in città e ora è la “ragazzina nuova” della Winterstein School. Ha un po’ di difficoltà con la nuova classe: Helen, dispettosa, le rende difficile farsi nuovi amici, e il primo giorno di scuola rimane un solo posto libero per lei – accanto all’altro bambino escluso dal gruppo, Benni. Un giorno l’insegnante presenta i bambini a Mortimer Morrison, che viaggia il mondo in cerca di “animali magici”. Ognuno di questi animali è destinato a diventare l’anima gemella di un bambino. Tra tutti, Ida la nuova arrivata e Benni l’escluso, sono i primi bambini della classe a ricevere un compagno magico! Da questo momento, Benni è accompagnato dall’anziana e saggia tartaruga Henrietta e Ida dall’astuta volpe Rabbat. Quando a scuola continuano a verificarsi sparizioni di oggetti, i bambini e gli animali magici devono unirsi per risolvere il mistero del ladro.","language":"it-IT"},"tagline":{"value":"Benvenuti in un nuovo fantastico mondo","language":"it-IT"},"releaseDate":"2021-10-14","status":"Released","rating":6.222,"ratingCount":106,"genres":["Famiglia","Avventura","Fantasy"],"countries":["Austria","Germany"],"facts":{"Runtime":"93m"},"keywords":[],"networks":[],"socialLinks":{},"cast":[{"id":2966421,"name":"Emilia Maier","role":"Ida Kronenberg","profile":"https://image.tmdb.org/t/p/original/k0QW36vtiTAyc72MybSx89uvDVu.jpg"},{"id":2941494,"name":"Leonard Artur Conrads","role":"Benjamin Schubert","profile":"https://image.tmdb.org/t/p/original/mTTNznIsrWzPm4zOadx9bDL2Bzs.jpg"},{"id":2966423,"name":"Loris Sichrovsky","role":"Jo Wieland","profile":"https://image.tmdb.org/t/p/original/14hu4dR4lphXYt0UqAId9dsiJaV.jpg"},{"id":5511,"name":"Nadja Uhl","role":"Mary Cornfield","profile":"https://image.tmdb.org/t/p/original/s8xKoionb7eginXbxG0a1HU9KFN.jpg"},{"id":5646,"name":"Justus von Dohnányi","role":"Heribert Siegmann","profile":"https://image.tmdb.org/t/p/original/2zg2pY7w3X3z4FyYEqzlBHFZXK1.jpg"},{"id":225907,"name":"Heiko Pinkowski","role":"Willi Wondraschek","profile":"https://image.tmdb.org/t/p/original/oegbhEGwKoMRdqvuDgQ4T9ZiBNT.jpg"},{"id":586664,"name":"Marleen Lohse","role":"Elvira Kronenberg","profile":"https://image.tmdb.org/t/p/original/qBlETsMdgZTSyWhy61AJ3ia4NTz.jpg"},{"id":24440,"name":"Milan Peschel","role":"Mortimer Morrison","profile":"https://image.tmdb.org/t/p/original/3E9GchiOTtdEIvZ3AP5cCzXaFNy.jpg"},{"id":1272059,"name":"Max von der Groeben","role":"Rabbat (voice)","profile":"https://image.tmdb.org/t/p/original/5911aH1QWReNX2goc4cQ7jnaDL0.jpg"},{"id":10257,"name":"Katharina Thalbach","role":"Henrietta (voice)","profile":"https://image.tmdb.org/t/p/original/dFOwcCqKnFseJdShQmjwMzwxHfu.jpg"},{"id":15122,"name":"Sophie Rois","role":"Pinkie (voice)","profile":"https://image.tmdb.org/t/p/original/tgrQJo23b30NFcCaIaNinaRclPk.jpg"},{"id":5073311,"name":"Charlotte Hagenbucher","role":"Katinka Iwanow"},{"id":2966427,"name":"Levi Kazmaier","role":"Henry von Waldenfels"},{"id":2966428,"name":"Thilo Fridolin Matthes","role":"Max Kramer"},{"id":2965763,"name":"Emil Mascheck","role":"Matteo"},{"id":2966429,"name":"Tristan Schreck","role":"Eddie Petersen"},{"id":2966430,"name":"Lauri Kröck","role":"Lothar Roggenthiel"},{"id":52460,"name":"Rike Schmid","role":"Jos Mama","profile":"https://image.tmdb.org/t/p/original/ge7FXCPAoWIQgoe2M5SiXxeGLKh.jpg"},{"id":3373085,"name":"Jakob Weingärtner","role":"Samuel Trewes"},{"id":2825207,"name":"Lilith Julie Johna","role":"Anna-Lena Zink","profile":"https://image.tmdb.org/t/p/original/aYOhBk3UmfdryAypTsMsI7p6ERL.jpg"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","title":"La scuola degli animali magici","overview":"Ida si è trasferita da poco in città e ora è la “ragazzina nuova” della Winterstein School. Ha un po’ di difficoltà con la nuova classe: Helen, dispettosa, le rende difficile farsi nuovi amici, e il primo giorno di scuola rimane un solo posto libero per lei – accanto all’altro bambino escluso dal gruppo, Benni. Un giorno l’insegnante presenta i bambini a Mortimer Morrison, che viaggia il mondo in cerca di “animali magici”. Ognuno di questi animali è destinato a diventare l’anima gemella di un bambino. Tra tutti, Ida la nuova arrivata e Benni l’escluso, sono i primi bambini della classe a ricevere un compagno magico! Da questo momento, Benni è accompagnato dall’anziana e saggia tartaruga Henrietta e Ida dall’astuta volpe Rabbat. Quando a scuola continuano a verificarsi sparizioni di oggetti, i bambini e gli animali magici devono unirsi per risolvere il mistero del ladro.","tagline":"Benvenuti in un nuovo fantastico mondo"},{"language":"en-US","title":"The School of the Magical Animals","overview":"Ida Kronenberg must transfer to a new school, where she soon realizes the students are unkind to each other. However, that all changes when a new teacher, Miss Cornfield, begins to educate them on the value of friendship and magic.","tagline":"A magical adventure"},{"language":"de-DE","overview":"Ida muss umziehen. Weg von ihrem Zuhause, ihrer Schule und vor allem: Weg von ihren Freunden. In der neuen Klasse tut sie sich schwer. Eines Tages verkündet ihre Klassenlehrerin Miss Cornfield, dass demnächst jedes Kind in der Klasse ein magisches Tier als Begleiter bekommt. Ausgerechnet die beiden Außenseiter Ida und Benni erhalten als erste ihre neuen Gefährten, die Freunde fürs Leben werden sollen. Ida wird der Fuchs Rabbat an die Seite gestellt, Benni die Schildkröte Henrietta. Die magischen Tiere können nicht nur sprechen, sie haben alle auch einen ganz eigenen Charakter. Während Henrietta zwar etwas langsam, aber dafür fast 200 Jahre alt und sehr weise ist, ist Rabbat ebenso pfiffig wie gewitzt. Durch Rabbat wird Ida plötzlich zum Klassenstar und jeder möchte mit ihr befreundet sein."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/zTgHq7Hmb0YtH42v2TDsUH6kIYT.jpg","background":"https://image.tmdb.org/t/p/original/f5iYxNpImWQmaHPpamzutOjRwHe.jpg","seasons":[],"schema":{}}},"enrichment":{"status":"ready","hasMissingEpisodeMetadata":false}}
