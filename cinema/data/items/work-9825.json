rd.","tagline":"Half a zebra, a whole lot of adventure!"}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/eXbdzvbh9zZoAh2uuBGQT3rxGE1.jpg","background":"https://image.tmdb.org/t/p/original/bBvVy858Xt03Lm4AWJCekslC92A.jpg","seasons":[],"schema":{}}},"enrichment":{"status":"ready","hasMissingEpisodeMetadata":false}}
