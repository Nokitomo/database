dades físicas y mentales. Sometidos a un estrés extremo, privados de sueño y expuestos a condiciones inaguantables, los aspirantes tendrán que superar sus peores miedos para estar preparados para lo que pueda estar por venir."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/nyWRLBHO18qtBRsz9dCigsG0iFm.jpg","background":"https://image.tmdb.org/t/p/original/77kvD0tH49mw8V0enR9Cs9F4JA0.jpg","seasons":[{"seasonNumber":1,"name":{"value":"Stagione 1","language":"it-IT"},"year":2021,"episodeCount":8,"poster":"https://image.tmdb.org/t/p/original/nyWRLBHO18qtBRsz9dCigsG0iFm.jpg","posters":[],"backgrounds":[],"sourceUrl":"https://www.themoviedb.org/tv/133765/season/1"}],"schema":{"@context":"https://schema.org","@type":"TVSeries","dateCreated":"2021-09-16T10:59:50Z","dateModified":"2026-01-02T05:36:31Z","description":"For the first time in the history of the Spanish Police, a camera crew has been granted exclusive access to the selection process for new members of the Special Group of Operations (G.E.O.), which lasts for more than seven months. Dozens of officers start, but only a few will finish the course.","isFamilyFriendly":true,"name":"Spain's Elite Force: Beyond Limits","numberOfEpisodes":8,"url":"https://www.themoviedb.org/tv/133765-g-e-o-mas-alla-del-limite","aggregateRating":{"@type":"AggregateRating","bestRating":10,"ratingValue":7.6,"ratingCount":14,"worstRating":0},"countryOfOrigin":[{"@type":"Country","name":"Spagna"}],"endDate":"2021-10-14T00:00:00Z","genre":["Documentario"],"image":"https://image.tmdb.org/t/p/w500/nyWRLBHO18qtBRsz9dCigsG0iFm.jpg","startDate":"2021-10-14T00:00:00Z","sameAs":["https://www.imdb.com/title/tt13063852","https://www.wikidata.org/wiki/Q113048687"]}}},"enrichment":{"status":"ready","hasMissingEpisodeMetadata":true}}
