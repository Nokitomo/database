38,"type":"movie","sourceUrl":"https://www.themoviedb.org/movie/846238","fetchedAt":"2026-11-07T16:44:24.981Z","originalLanguage":"fr-FR","title":{"value":"I Love America","language":"fr-FR"},"originalTitle":"I Love America","overview":{"value":"Lisa è una donna single che decide di dare una nuova possibilità all'amore catapultando la sua vita da Parigi a Los Angeles. Il suo migliore amico Luka inizia vuole donare a Lisa un nuovo inizio. Da appuntamenti imbarazzanti a un commovente incontro a sorpresa, Lisa capirà che il viaggio verso l'amore è un viaggio verso se stessa e il perdono.","language":"it-IT"},"tagline":{"value":"Il n'est jamais trop tard pour changer de vie.","language":"fr-FR"},"releaseDate":"2022-03-11","status":"Released","rating":5.1,"ratingCount":82,"genres":["Commedia","Romance"],"countries":["France"],"facts":{"Runtime":"102m"},"keywords":[],"networks":[],"socialLinks":{},"cast":[{"id":1957,"name":"Sophie Marceau","role":"Lisa","profile":"https://image.tmdb.org/t/p/original/b56TRCVVMZ2LMZqzXg0FxeGMd0u.jpg"},{"id":2294424,"name":"Djanis Bouzyani","role":"Luka","profile":"https://image.tmdb.org/t/p/original/9E00wRHlLR1ZdzDGGOm5UG14Xle.jpg"},{"id":1660946,"name":"Colin Woodell","role":"John","profile":"https://image.tmdb.org/t/p/original/mh32Sz1K8o7jUNGb4IGO4CRJhkQ.jpg"},{"id":1379184,"name":"Sophie Verbeeck","role":"Lisa's Mother","profile":"https://image.tmdb.org/t/p/original/6w1EVVZ8tw5hlKe1ccX0Oesk4kc.jpg"},{"id":291375,"name":"Florence Viala","role":"Charlotte","profile":"https://image.tmdb.org/t/p/original/8L2OF9Yo0GbxGrXihOqPDJ969VK.jpg"},{"id":1031885,"name":"Keller Wortham","role":"The Valet","profile":"https://image.tmdb.org/t/p/original/zHbobwYKYYStLDxJKpYI2HRwSok.jpg"},{"id":1458318,"name":"Syrus Shahidi","role":"Jules","profile":"https://image.tmdb.org/t/p/original/mYMfegFlxyBTLMmbts5yeSEUAHP.jpg"},{"id":149486,"name":"Carlease Burke","role":"Aurora","profile":"https://image.tmdb.org/t/p/original/watMlWszsYx1MBLdmAvahZ8KkgR.jpg"},{"id":