nte VIII","profile":"https://image.tmdb.org/t/p/original/znlov0nUwAMnslo5U4uTZrCGwd9.jpg"},{"id":129881,"name":"Giulia Salerno","role":"Giovannina","profile":"https://image.tmdb.org/t/p/original/j2bP7oQRz12l6e6YRb8D2uKumOo.jpg"},{"id":6177619,"name":"Mariano Matrone","role":"Mezzapagnotta bambino"},{"id":2121908,"name":"Michele Nani","role":"Annibale","profile":"https://image.tmdb.org/t/p/original/oq8bXN3dBzH86qFTpouWP0LnZ16.jpg"},{"id":6177632,"name":"Antonio Silvestre","role":"Michele"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","overview":"La vita di Filippo Neri, uno dei santi piú bizzarri della storia della Chiesa. Il santo della gioia, il giullare di Dio, il secondo apostolo di Roma, Pippo il buono, sono solo alcune delle definizioni date a questo sacerdote che nacque a Firenze nel 1515 ed ha poi vissuto per sessant'anni a Roma. Mentre si celebrava il Concilio di Trento e prendeva avvio la Controriforma, San Filippo formava bande di giovani scapestrati trasteverini avvicinandoli alla liturgia e facendoli divertire, cantando e giocando, in quello che sarebbe divenuto l'Oratorio, proclamata congregazione da Papa Gregorio XIII nel 1575. San Filippo Neri nella sua lunga vita fu amico di Sant'Ignazio e del cardinale Carlo Borromeo, ma quando gli fu chiesto se volesse diventare cardinale disse che preferiva il Paradiso. Fu proclamato santo nel 1622."},{"language":"en-US","title":"Saint Philip Neri: I Prefer Heaven","overview":"One of the most popular saints of all time, St. Philip Neri was widely known for his great charity, deep prayer life, and tremendous humor. Hoping to join St. Ignatius of Loyola's new order of Jesuits and be a missionary to India, Philip was instead guided by Providence to seek out the poor and abandoned youth of Rome to catechize them in the faith and help them find a better life. He became the founder of the religious congregation, the Oratory, that worked with the youth and also labored to re-evangelize a decadent Rome."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/2ha8OBeNiM1XgDIUAgM3JjMTnU7.jpg","background":"https://image.tmdb.org/t/p/original/46sS65nIC5KvkKHPXyZCJ4nNfDo.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":121576,"type":"movie","originalLanguage":"it-IT","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/2ha8OBeNiM1XgDIUAgM3JjMTnU7.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/2ha8OBeNiM1XgDIUAgM3JjMTnU7.jpg","language":"it","width":527,"height":750},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/2ha8OBeNiM1XgDIUAgM3JjMTnU7.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/2ha8OBeNiM1XgDIUAgM3JjMTnU7.jpg","language":"it","width":527,"height":750}]},"en":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/z9OsQoM343WsIrP0zMEE06pO1vH.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/z9OsQoM343WsIrP0zMEE06pO1vH.jpg","language":"en","width":900,"height":1305},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/z9OsQoM343WsIrP0zMEE06pO1vH.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/z9OsQoM343WsIrP0zMEE06pO1vH.jpg","language":"en","width":900,"height":1305}]},"xx":{"status":"missing","candidates":[]}},"background":{"it":{"status":"missing","candidates":[]},"en":{"status":"missing","candidates":[]},"xx":{"status":"available","selected":{"type":"backdrop","url":"https://image.tmdb.org/t/p/original/46sS65nIC5KvkKHPXyZCJ4nNfDo.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/46sS65nIC5KvkKHPXyZCJ4nNfDo.jpg","language":"xx","width":1280,"height":720},"candidates":[{"type":"backdrop","url":"https://image.tmdb.org/t/p/original/46sS65nIC5KvkKHPXyZCJ4nNfDo.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/46sS65nIC5KvkKHPXyZCJ4nNfDo.jpg","language":"xx","width":1280,"height":7