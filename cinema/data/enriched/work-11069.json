katere","profile":"https://image.tmdb.org/t/p/original/fjWlLItPuKWUZ3VHwvXylSOVcRJ.jpg"},{"id":4234280,"name":"Nikita Semyonov","role":"episode","profile":"https://image.tmdb.org/t/p/original/g6z5JUgwbXSOKPDWbMUBMu6dpfu.jpg"},{"id":1201370,"name":"Anna von Haebler","role":"Nina","profile":"https://image.tmdb.org/t/p/original/l27vrgPvklGApTuB25HKA8u9TyZ.jpg"},{"id":5949957,"name":"Aleksandr Suvorov","role":"матрос","profile":"https://image.tmdb.org/t/p/original/8aLIQhePy0UwAkm6w2g0RIvUdWq.jpg"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","title":"Stalingrad","overview":"Autunno del 1942, la città di Stalingrado è devastata dalle truppe naziste. Dopo un'azione bellica non riuscita, alcuni soldati russi lottano per stabilirsi dentro ad un edificio che, situato nei pressi delle rive del Volga, risulta di strategica importanza per la difesa. In una casa di quello stesso stabile vive una giovane donna, rifiutatasi di lasciare la propria città dopo l'arrivo dei tedeschi, che stabilirà un rapporto d'affetto con cinque soldati. Dalla parte dei nemici, intanto, il comandante Kahn si invaghisce della russa Masha.","tagline":"Una battaglia diventa leggenda!"},{"language":"en-US","title":"Stalingrad","overview":"A band of determined Russian soldiers fight to hold a strategic building in their devastated city against a ruthless German army, and in the process become deeply connected to a Russian woman who has been living there.","tagline":"The epic battle that turned the tide of World War II"},{"language":"ru-RU","overview":"1942-й год. Сталинград. Советские войска планируют контрнаступление на немецкие части, оккупировавшие берег Волги. Наступление сорвано. Лишь разведчикам под командованием капитана Громова удается перебраться на другой берег и закрепиться в одном из домов. Им дан приказ удержать его любой ценой. Кроме нескольких чудом уцелевших советских солдат они находят в доме его последнюю жительницу - 19-летнюю Катю.  Приказ отбить дом, захваченный противником, получает немецкий офицер Кан. На фоне одного из самых кровопролитных сражений в истории человечества разворачиваются истории любви и драматического противостояния характеров.","tagline":"Эпическая битва, которая перевернула ход Второй мировой войны"}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/o42FvkcHG5JrIHhYiNiymTDRoSE.jpg","background":"https://image.tmdb.org/t/p/original/ltji3cISxWL83DW5ngYxI89MepJ.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":203793,"type":"movie","originalLanguage":"ru-RU","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/o42FvkcHG5JrIHhYiNiymTDRoSE.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/o42FvkcHG5JrIHhYiNiymTDRoSE.jpg","language":"it","width":750,"height":1125},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/o42FvkcHG5JrIHhYiNiymTDRoSE.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/o42FvkcHG5JrIHhYiNiymTDRoSE.jpg","language":"it","width":750,"height":1125}]},"en":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/pk2d5ahR9g4R3YDlhNA5m1vHhFv.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/pk2d5ahR9g4R3YDlhNA5m1vHhFv.jpg","language":"en","width":1400,"height":2100},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/pk2d5ahR9g4R3YDlhNA5m1vHhFv.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/pk2d5ahR9g4R3YDlhNA5m1vHhFv.jpg","language":"en","width":1400,"height":2100},{"type":"poster","url":"https://image.tmdb.org/t/p/original/roK6b2qNTreXqxFl1iI8pPoB0Li.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/roK6b2qNTreXqxFl1iI8pPoB0Li.jpg","language":"en","width":1400,"height":2100},{"type":"poster","url":"https://image.tmdb.org/t/p/original/6AZTihsvNV8EsYTQ6jfcMl0AP77.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/6AZTihsv