000Z","original_url_field":null,"reference":{"base":"streamingunity:images","path":"/images/50d05266-9ebf-445d-886b-c02fb7d91056.webp"},"provider":"streamingunity"}],"episodeMappingUncertain":false,"seasons":[],"provenance":{},"warnings":[],"externalIdsEvidence":{"wikidata":{"source":"wikidata","sourceUrl":"https://www.wikidata.org/wiki/Q1273736","wikidataId":"Q1273736","tmdbId":1679,"type":"movie","imdbId":"tt0048127","tvdbId":18725}},"externalMedia":{"tmdb":{"source":"tmdb-api","id":1679,"type":"movie","sourceUrl":"https://www.themoviedb.org/movie/1679","fetchedAt":"2026-11-07T22:22:03.513Z","originalLanguage":"ja-JP","title":{"value":"Godzilla - Il Re Dei Mostri","language":"it-IT"},"originalTitle":"ゴジラの逆襲","overview":{"value":"In attesa di soccorsi su un'isola deserta, due uomini assistono al combattimento tra Godzilla e un altro mostro preistorico. I due uomini fanno giusto in tempo a fotografare le due creature prima che precipitino in mare. Le foto vengono consegnate al professor Yamane, che riconosce nell'avversario di Godzilla un Anchilosauro probabilmente mutato anch'esso dalle radiazioni, che viene battezzato Angilas. I due mostri riemergono ad Osaka, trasformandola in un campo di battaglia sotto i colpi dell'esercito...","language":"it-IT"},"tagline":{"value":"Una storia tremenda e sorprendente che imperversa in tutta la nazione del Giappone!","language":"it-IT"},"releaseDate":"1955-04-24","status":"Released","rating":6,"ratingCount":353,"genres":["Fantascienza","Horror","Azione"],"countries":["Japan"],"facts":{"Runtime":"82m"},"keywords":[],"networks":[],"socialLinks":{},"cast":[{"id":18607,"name":"Hiroshi Koizumi","role":"Shoichi Tsukioka","profile":"https://image.tmdb.org/t/p/original/37i54gRXt1mvLXt9K7dxlXmPee6.jpg"},{"id":18608,"name":"Setsuko Wakayama","role":"Hidemi Yamaji","profile":"https://image.tmdb.org/t/p/original/5UrI66vwMJgmtbw4ZjQu1JjWi6w.jpg"},{"id":7454,"name":"Minoru Chiaki","role":"Kôji Kobayashi","profile":"https://image.tmdb.org/t/p/original/9E3efYEg8pxANdfVLqYGiX8zJE8.jpg"},{"id":7453,"name":"Takashi Shimura","role":"Kyohei Yamane-hakase","profile":"https://image.tmdb.org/t/p/original/ydyAm2vyBbEPZRICIMqqjDm0NM9.jpg"},{"id":131194,"name":"Masao Shimizu","role":"Zoologist Dr. Tadokoro","profile":"https://image.tmdb.org/t/p/original/77QHN0Ac5Oq31R1PKQSIVX3nFzX.jpg"},{"id":1113864,"name":"Seijirô Onda","role":"Captain Terasawa of Osaka Defense Corps","profile":"https://image.tmdb.org/t/p/original/zfKODC7wPa0kFUB9PPF4Vmrt7Cc.jpg"},{"id":80714,"name":"Sonosuke Sawamura","role":"Hokkaido Branch Manager Shingo Shibeki","profile":"https://image.tmdb.org/t/p/original/c1C2iV7mp1TtIrwN1aLAigZiwBD.jpg"},{"id":17540,"name":"Yoshio Tsuchiya","role":"Tajima, Member of Osaka Defense Corps","profile":"https://image.tmdb.org/t/p/original/kJS04UByTERRVYF7TwozrXwh5cs.jpg"},{"id":1113865,"name":"Mayuri Mokushô","role":"Radio Operator Yasuko Inouye","profile":"https://image.tmdb.org/t/p/original/aByFgaKhny6MubVk6yHejnpxeh1.jpg"},{"id":980381,"name":"Minosuke Yamada","role":"Chief of Civil Defense","profile":"https://image.tmdb.org/t/p/original/7X4YVArkGtjx8Hl6HSgxwWOI3zo.jpg"},{"id":1113866,"name":"Yukio Kasama","role":"Koehi Wamaji, President of the Fishery"},{"id":552166,"name":"Senkichi Ōmura","role":"Small Escaped Convict","profile":"https://image.tmdb.org/t/p/original/hRLeplP5SobQSm3QcQy1REsn9yH.jpg"},{"id":931393,"name":"Ren Yamamoto","role":"Commander of Landing Craft","profile":"https://image.tmdb.org/t/p/original/aCDqBF6VppuIKWxqIgPTvmsSZd7.jpg"},{"id":552174,"name":"Shin Ōtomo","role":"Convict Leader","profile":"https://image.tmdb.org/t/p/original/efd6F1rj3qu18nuF7ANaYumdfDa.jpg"},{"id":552168,"name":"Takeo Oikawa","role":"Osaka Municipal Police Commissioner"},{"id":552170,"name":"Shōichi Hirose","role":"Convict","profile":"https://image.tmdb.org/t/p/original/6GPbRH8GNvGygu9Bj77XeFr5l8w.jpg"},{"id":1478369,"name":"Teruko Mita","role":"'Yayoi' Madam","profile":"https://image.tmdb.org/t/p/original/frGFLjkWF8Xn5KAtrsGoHSTz7jq.jpg"},{"id":235722,"name":"Haruo Nakajima","role":"Godzilla","profile":"https://image.tmdb.org/t/p/original/yZYuoFGAMjRIAen3ThTk2Hi0LvI.jpg"},{"id":1185640,"name":"Katsumi Tezuka","role":"Anguirus","profile":"https://image.tmdb.org/t/p/original/ygykXHsIOvfP65A5mftigskKwJ7.jpg"},{"id":1478370,"name":"Miyoko Hoshino","role":"Cabaret Singer"},{"id":1478371,"name":"Toku Ihara","role":"Policeman"},{"id":552169,"name":"Takuzō Kumagai","role":"Hokkai-Maru Captain","profile":"https://image.tmdb.org/t/p/original/xanW6GbvZk53ITGXltY3tbj6KxO.jpg"},{"id":87544,"name":"Tadao Nakamaru","role":"Policeman","profile":"https://image.tmdb.org/t/p/original/cRqoUQlUMoElBeQzqnPI9nuMiSZ.jpg"},{"id":1478372,"name":"Hideo Shibuya","role":"Visitor of Cabaret","profile":"https://image.tmdb.org/t/p/original/5IurZrIVGtjW5nVYysZISikSqi4.jpg"},{"id":552181,"name":"Shigemi Sunagawa","role":"Visitor of Cabaret"},{"id":1478373,"name":"Masaaki Tachibana","role":"Policeman"},{"id":1059891,"name":"Kôji Uno","role":"Shibeki's Assistant"},{"id":1484036,"name":"Shin Yoshida","role":"Convict"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","title":"Godzilla - Il Re Dei Mostri","overview":"In attesa di soccorsi su un'isola deserta, due uomini assistono al combattimento tra Godzilla e un altro mostro preistorico. I due uomini fanno giusto in tempo a fotografare le due creature prima che precipitino in mare. Le foto vengono consegnate al professor Yamane, che riconosce nell'avversario di Godzilla un Anchilosauro probabilmente mutato anch'esso dalle radiazioni, che viene battezzato Angilas. I due mostri riemergono ad Osaka, trasformandola in un campo di battaglia sotto i colpi dell'esercito...","tagline":"Una storia tremenda e sorprendente che imperversa in tutta la nazione del Giappone!"},{"language":"en-US","title":"Godzilla Raids Again","overview":"Two fishing scout pilots make a horrifying discovery when they encounter a second Godzilla alongside a new monster named Anguirus. Without the weapon that killed the original, authorities attempt to lure Godzilla away from the mainland. But Anguirus soon arrives and the two monsters make their way towards Osaka as Japan braces for tragedy.","tagline":"A tremendous, astonishing story that rages across the nation of Japan!"},{"language":"ja-JP","title":"ゴジラの逆襲","overview":"ゴジラシリーズ第2作。岩戸島に遭難した飛行士によって、ゴジラとアンキロサウルス、通称アンギラスの闘いが目撃された。対策本部はゴジラを監視下に置き、本土上陸を阻止しようとする。しかし、脱走した囚人が起こしたコンビナートの火災が、ゴジラを大阪に誘導してしまう。そしてゴジラを追って、アンギラスも姿を現わした。世紀の闘争の末、アンギラスは倒れゴジラは海へ去ったが、大阪の街は廃虚と化す……。","tagline":"怪獣ゴジラ対新登場の暴龍アンギラス 日本全土狭しと暴れ廻る驚天動地の巨篇！"}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/azduOL0fZdGIz1ZB8Oos4sTB2oG.jpg","background":"https://image.tmdb.org/t/p/original/xJgVSEl4HnRl4UscJRQn9Rfubet.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":1679,"type":"movie","originalLanguage":"ja-JP","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/azduOL0fZdGIz1ZB8Oos4sTB2oG.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/azduOL0fZdGIz1ZB8Oos4sTB2oG.jpg","language":"it","width":500,"height":750},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/azduOL0fZdGIz1ZB8Oos4sTB2oG.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/azduOL0fZdGIz1ZB8Oos4sTB2oG.jpg","language":"it","width":500,"height":750}]},"en":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/bBYdh9tDCyLaArBOzE38QCA7C3y.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/bBYdh9tDCyLaArBOzE38QCA7C3y.jpg","language":"en","width":1208,"height":1809},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/bBYdh9tDCyLaArBOzE38QCA7C3y.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/bBYdh9tDCyLaArBOzE38QCA7C3y.jpg","language":"en","width":1208,"height":1809},{"type":"poster","url":"https:/