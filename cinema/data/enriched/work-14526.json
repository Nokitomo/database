unica mano. Determinato a provare la veridicità della sua teoria, inizia ad investigare con l'aiuto di Raisa. In un sistema in cui il crimine non esiste ufficialmente, sostenere l'esistenza di un serial killer rende automaticamente Leo un nemico dello Stato: un'ottima occasione per Vasili, che non stava aspettando altro per liberarsi definitivamente di lui."},{"id":98824,"translatable_type":"title","translatable_id":6432,"locale":"it","key":"release_date","value":"2015-03-15"},{"id":98823,"translatable_type":"title","translatable_id":6432,"locale":"it","key":"slug","value":"child-44-il-bambino-n-44"},{"id":52171,"translatable_type":"title","translatable_id":6432,"locale":"it","key":"views","value":"31455"}],"keywords":[{"id":37,"name":"murder","created_at":"2023-05-18T11:48:50.000000Z","updated_at":"2023-05-18T11:48:50.000000Z","pivot":{"title_id":6432,"keyword_id":37}},{"id":74,"name":"based on novel or book","created_at":"2023-05-18T11:48:55.000000Z","updated_at":"2023-05-18T11:48:55.000000Z","pivot":{"title_id":6432,"keyword_id":74}},{"id":360,"name":"military","created_at":"2023-05-18T11:50:21.000000Z","updated_at":"2023-05-18T11:50:21.000000Z","pivot":{"title_id":6432,"keyword_id":360}},{"id":368,"name":"serial killer","created_at":"2023-05-18T11:50:25.000000Z","updated_at":"2023-05-18T11:50:25.000000Z","pivot":{"title_id":6432,"keyword_id":368}},{"id":745,"name":"soviet union","created_at":"2023-05-18T11:52:27.000000Z","updated_at":"2023-05-18T11:52:27.000000Z","pivot":{"title_id":6432,"keyword_id":745}},{"id":1628,"name":"1950s","created_at":"2023-05-18T11:56:50.000000Z","updated_at":"2023-05-18T11:56:50.000000Z","pivot":{"title_id":6432,"keyword_id":1628}},{"id":5880,"name":"child murder","created_at":"2023-05-18T12:38:30.000000Z","updated_at":"2023-05-18T12:38:30.000000Z","pivot":{"title_id":6432,"keyword_id":5880}},{"id":9009,"name":"stalinism","created_at":"2023-06-30T07:01:23.000000Z","updated_at":"2023-06-30T07:01:23.000000Z","pivot":{"title_id":6432,"k