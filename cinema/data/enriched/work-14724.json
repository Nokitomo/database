org/t/p/original/cDkIwmfjChprlO7qaoDQl1Em54P.jpg"},{"id":64880,"name":"Choi Min-sik","role":"Wanderer (voice)","profile":"https://image.tmdb.org/t/p/original/sd7gIA6nEkq6zumkDCfxSE0YSSV.jpg"},{"id":138527,"name":"Park Cheol-min","role":"Mayor (voice)","profile":"https://image.tmdb.org/t/p/original/7IZSnaNTuK2vBHJuhc0iR31iq56.jpg"},{"id":3609598,"name":"Kim Sang-hyun","role":"One-Eye (voice)","profile":"https://image.tmdb.org/t/p/original/kATqWttboXBqWtfwxM284aGfxl7.jpg"},{"id":578825,"name":"Jeon Sook-kyung","role":"Jjaek (voice)","profile":"https://image.tmdb.org/t/p/original/hSTvmcfruo26G9RQl6cnzfpQuPR.jpg"},{"id":1648983,"name":"Um Sang-hyun","role":"Rooster (voice)","profile":"https://image.tmdb.org/t/p/original/bjtERD0cm5fiVxxLstbjs2XHvqY.jpg"},{"id":1912175,"name":"Sa Seong-ung","role":"Red Head (voice)"},{"id":3005455,"name":"Kim Ji-hye","role":"Wanderer's Mate / Yard Hen (voice)"},{"id":3005462,"name":"Seo Seung-won","role":"Owl / Duck Captain (voice)","profile":"https://image.tmdb.org/t/p/original/nrZNvhK7QGBQcD46TCPD2xMSOa3.jpg"},{"id":3011537,"name":"Han Shin-jeong","role":"Young Greenie / Barnyard Duck (voice)"},{"id":1485137,"name":"Hong Bum-ki","role":"Bat / Kanjugi (voice)","profile":"https://image.tmdb.org/t/p/original/sPEAXhXAZAAwbch9XgB7NapJC7N.jpg"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","title":"Leafie - La storia di un amore","overview":"In un allevamento di polli tra centinaia di galline si trova Leafie, una creatura straordinaria che sogna una vita fuori dalla gabbia. Leafie riesce a sfuggire dalla prigionia usando la sua intelligenza e, mentre si avventura nel bosco alla ricerca di se stessa, viene braccata da una feroce donnola chiamata One Eye. Leafie si salva grazie all'aiuto dell'anatra coraggiosa, Wanderer..."},{"language":"en-US","title":"Leafie, a Hen Into the Wild","overview":"Based on a bestselling preteen novel of the same title that has sold more than 1 million copies in Korea, “Leafie, A Hen into the Wild” is about a laying hen named Leafie who is destined to live the “same old” repetitive life confined on the chicken farm.  Her fate changes when she escapes from the chicken farm and hatches a duck egg. With the duckling (who believes Leafie to be his mother), sets off on a journey into the wild with her new son to find her freedom.","tagline":"A story of love, sacrifice and courage"},{"language":"ko-KR","overview":"양계장을 탈출해 세상 밖으로 나온 암탉 ‘잎싹’과 청둥오리 ‘초록’의  꿈과 자유를 향한 용감한 도전  마당 밖 자유로운 세상을 꿈꾸는 암탉!  양계장 안에 갇혀 살며 알만 낳던 암탉 잎싹은 마당으로 나가 자유롭게 살면서 알을 품어보기를 꿈꾼다. 몇 날 며칠을 굶어 폐계 흉내를 내다가 드디어 뒷산의 폐계 웅덩이에 버려져 마당을 나오는데 성공하지만, 애꾸눈 족제비에게 잡아 먹히기 일보직전! 청둥오리 나그네의 도움으로 폐계 웅덩이에서 벗어나 가까스로 목숨을 구하게 되는데…  암탉, 오리알을 품다!  드디어 대자연으로 나온 잎싹은 나그네와 달수의 도움을 받아 자유를 만끽하며 서서히 적응해 나간다. 그러던 어느 날 주인 없이 버려진 뽀얀 오리알을 발견하고 난생 처음 알을 품기 시작하는 잎싹. 애꾸눈 족제비로부터 잎싹과 알을 보호하던 나그네는 최후를 맞이하고 마침내 알에서 깨어난 아기 오리는 잎싹을 ‘엄마’로 여기게 되는데…  겁 없는 엄마와 아들의 용감한 도전!!  족제비의 위협으로부터 안전한 늪으로 여정을 떠나는 암탉 잎싹과 청둥오리 초록  과연 이들은 험난한 대자연 속에서 더 자유롭고 더 높이 날고 싶은 꿈을 이루어 낼 수 있을까?","tagline":"˝다른게 뭐 어때서?˝ 달라도 너무 다른 엄마와 아들의 용감한 도전!"}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/cdShxXk13BC5NHNTWjxXpYhkezd.jpg","background":"https://image.tmdb.org/t/p/original/nsu4eCB9b5MXJKqVLhlQgAcCa2B.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":89623,"type":"movie","originalLanguage":"ko-KR","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/cdShxXk13BC5NHNTWjxXpYhkezd.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/cdShxXk13BC5NHNTWjxXpYhkezd.jpg","language":"it","width":1000,"height":1500},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/cdShxXk13BC5NHNTWjxXpYhkezd.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/cdShxXk13BC5NHNTWjxXpYhkezd.jpg","language":"it","width":1000,"height":1500}]},"en":{"status":"available","selected":{"type":"post