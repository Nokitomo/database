ebkL5bj4XkwdNknLmS.jpg"},{"id":1256888,"name":"Mina Ōba","profile":"https://image.tmdb.org/t/p/original/rZWAC7Aide4XXGtV28QfNXBcMHE.jpg"},{"id":550606,"name":"Mayumi Shintani","profile":"https://image.tmdb.org/t/p/original/s3aH3ZIFf03YqjVLHIHXG9RJuRl.jpg"},{"id":1129848,"name":"Toshihiro Yashiba","profile":"https://image.tmdb.org/t/p/original/spZDzLdREY66MMUVzGV7GnOWA1j.jpg"},{"id":1800311,"name":"Kento Ogura"},{"id":4631550,"name":"Tadaaki Yamada","profile":"https://image.tmdb.org/t/p/original/g3wm0FqFKDPnY80cIoYE4Fd67fo.jpg"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","title":"Anime Supremacy!","overview":"Decisa a dare una svolta alla sua vita professionale, Hitomi è entrata in una società di produzione di film d'animazione, dove ha impiegato anni a farsi strada e ora, finalmente, è stata incaricata di dirigere una serie anime. Tuttavia, per realizzare un prodotto che la soddisfi, deve ottenere la collaborazione di uno staff di testardi animatori dai metodi ancora artigianali. In più, il produttore è concentrato sul profitto e non dà tregua alla novellina Hitomi. Come se non bastasse, il suo anime è in programma nella stessa fascia oraria dell'attesissimo nuovo anime di Chiharu, una regista ritenuta geniale. Hitomi si sente schiacciata dalla pressione, ma anche Chiharu, apparentemente molto sicura di sé, sente il peso delle aspettative di tutti..."},{"language":"en-US","title":"Anime Supremacy!","overview":"Hitomi Saito has been climbing the ranks for years and is set to direct an anime series for the first time, while brilliant director Chiharu Oji is about to make his big comeback after nearly a decade."},{"language":"ja-JP","overview":"連続アニメ『サウンドバック 奏の石』で夢の監督デビューが決定した斎藤瞳。だが、気合いが空回りして制作現場には早くも暗雲が…。瞳を大抜擢してくれたはずのプロデューサー・行城理は、ビジネス最優先で瞳にとって最大のストレスメーカー。「なんで分かってくれないの！」だけど日本中に最高のアニメを届けたい！ そんなワケで目下大奮闘中。最大のライバルは『運命戦線リデルライト』。瞳も憧れる天才・王子千晴監督の復帰作だ。王子復活に懸けるのはその才能に惚れ抜いたプロデューサーの有科香屋子…しかし、彼女も王子の超ワガママ、気まぐれに振り回され「お前、ほんっとーに、ふざけんな！」と、大大悪戦苦闘中だった。瞳は一筋縄じゃいかないスタッフや声優たちも巻き込んで、熱い“想い”をぶつけ合いながら “ハケン＝覇権” を争う戦いを繰り広げる！！その勝負の行方は！？ アニメの仕事人たちを待つのは栄冠か？ 果たして、瞳の想いは人々の胸に刺さるのか？","tagline":"好きを、つらぬけ。"}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/hlom3uDLj2ZM2cHdcA8HWbGm4Sz.jpg","background":"https://image.tmdb.org/t/p/original/Agd1mwkZ4bT7EGbdx6j8CsHebTs.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":947166,"type":"movie","originalLanguage":"ja-JP","series":{"poster":{"it":{"status":"missing","candidates":[]},"en":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/2Lin1w6GuvpkRxrah7k3IOJz7HE.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/2Lin1w6GuvpkRxrah7k3IOJz7HE.jpg","language":"en","width":1000,"height":1500},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/2Lin1w6GuvpkRxrah7k3IOJz7HE.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/2Lin1w6GuvpkRxrah7k3IOJz7HE.jpg","language":"en","width":1000,"height":1500}]},"ja":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/hlom3uDLj2ZM2cHdcA8HWbGm4Sz.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/hlom3uDLj2ZM2cHdcA8HWbGm4Sz.jpg","language":"ja","width":2000,"height":3000},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/hlom3uDLj2ZM2cHdcA8HWbGm4Sz.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/hlom3uDLj2ZM2cHdcA8HWbGm4Sz.jpg","language":"ja","width":2000,"height":3000},{"type":"poster","url":"https://image.tmdb.org/t/p/original/dnlJwCbA4hOJRylgR4lP4nfF4F4.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/dnlJwCbA4hOJRylgR4lP4nfF4F4.jpg","language":"ja","width":2000,"height":2829},{"type":"poster","url":"https://image.tmdb.org/t/p/original/ig6tHGs4g81aEAkbyOSHxvMLTcy.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/ig6tHGs4g81aEAkbyOSHxvMLTcy.jpg","language":"ja","width":849,"height":1200},{"type":"poster","url":"