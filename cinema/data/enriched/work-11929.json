res":["Dramma","Thriller"],"countries":["France","Italy"],"facts":{"Runtime":"123m"},"keywords":[],"networks":[],"socialLinks":{},"cast":[{"id":15135,"name":"Alain Delon","role":"Jean-Paul","profile":"https://image.tmdb.org/t/p/original/u4nu4YAQfwuy5Dnxlk28Z5eNA1S.jpg"},{"id":6250,"name":"Romy Schneider","role":"Marianne","profile":"https://image.tmdb.org/t/p/original/7ZM51RfI5oMx8Q5hpyYZ7MyD6Do.jpg"},{"id":15395,"name":"Maurice Ronet","role":"Harry","profile":"https://image.tmdb.org/t/p/original/n59auqYzna4exH96CFzGA1l7TAb.jpg"},{"id":15200,"name":"Jane Birkin","role":"Penelope","profile":"https://image.tmdb.org/t/p/original/nkg4tcwseZMHtDmdpFfZqK2mP6a.jpg"},{"id":35003,"name":"Paul Crauchet","role":"L'inspecteur Lévêque","profile":"https://image.tmdb.org/t/p/original/sEf90lQocXbTDjFrqwWwTibn2ab.jpg"},{"id":2104037,"name":"Suzie Jaspard","role":"Emilie"},{"id":1606879,"name":"Maddly Bamy","role":"La mulâtre","profile":"https://image.tmdb.org/t/p/original/riPro7PpN8GyS7lCBo7XWngntCj.jpg"},{"id":122570,"name":"Thierry Chabert","role":"Un ami","profile":"https://image.tmdb.org/t/p/original/5VB5ivGJndzIzwVq69C3zLvTOtl.jpg"},{"id":1307054,"name":"Steve Eckardt","role":"Fred","profile":"https://image.tmdb.org/t/p/original/cEDud9DduhOvjD1SVoQmmI1wy4I.jpg"},{"id":3465467,"name":"Ruth Price","role":"Singer (uncredited)"},{"id":2104043,"name":"Stéphanie Fugain","role":"Une amie à la party (uncredited)","profile":"https://image.tmdb.org/t/p/original/1Ul74tpPuvOB8E2XJdr285HWqIo.jpg"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","title":"La piscina","overview":"Due amanti che trascorrono le ferie in una villa vengono raggiunti da un ex spasimante di lei e da quella che lui presenta come sua figlia. Ben presto i due uomini diventano rivali, soprattutto a causa delle premurose attenzioni che il nuovo arrivato rivolge alla donna. L'altro, dopo essere andato a letto con la ragazza per vendicarsi, litiga con il \"padre\" di costei e lo uccide annegandolo. La polizia non trova le prove dell'omicidio e l'uomo resterà per sempre con l'amante, legata a lui dal silenzio complice.","tagline":"Il gioco d'amore più pericoloso mai giocato."},{"language":"en-US","title":"The Swimming Pool","overview":"Set in a magnificent villa near a sun-drenched St. Tropez, lovers Jean-Paul and Marianne are spending a happy, lazy summer holiday. Their only concern is to gratify their mutual passion - until the day when Marianne invites her former lover and his beautiful teenage daughter to spend a few days with them. From the first moment, a certain uneasiness and tension begin to develop between the four, which soon escalates in a dangerous love-game.","tagline":"The most dangerous love-game ever played"},{"language":"fr-FR","overview":"Jean-Paul et Marianne forment un couple idéal et coulent des jours heureux dans leur villa de Saint-Tropez, jusqu'au jour où arrive Harry, au bras de l'incendiaire Pénélope. Ancien amant de Marianne, l'homme trouble cette vie tranquille. La tension monte.","tagline":"Le premier est sorti… le dernier est mort !"}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/imujVE5km5hNFaY3NMWLPGSak7Y.jpg","background":"https://image.tmdb.org/t/p/original/fYEkL31wAb0k4Uk5ZcSN5XrStvi.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":4946,"type":"movie","originalLanguage":"fr-FR","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/imujVE5km5hNFaY3NMWLPGSak7Y.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/imujVE5km5hNFaY3NMWLPGSak7Y.jpg","language":"it","width":1000,"height":1500},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/imujVE5km5hNFaY3NMWLPGSak7Y.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/imujVE5km5hNFaY3NMWLPGSak7Y.jpg","language":"it","width":1000,"height":1500},{"type":"poster","url":"https:/