ani."},{"language":"en-US","overview":"A social worker dedicates himself to the recovery of children who have dropped out of school in the streets of Naples thanks to the circus arts. His work, however, is not well received by the families of the neighborhood and the courage of these children, with their stilts and their red noses, will clash with the harsh reality."}],"images":{"logos":[{"type":"logo","url":"https://image.tmdb.org/t/p/original/g5bEcahib2RW8N1oPzm90I82KUi.png","previewUrl":"https://image.tmdb.org/t/p/w300/g5bEcahib2RW8N1oPzm90I82KUi.png","language":"it","width":800,"height":165}],"posters":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/7rinMnnmRdmjbwfNPXbIp0katq6.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/7rinMnnmRdmjbwfNPXbIp0katq6.jpg","language":"it","width":857,"height":1286},{"type":"poster","url":"https://image.tmdb.org/t/p/original/tRpFFPAvaNsVxD2qCD1QaWAWdvR.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/tRpFFPAvaNsVxD2qCD1QaWAWdvR.jpg","language":"it","width":1000,"height":1500},{"type":"poster","url":"https://image.tmdb.org/t/p/original/w1vUpyIvb87hrycVoj7bpSAaznQ.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/w1vUpyIvb87hrycVoj7bpSAaznQ.jpg","language":"it","width":1920,"height":2560}],"backdrops":[{"type":"backdrop","url":"https://image.tmdb.org/t/p/original/mwaoDTH5jFEbsxvsIQr0Bfk1Pvh.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/mwaoDTH5jFEbsxvsIQr0Bfk1Pvh.jpg","language":"xx","width":1500,"height":844},{"type":"backdrop","url":"https://image.tmdb.org/t/p/original/u30PDKQMCTRlsMGznyjOzuRr3kN.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/u30PDKQMCTRlsMGznyjOzuRr3kN.jpg","language":"xx","width":1920,"height":1080}]},"logo":"https://image.tmdb.org/t/p/original/g5bEcahib2RW8N1oPzm90I82KUi.png","poster":"https://image.tmdb.org/t/p/original/7rinMnnmRdmjbwfNPXbIp0katq6.jpg","background":"https://image.tmdb.org/t/p/original/mwaoDTH5jFEbsxvsIQr0Bfk1Pvh.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tm