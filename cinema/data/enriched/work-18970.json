. Чтобы найти организаторов группы, Дане придётся вступить в опасную игру на выживание."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/4JVFbNE256dzKj9q6t0018cCIbt.jpg","background":"https://image.tmdb.org/t/p/original/sKdDC38FHuPvEsRgIzMEQE6ydol.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":714567,"type":"movie","originalLanguage":"ru-RU","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/4JVFbNE256dzKj9q6t0018cCIbt.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/4JVFbNE256dzKj9q6t0018cCIbt.jpg","language":"it","width":1000,"height":1500},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/4JVFbNE256dzKj9q6t0018cCIbt.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/4JVFbNE256dzKj9q6t0018cCIbt.jpg","language":"it","width":1000,"height":1500}]},"en":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/2TmZ2lgDEYJAFpeUMALRx5NwqK.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/2TmZ2lgDEYJAFpeUMALRx5NwqK.jpg","language":"en","width":664,"height":997},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/2TmZ2lgDEYJAFpeUMALRx5NwqK.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/2TmZ2lgDEYJAFpeUMALRx5NwqK.jpg","language":"en","width":664,"height":997}]},"ru":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/S35xx6XA75qgSbgtCTIjZhSdh0.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/S35xx6XA75qgSbgtCTIjZhSdh0.jpg","language":"ru","width":2000,"height":3000},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/S35xx6XA75qgSbgtCTIjZhSdh0.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/S35xx6XA75qgSbgtCTIjZhSdh0.jpg","language":"ru","width":2000,"height":3000},{"type":"poster","url":"https://image.tmdb.org/t/p/original/wNQuRpVSETj15ht8knrTZgEOoTn.jpg"