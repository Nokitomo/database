ofile":"https://image.tmdb.org/t/p/original/lbWFuZ74lLkOyOldekjvmphCXcI.jpg"},{"id":2454083,"name":"Lea Drinda","role":"Erika","profile":"https://image.tmdb.org/t/p/original/1HYkiGcfdo9Gc5klqbRHpn1jJ4P.jpg"},{"id":4442495,"name":"Hanna Heckt","role":"Alma","profile":"https://image.tmdb.org/t/p/original/2J3D3K3xl8khTlE69dGbM0gwM5m.jpg"},{"id":4330239,"name":"Laeni Geiseler","role":"Lenka","profile":"https://image.tmdb.org/t/p/original/1olxz20LvIJWhTMmjUQiUNVkjcu.jpg"},{"id":4394538,"name":"Florian Geißelmann","role":"Rainer","profile":"https://image.tmdb.org/t/p/original/xhV02KqmDxu4pAJdEwQ4WuCAJlS.jpg"},{"id":1327557,"name":"Andreas Anke","role":"Albat","profile":"https://image.tmdb.org/t/p/original/m3TJ8fvu8tq7d8jkL6P73Y5VINS.jpg"},{"id":49204,"name":"Susanne Wuest","role":"Emma","profile":"https://image.tmdb.org/t/p/original/digwuYrLyKVJVTW8BAgGCFduRta.jpg"},{"id":46987,"name":"Gode Benedix","role":"Max","profile":"https://image.tmdb.org/t/p/original/3ZfiXWGPSH0afk0w13KHyorZpZu.jpg"},{"id":2002963,"name":"Bärbel Schwarz","role":"Berta"},{"id":1288682,"name":"Lucas Prisor","role":"Hannes","profile":"https://image.tmdb.org/t/p/original/nqkXOWi60SWBqrxTZR4liSRrRZj.jpg"},{"id":1323644,"name":"Konstantin Lindhorst","role":"Uwe","profile":"https://image.tmdb.org/t/p/original/8t5wxWjf70PNan0gBCd0JVNX31E.jpg"},{"id":1950083,"name":"Luzia Oppermann","role":"Trudi","profile":"https://image.tmdb.org/t/p/original/nmcjAx3oxrvatWruYuWmhABSmfT.jpg"},{"id":1832897,"name":"Martin Rother","role":"Fritz","profile":"https://image.tmdb.org/t/p/original/2oSjYkk2Opuf1906IevQzgW6Vut.jpg"},{"id":4193344,"name":"Filip Schnack","role":"Fritz","profile":"https://image.tmdb.org/t/p/original/j6gLYTzGhAgd5s5pgXlp8lX4xZ2.jpg"},{"id":3414822,"name":"Ninel Geiger","role":"Kaya"},{"id":4442497,"name":"Greta Krämer","role":"Lia","profile":"https://image.tmdb.org/t/p/original/mENcFdDy7xM8JBhm3mlLxrnYU1U.jpg"},{"id":4442498,"name":"Zoë Baier","role":"Nelly","profile":"https://image.tmdb.org/t/p/original/d7wplrYFTkQpf7Rmws7ogO47zru.jpg"},{"id":4442499,"name":"Anastasia Cherepakha","role":"Hedda"},{"id":1738274,"name":"Liane Düsterhöft","role":"Frieda","profile":"https://image.tmdb.org/t/p/original/kXkm3Ito1PcbQJlAqUWT5MMESXq.jpg"},{"id":4442500,"name":"Helena Lüer","role":"Gerti"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","title":"Il suono di una caduta","overview":"La storia di quattro generazioni di donne di una fattoria nell'Altmark: Alma è una bambina silenziosa che cresce negli anni della grande guerra, testimone inconsapevole di un segreto legato all'amputazione di una gamba di un parente; durante il secondo dopoguerra, la sua discendente Erika è attratta da quella stessa persona; sua nipote Angelika negli anni '80 scopre la propria sessualità adolescenziale, ma è insidiata dallo zio orco: ai giorni nostri, la fattoria, diventata una casa vacanze, è testimone dell'amicizia della malinconica Lenka con una ragazza che ha perso la madre."},{"language":"en-US","title":"Sound of Falling","overview":"Four adolescent girls each spend their youth in the same farmhouse over the last century. Though separated by decades, resonances between their lives emerge: their desires and distress, secrets and truths, encounters with another’s gaze and defiant gaze in return.","tagline":"The past doesn't fade. It echoes."},{"language":"de-DE","overview":"Ein abgelegener Vierseitenhof in der Altmark, dessen Wände seit über einem Jahrhundert die Geschichten der dort lebenden Menschen tragen. Ein Hof, den einst vier Frauen bewohnten, deren Leben über verschiedene Jahrzehnten miteinander verknüpft sind. Alma, Erika, Angelika und Nelly – jede von ihnen verbringt ihre Kindheit oder Jugend auf diesem Ort, doch während sie durch ihre eigene Zeit gehen, offenbaren sich ihnen Spuren aus der Vergangenheit. Verborgene Ängste, verdrängte Traumata und lange gehütete Geheimnisse treten zu Tage. Alma erfährt, dass sie nach ihrer verstorbenen Schwester benannt wurde und fürchtet, ihr Schicksal zu teilen. Erika gerät in den Bann ihres schwer verletzten Onkels und verliert sich in gefährlichen Fantasien. Angelika schwankt zwischen Lebenslust und Todessehnsucht, während sie in einem zerrissenen Familiensystem gefangen ist. Nelly wächst in scheinbarer Sicherheit auf, doch dunkle Träume und unbewusste Erinnerungen an vergangene Ereignisse verfolgen sie.","tagline":"Die Vergangenheit verblasst nicht. Sie hallt nach."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/wgPOP0hYAkHy0YCvnFHANxWsQy1.jpg","background":"https://image.tmdb.org/t/p/original/cXr5YOMJKZBkokgNogHjEyFZLc6.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":1221061,"type":"movie","originalLanguage":"de-DE","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/wgPOP0hYAkHy0YCvnFHANxWsQy1.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/wgPOP0hYAkHy0YCvnFHANxWsQy1.jpg","language":"it","width":1524,"height":2286},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/wgPOP0hYAkHy0YCvnFHANxWsQy1.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/wgPOP0hYAkHy0YCvnFHANxWsQy1.jpg","language":"it","width":1524,"height":2286}]},"en":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/5hLiXAqZ3xTHExOIsxYANIswBjZ.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/5hLiXAqZ3xTHExOIsxYANIswBjZ.jpg","language":"en","width":1365,"height":2048},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/5hLiXAqZ3xTHExOIsxYANIswBjZ.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/5hLiXAqZ3xTHExOIsxYANIswBjZ.jpg","language":"en","width":1365,"height":2048},{"type":"poster","url":"https://image.tmdb.org/t/p/original/mv2edAI0vmheVVcv4mIVW5X8GNP.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/mv2edAI0vmheVVcv4mIVW5X8GNP.jpg","