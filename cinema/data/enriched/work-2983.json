, ma io so io... E voi non siete un cazzo!","language":"it-IT"},"releaseDate":"1981-12-23","status":"Released","rating":7.839,"ratingCount":507,"genres":["Commedia"],"countries":["France","Italy"],"facts":{"Runtime":"135m"},"keywords":[],"networks":[],"socialLinks":{},"cast":[{"id":45982,"name":"Alberto Sordi","role":"Onofrio Del Grillo","profile":"https://image.tmdb.org/t/p/original/xXCk1HKZM9MGUmQcorjuEV2vOI5.jpg"},{"id":4962,"name":"Paolo Stoppa","role":"Papa Pio VII","profile":"https://image.tmdb.org/t/p/original/3JMNHmi8734eaMT5zh453DsaaEo.jpg"},{"id":1200785,"name":"Caroline Berg","role":"Olimpia","profile":"https://image.tmdb.org/t/p/original/fErs2Psz1uaJCpkRF9g8zZlBm1z.jpg"},{"id":132476,"name":"Riccardo Billi","role":"Aronne Piperno","profile":"https://image.tmdb.org/t/p/original/y3gUGClMqyJMNoYh48Po8X1jLmZ.jpg"},{"id":24608,"name":"Flavio Bucci","role":"Don Bastiano","profile":"https://image.tmdb.org/t/p/original/lZoYVFD8ebEwM2VQLeVDNg62SJu.jpg"},{"id":133755,"name":"Camillo Milli","role":"Segretario del Papa","profile":"https://image.tmdb.org/t/p/original/nzc7FUYBiAPnrsRePeSvjcCJdyv.jpg"},{"id":129535,"name":"Cochi Ponzoni","role":"Conte Rambaldo","profile":"https://image.tmdb.org/t/p/original/3nmCLwCGOxAlxpVoZx0sZj8dYhJ.jpg"},{"id":24597,"name":"Marc Porel","role":"Capitano Blanchard"},{"id":543681,"name":"Pietro Tordi","role":"Monsignor Terenzio Del Grillo","profile":"https://image.tmdb.org/t/p/original/kIpvNHHea2rPIUCoiNy9g8UpK3e.jpg"},{"id":14151,"name":"Leopoldo Trieste","role":"Padre Sabino","profile":"https://image.tmdb.org/t/p/original/rPvCj39OY7LClFh9CG2OXFKxioB.jpg"},{"id":226029,"name":"Giorgio Gobbi","role":"Ricciotto","profile":"https://image.tmdb.org/t/p/original/emCOa42vDYsXjtvWzKZo1bJ1DPS.jpg"},{"id":1034731,"name":"Isabelle Linnartz","role":"Genuflessa","profile":"https://image.tmdb.org/t/p/original/cDQTwRTLD66JMzMJmM6wKNYs0KP.jpg"},{"id":287863,"name":"Tommaso Bianco","role":"Amministratore","profile":"https://image.tmdb.org/t/p/original/ocO8WgPc6kZLMr6jVD9WR5XXKa7.jpg"},{"id":269705,"name":"Marina Confalone","role":"Camilla","profile":"https://image.tmdb.org/t/p/original/zfT4a39HmaeN3rEVetEFFRxBXzI.jpg"},{"id":33929,"name":"Elena Fiore","role":"Anita"},{"id":1384273,"name":"Elena Daskowa Valenzano","role":"Marchesa del Grillo"},{"id":1384271,"name":"Andrea Bevilacqua","role":"Polpeo"},{"id":1384272,"name":"Angela Campanella","role":"Faustina","profile":"https://image.tmdb.org/t/p/original/kfUfQ9RWQmX3nikDny8gjvzlr8g.jpg"},{"id":129568,"name":"Isabella De Bernardi","role":"Figlia di Gasperino","profile":"https://image.tmdb.org/t/p/original/payUQ7W9Qui0xpeZFblAN1xYfV4.jpg"},{"id":1384274,"name":"Gianni Di Pinto","role":"Maruccio"},{"id":119435,"name":"Ettore Geri","role":"High priest who presides over the execution","profile":"https://image.tmdb.org/t/p/original/nshJciOqanfzse6q3Sv4IqHZe8j.jpg"},{"id":2203032,"name":"Ivan De Paola"},{"id":2019184,"name":"Nicola Di Marzio"},{"id":6784,"name":"Jacques Herlin","role":"Rabet","profile":"https://image.tmdb.org/t/p/original/ztGRlFmz3GEIWpNb9uIX7TtAiFF.jpg"},{"id":1680429,"name":"Salvatore Iacono","role":"Bargello"},{"id":44421,"name":"Elisa Mainardi","role":"Moglie di Gasperino","profile":"https://image.tmdb.org/t/p/original/wWlgXjwWRln8U6oLZg5JCnQHI7v.jpg"},{"id":295908,"name":"Renzo Rinaldi","profile":"https://image.tmdb.org/t/p/original/8PfA3hpC1HuudrMQ04QdPwdsTSy.jpg"},{"id":1895497,"name":"Salvatore Biondo","role":"Monk (uncredited)"},{"id":49458,"name":"Sal Borgese","role":"giocatore di carte","profile":"https://image.tmdb.org/t/p/original/dmvigFNtAYoKrscqVLRHAUIKdwi.jpg"},{"id":225190,"name":"Mimmo Poli","role":"Oste","profile":"https://image.tmdb.org/t/p/original/ogRb16e5BplvdpngH3Txhp3Y0pb.jpg"},{"id":1600593,"name":"Arnaldo Caivano","role":"Cardinal (uncredited)"},{"id":101602,"name":"Fernando Arcangeli","role":"Prince Marcello di Valmontone (uncredited)","profile":"https://image.tmdb.org/t/p/original/v4AluKP9xRI9vkuj8Q0QaEFuhX9.jpg"},{"id":2201