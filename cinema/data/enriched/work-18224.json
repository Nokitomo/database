id":1041210,"name":"Anthony Straeger","role":"Officer Garth","profile":"https://image.tmdb.org/t/p/original/3bk6ceNgeXrnL58Ibg357sBZwaj.jpg"},{"id":1518004,"name":"Magnus Bruun","role":"Danish Soldier","profile":"https://image.tmdb.org/t/p/original/rJfZ9H00WcbNF63wKaH6d9XwoQg.jpg"},{"id":135757,"name":"Michael Asmussen","role":"Danish Sergeant","profile":"https://image.tmdb.org/t/p/original/1EB3ocRbmXYFW9k0eLl6qkFH4Uj.jpg"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","title":"Land of Mine - Sotto la sabbia","overview":"Nei giorni che seguirono la resa della Germania nazista nel maggio del 1945, i soldati tedeschi in Danimarca furono deportati e vennero messi a lavorare per quelli che erano stati i loro prigionieri. Incredibilmente attento e delicato, il film racconta il desiderio di vendetta ma anche il ritrovamento del senso di umanità di un popolo dilaniato dalla guerra."},{"language":"en-US","title":"Land of Mine","overview":"In the days following the surrender of Germany in May 1945, a group of young German prisoners of war is handed over to the Danish authorities and subsequently sent to the West Coast, where they are ordered to remove the more than two million mines that the Germans had placed in the sand along the coast. With their bare hands, crawling around in the sand, the boys are forced to perform the dangerous work under the leadership of a Danish sergeant.","tagline":"They survived the second World War, now they must survive the cleanup"},{"language":"da-DA","overview":"Maj 1945, regnskabets time efter fem års besættelse. En flok unge tyske krigsfanger sendes ud til Vestkysten, hvor de beordres til at fjerne de over 2 millioner miner, som den tyske besættelsesmagt har placeret under sandet langs kysten. Med deres bare hænder, kravlende rundt i sandet, bliver drengene tvunget til at udføre det livsfarlige arbejde under ledelse af den danske militære kaptajn, Carl Leopold Rasmussen. Filmen er inspireret af autentiske hændelser. Man antager, at over 2000 tyske soldater blev sendt ud som 'frivillige' mineryddere og at hen ved 250 tyske soldater mistede livet, mens 600 af dem blev lemlæstet.","tagline":"De overlevede 2. verdenskrig, nu skal de overleve oprydningen"}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/gNV19FeXWw8EHqRLSjinVRAYVg9.jpg","background":"https://image.tmdb.org/t/p/original/vkzeh2G7Gwapo4J1eqGWRph2hCs.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":335578,"type":"movie","originalLanguage":"da-DA","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/gNV19FeXWw8EHqRLSjinVRAYVg9.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/gNV19FeXWw8EHqRLSjinVRAYVg9.jpg","language":"it","width":600,"height":861},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/gNV19FeXWw8EHqRLSjinVRAYVg9.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/gNV19FeXWw8EHqRLSjinVRAYVg9.jpg","language":"it","width":600,"height":861}]},"en":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/7TOYH2VDnYbXpBKlrkdQZUSC3Du.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/7TOYH2VDnYbXpBKlrkdQZUSC3Du.jpg","language":"en","width":2000,"height":3000},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/7TOYH2VDnYbXpBKlrkdQZUSC3Du.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/7TOYH2VDnYbXpBKlrkdQZUSC3Du.jpg","language":"en","width":2000,"height":3000},{"type":"poster","url":"https://image.tmdb.org/t/p/original/kJqFO72XXYOGuqTfa9RHrwVEk0T.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/kJqFO72XXYOGuqTfa9RHrwVEk0T.jpg","language":"en","width":1165,"height":1747},{"type":"poster","url":"https://image.tmdb.org/t/p/original/2XEdQI7QBxIG7utsRA1SIiCGse2.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/2XEdQI7QBxIG7utsRA1SIiCGse2.jpg","lan