8315,"name":"Ranjit Deval","role":"Mallika's Father"},{"id":4436819,"name":"Amita Pavera","role":"Mallika's Mother"},{"id":5169344,"name":"Neha Mishra","role":"Nilofer"},{"id":4876396,"name":"Chetan Mishra","role":"Surma Bhopali"},{"id":2619345,"name":"Athar Nawaaz","role":"Farogh's Father"},{"id":5324939,"name":"Iqbal Shaikh","role":"Cycle Shop Repair Owner"},{"id":5324942,"name":"Harshad Shah","role":"Press Worker"},{"id":5324943,"name":"Varad Bhatnagar","role":"Halal Guy"},{"id":5324945,"name":"Pradeep Baghel","role":"Bhangarwala"},{"id":5324946,"name":"Mayuriesh Dhaliwal","role":"Guy"},{"id":5324956,"name":"Ananya Pathak","role":"Wannabe 2"},{"id":4256002,"name":"Ali Abbas","role":"Wannabe 1"},{"id":3285529,"name":"Atharva Kulkarni","role":"Orchestra Anchor"},{"id":5324958,"name":"Suyas Yashpal","role":"Announcer (Wedding 1)"},{"id":5324960,"name":"Nitin Salunke","role":"Mangal Parlor Owner (Kalute)"},{"id":5324961,"name":"Shankar Dada","role":"Ramdeo"},{"id":2474983,"name":"Dhananjay Kapoor","role":"Doctor (Nashik)"},{"id":5324964,"name":"Shakeel Dada","role":"Tailor"},{"id":5324965,"name":"Sohail Anwar Shaikh","role":"Barber"},{"id":5324966,"name":"Mukkem Arshad","role":"Atta Theif"},{"id":5324968,"name":"Nirbhay Jain","role":"Ibrahim Qaazi"},{"id":5324969,"name":"Nand Kumar Deshpande","role":"Maulvi"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","title":"I supereroi di Malegaon","overview":"Nella cittadina di Malegaon, dove solo i film aiutano a fuggire dalla realtà, il regista dilettante Nasir Shaikh riunisce un disparato gruppo di amici per girarne uno per i suoi concittadini, reclutandoli anche come attori. In questa toccante storia di cinema e amicizia, la passione supera i budget ridotti, l'ingegno vince le sfide e i sogni accendono la speranza, facendo sentire tutti più vivi."},{"language":"en-US","title":"Superboys of Malegaon","overview":"The residents of Malegaon look to Bollywood cinema for a much-needed escape from daily drudgery. Amateur filmmaker Nasir Shaikh gets inspired to make a film for the people of Malegaon, by the people of Malegaon. He bands together his ragtag group of friends to bring his vision to life, thereby bringing a fresh lease of life into the town.","tagline":"There are no rules in filmmaking."},{"language":"hi-IN","overview":"नासिर शेख (आदर्श गौरव) एक युवक है जो फिल्में बनाने का सपना देखता है, लेकिन उसके छोटे से शहर मालेगांव में केवल हिंदी मसाला फिल्मों में ही दिलचस्पी है। वह शफीक (शशांक अरोड़ा), फरोग (विनीत सिंह) और अकरम (अनुज सिंह दुहान) सहित दोस्तों के एक समूह को इकट्ठा करता है, ताकि एक फिल्म बनाई जा सके और अपने सपने को साकार किया जा सके, जिससे शहर में नया जीवन आ सके। नासिर एक शादी के कैमरामैन से उपकरण उधार लेते हैं और 1975 की फिल्म शोले का रीमेक बनाते हैं। यह फिल्म एक क्षेत्रीय हिट है, लेकिन नासिर की यात्रा कठिन होगी। यह फिल्म दोस्ती, साथ-साथ बढ़ने, दूरियां, पुनर्मिलन और सिनेमा की परिवर्तनकारी शक्ति की कहानी है।"}],"images":{"logos":[{"type":"logo","url":"https://image.tmdb.org/t/p/original/ircga5I8GlOkpuaW3KalQTBpLMX.png","previewUrl":"https://image.tmdb.org/t/p/w300/ircga5I8GlOkpuaW3KalQTBpLMX.png","language":"it","width":1996,"height":656},{"type":"logo","url":"https://image.tmdb.org/t/p/original/ssbVdQuAHFJQrmiXFD3pKwOBhXT.png","previewUrl":"https://image.tmdb.org/t/p/w300/ssbVdQuAHFJQrmiXFD3pKwOBhXT.png","language":"en","width":1996,"height":672},{"type":"logo","url":"https://image.tmdb.org/t/p/original/9QYH1Rn7RjvGDbRXnCtzRy6JRSV.png","previewUrl":"https://image.tmdb.org/t/p/w300/9QYH1Rn7RjvGDbRXnCtzRy6JRSV.png","language":"en","width":1996,"height":672}],"posters":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/2R6uHE17nQxRFtY3KPmacsbd51l.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/2R6uHE17nQxRFtY3KPmacsbd51l.jpg","language":"it","width":2000,"height":3000},{"type":"poster","url":"https://image.tmdb.org/t/p/original/kLMLaZa0Mu4BqPhA2eYbduFjcD0.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/kLMLaZa0Mu