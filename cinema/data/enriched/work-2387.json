rà per lasciarlo. Sedotti e abbandonati si rimboccheranno le maniche e proveranno a riprendersi la famiglia e una vita migliore in un'Italia senza confini e campanilismi.","language":"it-IT"},"tagline":{"value":"But when a Neapolitan goes to the North...?","language":"en-US"},"releaseDate":"2012-01-18","status":"Released","rating":5.776,"ratingCount":1361,"genres":["Commedia"],"countries":["Italy"],"facts":{"Runtime":"110m"},"keywords":[],"networks":[],"socialLinks":{},"cast":[{"id":55914,"name":"Claudio Bisio","role":"Alberto Colombo","profile":"https://image.tmdb.org/t/p/original/cDhzyPQ3446zpRmP523rPFkkl4h.jpg"},{"id":233334,"name":"Alessandro Siani","role":"Mattia Volpe","profile":"https://image.tmdb.org/t/p/original/ysZS493TskKLQtllPUO3S3Y5Bc8.jpg"},{"id":59640,"name":"Angela Finocchiaro","role":"Silvia Colombo / Erminia","profile":"https://image.tmdb.org/t/p/original/4ZgMeXRcZOBDwDLmucIB9gUkslP.jpg"},{"id":36322,"name":"Valentina Lodovini","role":"Maria Flagello","profile":"https://image.tmdb.org/t/p/original/3l2jLSzpHud4mvuTCdHW047exvR.jpg"},{"id":545137,"name":"Nando Paone","role":"Costabile Piccolo","profile":"https://image.tmdb.org/t/p/original/lUjUffdd1U96r3fGwRHnELoCe8c.jpg"},{"id":132849,"name":"Nunzia Schiano","role":"Mamma di Mattia","profile":"https://image.tmdb.org/t/p/original/wsy9KD5AKuOIFpepptImeVrs3JY.jpg"},{"id":1293959,"name":"Salvatore Misticone","role":"Scapece","profile":"https://image.tmdb.org/t/p/original/yFJQxYrJ7n5zFiYwBnVpzc29Cwi.jpg"},{"id":73873,"name":"Teco Celio","role":"Leghista","profile":"https://image.tmdb.org/t/p/original/5PUIFW0JvgoaLX1ndyJbSeBdQF0.jpg"},{"id":227847,"name":"Paolo Rossi","role":"Palmisan","profile":"https://image.tmdb.org/t/p/original/lk8jVmZ5GC7ZNmE33867a8vyRpB.jpg"},{"id":148255,"name":"Giacomo Rizzo","role":"Costabile Grande","profile":"https://image.tmdb.org/t/p/original/8OKMp1CsektxeMFKZpC1z31vzkG.jpg"},{"id":555715,"name":"Fulvio Falzarano","role":"Ciaparatt","profile":"https://image.tmdb.org/t/p/origin