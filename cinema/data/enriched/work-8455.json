un film en France, loin des villes, en voyage avec le camion photographique (et magique) de JR. Hasard des rencontres ou projets préparés, ils sont allés vers les autres, les ont écoutés, photographiés et parfois affichés. Le film raconte aussi l’histoire de leur amitié qui a grandi au cours du tournage, entre surprises et taquineries, en se riant de leurs différences."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/mTmDvvIpFZfdGQ5f4uve9eMZvPw.jpg","background":"https://image.tmdb.org/t/p/original/w4uYP6ebNaLQIjsHcjQhjz3BB2m.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":451995,"type":"movie","originalLanguage":"fr-FR","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/mTmDvvIpFZfdGQ5f4uve9eMZvPw.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/mTmDvvIpFZfdGQ5f4uve9eMZvPw.jpg","language":"it","width":1155,"height":1733},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/mTmDvvIpFZfdGQ5f4uve9eMZvPw.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/mTmDvvIpFZfdGQ5f4uve9eMZvPw.jpg","language":"it","width":1155,"height":1733}]},"en":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/1NX6NTj9FiiJwEgRUmEifSzE7Na.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/1NX6NTj9FiiJwEgRUmEifSzE7Na.jpg","language":"en","width":1000,"height":1500},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/1NX6NTj9FiiJwEgRUmEifSzE7Na.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/1NX6NTj9FiiJwEgRUmEifSzE7Na.jpg","language":"en","width":1000,"height":1500},{"type":"poster","url":"https://image.tmdb.org/t/p/original/uNbXD6Fy8ouc4PvWZnsLBjXJX8r.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/uNbXD6Fy8ouc4PvWZnsLBjXJX8r.jpg","language":"en","width":2000,"height":3000},{"type":"poster","url":"https://image.tmdb.org/t/p/original/5OfE6u