db.org/t/p/original/raW50z3LZZXOSXTwOFFUf4U3zet.jpg"},{"id":1168829,"name":"Bárbara Santa-Cruz","role":"Paciente nuevo grupo #3","profile":"https://image.tmdb.org/t/p/original/3d9MH5ZAfS8HHY4zSLL8y6XU4Du.jpg"},{"id":233947,"name":"Daniel Grao","role":"Paciente nuevo grupo #4","profile":"https://image.tmdb.org/t/p/original/8pNOwG9UxgHestAriO0N7r5GHN8.jpg"},{"id":1042765,"name":"Arturo Valls","role":"Paciente nuevo grupo #5","profile":"https://image.tmdb.org/t/p/original/wSkitriFHIp1yNRhA3SjWq5QGwy.jpg"},{"id":970027,"name":"Marta Hazas","role":"Paciente nuevo grupo #6","profile":"https://image.tmdb.org/t/p/original/1dbeTFRCbWBt70dIGjYHKVLnpaG.jpg"},{"id":2094036,"name":"Toni Balach","role":"Man Locked In The Taxi"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","overview":"Al cospetto di un illustre psicologo si alterna un eterogeneo gruppo di pazienti, tutti affetti da disturbo ossessivo compulsivo. Il medico un giorno non può però presentarsi in tempo a causa di un ritardo imprevisto che ha subito il suo volo. I pazienti sono così costretti a condividere un'attesa che sembra non avere fine. Per loro, riuscire a mantenere a bada manie e ossessioni non sarà facile e presto il caos prenderà il sopravvento."},{"language":"en-US","overview":"A group of patients meet at a prestigious psychologist's office. Apart from the day and time of the appointment, something else unites them all: all six suffer from OCD. But the plane bringing the doctor is unexpectedly delayed, which forces them to spend an endless wait until the doctor shows up. Will they be able to keep their manias, impulses, convulsions, obsessions and rituals at bay during the wait?","tagline":"I have to watch it. I have to watch it. I have to watch it. I have to watch it."},{"language":"es-ES","title":"Toc Toc","overview":"Un grupo de pacientes coincide en la consulta de un eminente psicólogo, todos ellos aquejados de TOC (Trastorno Obsesivo Compulsivo). Pero