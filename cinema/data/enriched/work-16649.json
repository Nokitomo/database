original/ziH9WcIkDOQ9XLcffKzqa4mTd6n.jpg"},{"id":84645,"name":"Amy Huberman","role":"Emily","profile":"https://image.tmdb.org/t/p/original/3Jv2QqgWdXxHXukYGpytRl0812T.jpg"},{"id":525439,"name":"Patrick Mölleken","role":"Harry","profile":"https://image.tmdb.org/t/p/original/AoqJfAfydQ18mZyt4N18enl15dZ.jpg"},{"id":1449849,"name":"Tamás Ferkay","role":"Librarian"},{"id":26202,"name":"Nina Fog","role":"Asian Woman","profile":"https://image.tmdb.org/t/p/original/xB6TGcsn9blgaASrFOV59aNtXFz.jpg"},{"id":1449850,"name":"Bruno Ricketts","role":"Soccerboy 1"},{"id":1449851,"name":"Francis Barnes","role":"Soccerboy 2"},{"id":1449852,"name":"Oskar Ricketts","role":"Soccerboy 3","profile":"https://image.tmdb.org/t/p/original/1YIglDPYovI9sQy8S1LtCN4Ga6e.jpg"},{"id":1290935,"name":"Lars Walther","role":"Ghosthunter 1","profile":"https://image.tmdb.org/t/p/original/7YGCjFI0hBP6wLXXuoU2jCiEGNR.jpg"},{"id":37246,"name":"Axel Stein","profile":"https://image.tmdb.org/t/p/original/wMVOPqj1ZQcQyQeZS5PKM5tTP3d.jpg"},{"id":220754,"name":"Carolin Kebekus","profile":"https://image.tmdb.org/t/p/original/82z2QGHvY8t4Koej2PtYaDxMRnr.jpg"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","title":"Ghosthunters - Gli acchiappafantasmi","overview":"Il piccolo e solitario Tom scopre nella sua cantina un piccolo fantasma verde e gelatinoso, che gli racconta di essere dovuto fuggire dal maniero dove abitava a causa dell'arrivo di uno spirito malvagio. Tom decide di chiedere aiuto alla scontrosa Hetty, un'acchiappafantasmi appena licenziata dalla sua organizzazione segreta, con la quale riusciranno a sconfiggere il terribile nemico"},{"language":"en-US","title":"Ghosthunters: On Icy Trails","overview":"They couldn't be more different, the members of the trio that allies in the fight against an Ancient Ice Ghost (AIG): Tom, an easily scared boy, Hetty, a professional ghosthunter and the loveable, but pretty slimy Hugo - a ghost. Will the team manage to save their town from the next ice age?"},{"language":"de-DE","overview":"Tom hat es nicht leicht, denn nicht nur seine bösartige Schwester Lola macht ihm das Leben schwer, scheinbar hält jeder den kleinen Jungen für einen Angsthasen. Als er im Keller auf Hugo trifft, jagt der ihm im ersten Moment einen gehörigen Schreck ein, denn bei ihm handelt es sich um ein schleimiges Gespenst. Doch bald schon stellt sich Hugo nicht nur als vollkommen harmlos heraus, sondern auch noch als ziemlich liebenswert. Die beiden werden Freunde. Doch das MUG - das mittelmäßig unheimliches Gespenst - hat ein gewaltiges Problem, das es innerhalb von sieben Tagen zu lösen gilt. Denn seine Gespenstervilla wird von einem UEG – urzeitliches Eisgespenst – bewohnt und dieses hat Hugo vertrieben. Kehrt er nicht in sein Spukschloss zurück, löst er sich in Luft auf. Zusammen mit der professionellen, aber arbeitslosen Geisterjägerin Hedwig Kümmelsaft wollen sie das Gespenst bekämpfen."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/xHd4BoYnKA65A7jZ7VMvLwqv59X.jpg","background":"https://image.tmdb.org/t/p/original/qe1O6iT6IDdlepVxRUZlD9WXmXM.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":333112,"type":"movie","originalLanguage":"de-DE","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/xHd4BoYnKA65A7jZ7VMvLwqv59X.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/xHd4BoYnKA65A7jZ7VMvLwqv59X.jpg","language":"it","width":1000,"height":1500},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/xHd4BoYnKA65A7jZ7VMvLwqv59X.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/xHd4BoYnKA65A7jZ7VMvLwqv59X.jpg","language":"it","width":1000,"height":1500},{"type":"poster","url":"https://image.tmdb.org/t/p/original/bpXkrRpHo5xJc0GqPAb4o0gAcvS.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/bpXkrRpHo5xJc0GqPAb4o0gAcvS.jpg","lan