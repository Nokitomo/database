db.org/t/p/original/d3phhUP1FtVAxUCM3BICobNSVei.jpg"},{"id":2663919,"name":"Yoon Byung-hee","role":"Detective Woo","profile":"https://image.tmdb.org/t/p/original/77HOYpL0BI6BN4kaTYUMNIlnLM0.jpg"},{"id":4047197,"name":"Seo Suk-kyu","role":"Detective 1","profile":"https://image.tmdb.org/t/p/original/otD7AbTlnU2wASORzKWsEB0LbGh.jpg"},{"id":3909265,"name":"Lee Geon-goo","role":"Detective 2"},{"id":6303933,"name":"Ko Yong-seok","role":"Detective 3"},{"id":116178,"name":"Kim Hyeong-jong","role":"Detective 4","profile":"https://image.tmdb.org/t/p/original/7ETKX9TOrXo3Kwlq2Y5t9eq6fS8.jpg"},{"id":6303934,"name":"Moon Jeong-hwan","role":"Detective 5"},{"id":6303935,"name":"Kim Cha-woong","role":"Detective 6"},{"id":6303936,"name":"Park Jong-hwi","role":"Detective 7"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","title":"Husbands in Action","overview":"Un detective fa squadra con il nuovo marito della sua ex moglie per trovare chi l'ha rapita. Riusciranno a mettere da parte le divergenze per compiere un salvataggio spericolato?"},{"language":"en-US","title":"Husbands in Action","overview":"A detective teams up with his ex-wife's new husband to chase down her kidnappers. Can this unlikely duo put aside their differences for one wild rescue?","tagline":"A chaotic match, a reckless mission."},{"language":"ko-KR","overview":"신종 마약 조직을 쫓는 데 수년을 바쳐 온 마약반 열혈 형사 충식. 마침내 조직의 두목을 붙잡은 날, 그는 전처 시내가 범죄 조직에게 납치되었다는 충격적인 소식을 듣는다. 다급히 달려간 충식 앞에 나타난 사람은 시내의 현남편 민석. 성격도, 직업도, 살아온 방식도 무엇 하나 맞는 구석이 없는 두 남자는 서로를 못마땅해하면서도 시내를 구하겠다는 일념 하나로 얼떨결에 손을 잡는다. 뜻밖의 동행까지 떠안은 채 시간과의 싸움에 뛰어든 이들은 티격태격하는 사이에 예기치 못한 상황과 연이어 맞닥뜨린다. 과연 어울리지 않는 두 남편은 아내를 무사히 구해낼 수 있을까.","tagline":"전남편과 현남편, 아내를 구하러 한 팀이 되다"}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/A01Ca3GfoUZ192ebgHHj6MYOG35.jpg","background":"https://image.tmdb.org/t/p/original/doasZ6ROBhD0xIRsvAFdTeZsKhp.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tm