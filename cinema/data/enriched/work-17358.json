rofile":"https://image.tmdb.org/t/p/original/flIGG4GZ1r8IsrpvsuVV0LegK59.jpg"},{"id":28532,"name":"Maxim Mehmet","role":"Mr. Sesemann","profile":"https://image.tmdb.org/t/p/original/mKxkszluLiJAv7fpHg2T3BS8b6P.jpg"},{"id":39303,"name":"Hannelore Hoger","role":"Grandmother Sesemann","profile":"https://image.tmdb.org/t/p/original/cSEgeVHkVQRATHMoFnBPoXIOCuG.jpg"},{"id":912632,"name":"Jella Haase","role":"Tinette","profile":"https://image.tmdb.org/t/p/original/kwbw9Q4Cnk1Oiwz8ktIQXgECLTx.jpg"},{"id":78444,"name":"Anna Schinz","role":"Dete","profile":"https://image.tmdb.org/t/p/original/tHNI3VFmoBmjMfZrTpM2YZBmK5j.jpg"},{"id":11071,"name":"Peter Lohmeyer","role":"Sebastian","profile":"https://image.tmdb.org/t/p/original/1hnbaz9deXeNzCDwPxudTea17rV.jpg"},{"id":105925,"name":"Lilian Naef","role":"Barbel","profile":"https://image.tmdb.org/t/p/original/qnKcJIzuDXsEHx38eNiEiDxkWn1.jpg"},{"id":105921,"name":"Monica Gubser","role":"Grandmother","profile":"https://image.tmdb.org/t/p/original/k1tCSURBsdg0d1BmqVMXAykYn58.jpg"},{"id":233968,"name":"Peter Jecklin","role":"Pastor","profile":"https://image.tmdb.org/t/p/original/3n5L2liuCS2J6bx7XWSXDe8DEf4.jpg"},{"id":1086277,"name":"Christoph Gaugler","role":"Herdsman","profile":"https://image.tmdb.org/t/p/original/4seaVimdqh7iivh5YtlZpzc4Fv2.jpg"},{"id":233966,"name":"Rebecca Indermaur","role":"Geissenpeterin","profile":"https://image.tmdb.org/t/p/original/rtG8IscSTv8xRptJtfrfhvLeISk.jpg"},{"id":1851261,"name":"Marietta Jemmi","role":"Woman in the village","profile":"https://image.tmdb.org/t/p/original/6LbbkC7PBlbcDru0QQlDbc5qrxZ.jpg"},{"id":1643968,"name":"Michael Kranz","role":"Mr. Kandidat","profile":"https://image.tmdb.org/t/p/original/9WioDLqhY0eUG96ytxXkNuH8nej.jpg"},{"id":38738,"name":"Markus Hering","role":"Doctor","profile":"https://image.tmdb.org/t/p/original/wcBVSFpeqaUNvOp5U0Lph1zLIoa.jpg"},{"id":1918930,"name":"Arthur Bühler","role":"Villager"},{"id":1918931,"name":"Laura Parker","role":"Market woman"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","title":"Heidi","overview":"Heidi è una bambina felice che vive in compagnia del nonno in una piccola casetta sulle montagne svizzere. Insieme al suo migliore amico Peter si diverte prendendosi cura delle caprette e godendosi la libertà della vita sui monti. Ma queste giornate spensierate si interrompono quando la zia Dete decide di portare Heidi a Francoforte. Lì dovrà fare compagnia a Klara, la figlia del ricco signor Seseman, e insieme a lei imparare a leggere e scrivere sotto la supervisione della severa signorina Rottnmeier. In città Heidi conoscerà quindi un’amica inseparabile e l’amore per la lettura, ma la nostalgia delle sue amate montagne e di suo nonno si faranno sentire presto.","tagline":"La vera amicizia non conosce limiti"},{"language":"en-US","overview":"Heidi, is an eight-year-old Swiss orphan who is given by her aunt to her mountain-dwelling grandfather. She is then stolen back by her aunt from her grandfather to live in the wealthy Sesemann household in Frankfurt, Germany as a companion to Klara, a sheltered, disabled girl in a wheelchair. Heidi is unhappy but makes the best of the situation, always longing for her grandfather."},{"language":"de-DE","overview":"Die glücklichsten Tage ihrer Kindheit verbringt das Waisenmädchen Heidi zusammen mit ihrem eigenbrötlerischen Großvater, dem Almöhi, abgeschieden in einer einfachen Hütte in den Schweizer Bergen. Zusammen mit ihrem Freund, dem Geißenpeter, hütet sie die Ziegen des Almöhi und genießt die Freiheit in den Bergen in vollen Zügen. Doch die unbeschwerte Zeit endet jäh, als Heidi von ihrer Tante Dete nach Frankfurt gebracht wird. Dort soll sie in der Familie des wohlhabenden Herrn Sesemann eine Spielgefährtin für die im Rollstuhl sitzende Tochter Klara sein und unter der Aufsicht des strengen Kindermädchens Fräulein Rottenmeier lesen und schreiben lernen. Obwohl sich die beiden Mädchen bald anfreunden und Klaras Großmutter in Heidi die Leidenschaft für Bücher erweckt, wird die Sehnsucht nach den geliebten Bergen und dem Almöhi immer stärker…","tagline":"Wir alle kennen sie!"}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/kxnhHaPOvh0cqMOAx5k0NnqhDqS.jpg","background":"https://image.tmdb.org/t/p/original/1PlM2EeieSZPJ9jrM5XYIJyoRRL.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":365045,"type":"movie","originalLanguage":"de-DE","series":{"poster":{"it":{"status":"missing","candidates":[]},"en":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/ue6L0x3C9V4c5kIiWnEIOPwtGhw.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/ue6L0x3C9V4c5kIiWnEIOPwtGhw.jpg","language":"en","width":2000,"height":3000},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/ue6L0x3C9V4c5kIiWnEIOPwtGhw.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/ue6L0x3C9V4c5kIiWnEIOPwtGhw.jpg","language":"en","width":2000,"height":3000},{"type":"poster","url":"https://image.tmdb.org/t/p/original/7x7N2SvVVLLJrGx7hOu0ymFvz2M.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/7x7N2SvVVLLJrGx7hOu0ymFvz2M.jpg","language":"en","width":1000,"height":1426}]},"de":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/kxnhHaPOvh0cqMOAx5k0NnqhDqS.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/kxnhHaPOvh0cqMOAx5k0NnqhDqS.jpg","language":"de","width":2000,"height":3000},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/kxnhHaPOvh0cqMOAx5k0NnqhDqS.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/kxnhHaPOvh0cqMOAx5k0NnqhDqS.jpg","language":"de","width":2000,"height":3000},{"type":"poster","url":"https://image.tmdb.org/t/p/original/rr9k7X9yUDXVtX7SqxvAnC0L2xp.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/rr9k7X9yUDXVtX7SqxvAnC0L2xp.jpg","language":"de","width":2000,"height":3000},{"type":"poster","ur