na Barcelona invisible. Sintiendo que la muerte le ronda, intenta encontrar la paz, proteger a sus hijos, salvarse a sí mismo. La historia de Uxbal es sencilla y compleja, al igual que nuestras vidas de hoy.","tagline":"Tú no eliges a tu familia. Todos somos de alguien, pero pertenecer a Uxbal y Marambra es tanto una bendición como una maldición."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/2RGgtKbSzhuUvQQmWpEdOfHsAu2.jpg","background":"https://image.tmdb.org/t/p/original/s1r2aBDzkvlFkNnAgxWFTCQjKPe.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":45958,"type":"movie","originalLanguage":"es-ES","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/2RGgtKbSzhuUvQQmWpEdOfHsAu2.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/2RGgtKbSzhuUvQQmWpEdOfHsAu2.jpg","language":"it","width":1000,"height":1500},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/2RGgtKbSzhuUvQQmWpEdOfHsAu2.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/2RGgtKbSzhuUvQQmWpEdOfHsAu2.jpg","language":"it","width":1000,"height":1500}]},"en":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/4BLshBMp8INRDhvfuKwxMlHDIIt.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/4BLshBMp8INRDhvfuKwxMlHDIIt.jpg","language":"en","width":2000,"height":3000},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/4BLshBMp8INRDhvfuKwxMlHDIIt.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/4BLshBMp8INRDhvfuKwxMlHDIIt.jpg","language":"en","width":2000,"height":3000},{"type":"poster","url":"https://image.tmdb.org/t/p/original/scNpI9bz6SdtROxthKdvBP3fFtt.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/scNpI9bz6SdtROxthKdvBP3fFtt.jpg","language":"en","width":950,"height":1426},{"type":"poster","url":"https://image.tmdb.org/t/p/original/8cj0Q2uFfpTkCw4gMqqcTBpdoqF.jpg