":"2026-07-04T20:52:04.000000Z","original_url_field":null,"reference":{"base":"streamingunity:images","path":"/images/d2d4d4b1-60cd-4c3a-b59d-8d2e80a9f4ef.webp"},"provider":"streamingunity"}],"episodeMappingUncertain":false,"seasons":[],"provenance":{},"warnings":[],"externalIdsEvidence":{"wikidata":{"source":"wikidata","sourceUrl":"https://www.wikidata.org/wiki/Q492521","wikidataId":"Q492521","tmdbId":103753,"type":"movie","imdbId":"tt1989712","tvdbId":19361}},"externalMedia":{"tmdb":{"source":"tmdb-api","id":103753,"type":"movie","sourceUrl":"https://www.themoviedb.org/movie/103753","fetchedAt":"2026-11-08T04:30:02.049Z","originalLanguage":"ko-KR","title":{"value":"In Another Country","language":"it-IT"},"originalTitle":"다른 나라에서","overview":{"value":"In un paese che non è il suo, una donna che non è del tutto la stessa né del tutto un'altra, ha incontrato, incontra e incontrerà nello stesso posto le stesse persone che le faranno vivere ogni volta un'esperienza nuova.","language":"it-IT"},"tagline":{"value":"세 명의 안느가 다른 나라에서 머문 신비로운 날들","language":"ko-KR"},"releaseDate":"2012-05-31","status":"Released","rating":6.1,"ratingCount":127,"genres":["Dramma"],"countries":["South Korea","France"],"facts":{"Runtime":"89m"},"keywords":[],"networks":[],"socialLinks":{},"cast":[{"id":17882,"name":"Isabelle Huppert","role":"Anne","profile":"https://image.tmdb.org/t/p/original/wGG9v1Uci3sfrbjt0bRXkLrTqjY.jpg"},{"id":80461,"name":"Yu Jun-sang","role":"Lifeguard","profile":"https://image.tmdb.org/t/p/original/xAyOtT2ku17QBsLW5NBaYaaYuok.jpg"},{"id":127720,"name":"Jung Yu-mi","role":"Wonjoo","profile":"https://image.tmdb.org/t/p/original/pU8iBcZHhuc4kQe6HHZVcommefG.jpg"},{"id":240948,"name":"Moon Sung-keun","role":"Moonsoo","profile":"https://image.tmdb.org/t/p/original/wQjOvAFqCItwMw7dxa486KnGgEE.jpg"},{"id":1080935,"name":"Youn Yuh-jung","role":"Park Sook","profile":"https://image.tmdb.org/t/p/original/rSoSAX85gvPNSWmWXcCaJ2eBPrp.jpg"},{"id":554945,"name":"Kwon Hae-hyo","role":"Jongsoo","profile":"https://image.tmdb.org/t/p/original/3sCMSQVdY2mqYYq3jj4u9JWRoTt.jpg"},{"id":83122,"name":"Moon So-ri","role":"Geumhee","profile":"https://image.tmdb.org/t/p/original/iXfIsmrzohNAAf2gyPCE06rJM1N.jpg"},{"id":2354034,"name":"Kim Yong-ok","role":"Monk","profile":"https://image.tmdb.org/t/p/original/is7IF2LAELPTJvrFZRwm63mrRvq.jpg"},{"id":6265639,"name":"Kim Yong-soon","role":"Old woman"},{"id":6265640,"name":"Lee Jung-woong","role":"Fisher"},{"id":6265641,"name":"Kim Soon-ja","role":"Bodhisattva"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","title":"In Another Country","overview":"In un paese che non è il suo, una donna che non è del tutto la stessa né del tutto un'altra, ha incontrato, incontra e incontrerà nello stesso posto le stesse persone che le faranno vivere ogni volta un'esperienza nuova."},{"language":"en-US","title":"In Another Country","overview":"A young woman and her mother run away to the seaside town of Mohang to escape their mounting debt. The young woman begins writing a script for a short film in order to calm her nerves: There are three women named Anne, and each woman consecutively visits the seaside town of Mohang. A young woman tends to the small hotel by the Mohang foreshore owned by her parents. A certain lifeguard can be seen restlessly wandering up and down the beach that lies nearby. Each Anne stays at this small hotel, receives some assistance from the owner's daughter, and ventures onto the beach where they meet the lifeguard."},{"language":"ko-KR","overview":"모항이란 해변 마을로 어머니와 함께 빚에 쫓겨 내려온 영화과 학생이 불안해서 시나리오를 쓴다. 안느라는 이름의 세 여인이 등장하고, 그들은 차례로 모항으로 내려온다. 첫 번째 안느는 잘 나가는 감독이고, 두 번째 안느는 한국 남자를 비밀리에 만나는 유부녀이고, 세 번째 안느는 한국여자에게 남편을 빼앗긴 이혼녀이다. 모항 갯벌 앞에는 한 펜션이 있고, 그곳엔 주인부부를 대신해 펜션을 지키는 딸이 있고, 해변 쪽으로 가면 항상 해변을 서성이는 안전요원이 있다. 안느들은 모두 이 펜션에 숙소를 정하고, 그 펜션 딸의 작은 도움을 받게 되고, 또 모두 해변으로 나가 그 안전요원을 만나게 된다.","tagline":"세 명의 안느가 다른 나라에서 머문 신비로운 날들"}],"images":{"logos":[],"posters":[],"backdr