","path":"/images/15867584-7f24-4278-918c-fcbd2b851724.webp"},"provider":"streamingunity"},{"id":789396,"filename":"d81c4831-122b-4623-a790-72f6fc1c489c.webp","type":"cover_mobile","lang":"it","imageable_type":"title","imageable_id":65275,"created_at":"2026-07-30T19:52:40.000000Z","updated_at":"2026-07-30T19:52:40.000000Z","original_url_field":null,"reference":{"base":"streamingunity:images","path":"/images/d81c4831-122b-4623-a790-72f6fc1c489c.webp"},"provider":"streamingunity"}],"episodeMappingUncertain":false,"seasons":[],"provenance":{},"warnings":[],"externalIdsEvidence":{"wikidata":{"source":"wikidata","sourceUrl":"https://www.wikidata.org/wiki/Q84782103","wikidataId":"Q84782103","tmdbId":667995,"type":"movie","imdbId":"tt11697832","tvdbId":155002}},"externalMedia":{"tmdb":{"source":"tmdb-api","id":667995,"type":"movie","sourceUrl":"https://www.themoviedb.org/movie/667995","fetchedAt":"2026-11-08T05:08:28.506Z","originalLanguage":"ru-RU","title":{"value":"ДАУ. Наташа","language":"ru-RU"},"originalTitle":"DAU. Natasha","overview":{"value":"Natasha runs the canteen at a secret 1950s Soviet research institute. This is the beating heart of the DAU universe, everyone drops in here: the institute's employees, scientists and visiting foreign guests. Natasha's world is a small one, split between the demands of the canteen during the day and alcohol fuelled nights with her younger colleague Olga, during which the two confide their hopes of romance and for a different future. At a party one evening Natasha becomes close to a visiting French scientist Luc Bige and the two sleep together. The following day her life takes a dramatic turn when she is summoned to an interrogation by the KGB's General Vladimir Azhippo who questions the nature of her relationship with the foreign guest.","language":"en-US"},"releaseDate":"2021-08-26","status":"Released","rating":5.65,"ratingCount":20,"genres":["Dramma"],"countries":["United Kingdom","Germany","Russia","Ukraine"],"facts":{"Runtime":"138m"},"keywords":[],"networks":[],"socialLinks":{},"cast":[{"id":2524213,"name":"Natalia Berezhnaya","role":"Natasha","profile":"https://image.tmdb.org/t/p/original/cuowAqmRzW5yJVDIwJlSXDwxaiD.jpg"},{"id":2524169,"name":"Olga Shkabarnya","role":"Olga","profile":"https://image.tmdb.org/t/p/original/oO4I0klR4I7rVAGHI8Yyd9E3n88.jpg"},{"id":2524165,"name":"Vladimir Azhippo","role":"Azhippo","profile":"https://image.tmdb.org/t/p/original/xDU8anIE7uT7oBHYhPD1zDWmy8Q.jpg"},{"id":2525096,"name":"Alexey Blinov","role":"Blinov","profile":"https://image.tmdb.org/t/p/original/iT0BznuaP9nF56LsPWzzDraxOJv.jpg"},{"id":2537474,"name":"Luc Bigé","role":"Luc"},{"id":2602836,"name":"Alexandr Bozhik"},{"id":2602839,"name":"Anatoly Sidko","role":"Palych"},{"id":2602843,"name":"Raisa Voloshchuk"},{"id":2513196,"name":"Valery Andreev"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT"},{"language":"en-US","overview":"Natasha runs the canteen at a secret 1950s Soviet research institute. This is the beating heart of the DAU universe, everyone drops in here: the institute's employees, scientists and visiting foreign guests. Natasha's world is a small one, split between the demands of the canteen during the day and alcohol fuelled nights with her younger colleague Olga, during which the two confide their hopes of romance and for a different future. At a party one evening Natasha becomes close to a visiting French scientist Luc Bige and the two sleep together. The following day her life takes a dramatic turn when she is summoned to an interrogation by the KGB's General Vladimir Azhippo who questions the nature of her relationship with the foreign guest."},{"language":"ru-RU","title":"ДАУ. Наташа","overview":"Наташа заведует столовой в секретном советском научно-исследовательском институте 1950-х годов. Это бьющееся сердце вселенной DAU, сюда заглядывают все: сотрудники института, ученые и иностранные гости. Мир Наташи маленький, он разделен между потребностями столовой в течение дня и ночами, вызванными алкоголем, с ее младшей коллегой Ольгой, во время которой они доверяют свои надежды на романтику и на другое будущее. Однажды вечером на вечеринке Наташа сближается с приглашенным французским ученым Люком Биге, и они спят вместе. На следующий день ее жизнь резко меняется, когда ее вызывает на допрос генерал КГБ Владимир Ажиппо, который ставит под сомнение характер ее отношений с иностранным гостем."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/aghJGIRRkzMQTUMjw6ts1PeM3ll.jpg","background":"https://image.tmdb.org/t/p/original/7cMWa2cuHQc9QiHCSWCznhDS3Ux.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":667995,"type":"movie","originalLanguage":"ru-RU","series":{"poster":{"it":{"status":"missing","candidates":[]},"en":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/d4DNYzlDcKcsuA9d9hlhvB1aSE6.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/d4DNYzlDcKcsuA9d9hlhvB1aSE6.jpg","language":"en","width":2000,"height":3000},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/d4DNYzlDcKcsuA9d9hlhvB1aSE6.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/d4DNYzlDcKcsuA9d9hlhvB1aSE6.jpg","language":"en","width":2000,"height":3000},{"type":"poster","url":"https://image.tmdb.org/t/p/original/ppQLS7bwrIX1Gde7qh36cXGafpa.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/ppQLS7bwrIX1Gde7qh36cXGafpa.jpg","language":"en","width":720,"height":1080},{"type":"poster","url":"https://image.tmdb.org/t/p/original/bKB1xOsGDprCKN83b4SZKCld2dc.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/bKB1xOsGDprCKN83b4SZKCld2dc.jpg","language":"en","width":509,"height":750},{"type":"poster","url":"https://image.tmdb.org/t/p/original/4Ecj7OU3I1SXjmTMwpcVRuHppV2.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/4Ecj7OU3I1SXjmTMwpcVRuHppV2.jpg","language":"en","width":666,"h