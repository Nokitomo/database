심한 지아는 그곳에서 어엿한 파티시에가 되어 빵집을 꾸려 가는 첫사랑 승현과 다시 마주한다. 오랜 시간 가슴속에 묻어 두었던 마음이 다시 움직이기 시작하고 두 사람은 비로소 사랑에 빠지지만, 그들에게 허락된 시간은 생각보다 훨씬 짧은데...","tagline":"너의 마지막 사랑이 되고 싶었고, 너의 마지막 기억이 되고 싶었다"}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/bqBVZucNhvPLBTt0s7SDXvL6Ejc.jpg","background":"https://image.tmdb.org/t/p/original/y12yGohzantqzmT2CGKFFj2KqxX.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":784610,"type":"movie","originalLanguage":"ko-KR","series":{"poster":{"it":{"status":"missing","candidates":[]},"en":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/186r1DnR9hHipdwFigNYlcF1ALL.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/186r1DnR9hHipdwFigNYlcF1ALL.jpg","language":"en","width":740,"height":1060},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/186r1DnR9hHipdwFigNYlcF1ALL.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/186r1DnR9hHipdwFigNYlcF1ALL.jpg","language":"en","width":740,"height":1060}]},"ko":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/bqBVZucNhvPLBTt0s7SDXvL6Ejc.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/bqBVZucNhvPLBTt0s7SDXvL6Ejc.jpg","language":"ko","width":1890,"height":2835},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/bqBVZucNhvPLBTt0s7SDXvL6Ejc.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/bqBVZucNhvPLBTt0s7SDXvL6Ejc.jpg","language":"ko","width":1890,"height":2835}]},"xx":{"status":"missing","candidates":[]}},"background":{"it":{"status":"missing","candidates":[]},"en":{"status":"missing","candidates":[]},"ko":{"status":"missing","candidates":[]},"xx":{"status":"available","selected":{"type":"backdrop","url":"https://image.tmdb.org/t/p/original/y12yGohzantqzmT2CGKFFj2KqxX.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/y12yGohzantqzmT2CGKFFj2KqxX.jpg","language":"xx","width":1920,"hei