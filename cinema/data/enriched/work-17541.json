g":null,"imageable_type":"title","imageable_id":8436,"created_at":"2024-05-10T05:17:05.000000Z","updated_at":"2024-05-10T05:17:05.000000Z","original_url_field":null,"reference":{"base":"streamingunity:images","path":"/images/4d9d3926-aa29-4012-8c33-05da221e2b3d.webp"},"provider":"streamingunity"},{"id":107344,"filename":"00a77593-1b15-45b1-a8f4-f5333f6dceae.webp","type":"logo","lang":"it","imageable_type":"title","imageable_id":8436,"created_at":"2024-05-10T05:17:04.000000Z","updated_at":"2025-05-12T09:25:05.000000Z","original_url_field":null,"reference":{"base":"streamingunity:images","path":"/images/00a77593-1b15-45b1-a8f4-f5333f6dceae.webp"},"provider":"streamingunity"},{"id":107347,"filename":"eb674880-8192-44c5-97c9-771575d073f7.webp","type":"cover_mobile","lang":"it","imageable_type":"title","imageable_id":8436,"created_at":"2024-05-10T05:17:05.000000Z","updated_at":"2025-05-12T09:25:05.000000Z","original_url_field":null,"reference":{"base":"streamingunity:images","path":"/images/eb674880-8192-44c5-97c9-771575d073f7.webp"},"provider":"streamingunity"}],"episodeMappingUncertain":false,"seasons":[{"number":1,"episodes":[{"number":1,"title":"Tornare","synopsis":"Rita Montero, famosa regista internazionale, torna a Elda dopo venticinque anni e rivede il gruppo di amici che frequentava al liceo. Nel frattempo, Paula Ríos, ispettrice di polizia, arriva a Maiorca per identificare alcuni resti che potrebbero appartenere a sua sorella Matilde, scomparsa venticinque anni prima durante la gita dell'ultimo anno di liceo.","thumbnail":{"base":"streamingunity:images","path":"/images/4e2852ba-f196-4bec-8e63-2f6e85ef22df.webp"},"metadataSources":{"streamingunity:8436":{"title":"Tornare","synopsis":"Rita Montero, famosa regista internazionale, torna a Elda dopo venticinque anni e rivede il gruppo di amici che frequentava al liceo. Nel frattempo, Paula Ríos, ispettrice di polizia, arriva a Maiorca per identificare alcuni resti che potrebbero appartenere a sua sorella Matilde, scomparsa venticinque anni prima durante la gita dell'ultimo anno di liceo.","thumbnail":{"base":"streamingunity:images","path":"/images/4e2852ba-f196-4bec-8e63-2f6e85ef22df.webp"}}}},{"number":2,"title":"Vecchi Peccati","synopsis":"La notizia del ritrovamento dei resti di Mati sconvolge il gruppo. Tuttavia, alcuni sembrano sapere più di quanto affermano. Lena insiste per parlare da sola con Rita, la quale, perseguitata dai fantasmi del suo passato, vorrebbe tornare subito a Londra. Paula inizia a indagare su quanto è accaduto a sua sorella.","thumbnail":{"base":"streamingunity:images","path":"/images/6eacd030-c9b5-40c5-b514-956f89db4b55.webp"},"metadataSources":{"streamingunity:8436":{"title":"Vecchi Peccati","synopsis":"La notizia del ritrovamento dei resti di Mati sconvolge il gruppo. Tuttavia, alcuni sembrano sapere più di quanto affermano. Lena insiste per parlare da sola con Rita, la quale, perseguitata dai fantasmi del suo passato, vorrebbe tornare subito a Londra. Paula inizia a indagare su quanto è accaduto a sua sorella.","thumbnail":{"base":"streamingunity:images","path":"/images/6eacd030-c9b5-40c5-b514-956f89db4b55.webp"}}}},{"number":3,"title":"Le ragazze del 28","synopsis":"Scossa dagli ultimi avvenimenti, Rita accantona il suo desiderio di tornare a Londra e si unisce alle indagini di Paula. Questo la porta a scontrarsi con il suo gruppo di amici, soprattutto con Candela, con la quale ha avuto una storia d'amore in passato. Sentendosi minacciate, anche le altre si uniscono alle indagini ed escogitano strategie per far sì che la polizia tenga gli occhi ben lontano dalla situazione.","thumbnail":{"base":"streamingunity:images","path":"/images/187da96d-9ded-49ba-b85a-b34f9fb31c9a.webp"},"metadataSources":{"streamingunity:8436":{"title":"Le ragazze del 28","synopsis":"Scossa dagli ultimi avvenimenti, Rita accantona il suo desiderio di tornare a Londra e si unisce alle indagini di Paula. Questo la porta a scontrarsi con il suo gruppo di amici, soprattutto con Candela, con la quale ha avuto una storia d'amore in passato. Sentendosi minacciate, anche le altre si uniscono alle indagini ed escogitano strategie per far sì che la polizia tenga gli occhi ben lontano dalla situazione.","thumbnail":{"base":"streamingunity:images","path":"/images/187da96d-9ded-49ba-b85a-b34f9fb31c9a.webp"}}}},{"number":4,"title":"Ondata","synopsis":"Angela torna a Londra e Rita sente che il mondo le sta crollando addosso. Sa che le sue amiche stanno cercando di distogliere l'attenzione della polizia e chiede l'aiuto dell'avvocato Candela. Candela accetta su insistenza di Rita, e poi le due passano la giornata in spiaggia ricordando tutta la magia che c'era stata tra loro da adolescenti.","thumbnail":{"base":"streamingunity:images","path":"/images/c610627b-c738-42e2-908a-847ec4e0c8c8.webp"},"metadataSources":{"streamingunity:8436":{"title":"Ondata","synopsis":"Angela torna a Londra e Rita sente che il mondo le sta crollando addosso. Sa che le sue amiche stanno cercando di distogliere l'attenzione della polizia e chiede l'aiuto dell'avvocato Candela. Candela accetta su insistenza di Rita, e poi le due passano la giornata in spiaggia ricordando tutta la magia che c'era stata tra loro da adolescenti.","thumbnail":{"base":"streamingunity:images","path":"/images/c610627b-c738-42e2-908a-847ec4e0c8c8.webp"}}}},{"number":5,"title":"La Tempesta","synopsis":"Vengono ritrovate delle vecchie fotografie conservate dalla madre di Paula in un vecchio magazzino e le indagini di Paula si intensificano. È la sua ultima occasione per dimostrare che la sorella non è morta in un incidente. Trova sostegno in Rita, che però ignora ancora una volta i consigli di Candela, e mette in pericolo la loro relazione. Tutto peggiora quando il capo della polizia decide di chiudere il caso.","thumbnail":{"base":"streamingunity:images","path":"/images/5605dca4-74b0-4629-a287-6e50e6081962.webp"},"metadataSources":{"streamingunity:8436":{"title":"La Tempesta","synopsis":"Vengono ritrovate delle vecchie fotografie conservate dalla madre di Paula in un vecchio magazzino e le indagini di Paula si intensificano. È la sua ultima occasione per dimostrare che la sorella non è morta in un incidente. Trova sostegno in Rita, che però ignora ancora una volta i consigli di Candela, e mette in pericolo la loro relazione. Tutto peggiora quando il capo della polizia decide di chiudere il caso.","thumbnail":{"base":"streamingunity:images","path":"/images/5605dca4-74b0-4629-a287-6e50e6081962.webp"}}}},{"number":6,"title":"Patto di sangue","synopsis":"Il caso è ufficialmente chiuso, e l'indagine si blocca. Rita pensa agli ultimi preparativi per il suo ritorno a Londra. Sembra tutto finito e gli amici tirano un sospiro di sollievo. Proprio quando torna la quiete nelle loro case, un arresto inaspettato della polizia e l'emergere di nuove prove inducono Rita a rimandare i suoi piani e la conducono finalmente alla verità risalente a venticinque anni prima.","thumbnail":{"base":"streamingunity:images","path":"/images/491fbf82-04af-4387-b269-4acb81a36248.webp"},"metadataSources":{"streamingunity:8436":{"title":"Patto di sangue","synopsis":"Il caso è ufficialmente chiuso, e l'indagine si blocca. Rita pensa agli ultimi preparativi per il suo ritorno a Londra. Sembra tutto finito e gli amici tirano un sospiro di sollievo. Proprio quando torna la quiete nelle loro case, un arresto inaspettato della polizia e l'emergere di nuove prove inducono Rita a rimandare i suoi piani e la conducono finalmente alla verità risalente a venticinque anni prima.","thumbnail":{"base":"streamingunity:images","path":"/images/491fbf82-04af-4387-b269-4acb81a36248.webp"}}}}],"images":[]}],"provenance":{},"warnings":[],"externalIdsEvidence":{"wikidata":{"source":"wikidata","sourceUrl":"https://www.wikidata.org/wiki/Q125267757","wikidataId":"Q125267757","tmdbId":242904,"type":"tv","imdbId":"tt27531478","tvdbId":449628}},"externalMedia":{"tmdb":{"source":"tmdb-api","id":242904,"type":"tv","sourceU