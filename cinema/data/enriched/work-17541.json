.tmdb.org/t/p/original/plk1c9SbjR0mDwv6dUAvNeOF33a.jpg"},{"id":2105358,"name":"Lorena López","role":"Lena","episodeCount":6,"profile":"https://image.tmdb.org/t/p/original/ffZm43wep0jGpiGPvYQy8n6uKOP.jpg"},{"id":4256984,"name":"Laura Wedel","role":"Mati","episodeCount":6,"profile":"https://image.tmdb.org/t/p/original/mrcR2zbX2fHkJuP0BVOgOfweLoz.jpg"}]},"providers":{"streamingunity":[{"id":8436,"path":"/it/titles/8436-ombre-dal-passato","availability":"present","seasons":[{"id":4697,"number":1,"name":null,"plot":"","release_date":null,"title_id":8436,"created_at":"2024-05-10T05:17:07.000000Z","updated_at":"2025-05-12T09:54:11.000000Z","release_date_it":null,"translations":[],"episodes":[{"id":61388,"number":1,"name":"Tornare","plot":"Rita Montero, famosa regista internazionale, torna a Elda dopo venticinque anni e rivede il gruppo di amici che frequentava al liceo. Nel frattempo, Paula Ríos, ispettrice di polizia, arriva a Maiorca per identificare alcuni resti che potrebbero appartenere a sua sorella Matilde, scomparsa venticinque anni prima durante la gita dell'ultimo anno di liceo.","duration":51,"scws_id":225662,"season_id":4697,"created_at":"2024-05-10T05:17:14.000000Z","updated_at":"2025-11-05T08:39:50.000000Z","quality":"HD","audio_orig":1,"dub_ita":1,"sub_ita":0,"uploaded_at":"2024-05-10 07:17:14","images":[{"id":107349,"filename":"4e2852ba-f196-4bec-8e63-2f6e85ef22df.webp","type":"cover","lang":null,"imageable_type":"episode","imageable_id":61388,"created_at":"2024-05-10T05:17:16.000000Z","updated_at":"2024-05-10T05:17:16.000000Z","original_url_field":null,"reference":{"base":"streamingunity:images","path":"/images/4e2852ba-f196-4bec-8e63-2f6e85ef22df.webp"}}],"translations":[{"id":195797,"translatable_type":"episode","translatable_id":61388,"locale":"it","key":"name","value":"Tornare"},{"id":195798,"translatable_type":"episode","translatable_id":61388,"locale":"it","key":"plot","value":"Rita Montero, famosa regista internazionale, torna a Elda dopo venticinque anni e rivede il gruppo di amici che frequentava al liceo. Nel frattempo, Paula Ríos, ispettrice di polizia, arriva a Maiorca per identificare alcuni resti che potrebbero appartenere a sua sorella Matilde, scomparsa venticinque anni prima durante la gita dell'ultimo anno di liceo."}]},{"id":61387,"number":2,"name":"Vecchi Peccati","plot":"La notizia del ritrovamento dei resti di Mati sconvolge il gruppo. Tuttavia, alcuni sembrano sapere più di quanto affermano. Lena insiste per parlare da sola con Rita, la quale, perseguitata dai fantasmi del suo passato, vorrebbe tornare subito a Londra. Paula inizia a indagare su quanto è accaduto a sua sorella.","duration":52,"scws_id":225663,"season_id":4697,"created_at":"2024-05-10T05:17:09.000000Z","updated_at":"2025-11-05T08:39:50.000000Z","quality":"HD","audio_orig":1,"dub_ita":1,"sub_ita":0,"uploaded_at":"2024-05-10 07:17:09","images":[{"id":107348,"filename":"6eacd030-c9b5-40c5-b514-956f89db4b55.webp","type":"cover","lang":null,"imageable_type":"episode","imageable_id":61387,"created_at":"2024-05-10T05:17:12.000000Z","updated_at":"2024-05-10T05:17:12.000000Z","original_url_field":null,"reference":{"base":"streamingunity:images","path":"/images/6eacd030-c9b5-40c5-b514-956f89db4b55.webp"}}],"translations":[{"id":195795,"translatable_type":"episode","translatable_id":61387,"locale":"it","key":"name","value":"Vecchi Peccati"},{"id":195796,"translatable_type":"episode","translatable_id":61387,"locale":"it","key":"plot","value":"La notizia del ritrovamento dei resti di Mati sconvolge il gruppo. Tuttavia, alcuni sembrano sapere più di quanto affermano. Lena insiste per parlare da sola con Rita, la quale, perseguitata dai fantasmi del suo passato, vorrebbe tornare subito a Londra. Paula inizia a indagare su quanto è accaduto a sua sorella."}]},{"id":61391,"number":3,"name":"Le ragazze del 28","plot":"Scossa dagli ultimi avvenimenti, Rita accantona il suo desiderio di tornare a Londra e si unisce alle indagini di Paula. Questo la porta a scontrarsi con il suo gruppo di amici, soprattutto con Candela, con la quale ha avuto una storia d'amore in passato. Sentendosi minacciate, anche le altre si uniscono alle indagini ed escogitano strategie per far sì che la polizia tenga gli occhi ben lontano dalla situazione.","duration":50,"scws_id":225664,"season_id":4697,"created_at":"2024-05-10T05:21:03.000000Z","updated_at":"2025-11-05T08:39:50.000000Z","quality":"HD","audio_orig":1,"dub_ita":1,"sub_ita":0,"uploaded_at":"2024-05-10 07:21:03","images":[{"id":107352,"filename":"187da96d-9ded-49ba-b85a-b34f9fb31c9a.webp","type":"cover","lang":null,"imageable_type":"episode","imageable_id":61391,"created_at":"2024-05-10T05:21:07.000000Z","updated_at":"2024-05-10T05:21:07.000000Z","original_url_field":null,"reference":{"base":"streamingunity:images","path":"/images/187da96d-9ded-49ba-b85a-b34f9fb31c9a.webp"}}],"translations":[{"id":195803,"translatable_type":"episode","translatable_id":61391,"locale":"it","key":"name","value":"Le ragazze del 28"},{"id":195804,"translatable_type":"episode","translatable_id":61391,"locale":"it","key":"plot","value":"Scossa dagli ultimi avvenimenti, Rita accantona il suo desiderio di tornare a Londra e si unisce alle indagini di Paula. Questo la porta a scontrarsi con il suo gruppo di amici, soprattutto con Candela, con la quale ha avuto una storia d'amore in passato. Sentendosi minacciate, anche le altre si uniscono alle indagini ed escogitano strategie per far sì che la polizia tenga gli occhi ben lontano dalla situazione."}]},{"id":61389,"number":4,"name":"Ondata","plot":"Angela torna a Londra e Rita sente che il mondo le sta crollando addosso. Sa che le sue amiche stanno cercando di distogliere l'attenzione della polizia e chiede l'aiuto dell'avvocato Candela. Candela accetta su insistenza di Rita, e poi le due passano la giornata in spiaggia ricordando tutta la magia che c'era stata tra loro da adolescenti.","duration":50,"scws_id":225665,"season_id":4697,"created_at":"2024-05-10T05:19:02.000000Z","updated_at":"2025-11-05T08:39:50.000000Z","quality":"HD","audio_orig":1,"dub_ita":1,"sub_ita":0,"uploaded_at":"2024-05-10 07:19:02","images":[{"id":107350,"filename":"c610627b-c738-42e2-908a-847ec4e0c8c8.webp","type":"cover","lang":null,"imageable_type":"episode","imageable_id":61389,"created_at":"2024-05-10T05:19:04.000000Z","updated_at":"2024-05-10T05:19:04.000000Z","original_url_field":null,"reference":{"base":"streamingunity:images","path":"/images/c610627b-c738-42e2-908a-847ec4e0c8c8.webp"}}],"translations":[{"id":195799,"translatable_type":"episode","translatable_id":61389,"locale":"it","key":"name","value":"Ondata"},{"id":195800,"translatable_type":"episode","translatable_id":61389,"locale":"it","key":"plot","value":"Angela torna a Londra e Rita sente che il mondo le sta crollando addosso. Sa che le sue amiche stanno cercando di distogliere l'attenzione della polizia e chiede l'aiuto dell'avvocato Candela. Candela accetta su insistenza di Rita, e poi le due passano la giornata in spiaggia ricordando tutta la magia che c'era stata tra loro da adolescenti."}]},{"id":61393,"number":5,"name":"La Tempesta","plot":"Vengono ritrovate delle vecchie fotografie conservate dalla madre di Paula in un vecchio magazzino e le indagini di Paula si intensificano. È la sua ultima occasione per dimostrare che la sorella non è morta in un incidente. Trova sostegno in Rita, che però ignora ancora una volta i consigli di Candela, e mette in pericolo la loro relazione. Tutto peggiora quando il capo della polizia decide di chiudere il caso.","duration":51,"scws_id":225666,"season_id":4697,"created_at":"2024-05-10T05:22:02.000000Z","updated_at":"2025-11-05T08:39:50.000000Z","quality":"HD","audio_orig":1,"dub_ita":1,"sub_ita":0,"uploaded_at":"2024-05-10 07:22:02","images":[{"id":107354,"filename":"5605dca4-74b0-4629-a287-6e50e6081962.webp","type":"cover","lang":null,"imageable_type":"episode","imageable_id":61393,"created_at":"2024-05-10T05:22:05.000000Z","updated_at":"2024-05-10T05:22:05.000000Z","original_url_field":null,"reference":{"base":"streamingunity:images","path":"/images/5605dca4-74b0-4629-a287-6e50e6081962.webp"}}],"translations":[{"id":195812,"translatable_type":"episode","translatable_id":61393,"locale":"it","key":"name","value":"La Tempesta"},{"id":195813,"translatable_type":"episode","translatable_id":61393,"locale":"it","key":"plot","value":"Vengono ritrovate delle vecchie fotografie conservate dalla madre di Paula in un vecchio magazzino e le indagini di Paula si intensificano. È la sua ultima occasione per dimostrare che la sorella non è morta in un incidente. Trova sostegno in Rita, che però ignora ancora una volta i consigli di Candela, e mette in pericolo la loro relazione. Tutto peggiora quando il capo della polizia decide di chiudere il caso."}]},{"id":61392,"number":6,"name":"Patto di sangue","plot":"Il caso è ufficialmente chiuso, e l'indagine si blocca. Rita pensa agli ultimi preparativi per il suo ritorno a Londra. Sembra tutto finito e gli amici tirano un sospiro di sollievo. Proprio quando torna la quiete nelle loro case, un arresto inaspettato della polizia e l'emergere di nuove prove inducono Rita a rimandare i suoi piani e la conducono finalmente alla verità risalente a venticinque anni prima.","duration":52,"scws_id":225667,"season_id":4697,"created_at":"2024-05-10T05:21:09.000000Z","updated_at":"2025-11-05T08:39:50.000000Z","quality":"HD","audio_orig":1,"dub_ita":1,"sub_ita":0,"uploaded_at":"2024-05-10 07:21:09","images":[{"id":107353,"filename":"491fbf82-04af-4387-b269-4acb81a36248.webp","type":"cover","lang":null,"imageable_type":"episode","imageable_id":61392,"created_at":"2024-05-10T05:21:12.000000Z","updated_at":"2024-05-10T05:21:12.000000Z","original_url_field":null,"reference":{"base":"streamingunity:images","path":"/images/491fbf82-04af-4387-b269-4acb81a36248.webp"}}],"translations":[{"id":195805,"translatable_type":"episode","translatable_id":61392,"locale":"it","key":"name"