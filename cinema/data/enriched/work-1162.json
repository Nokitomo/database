original/lP0t098CUWtaPmfzLe4hMY4hbq2.jpg"},{"id":3230295,"name":"Alessandra Scirdi","role":"Vigile Urbano","profile":"https://image.tmdb.org/t/p/original/w8woAItye1ztkYlSk29RCa2FCAt.jpg"},{"id":4828939,"name":"Francesco Stoia","role":"Tiromancino Band"},{"id":4828940,"name":"Antonio Marcucci","role":"Tiromancino Band #2"},{"id":1925259,"name":"Mavina Graziani","role":"Mandy"},{"id":2486998,"name":"Giorgia Mangiafesta","role":"Silvia"},{"id":3109162,"name":"Massimo Galimberti","role":"Galimberti"},{"id":1359232,"name":"Stefano Venturi","role":"Dottor Sanna","profile":"https://image.tmdb.org/t/p/original/7UN6tyx6ef5bb9gH2LjMnkGjy01.jpg"},{"id":2807016,"name":"Sofia Pellegrino","role":"Barista Morrison"},{"id":3855377,"name":"Andrea Ceravolo","role":"Ragazzo","profile":"https://image.tmdb.org/t/p/original/uYa497ZVFesE4rDB5GsGfQp3rFG.jpg"},{"id":1875053,"name":"Rosa Enginoli Gerini","role":"Ragazza"},{"id":4828946,"name":"Gabriele Marchingiglio","role":"Voce Speaker TG"},{"id":142134,"name":"Andrea Aureli","role":"DJ","profile":"https://image.tmdb.org/t/p/original/c0PKQwnVQxFNhKaOHwDIp3sQF2s.jpg"},{"id":4828947,"name":"Gianni Galli","role":"Giornalista"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","overview":"Lodo ha vent’anni e vive le difficoltà della sua età, tra un difficile rapporto con il padre e il tentativo di conquistare Giulia, la sua coinquilina di cui è follemente innamorato. Si esibisce con i MOB, una band indie, in un leggendario locale romano: il Morrison. Un giorno, casualmente, la strada di Lodo incrocia quella di Libero Ferri, ex rockstar dalla carriera in stallo, che cerca di ritrovare il successo ma finisce per chiudersi sempre di più in se stesso, trascurando la bella moglie Luna e vivendo isolato nella sua lussuosa villa piena di ricordi.  Tra sogni, fallimenti, amicizia, amori tormentati e curiosi personaggi, il loro incontro diventerà uno stimolo reciproco ad andare avanti, ma a tratti anche un difficile confronto tra generazioni e modi di essere molto diversi."},{"language":"en-US","overview":"Lodo is twenty years old and lives the difficulties of his age, between a difficult relationship with his father and the attempt to conquer Giulia, his roommate with whom he is madly in love. He performs with the MOB, an indie band, in a legendary Roman club: the Morrison. One day, by chance, Lodo's path crosses that of Libero Ferri, a former rock star with a stalemate career, who tries to find success but ends up withdrawing more and more in himself, neglecting his beautiful wife Luna and living isolated in his luxurious villa full of memories. Between dreams, failures, friendship, tormented loves and curious characters, their meeting will become a mutual stimulus to move forward, but at times also a difficult comparison between generations and very different ways of being."}],"images":{"logos":[{"type":"logo","url":"https://image.tmdb.org/t/p/original/mDpGKJKreH3BhmlgH1Bf1jcXSI0.png","previewUrl":"https://image.tmdb.org/t/p/w300/mDpGKJKreH3BhmlgH1Bf1jcXSI0.png","language":"en","width":1274,"height":180}],"posters":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/lnyWxCpFiAiDA2LGSRDjnhUGUzq.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/lnyWxCpFiAiDA2LGSRDjnhUGUzq.jpg","language":"it","width":900,"height":1350},{"type":"poster","url":"https://image.tmdb.org/t/p/original/OjAXRGCWBuRIS8WIyf4rTERoGS.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/OjAXRGCWBuRIS8WIyf4rTERoGS.jpg","language":"it","width":1000,"height":1500}],"backdrops":[{"type":"backdrop","url":"https://image.tmdb.org/t/p/original/i83Z30QLgtcf37oYt5exyCRdX82.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/i83Z30QLgtcf37oYt5exyCRdX82.jpg","language":"it","width":1280,"height":720},{"type":"backdrop","url":"https://image.tmdb.org/t/p/original/jrR7HoZ1v6D79yr9vpYzNetrlaf.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/jrR7HoZ1v6D79yr9vpYzNetrlaf.jpg","language":"en","width":1280,