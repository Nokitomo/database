2a.webp"},"provider":"streamingunity"}],"episodeMappingUncertain":false,"seasons":[],"provenance":{},"warnings":[],"externalIdsEvidence":{"wikidata":{"source":"wikidata","sourceUrl":"https://www.wikidata.org/wiki/Q135236478","wikidataId":"Q135236478","tmdbId":1117027,"type":"movie","imdbId":"tt27759716","tvdbId":360778}},"externalMedia":{"tmdb":{"source":"tmdb-api","id":1117027,"type":"movie","sourceUrl":"https://www.themoviedb.org/movie/1117027","fetchedAt":"2026-11-06T08:26:20.525Z","originalLanguage":"en-US","title":{"value":"Cassino in Ischia","language":"en-US"},"originalTitle":"Cassino in Ischia","overview":{"value":"Nic Cassino è un attore americano di film d'azione la cui carriera un tempo gloriosa è oggi in rapido declino. Sconsolato dalla mancanza di ingaggi, accetta un invito dal Giffoni Film Festival che ha programmato una retrospettiva sulla sua carriera. Il Festival proietta anche il nuovo film del regista Italiano Fabrizio Favuzzo, che però non ha molta fortuna. Alla disperata ricerca di ispirazione, Favuzzo - ospite a Ischia dei genitori del fidanzato di sua figlia -  decide di visitare la vicina villa del suo idolo Luchino Visconti, La Colombaia, dove spera di trovare un guizzo per rilanciare la sua fallimentare carriera, o un precipizio dal quale buttarsi. Alla Villa, le preghiere del regista suicida vengono esaudite quando si imbatte nel quaderno contenente una sceneggiatura inedita, ma incompleta, di Visconti. È proprio in quel momento che Favuzzo si imbatte casualmente in Nic.","language":"it-IT"},"releaseDate":"2024-09-30","status":"Released","rating":5.1,"ratingCount":17,"genres":["Commedia","Azione"],"countries":["United States of America"],"facts":{"Runtime":"113m"},"keywords":[],"networks":[],"socialLinks":{},"cast":[{"id":10862,"name":"Dominic Purcell","role":"Nic Cassino","profile":"https://image.tmdb.org/t/p/original/5GtHSYdnH7o2x5UIm09XqqLoJKO.jpg"},{"id":232111,"name":"Ugo Dighero","role":"Fabrizio Favuzzo","profile":"https://image.tmdb.org/t/p/original/gUJDnk8raCMrbDB94U95sdmCtyu.jpg"},{"id":1807500,"name":"Miriam Candurro","role":"Titina Monti","profile":"https://image.tmdb.org/t/p/original/4R4Ar2bs2EPu463wUdRzzlAGz68.jpg"},{"id":1587369,"name":"Marcello Romolo","role":"Angioletto Di Meglio","profile":"https://image.tmdb.org/t/p/original/p9dsUxJQNJ685XMxSaoj63iQops.jpg"},{"id":1123312,"name":"Carlotta Natoli","role":"Lorella Favuzzo","profile":"https://image.tmdb.org/t/p/original/fdVfGAslFZsoWeRzho0YziRVpvQ.jpg"},{"id":1844011,"name":"Lucianna De Falco","role":"Filomena Di Meglio","profile":"https://image.tmdb.org/t/p/original/hUOpHDgmCp1ID6xLUptOvAHXBc3.jpg"},{"id":1311612,"name":"Fabio Avaro","profile":"https://image.tmdb.org/t/p/original/kg2Y6A9IjLvWpFs9RhuHnz1C2GG.jpg"},{"id":4058044,"name":"Simone Mazzella","role":"Nello Di Meglio"},{"id":2619096,"name":"Alessia Santalucia","role":"Ombretta Favuzzo","profile":"https://image.tmdb.org/t/p/original/dsot3GREKCeEFlLxcLAoUwg6n1Q.jpg"},{"id":4121118,"name":"Claudia Delli Noci","role":"Sabrina Fiorucci","profile":"https://image.tmdb.org/t/p/original/9uym86azPOwLVvK0S3YwrmicJde.jpg"},{"id":17163,"name":"Yvonne Sciò","role":"Aurora Cassino","profile":"https://image.tmdb.org/t/p/original/sIGxBizntdQVftxzYKvW2kdJF7M.jpg"},{"id":1106228,"name":"Jennifer Mischiati","role":"Carla","profile":"https://image.tmdb.org/t/p/original/aS3IPS4KqWV0PibR2d6Wkca6yM0.jpg"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","overview":"Nic Cassino è un attore americano di film d'azione la cui carriera un tempo gloriosa è oggi in rapido declino. Sconsolato dalla mancanza di ingaggi, accetta un invito dal Giffoni Film Festival che ha programmato una retrospettiva sulla sua carriera. Il Festival proietta anche il nuovo film del regista Italiano Fabrizio Favuzzo, che però non ha molta fortuna. Alla disperata ricerca di ispirazione, Favuzzo - ospite a Ischia dei genitori del fidanzato di sua figlia -  decide di visitare la vicina villa del suo idolo Luchino Visconti, La Colombaia, dove spera di trovare un guizzo per rilanciare la sua fallimentare carriera, o un precipizio dal quale buttarsi. Alla Villa, le preghiere del regista suicida vengono esaudite quando si imbatte nel quaderno contenente una sceneggiatura inedita, ma incompleta, di Visconti. È proprio in quel momento che Favuzzo si imbatte casualmente in Nic."},{"language":"en-US","overview":"A former film star travels to Italy to work with a struggling director in order to revitalize his career."}],"images":{"logos":[{"type":"logo","url":"https://image.tmdb.org/t/p/original/rtbXoNRpkqgzzAnZV0c1YbsQkmG.png","previewUrl":"https://image.tmdb.org/t/p/w300/rtbXoNRpkqgzzAnZV0c1YbsQkmG.png","language":"xx","width":540,"height":295}],"posters":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/3HNFnLe9DcDt3ZcytxOXzeToEvQ.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/3HNFnLe9DcDt3ZcytxOXzeToEvQ.jpg","language":"en","width":2000,"height":3000},{"type":"poster","url":"https://image.tmdb.org/t/p/original/rjUMKO2XGFReaOzQPPjKEcdpoTG.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/rjUMKO2XGFReaOzQPPjKEcdpoTG.jpg","language":"en","width":2000,"height":3000},{"type":"poster","url":"https://image.tmdb.org/t/p/original/4fbaCJDM4Zg6tRuCZd1LGL5YhUe.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/4fbaCJDM4Zg6tRuCZd1LGL5YhUe.jpg","language":"en","width":2000,"height":3000},{"type":"poster","url":"https://image.tmdb.org/t/p/original/9y7tSy4Z6m2WPObno7h9yNBN2x4.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/9y7tSy4Z6m2WPObno7h9yNBN2x4.jpg","language":"xx","width":2000,"height":3000},{"type":"poster","url":"https://image.tmdb.org/t/p/original/4PcPFtpdqT3GJKJ0xCToFq5s2Wd.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/4PcPFtpdqT3GJKJ0xCToFq5s2Wd.jpg","language":"xx","width":1500,"height":2250},{"type":"poster","url":"https://image.tmdb.org/t/p/original/eyFNoyIq5g9E5fRyBGK9DkJopIC.jpg","previewUrl":"https://image.tmdb.org/t/p/w30