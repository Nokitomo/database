rofile":"https://image.tmdb.org/t/p/original/u4J2CSTm5HfWWgjdDH3w9SUWBiy.jpg"},{"id":5260170,"name":"Naïs Desiles","role":"Femme synthétique / Brigadier (voice)"},{"id":1364266,"name":"Martial Le Minoux","role":"Robot 4 (voice)","profile":"https://image.tmdb.org/t/p/original/fwVHuPoEv8j4VjBTibizOAAIga1.jpg"},{"id":964786,"name":"Laurent Sarfati","role":"Robot 6 (voice)"},{"id":4367858,"name":"Renaud Jesionek","role":"Brain farmer (voice)","profile":"https://image.tmdb.org/t/p/original/wPUiiN0KZjeG3jbRx4LrQfzj3vN.jpg"},{"id":2151099,"name":"Maxime Pacaud","role":"Médecin / Proviseur / Le vrai Mr Chow (voice)"},{"id":1762591,"name":"Marie Chevalot","role":"Réactions / Rôles divers (voice)","profile":"https://image.tmdb.org/t/p/original/tHvk1jTWad3kb27c2v0zN0T2eFz.jpg"},{"id":5260172,"name":"Catherine Tartara","role":"Vendeuse / Flic / Robot (voice)"},{"id":5260173,"name":"Nancy Guyon","role":"Nageuse / Lem fille / Présentatrice (voice)"},{"id":5098706,"name":"Sebastien Bizzotto","role":"Jeffrey Kearney / Divisionnaire / Douanier (voice)"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","title":"Mars Express","overview":"Ambientato su Marte nel 23 secolo, la detective privata Aline Ruby e il suo partner androide Carlos Rivera indagano su un caso di omicidio."},{"language":"en-US","overview":"In 2200, private detective Aline Ruby and her android partner Carlos Rivera are hired by a wealthy businessman to track down a notorious hacker. On Mars, they descend deep into the underbelly of the planet's capital city where they uncover a darker story of brain farms, political corruption, and a missing girl who holds a secret about the robots that threatens to change the face of the universe.","tagline":"Built to serve. Programmed to live."},{"language":"fr-FR","overview":"En l’an 2200, Aline Ruby, détective privée obstinée, et Carlos Rivera son partenaire androïde sont embauchés par un riche homme d’affaires afin de capturer sur Terre une célèbre hackeuse. De retour sur Mars, une nouvelle affaire va les conduire à s’aventurer dans les entrailles de Noctis, la capitale martienne, à la recherche de Jun Chow, une étudiante en cybernétique disparue. Noctis est leur ville, une utopie libertarienne rendue possible par les progrès en robotique, emblème d’un futur tourné vers les étoiles. Au fil de leur enquête, ils seront confrontés aux plus sombres secrets de leur cité ; ses institutions corrompues, ses trafics, ses fermes cérébrales, et les magouilles des toutes puissantes corporations. Mais des tueurs cyber augmentés ont eux aussi pris pour cible Jun Chow. Aline et Carlos se lancent dans une course désespérée pour sauver cette jeune femme qui, sans le savoir, détient un secret capable de menacer l’équilibre précaire sur lequel repose leur civilisation.","tagline":"Construit pour servir. Programmé pour vivre."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/JEPbbxkFtRASU1WzeQGRvKqjuO.jpg","background":"https://image.tmdb.org/t/p/original/yIOw17XdfsoCaydtrkzlZBCcHk6.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":586810,"type":"movie","originalLanguage":"fr-FR","series":{"poster":{"it":{"status":"missing","candidates":[]},"en":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/g8rUn0khoYB3G4gPPGTF1Xv9Olu.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/g8rUn0khoYB3G4gPPGTF1Xv9Olu.jpg","language":"en","width":2000,"height":3000},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/g8rUn0khoYB3G4gPPGTF1Xv9Olu.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/g8rUn0khoYB3G4gPPGTF1Xv9Olu.jpg","language":"en","width":2000,"height":3000},{"type":"poster","url":"https://image.tmdb.org/t/p/original/bagX09lbBjqnTMqggSXAQOpt22B.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/bagX09lbBjqnTMqggSXAQOpt22B.jpg","language":"en","width":710,"heig