.tmdb.org/t/p/original/siDpFEu913CMSSAhTCaoXT1S2a2.jpg"},{"id":144137,"name":"Tehilla Blad","role":"Young Lisbeth","profile":"https://image.tmdb.org/t/p/original/jh3JTpmXVYUs4k4o1rz0v60TOTO.jpg"},{"id":1544577,"name":"Alexandra Hummingson","profile":"https://image.tmdb.org/t/p/original/gusBL6PvUejc2AiN0NyqRXWpffr.jpg"},{"id":76548,"name":"Agnes Kittelsen","profile":"https://image.tmdb.org/t/p/original/2neXYDVEYrCR9tifNy5YJk6tkQj.jpg"},{"id":1244028,"name":"Alexandra Pascalidou","role":"Herself","profile":"https://image.tmdb.org/t/p/original/l4fHIhPon3zphxhSVDNwPIesmvK.jpg"},{"id":6294,"name":"Niklas Falk","role":"Edklinth","profile":"https://image.tmdb.org/t/p/original/1NqPIBlo9dpZJ075UzciE2TWq2b.jpg"},{"id":1544577,"name":"Alexandra Hummingson","role":"Journalist (uncredited)","profile":"https://image.tmdb.org/t/p/original/gusBL6PvUejc2AiN0NyqRXWpffr.jpg"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","title":"La regina dei castelli di carta","overview":"Sopravvissuta al confronto col padre e alla furia dell'esagerato fratellastro, Lisbeth Salander viene ricoverata in ospedale con una pallottola in testa. A un passo dalla morte e a due camere dalla stanza di Alexander Zalachenko, la ragazza che odia gli uomini e su tutti il genitore disertore è una minaccia per la Sezione, ramo deviato e criminale della SÄPO (i servizi segreti svedesi). Sfinita dagli abusi e dai soprusi, Lisbeth è decisa a rivelare al mondo le mostruosità commesse dal padre e dallo spregevole dottor Teleborian, disposto di nuovo a redigere a suo danno una falsa perizia psichiatrica. Per salvaguardare Zalachenko, preziosa fonte di informazioni, e il loro circolo corrotto operativo dagli anni Settanta i \"servizi\" organizzeranno una violenta rappresaglia. A difesa della verità e della vita di Lisbeth ancora una volta interverrà Mikael Blomkvist. La sua inchiesta denuncerà i colpevoli, riportando al centro dell'attenzione e del suo cuore la problematica Lisbeth.","tagline":"Conta solo vendicarsi... Lisbeth è tornata."},{"language":"en-US","title":"The Girl Who Kicked the Hornet's Nest","overview":"After taking a bullet to the head, Salander is under close supervision in a hospital and is set to face trial for attempted murder on her eventual release. With the help of journalist Mikael Blomkvist and his researchers at Millennium magazine, Salander must prove her innocence. In doing this she plays against powerful enemies and her own past.","tagline":"There's A Storm Coming"},{"language":"sv-SV","overview":"Lisbeth Salander ligger på sjukhus efter att ha blivit skjuten i huvudet. Polisen startar en utredning, men i takt med att sanningen om hennes tidigare liv kommer fram avslöjas också en sammansvärjning på högsta nivå. Alla jagar alla, men ingen kan stoppa Salander och Mikael Blomkvist i deras jakt efter rättvisa!Äntligen kommer det definitiva slutet på Stieg Larssons oerhört populära och andlöst spännande Millenium-trilogi. Alla skelett ska ut ur garderoben när Blomkvist och Salander möts för sista gången!"}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/s1fYuOLG0Z5OiwyPoZd9qIzcS0t.jpg","background":"https://image.tmdb.org/t/p/original/qhohCrCs4sv1M4H9NIRlhgl0lcE.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":33613,"type":"movie","originalLanguage":"sv-SV","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/s1fYuOLG0Z5OiwyPoZd9qIzcS0t.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/s1fYuOLG0Z5OiwyPoZd9qIzcS0t.jpg","language":"it","width":1000,"height":1500},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/s1fYuOLG0Z5OiwyPoZd9qIzcS0t.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/s1fYuOLG0Z5OiwyPoZd9qIzcS0t.jpg","language":"it","width":1000,"height":1500},{"type":"poster","url":"https://image.tmdb.org/t/p/original/l