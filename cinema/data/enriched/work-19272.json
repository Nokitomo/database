n is conducted by Inspector Messina, a trendy cop.  Maria and Messina become an inseparable investigating team.  Maria poses as a call-girl in order to reveal her sister's killer and they use mobile phones to keep in touch."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/ptvQb3zkCXjKu138P02UOjbjXSm.jpg","background":"https://image.tmdb.org/t/p/original/5MaUuFoZzGyVEUxO7psu6JU8ro8.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":108465,"type":"movie","originalLanguage":"it-IT","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/ptvQb3zkCXjKu138P02UOjbjXSm.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/ptvQb3zkCXjKu138P02UOjbjXSm.jpg","language":"it","width":695,"height":1000},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/ptvQb3zkCXjKu138P02UOjbjXSm.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/ptvQb3zkCXjKu138P02UOjbjXSm.jpg","language":"it","width":695,"height":1000},{"type":"poster","url":"https://image.tmdb.org/t/p/original/jPTpnRXkB6SGQ2iomu1nEWNM4vj.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/jPTpnRXkB6SGQ2iomu1nEWNM4vj.jpg","language":"it","width":525,"height":788},{"type":"poster","url":"https://image.tmdb.org/t/p/original/yfpCCbjmvxefYusHJPmUo4oNFOL.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/yfpCCbjmvxefYusHJPmUo4oNFOL.jpg","language":"it","width":768,"height":1024}]},"en":{"status":"missing","candidates":[]},"xx":{"status":"missing","candidates":[]}},"background":{"it":{"status":"missing","candidates":[]},"en":{"status":"missing","candidates":[]},"xx":{"status":"available","selected":{"type":"backdrop","url":"https://image.tmdb.org/t/p/original/5MaUuFoZzGyVEUxO7psu6JU8ro8.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/5MaUuFoZzGyVEUxO7psu6JU8ro8.jpg","language":"xx","width":1280,"height":720},"candidates":[{"type":"backdrop","url":"https://i