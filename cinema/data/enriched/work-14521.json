Qz0KBW7GnCslxfdQ5oVK6gJHD.jpg"},{"id":1091284,"name":"Kôsuke Hamamoto","role":"Genesis' Gang"},{"id":1091286,"name":"Yoko Kamon","role":"The Bat / Kiyoko","profile":"https://image.tmdb.org/t/p/original/gqGKbU8amjc3OFiCvJ9N7oA1Xsr.jpg"},{"id":1091285,"name":"Kei Nagase","role":"Genesis' Gang"},{"id":1091287,"name":"Maiko Mori","role":"Kiyoko's Sister"},{"id":1417325,"name":"Suzunosuke Tanaka","profile":"https://image.tmdb.org/t/p/original/6IjOHn6iBjdWfuZ8Nty7o12UpgS.jpg"},{"id":2092720,"name":"Kanako Hiramatsu","profile":"https://image.tmdb.org/t/p/original/1FJLtiGc3NSPDXbYhSCUQDjeVbo.jpg"},{"id":209006,"name":"Keiko Suzuki","profile":"https://image.tmdb.org/t/p/original/A2rKWZpalWggNAU1jQQdpmR1dir.jpg"},{"id":2613944,"name":"Ryuji Kasahara"},{"id":80864,"name":"Kimiko Yo","profile":"https://image.tmdb.org/t/p/original/g1NZGtCzJKpqgdjNbNYaKBPyYRw.jpg"},{"id":135524,"name":"Kenjiro Tsuda","profile":"https://image.tmdb.org/t/p/original/yFpSPNHqYN4rdRiVpVaYmqXMkmi.jpg"},{"id":1291355,"name":"Mitsuru Kuramoto"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","title":"Suicide Club","overview":"Cinquantaquattro ragazze liceali si tengono per mano, sorridono e si suicidano improvvisamente, gettandosi sotto un treno in corsa nella metropolitana di Shinjuku. Il detective Kuroda viene incaricato del caso, e inizia a seguire diverse piste. Intanto Tokyo è sconvolta da una serie di inspiegabili suicidi, commessi da ragazzi e ragazze di età inferiore ai 16 anni. Inizialmente convinto che si tratti di una coincidenza, Kuroda capisce che c'è qualcosa di più.","tagline":"E per te ci sei? Ganbare!"},{"language":"en-US","title":"Suicide Club","overview":"When the bizarre mass suicide of 54 high school girls throwing themselves in front of a subway train appears to instigate a string of suicides around the country, Detective Kuroda strives to find the answer, which isn't as simple as he had hoped.","tagline":"Well then, goodbye everybody."},{"language":"ja-JP","title":"自殺サークル","overview":"新宿のプラットホーム。楽しげにおしゃべりをする女子高校生の集団。電車がホームに入ってきた瞬間、彼女たち54人の女子高校生たちは手をつないだまま飛び降りた。同じ頃、各地で集団自殺が次々と起こり始める。“事件”なのか“事故”なのか、迷う警察。そんな中、警視庁の刑事・黒田のもとに次回の集団自殺を予告する電話が入る。本格捜査に切り替え、集団自殺をくい止めようとする黒田たちの奮闘も虚しく再び都内のあちこちで壮絶な連鎖自殺が続発する。そして、落胆し帰宅した黒田を待っていたのは凄惨な家族全員の自殺現場だった…。","tagline":"それではみなさんさようなら。"}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/gTwhwhfiRxgTSzcQ8sZBAoZSZ5t.jpg","background":"https://image.tmdb.org/t/p/original/pK8jgMF9o5SBq7grQzVnpeqib7Y.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":12720,"type":"movie","originalLanguage":"ja-JP","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/gTwhwhfiRxgTSzcQ8sZBAoZSZ5t.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/gTwhwhfiRxgTSzcQ8sZBAoZSZ5t.jpg","language":"it","width":1260,"height":1890},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/gTwhwhfiRxgTSzcQ8sZBAoZSZ5t.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/gTwhwhfiRxgTSzcQ8sZBAoZSZ5t.jpg","language":"it","width":1260,"height":1890},{"type":"poster","url":"https://image.tmdb.org/t/p/original/somzBnNY8AKVJu1cmU0wyShVbZd.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/somzBnNY8AKVJu1cmU0wyShVbZd.jpg","language":"it","width":1200,"height":1697}]},"en":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/oMjWlKHzR9cwhf3oCUy9j57o67O.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/oMjWlKHzR9cwhf3oCUy9j57o67O.jpg","language":"en","width":1000,"height":1500},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/oMjWlKHzR9cwhf3oCUy9j57o67O.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/oMjWlKHzR9cwhf3oCUy9j57o67O.jpg","language":"en","width":1000,"height":1500},{"type":"poster","url":"https://image.tmdb.org/t/p/original/pGStN4vXC2WyJZ1IcQHAPFYXrgY.jpg","previewUrl":