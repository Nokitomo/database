kR2HQU8pB7saSPM0qaF3O1hehPb.jpg"},{"id":1050765,"name":"Guillermo Jacubowicz","role":"Cardozo","profile":"https://image.tmdb.org/t/p/original/3REBY1An5fn3ByORifeYoBOQN2C.jpg"},{"id":1814150,"name":"Jorge Prado","role":"Molina","profile":"https://image.tmdb.org/t/p/original/ixbqYtlsc7mAAntvgMUo3Jrfc9X.jpg"},{"id":1886228,"name":"Jimena Acevedo","role":"Madre Cetarti 2"},{"id":4907978,"name":"Violeta Vidal","role":"Cajera Banco"},{"id":2405479,"name":"Luis Navarro","role":"Policía"},{"id":4907974,"name":"Estanislao Arpone","role":"Hermano Cetarti"},{"id":4907979,"name":"Maximiliano Rúa","role":"Joven Secuestrado"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","title":"L'altro fratello","overview":"Per sistemare gli affari della madre e del fratello assassinati, un uomo ricorre a un criminale locale per truffare un'assicurazione e si ritrova su una brutta strada."},{"language":"en-US","title":"The Lost Brother","overview":"Cetarti is drowning in nothingness. With no job or purpose, he spends his days inside watching documentaries on television, until one day he is informed that his mother and brother were gunned down. He travels from Buenos Aires to Lapachito, a decrepit town in the province of Chaco in northern Argentina to deal with their bodies and to get the life insurance money. There he meets Duarte, a sort of boss in the town and a friend of his mother's murderer who also kidnaps people for money. Cetarti's path will lead him to committing illegal acts to get his hands on the insurance money and to his involvement in Duarte's dark dealings, leading to an absurd and unexpected outcome."},{"language":"es-ES","overview":"Cetarti, un empleado público que acaba de ser despedido, viaja desde Buenos Aires a Lapachito, un solitario pueblo en la provincia del Chaco. Debe hacerse cargo de los cadáveres de su madre y su hermano que han sido brutalmente asesinados, y con quienes no lo une ningún lazo afectivo. Lo único que moviliza a Cetarti a emprender el viaje es la posibilidad de cobrar un modesto seguro de vida para poder radicarse en Brasil. Allí conoce a Duarte, una suerte de capo del pueblo y amigo del asesino de su madre, con quien establece una extraña sociedad para gestionar y cobrar ese dinero.","tagline":"Nada más peligroso que un hombre común."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/ueJ0hARGGEA2JT1o3e9DEpjErat.jpg","background":"https://image.tmdb.org/t/p/original/kOmTEgbJAj6RTFTa5lhBytqc97e.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":447904,"type":"movie","originalLanguage":"es-ES","series":{"poster":{"it":{"status":"missing","candidates":[]},"en":{"status":"missing","candidates":[]},"es":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/ueJ0hARGGEA2JT1o3e9DEpjErat.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/ueJ0hARGGEA2JT1o3e9DEpjErat.jpg","language":"es","width":1067,"height":1600},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/ueJ0hARGGEA2JT1o3e9DEpjErat.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/ueJ0hARGGEA2JT1o3e9DEpjErat.jpg","language":"es","width":1067,"height":1600},{"type":"poster","url":"https://image.tmdb.org/t/p/original/qs0XK8pzRrzcnZDiYN9VoPWPgf.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/qs0XK8pzRrzcnZDiYN9VoPWPgf.jpg","language":"es","width":646,"height":968},{"type":"poster","url":"https://image.tmdb.org/t/p/original/rpLsI0JNJkJlCqwpNKXPMXpCAHw.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/rpLsI0JNJkJlCqwpNKXPMXpCAHw.jpg","language":"es","width":500,"height":750},{"type":"poster","url":"https://image.tmdb.org/t/p/original/4ySh77TyQQ2FxXQt80iWn6E0Kjm.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/4ySh77TyQQ2FxXQt80iWn6E0Kjm.jpg","language":"es","width":700,"height":1000}]},"xx":{"status":"missing","candidates":[]}},"background":{"it":{"status":