ает Машу от нападения химеры. Так Маша попадает в секретную корпорацию, где узнаёт, что Дед Мороз реально существует и, возглавляя армию магов, способных управлять снегом и льдом, охраняет Землю от вторжения темных сил.  А новогодний праздник — это магический ритуал, который каждый год совершают люди на всей планете, даже не подозревая, что участвуют в самой масштабной битве добра и зла. Дед Мороз сообщает Маше, что судьба нашего мира висит на волоске, и от Маши зависит, кто победит — свет или тьма."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/MQxV4rGemIYhTtAslax9zn75TJ.jpg","background":"https://image.tmdb.org/t/p/original/8VJeQtCyEupxUYfpEIa2PX08oZN.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":428398,"type":"movie","originalLanguage":"ru-RU","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/MQxV4rGemIYhTtAslax9zn75TJ.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/MQxV4rGemIYhTtAslax9zn75TJ.jpg","language":"it","width":1103,"height":1652},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/MQxV4rGemIYhTtAslax9zn75TJ.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/MQxV4rGemIYhTtAslax9zn75TJ.jpg","language":"it","width":1103,"height":1652}]},"en":{"status":"missing","candidates":[]},"ru":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/ubQcU6RdGYVgPlAeJHU8Cx7IpuS.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/ubQcU6RdGYVgPlAeJHU8Cx7IpuS.jpg","language":"ru","width":500,"height":750},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/ubQcU6RdGYVgPlAeJHU8Cx7IpuS.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/ubQcU6RdGYVgPlAeJHU8Cx7IpuS.jpg","language":"ru","width":500,"height":750},{"type":"poster","url":"https://image.tmdb.org/t/p/original/3wnHeVidgwVnZyNwO2Iau7D2Aj5.jpg","previewUrl":"https://i