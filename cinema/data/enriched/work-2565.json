df-48f8-aea3-ca036e7a9084.webp","type":"background","lang":null,"imageable_type":"title","imageable_id":12482,"created_at":"2025-06-12T11:51:32.000000Z","updated_at":"2025-06-12T11:51:32.000000Z","original_url_field":null,"reference":{"base":"streamingunity:images","path":"/images/60aa17ab-10df-48f8-aea3-ca036e7a9084.webp"},"provider":"streamingunity"},{"id":207221,"filename":"e0212bb2-202f-4cf7-8116-540993b7c866.webp","type":"logo","lang":"it","imageable_type":"title","imageable_id":12482,"created_at":"2025-06-12T11:51:36.000000Z","updated_at":"2025-06-12T11:51:36.000000Z","original_url_field":null,"reference":{"base":"streamingunity:images","path":"/images/e0212bb2-202f-4cf7-8116-540993b7c866.webp"},"provider":"streamingunity"},{"id":207219,"filename":"733c4445-7b8a-4f91-8fce-babc8419b8ef.webp","type":"cover_mobile","lang":"it","imageable_type":"title","imageable_id":12482,"created_at":"2025-06-12T11:51:32.000000Z","updated_at":"2025-06-12T11:51:32.000000Z","original_url_field":null,"reference":{"base":"streamingunity:images","path":"/images/733c4445-7b8a-4f91-8fce-babc8419b8ef.webp"},"provider":"streamingunity"}],"episodeMappingUncertain":false,"seasons":[],"provenance":{},"warnings":[],"externalIdsEvidence":{"wikidata":{"source":"wikidata","sourceUrl":"https://www.wikidata.org/wiki/Q464294","wikidataId":"Q464294","tmdbId":12500,"type":"movie","imdbId":"tt0088708","tvdbId":6173}},"externalMedia":{"tmdb":{"source":"tmdb-api","id":12500,"type":"movie","sourceUrl":"https://www.themoviedb.org/movie/12500","fetchedAt":"2026-11-07T11:36:29.138Z","originalLanguage":"en-US","title":{"value":"Guerriero americano","language":"it-IT"},"originalTitle":"American Ninja","overview":{"value":"Joe Armstrong è un soldato americano che si ritrova nelle Filippine come punizione per i guai commessi. È molto scontroso e non ha rispetto per l'autorità, così da attirarsi addosso l'antipatia dei proprî commilitoni.  Durante una missione di trasporto armi, il convoglio militare viene attaccato da un gruppo di ribelli, addestrati nell'arte marziale del ninjutsu da un misterioso Ninja nero, i quali cercano di rubare le armi e di rapire la figlia del Colonnello Hickock che viaggia con i militari. Interviene così Joe, che dà sfoggio di un'ampia conoscenza del ninjutsu, tanto da impedire il rapimento della ragazza.  Tornato alla base, però, scopre che tutti i suoi commilitoni sono stati uccisi dai ninja, così che i superiori si convincono che Joe non sia un eroe bensì un traditore. Come se non bastasse, il trafficante d'armi Ortega, visti falliti i suoi piani, decide di mandare un plotone di ninja ad uccidere Joe.  Da Wikipedia, l'enciclopedia libera","language":"it-IT"},"tagline":{"value":"The deadliest art of the Orient is now in the hands of an American.","language":"en-US"},"releaseDate":"1985-08-30","status":"Released","rating":5.974,"ratingCount":514,"genres":["Avventura","Azione"],"countries":["United States of America","Netherlands"],"facts":{"Runtime":"95m"},"keywords":[],"networks":[],"socialLinks":{},"cast":[{"id":21259,"name":"Michael Dudikoff","role":"Pvt. Joe Armstrong","profile":"https://image.tmdb.org/t/p/original/mj8wZ5Ov8ZAjvUBfIxVf4oADogh.jpg"},{"id":55271,"name":"Steve James","role":"Cpl. Curtis Jackson","profile":"https://image.tmdb.org/t/p/original/wMz9DNYCd5B2xl7YtU7aq0H1bbz.jpg"},{"id":72541,"name":"Judie Aronson","role":"Patricia Hickock","profile":"https://image.tmdb.org/t/p/original/mHfgGvgdrfFvWTbkqRjziyNFxny.jpg"},{"id":72542,"name":"Guich Koock","role":"Col. William T. Hickock","profile":"https://image.tmdb.org/t/p/original/loRBK51lUh3J4H49XecsD0UiL3Z.jpg"},{"id":10133,"name":"John Fujioka","role":"Shinyuki","profile":"https://image.tmdb.org/t/p/original/bH6tXN6aOOW97cbiXY5yLUtFl8c.jpg"},{"id":103798,"name":"Don Stewart","role":"Victor Ortega"},{"id":99854,"name":"John LaMotta","role":"MSgt. Rinaldo","profile":"https://image.tmdb.org/t/p/original/xyj8QUjBv2wxgHfkHqI60lwC8Re.jpg"},{"id":566939,"name":"Tadashi Yamashita","role