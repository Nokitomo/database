ramite con l'esterno. Per non dividere con l'amico l'amore di Natalija, Marko anche dopo la liberazione continua a far credere che la guerra vada avanti.","language":"it-IT"},"tagline":{"value":"ONCE UPON A TIME THERE WAS A COUNTRY","language":"en-US"},"releaseDate":"1995-10-25","status":"Released","rating":7.678,"ratingCount":819,"genres":["Commedia","Dramma","Guerra"],"countries":["Yugoslavia","Czech Republic","France","Germany","Hungary"],"facts":{"Runtime":"172m"},"keywords":[],"networks":[],"socialLinks":{},"cast":[{"id":48791,"name":"Predrag 'Miki' Manojlović","role":"Marko Dren","profile":"https://image.tmdb.org/t/p/original/hj4MF8aQAGMeFHjeIzbckAko2v9.jpg"},{"id":70874,"name":"Lazar Ristovski","role":"Petar 'Crni' Popara","profile":"https://image.tmdb.org/t/p/original/ejgCgIQGwOVEZwYjtr5OT1xa50b.jpg"},{"id":70875,"name":"Mirjana Joković","role":"Natalija Zovkov","profile":"https://image.tmdb.org/t/p/original/x7FJaCev5abs2kq1XgS01Ei6mX2.jpg"},{"id":70876,"name":"Slavko Štimac","role":"Ivan Dren","profile":"https://image.tmdb.org/t/p/original/mQMeX8rdkTVsKLNW17y1BrCgbqr.jpg"},{"id":129215,"name":"Ernst Stötzner","role":"Franz","profile":"https://image.tmdb.org/t/p/original/zZ7oEIbgoonsDIYuTxZ4HK2weJY.jpg"},{"id":15265,"name":"Srđan 'Žika' Todorović","role":"Jovan Popara","profile":"https://image.tmdb.org/t/p/original/drsYd3lcoq60vWSeteU3bKtpSOP.jpg"},{"id":4635,"name":"Mirjana Karanović","role":"Vera","profile":"https://image.tmdb.org/t/p/original/srev6gJelsMQYDQKtKqQ23vMnOe.jpg"},{"id":110981,"name":"Milena Pavlović Čučilović","role":"Jelena","profile":"https://image.tmdb.org/t/p/original/2TNKX7d9gwMv2wHfqjt4XPuZeKS.jpg"},{"id":226302,"name":"Danilo 'Bata' Stojković","role":"Deda","profile":"https://image.tmdb.org/t/p/original/29vCmA17keNJrPR7cD1DmmLeFro.jpg"},{"id":85643,"name":"Borivoje Todorović","role":"Golub","profile":"https://image.tmdb.org/t/p/original/cPl8copuAfqJwGtirplr2yOTDri.jpg"},{"id":85642,"name":"Davor Dujmović","role":"Bata","profile":"https