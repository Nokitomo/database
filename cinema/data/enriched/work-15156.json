://image.tmdb.org/t/p/original/lUACMATs6jcscXIrzNCQzbvNVN5.png"}],"socialLinks":{},"cast":[{"id":46364,"name":"Shun Oguri","role":"Keishi Amami","profile":"https://image.tmdb.org/t/p/original/4tfrhvqp3IGHPATor0lYE9X9UD3.jpg"},{"id":79037,"name":"Kenichi Matsuyama","role":"Kōichi Tokiwa","profile":"https://image.tmdb.org/t/p/original/j7zwtoLF6A7d8xSU9kjgz664nQw.jpg"},{"id":572020,"name":"Anne Watanabe","role":"Minori Shiina","profile":"https://image.tmdb.org/t/p/original/kOtbhJgBYQFbRIGub1KfHXrkkTP.jpg"},{"id":117977,"name":"Eiji Wentz","role":"Taira Ishizuka","profile":"https://image.tmdb.org/t/p/original/2Gr8oi4m2CTFy0gyMBGMLTo0fK7.jpg"},{"id":1744548,"name":"Anne Nakamura","role":"Misuzu Aihara","profile":"https://image.tmdb.org/t/p/original/1E74om6R0oaTedZoBfJ768kuisi.jpg"},{"id":74195,"name":"Toru Nakamura","role":"Eiichi Higashiyama","profile":"https://image.tmdb.org/t/p/original/hZuETSVRoDV5L8AuS5hKmAi6Wzr.jpg"},{"id":46691,"name":"Teruyuki Kagawa","role":"Yūsuke Tadokoro","profile":"https://image.tmdb.org/t/p/original/5pQwTpjkjOI4Ul5NL0vVTA3tEFI.jpg"},{"id":555285,"name":"Manabu Hamada","role":"Satoshi Oribe","profile":"https://image.tmdb.org/t/p/original/y6jahb3Yze4RwxWqzkSnYP0Noch.jpg"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","title":"JAPAN SINKS: People of Hope","overview":"Nel 2023 a Tokyo, il primo ministro Eiichi Higashiyama spinge per il COMS alla Conferenza mondiale sull'ambiente. COMS è un metodo per liquefare gli inquinanti e immagazzinarli nella fessura del fondale marino. Il primo ministro Eiichi Higashiyama riunisce giovani e talentuosi burocrati e lancia la Japan Future Promotion Conference, a beneficio del futuro del Giappone. Keishi Amami del Ministero dell'Ambiente e Kōichi Tokiwa del Ministero dell'Economia, del Commercio e dell'Industria sono membri di quella conferenza."},{"language":"en-US","title":"JAPAN SINKS: People of Hope","overview":"In 2023 in Tokyo, Prime Minister Eiichi Higashiyama pushes for COMS at the World Environment Conference. COMS is a method to liquify pollutants and store it in the crack of the sea floor. Prime Minister Eiichi Higashiyama gathers young and talented bureaucrats and launches Japan Future Promotion Conference, which is to benefit the future of Japan. Keishi Amami of the Ministry of the Environment and Kōichi Tokiwa of the Ministry of Economy, Trade, and Industry are members of that conference."},{"language":"ja-JP","overview":"1973年に刊行された小松左京のSF小説「日本沈没」に大きくアレンジを加え、小栗旬主演でドラマ化。2023年の東京を舞台に“沈没”という目に見えない危機が迫る中「見いだしていく希望」をテーマに描く。野心家の環境省官僚・天海(小栗)は、各省庁の精鋭を集めた会議の場で、日本に迫る未曽有の事態に巻き込まれていく。"}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/r8gBxlJ8Hb6VZRhPZmQnZVwGXgE.jpg","background":"https://image.tmdb.org/t/p/original/qxpDSiFEeKHjVJYL0uJ3ZfZK7CB.jpg","seasons":[{"seasonNumber":1,"name":{"value":"Stagione 1","language":"it-IT"},"year":2021,"episodeCount":10,"poster":"https://image.tmdb.org/t/p/original/uFi38sZt7AHbv4vbwoGx7r8xM4j.jpg","posters":[],"backgrounds":[],"sourceUrl":"https://www.themoviedb.org/tv/135144/season/1"}],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":135144,"type":"tv","originalLanguage":"ja-JP","series":{"poster":{"it":{"status":"missing","candidates":[]},"en":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/d002IaCQ55rcA7mXZzl4Y5Pq5nV.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/d002IaCQ55rcA7mXZzl4Y5Pq5nV.jpg","language":"en","width":1223,"height":1835},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/d002IaCQ55rcA7mXZzl4Y5Pq5nV.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/d002IaCQ55rcA7mXZzl4Y5Pq5nV.jpg","language":"en","width":1223,"height":1835},{"type":"poster","url":"https://image.tmdb.org/t/p/original/co3vr5LmBRrnP9NVlUXnnOer138.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/co3vr5LmBRrnP9NVlUXnnOer138.jpg","language":"en","wid