at, som hans kone tilfældigt blev offer for.","tagline":"Intet er tilfældigt"}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/ivB064Mcf7cvWUTI8BDAXntb7Lq.jpg","background":"https://image.tmdb.org/t/p/original/7XZsVVnqTsMJXg3J4CHzeV2Lro9.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":663870,"type":"movie","originalLanguage":"da-DA","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/ivB064Mcf7cvWUTI8BDAXntb7Lq.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/ivB064Mcf7cvWUTI8BDAXntb7Lq.jpg","language":"it","width":2000,"height":3000},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/ivB064Mcf7cvWUTI8BDAXntb7Lq.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/ivB064Mcf7cvWUTI8BDAXntb7Lq.jpg","language":"it","width":2000,"height":3000},{"type":"poster","url":"https://image.tmdb.org/t/p/original/aFAfZm0WLewCMBDLyMX7gOcKwxt.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/aFAfZm0WLewCMBDLyMX7gOcKwxt.jpg","language":"it","width":1000,"height":1500}]},"en":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/sshNnwmQLk720iBQ0dZg3GVGKfK.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/sshNnwmQLk720iBQ0dZg3GVGKfK.jpg","language":"en","width":1000,"height":1500},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/sshNnwmQLk720iBQ0dZg3GVGKfK.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/sshNnwmQLk720iBQ0dZg3GVGKfK.jpg","language":"en","width":1000,"height":1500},{"type":"poster","url":"https://image.tmdb.org/t/p/original/evIMo53WIXJEge5qVbN3cTrTNd5.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/evIMo53WIXJEge5qVbN3cTrTNd5.jpg","language":"en","width":1476,"height":2197},{"type":"poster","url":"https://image.tmdb.org/t/p/original/3eE0HuQXH2q5wQilbm3c59gJOST.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/3eE0Hu