mage.tmdb.org/t/p/original/vfmKoTVXXHJsbqQzURQMqQUMQCZ.jpg"},{"id":1632768,"name":"Mario Patanè","role":"Impiegato monte pegni","profile":"https://image.tmdb.org/t/p/original/wzl4OeqFeeJB8E1yykSLWwzDcaa.jpg"},{"id":1878282,"name":"Ursula Volkmann","role":"Segretaria Muller"},{"id":1091599,"name":"Lallo Circosta","role":"Ospite Grasso","profile":"https://image.tmdb.org/t/p/original/nnK7tqu5J1lvW4aiqABN6iSRcHo.jpg"},{"id":1878283,"name":"Mauro Bellisario","role":"Ospite Romano"},{"id":1359528,"name":"Tatiana Winteler","role":"Proprietaria albergo Zurigo"},{"id":1878284,"name":"Diego Migeni","role":"1° Agente Interpol","profile":"https://image.tmdb.org/t/p/original/nV8WFnAfI2qPVtPizFSpNVA3e1.jpg"},{"id":1878285,"name":"Giorgio Melidoni","role":"2° Agente Interpol"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","title":"Non si ruba a casa dei ladri","overview":"Antonio Russo è un piccolo imprenditore napoletano la cui azienda è fallita perché ha perso una gara d'appalto truccata. Per poter pagare il master alla figlia negli Stati Uniti, lui e la moglie Daniela trovano lavoro come camerieri presso Simone Santoro, un faccendiere romano che vive in un villone con la fidanzata Lori e alimenta un giro di corruzione che ha per interlocutore primario un onorevole pugliese ammanicato con la criminalità organizzata."},{"language":"en-US","overview":"Antonio, an honest citizen, seeks his revenge against Simone, a dishonest politician. Antonio initially wanted to report him but then, knowing Italy, a country in which the justice process is very long and uncertain, he decides to take revenge in another way: he discovers that his enemy has hidden the proceeds of his misdeeds in a Swiss bank and decides to organize a hit to get back what was stolen from him. To accomplish the feat, Antonio sets up a small gang, made up of non-professionals who have only one thing in common: they too have been defrauded by corrupt politics. The heist takes place in Zurich where the bank in which Simone hid the money is based. With a series of unpredictable consequences, and with a funny substitution of people (Antonio and his wife pretend to be Simone and his partner), a comic clockwork mechanism starts. And the heist begins."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/4sOVH4xOOhvKQjMSDi0lUjP9mwt.jpg","background":"https://image.tmdb.org/t/p/original/9V98A3oLdm9UG5juS8I78cyU014.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":424009,"type":"movie","originalLanguage":"it-IT","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/4sOVH4xOOhvKQjMSDi0lUjP9mwt.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/4sOVH4xOOhvKQjMSDi0lUjP9mwt.jpg","language":"it","width":840,"height":1200},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/4sOVH4xOOhvKQjMSDi0lUjP9mwt.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/4sOVH4xOOhvKQjMSDi0lUjP9mwt.jpg","language":"it","width":840,"height":1200},{"type":"poster","url":"https://image.tmdb.org/t/p/original/59uHIj9JRjGlkLSPYuAFPeYG1h9.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/59uHIj9JRjGlkLSPYuAFPeYG1h9.jpg","language":"it","width":840,"height":1260},{"type":"poster","url":"https://image.tmdb.org/t/p/original/LcWgHoJIXvzRYUND9yHZF4AdcY.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/LcWgHoJIXvzRYUND9yHZF4AdcY.jpg","language":"it","width":1920,"height":2560},{"type":"poster","url":"https://image.tmdb.org/t/p/original/tUpGgnoIjv7t5ixQ1Kw5nCyJ8Wq.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/tUpGgnoIjv7t5ixQ1Kw5nCyJ8Wq.jpg","language":"it","width":2000,"height":3000}]},"en":{"status":"missing","candidates":[]},"xx":{"status":"missing","candidates":[]}},"background":{"it":{"status":"missing","candidates":[]},"en":{"status":"missing","candidates":[]},"xx":{"status":"available","se