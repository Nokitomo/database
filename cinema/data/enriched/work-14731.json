apan"],"facts":{"Runtime":"121m"},"keywords":[],"networks":[],"socialLinks":{},"cast":[{"id":2187869,"name":"Kotone Furukawa","role":"Meiko","profile":"https://image.tmdb.org/t/p/original/vcW4qq52yAWuIwKlHw3s5y2HEnI.jpg"},{"id":1505062,"name":"Ayumu Nakajima","role":"Kazuaki","profile":"https://image.tmdb.org/t/p/original/kK3N0wjhicPGKia5Cn4fRJTCT6y.jpg"},{"id":1324449,"name":"Hyunri","role":"Tsugumi","profile":"https://image.tmdb.org/t/p/original/u7st8OeVA4E1i20Q9PlN43Keeuf.jpg"},{"id":58611,"name":"Kiyohiko Shibukawa","role":"Segawa","profile":"https://image.tmdb.org/t/p/original/eeQ3Dbrz7e09rJzcR31uxiH8xji.jpg"},{"id":2975325,"name":"Katsuki Mori","role":"Nao","profile":"https://image.tmdb.org/t/p/original/5tgebpJ2JwFZF7b6lDPe32l21YB.jpg"},{"id":1323814,"name":"Shouma Kai","role":"Sasaki","profile":"https://image.tmdb.org/t/p/original/dyi4S78VAOHFdGwNd9QZVioSQy3.jpg"},{"id":1185435,"name":"Fusako Urabe","role":"Natsuko","profile":"https://image.tmdb.org/t/p/original/rmXUTHT22lJ5D6pNIqZS6EaX4Ti.jpg"},{"id":464228,"name":"Aoba Kawai","role":"Aya","profile":"https://image.tmdb.org/t/p/original/7IpyJz6obQSOoNuMufM2wEe0GQD.jpg"},{"id":2975332,"name":"Hitoshi Omika","role":"Magazine Editor","profile":"https://image.tmdb.org/t/p/original/gYOpeM2pSC5MBBomvZvL9JaKvgi.jpg"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","title":"Il gioco del destino e della fantasia","overview":"Tre storie di rivelazioni e coincidenze nel Giappone d'oggi. Nella prima, una ragazza si rende conto che la sua amica ha incontrato e si sta invaghendo del suo ex-fidanzato, e deve decidere come comportarsi. Nella seconda, uno studente vuole vendicarsi di un professore che lo ha bocciato, e persuade una studentessa a incastrarlo con un tentativo di seduzione dagli esiti imprevisti. Nella terza, due donne si riconoscono reciprocamente per strada come due importanti figure del rispettivo passato, ma un pomeriggio insieme farà venire alla luce una realtà un po' diversa."},{"language":"en-US","title":"Wheel of Fortune and Fantasy","overview":"An unexpected love triangle, a seduction trap, and a random encounter are the three episodes, told in three movements to depict three female characters and trace the trajectories between their choices and regrets."},{"language":"ja-JP","title":"偶然と想像","overview":"ヘアメイクアーティストである親友のつぐみ(玄理)から好きな男がいると聞かされた、モデルの芽衣子(古川琴音)。だが、その男が元恋人の和明(中島歩)だと知る(第1話『魔法(よりもっと不確か)』)。芥川賞を受賞した大学教授・瀬川(渋川清彦)に落第させられた大学生・佐々木(甲斐翔真)は、復讐(ふくしゅう)を企てる(第2話『扉は開けたままで』)。高校時代の友人である夏子(占部房子)とあや(河井青葉)が、20年ぶりに仙台で再会。当時のことで盛り上がるが、徐々にすれ違っていく(第3話『もう一度』)。"}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/8A1e5UYU9V4WieFJ2fqg9VCQUYY.jpg","background":"https://image.tmdb.org/t/p/original/mTOUk5M0LXIATbJDZkeH4xzA2hV.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":795811,"type":"movie","originalLanguage":"ja-JP","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/8A1e5UYU9V4WieFJ2fqg9VCQUYY.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/8A1e5UYU9V4WieFJ2fqg9VCQUYY.jpg","language":"it","width":1000,"height":1500},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/8A1e5UYU9V4WieFJ2fqg9VCQUYY.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/8A1e5UYU9V4WieFJ2fqg9VCQUYY.jpg","language":"it","width":1000,"height":1500},{"type":"poster","url":"https://image.tmdb.org/t/p/original/n86rt3noRgFSh2alC1cE5an3JPa.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/n86rt3noRgFSh2alC1cE5an3JPa.jpg","language":"it","width":1400,"height":2100}]},"en":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/z3xqVWOsetW6pSEgx1uiqXfzRet.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/z3xqVWOsetW6pSEgx1uiqXfzRet.jpg","language":"en","width":2000,"height":3000},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/