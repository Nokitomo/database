org/t/p/original/tBdFNmf6zwfeoIx3ECDOOCcHz8T.jpg"},{"id":589484,"name":"Gustavo Garzón","role":"Gerardo Palacios","profile":"https://image.tmdb.org/t/p/original/nB4cWI8JQF01chqNtqxt9NTg8np.jpg"},{"id":1086357,"name":"Julián Larquier Tellarini","role":"Conserje (as Julian Larquier)","profile":"https://image.tmdb.org/t/p/original/1fWqLU4U0BHendob3SGMV4xYs33.jpg"},{"id":2015996,"name":"Emma Rivera","role":"Emilse"},{"id":2015997,"name":"Nicolás de Tracy","role":"Roque","profile":"https://image.tmdb.org/t/p/original/6ob9DvlhHMyKw2XhnU9tW1kPzc3.jpg"},{"id":1689136,"name":"Daniel Kargieman","role":"Renato Provicello","profile":"https://image.tmdb.org/t/p/original/oObg3rCFWMNSFEaoaqrssGJDkkQ.jpg"},{"id":2015998,"name":"Alexis López Costa","role":"Asistente del Intendente"},{"id":2015999,"name":"Leonardo Murija","role":"Mendez"},{"id":2016000,"name":"Pedro Roth","role":"Nobel Prize Presenter"},{"id":2016001,"name":"Pilar Dutari","role":"Beauty Queen"},{"id":2016002,"name":"Ariel Fiorenza","role":"TV Presenter"},{"id":2016003,"name":"Franco Peralta","role":"Julian (as Franco Peralta Ramos)"},{"id":2016004,"name":"Juan Travnik","role":"King of Sweden"},{"id":2016005,"name":"Patricia March","role":"Queen of Sweden"},{"id":2016006,"name":"Francisco Cortes","role":"Vicente"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","title":"Il cittadino illustre","overview":"Daniel Mantovani, premio Nobel per la letteratura, l'ha profetizzato nel suo antiretorico discorso svedese: la massima onoreficenza farà di lui un monumento, spedendolo anzitempo al museo. Da cinque anni, infatti, non scrive niente di nuovo, e sono più gli inviti che rifiuta di quelli che accetta. Quando però arriva via lettera una richiesta da Salas, minuscolo paese argentino, decide di andare. A Salas, Daniel Mantovani è nato e cresciuto, e da là è fuggito, senza mai tornare, quarant'anni or sono, costruendo la sua identità sul rifiuto di quel luogo e della sua mentalità. Una volta in Argentina, lo scrittore è oggetto di un'accoglienza trionfale, ma col passare dei giorni le cose peggiorano, le sue opinioni non piacciono, si solleva un malumore sempre più generalizzato,un'aria nientemeno che di violenza.","tagline":"Quando la realtà supera la finzione"},{"language":"en-US","title":"The Distinguished Citizen","overview":"After refusing big and prestigious awards all over the world, Mr. Mantovani, Literature Nobel Prize winner, accepts an invitation to visit his hometown in Argentina, which has been the inspiration for all of his books. It turns out that accepting this invitation is the worst idea of his life. Expect the unexpected when you have used real people as characters in your novels!"},{"language":"es-ES","overview":"Es la historia de un escritor argentino, Premio Nobel de Literatura, que hace cuarenta años abandonó su pueblo y partió hacia Europa, donde triunfó escribiendo sobre su localidad natal y sus personajes. En el pico de su carrera, el alcalde de ese pueblo donde nació le invita para nombrarle \"Ciudadano Ilustre\" del mismo, y él decide cancelar su apretada agenda y aceptar la invitación.","tagline":"Una Película de Mariano Cohn"}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/tOCdpZTKoS14Xn3k2DHQe7uB5Qa.jpg","background":"https://image.tmdb.org/t/p/original/65uaQK0WE6onMLmswihdduH93xH.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":408537,"type":"movie","originalLanguage":"es-ES","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/tOCdpZTKoS14Xn3k2DHQe7uB5Qa.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/tOCdpZTKoS14Xn3k2DHQe7uB5Qa.jpg","language":"it","width":1000,"height":1500},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/tOCdpZTKoS14Xn3k2DHQe7uB5Qa.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/tOCdpZTKoS14Xn3