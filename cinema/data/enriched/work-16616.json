 cuenta y siguiendo el rastro de la maleta llega hasta Sara, una joven atrapada desde niña en una organización de tráfico de personas. Una red que trata a las personas como si fueran objetos."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/z7xh96ve8iMZAkw0FqoivGqOk7t.jpg","background":"https://image.tmdb.org/t/p/original/5s7zDN0nAuio5eMcWqsrsB2ibjK.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":946706,"type":"movie","originalLanguage":"es-ES","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/z7xh96ve8iMZAkw0FqoivGqOk7t.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/z7xh96ve8iMZAkw0FqoivGqOk7t.jpg","language":"it","width":1000,"height":1500},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/z7xh96ve8iMZAkw0FqoivGqOk7t.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/z7xh96ve8iMZAkw0FqoivGqOk7t.jpg","language":"it","width":1000,"height":1500}]},"en":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/7hrSRxsd7nZ7Myg7SpvxJ7EWItO.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/7hrSRxsd7nZ7Myg7SpvxJ7EWItO.jpg","language":"en","width":2000,"height":3000},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/7hrSRxsd7nZ7Myg7SpvxJ7EWItO.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/7hrSRxsd7nZ7Myg7SpvxJ7EWItO.jpg","language":"en","width":2000,"height":3000},{"type":"poster","url":"https://image.tmdb.org/t/p/original/AdLDsw5ww7k5RhH4ZePbUJUIYzu.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/AdLDsw5ww7k5RhH4ZePbUJUIYzu.jpg","language":"en","width":1000,"height":1429},{"type":"poster","url":"https://image.tmdb.org/t/p/original/xNKlulbjvz0DErBFihqMCY1t7LP.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/xNKlulbjvz0DErBFihqMCY1t7LP.jpg","language":"en","width":2000,"height":3000}]},"es":{"status":"available","