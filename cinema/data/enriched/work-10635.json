{"fingerprint":"4f71b1ddb72c9f1bc3f2c379c99eba1fbe919875c83357df92f2ad4b382055eb","record":{"id":"work-10635","active":true,"sourceIds":{"tmdb":"10360","imdb":"tt0986233","tvdb":"7011","wikidata":"Q1637811"},"info":{"id":49874,"name":"Hunger","slug":"hunger","plot":"Il film ricostruisce il trattamento riservato ai prigionieri politici in un carcere dell'Irlanda del Nord. Protagonista è Bobby Sands appartenente alla Provisional IRA, che per ribellarsi ai soprusi, cui lui e gli altri prigionieri sono costretti dalle guardie carcerarie, e per ottenere l'attenzione del governo, organizza uno sciopero della fame in cui perderà la vita. Oltre allo sciopero della fame furono attuati anche uno sciopero delle coperte, che prevedeva il rifiuto della tradizionale divisa da carcerato, e lo sciopero dello sporco, consistente nell'imbrattare le pareti della cella con escrementi. Nel film vengono evidenziate la violenza e l'efferatezza con cui le guardie carcerarie malmenano e torturano i prigionieri, la determinazione e spirito di sacrificio del protagonista e degli altri prigionieri, che persero la vita lottando per la causa dell'indipendenza.","quality":"HD","type":"movie","original_name":"Hunger","original_language":"en","status":"Released","runtime":96,"views":2910,"daily_views":29,"score":"7.7","tmdb_id":10360,"imdb_id":"tt0986233","netflix_id":null,"prime_id":"0JKUUM7RYBY55QOOSVHS6NZOJ2","scws_id":780609,"public":1,"release_date":"2008-05-15","last_air_date":"2008-05-15","sub_ita":0,"dub_ita":1,"created_at":"2026-01-05T02:51:57.000000Z","updated_at":"2026-10-31T05:00:00.000000Z","disney_id":null,"now_id":null,"apple_id":null,"paramount_id":null,"age":null,"audio_orig":1,"release_date_it":"2008-05-15","last_air_date_it":"2008-05-15","uploaded_at":"2026-08-20 16:12:48","views_it":2910,"daily_views_it":29,"hbo_id":null,"seasons_count":0,"coming_soon":false,"trailers":[{"id":33509,"name":"Steve McQueen and Michael Fassbender on Hunger | Film4 Interview Archive","is_hd":1,"youtu