mdb.org/t/p/original/5JkYyv6YSePIQ8ANaMMAVSzGP8e.jpg"},{"id":1041228,"name":"Fatima Trotta","role":"Roberta","profile":"https://image.tmdb.org/t/p/original/kO4QvG3HTRHrJHTUlVOmT0PG8x7.jpg"},{"id":226527,"name":"Francesco Paolantoni","role":"brigadiere","profile":"https://image.tmdb.org/t/p/original/iXspSbOFe7HIDOHGi68hoj4kCsX.jpg"},{"id":24290,"name":"Mariano Rigillo","role":"padre Benedetto","profile":"https://image.tmdb.org/t/p/original/p6bQl4qicc0bFnsKxxKagDjsOOy.jpg"},{"id":120646,"name":"Nino Frassica","role":"barbiere","profile":"https://image.tmdb.org/t/p/original/djTWn0guHC156gHJLwMzjzvVaKt.jpg"},{"id":1382323,"name":"Ludovico Caldarera","role":"Carmelo"},{"id":1604290,"name":"Lily Tirinnanzi","role":"zia Lucia","profile":"https://image.tmdb.org/t/p/original/nNQzDGPvlNUsBPSoyx4ABhnoLtn.jpg"},{"id":1883871,"name":"Christian Maggio","role":"se stesso","profile":"https://image.tmdb.org/t/p/original/kscujD45EiryUMmkHPCZah7NRxZ.jpg"},{"id":1520768,"name":"Giancarlo Ratti","role":"padre Raffaele","profile":"https://image.tmdb.org/t/p/original/3MlL68eQHp2GejLoc01tXOvitqA.jpg"},{"id":1850977,"name":"Orio Scaduto","role":"procuratore della Repubblica","profile":"https://image.tmdb.org/t/p/original/pbnyEIO10TDg7OJevL33ncETWKx.jpg"},{"id":1883872,"name":"Lello Analfino","role":"paesano che fa la serenata","profile":"https://image.tmdb.org/t/p/original/gl2sP2ibFexIB71vRd4twgqLiOb.jpg"},{"id":1330099,"name":"Lollo Franco","role":"segretario dell'onorevole La Duca","profile":"https://image.tmdb.org/t/p/original/4LCgKcfHfyeN8xQhEtwQC6xeGIT.jpg"},{"id":1879745,"name":"Salvatore La Mantia","role":"barista","profile":"https://image.tmdb.org/t/p/original/tmeSxBovJe04mvSjBVohNCjI5l1.jpg"},{"id":2120778,"name":"Stefania Blandeburgo","profile":"https://image.tmdb.org/t/p/original/pTJDwOOTM7QrX7IqOVepjFfrxaf.jpg"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","title":"Andiamo a quel paese","overview":"Valentino e Salvo, disoccupati in cerca di fortuna e raccomandazione, lasciano Palermo per il paese, dove Valentino è nato e ha piantato la donna dei suoi sogni. La situazione a Monteforte non è però promettente, la gente mormora tra piazza, chiesa, bar e barbiere. L'età matura dei paesani ispira Salvo che risolve di (soprav)vivere con la pensione della suocera e di ogni zio e zia provvisto di 'utile'. Accolti e costretti a un regime alimentare severo, che li conservi in salute e in vita, i 'pensionanti' delegano vita e ritiro pensione a Salvo e Valentino, che comprano la prima auto nuova e provano a godersi il quotidiano. Ma uno dopo l'altro gli ospiti senili trapasseranno, gettando Salvo nella più completa disperazione. Irriducibile e ostinato, convince Valentino a sposare la zia Lucia per garantirsi con la sua pensione il futuro. Niente tuttavia andrà secondo i suoi piani. Perché la vita è sempre in agguato."},{"language":"en-US","title":"Let's Go to the Country","overview":"Valentino and Salvo, unemployed and in search of fortune and recommendation, leave Palermo for Valentino’s home town, Monteforte, where they will try to survive the Italian crisis by opening some sort of hospice."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/vcUKXHI7uOLJeLdresvwHlRpGfs.jpg","background":"https://image.tmdb.org/t/p/original/IorAAceTVBGg6Nf3b9X0DiibC4.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":301272,"type":"movie","originalLanguage":"it-IT","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/vcUKXHI7uOLJeLdresvwHlRpGfs.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/vcUKXHI7uOLJeLdresvwHlRpGfs.jpg","language":"it","width":730,"height":1024},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/vcUKXHI7uOLJeLdresvwHlRpGfs.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/vcUKXHI7uOLJeLdresvwHlRpGfs.jpg","languag