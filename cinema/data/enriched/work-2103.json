g/t/p/original/pDYAoScSiHXx6vwbLcIU3aAMFhG.jpg"},{"id":3057449,"name":"Oleg Shapkov","role":"Grey","profile":"https://image.tmdb.org/t/p/original/ipkXBTNJvF6Ajy0IagcjA9cQaYD.jpg"},{"id":80997,"name":"Pyotr Fyodorov","role":"uncle Kostya","profile":"https://image.tmdb.org/t/p/original/o5LMY6QgIXRxgK6iTG4YGDccGsi.jpg"},{"id":1770803,"name":"Oleg Sokolov","role":"God of Fire","profile":"https://image.tmdb.org/t/p/original/qLYk3DlIXRyaMcN62dBNin3eyim.jpg"},{"id":1561965,"name":"Ramis Ibragimov","role":"Beard","profile":"https://image.tmdb.org/t/p/original/AsES0fzqBDJapuw9fwOqesMjGQ.jpg"},{"id":1887155,"name":"Andrey Nazimov","role":"Baby","profile":"https://image.tmdb.org/t/p/original/fbNURRpaDinybbKVHAKwgjK0uXM.jpg"},{"id":143744,"name":"Alexander Korshunov","role":"Sidorchuk","profile":"https://image.tmdb.org/t/p/original/i9Ld2WMeG2mHKuTeye4uydYxRaw.jpg"},{"id":1615227,"name":"Dmitriy Mulyar","role":"Furdetskiy","profile":"https://image.tmdb.org/t/p/original/3IdvrzXEu8Jubzkb4AN5uFmg91c.jpg"},{"id":1561961,"name":"Evgeniy Titov","role":"Borya Bardykin"},{"id":1181894,"name":"Aleksandr Suchkov","role":"major"},{"id":1854376,"name":"Boris Bachurin","role":"coryphaeus"},{"id":2437471,"name":"Natalya Danilova","profile":"https://image.tmdb.org/t/p/original/148W1SuTbFEOSCV1bor88yYq5yx.jpg"},{"id":3859385,"name":"Tamara Obutova","profile":"https://image.tmdb.org/t/p/original/wthMqOnfEoRolp9pbTLBS5CCWUe.jpg"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","title":"Territory - L'oro dei ghiacci","overview":"Durante il disgelo politico degli anni '60, l'Unione Sovietica aveva bisogno di oro. Dopo aver trascorso anni a esplorare senza successo, le autorità hanno deciso di chiudere le esplorazioni. Ma il geologo Chinikov è posseduto dall'idea di trovare l'oro leggendario del Territorio, l'inospitale terra dove la tundra incontra l'Artico nell'estremo nord russo."},{"language":"en-US","title":"Territory","overview":"It happened in the sixties, during the political thaw in the Soviet Union... but our story unfolds in the coldest terrain of the country. It was an unexplored and unbeaten terrain of boundless ice-field and forbidding rocks. This was the proper place for real men and real romantics. Our story is about the geologists prospecting gold in the Extreme North."},{"language":"ru-RU","overview":"Территория — это место, где люди проверяются на прочность. Необозримые пространства, где тундра встречается с ледяными торосами Ледовитого океана. Суровый русский север, которому способны бросить вызов немногие. Геолог Илья Чинков, одержимый идеей найти легендарное золото Территории, собирает команду смельчаков, готовых поставить на карту все, включая собственные жизни."}],"images":{"logos":[{"type":"logo","url":"https://image.tmdb.org/t/p/original/oic49IkzCNEBdzGDxw823PufaVU.png","previewUrl":"https://image.tmdb.org/t/p/w300/oic49IkzCNEBdzGDxw823PufaVU.png","language":"ru","width":6224,"height":800}],"posters":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/i90bORjE9bAEMnPar88ZPikLMea.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/i90bORjE9bAEMnPar88ZPikLMea.jpg","language":"it","width":1000,"height":1500},{"type":"poster","url":"https://image.tmdb.org/t/p/original/2QYg5Uiyq6c6DSQxAtd8hRe5Sws.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/2QYg5Uiyq6c6DSQxAtd8hRe5Sws.jpg","language":"ru","width":2000,"height":3000},{"type":"poster","url":"https://image.tmdb.org/t/p/original/w6tV4oKJEJVp2DOKX90KsRpPBpk.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/w6tV4oKJEJVp2DOKX90KsRpPBpk.jpg","language":"ru","width":1000,"height":1500},{"type":"poster","url":"https://image.tmdb.org/t/p/original/rd8HbYf6wqI3gLGxwhdkszlSrBG.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/rd8HbYf6wqI3gLGxwhdkszlSrBG.jpg","language":"ru","width":1080,"height":1620}],"backdrops":[{"type":"backdrop","url":"https://image.tmdb.org/t/p/original/xYmT1UeehKZ0cRl5hRY3XiwS9PD.jpg","previewUrl":"https://image.tm