am","created_at":"2023-05-18T11:55:26.000000Z","updated_at":"2023-05-18T11:55:26.000000Z","pivot":{"title_id":9418,"credit_id":6541,"job":"actor","order":6}},{"id":1942,"name":"Morena Baccarin","created_at":"2023-05-18T11:51:55.000000Z","updated_at":"2023-05-18T11:51:55.000000Z","pivot":{"title_id":9418,"credit_id":1942,"job":"actor","order":7}}],"main_directors":[{"id":82985,"name":"Robert C. Cooper","created_at":"2024-01-15T07:34:02.000000Z","updated_at":"2024-01-15T07:34:02.000000Z","pivot":{"title_id":9418,"credit_id":82985,"job":"director","order":0}}],"cam":null,"translations":[{"id":22792,"translatable_type":"title","translatable_id":9418,"locale":"it","key":"daily_views","value":"0"},{"id":154890,"translatable_type":"title","translatable_id":9418,"locale":"it","key":"last_air_date","value":"2008-03-11"},{"id":154886,"translatable_type":"title","translatable_id":9418,"locale":"it","key":"name","value":"Stargate SG-1 - L'arca della verità"},{"id":154887,"translatable_type":"title","translatable_id":9418,"locale":"it","key":"plot","value":"Il film inizia raccontando le vicende che portarono gli Alteriani a lasciare la loro galassia per sfuggire agli Ori e trasferirsi nella nostra. Sia gli Alteriani che gli Ori avevano scoperto i segreti dell'ascensione, ma avevano forti ideologie contrapposte: gli Alteriani praticavano una politica di non intervento, mentre gli Ori si fecero venerare come dei, così da far accrescere il loro potere. Gli Ori però non erano sinceri con i loro sudditi, infatti promettevano l'ascensione a chi li venerava, ma non mantevano mai questa promessa. Con queste premesse la guerra fu inevitabile, e gli Alteriani furono sul punto di perdere. Idearono così un manufatto che avrebbe risollevato le sorti della guerra: un'arca che avrebbe fatto capire ai fedeli degli Ori le menzogne rifilateli dai loro falsi dei. Ma gli Alteriani, rispettando la loro regola di non-intervento, decisero di non usare l'arca e scappare nella nostra galassia, tenendone l'esistenza all'oscuro degli Ori."},{"id":154889,"translatable_type":"title","translatable_id":9418,"locale":"it","key":"release_date","value":"2008-03-11"},{"id":154888,"translatable_type":"title","translatable_id":9418,"locale":"it","key":"slug","value":"stargate-sg-1-larca-della-verita"},{"id":22791,"translatable_type":"title","translatable_id":9418,"locale":"it","key":"views","value":"44549"}],"keywords":[{"id":171,"name":"super power","created_at":"2023-05-18T11:49:10.000000Z","updated_at":"2023-05-18T11:49:10.000000Z","pivot":{"title_id":9418,"keyword_id":171}},{"id":337,"name":"spacecraft","created_at":"2023-05-18T11:50:16.000000Z","updated_at":"2023-05-18T11:50:16.000000Z","pivot":{"title_id":9418,"keyword_id":337}},{"id":412,"name":"wormhole","created_at":"2023-05-18T11:50:37.000000Z","updated_at":"2023-05-18T11:50:37.000000Z","pivot":{"title_id":9418,"keyword_id":412}},{"id":413,"name":"space travel","created_at":"2023-05-18T11:50:37.000000Z","updated_at":"2023-05-18T11:50:37.000000Z","pivot":{"title_id":9418,"keyword_id":413}},{"id":430,"name":"alien","created_at":"2023-05-18T11:50:38.000000Z","updated_at":"2023-05-18T11:50:38.000000Z","pivot":{"title_id":9418,"keyword_id":430}}]}}]},"images":[{"id":126318,"filename":"498be501-b1eb-47b1-b60f-4733de4807fb.webp","type":"poster","lang":"it","imageable_type":"title","imageable_id":9418,"created_at":"2024-07-30T06:13:03.000000Z","updated_at":"2025-05-12T09:25:13.000000Z","original_url_field":null,"reference":{"base":"streamingunity:images","path":"/images/498be501-b1eb-47b1-b60f-4733de4807fb.webp"},"provider":"streamingunity"},{"id":126316,"filename":"58673b95-e912-4eb6-b7b9-c15828c1d840.webp","type":"cover","lang":"it","imageable_type":"title","imageable_id":9418,"created_at":"2024-07-30T06:13:03.000000Z","updated_at":"2025-05-12T09:25:13.000000Z","original_url_field":null,"reference":{"base":"streamingunity:images","path":"/images/58673b95-e912-4eb6-b7b9-c15828c1d840.webp"},"provider":"streamingunity"},{"id