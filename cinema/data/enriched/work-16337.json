warnings":[],"externalIdsEvidence":{"wikidata":{"source":"wikidata","sourceUrl":"https://www.wikidata.org/wiki/Q110511260","wikidataId":"Q110511260","tmdbId":884452,"type":"movie","imdbId":"tt13445076","tvdbId":330706}},"externalMedia":{"tmdb":{"source":"tmdb-api","id":884452,"type":"movie","sourceUrl":"https://www.themoviedb.org/movie/884452","fetchedAt":"2026-11-08T09:53:48.881Z","originalLanguage":"ar-SA","title":{"value":"The Ambush","language":"it-IT"},"originalTitle":"الكمينAl Kameen","overview":{"value":"È l'inverno del 2018, gli uomini e le donne dell'esercito degli Emirati Arabi Uniti sono schierati per fornire aiuti. Alla base di Mocha, il morale è alto mentre tre soldati degli Emirati prevedono un imminente ritorno a casa. Durante la loro ultima pattuglia di routine, i tre soldati, Ali, Bilal e Hindasi cadono in un'imboscata da parte di militanti pesantemente armati lungo il loro percorso, attraverso uno stretto canyon. Intrappolati, feriti e fuori portata di comunicazione, i tre soldati si rendono conto della gravità della loro situazione. Stanno esaurendo le opzioni, le munizioni e il tempo. Di ritorno alla base, il loro comandante viene informato e si rende conto che l'assalto alla pattuglia dell'esercito degli Emirati Arabi Uniti era premeditato. Viene rapidamente avviata una missione di salvataggio, ma il supporto aereo e terrestre raggiungerà gli uomini in tempo e sopravviveranno?","language":"it-IT"},"tagline":{"value":"They will bring their brothers home by any means necessary.","language":"en-US"},"releaseDate":"2021-11-25","status":"Released","rating":6.038,"ratingCount":66,"genres":["Guerra","Azione","Dramma"],"countries":["United Arab Emirates"],"facts":{"Runtime":"110m"},"keywords":[],"networks":[],"socialLinks":{},"cast":[{"id":2449596,"name":"Marwan Abdullah","role":"Sergeant Ali Al-mismari"},{"id":3306357,"name":"Khalifa Al Jassem","role":"Warrant Officer Bilal Al Saadi"},{"id":3306358,"name":"Mohammed Ahmed","role":"Sergeant Al Hindasi"},{"id":3306360,"name":"Abdulla Saeed Bin Haider","role":"Colonel Almazroui","profile":"https://image.tmdb.org/t/p/original/ongY72qqncu6iWCp4SJyb2wO0li.jpg"},{"id":3306361,"name":"Saeed Alharsh","role":"Captain Saeed Al Shehhi"},{"id":3306363,"name":"Hassan Yousuf Alblooshi","role":"Abdulla Alblooshi"},{"id":3306364,"name":"Khalifa Albahri","role":"Al Sayari","profile":"https://image.tmdb.org/t/p/original/aID0M0MNCoYOS0ItY1pKxCax7SI.jpg"},{"id":3306365,"name":"Ghanim Nasser","role":"Opposition Leader"},{"id":1688296,"name":"Mansoor Alfeeli","role":"Colonel Jamal Al Khatri","profile":"https://image.tmdb.org/t/p/original/wxtqj2cVZLrogniArd6Y9qCh6th.jpg"},{"id":4108132,"name":"Ibrahim Almusharaakh","role":"Mansoor"},{"id":4108133,"name":"Salem Altamimi","role":"Sergeant Salem"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","title":"The Ambush","overview":"È l'inverno del 2018, gli uomini e le donne dell'esercito degli Emirati Arabi Uniti sono schierati per fornire aiuti. Alla base di Mocha, il morale è alto mentre tre soldati degli Emirati prevedono un imminente ritorno a casa. Durante la loro ultima pattuglia di routine, i tre soldati, Ali, Bilal e Hindasi cadono in un'imboscata da parte di militanti pesantemente armati lungo il loro percorso, attraverso uno stretto canyon. Intrappolati, feriti e fuori portata di comunicazione, i tre soldati si rendono conto della gravità della loro situazione. Stanno esaurendo le opzioni, le munizioni e il tempo. Di ritorno alla base, il loro comandante viene informato e si rende conto che l'assalto alla pattuglia dell'esercito degli Emirati Arabi Uniti era premeditato. Viene rapidamente avviata una missione di salvataggio, ma il supporto aereo e terrestre raggiungerà gli uomini in tempo e sopravviveranno?"},{"language":"en-US","title":"The Ambush","overview":"It is the winter of 2018, the men and women of the UAE military are deployed to provide aid. At the Mocha Base, spirits are high as three Emirati soldiers anticipate an imminent return home. While on their final routine patrol, the three soldiers, Ali, Bilal and Hindasi are ambushed by heavily armed militants on their route, through a narrow canyon. Trapped, wounded, and out of communication range, the three soldiers realize the gravity of their situation. They are running out of options, munitions - and time. Back at the base, their commander receives word and realizes that the assault on the UAE army patrol was premeditated. A rescue mission is quickly put into action, but will air and land support reach the men in time, and will they survive?","tagline":"They will bring their brothers home by any means necessary."},{"language":"ar-SA","overview":"الفيلم مُقتبس عن وقائع حقيقية، وتدور أحداثه حول قاعدة المخا عام 2018، حيث يحكي عن القصة البطولية لمجموعة جنود إمارتيين تعرض ثلاثة جنود منهم لكمين وفقدوا كل وسائل الاتصال مع القيادة العسكرية التابعة لهم ليحاول زملائهم إنقاذ حياتهم في مهمة خطيرة تتوسطها المشاعر القوية والإصرارعلى إتمام المهمة والانتصار في معركتهم."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/66YilIOkU9X3yQ9MzGgsFtA7XXL.jpg","background":"https://image.tmdb.org/t/p/original/tKQBdl1wf8rhurIr6QnvuDl7e3m.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":884452,"type":"movie","originalLanguage":"ar-SA","series":{"poster":{"it":{"status":"missing","candidates":[]},"en":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/dEZJgTWjq5ex8lEvI6XcYMxnTSn.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/dEZJgTWjq5ex8lEvI6XcYMxnTSn.jpg","language":"en","width":2000,"height":3000},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/dEZJgTWjq5ex8lEvI6XcYMxnTSn.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/dEZJgTWjq5ex8lEvI6XcYMxnTSn.jpg","language":"en","width":2000,"height":3000},{"type":"poster","url":"https://image.tmdb.org/t