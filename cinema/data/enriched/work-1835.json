rg/t/p/original/6XFDvIXflF8dE7kdYTLRGEDri64.jpg"},{"id":230065,"name":"Vanessa David","role":"Krista Malinski","profile":"https://image.tmdb.org/t/p/original/vU6iQiSJsvNrc2xZxrHe8sXzCWO.jpg"},{"id":1076710,"name":"Elsa Lepoivre","role":"Mathilde Geithner","profile":"https://image.tmdb.org/t/p/original/y6fWDCX1jChmQH58WZVdDmtml0y.jpg"},{"id":1315913,"name":"Télesphore Teunou","role":"Driss","profile":"https://image.tmdb.org/t/p/original/A6oHmZo0CH6aco0Ga9mstkNSseS.jpg"},{"id":1905517,"name":"Xavier Guelfi","role":"Kevin","profile":"https://image.tmdb.org/t/p/original/zDhbYyUJLAlfdJ07FbzkgfAoo8v.jpg"},{"id":2271025,"name":"Louis Vazquez","role":"Mathieu at 12 years old","profile":"https://image.tmdb.org/t/p/original/AskIMpYu5WIJutFFgpB2D9Tql9s.jpg"},{"id":2302770,"name":"Louise Labèque","role":"Marion Malinski","profile":"https://image.tmdb.org/t/p/original/A6avdJDxsjifF1iaNOQtPu9rHtf.jpg"},{"id":21665,"name":"Alexandre Brik","role":"Alexandre Delaunay","profile":"https://image.tmdb.org/t/p/original/pzMey0PUuJfgZYG49KOJ5ClmpPU.jpg"},{"id":543817,"name":"Gaspard Meier-Chaurand","role":"Sébastien Michelet"},{"id":1580656,"name":"Milo Mazé","role":"David Malinski","profile":"https://image.tmdb.org/t/p/original/by7MBSHmzWqiPRRRsHxj9DT8iUF.jpg"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","title":"Nelle tue mani","overview":"Un giovane, di origini modeste, ha l'opportunità irripetibile di rivelare il suo talento nascosto per pianoforte, ma può trovare la forza e il coraggio per essere all'altezza della sfida?"},{"language":"en-US","title":"In Her Hands","overview":"A young man from a modest family gets the chance of a lifetime to reveal his hidden talent for piano but can he find the strength and courage to live up to the challenge?"},{"language":"fr-FR","overview":"La musique est le secret de Mathieu Malinski, un sujet dont il n’ose pas parler dans sa banlieue où il traîne avec ses potes. Alors qu’un des petits cambriolages qu’il fait avec ces derniers le mène aux portes de la prison, Pierre Geitner, directeur du Conservatoire National Supérieur de Musique l’en sort en échange d’heures d’intérêt général. Mais Pierre a une toute autre idée en tête… Il a décelé en Mathieu un futur très grand pianiste qu’il inscrit au concours national de piano. Mathieu entre dans un nouveau monde dont il ignore les codes, suit les cours de l’intransigeante « Comtesse » et rencontre Anna dont il tombe amoureux. Pour réussir ce concours pour lequel tous jouent leur destin, Mathieu, Pierre et la Comtesse devront apprendre à dépasser leurs préjugés…"}],"images":{"logos":[],"posters":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/llNCpWkbpbZKoeKrHcpNpFzRR6W.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/llNCpWkbpbZKoeKrHcpNpFzRR6W.jpg","language":"it","width":1429,"height":2000},{"type":"poster","url":"https://image.tmdb.org/t/p/original/eywRnDzLodfDOfIt8t6hsib8GdY.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/eywRnDzLodfDOfIt8t6hsib8GdY.jpg","language":"it","width":640,"height":896},{"type":"poster","url":"https://image.tmdb.org/t/p/original/zj7CP9SEh0xPsHJWw0H7jJcrt0r.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/zj7CP9SEh0xPsHJWw0H7jJcrt0r.jpg","language":"it","width":541,"height":820},{"type":"poster","url":"https://image.tmdb.org/t/p/original/xsBmYsCOz691LRvkv8xGZ2HdPCL.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/xsBmYsCOz691LRvkv8xGZ2HdPCL.jpg","language":"it","width":1000,"height":1500},{"type":"poster","url":"https://image.tmdb.org/t/p/original/bBr8agu2JGoRb4Ztfzuk23B1wRj.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/bBr8agu2JGoRb4Ztfzuk23B1wRj.jpg","language":"en","width":800,"height":1200},{"type":"poster","url":"https://image.tmdb.org/t/p/original/wnNCB5tmQAb21gD7khJY8r8Y2IY.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/wnNCB5tmQAb21gD7khJY8r8Y2IY.jpg","language":"en","width":1280,"height":1920},{"type":"poster","url":"https://image.tmdb.org/t/p/or