ages","path":"/images/a84940b1-1161-4860-ba99-7f2bb8494209.webp"},"provider":"streamingunity"}],"episodeMappingUncertain":false,"seasons":[],"provenance":{},"warnings":[],"externalIdsEvidence":{"wikidata":{"source":"wikidata","sourceUrl":"https://www.wikidata.org/wiki/Q16651486","wikidataId":"Q16651486","tmdbId":284685,"type":"movie","imdbId":"tt0064290","tvdbId":154747}},"externalMedia":{"tmdb":{"source":"tmdb-api","id":284685,"type":"movie","sourceUrl":"https://www.themoviedb.org/movie/284685","fetchedAt":"2026-11-08T01:45:26.833Z","originalLanguage":"fr-FR","title":{"value":"Maliziosamente","language":"it-IT"},"originalTitle":"L'etreinte","overview":{"value":"L'\"educazione sentimentale\"di Giselle, una orfana che viene prima scacciata dall'abitazione della zia perché l'amante della stessa la stava concupiscendo, e che finisce poi a Parigi, dove trova impiego come domestica nella casa di Michel, un bel giovane uomo danaroso che finirà presto per dedicarle attenzioni sessuali fino a quando lei non scoprirà altro sull'amore e sul sesso.","language":"it-IT"},"tagline":{"value":"Venez dans la grande ville... Pour découvrir la vraie corruption !","language":"fr-FR"},"releaseDate":"1969-01-01","status":"Released","rating":4.3,"ratingCount":13,"genres":["Avventura","Dramma","Romance"],"countries":["Belgium","France"],"facts":{"Runtime":"103m"},"keywords":[],"networks":[],"socialLinks":{},"cast":[{"id":1348410,"name":"Nathalie Vernier","role":"Gisèle","profile":"https://image.tmdb.org/t/p/original/2Ga9xGoHOUa5IckSgDy8uSVFE7b.jpg"},{"id":1348411,"name":"Daniel Vigo","role":"Michel"},{"id":1348412,"name":"Laetitia Sorel","role":"Leni","profile":"https://image.tmdb.org/t/p/original/93N3QQPoCpjdOOcz25SlyjcmShF.jpg"},{"id":1348413,"name":"Oscar Delmart","role":"L'oncle"},{"id":1129745,"name":"Bernard Graczyk","role":"Bernard","profile":"https://image.tmdb.org/t/p/original/zB0S0OYoEZyG3nu4Pksp2Fhl49c.jpg"},{"id":1425782,"name":"Brigitte Kowaltjouk","role":"Brigitte"},{"id":1425784,"name":"Josée Cellier"},{"id":1425785,"name":"Nicole Roegiers"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","title":"Maliziosamente","overview":"L'\"educazione sentimentale\"di Giselle, una orfana che viene prima scacciata dall'abitazione della zia perché l'amante della stessa la stava concupiscendo, e che finisce poi a Parigi, dove trova impiego come domestica nella casa di Michel, un bel giovane uomo danaroso che finirà presto per dedicarle attenzioni sessuali fino a quando lei non scoprirà altro sull'amore e sul sesso."},{"language":"en-US","overview":"L’Étreinte (1969) is a sharp, provocative Franco-Belgian psychological drama that masterfully subverts power dynamics through an erotic lens. Heavily inspired by The Story of O, the film tracks Gisèle, an innocent runaway who becomes a housemaid—and subsequent sex slave—to Michel, a wealthy playboy. What begins as a classic tale of bourgeois exploitation takes a radical turn when a visiting friend awakens Gisèle to her own alienation. In a striking third-act shift, the film flips the master-servant dynamic, leaving the oppressor completely subjugated by his former victim.."},{"language":"fr-FR","overview":"Gisèle, une jeune fille naïve, est engagée comme gouvernante par Michel, bourgeois libertin. Des rapports de domination, à tous égards, se développent entre eux. Léni, amie de Michel, profite de l'absence de ce dernier pour tenter de faire prendre conscience à Gisèle de son aliénation.","tagline":"Venez dans la grande ville... Pour découvrir la vraie corruption !"}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/fNTbySVQY3gmHWht5sEua97srt1.jpg","background":"https://image.tmdb.org/t/p/original/hu689E2kNcmJxCbF76WUYo9x52A.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":284685,"type":"movie","originalLanguage":"fr-FR","series":{"poster":{"it":{"status":"availab