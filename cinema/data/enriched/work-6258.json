rá un testigo clave durante los juicios de Núremberg."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/1GzwDodNHSQM7Wu8VIbvTmYXJQB.jpg","background":"https://image.tmdb.org/t/p/original/ljZOlqLtMa6gnTHcYn9y9lP0bK3.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":528949,"type":"movie","originalLanguage":"es-ES","series":{"poster":{"it":{"status":"missing","candidates":[]},"en":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/6b4L0uLVgFsDfqPx0sFZbCRwIKH.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/6b4L0uLVgFsDfqPx0sFZbCRwIKH.jpg","language":"en","width":750,"height":1125},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/6b4L0uLVgFsDfqPx0sFZbCRwIKH.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/6b4L0uLVgFsDfqPx0sFZbCRwIKH.jpg","language":"en","width":750,"height":1125},{"type":"poster","url":"https://image.tmdb.org/t/p/original/3516IOUGHbUDjBGTS0dlnqIUkE2.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/3516IOUGHbUDjBGTS0dlnqIUkE2.jpg","language":"en","width":500,"height":750}]},"es":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/1GzwDodNHSQM7Wu8VIbvTmYXJQB.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/1GzwDodNHSQM7Wu8VIbvTmYXJQB.jpg","language":"es","width":2000,"height":3000},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/1GzwDodNHSQM7Wu8VIbvTmYXJQB.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/1GzwDodNHSQM7Wu8VIbvTmYXJQB.jpg","language":"es","width":2000,"height":3000},{"type":"poster","url":"https://image.tmdb.org/t/p/original/jMYW5HdduWQ3QX3IB0P7A8KeJzm.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/jMYW5HdduWQ3QX3IB0P7A8KeJzm.jpg","language":"es","width":1000,"height":1500},{"type":"poster","url":"https://image.tmdb.org/t/p/original/u6uOpJJrpQzqt564rKaIZlhLF50.jpg","previewUrl":"https://image.tmdb.org/