4e83-a22c-76e69518c84c.webp"},"provider":"streamingunity"}],"episodeMappingUncertain":false,"seasons":[],"provenance":{},"warnings":[],"externalIdsEvidence":{"wikidata":{"source":"wikidata","sourceUrl":"https://www.wikidata.org/wiki/Q133888220","wikidataId":"Q133888220","tmdbId":1455132,"type":"movie","imdbId":"tt36351149","tvdbId":365610}},"externalMedia":{"tmdb":{"source":"tmdb-api","id":1455132,"type":"movie","sourceUrl":"https://www.themoviedb.org/movie/1455132","fetchedAt":"2026-11-06T11:09:11.026Z","originalLanguage":"en-US","title":{"value":"AMERICAN TERROR: L'ATTENTATO DI OKLAHOMA CITY","language":"it-IT"},"originalTitle":"Oklahoma City Bombing: American Terror","overview":{"value":"Il documentario ci racconta uno dei più grandi attacchi terroristici nella storia del Paese nordamericano. Accadde nel 1995 a Oklahoma City: un ex soldato dell'esercito decise di distruggere parte dell'Alfred P. Murrah Building, provocando un totale di 168 morti e più di 600 feriti, tra cui bambini di tutte le età. Per mostrare l'impatto dell'azione, la produzione ricrea le scene del crimine, riporta i resoconti dei sopravvissuti e dei soccorritori, nonché registrazioni audio esclusive di Timothy McVeigh, il responsabile dell'atto, che vengono analizzate da esperti.","language":"it-IT"},"releaseDate":"2025-04-17","status":"Released","rating":6.8,"ratingCount":60,"genres":["Documentario","Crime"],"countries":["United States of America"],"facts":{"Runtime":"85m"},"keywords":[],"networks":[],"socialLinks":{},"cast":[{"id":1428460,"name":"Max Bennett","role":"FBI Agent & Interrogator","profile":"https://image.tmdb.org/t/p/original/fthD8U3aGnQioWAiwvFPcdDQJRV.jpg"},{"id":5380781,"name":"Michael Charles Jr.","role":"Timothy McVeigh"},{"id":4469868,"name":"Tommy Payne","role":"Self -news anchor(archive footage)"},{"id":2830484,"name":"Bob Ricks","role":"Self - FBI Special Agent in Charge, OKC","profile":"https://image.tmdb.org/t/p/original/r2N4dikPkrtEDTASA1nO4pHBTGQ.jpg"},{"id":4636927