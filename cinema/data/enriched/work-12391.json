2f895224.webp","type":"logo","lang":"it","imageable_type":"title","imageable_id":55570,"created_at":"2026-04-10T05:49:48.000000Z","updated_at":"2026-04-10T05:49:48.000000Z","original_url_field":null,"reference":{"base":"streamingunity:images","path":"/images/fa1a7a01-76fc-4edd-88d8-886f2f895224.webp"},"provider":"streamingunity"},{"id":676600,"filename":"8462e4f5-2388-4952-b9fe-5be8f990c19e.webp","type":"cover_mobile","lang":"it","imageable_type":"title","imageable_id":55570,"created_at":"2026-04-10T05:49:47.000000Z","updated_at":"2026-04-10T05:49:47.000000Z","original_url_field":null,"reference":{"base":"streamingunity:images","path":"/images/8462e4f5-2388-4952-b9fe-5be8f990c19e.webp"},"provider":"streamingunity"}],"episodeMappingUncertain":false,"seasons":[],"provenance":{},"warnings":[],"externalIdsEvidence":{"wikidata":{"source":"wikidata","sourceUrl":"https://www.wikidata.org/wiki/Q3794612","wikidataId":"Q3794612","tmdbId":58188,"type":"movie","imdbId":"tt0063288","tvdbId":16653}},"externalMedia":{"tmdb":{"source":"tmdb-api","id":58188,"type":"movie","sourceUrl":"https://www.themoviedb.org/movie/58188","fetchedAt":"2026-11-07T21:40:58.144Z","originalLanguage":"it-IT","title":{"value":"Be Sick… It's Free","language":"en-US"},"originalTitle":"Il medico della mutua","overview":{"value":"Il promettente e neolaureato medico Guido Tersilli scopre che può guadagnare molto di più occupandosi di mutuati. All'inizio gli affari non vanno bene, ma la morte dell'anziano dottor Bui, che \"possiede\" duemilatrecento mutuati, giova alla sua carriera: seduce la vedova con la promessa di portarla all'altare e riesce a far passare sotto le sue cure i pazienti del defunto dottor Bui. Adesso Tersilli lavora giorno e notte, è ricchissimo e può abbandonare la vedova per sposare una ragazza giovane e ricca, figlia di un costruttore. Nel frattempo i suoi assistiti crescono a dismisura, tanto che Tersilli non può dedicare loro che pochi minuti per visita. Sopraffatto da un collasso, finisce nello stesso ospedale che lo aveva visto assistente volontario agli inizi della carriera. Sentendosi minacciato dai suoi vecchi colleghi, che gli vorrebbero portar via gli assistiti, prenderà una decisione vantaggiosa.","language":"it-IT"},"releaseDate":"1968-10-24","status":"Released","rating":7.02,"ratingCount":221,"genres":["Commedia"],"countries":["Italy"],"facts":{"Runtime":"99m"},"keywords":[],"networks":[],"socialLinks":{},"cast":[{"id":45982,"name":"Alberto Sordi","role":"Guido Tersilli","profile":"https://image.tmdb.org/t/p/original/xXCk1HKZM9MGUmQcorjuEV2vOI5.jpg"},{"id":5969,"name":"Ida Galli","role":"Anna Maria","profile":"https://image.tmdb.org/t/p/original/9iUgC8Z10IIxGUd1ozoNcy7zYvp.jpg"},{"id":93968,"name":"Bice Valori","role":"Amelia","profile":"https://image.tmdb.org/t/p/original/r8xGK2hbR8zPxKeryNCPsevh5Jk.jpg"},{"id":100412,"name":"Sara Franchetti","role":"Teresa","profile":"https://image.tmdb.org/t/p/original/9accAJY6vp4YtRmJe5R9jNuyr1d.jpg"},{"id":227515,"name":"Nanda Primavera","role":"Guido's Mother","profile":"https://image.tmdb.org/t/p/original/7IgkGlkLY8W73LkfXpee9P2bulv.jpg"},{"id":550640,"name":"Patrizia De Clara","role":"Pasqualina","profile":"https://image.tmdb.org/t/p/original/tuaOXOZFZQRuuemy3Lbf5z4Axuk.jpg"},{"id":14151,"name":"Leopoldo Trieste","role":"Pietro","profile":"https://image.tmdb.org/t/p/original/rPvCj39OY7LClFh9CG2OXFKxioB.jpg"},{"id":1135474,"name":"Adriana Giuffrè","role":"Marianna","profile":"https://image.tmdb.org/t/p/original/m394Fx0nO1BdxWyVEdAOKPqzO8G.jpg"},{"id":25780,"name":"Pupella Maggio","role":"Mrs. Parise","profile":"https://image.tmdb.org/t/p/original/eLzAnbMwfWNHiOy1Mgylgz0tnUa.jpg"},{"id":32677,"name":"Claudio Gora","role":"Chief Physician","profile":"https://image.tmdb.org/t/p/original/otKGKlrLIP0NnuVehXGaFyyItGm.jpg"},{"id":1636304,"name":"Giovanni Nuvoletti","role":"Surgeon"},{"id":1074082,"name":"Sandro Merli","role":"Dr. Drufo","profile":"https://image.tmdb.org/t/p/original/qqT9fgUlX60Mq0OdQ3uW