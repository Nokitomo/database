ts, where Luisa is a habitué, since she gets her crack there. Vincenzo’s problems suddenly get worse, though, after a series of mistakes shut him out of the gang, and Luisa is now his only chance: he convinces her to have her bones broken."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/kKO1f92mY2ckADAhlCaanvqNIQG.jpg","background":"https://image.tmdb.org/t/p/original/16X8je718N2jlJ0IkRa6IoEK5Ub.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":938858,"type":"movie","originalLanguage":"it-IT","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/kKO1f92mY2ckADAhlCaanvqNIQG.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/kKO1f92mY2ckADAhlCaanvqNIQG.jpg","language":"it","width":1000,"height":1500},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/kKO1f92mY2ckADAhlCaanvqNIQG.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/kKO1f92mY2ckADAhlCaanvqNIQG.jpg","language":"it","width":1000,"height":1500}]},"en":{"status":"missing","candidates":[]},"xx":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/vHXz8QoWVNEF2dZA5sO13Q7MbWr.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/vHXz8QoWVNEF2dZA5sO13Q7MbWr.jpg","language":"xx","width":1536,"height":2048},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/vHXz8QoWVNEF2dZA5sO13Q7MbWr.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/vHXz8QoWVNEF2dZA5sO13Q7MbWr.jpg","language":"xx","width":1536,"height":2048}]}},"background":{"it":{"status":"available","selected":{"type":"backdrop","url":"https://image.tmdb.org/t/p/original/dDkxIjzCVJoVDqNFdvDN0K65Pnm.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/dDkxIjzCVJoVDqNFdvDN0K65Pnm.jpg","language":"it","width":1280,"height":720},"candidates":[{"type":"backdrop","url":"https://image.tmdb.org/t/p/original/dDkxIjzCVJoVDqNFdvDN0K65