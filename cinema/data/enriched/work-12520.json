e":"streamingunity:images","path":"/images/2e6e55dd-7641-440f-90e9-6ff0b690d5f3.webp"},"provider":"streamingunity"},{"id":682329,"filename":"89278fba-0d76-4ac3-aac3-3197c0aca22f.webp","type":"cover_mobile","lang":"it","imageable_type":"title","imageable_id":55725,"created_at":"2026-04-29T12:32:00.000000Z","updated_at":"2026-05-19T19:05:16.000000Z","original_url_field":null,"reference":{"base":"streamingunity:images","path":"/images/89278fba-0d76-4ac3-aac3-3197c0aca22f.webp"},"provider":"streamingunity"}],"episodeMappingUncertain":false,"seasons":[],"provenance":{},"warnings":[],"externalIdsEvidence":{"wikidata":{"source":"wikidata","sourceUrl":"https://www.wikidata.org/wiki/Q2633310","wikidataId":"Q2633310","tmdbId":41115,"type":"movie","imdbId":"tt0201631","tvdbId":28238}},"externalMedia":{"tmdb":{"source":"tmdb-api","id":41115,"type":"movie","sourceUrl":"https://www.themoviedb.org/movie/41115","fetchedAt":"2026-11-07T21:59:43.396Z","originalLanguage":"es-ES","title":{"value":"Garage Olimpo","language":"es-ES"},"originalTitle":"Garage Olimpo","overview":{"value":"Maria Fabiani, 19 anni, è un'attivista militante in una organizzazione clandestina che si oppone alla dittatura militare al governo in Argentina. Fa la maestra in una bidonville di Buenos Aires, e vive in città in una grande casa insieme alla madre Diana. Incombono difficoltà economiche e così Diana ha affittato alcune stanze dell'appartamento, una di queste a Felix, un giovane timido, che dice di non avere famiglia, di lavorare come guardiano notturno in un garage e, soprattutto, si mostra innamorato di Maria. Una mattina irrompono in casa poliziotti e militari in borghese: arrestata di fronte allo sguardo impotente della madre, Maria viene portata via e chiusa in prigione in un centro clandestino chiamato 'Garage Olimpo'. Al momento di farla parlare, Tigre, il capo del centro, affida il compito ad uno dei suoi uomini più fidati: è Felix, l'affittuario.","language":"it-IT"},"releaseDate":"1999-09-02","sta