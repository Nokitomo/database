の倒産を宣言し、借金を踏み倒せば皆助かるというのだ。しかし・・・実は一狐斎は、息子に全ての責任を押し付け、切腹させるつもりだった！小四郎に残された道は、100億返済か切腹のみ！人生最大のトラブルに巻き込まれた若きプリンス、一体どうする――！？","tagline":"節約は、戦でござります!"}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/mP9tlhEXm3dU9noFZCNU4P4fsRT.jpg","background":"https://image.tmdb.org/t/p/original/qGlKLxHYwPpRZqWqZqYxzhYgBKx.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":1126444,"type":"movie","originalLanguage":"ja-JP","series":{"poster":{"it":{"status":"missing","candidates":[]},"en":{"status":"missing","candidates":[]},"ja":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/mP9tlhEXm3dU9noFZCNU4P4fsRT.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/mP9tlhEXm3dU9noFZCNU4P4fsRT.jpg","language":"ja","width":693,"height":1040},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/mP9tlhEXm3dU9noFZCNU4P4fsRT.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/mP9tlhEXm3dU9noFZCNU4P4fsRT.jpg","language":"ja","width":693,"height":1040},{"type":"poster","url":"https://image.tmdb.org/t/p/original/obKzhXbt5zuKkj76LdgtFc82m5V.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/obKzhXbt5zuKkj76LdgtFc82m5V.jpg","language":"ja","width":1810,"height":2560}]},"xx":{"status":"missing","candidates":[]}},"background":{"it":{"status":"missing","candidates":[]},"en":{"status":"missing","candidates":[]},"ja":{"status":"missing","candidates":[]},"xx":{"status":"available","selected":{"type":"backdrop","url":"https://image.tmdb.org/t/p/original/qGlKLxHYwPpRZqWqZqYxzhYgBKx.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/qGlKLxHYwPpRZqWqZqYxzhYgBKx.jpg","language":"xx","width":1280,"height":720},"candidates":[{"type":"backdrop","url":"https://image.tmdb.org/t/p/original/qGlKLxHYwPpRZqWqZqYxzhYgBKx.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/qGlKLxHYwPpRZqWqZqYxzhYgBKx.jpg","language":"xx","width":1280,"height":720},{"type":"backdrop","url