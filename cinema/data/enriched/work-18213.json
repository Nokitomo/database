luzione\" cova sulla Revolutionary road.","tagline":"Come puoi liberarti senza andare in pezzi?"},{"language":"en-US","overview":"A young couple living in a Connecticut suburb during the mid-1950s struggle to come to terms with their personal problems while trying to raise their two children. Based on a novel by Richard Yates.","tagline":"How do you break free without breaking apart?"}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/j1AO4cW8iYiLjpOyegZfMtSrhfy.jpg","background":"https://image.tmdb.org/t/p/original/zmXMm9DI5qdPPPM92uShv8c2IBP.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":4148,"type":"movie","originalLanguage":"en-US","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/j1AO4cW8iYiLjpOyegZfMtSrhfy.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/j1AO4cW8iYiLjpOyegZfMtSrhfy.jpg","language":"it","width":1080,"height":1620},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/j1AO4cW8iYiLjpOyegZfMtSrhfy.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/j1AO4cW8iYiLjpOyegZfMtSrhfy.jpg","language":"it","width":1080,"height":1620}]},"en":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/cvkD3yiVXLg3as8EAG3LaTycONQ.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/cvkD3yiVXLg3as8EAG3LaTycONQ.jpg","language":"en","width":2000,"height":3000},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/cvkD3yiVXLg3as8EAG3LaTycONQ.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/cvkD3yiVXLg3as8EAG3LaTycONQ.jpg","language":"en","width":2000,"height":3000},{"type":"poster","url":"https://image.tmdb.org/t/p/original/rbCQ3wKIwcgYxvZaAkEeC0eRGKD.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/rbCQ3wKIwcgYxvZaAkEeC0eRGKD.jpg","language":"en","width":1600,"height":2400},{"type":"poster","url":"https://image.tmdb.org/t/p/or