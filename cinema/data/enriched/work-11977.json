haracter of Arturo. The media is going wild, and the presence of Enrico, the actor's agent, becomes increasingly pressing."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/7eORuG7JZn77Hqzvvds4bpqrpmZ.jpg","background":"https://image.tmdb.org/t/p/original/9q3EWLQzKtjxEwB0xvPODPbtybQ.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":105775,"type":"movie","originalLanguage":"it-IT","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/7eORuG7JZn77Hqzvvds4bpqrpmZ.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/7eORuG7JZn77Hqzvvds4bpqrpmZ.jpg","language":"it","width":740,"height":1110},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/7eORuG7JZn77Hqzvvds4bpqrpmZ.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/7eORuG7JZn77Hqzvvds4bpqrpmZ.jpg","language":"it","width":740,"height":1110},{"type":"poster","url":"https://image.tmdb.org/t/p/original/mea1Ka8NFJrfOV8TxeHk3PgCZgO.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/mea1Ka8NFJrfOV8TxeHk3PgCZgO.jpg","language":"it","width":576,"height":864},{"type":"poster","url":"https://image.tmdb.org/t/p/original/AeCFZdwGqbA8XE4Jcsz4EPjYePl.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/AeCFZdwGqbA8XE4Jcsz4EPjYePl.jpg","language":"it","width":1200,"height":1600}]},"en":{"status":"missing","candidates":[]},"xx":{"status":"missing","candidates":[]}},"background":{"it":{"status":"missing","candidates":[]},"en":{"status":"missing","candidates":[]},"xx":{"status":"available","selected":{"type":"backdrop","url":"https://image.tmdb.org/t/p/original/9q3EWLQzKtjxEwB0xvPODPbtybQ.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/9q3EWLQzKtjxEwB0xvPODPbtybQ.jpg","language":"xx","width":1280,"height":720},"candidates":[{"type":"backdrop","url":"https://image.tmdb.org/t/p/original/9q3EWLQzKtjxEwB0xvPODPbtybQ.jpg","previewUrl":"https://image.tmdb.org/t/p