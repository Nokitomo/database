/original/6EGqmWOR3R3jv3IgrEZmCjTAVGv.jpg"},{"id":11916,"name":"Liv Ullmann","role":"Elisabet Vogler","profile":"https://image.tmdb.org/t/p/original/7IJimLbXIOYpLAS4UaHcNYWRsJe.jpg"},{"id":11917,"name":"Margaretha Krook","role":"The Doctor","profile":"https://image.tmdb.org/t/p/original/eIfMDQG8oaU2Vt5xbYt4vS6ftja.jpg"},{"id":6649,"name":"Gunnar Björnstrand","role":"Herr Vogler","profile":"https://image.tmdb.org/t/p/original/vy5Y0c1ACGCI6d4rVjmTM6HOqNN.jpg"},{"id":11918,"name":"Jörgen Lindström","role":"Elisabet's Son (uncredited)","profile":"https://image.tmdb.org/t/p/original/yXsYjc6FvmcHgSJ5Uv4GJBnRBqX.jpg"},{"id":6340224,"name":"Thích Quảng Đức","role":"Self - burning monk (archive footage)"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","overview":"Alma, giovane infermiera, assiste elisabeth, un'attrice che da tempo ha scelto di non parlare. Lontane dalla clinica, le due donne si trasferiscono in una casa in riva al mare: qui la convivenza forzata incrina il rapporto di amicizia e poco a poco l'astio e le incomprensioni prendono il sopravvento, in un confronto dove l'una scoprirà di avere sempre più bisogno dell'altra."},{"language":"en-US","overview":"A young nurse, Alma, is put in charge of Elisabeth Vogler: an actress who is seemingly healthy in all respects, but will not talk. As they spend time together, Alma speaks to Elisabeth constantly, never receiving any answer.","tagline":"Ingmar Bergman's most personal and original film."},{"language":"sv-SV","overview":"På ytan verkar Elisabeth Vogler ha allt hon önskar sig: hon är en framgångsrik skådespelerska, lycklig i sitt äktenskap och mor till en son. Men efter en föreställning av Elektra har hon plötsligt upphört att tala. I övrigt helt frisk har hon valt att gå in i tystnaden. Hon svarar inte på frågor och tilltal, tystnaden är hennes mask. Tillsammans med en sköterska, syster Alma, bosätter hon sig i en isolerad stuga på en ö. De två kvinnorna kommer efterhand varandra närmare i olika situationer och det uppstår ett förtroligt förhållande dem emellan, så pass förtroligt att deras identiteter börjar glida mot och in i varandra.","tagline":"Ett drama om människans svårighet att fylla alla roller i tillvaron"}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/tSIrlTXoUb6qYnE2fVZGoKvVSoL.jpg","background":"https://image.tmdb.org/t/p/original/amr72SENYz7AM4Hq5WBXxFBJEY6.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":797,"type":"movie","originalLanguage":"sv-SV","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/tSIrlTXoUb6qYnE2fVZGoKvVSoL.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/tSIrlTXoUb6qYnE2fVZGoKvVSoL.jpg","language":"it","width":2000,"height":3000},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/tSIrlTXoUb6qYnE2fVZGoKvVSoL.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/tSIrlTXoUb6qYnE2fVZGoKvVSoL.jpg","language":"it","width":2000,"height":3000},{"type":"poster","url":"https://image.tmdb.org/t/p/original/zvwPsqLQDGToaMfUYmYgJsVCZro.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/zvwPsqLQDGToaMfUYmYgJsVCZro.jpg","language":"it","width":500,"height":750},{"type":"poster","url":"https://image.tmdb.org/t/p/original/tbegnPYSsSDKIMPRfi5NzT9HPiG.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/tbegnPYSsSDKIMPRfi5NzT9HPiG.jpg","language":"it","width":1497,"height":2246},{"type":"poster","url":"https://image.tmdb.org/t/p/original/npCioLxNiW795VnWsqvdKp9sOPp.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/npCioLxNiW795VnWsqvdKp9sOPp.jpg","language":"it","width":1200,"height":1800}]},"en":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/cl0HEZT8UfzLqaMrYTvGNHOfPYj.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/cl0HEZT8UfzLqaMrYTvGNHOfPYj.jpg","language":"en","width":100