ont les prisonniers qui surveillent les gardiens.  L’intégration de Melissa est facilitée par Saveriu, un jeune détenu qui semble influent et la place sous sa protection.  Mais une fois libéré, Saveriu reprend contact avec Melissa. Il a un service à lui demander... Une mécanique pernicieuse se met en marche.","tagline":"Ici, on n'oublie personne."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/48xwJpo5tecapOAEq0Gio1LQ3Q1.jpg","background":"https://image.tmdb.org/t/p/original/pW0Hl1sKv2AxoikRTGhFG7a6fcE.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":989474,"type":"movie","originalLanguage":"fr-FR","series":{"poster":{"it":{"status":"missing","candidates":[]},"en":{"status":"missing","candidates":[]},"fr":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/48xwJpo5tecapOAEq0Gio1LQ3Q1.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/48xwJpo5tecapOAEq0Gio1LQ3Q1.jpg","language":"fr","width":2000,"height":3000},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/48xwJpo5tecapOAEq0Gio1LQ3Q1.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/48xwJpo5tecapOAEq0Gio1LQ3Q1.jpg","language":"fr","width":2000,"height":3000},{"type":"poster","url":"https://image.tmdb.org/t/p/original/tGcn01ZoBRtEx807SjMmtlE9aYa.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/tGcn01ZoBRtEx807SjMmtlE9aYa.jpg","language":"fr","width":2000,"height":3000}]},"xx":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/bf1m5A4GOo5gcVUqtv674yZsNcf.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/bf1m5A4GOo5gcVUqtv674yZsNcf.jpg","language":"xx","width":1333,"height":2000},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/bf1m5A4GOo5gcVUqtv674yZsNcf.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/bf1m5A4GOo5gcVUqtv674yZsNcf.jpg","language":"xx","width":1333,"height":2000}]}},"b