es.","tagline":"World War II had finished, but it left indelible marks."},{"language":"de-DE","overview":"Der junge Herr Kessler kommt kurz nach Kriegsende von Amerika nach Deutschland. Er verweigerte den Dienst in der Army und möchte nun als Schlafwagenschaffner den Leid geplagten Deutschen etwas gutes tun. Doch muss er bald feststellen, dass sein schwarz-weiß Bild nicht passt."}],"images":{"logos":[{"type":"logo","url":"https://image.tmdb.org/t/p/original/1DiXa4lOhQGaI27AP7UNtLSEZEw.png","previewUrl":"https://image.tmdb.org/t/p/w300/1DiXa4lOhQGaI27AP7UNtLSEZEw.png","language":"en","width":792,"height":300},{"type":"logo","url":"https://image.tmdb.org/t/p/original/n1XQyjZuJAuL7idyhbNsFAHDA6g.png","previewUrl":"https://image.tmdb.org/t/p/w300/n1XQyjZuJAuL7idyhbNsFAHDA6g.png","language":"en","width":1466,"height":527},{"type":"logo","url":"https://image.tmdb.org/t/p/original/zr4XVShjQ2ybb4KJXoPK90ahqzR.png","previewUrl":"https://image.tmdb.org/t/p/w300/zr4XVShjQ2ybb4KJXoPK90ahqzR.png","language":"en","width":540,"height":1461}],"posters":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/pyFtuYQReoSmhNs55kRJedA5wEJ.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/pyFtuYQReoSmhNs55kRJedA5wEJ.jpg","language":"en","width":2000,"height":3000},{"type":"poster","url":"https://image.tmdb.org/t/p/original/ot4yJ4Hi1pXPaQpejUGtOIcAN18.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/ot4yJ4Hi1pXPaQpejUGtOIcAN18.jpg","language":"en","width":800,"height":1200},{"type":"poster","url":"https://image.tmdb.org/t/p/original/1qR24DNBgALWQCXjNQNCBU2zg4.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/1qR24DNBgALWQCXjNQNCBU2zg4.jpg","language":"en","width":2000,"height":2999},{"type":"poster","url":"https://image.tmdb.org/t/p/original/62dAtOyC0vodM9POQjpnZYWpV9c.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/62dAtOyC0vodM9POQjpnZYWpV9c.jpg","language":"en","width":1000,"height":1500},{"type":"poster","url":"https://image.tmdb.org/t/p/original/66SKAdMkW5vOABN2UteJlPabX