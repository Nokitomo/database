piele und sensationslüsterner Berichterstattung durch die Medien. Sie wird in Talkshows eingeladen und gelangt zu einer schier unglaublichen Berühmtheit. Die gesamte Welt interessiert sich für das Schicksal der Natascha Kampusch. Doch bald schon stellt die junge Frau fest, dass ihr Weg in die Freiheit noch lange nicht zu Ende ist.","tagline":"Die wahre Geschichte der Natascha Kampusch - Berührend. Bewegend. Mutig. Stark."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/eUsbeRroXNrFLNCFTvpgCLjwzws.jpg","background":"https://image.tmdb.org/t/p/original/dzm6sNpz9UwG208xyGKAJ6e4ybA.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":166666,"type":"movie","originalLanguage":"de-DE","series":{"poster":{"it":{"status":"missing","candidates":[]},"en":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/x2bybyGMtyFSVNjFSxeDNu2fnPD.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/x2bybyGMtyFSVNjFSxeDNu2fnPD.jpg","language":"en","width":1812,"height":2718},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/x2bybyGMtyFSVNjFSxeDNu2fnPD.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/x2bybyGMtyFSVNjFSxeDNu2fnPD.jpg","language":"en","width":1812,"height":2718},{"type":"poster","url":"https://image.tmdb.org/t/p/original/jQ7aucozEWiz1cBCdZtcYSJfWC7.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/jQ7aucozEWiz1cBCdZtcYSJfWC7.jpg","language":"en","width":1000,"height":1500},{"type":"poster","url":"https://image.tmdb.org/t/p/original/oCvYFKhiuWgrCe9kjqY0os5kJyg.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/oCvYFKhiuWgrCe9kjqY0os5kJyg.jpg","language":"en","width":1067,"height":1600},{"type":"poster","url":"https://image.tmdb.org/t/p/original/yEtadwqnLLWFvBxHplf9EgYvzqD.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/yEtadwqnLLWFvBxHplf9EgYvzqD.jpg","language":"en","width":800,"height":1200},{"type":"poster","url":"ht