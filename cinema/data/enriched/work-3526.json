iovanna Infante","role":"Fã"},{"id":5088410,"name":"Marcio Barro","role":"Policial"},{"id":592384,"name":"Ana Beatriz Caruncho","role":"Camila","profile":"https://image.tmdb.org/t/p/original/UenOdGGJxOl5TPfhMeosWy4qe0.jpg"},{"id":5088411,"name":"Gabriel Borgongino","role":"Aluno Nerd"},{"id":4205320,"name":"Raphael Jacques","role":"Motorista"},{"id":1418765,"name":"Paula Barbosa","role":"Aluna","profile":"https://image.tmdb.org/t/p/original/t0QluwyAUNWDHrLBEcCEyZTUrwp.jpg"},{"id":4190663,"name":"Nicolas Salim","role":"Técnico"},{"id":1181458,"name":"Prazeres Barbosa","role":"Mãe da Patrícia","profile":"https://image.tmdb.org/t/p/original/xF5b513aOQbHkKgKC9hj1QBRJCN.jpg"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","title":"Cenerentola Pop","overview":"Dopo il divorzio dei genitori Cíntia (Maisa Silva) non crede più all'amore, fino all'incontro con il cantautore Freddy Prince (Filipe Bragança)."},{"language":"en-US","title":"DJ Cinderella","overview":"Cintia is modern princess, she's connected, decided and loves music. This \"pop\" princess used to live with their parents in a huge castle with a nice view to the city. Every night she looked through the window and watch the view dreaming with a prince she didn't met yet. But one day her castle crumbles with everything around her, after her parents divorce she went to live with her aunt and stops believing in love.  What she didn't knew was that there was a charming prince in her history, that wanted to break the ice around our modern day cinderella."},{"language":"pt-BR","overview":"Cintia é uma princesa dos dias atuais: antenada, com opiniões próprias, decidida e adora música. Essa princesa pop morava com os pais em um castelo enorme de onde via toda a cidade. Todas as noites, ela olhava pela janela, de onde ficava admirando a vista e sonhando com um príncipe que ainda não conhecia. Porém, um dia, o castelo de Cintia desmoronou e com ele tudo à sua volta. Com a separação dos pais, ela vai morar com a tia, se afasta do pai e, principalmente, deixa de acreditar no amor. Ela só não contava com um detalhe... Havia mesmo um belo príncipe encantando em sua história. E tudo o que ele mais queria era descongelar o coração da nossa gata (nada) borralheira!"}],"images":{"logos":[{"type":"logo","url":"https://image.tmdb.org/t/p/original/jQc1tfdxztSn7CSGUWIzHFq6Yjo.png","previewUrl":"https://image.tmdb.org/t/p/w300/jQc1tfdxztSn7CSGUWIzHFq6Yjo.png","language":"it","width":729,"height":266},{"type":"logo","url":"https://image.tmdb.org/t/p/original/lzDMA8BLJw2RFC5e3amhgKlJufS.png","previewUrl":"https://image.tmdb.org/t/p/w300/lzDMA8BLJw2RFC5e3amhgKlJufS.png","language":"pt","width":1278,"height":450}],"posters":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/hefzmSfoWxOmf1IV343abaJ037Y.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/hefzmSfoWxOmf1IV343abaJ037Y.jpg","language":"it","width":1000,"height":1500},{"type":"poster","url":"https://image.tmdb.org/t/p/original/rhEMGSlmtfvUYdGuE3M1dB0SmOA.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/rhEMGSlmtfvUYdGuE3M1dB0SmOA.jpg","language":"en","width":2000,"height":3000},{"type":"poster","url":"https://image.tmdb.org/t/p/original/uL0TrrV5MHQFkwRxlho0dDKTwvm.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/uL0TrrV5MHQFkwRxlho0dDKTwvm.jpg","language":"pt","width":2000,"height":3000},{"type":"poster","url":"https://image.tmdb.org/t/p/original/hCuWrbbbyrqYg7Ln08YhEtISx5J.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/hCuWrbbbyrqYg7Ln08YhEtISx5J.jpg","language":"pt","width":546,"height":820}],"backdrops":[{"type":"backdrop","url":"https://image.tmdb.org/t/p/original/3tt3tp81aGboViMplQItugAI2RO.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/3tt3tp81aGboViMplQItugAI2RO.jpg","language":"xx","width":1758,"height":989},{"type":"backdrop","url":"https://image.tmdb.org/t/p/original/3sZvfEsVXRoiojabeUgP4JQ6H6v.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/3sZvfEsVXRoiojabe