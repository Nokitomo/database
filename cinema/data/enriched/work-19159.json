likely ally--a cruel and merciless martial arts expert  who is also the tower's master. But when the master dies under mysterious circumstances, Lo ends up dueling with someone far more terrifying."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/7UO1YDhHvqBxpCRYnA8wDljwSbR.jpg","background":"https://image.tmdb.org/t/p/original/kKCA2KS9ShIQwOnK8ef6A4T2Zem.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":48773,"type":"movie","originalLanguage":"cn-CN","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/7UO1YDhHvqBxpCRYnA8wDljwSbR.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/7UO1YDhHvqBxpCRYnA8wDljwSbR.jpg","language":"it","width":555,"height":833},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/7UO1YDhHvqBxpCRYnA8wDljwSbR.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/7UO1YDhHvqBxpCRYnA8wDljwSbR.jpg","language":"it","width":555,"height":833},{"type":"poster","url":"https://image.tmdb.org/t/p/original/sUsbjC3ZFTuQfjcwU2qQcuiS7zV.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/sUsbjC3ZFTuQfjcwU2qQcuiS7zV.jpg","language":"it","width":1059,"height":1500}]},"en":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/lVL0oX4ZA2owOtQwTsmbw92lhCp.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/lVL0oX4ZA2owOtQwTsmbw92lhCp.jpg","language":"en","width":2000,"height":3000},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/lVL0oX4ZA2owOtQwTsmbw92lhCp.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/lVL0oX4ZA2owOtQwTsmbw92lhCp.jpg","language":"en","width":2000,"height":3000},{"type":"poster","url":"https://image.tmdb.org/t/p/original/8CTSey0i1wqzDZVOO6HhGbGcmqf.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/8CTSey0i1wqzDZVOO6HhGbGcmqf.jpg","language":"en","width":1000,"height":1500},{"type":"poster","url":"https