t"},{"id":3120886,"name":"Piotr Witkowski","role":"'Pejolt'","profile":"https://image.tmdb.org/t/p/original/wOc1zX0nlfuZaZasX0Bb9Lq90IJ.jpg"},{"id":3223149,"name":"Przemysław Wyszyński","role":"Przemo","profile":"https://image.tmdb.org/t/p/original/ag1OCvJE0ejpF4dp2HUmuol5Fcc.jpg"},{"id":2951783,"name":"Jędrzej Wielecki","role":"'Śledziu'","profile":"https://image.tmdb.org/t/p/original/xgmJZx9cbkKA21GaQu79xoMfKFJ.jpg"},{"id":4565306,"name":"Dominika Krzemińska","role":"Lena"},{"id":4733080,"name":"Krzysztof Piekarz","role":"Kolas"},{"id":2464977,"name":"Dominika Kachlik","role":"Kris' Girlfriend","profile":"https://image.tmdb.org/t/p/original/cDujJV3iDeZS5u4QP1bs0KGyBBo.jpg"},{"id":2119965,"name":"Pamela Stefanowicz","profile":"https://image.tmdb.org/t/p/original/g1DjriRiyGi8blpERHWHRClEhQz.jpg"},{"id":2119966,"name":"Mateusz Janusz","profile":"https://image.tmdb.org/t/p/original/ieYCUlM5Ni4370HTN36boFsDVMf.jpg"},{"id":4733083,"name":"Vanessa Gazda"},{"id":1120450,"name":"Joanna Majstrak","role":"Gerard's Girlfriend","profile":"https://image.tmdb.org/t/p/original/kmD4B2mnsSJlBZ0747vCdTZEAtI.jpg"},{"id":4733084,"name":"Margo Marlow"},{"id":4733086,"name":"Monika Sikocińska"},{"id":4733089,"name":"Paweł Siergiej","role":"Guest"},{"id":4412877,"name":"Adrian Igielski","role":"Guest"},{"id":4733090,"name":"Lena Kołodziejak"},{"id":4733017,"name":"Monika Włoch","role":"Girl from the Party"},{"id":4733095,"name":"Kamila Zwierzyńska"},{"id":4733097,"name":"Agata Jackowska"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","title":"Diablo - L'ultima corsa","overview":"Kuba è un giovane ragazzo orfano appassionato di gare clandestine, a cui prende parte sia per passione verso le auto sportive, sia per racimolare in fretta i soldi necessari per le cure della sorella Lena. L’occasione della vita gli viene offerta da un certo Max, leader di una delle più importanti squadre in gara. Grazie a lui, Kuba inizia a gareggiare in uno dei tornei più pericolosi, la \"Pecora Nera”, dove in palio ci sono parecchi soldi...","tagline":"Mangia veloce. Ama follemente."},{"language":"en-US","title":"Diablo: The Utimate Race","overview":"Kuba's sister falls seriously ill. In order to gather the required money for treatment he starts taking part in illegal car races.","tagline":"Action in high gear."},{"language":"pl-PL","overview":"Pasją Kuby są szybkie samochody, zawrotna prędkość i ekstremalne wyścigi. Jego siostra Lena musi przejść bardzo kosztowną operację za granicą. Chcąc zdobyć potrzebne środki, chłopak postanawia brać udział w nielegalnych rajdach. Talent i brawurę młodego kierowcy zauważa wpływowy gangster – Max. Proponuje chłopakowi udział w okrytym złą sławą wyścigu, który niejeden kierowca przypłacił kalectwem, a nawet życiem. Nagrodą dla zwycięzcy legendarnych zmagań jest tytuł „Diablo” i kilkaset tysięcy euro. Kuba podejmuje ryzyko i wkracza do podejrzanego świata wielkich pieniędzy, pięknych kobiet i szemranych interesów. To właśnie w nim poznaje Ewę – obdarzoną wyjątkową urodą, nieugiętą zawodniczkę, która z zaciętej rywalki staje się jego wielką namiętnością. Wkrótce na jaw wychodzi jednak prawdziwa tożsamość dziewczyny. Od tego momentu życie Kuby znajdzie się w wielkim niebezpieczeństwie.","tagline":"Jedź szybko. Kochaj wściekle."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/25UKwenbGoBydBSlTXfjHVkIqzg.jpg","background":"https://image.tmdb.org/t/p/original/48Pod3td6cdvHXsrxjsx67GkIeS.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":568637,"type":"movie","originalLanguage":"pl-PL","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/25UKwenbGoBydBSlTXfjHVkIqzg.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/25UKwenbGoBydBSlTXfjHVkIqzg.jpg","language":"it","width":630,"height":945},"candidates":[{"type":"poster","url":"https: