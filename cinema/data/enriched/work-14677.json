ttps://image.tmdb.org/t/p/original/xQLvEUfXjUK4u9wYlHzAn8pIuTE.jpg"},{"id":24040,"name":"Jean-Luc Couchard","role":"Djo, le patriarche","profile":"https://image.tmdb.org/t/p/original/7Al4UYit5hkEh3auIEGeTMTYdHN.jpg"},{"id":1653189,"name":"Jimmy Labeeu","role":"Fil"},{"id":1884962,"name":"Cartman","role":"Igor","profile":"https://image.tmdb.org/t/p/original/qFdh9IV1pnP79ST0FUbNTJj17n8.jpg"},{"id":84434,"name":"Wahid Bouzidi","role":"Codétenu cellule","profile":"https://image.tmdb.org/t/p/original/H6mCqdBl3krwjtdEx5RLnuutJI.jpg"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","title":"Il consiglio studentesco","overview":"Bob, Romane, Max e Vinz, quattro amici quarantenni conosciutisi al Consiglio Studentesco della Facoltà di Economia e Commercio, si ritrovano, loro malgrado, invischiati con una nuova generazione di studenti durante un weekend \"senza limiti\" sulle Alpi."},{"language":"en-US","overview":"The story of four lifelong friends who met in the 2000s when they were presidents of the BDE of the Nantes Institute of Business. At the time, they were the \"Bioman\": the kings of partying, excess and \"transmutation\". 20 years later, they have mellowed out and lead well-ordered lives. Except... Once a year, when they get together for the WEB: the Bioman Weekend. There, they \"transmute\" hard as they like to say. In short: they drink and sing in a pathetic way."},{"language":"fr-FR","overview":"L’histoire de quatre amis pour la vie qui se sont rencontrés dans les années 2000 lorsqu’ils étaient à la présidence du BDE du Nantes Institute of Business. À l’époque, ils étaient les « Bioman » : les rois de la fête, des excès et de la « transmutation ». 20 ans plus tard, ils se sont assagis et mènent des vies bien rangées. Sauf… Une fois par an, quand ils se retrouvent pour le WEB : le Week End Des Bioman. Où là, ça « transmute » fort comme ils aiment à le dire. En clair : ça boit et ça chante de façon pathétique. Cette année, direction « la Folie Douce » à Val Thorens pour un week-end de ouf.","tagline":"Ça devait être un pur week-end... Ça va être le pire"}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/83JNxe7C0WGuBKY5CBRbxoMW2Oh.jpg","background":"https://image.tmdb.org/t/p/original/q18xU7tXpVnoZvpcmDiWAVzQi8W.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":957752,"type":"movie","originalLanguage":"fr-FR","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/83JNxe7C0WGuBKY5CBRbxoMW2Oh.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/83JNxe7C0WGuBKY5CBRbxoMW2Oh.jpg","language":"it","width":1200,"height":1800},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/83JNxe7C0WGuBKY5CBRbxoMW2Oh.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/83JNxe7C0WGuBKY5CBRbxoMW2Oh.jpg","language":"it","width":1200,"height":1800}]},"en":{"status":"missing","candidates":[]},"fr":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/tJso5lzMmDF5TI8BJZYQnOUh91o.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/tJso5lzMmDF5TI8BJZYQnOUh91o.jpg","language":"fr","width":2000,"height":3000},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/tJso5lzMmDF5TI8BJZYQnOUh91o.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/tJso5lzMmDF5TI8BJZYQnOUh91o.jpg","language":"fr","width":2000,"height":3000},{"type":"poster","url":"https://image.tmdb.org/t/p/original/ofWJ1UiUFJncIGBV2E9f9CGRFwk.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/ofWJ1UiUFJncIGBV2E9f9CGRFwk.jpg","language":"fr","width":2000,"height":3000},{"type":"poster","url":"https://image.tmdb.org/t/p/original/AaFA1SAasP5tcn5Wyc2tudfmKxo.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/AaFA1SAasP5tcn5Wyc2tudfmKxo.jpg","language":"fr","width":2000,"height":3000},{"type":"poster","url":"https://image.t