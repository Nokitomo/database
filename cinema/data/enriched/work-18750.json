XFSoaD3rncUg1XDLokt.jpg"},{"id":6252,"name":"Magda Schneider","role":"Duchess Ludovika","profile":"https://image.tmdb.org/t/p/original/c3IG8NHn5MFaFpFZke1Kj7BnO2n.jpg"},{"id":6255,"name":"Vilma Degischer","role":"Archduchess Sophie"},{"id":6254,"name":"Gustav Knuth","role":"Duke Max","profile":"https://image.tmdb.org/t/p/original/1bB83bPDWPQCh39efGpD9KnN4o1.jpg"},{"id":6809,"name":"Walther Reyer","role":"Count Andrassy","profile":"https://image.tmdb.org/t/p/original/qX7oxCxupVFOsCYRdeHiOe4pY4i.jpg"},{"id":6256,"name":"Josef Meinrad","role":"Major Böckl","profile":"https://image.tmdb.org/t/p/original/svPZ1mal3xGFW8QB754j2hh57Rl.jpg"},{"id":6810,"name":"Senta Wengraf","role":"Countess Bellegarde","profile":"https://image.tmdb.org/t/p/original/vVTfZNCz3KDJULBlOZGxzXdt3Qc.jpg"},{"id":6253,"name":"Uta Franz","role":"Princess Helene","profile":"https://image.tmdb.org/t/p/original/v44CyEhnW1oPt9uWJhizy5pbjCx.jpg"},{"id":591911,"name":"Franz Böheim","role":"Johann Petzmacher","profile":"https://image.tmdb.org/t/p/original/l3jBHE1e39KYR89ZeqEgD7XM5CV.jpg"},{"id":6257,"name":"Erich Nikowitz","role":"Archduke Franz Karl"},{"id":6811,"name":"Hans Ziegler","role":"Dr. Seeburger"},{"id":135435,"name":"Helene Lauterböck","role":"Countess Esterhazy"},{"id":6259,"name":"Hilde Wagener","role":"Baronne Wulfen","profile":"https://image.tmdb.org/t/p/original/9gS1kYsnye4uzDdq7e4jvYgyBxU.jpg"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","title":"Sissi - La giovane imperatrice","overview":"Dopo le nozze con Francesco Giuseppe, Sissi si trova in difficoltà per il suo comportamento, considerato sconveniente per le rigide regole della corte viennese. Si scontra così con l'austera suocera, l'arciduchessa Sofia, e decide di tornare in Baviera dagli amati genitori."},{"language":"en-US","title":"Sissi: The Young Empress","overview":"Sissi is now the empress of Austria and attempts to learn etiquette. While she is busy being empress she also has to deal with her difficult new mother-in-law, while the arch-duchess Sophie is trying to tell the emperor how to rule and also Sissi how to be a mother."},{"language":"de-DE","overview":"Nach der glanzvollen Hochzeit des jungen österreichischen Kaisers Franz Joseph und der bayerischen Prinzessin Elisabeth legt die Mutter des Monarchen nach wie vor größten Wert auf die Einhaltung des strengen Hofzeremoniells. Dies führt zu wachsenden Spannungen zwischen Sissi und ihrer Schwiegermutter. Als Sissi einer kleinen Prinzessin das Leben schenkt, beschließt Erzherzogin Sophie das Kind selbst zu erziehen. Franz Joseph erklärt sich einverstanden und verzweifelt sucht Sissi Zuflucht bei ihren Eltern. Vom Kaiser liebevoll nach Wien zurückgeholt, gewinnt Sissi zwar den Kampf um ihre Tochter, erkennt jedoch angesichts der gespannten politischen Lage mit Ungarn, dass ihre persönlichen Wünsche hinter den Geschicken des Landes zurückstehen müssen. In einem Triumphzug fahren Franz Joseph und Sissi nach Budapest."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/kIrd2lHhD6dYyPoamv1QQZfIckh.jpg","background":"https://image.tmdb.org/t/p/original/xvcqme7lPw7nXNIQU71z11bbWRd.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":458,"type":"movie","originalLanguage":"de-DE","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/kIrd2lHhD6dYyPoamv1QQZfIckh.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/kIrd2lHhD6dYyPoamv1QQZfIckh.jpg","language":"it","width":684,"height":1026},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/kIrd2lHhD6dYyPoamv1QQZfIckh.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/kIrd2lHhD6dYyPoamv1QQZfIckh.jpg","language":"it","width":684,"height":1026},{"type":"poster","url":"https://image.tmdb.org/t/p/original/4cyT3H4VQwqURHF0g2Mz6qDVHzz.jpg","previewUrl":"https://image.tmdb.org/t/p