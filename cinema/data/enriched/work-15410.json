や彼女が円記との雪辱戦に燃えていることなどを知る。"}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/1FzDRJBT4AWbDPkK943Exisu3Cg.jpg","background":"https://image.tmdb.org/t/p/original/x9mXe97tn5F9dxmjpVL9YqN1xJL.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":41477,"type":"movie","originalLanguage":"ja-JP","series":{"poster":{"it":{"status":"missing","candidates":[]},"en":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/80dPE18baHbnB8mrl6wWtGXEyCP.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/80dPE18baHbnB8mrl6wWtGXEyCP.jpg","language":"en","width":1450,"height":2175},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/80dPE18baHbnB8mrl6wWtGXEyCP.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/80dPE18baHbnB8mrl6wWtGXEyCP.jpg","language":"en","width":1450,"height":2175},{"type":"poster","url":"https://image.tmdb.org/t/p/original/rDpV5tuUluLgDGmi76qgcUKLtIa.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/rDpV5tuUluLgDGmi76qgcUKLtIa.jpg","language":"en","width":1000,"height":1500},{"type":"poster","url":"https://image.tmdb.org/t/p/original/bNstcpXn23BE60II30hqQEVGetX.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/bNstcpXn23BE60II30hqQEVGetX.jpg","language":"en","width":2000,"height":3000},{"type":"poster","url":"https://image.tmdb.org/t/p/original/7o8riiyyw4SxKWIh6c97AIudv3X.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/7o8riiyyw4SxKWIh6c97AIudv3X.jpg","language":"en","width":800,"height":1200},{"type":"poster","url":"https://image.tmdb.org/t/p/original/vjdpQY5hLBobfkNnIRBYCK4d2X4.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/vjdpQY5hLBobfkNnIRBYCK4d2X4.jpg","language":"en","width":1000,"height":1500},{"type":"poster","url":"https://image.tmdb.org/t/p/original/nU1yjpPfAUABYfCumq3DfmyEcyN.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/nU1yjpPfAUABYfCumq3DfmyEcyN.jpg","language":"en","width":1000,"height":