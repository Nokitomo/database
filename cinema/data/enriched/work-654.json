ty:images","path":"/images/dedc31c1-8b57-4790-a240-6e2b0b21dd1e.webp"},"provider":"streamingunity"},{"id":143487,"filename":"2a0458cb-0435-41d2-bcb1-1c4de9e71822.webp","type":"cover_mobile","lang":"it","imageable_type":"title","imageable_id":10632,"created_at":"2024-11-29T09:52:47.000000Z","updated_at":"2025-05-12T09:25:24.000000Z","original_url_field":null,"reference":{"base":"streamingunity:images","path":"/images/2a0458cb-0435-41d2-bcb1-1c4de9e71822.webp"},"provider":"streamingunity"}],"episodeMappingUncertain":false,"seasons":[],"provenance":{},"warnings":[],"externalIdsEvidence":{"wikidata":{"source":"wikidata","sourceUrl":"https://www.wikidata.org/wiki/Q131358862","wikidataId":"Q131358862","tmdbId":1150521,"type":"movie","imdbId":"tt28152535","tvdbId":351640}},"externalMedia":{"tmdb":{"source":"tmdb-api","id":1150521,"type":"movie","sourceUrl":"https://www.themoviedb.org/movie/1150521","fetchedAt":"2026-11-06T05:49:34.517Z","originalLanguage":"en-US","title":{"value":"Christmas on Windmill Way","language":"en-US"},"originalTitle":"Christmas on Windmill Way","overview":{"value":"Mia Meijer si prepara per il Dutch Bake-Off del mercatino di Natale e sospetta che sua nonna Ann se ne andrà con l'amato Golden Rolling Pin grazie al suo Kerststol, un tradizionale pane natalizio olandese alla frutta. Ma il mondo di Mia viene scosso quando scopre che Ann aveva problemi finanziari e ha dovuto vendere l'atto di proprietà della proprietà di Windmill Way, di proprietà della sua famiglia da generazioni. A peggiorare le cose, l'acquirente è l'ex fidanzato di Mia, l'imprenditore immobiliare Brady Schaltz, che deve far sapere a Mia e Ann che la segheria olandese di proprietà della famiglia Meijer, rinomata negli ultimi 90 anni per la sua raffinata lavorazione del legno e i suoi splendidi mobili in legno, verrà abbattuta per costruire un lussuoso resort.","language":"it-IT"},"releaseDate":"2023-12-02","status":"Released","rating":5.9,"ratingCount":68,"genres":["Romance","Commedia","televisione film"],"countries":["Canada","United States of America"],"facts":{"Runtime":"84m"},"keywords":[],"networks":[],"socialLinks":{},"cast":[{"id":1815065,"name":"Christa Taylor Brown","role":"Mia Meijer","profile":"https://image.tmdb.org/t/p/original/uUgiI5y8aHA6bxYxzqzFQmgs6H6.jpg"},{"id":62747,"name":"Chad Michael Murray","role":"Brady Schaltz","profile":"https://image.tmdb.org/t/p/original/jIkzUQUVLkgn3HFMFRJBDAD0OLj.jpg"},{"id":40385,"name":"Marcia Bennett","role":"Ann","profile":"https://image.tmdb.org/t/p/original/va30xYbQLgI9UvNFv5oNuhiORTC.jpg"},{"id":500085,"name":"Erin Agostino","role":"Lily Jansen","profile":"https://image.tmdb.org/t/p/original/fIuwUhBQQ2pyIcW8sZqekZVNbkl.jpg"},{"id":180878,"name":"Michael Copeman","role":"Herb","profile":"https://image.tmdb.org/t/p/original/wfzPhnXabS50dpF23Ybz0CJtmsN.jpg"},{"id":1727017,"name":"Kent Sheridan","role":"Lionel Quigley","profile":"https://image.tmdb.org/t/p/original/Ajv5bdt5bRtJP5HOdgKfmDcapSF.jpg"},{"id":225418,"name":"Jon McLaren","role":"Willem Jansen","profile":"https://image.tmdb.org/t/p/original/qqwkwlLaXcevLJdscwrnTNn8ROx.jpg"},{"id":171726,"name":"Darrin Baker","role":"Walt Caprio","profile":"https://image.tmdb.org/t/p/original/jZxcxDEyIeg9x3zvycnnOatCgdf.jpg"},{"id":2767294,"name":"Tim Gammon","role":"Mayor Beamon"},{"id":5889834,"name":"Jacob Blouin","role":"Derek"},{"id":1922745,"name":"Jason Paul","role":"News Reporter","profile":"https://image.tmdb.org/t/p/original/ccYGzYfeUZoDTgte4KvDiI89tPR.jpg"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","overview":"Mia Meijer si prepara per il Dutch Bake-Off del mercatino di Natale e sospetta che sua nonna Ann se ne andrà con l'amato Golden Rolling Pin grazie al suo Kerststol, un tradizionale pane natalizio olandese alla frutta. Ma il mondo di Mia viene scosso quando scopre che Ann aveva problemi finanziari e ha dovuto vendere l'atto di proprietà della proprietà di Windmill Way, di proprietà della sua famiglia da generazioni. A peggiorare le cose, l'acquirente è l'ex fidanzato di Mia, l'imprenditore immobiliare Brady Schaltz, che deve far sapere a Mia e Ann che la segheria olandese di proprietà della famiglia Meijer, rinomata negli ultimi 90 anni per la sua raffinata lavorazione del legno e i suoi splendidi mobili in legno, verrà abbattuta per costruire un lussuoso resort."},{"language":"en-US","overview":"Mia Meijer gets ready for the Christmas Market Dutch Bake-Off and suspects that her grandmother, Ann, will walk away with the cherished Golden Rolling Pin thanks to her Kerststol, a traditional Dutch fruited Christmas bread. But Mia's world is rocked when she learns that Ann was having financial troubles and had to sell the land deed to the Windmill Way property in her family for generations. Making matters worse, the buyer is Mia's former boyfriend, property developer Brady Schaltz, who must let Mia and Ann know the Meijer family-owned heritage Dutch sawmill, renowned for the past 90 years for its fine millwork and beautiful wooden furniture, will be torn down to put up a luxurious resort."}],"images":{"logos":[{"type":"logo","url":"https://image.tmdb.org/t/p/original/qphDJvU5rUhIIwroLlkF0y2F7Wz.png","previewUrl":"https://image.tmdb.org/t/p/w300/qphDJvU5rUhIIwroLlkF0y2F7Wz.png","language":"en","width":757,"height":310}],"posters":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/bRDWHhiVLllPWBU2ADV61acyqT7.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/bRDWHhiVLllPWBU2ADV61acyqT7.jpg","language":"en","width":2000,"height":3000},{"type":"poster","url":"https://image.tmdb.org/t/p/original/1VpPGNb6BTZQgO7CRGuBCOozHuJ.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/1VpPGNb6BTZQgO7CRGuBCOozHuJ.jpg","language":"en","width":800,"height":1200},{"type":"poster","url":"https://image.tmdb.org/t/p/original/ules1n2k3wcr0j1kORefrazHP8L.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/ules1n2k3wcr0j1kORefrazHP8L.jpg","language":"en","width":100