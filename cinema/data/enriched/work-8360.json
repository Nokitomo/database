b.org/t/p/original/jxCSg7hYjhilnYpTjXCFjGox5v6.jpg"},{"id":16921,"name":"Clotilde Courau","role":"Amélie Mazoyer","profile":"https://image.tmdb.org/t/p/original/jSy63zL0jdoQsSGzbUFZICZIrpW.jpg"},{"id":105870,"name":"Fausto Russo Alesi","role":"Achille Starace","profile":"https://image.tmdb.org/t/p/original/3ur2kwquax7vJujGXpWIzjHa4Ao.jpg"},{"id":1668746,"name":"Massimiliano Rossi","role":"Commissario Rizzo","profile":"https://image.tmdb.org/t/p/original/3kgkMSYty4mqBVLCO70b3gXtPnh.jpg"},{"id":1526272,"name":"Elena Bucci","role":"Luisa Baccara"},{"id":1510657,"name":"Lidia Liberman","role":"Lina","profile":"https://image.tmdb.org/t/p/original/tYmOX70CcKyUEN1Op7aklAt24EN.jpg"},{"id":1421529,"name":"Janina Rudenska","role":"Emy Heufler","profile":"https://image.tmdb.org/t/p/original/dNvFPV7EarhwxTT4LF6xAF1lA0B.jpg"},{"id":1871368,"name":"Lino Musella","role":"Carletto","profile":"https://image.tmdb.org/t/p/original/xZuVRh6zyh4fo5QsxERHu25l3P4.jpg"},{"id":1033152,"name":"Paolo Graziosi","role":"Giovanni's father","profile":"https://image.tmdb.org/t/p/original/a1swxZj4z6RgiVsl7y3EKddMrdC.jpg"},{"id":25813,"name":"Antonio Piovanelli","role":"General Noseda","profile":"https://image.tmdb.org/t/p/original/c3CM0EXYDdSKJVODn1rG86qlDS2.jpg"},{"id":1587369,"name":"Marcello Romolo","role":"Giuseppe Cobolli Gigli","profile":"https://image.tmdb.org/t/p/original/p9dsUxJQNJ685XMxSaoj63iQops.jpg"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","overview":"È il 1937 quando Giovanni Comini viene promosso federale per volontà del suo mentore, Achille Starace, Segretario del Partito Fascista nonché numero due del regime. Giovanni è il più giovane in Italia a potersi fregiare del titolo e per questo la notizia ha una certa risonanza. E a soli 29 anni si ritroverà a dover gestire una missione delicata: controllare Gabriele D’Annunzio, sempre più irrequieto e pericoloso agli occhi del Duce. Quest’ultimo non può permettersi intoppi o complicazioni, dal momento che il suo piano di espansione dell’Impero ha la precedenza su tutto. Si tratterà di una vera sfida per il protagonista, soprattutto per via della incrollabile stima reverenziale che prova nei confronti del “Vate”."},{"language":"en-US","title":"The Bad Poet","overview":"1936. Giovanni Comini, the youngest Federal in Fascist Italy, is summoned to Rome for a delicate mission: to surveil aging national poet Gabriele D'Annunzio, whose increasingly restless behavior Mussolini fears could damage his alliance with Nazi Germany. However, after spending time with D'Annunzio, Comini finds himself torn between loyalty to the Party and his fascination with the poet, who will put his burgeoning career at risk."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/7ngoRjEiVOuTdKOH5A6hWaO9r2Q.jpg","background":"https://image.tmdb.org/t/p/original/hMp3jupYQdV8uEGZIvfCn9ydXWj.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":654350,"type":"movie","originalLanguage":"it-IT","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/7ngoRjEiVOuTdKOH5A6hWaO9r2Q.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/7ngoRjEiVOuTdKOH5A6hWaO9r2Q.jpg","language":"it","width":2000,"height":3000},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/7ngoRjEiVOuTdKOH5A6hWaO9r2Q.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/7ngoRjEiVOuTdKOH5A6hWaO9r2Q.jpg","language":"it","width":2000,"height":3000},{"type":"poster","url":"https://image.tmdb.org/t/p/original/6Z6nPCnNTjq0IXlfLova9Srt9hW.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/6Z6nPCnNTjq0IXlfLova9Srt9hW.jpg","language":"it","width":667,"height":1000}]},"en":{"status":"missing","candidates":[]},"xx":{"status":"missing","candidates":[]}},"background":{"it":{"status":"available","selected":{"type":"backdrop","url":"https://image.tmdb.org/t/p/origi