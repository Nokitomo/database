rg/t/p/original/neOKLrDQouiMqlhqYZjxE6LJk8X.jpg"},{"id":19910,"name":"Nora Tschirner","role":"Mother of Hannes","profile":"https://image.tmdb.org/t/p/original/X4sLLqAJIcCk5QyD51Wb0DLojY.jpg"},{"id":22686,"name":"Maria Schrader","role":"Kai's mother"},{"id":37246,"name":"Axel Stein","role":"Kevin","profile":"https://image.tmdb.org/t/p/original/wMVOPqj1ZQcQyQeZS5PKM5tTP3d.jpg"},{"id":52722,"name":"Jacob Matschenz","role":"Dennis","profile":"https://image.tmdb.org/t/p/original/15AzdlqD13Bw0pLZC5pEItDFx0T.jpg"},{"id":71413,"name":"Fabian Halbig","role":"Kai","profile":"https://image.tmdb.org/t/p/original/euy7Mw2P4GyC9T6guonV5L7jcXe.jpg"},{"id":71414,"name":"Leonie Tepe","role":"Maria"},{"id":71415,"name":"Manuel Steitz","role":"Olli","profile":"https://image.tmdb.org/t/p/original/4CjRwavpQMXC7GZKhTnuKsGYD1f.jpg"},{"id":122214,"name":"Ella-Maria Gollmer","role":"Jenny"},{"id":45268,"name":"Jürgen Rißmann","role":"Pförtner","profile":"https://image.tmdb.org/t/p/original/yvPTXv2kqVN7fQHjAAnJEtH3bwi.jpg"},{"id":147346,"name":"Nicolas Schinseck","role":"Elvis","profile":"https://image.tmdb.org/t/p/original/87NVemyKoJeNLHakfKjASnBoWGF.jpg"},{"id":147347,"name":"Benjamin Bara","role":"Prison inmate"},{"id":147348,"name":"Javidan Imani","role":"Jorgo","profile":"https://image.tmdb.org/t/p/original/x8VNLf5QyA8uEZhgOyw1ycn7JA.jpg"},{"id":147349,"name":"David Hürten","role":"Frank","profile":"https://image.tmdb.org/t/p/original/pril4G8WMUZp555990YxJCcWeVv.jpg"},{"id":147350,"name":"Robin Walter","role":"Peter","profile":"https://image.tmdb.org/t/p/original/n80E9KKQYMLbtUuvNOr1JbWTRx9.jpg"},{"id":147351,"name":"Thomas Kautenburger","role":"Warden Kremers","profile":"https://image.tmdb.org/t/p/original/oqiL1Nb7wZ65UpbZsdEERLLB1DF.jpg"},{"id":387178,"name":"Smudo","role":"Kai's father","profile":"https://image.tmdb.org/t/p/original/pDrOaKN8oN0yMvb2q1R4x1NiS62.jpg"},{"id":2315,"name":"Hans Martin Stier","role":"Prison Warden Gerhard Hartmann","profile":"https://image.tmdb.org/t/p/original/ajbFzrVPBeyzEb0kKwlVS6LdSXj.jpg"},{"id":1449397,"name":"Horst Lichter","role":"Self","profile":"https://image.tmdb.org/t/p/original/cbLqap7kbk1GVb3FT6T3O9ginOQ.jpg"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","title":"La banda dei coccodrilli, tutti per uno","overview":"Per il compleanno di Hannes, i Coccodrilli, una banda di ragazzi di quartiere, si recano a una pista di go-kart. La felicità della giornata e l’euforia per la velocità delle automobili lasciano però presto il posto allo sconforto: Frank, uno di loro, rimane vittima di un incidente e ha bisogno di un trapianto di fegato. L’unico donatore compatibile sembra essere il fratello maggiore, in prigione per un furto commesso anni prima. La banda si adopererà per escogitare una soluzione."},{"language":"en-US","title":"The Crocodiles: All for One","overview":"“The Crocodiles” are back and they are in for quite an adventure! Frank is seriously hurt and needs a liver donation. In order to save him, the gang needs to get Frank’s brother out of prison. Their plan is risky and the stakes are high."},{"language":"de-DE","overview":"Kai fährt ins Basketball-Camp und Olli mit seiner Freundin in den Urlaub, während der Rest der Truppe alias Hannes, Maria, Frank, Jorgo und Peter mit halsbrecherischem Tempo über die Kart-Bahn heizt. Da passiert ein dramatischer Unfall - Frank wird mit Blaulicht ins Krankenhaus transportiert und schwebt in Lebensgefahr: Nur die schnelle Organspende eines nahen Verwandten kann ihn noch retten. Einziger möglicher Spender ist sein Bruder Dennis - doch der sitzt mit seinem Einbruchs-Kumpel Kevin im Gefängnis. Die Zeit rennt, aber ein Krokodil gibt niemals auf! Mit Hilfe von Vorstadtkrokidil Jenny und Hannes’ Mutter schmiedet die Bande einen unkonventionellen Plan …","tagline":"Freunde für immer"}],"images":{"logos":[{"type":"logo","url":"https://image.tmdb.org/t/p/original/6JiCxwnHh8NBNGiwArnR9ipmMwG.png","previewUrl":"https://image