so dell'altare maggiore. L'amore d'un giovane comunista per la figlia d'un possidente, fa perdere il controllo a Don Camillo, tanto che il vescovo lo manda un po' in vacanza.","language":"it-IT"},"releaseDate":"1952-03-28","status":"Released","rating":7.5,"ratingCount":322,"genres":["Commedia"],"countries":["France","Italy"],"facts":{"Runtime":"106m"},"keywords":[],"networks":[],"socialLinks":{},"cast":[{"id":69958,"name":"Fernandel","role":"Don Camillo Tarocci","profile":"https://image.tmdb.org/t/p/original/eiiPLZPZ0XilcexB5eNOWEbbcrm.jpg"},{"id":37191,"name":"Gino Cervi","role":"Giuseppe Bottazzi \"Peppone\"","profile":"https://image.tmdb.org/t/p/original/cO72ekkj7xnqluToLakGtWZ4ZHB.jpg"},{"id":71139,"name":"Vera Talchi","role":"Gina Filotti","profile":"https://image.tmdb.org/t/p/original/ioMjgTOqgaf2w2DkPljR4rCSdeR.jpg"},{"id":71140,"name":"Franco Interlenghi","role":"Mariolino Brusco","profile":"https://image.tmdb.org/t/p/original/8YPUzX1WAkQxK8m6OGbiNO41Jd7.jpg"},{"id":119431,"name":"Saro Urzì","role":"Brusco","profile":"https://image.tmdb.org/t/p/original/wp88yz8T1TJcw5egiDu1m5a302D.jpg"},{"id":1303003,"name":"Charles Vissières","role":"Il Vescovo","profile":"https://image.tmdb.org/t/p/original/du5UJygl98KIUwWeaBVc4TtFf14.jpg"},{"id":37462,"name":"Sylvie","role":"Signora Cristina","profile":"https://image.tmdb.org/t/p/original/oR0l90QnwjZOxwSUyBGgcHepN8D.jpg"},{"id":1189934,"name":"Clara Auteri Pepe","role":"Clara Auteri","profile":"https://image.tmdb.org/t/p/original/cpHE7DpQXxGT9drvwNZg9Ly6D90.jpg"},{"id":1303018,"name":"Italo Clerici","role":"Barchini"},{"id":225189,"name":"Peppino De Martino","role":"Assessore","profile":"https://image.tmdb.org/t/p/original/nNVOIiSfAnBe06VxpB1IefD76Sc.jpg"},{"id":543087,"name":"Carlo Duse","role":"Il Bigio","profile":"https://image.tmdb.org/t/p/original/rxYptmtR0bFGsJdbvm7DHC72zYp.jpg"},{"id":932521,"name":"Manuel Gary","role":"Il delegato","profile":"https://image.tmdb.org/t/p/original/eq2fm8EB23cIuOkzLvn2qvJI4my.jpg"},{"