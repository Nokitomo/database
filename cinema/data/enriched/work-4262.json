/original/syBIYCKqgBXXszxnsFtfIEMtKx.jpg"},{"id":7809,"name":"Ralf Müller","role":"Prisoner Nr. 15"},{"id":7808,"name":"Danny Richter","role":"Prisoner Nr. 21"},{"id":7807,"name":"Polat Dal","role":"Prisoner Nr. 40"},{"id":7806,"name":"Stephan Szasz","role":"Prisoner Nr. 53","profile":"https://image.tmdb.org/t/p/original/d2Ut1kQQrxRkdEQBkT0l1MSYaCM.jpg"},{"id":7810,"name":"Markus Rudolf","role":"Prisoner Nr. 74"},{"id":7812,"name":"Thorsten Dersch","role":"Prisoner Nr. 86"},{"id":7813,"name":"Sven Grefer","role":"Prisoner Nr. 94"},{"id":7819,"name":"Jacek Klimontko","role":"Gläser"},{"id":7820,"name":"Markus Klauk","role":"Stock"},{"id":7821,"name":"Ralph Püttmann","role":"Amandy"},{"id":7828,"name":"André Jung","role":"Ziegler","profile":"https://image.tmdb.org/t/p/original/cdpmnYjpRZ8mecM24K5CVDo7c1.jpg"},{"id":7829,"name":"Uwe Rohde","role":"Hans","profile":"https://image.tmdb.org/t/p/original/rwWuVTpQ71Pttt4XP9QSY7IsGRF.jpg"},{"id":7830,"name":"Heiner Lauterbach","role":"Dennis (voice)","profile":"https://image.tmdb.org/t/p/original/AuDVCHI4myGKsjVzUCXrVKIqu8x.jpg"},{"id":5125,"name":"Fatih Akin","role":"Cab Driver (voice)","profile":"https://image.tmdb.org/t/p/original/jqxUPrXlsAoNPY2GiZaZXUjFbTH.jpg"},{"id":7831,"name":"Christiane Gerboth","role":"Newscaster (voice)"},{"id":7826,"name":"Tristan Vostry","role":"Assistant"},{"id":5652,"name":"Klaus Spinnler","role":"Assistant"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","title":"The Experiment - Cercasi cavie umane","overview":"Stavano solo cercando un modo per fare soldi velocemente. Ora stanno solo cercando un modo per restare vivi. Tutto è cominciato come un esperimento nel nome della scienza. 20 uomini hanno scelto di rinunciare ai propri diritti civili per due settimane in cambio di denaro.","tagline":"Cercasi cavie umane."},{"language":"en-US","title":"The Experiment","overview":"20 volunteers agree to take part in a seemingly well-paid experiment advertised by the university. It is supposed to be about aggressive behavior in an artificial prison situation. A journalist senses a story behind the ad and smuggles himself in among the test subjects. They are randomly divided into prisoners and guards. What seems like a game at the beginning soon turns into bloody seriousness.","tagline":"You are invited to participate"},{"language":"de-DE","overview":"Der Taxifahrer Tarek ist einer von 20 Männern, die an einer zweiwöchigen Aggressionsstudie teilnehmen. Bei dieser werden die Forschungsobjekte in einen überwachten Zellentrakt untergebracht und vorab in Wärter und Gefangene eingeteilt. Damit soll ermittelt werden, wie die Testpersonen auf die neuen Umstände reagieren. Anfangs läuft alles nach den Vorstellungen der Wissenschaftler, doch schon sehr bald fangen die als Wärter eingeteilten Probanden an, ihre Vormachtstellung auszunutzen und schikanieren die Gefangenen. Zu schnell entwickelt sich die Lage in einen Ausnahmezustand, der den Experten keine Möglichkeit zum Eingreifen mehr lässt. Aus dem Spiel ist nun bitterer Ernst geworden und nun wird auch nicht mehr vor Mord zurückgeschreckt.","tagline":"Bist du stark genug?"}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/p2WxrilRflcFL2NdQjaGbXecdEt.jpg","background":"https://image.tmdb.org/t/p/original/uxMcyp2U1SKpAK3gOMkBugCxn0X.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":575,"type":"movie","originalLanguage":"de-DE","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/p2WxrilRflcFL2NdQjaGbXecdEt.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/p2WxrilRflcFL2NdQjaGbXecdEt.jpg","language":"it","width":800,"height":1200},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/p2WxrilRflcFL2NdQjaGbXecdEt.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/p2WxrilRflcFL2NdQjaGbXecdEt.jpg","la