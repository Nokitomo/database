time":"68m"},"keywords":[],"networks":[{"id":160,"name":"TBS","logo":"https://image.tmdb.org/t/p/original/lUACMATs6jcscXIrzNCQzbvNVN5.png"}],"socialLinks":{},"cast":[{"id":1098600,"name":"Hiroki Hasegawa","role":"Akizumi Masaki","profile":"https://image.tmdb.org/t/p/original/aWfpj9ndyDq2xsSrABRRscAkcaa.jpg"},{"id":1388624,"name":"Takumi Kitamura","role":"Akamine Shuto","profile":"https://image.tmdb.org/t/p/original/hBt2HLj6khCESyaRl7ga8ifilsV.jpg"},{"id":2054290,"name":"Mayu Hotta","role":"Shinomiya Asuka","profile":"https://image.tmdb.org/t/p/original/hm8sFX6rXTuA7czOSruFxSz1gHM.jpg"},{"id":1029718,"name":"Yuko Oshima","role":"Shiraki Rin","profile":"https://image.tmdb.org/t/p/original/70brQ4Zjaz4oW1pYIP8ZHuM6D7J.jpg"},{"id":72764,"name":"Yoshino Kimura","role":"Midorikawa Ayuka","profile":"https://image.tmdb.org/t/p/original/fI0ALURUC3CO96fEb33f4iijlF.jpg"},{"id":149405,"name":"Mansai Nomura","role":"Datehara Taisuke","profile":"https://image.tmdb.org/t/p/original/2ckdbJKCF7hE1rE2J4364gdklOh.jpg"},{"id":1384549,"name":"Takanori Iwata","role":"Hiyama Keita","profile":"https://image.tmdb.org/t/p/original/c4YQfIROreyJBLja3zzhZPrYTwi.jpg"},{"id":1502396,"name":"Misuzu Kanno","role":"Seko Narumi","profile":"https://image.tmdb.org/t/p/original/eyUf1JwpT1YEhotYerL0J6de1Tw.jpg"},{"id":72819,"name":"Yasufumi Hayashi","role":"Aoyama Kenji","profile":"https://image.tmdb.org/t/p/original/1kmG0vtAMYH83l2lpEJmrYofX6r.jpg"},{"id":4142284,"name":"Hana Kondo","role":"Makino Saya","profile":"https://image.tmdb.org/t/p/original/4NgpDfkIVlXpShjOvHLxY1e8T7Z.jpg"},{"id":3627494,"name":"Coki Yamashita","role":"Kikuchi Daiki","profile":"https://image.tmdb.org/t/p/original/j7C9n4VQo5hooPxjUssduvSCbcm.jpg"},{"id":3829772,"name":"Ryo Tamaki","role":"Todo Aki","profile":"https://image.tmdb.org/t/p/original/ycolSKVtWf6Exin1GVC6SHSP9HY.jpg"},{"id":553939,"name":"Naoto Ogata","role":"Shimizu Yusaku","profile":"https://image.tmdb.org/t/p/original/9vAzFrvZQORqxHK9flS9cRIhOMb.jpg"},{"id":125943,"name":"Naohito Fujiki","role":"Kurata Isao","profile":"https://image.tmdb.org/t/p/original/itfh6sPqDHhYdc4roDaz7s3YV4U.jpg"},{"id":235147,"name":"Yoshihiko Hosoda","role":"Matsunaga Rihito","profile":"https://image.tmdb.org/t/p/original/dPG05qmZNGiIhcldQb0Cc9hfiDM.jpg"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"en-US","title":"Antihero","overview":"Japan has a conviction rate of 99.9% for criminal cases that go to trial. A lawyer (Hiroki Hasegawa) is able to defeat those odds and obtain an acquittal for his client, even though there's conclusive evidence that says otherwise. Sometimes, due to minor things, good and evil can switch sides and good people can become bad people."},{"language":"ja-JP","title":"アンチヒーロー","overview":"有罪率99.9%と言われる日本の刑事裁判で、どれほど不利な証拠がそろっている犯罪者でも、依頼人のために無罪を勝ち取る\"アンチ\"な弁護士の活躍を描く。\n\n長谷川博己主演！“アンチ”な弁護士は正義か悪か？新たなヒーローが常識を覆す、逆転パラドックスエンターテインメントが始動！長谷川が演じるのは犯罪者である証拠が１００％揃っていても無罪を勝ち取る、「殺人犯をも無罪にしてしまう」“アンチ”な弁護士。ヒーローとは言い難い、限りなくダークで危険な人物だ。「弁護士ドラマ」という枠組みを超え、長谷川が演じるアンチヒーローを通して“正義とは果たして何なのか？”“世の中の悪とされていることは、本当に悪いことなのか？”を問いかける。スピーディーな展開で次々に常識が覆されていく完全オリジナルストーリー！そのほか共演には、長谷川演じる主人公の事務所で働く同僚弁護士役に北村匠海と堀田真由、パラリーガル役に大島優子、東京地検の有能な検事役に木村佳乃、剛腕検事正役に野村萬斎ら豪華キャストが顔を揃える！"}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/WzBXCQjcdm1zEsYVZPIA1KPi64.jpg","background":"https://image.tmdb.org/t/p/original/A7HHloMWQlub6kWyR7CwQcwRDtn.jpg","seasons":[{"seasonNumber":1,"name":{"value":"Stagione 1","language":"it-IT"},"year":2024,"episodeCount":10,"poster":"https://image.tmdb.org/t/p/original/WzBXCQjcdm1zEsYVZPIA1KPi64.jpg","posters":[],"backgrounds":[],"sourceUrl":"https://www.themoviedb.org/tv/249928/season/1"}],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":249928,"type":"tv","originalLanguage":"ja-JP","series":{"poster":{"it":{"status":"missing","candidates":[]},"en":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/or