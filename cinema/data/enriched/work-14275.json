amingunity"}],"episodeMappingUncertain":false,"seasons":[],"provenance":{},"warnings":[],"externalIdsEvidence":{"wikidata":{"source":"wikidata","sourceUrl":"https://www.wikidata.org/wiki/Q22970530","wikidataId":"Q22970530","tmdbId":166428,"type":"movie","imdbId":"tt2386490","tvdbId":34}},"externalMedia":{"tmdb":{"source":"tmdb-api","id":166428,"type":"movie","sourceUrl":"https://www.themoviedb.org/movie/166428","fetchedAt":"2026-11-08T03:28:14.082Z","originalLanguage":"en-US","title":{"value":"Dragon Trainer - Il mondo nascosto","language":"it-IT"},"originalTitle":"How to Train Your Dragon: The Hidden World","overview":{"value":"Hiccup ha preso il posto del padre Stoyck come leader di Berk, nonostante del leader debba ancora trovare la stoffa, mentre Sdentato è il nuovo Alfa, il drago da cui tutti gli altri draghi si lasciano guidare. Uomini e draghi convivono, dunque, felicemente e scomodamente, ma l'utopia ha i giorni contati: Grimmel il Grifagno, assetato killer di Furie Buie, è sulle tracce di Sdentato e ha stretto un patto con i nemici di Hiccup promettendo loro di riportare in gabbia ogni drago in libertà. Non resta che partire, lasciare la propria terra, alla ricerca di quel mondo nascosto di cui vaneggiava Stoyck, per scoprire se si tratti davvero del paradiso dei draghi o soltanto di una leggenda da marinai.","language":"it-IT"},"tagline":{"value":"Fly on your own. Find your way home.","language":"en-US"},"releaseDate":"2019-01-03","status":"Released","rating":7.749,"ratingCount":7366,"genres":["Animazione","Famiglia","Avventura"],"countries":["United States of America"],"facts":{"Runtime":"104m"},"keywords":[],"networks":[],"socialLinks":{},"cast":[{"id":449,"name":"Jay Baruchel","role":"Hiccup (voice)","profile":"https://image.tmdb.org/t/p/original/1GYJeQzPcY9Pfmc3FFsBwClkCv7.jpg"},{"id":59174,"name":"America Ferrera","role":"Astrid (voice)","profile":"https://image.tmdb.org/t/p/original/7q9uUWnaIjveX8DTU2lcA7mA3dp.jpg"},{"id":1164,"name":"F. Murray Abrah