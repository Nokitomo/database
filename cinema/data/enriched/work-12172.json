erta sincerità. All'attivo del regista c'è la sagacia con cui ha saputo esprimere l'erotismo di Travolta. Coreografia di Lester Wilson, musiche dei Bee Gees. Stallone diresse il fiacco seguito Staying Alive.","language":"it-IT"},"tagline":{"value":"Where do you go when the record is over...","language":"en-US"},"releaseDate":"1977-12-16","status":"Released","rating":6.737,"ratingCount":2177,"genres":["Dramma"],"countries":["United States of America"],"facts":{"Runtime":"118m"},"keywords":[],"networks":[],"socialLinks":{},"cast":[{"id":8891,"name":"John Travolta","role":"Tony Manero","profile":"https://image.tmdb.org/t/p/original/ap8eEYfBKTLixmVVpRlq4NslDD5.jpg"},{"id":67787,"name":"Karen Lynn Gorney","role":"Stephanie","profile":"https://image.tmdb.org/t/p/original/180L4tV9AvFM4JzWmHyKEsmTZOv.jpg"},{"id":62014,"name":"Barry Miller","role":"Bobby C.","profile":"https://image.tmdb.org/t/p/original/jClFwEE3TJqOi8yyuD1c6o9ldlr.jpg"},{"id":67788,"name":"Joseph Cali","role":"Joey","profile":"https://image.tmdb.org/t/p/original/qYf43JOmvNR5SausEtyaXIjlqdt.jpg"},{"id":174563,"name":"Paul Pape","role":"Double J.","profile":"https://image.tmdb.org/t/p/original/7lBHhavJ6wpLoMl9FybfLzKzVQy.jpg"},{"id":1216751,"name":"Donna Pescow","role":"Annette","profile":"https://image.tmdb.org/t/p/original/4GblWAvSkQ7d6UXYXbNBBISUiW.jpg"},{"id":171758,"name":"Bruce Ornstein","role":"Gus","profile":"https://image.tmdb.org/t/p/original/bh4Dx7x9AREbtG1CFhea9HaDQKO.jpg"},{"id":20972,"name":"Julie Bovasso","role":"Flo","profile":"https://image.tmdb.org/t/p/original/q0VH5NSnsHnhgZxe6SufKQ63Y6Q.jpg"},{"id":119054,"name":"Martin Shakar","role":"Frank, Jr.","profile":"https://image.tmdb.org/t/p/original/yDxoVs2okrsXcmqX4LER0eLeZhy.jpg"},{"id":118132,"name":"Sam Coppola","role":"Fusco","profile":"https://image.tmdb.org/t/p/original/wVFzWq1Nq3jdKSpZ2LPdKNMmooi.jpg"},{"id":951077,"name":"Nina Hansen","role":"Grandmother"},{"id":1191736,"name":"Lisa Peluso","role":"Linda"},{"id":59695,"name":"Denny Dill