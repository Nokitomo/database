riginal/5JZWivkEYm8IfuWa1C1FO87jN9v.jpg"},{"id":1164093,"name":"Maxime Allard","role":"Journaliste Fafard","profile":"https://image.tmdb.org/t/p/original/wr0K1IziHQ8etZjy4Ujhr4dpNfM.jpg"},{"id":1293499,"name":"Garry Gagnon","role":"Caméraman Fafard"},{"id":1628409,"name":"Michel-André Cardin","role":"Journaliste chalet","profile":"https://image.tmdb.org/t/p/original/aXTnWVGOZsbi3NS2yzhPmtZWZ7o.jpg"},{"id":1173449,"name":"Léa-Marie Cantin","role":"Femme de Mercure","profile":"https://image.tmdb.org/t/p/original/ipRkiMtlFcx2qVxWgHmYJIdsi5B.jpg"},{"id":2152702,"name":"Vlace Samar","role":"Frédéric 8 ans","profile":"https://image.tmdb.org/t/p/original/AaH1v1Gd74EFfdcNAAJueyO8enA.jpg"},{"id":1024250,"name":"Jean-François Boudreau","role":"Père Laurie","profile":"https://image.tmdb.org/t/p/original/zl5JueMb8AxrWY96XZwjR1mFOk7.jpg"},{"id":1359660,"name":"Amélie Chérubin-Soulières","role":"Mère Laurie","profile":"https://image.tmdb.org/t/p/original/5C15a1ZVZgrdgF6088YVdx4yJTQ.jpg"},{"id":1031978,"name":"Yves Bélanger","role":"Père de Marion","profile":"https://image.tmdb.org/t/p/original/uknvpl2oWPlgLfYLb3kQDYguZUx.jpg"},{"id":142775,"name":"Marika Lhoumeau","role":"Mère de Marion","profile":"https://image.tmdb.org/t/p/original/clDLghTwUIhgOdDs1Y2AcTtTh3A.jpg"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"en-US","title":"Seven Days","overview":"Like many happy people, Bruno Hamel is leading an uneventful life until one afternoon, when his daughter is raped and murdered. When the murderer is arrested, a terrible project germinates in Bruno's darkened mind. He plans to capture the \"monster\" and make him pay for his crime.","tagline":"Justice is blind. So is vengence."},{"language":"fr-FR","title":"Les 7 jours du talion","overview":"Bruno Hamel, il a trente-huit ans et il est chirurgien. Avec sa petite famille – Sylvie, sa conjointe, et Jasmine, sa fille de huit ans, il habite Drummondville et, comme tous les gens heureux, il n'a pas vraiment d'histoire. Jusqu'à ce que Jasmine, par un bel après-midi d'automne, soit violée et assassinée. Dès lors, l'univers de la famille Hamel bascule. Mais lorsque la police arrête le meurtrier, un terrible projet germe dans l'esprit enténébré de Bruno, il va s'emparer du monstre et lui faire payer ce qu'il a fait à sa petite fille. Le jour de la comparution du meurtrier, Hamel, qui a minutieusement préparé son coup, kidnappe le monstre, puis transmet aux autorités policières un message laconique, celui qui a violé et tué ma petite fille va souffrir pendant sept jours, après quoi il sera exécuté. Ensuite seulement, je me rendrai."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/9jKnm8gxSdVm2JObLy5MdpYd1fk.jpg","background":"https://image.tmdb.org/t/p/original/1FIyqEY0Vz4GX3YYnyoZJQBnmXL.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":39681,"type":"movie","originalLanguage":"fr-FR","series":{"poster":{"it":{"status":"missing","candidates":[]},"en":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/ag662hfmscOMYuVXxcPzAcDfIJY.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/ag662hfmscOMYuVXxcPzAcDfIJY.jpg","language":"en","width":838,"height":1257},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/ag662hfmscOMYuVXxcPzAcDfIJY.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/ag662hfmscOMYuVXxcPzAcDfIJY.jpg","language":"en","width":838,"height":1257},{"type":"poster","url":"https://image.tmdb.org/t/p/original/eKIDygJ4RoTGBD3dKSRgdcsNZWt.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/eKIDygJ4RoTGBD3dKSRgdcsNZWt.jpg","language":"en","width":1067,"height":1600},{"type":"poster","url":"https://image.tmdb.org/t/p/original/l6EWeUqG7k7P00DfE9QsxOCcR2t.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/l6EWeUqG7k7P00DfE9QsxOCcR2t.jpg","language":"en","width":1000,"height":1500},{"type":"poster","url":