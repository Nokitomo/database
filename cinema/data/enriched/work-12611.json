bId":811,"type":"movie","imdbId":"tt0067756","tvdbId":6772}},"externalMedia":{"tmdb":{"source":"tmdb-api","id":811,"type":"movie","sourceUrl":"https://www.themoviedb.org/movie/811","fetchedAt":"2026-11-07T22:14:01.085Z","originalLanguage":"en-US","title":{"value":"2002 - La seconda odissea","language":"it-IT"},"originalTitle":"Silent Running","overview":{"value":"Sulla gigantesca astronave Valley Forge viaggia quel che resta della vegetazione terrestre dopo che il pianeta è stato devastato dalle guerre nucleari. Quando il comandante riceve l'ordine di distruggere tutto, si ribella e, uccisi i compagni, guida l'astronave oltre gli anelli di Saturno. Diretto dal realizzatore degli effetti speciali di 2001: Odissea nello spazio, esordiente nella regia, (sceneggiato, tra gli altri da Michael Cimino), è, pur con ingenuità e pesantezze didattiche, un buon esempio di cinema fantaecologico e apocalittico. Quasi un monologo per Dern, aiutato nel suo lavoro da simpatici robot. Bella colonna musicale di Peter Schickele.","language":"it-IT"},"tagline":{"value":"Compagni straordinari in un'avventura incredibile... che viaggia oltre l'immaginazione!","language":"it-IT"},"releaseDate":"1972-03-09","status":"Released","rating":6.4,"ratingCount":682,"genres":["Fantascienza","Avventura","Dramma"],"countries":["United States of America"],"facts":{"Runtime":"89m"},"keywords":[],"networks":[],"socialLinks":{},"cast":[{"id":6905,"name":"Bruce Dern","role":"Freeman Lowell","profile":"https://image.tmdb.org/t/p/original/5RKGcElQiFZh4Mu9gInyUhr9Uu7.jpg"},{"id":12121,"name":"Cliff Potts","role":"John Keenan","profile":"https://image.tmdb.org/t/p/original/cJHtaOUL1OQ2ou9rcadNk5PTfEf.jpg"},{"id":12122,"name":"Ron Rifkin","role":"Marty Barker","profile":"https://image.tmdb.org/t/p/original/fj2u4t6nG0HGYFtRVDUTNbUtEtl.jpg"},{"id":12123,"name":"Jesse Vint","role":"Andy Wolf","profile":"https://image.tmdb.org/t/p/original/h87WgEkcFDjXFmQ5lQ8yYiC3cmI.jpg"},{"id":12125,"name":"Mark Persons","role":"Grey Drone #1 “Dewey”","profile":"https://image.tmdb.org/t/p/original/1hfA4mYMGreFCIgYTh7IpEDCSna.jpg"},{"id":12124,"name":"Steven Brown","role":"Orange Drone #2 “Huey”","profile":"https://image.tmdb.org/t/p/original/e4EJPcFaZFu3RdcRFtTPqsVbFy2.jpg"},{"id":12126,"name":"Cheryl Sparks","role":"Orange Drone #2 “Huey”","profile":"https://image.tmdb.org/t/p/original/lWGeTNJU1QXgrbQscGmXph12zBF.jpg"},{"id":3918624,"name":"Larry Whisenhunt","role":"Green Drone #3 “Louie”","profile":"https://image.tmdb.org/t/p/original/d4Qvgxx2FhqoB72F7aMFEJO06S1.jpg"},{"id":121144,"name":"Joseph Campanella","role":"Neal - Berkshire’ Captain (voice/uncredited)","profile":"https://image.tmdb.org/t/p/original/o6A0IZkjcDNDVBTFCVLsdySz3w3.jpg"},{"id":100582,"name":"Roy Engel","role":"Anderson (voice/uncredited)"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","title":"2002 - La seconda odissea","overview":"Sulla gigantesca astronave Valley Forge viaggia quel che resta della vegetazione terrestre dopo che il pianeta è stato devastato dalle guerre nucleari. Quando il comandante riceve l'ordine di distruggere tutto, si ribella e, uccisi i compagni, guida l'astronave oltre gli anelli di Saturno. Diretto dal realizzatore degli effetti speciali di 2001: Odissea nello spazio, esordiente nella regia, (sceneggiato, tra gli altri da Michael Cimino), è, pur con ingenuità e pesantezze didattiche, un buon esempio di cinema fantaecologico e apocalittico. Quasi un monologo per Dern, aiutato nel suo lavoro da simpatici robot. Bella colonna musicale di Peter Schickele.","tagline":"Compagni straordinari in un'avventura incredibile... che viaggia oltre l'immaginazione!"},{"language":"en-US","overview":"After the entire flora goes extinct, ecologist Lowell maintains a greenhouse aboard a space station for the future with his android companions. However, he rebels after being ordered to destroy the greenhouse in favor of carrying cargo, a decision that puts him at