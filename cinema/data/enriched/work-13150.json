år höra om detta och får en plötslig impuls att skriva till sin mor och bjuda henne till sig. I huset finns också en annan dotter, Helena, svårt handikappad, som den äldsta dottern sköter om sedan två år. Detta vet inte modern om. Hon tror att Helena vårdas på ett sjukhus, där hon lämnat henne."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/gXZw5FUmFvzSBBPbjfUrP8FKK2F.jpg","background":"https://image.tmdb.org/t/p/original/ozNapY9iczRr6FYKRbLLM00szCW.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":12761,"type":"movie","originalLanguage":"sv-SV","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/gXZw5FUmFvzSBBPbjfUrP8FKK2F.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/gXZw5FUmFvzSBBPbjfUrP8FKK2F.jpg","language":"it","width":1400,"height":2100},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/gXZw5FUmFvzSBBPbjfUrP8FKK2F.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/gXZw5FUmFvzSBBPbjfUrP8FKK2F.jpg","language":"it","width":1400,"height":2100},{"type":"poster","url":"https://image.tmdb.org/t/p/original/xltLPyqOjVkfyDONauaXIO6FeOH.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/xltLPyqOjVkfyDONauaXIO6FeOH.jpg","language":"it","width":500,"height":750},{"type":"poster","url":"https://image.tmdb.org/t/p/original/gsdNmKBGaZENT605K1SwGBURPrs.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/gsdNmKBGaZENT605K1SwGBURPrs.jpg","language":"it","width":2000,"height":3000}]},"en":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/6beNbtCXv3GkzHkxkGYf38ib7v8.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/6beNbtCXv3GkzHkxkGYf38ib7v8.jpg","language":"en","width":1280,"height":1920},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/6beNbtCXv3GkzHkxkGYf38ib7v8.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/6beNbt