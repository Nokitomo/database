inal/669Q5NyXhjs0sfyl5KffNA3OJca.jpg"},{"id":2378493,"name":"Franck Muon","role":"Member of the Belgian gang","profile":"https://image.tmdb.org/t/p/original/zuyFL1VtXTMWywbjfvYIaoWQ5Ig.jpg"},{"id":2192962,"name":"William Prunck","role":"Member of the Belgian gang","profile":"https://image.tmdb.org/t/p/original/vtsN0Ro5LZNLOAUz84BArkjJ5U8.jpg"},{"id":2378494,"name":"Aude Denis","role":"Worker at La Belle Mer"},{"id":2330203,"name":"Audrey Chapon","role":"Worker at La Belle Mer"},{"id":2378495,"name":"Elléonore Lemattre","role":"Worker at La Belle Mer"},{"id":2180804,"name":"Eric Beauchamp","role":"Doctor","profile":"https://image.tmdb.org/t/p/original/2jPBNNlRR3bupEcOdNNEWsM16Ij.jpg"},{"id":2378498,"name":"Emmanuelle Fernandez","role":"Professor","profile":"https://image.tmdb.org/t/p/original/cB4gGt973OKKvIwSGodHslORYkg.jpg"},{"id":238395,"name":"Manu Layotte","role":"Mechanic","profile":"https://image.tmdb.org/t/p/original/wRiIYvyJxnFBpGKEZKZT3s9UPvr.jpg"},{"id":2378499,"name":"Pascal Cochez","role":"Boss"},{"id":2378500,"name":"Hervé Mahieux","role":"Owner","profile":"https://image.tmdb.org/t/p/original/5K1FiQ7IHUqWqVBhIwL1H1RIU4f.jpg"},{"id":1766366,"name":"Alain Grellier","role":"Retiree"},{"id":1671403,"name":"Michel Nabokoff","role":"Advisor (credit only)","profile":"https://image.tmdb.org/t/p/original/eOVfFjiWVgaV6cidbSUzH6kXxCZ.jpg"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","title":"Ribelli","overview":"Riunite dall'omicidio accidentale del loro viscido caposquadra, Sandra, Marilyn e Nadine, tre operaie di una azienda di inscatolamento di pesce, scoprono una borsa piena di denaro vicino al corpo del morto. Disperatamente bisognose di soldi, decidono di rubare la borsa e di sbarazzarsi del cadavere inscatolandolo. Quello che dovrebbe sulla carta essere un piano perfetto si trasforma in caos quando si presenteranno i gangster a cui il bottino apparteneva e le scatolette finiranno consegnate a un'organizzazione benefica per la distribuzione."},{"language":"en-US","title":"Rebels","overview":"Sandra, a young woman forced to leave the south of France to flee a violent husband. Without attachment, she returned to Boulogne-sur-Mer, the city of her childhood which she left almost 15 years ago. She finds her mother there and a world she left behind. Without money, she is hired in a fish cannery where she befriends two workers. But one day, one of her colleagues tackles her insistently, she defends herself and kills him accidentally."},{"language":"fr-FR","overview":"Sans boulot ni diplôme, Sandra, ex miss Pas-de-Calais, revient s'installer chez sa mère à Boulogne-sur-Mer après 15 ans sur la Côte d'Azur. Embauchée à la conserverie locale, elle repousse vigoureusement les avances de son chef et le tue accidentellement. Deux autres filles ont été témoins de la scène. Alors qu'elles s'apprêtent à appeler les secours, les trois ouvrières découvrent un sac plein de billets dans le casier du mort. Une fortune qu'elles décident de se partager. C'est là que leurs ennuis commencent..."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/9TYRqzYZvra92VOUstzNMmBkTnI.jpg","background":"https://image.tmdb.org/t/p/original/tdINmzvmq0en7FprqiE3STwM9hQ.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":569814,"type":"movie","originalLanguage":"fr-FR","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/9TYRqzYZvra92VOUstzNMmBkTnI.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/9TYRqzYZvra92VOUstzNMmBkTnI.jpg","language":"it","width":1000,"height":1500},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/9TYRqzYZvra92VOUstzNMmBkTnI.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/9TYRqzYZvra92VOUstzNMmBkTnI.jpg","language":"it","width":1000,"height":1500},{"type":"poster","url":"https://image.tmdb.org/t/p/orig