,"role":"Tuk-tuk driver","profile":"https://image.tmdb.org/t/p/original/wUuuudG672L7XHLSkj62r3L5uhv.jpg"},{"id":1371738,"name":"Jean-Philippe Lejeune","role":"Delivery man","profile":"https://image.tmdb.org/t/p/original/fYIRC29FAb5sqwCkMv4WhEXzhwX.jpg"},{"id":1186852,"name":"Mathias Malzieu","role":"Self - Dionysos","profile":"https://image.tmdb.org/t/p/original/crBkNcM8zOuFfbWbWTA4xNDQ05p.jpg"},{"id":2413919,"name":"Mike Ponton","role":"Self - Dionysos","profile":"https://image.tmdb.org/t/p/original/nieNdn2atvJFVZrUSBAJodEicDo.jpg"},{"id":2617027,"name":"Stéphan Bertholio","role":"Self - Dionysos","profile":"https://image.tmdb.org/t/p/original/ycnOEqATPlNksNJPltpJ0bnlh3m.jpg"},{"id":2616998,"name":"Eric Serra-Tosio","role":"Self - Dionysos","profile":"https://image.tmdb.org/t/p/original/vdAnf7HVXu9QcErhCBatDoffdjq.jpg"},{"id":2616997,"name":"Élisabet Maistre","role":"Self - Dionysos","profile":"https://image.tmdb.org/t/p/original/jZXyrE5IaSblQJA1J7B80dNTs0o.jpg"},{"id":1400900,"name":"Patrick Leonard","role":"Hospital patient"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","title":"Una sirena a Parigi","overview":"Gaspard Snow è un cantante rock sentimentale che si esibisce nel favoloso cabaret-café parigino Flowerburger, residuo di un mondo fantasioso ed eccentrico, romantico e sognatore, che fuori da quelle quattro mura non esiste più. Per giunta gli affari vanno male e la madre di Gaspard, anima e ispiratrice del locale, è morta, lasciando il marito e il figlio dentro un lutto che non sanno superare. Una sera, però, uscendo da lì, Gaspard trova sulla riva della Senna una sirena ferita e decide di portarla a casa e sistemarla nella propria vasca da bagno per curarla. Lula però lo avverte: il suo canto ammalia e uccide chi l'ascolta. E infatti alcuni uomini cominciano a cadere, stecchiti.","tagline":"Un amore profondo e impossibile"},{"language":"en-US","title":"A Mermaid in Paris","overview":"A man rescues a mermaid in Paris and slowly falls in love with her.","tagline":"Love is possible when it's impossible."},{"language":"fr-FR","overview":"Crooner au cœur brisé, Gaspard s’était juré de ne plus retomber amoureux. Quant à Lula, jolie sirène, elle n’a que le chant pour se défendre des hommes, en faisant s’emballer leur cœur jusqu’à l’explosion. Lorsque la Seine en crue vient déposer Lula au pied du Flowerburger, la péniche-cabaret où chante Gaspard, c’est un mini-tsunami qui va bouleverser leur existence. Lui, l’homme qui a souffert d’avoir trop aimé, et elle, la créature qui n’a jamais connu l’amour, vont apprendre à se connaître. Et à chanter d’une même voix…","tagline":"L'amour devient possible quand il est impossible."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/szTiYrNUpyJNzkysxYS0GvOXgsF.jpg","background":"https://image.tmdb.org/t/p/original/x5bjSUQ8RnbqLn7PBwP24tr4VMB.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":600479,"type":"movie","originalLanguage":"fr-FR","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/szTiYrNUpyJNzkysxYS0GvOXgsF.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/szTiYrNUpyJNzkysxYS0GvOXgsF.jpg","language":"it","width":667,"height":1000},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/szTiYrNUpyJNzkysxYS0GvOXgsF.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/szTiYrNUpyJNzkysxYS0GvOXgsF.jpg","language":"it","width":667,"height":1000},{"type":"poster","url":"https://image.tmdb.org/t/p/original/w9QRfQQZNNqbkIZstGYGU8t7Jd4.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/w9QRfQQZNNqbkIZstGYGU8t7Jd4.jpg","language":"it","width":1500,"height":2250},{"type":"poster","url":"https://image.tmdb.org/t/p/original/2ybP2BpvAWnCrHsbumR9nqJD4De.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/2ybP2BpvAWnCrHsbumR9nqJD4De.jpg","language":"it","width":1500,