omunicazione, dell'emozione. Esplicita denuncia dell'ignavia dell'ONU, delle vergogne della politica europea, dell'indifferenza comoda di tanti di noi in Europa. Meglio la 1ª parte che la 2ª.","language":"it-IT"},"tagline":{"value":"To get the story, they’ll risk everything.","language":"en-US"},"releaseDate":"1997-05-09","status":"Released","rating":6.5,"ratingCount":130,"genres":["Guerra","Dramma","Storia"],"countries":["United Kingdom","United States of America"],"facts":{"Runtime":"103m"},"keywords":[],"networks":[],"socialLinks":{},"cast":[{"id":8435,"name":"Stephen Dillane","role":"Michael Henderson","profile":"https://image.tmdb.org/t/p/original/qjIa6pXD4Z7nL7nH2LxyHDfxNgC.jpg"},{"id":57755,"name":"Woody Harrelson","role":"Flynn","profile":"https://image.tmdb.org/t/p/original/igxYDQBbTEdAqaJxaW6ffqswmUU.jpg"},{"id":3141,"name":"Marisa Tomei","role":"Nina","profile":"https://image.tmdb.org/t/p/original/5NCCKQooVCQD36R6JL3a1hOeBVn.jpg"},{"id":5725,"name":"Goran Višnjić","role":"Risto Bavić","profile":"https://image.tmdb.org/t/p/original/2jFpq46QPjCbRmmGYdW9WSVC47W.jpg"},{"id":77603,"name":"Emira Nušević","role":"Emira"},{"id":17258,"name":"Kerry Fox","role":"Jane Carson","profile":"https://image.tmdb.org/t/p/original/fThcQKAsWFIIhQND8prUJnHdbni.jpg"},{"id":34715,"name":"James Nesbitt","role":"Gregg","profile":"https://image.tmdb.org/t/p/original/lQiGZcwUXbCqpF055Ia5jxdZ2Ma.jpg"},{"id":18017,"name":"Emily Lloyd","role":"Annie McGee","profile":"https://image.tmdb.org/t/p/original/2OrKRl9Vel31ihbeMYb4Z5XZvGF.jpg"},{"id":1866071,"name":"Igor Džambazov","role":"Jacket"},{"id":77605,"name":"Gordana Gadžić","role":"Mrs. Savić"},{"id":18066,"name":"Juliet Aubrey","role":"Helen Henderson","profile":"https://image.tmdb.org/t/p/original/puwE4ofyI8OWXXjpoJNyGASdFiR.jpg"},{"id":77606,"name":"Dražen Šivak","role":"Željko"},{"id":77607,"name":"Vesna Orel","role":"Munira"},{"id":77608,"name":"Davor Janjić","role":"Dragan","profile":"https://image.tmdb.org/t/p/original/4opzbmS0