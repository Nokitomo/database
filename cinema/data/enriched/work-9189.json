 recherche de ses parents, scientifiques disparus, en compagnie de Darwin, son chat parlant, et de Julius, jeune gredin des rues. Ce trio devra affronter les dangers et les mystères de ce Monde Truqué. Qui enlève les savants depuis des décennies ? Dans quel sinistre but ?"}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/8bTxUAoDhUGx2lL6KfcoiZNqepM.jpg","background":"https://image.tmdb.org/t/p/original/bALW6bJuN1VW2xRsx49Hy7JIejG.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":340357,"type":"movie","originalLanguage":"fr-FR","series":{"poster":{"it":{"status":"missing","candidates":[]},"en":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/cenqAhHFJRGf08L8rgvHTlFrLuL.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/cenqAhHFJRGf08L8rgvHTlFrLuL.jpg","language":"en","width":1400,"height":2100},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/cenqAhHFJRGf08L8rgvHTlFrLuL.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/cenqAhHFJRGf08L8rgvHTlFrLuL.jpg","language":"en","width":1400,"height":2100},{"type":"poster","url":"https://image.tmdb.org/t/p/original/ogKQ2eK8lJP5KyAptsypEBZwdXy.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/ogKQ2eK8lJP5KyAptsypEBZwdXy.jpg","language":"en","width":2000,"height":3000},{"type":"poster","url":"https://image.tmdb.org/t/p/original/cMPHF30yY8zqvPDxChQnc2KHlXR.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/cMPHF30yY8zqvPDxChQnc2KHlXR.jpg","language":"en","width":614,"height":913},{"type":"poster","url":"https://image.tmdb.org/t/p/original/iSRq0hhvpJYpLD4FQWxFRaseUzC.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/iSRq0hhvpJYpLD4FQWxFRaseUzC.jpg","language":"en","width":1295,"height":1938},{"type":"poster","url":"https://image.tmdb.org/t/p/original/2VLJqthJdHojd867L3tyxnORVmy.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/2VLJqthJdHojd867L3tyxnORVmy.jpg","langua