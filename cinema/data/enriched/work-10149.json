uJgyL.jpg"},{"id":46065,"name":"Taner Birsel","role":"Savcı Nusret","profile":"https://image.tmdb.org/t/p/original/zq4uEMEezi9Nwev5KdVyO5juQ9e.jpg"},{"id":230759,"name":"Ahmet Mümtaz Taylan","role":"Şoför Arap Ali","profile":"https://image.tmdb.org/t/p/original/7BcirImyPmuD8PxMVKPx6xefunW.jpg"},{"id":564271,"name":"Fırat Tanış","role":"Kenan","profile":"https://image.tmdb.org/t/p/original/sUdRJPbSodfUzS8vxGVBnGVCMsP.jpg"},{"id":87224,"name":"Ercan Kesal","role":"Muhtar","profile":"https://image.tmdb.org/t/p/original/krKWIjwR9oDRP3YWET81hsx4SwX.jpg"},{"id":1001772,"name":"Erol Eraslan","role":"Murder Victim Yaşar","profile":"https://image.tmdb.org/t/p/original/g8hmtt08zgHqUqnKGzhMuYk686y.jpg"},{"id":3498408,"name":"Burhan Yıldız","role":"Suspect Ramazan","profile":"https://image.tmdb.org/t/p/original/51fOoffgJC3hZW5gJSlgSjdztJ2.jpg"},{"id":1001777,"name":"Murat Kılıç","role":"Police Officer İzzet","profile":"https://image.tmdb.org/t/p/original/3XCEZgIYMcIItG12nmriVXqqLNC.jpg"},{"id":1001778,"name":"Şafak Karali","role":"Courthouse Clerk Abidin","profile":"https://image.tmdb.org/t/p/original/nwgwzvllJabkkD8oMQ7Z2oFRhqv.jpg"},{"id":1001779,"name":"Emre Şen","role":"Sergeant Önder","profile":"https://image.tmdb.org/t/p/original/82mp2bdj4CMVLl1tE3pRsJCpTaI.jpg"},{"id":928253,"name":"Cansu Demirci","role":"Mukhtar's Daughter Cemile","profile":"https://image.tmdb.org/t/p/original/4EyijgiQDJenrmV4xuaax6FoFWV.jpg"},{"id":2104550,"name":"Uğur Arslanoğlu","role":"Courthouse Driver Tevfik","profile":"https://image.tmdb.org/t/p/original/4C5lZfiTPvmeKc83kHonqc9iWU4.jpg"},{"id":1001781,"name":"Nihan Okutucu","role":"Yaşar's Wife Gülnaz","profile":"https://image.tmdb.org/t/p/original/2S948zcpPDk8ZOcDmoM5LeSHZbX.jpg"},{"id":1001782,"name":"Kubilay Tunçer","role":"Autopsy Technician Şakir","profile":"https://image.tmdb.org/t/p/original/tuyK9ewHfnOBuk4tp2VeKnfUXvL.jpg"},{"id":1001783,"name":"Salih Ünal","role":"Hospital Cook Hamit","profile":"https://image.tmdb.org/t/p/original/nA0DZhSYpiC4nh1hGD28iib5aPw.jpg"},{"id":1001784,"name":"Aziz İzzet Biçici","role":"Restaurant Owner Kazım","profile":"https://image.tmdb.org/t/p/original/aGeUSYQFTa48cFuJ4haqRvXTZkl.jpg"},{"id":1001785,"name":"Celal Acaralp","role":"Pharmacist Saim","profile":"https://image.tmdb.org/t/p/original/mBTkzursOjBETeBW6E7gOEphrk9.jpg"},{"id":1001786,"name":"Mehmet Eren Topçak","role":"Hamam Scrubber"},{"id":1001787,"name":"Ufuk Karali","role":"Hospital Attendant Sıtkı","profile":"https://image.tmdb.org/t/p/original/imr6CHiagRbk3cIz65zagV6EiLk.jpg"},{"id":1001788,"name":"Fevzi Müftüoğlu","role":"1st Digger Hayrettin"},{"id":1001789,"name":"Turgay Kürkçü","role":"2nd Digger Ethem"},{"id":1001790,"name":"Fatih Ereli","role":"Gülnaz's Son Adem"},{"id":1001791,"name":"Hüseyin Bekeç","role":"1st Soldier"},{"id":1001792,"name":"Mehmet Öztürk","role":"2nd Soldier"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","title":"C'era una volta in Anatolia","overview":"Tre auto viaggiano nella notte nella provincia dell’Anatolia. Cercano qualcosa nell’oscurità: ogni collina, ogni albero potrebbero essere il luogo giusto. Sono un commissario con i suoi poliziotti, un procuratore e un medico, conducono il sospettato di un crimine alla ricerca del luogo dove avrebbe sepolto il cadavere. Vagano senza risultati, si fermano a mangiare dal sindaco di un paesino, poi riprendono la ricerca. All’alba trovano il corpo, lo caricano in auto e lo trasportano nella cittadina per farlo riconoscere dalla moglie ed eseguire l’autopsia.","tagline":"Quando sarai padre racconterai ai tuoi figli"},{"language":"en-US","title":"Once Upon a Time in Anatolia","overview":"A group of men set out in search of a dead body in the Anatolian steppes"},{"language":"tr-TR","overview":"Gece bitmek bilmez. Anadolu’nun bozkırında saatlerdir süren bir cinayet soruşturması herkesi yormuştur. Savcı, komiser, jandarma ve doktordan oluşan bir ekip, Kenan’la Ramazan’ın gömdüğü cesedi aramaktadır. Kenan, Yaşar’ı gömerken sarhoş olduğunu, yalnızca top gibi bir ağacı ve bir çeşmeyi hatırladığını söylemiştir. Ceset ya o tepenin ardındadır, ya bu tepenin… Engebeli, yılankavi yolların sırtında iş uzadıkça uzar. Araba farlarının titrek ışığında kuru otlar savrulur, gölgeler büyür, karanlık adım adım koyulaşır. Arap Ali, doktora yaklaşıp “Çoluk çocuk sahibi olunca anlatacak bir hikâyen olur. Fena mı?” der. “Bir zamanlar Anadolu’da, dersin, ücra bir yerde görev yaparken işte başımdan böyle böyle olaylar geçti dersin. Anlatırsın yani masal gibi.”","tagline":"Bozkırın sessizliğinde gömülü kalan tek şey cesetler değildir."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/5RGIjgTlt788OaJTTX8oS51P6AF.jpg","background":"https://image.tmdb.org/t/p/original/213Gdu9zjGsVeWQl6p5gJrBq8n8.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":74879,"type":"movie","originalLanguage":"tr-TR","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/5RGIjgTlt788OaJTTX8oS51P6AF.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/5RGIjgTlt788OaJTTX8oS51P6AF.jpg","language":"it","width":683,"height":1024},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/5RGIjgTlt788OaJTTX8oS51P6AF.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/5RGIjgTlt788OaJTTX8oS51P6AF.jpg","language":"it","width":683,"height":1024},{"type":"poster","url":"https://image.tmdb.org/t/p/original/pQfNoYY9ES0RvKj9zRz1jFS1b2L.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/pQfNoYY9ES0RvKj9zRz1jFS1b2L.jpg","language":"it","width":1000,"height":1500},{"type":"poster","url":"https://image.tmdb.org/t/p/original/49AkCSeQA1MZGDdUULDNhOARclO.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/49AkCSeQA1MZGDdUULDNhOARclO.jpg","language":"it","width":1000,"height":1500}]},"en":{"status":"available","selected":{"type":"poster","url":"https://imag