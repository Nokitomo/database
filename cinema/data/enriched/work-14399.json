g/t/p/original/yOSgxl4ol4AbGud0aJrpLjkzlHa.jpg"},{"id":988795,"name":"Ron Whelan","role":"Annas"},{"id":3338,"name":"Jay C. Flippen","role":"Drunken Soldier - Herod Antipas' Court","profile":"https://image.tmdb.org/t/p/original/rfIPu6mEFDiJSnDMDZXLJTU04xT.jpg"},{"id":15942,"name":"Celia Lovsky","role":"Woman Behind Railings","profile":"https://image.tmdb.org/t/p/original/kyxxWyoKXmlNxptefqnjCtY6Sz0.jpg"},{"id":1214019,"name":"Joseph V. Perry","role":"Archelaus","profile":"https://image.tmdb.org/t/p/original/oUjWrdpMi7GEVI4OIeU8FXFNVtU.jpg"},{"id":13874,"name":"Marc Cavell","role":"Bad Thief on Cross","profile":"https://image.tmdb.org/t/p/original/sN8iO8Wy79wj0SNlDFprJNftcGc.jpg"},{"id":4099,"name":"Johnny Seven","role":"Pilate's Aide","profile":"https://image.tmdb.org/t/p/original/kn6k8OPk4OnAGl2aKp9zOBXfMyw.jpg"},{"id":2385449,"name":"Dal Jenkins","role":"Philip"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","title":"La più grande storia mai raccontata","overview":"Il film ricalca la vita di Gesù, fedele alla narrazione dei quattro vangeli ed inizia con l'arrivo dei magi. Poi continua con l'ira di Erode il grande, l'adorazione dei magi nella grotta di Betlemme, la strage degli innocenti, la fuga in Egitto, le rivolte dei giudei in Gerusalemme dopo la morte di Erode represse nel sangue dalle legioni romane, il battesimo di Gesù nel fiume Giordano, i discepoli, la predicazione e i miracoli, la morte di Giovanni Battista, la resurrezione di Lazzaro, l'entrata trionfale a Gerusalemme di Gesù, la cacciata dei mercanti dal Tempio, l'ultima cena, il tradimento di Giuda Iscariota, la preghiera all'orto del Getsemani, l'arresto, il processo dinanzi Caifa, Ponzio Pilato ed Erode Antipa, la via al Calvario, la crocifissione insieme a due ladroni, la deposizione nel sepolcro ed, infine, l'annuncio del risorto agli apostoli.","tagline":"Solo una volta nella vita... un intrattenimento così ricco... un'esperienza così gratificante..."},{"language":"en-US","overview":"From his birth in Bethlehem to his death and eventual resurrection, the life of Jesus Christ is given the all-star treatment in this epic retelling. Major aspects of Christ's life are touched upon, including the execution of all the newborn males in Egypt by King Herod; Christ's baptism by John the Baptist; and the betrayal by Judas after the Last Supper that eventually leads to Christ's crucifixion and miraculous return.","tagline":"Only once in a lifetime... an entertainment so rich... an experience so rewarding..."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/fz9SnpXjou87dNJnThTAz63uZO3.jpg","background":"https://image.tmdb.org/t/p/original/f6JjKDXn66XgNnYjBcKiwO4h3A7.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":2428,"type":"movie","originalLanguage":"en-US","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/fz9SnpXjou87dNJnThTAz63uZO3.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/fz9SnpXjou87dNJnThTAz63uZO3.jpg","language":"it","width":1600,"height":2400},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/fz9SnpXjou87dNJnThTAz63uZO3.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/fz9SnpXjou87dNJnThTAz63uZO3.jpg","language":"it","width":1600,"height":2400},{"type":"poster","url":"https://image.tmdb.org/t/p/original/dU1Eb7md4dTxsyTnyN36G7XjuGB.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/dU1Eb7md4dTxsyTnyN36G7XjuGB.jpg","language":"it","width":1000,"height":1500},{"type":"poster","url":"https://image.tmdb.org/t/p/original/bwYc8EwF35fDiTZCc5cUxlyhbD7.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/bwYc8EwF35fDiTZCc5cUxlyhbD7.jpg","language":"it","width":536,"height":804},{"type":"poster","url":"https://image.tmdb.org/t/p/original/hJRHroYaxA4kvHPrlfthCqgJnk3.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/hJRHroYax