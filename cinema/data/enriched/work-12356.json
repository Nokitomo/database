nexpected, deep, and sincere bond between them develops."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/6tJSUT4sG1b5H1RLfxsv8mMjoCa.jpg","background":"https://image.tmdb.org/t/p/original/7wlZpYSxmwdcNDEZj7gNwYPeekm.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":1143973,"type":"movie","originalLanguage":"it-IT","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/6tJSUT4sG1b5H1RLfxsv8mMjoCa.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/6tJSUT4sG1b5H1RLfxsv8mMjoCa.jpg","language":"it","width":1096,"height":1644},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/6tJSUT4sG1b5H1RLfxsv8mMjoCa.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/6tJSUT4sG1b5H1RLfxsv8mMjoCa.jpg","language":"it","width":1096,"height":1644},{"type":"poster","url":"https://image.tmdb.org/t/p/original/a2VaswTTjMlYdJZtgM84Fpa72P3.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/a2VaswTTjMlYdJZtgM84Fpa72P3.jpg","language":"it","width":1640,"height":2309},{"type":"poster","url":"https://image.tmdb.org/t/p/original/r9I9KPPvy7lnzds0blUQXddsC1f.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/r9I9KPPvy7lnzds0blUQXddsC1f.jpg","language":"it","width":1640,"height":2309},{"type":"poster","url":"https://image.tmdb.org/t/p/original/4WsQKQBOp8RxhFqz4KIriQw95Lc.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/4WsQKQBOp8RxhFqz4KIriQw95Lc.jpg","language":"it","width":1000,"height":1500},{"type":"poster","url":"https://image.tmdb.org/t/p/original/oDucYHSU6iDlRKAj0tJmvNBgoq0.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/oDucYHSU6iDlRKAj0tJmvNBgoq0.jpg","language":"it","width":729,"height":1094},{"type":"poster","url":"https://image.tmdb.org/t/p/original/dlSyaYtUP5icug5SkNmLCAejd29.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/dlSyaYtUP5icug5SkNmLCAejd29.jpg","language":"it","width":800,"height":1200},{"ty