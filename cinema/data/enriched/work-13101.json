dsEvidence":{"wikidata":{"source":"wikidata","sourceUrl":"https://www.wikidata.org/wiki/Q587566","wikidataId":"Q587566","tmdbId":11698,"type":"movie","imdbId":"tt0075276","tvdbId":10305}},"externalMedia":{"tmdb":{"source":"tmdb-api","id":11698,"type":"movie","sourceUrl":"https://www.themoviedb.org/movie/11698","fetchedAt":"2026-11-07T23:37:04.360Z","originalLanguage":"de-DE","title":{"value":"La ballata di Stroszek","language":"it-IT"},"originalTitle":"Stroszek","overview":{"value":"L'ingenuo Stroszek torna in libertà dopo un periodo di detenzione e stringe amicizia con una prostituta. Lei è perseguitata dal protettore e per sfuggire una volta per tutte dalla mala decide di scappare con il nuovo amico negli Stati Uniti. Per la coppia, però, la vita oltreoceano sarà tutt'altro che facile.  Ritratto di un inferno interiore ed esteriore con attori non professionisti (a parte Eva Mattes). Herzog disegna con sguardo lucido e spietato i confini della terra \"delle possibilità\" che però respinge gli emarginati. Un film disperato ma dal cuore puro, come quello del povero protagonista.","language":"it-IT"},"tagline":{"value":"A Ballad","language":"en-US"},"releaseDate":"1977-05-20","status":"Released","rating":7.3,"ratingCount":317,"genres":["Dramma"],"countries":["Germany"],"facts":{"Runtime":"108m"},"keywords":[],"networks":[],"socialLinks":{},"cast":[{"id":70273,"name":"Bruno S.","role":"Bruno Stroszek","profile":"https://image.tmdb.org/t/p/original/9c70miZGGvxwUzmTidcexPHStWC.jpg"},{"id":10627,"name":"Eva Mattes","role":"Eva","profile":"https://image.tmdb.org/t/p/original/63ET2xZ3ezbDGKwXxz2eqwX0pxB.jpg"},{"id":49509,"name":"Clemens Scheitz","role":"Scheitz","profile":"https://image.tmdb.org/t/p/original/jzPlAjMDNM4iRAGeBtm3MeIkYfJ.jpg"},{"id":27585,"name":"Wilhelm von Homburg","role":"Souteneur","profile":"https://image.tmdb.org/t/p/original/dfX2YeRSHQusMcddYn5Db7aEv09.jpg"},{"id":21833,"name":"Burkhard Driest","role":"Pimp #2","profile":"https://image.tmdb.org/t/p/original/k2flWgifoErLajv2mSqAhMblVEG.jpg"},{"id":1359462,"name":"Clayton Szalpinski","role":"Mechanic"},{"id":1359463,"name":"Ely Rodriguez","role":"Mechanic's Assistant"},{"id":1013897,"name":"Alfred Edel","role":"Prison Warden"},{"id":1023729,"name":"Scott McKain","role":"Bank Teller"},{"id":1464439,"name":"Pitt Bedewitz","role":"Pimp #3"},{"id":1023730,"name":"Ralph Wade","role":"Auctioneer"},{"id":36493,"name":"Michael Gahr","role":"Hoss, a prisoner","profile":"https://image.tmdb.org/t/p/original/su0BmXkXWYhh6UskFpKJpcO7nZM.jpg"},{"id":1464440,"name":"Vaclav Vojta","role":"Doctor"},{"id":1464441,"name":"Yüksel Topcugürler","role":"Turkish Prisoner"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","title":"La ballata di Stroszek","overview":"L'ingenuo Stroszek torna in libertà dopo un periodo di detenzione e stringe amicizia con una prostituta. Lei è perseguitata dal protettore e per sfuggire una volta per tutte dalla mala decide di scappare con il nuovo amico negli Stati Uniti. Per la coppia, però, la vita oltreoceano sarà tutt'altro che facile.  Ritratto di un inferno interiore ed esteriore con attori non professionisti (a parte Eva Mattes). Herzog disegna con sguardo lucido e spietato i confini della terra \"delle possibilità\" che però respinge gli emarginati. Un film disperato ma dal cuore puro, come quello del povero protagonista."},{"language":"en-US","title":"Stroszek","overview":"Bruno Stroszek is released from prison and warned to stop drinking. He has few skills and fewer expectations: with a glockenspiel and an accordion, he ekes out a living as a street musician. He befriends Eva, a prostitute down on her luck and they join his neighbor, Scheitz, an elderly eccentric, when he leaves Germany to live in Wisconsin.","tagline":"A Ballad"},{"language":"de-DE","overview":"Auf der Suche nach dem großen Glück wandert der Kleinganove und Straßensänger Bruno S. kurz nach seiner erneuten Entlassung aus dem Berliner Gefängnis samt Streuner-Freundin Eva und Nachbar Scheitz nach Amerika aus. Das ungewöhnliche Trio will auf der anderen Seite vom großen Ozean sein Glück versuchen. In einem gemütlich warmen 21 Meter langen Wohnwagen in Wisconsin finden sie es, doch es ist nicht von langer Dauer. Nach Zahlungsschwierigkeiten wird der Wohnwagen versteigert und der Traum zerplatzt. Zu allem Unglück wird Stroszek auch noch von Eva verlassen. Wird die Glückssuche im Fiasko enden?","tagline":"Eine Ballade"}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/w9HJcRcXohIZqx8HbKal3gp3NCR.jpg","background":"https://image.tmdb.org/t/p/original/eM3Kbzk9v03wJc0yoSC0QGEOU9C.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":11698,"type":"movie","originalLanguage":"de-DE","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/w9HJcRcXohIZqx8HbKal3gp3NCR.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/w9HJcRcXohIZqx8HbKal3gp3NCR.jpg","language":"it","width":676,"height":1000},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/w9HJcRcXohIZqx8HbKal3gp3NCR.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/w9HJcRcXohIZqx8HbKal3gp3NCR.jpg","language":"it","width":676,"height":1000},{"type":"poster","url":"https://image.tmdb.org/t/p/original/7aSnhQPyKYTWTJ8H0JbIO6qxoQJ.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/7aSnhQPyKYTWTJ8H0JbIO6qxoQJ.jpg","language":"it","width":2000,"height":3000},{"type":"poster","url":"https://image.tmdb.org/t/p/original/sU2LRDf95BceVYhUGWTU9pVbLQ6.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/sU2LRDf95BceVYhUGWTU9pVbLQ6.jpg","language":"it","width":2000,"height":3000}]},"en":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/wDq9ytRxoVpICRcx1BvagmXhd4t.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/wDq9ytRxoVpICRcx1BvagmXhd4t.jpg","language"