2998,"type":"movie","imdbId":"tt0066601","tvdbId":9473}},"externalMedia":{"tmdb":{"source":"tmdb-api","id":2998,"type":"movie","sourceUrl":"https://www.themoviedb.org/movie/2998","fetchedAt":"2026-11-07T22:31:53.498Z","originalLanguage":"en-US","title":{"value":"Zabriskie Point","language":"en-US"},"originalTitle":"Zabriskie Point","overview":{"value":"L'amore tra una ragazza benestante e uno studente ribelle di Los Angeles che ruba un aereo alla ricerca della libertà. Finale profetico esplosivo in forma di apocalisse capitalistica. La sproporzione tra idee e apparato figurativo, tra esilità della storia e terribilità della conclusione irritò la critica americana, ma l'esilità (la superficialità) non è soltanto della storia: è l'invenzione registica che bisogna mettere in discussione, è la pregnanza figurativa che manca, sostituita da una compiaciuta lussuria fotografica (Alfio Contini). È il film di un provinciale che punta al grandioso. Sam Shepard collaborò alla sceneggiatura. Una buona colonna rock con (fra gli altri) Pink Floyd, Grateful Dead e Rolling Stones.","language":"it-IT"},"tagline":{"value":"Il modo in cui ci arrivi dipende da dove ti trovi.","language":"it-IT"},"releaseDate":"1970-03-26","status":"Released","rating":7,"ratingCount":461,"genres":["Dramma"],"countries":["Italy","United States of America"],"facts":{"Runtime":"110m"},"keywords":[],"networks":[],"socialLinks":{},"cast":[{"id":29896,"name":"Mark Frechette","role":"Mark","profile":"https://image.tmdb.org/t/p/original/j7SJAJGrkly5Yk7rvuwWK2Hv3lY.jpg"},{"id":29897,"name":"Daria Halprin","role":"Daria","profile":"https://image.tmdb.org/t/p/original/kLsqayp4aotLOuc3CemXYEth3Uq.jpg"},{"id":8496,"name":"Paul Fix","role":"Cafe Owner","profile":"https://image.tmdb.org/t/p/original/1CTVXkgurzEYeFaJDuuIODaZvFu.jpg"},{"id":3173,"name":"G.D. Spradlin","role":"Lee's Associate","profile":"https://image.tmdb.org/t/p/original/pWNa9H3ABB3Ug9CwTfVNtHsCFjV.jpg"},{"id":225930,"name":"Bill Garaway","role":"Morty