image.tmdb.org/t/p/original/kl66283kiuvgaIGyjqqQLJ7NsXq.jpg"},{"id":3148291,"name":"Li Xingchen","role":"Chu Yao"},{"id":2778966,"name":"Jiang Peng","role":"Tang Yang","profile":"https://image.tmdb.org/t/p/original/nuuCUOgnzNdO0VZPkPns1sqRvSL.jpg"},{"id":3917168,"name":"Cui Yishao","role":"Xiao Bei","profile":"https://image.tmdb.org/t/p/original/eZA3fuGMvbnn8w3WTGPPhjmin1q.jpg"},{"id":2378306,"name":"Zhou Yao","role":"Li Ke","profile":"https://image.tmdb.org/t/p/original/dT5xaW5YZI8pmGf802psyx1F2Hs.jpg"},{"id":4099132,"name":"Shao Yanyuan","role":"Li Si","profile":"https://image.tmdb.org/t/p/original/nwR2SuH5r7D4eRsOBvO5GqIxpiJ.jpg"},{"id":3166278,"name":"Zhu Dong Ning","role":"Hei Sha","profile":"https://image.tmdb.org/t/p/original/XVjJll36obJdv1NIrXyncUW5rF.jpg"},{"id":1931226,"name":"Wang Ziwei","role":"Wang Xiaohua","profile":"https://image.tmdb.org/t/p/original/vLgKlbOZoHUkqx0k2rZsmjmRXfF.jpg"},{"id":1627288,"name":"Kong Lianshun","role":"Wang Daniu","profile":"https://image.tmdb.org/t/p/original/dAqV16WmglYw1c2DwBERYrkI5Zz.jpg"},{"id":3340125,"name":"Chen Shimin","role":"Mo Rou","profile":"https://image.tmdb.org/t/p/original/4IrK8SYtf0vfL46kBQoH1qINjo0.jpg"},{"id":1559685,"name":"Sun Hao","role":"Uncle Hui","profile":"https://image.tmdb.org/t/p/original/uvDbNS87xnZ9SAKSQT3eFJu9W0z.jpg"},{"id":1912963,"name":"Sun Hao","role":"Uncle Hui","profile":"https://image.tmdb.org/t/p/original/glSr4ySHNssLErAHYXYwbyor45A.jpg"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"en-US","title":"Wulin Heroes","overview":"Ye Xi, a kindhearted woman with dreams of becoming a martial arts hero, enters a world full of betrayal and challenges. Despite facing exploitation and setbacks, she remains determined to uphold her belief in good prevailing over evil. With the help of Bai Yue, a skilled doctor, Ye Xi grows stronger, learning the true essence of love and martial arts."},{"language":"zh-CN","title":"武林有侠气","overview":"生性良善、立志成为一代侠女的叶兮初入江湖，对武林和爱情抱有美好的幻想，一意锄强扶弱，却不懂人心险恶，竟一再遭遇利用、欺骗和背叛，甚至于被自己信任的“大侠”、以为可以相携仗剑天下的“良人”出卖，名声尽毁且几度被害。但纵然遭遇重重打击，叶兮仍然初心不改，坚信邪不压正、公道自在人心，她努力追查真相，证明自己的清白。期间幸得神医白岳多次相救，一路默默守护、生死与共。叶兮也逐渐成长，变得更加坚强自信，也终于明白了什么是真爱和武侠精神。在白岳的帮助下，叶兮铲除了陷害她并为祸江湖的武林败类，成长为真正的武林侠女。白岳更用医术仁心救治了被蛊惑的武林众人，武林中从此正气张扬，回归侠之大道。"}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/l9Qn1Ai4wsTkhzwhaRp9wIk1VO8.jpg","background":"https://image.tmdb.org/t/p/original/pt9gTLwRbghm0gaWfAaBDE0AyXp.jpg","seasons":[{"seasonNumber":1,"name":{"value":"Stagione 1","language":"it-IT"},"year":2023,"episodeCount":22,"posters":[],"backgrounds":[],"sourceUrl":"https://www.themoviedb.org/tv/128721/season/1"}],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":128721,"type":"tv","originalLanguage":"zh-CN","series":{"poster":{"it":{"status":"missing","candidates":[]},"en":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/q3EKQhwlZ0B9KP0bHovtPDEjaEn.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/q3EKQhwlZ0B9KP0bHovtPDEjaEn.jpg","language":"en","width":2000,"height":3000},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/q3EKQhwlZ0B9KP0bHovtPDEjaEn.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/q3EKQhwlZ0B9KP0bHovtPDEjaEn.jpg","language":"en","width":2000,"height":3000},{"type":"poster","url":"https://image.tmdb.org/t/p/original/Aik9UiiHqvbNvW7IHMn2GBgV5Bk.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/Aik9UiiHqvbNvW7IHMn2GBgV5Bk.jpg","language":"en","width":960,"height":1440},{"type":"poster","url":"https://image.tmdb.org/t/p/original/b5hb3slOy4WVsZifyW3Qk1sgMZD.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/b5hb3slOy4WVsZifyW3Qk1sgMZD.jpg","language":"en","width":1440,"height":2160},{"type":"poster","url":"https://image.tmdb.org/t/p/original/yXg0zd8y0HEArFwqh53g9Wo2i8N.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/yXg0zd8y0HEArFwqh53g9Wo2i8N.jpg","language":"en","width":1440,"height":2