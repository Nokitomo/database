iginal/l2kgp33bf2EwPsPqRIIKSRRMi0u.jpg"},{"id":2330837,"name":"Simona Malato","role":"operaia fabbrica","profile":"https://image.tmdb.org/t/p/original/cMvC8FkAowfcdXWvQFJ1lrtaGm4.jpg"},{"id":3257763,"name":"Totò Troia","role":"comparsa"},{"id":4304889,"name":"Chiara Russo","role":"Attivista Natoli","profile":"https://image.tmdb.org/t/p/original/wTMrpPXJwgxW1gt51efoXeILBqq.jpg"},{"id":1985823,"name":"Antonio Pandolfo","profile":"https://image.tmdb.org/t/p/original/o4ShOnABX7RQf58XTgwpPa050Kz.jpg"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","title":"L'ora legale","overview":"Salvo e Valentino sono cognati e vivono a Pietrammare, paesino della Sicilia dove gestiscono insieme un chiosco sulla piazza principale. Il marito della sorella di Valentino, a sua volta sorella della moglie di Salvo, è Pierpaolo Natoli, un professore di liceo dagli elevati valori morali e la condotta integerrima. Pierpaolo si candida a sindaco di Pietrammare contrapponendosi a Gaetano Patanè, il primo cittadino in carica, un concentrato di corruzione e malaffare: vuole proporre un cambiamento radicale che metta fine al degrado etico ed estetico che Patanè ha incoraggiato nel paese. A sorpresa, i compaesani votano Natoli sindaco, ma una volta eletto questi esigerà il rispetto assoluto delle regole: e si sa, in Italia chi invoca la legalità lo fa sempre riferendosi agli altri, mai a se stesso."},{"language":"en-US","title":"It’s the Law","overview":"A small Sicilian town elects a new, honest major but quickly learns that playing by the rules is not as easy as it seems."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/wiYW7gBAF70aGiuYkfH928vfmng.jpg","background":"https://image.tmdb.org/t/p/original/uhkLSVouiRjMqk65ydC3XxIpTB5.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":435921,"type":"movie","originalLanguage":"it-IT","series":{"poster":{"it":{