eu près normale et son seul ami n’est autre que son banquier. Tout va changer le jour où Laura, 16 ans, débarque sur le pas de sa porte et lui annonce qu’elle est sa fille. François ne pouvant avouer qui il est en réalité, ce sera pour lui le début des problèmes… d’autant que Laura a une idée derrière la tête. Une idée qui va lui coûter très cher.","tagline":"Quand on aime, on ne compte pas sauf..."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/lYigqYeNEuOCm9eyJIfibx3UHch.jpg","background":"https://image.tmdb.org/t/p/original/kvSFYQG9tW7JOOhpFOWv6b1pbB0.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":382511,"type":"movie","originalLanguage":"fr-FR","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/lYigqYeNEuOCm9eyJIfibx3UHch.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/lYigqYeNEuOCm9eyJIfibx3UHch.jpg","language":"it","width":500,"height":750},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/lYigqYeNEuOCm9eyJIfibx3UHch.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/lYigqYeNEuOCm9eyJIfibx3UHch.jpg","language":"it","width":500,"height":750},{"type":"poster","url":"https://image.tmdb.org/t/p/original/kIeq2aoZHXq0DJ0RevbHibZD93h.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/kIeq2aoZHXq0DJ0RevbHibZD93h.jpg","language":"it","width":1400,"height":2100}]},"en":{"status":"missing","candidates":[]},"fr":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/axdQyS20MtoBnXLpzJhn3g6etqZ.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/axdQyS20MtoBnXLpzJhn3g6etqZ.jpg","language":"fr","width":2000,"height":3000},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/axdQyS20MtoBnXLpzJhn3g6etqZ.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/axdQyS20MtoBnXLpzJhn3g6etqZ.jpg","language":"fr","width":2000,"height":3000