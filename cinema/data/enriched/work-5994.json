reichen Töchterchen das Geld aus der Tasche ziehen zu können, das er für seinen ersten Profikampf braucht. Aus ihren Vorhaben wird schnell ein emotionales Chaos, das alles, was die beiden über Geld, Karriere und Liebe zu wissen glauben, gehörig auf den Kopf stellt."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/bZ7H0kCwEM6CQ0dyCs2H4RkU130.jpg","background":"https://image.tmdb.org/t/p/original/2EOy2YSJbzKvlzKpEEKULVYZGlN.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":658760,"type":"movie","originalLanguage":"de-DE","series":{"poster":{"it":{"status":"missing","candidates":[]},"en":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/zaqStzYifawjqXnkxVGUvdi4KJ.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/zaqStzYifawjqXnkxVGUvdi4KJ.jpg","language":"en","width":1365,"height":2048},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/zaqStzYifawjqXnkxVGUvdi4KJ.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/zaqStzYifawjqXnkxVGUvdi4KJ.jpg","language":"en","width":1365,"height":2048},{"type":"poster","url":"https://image.tmdb.org/t/p/original/5GBggId0ZPoIKZeXnjekEHNbpOR.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/5GBggId0ZPoIKZeXnjekEHNbpOR.jpg","language":"en","width":1365,"height":2048},{"type":"poster","url":"https://image.tmdb.org/t/p/original/jCuF55yPmWd4yZbsfpOa3MFGuDX.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/jCuF55yPmWd4yZbsfpOa3MFGuDX.jpg","language":"en","width":1365,"height":2048},{"type":"poster","url":"https://image.tmdb.org/t/p/original/knHM58GVNpTxdaqYrLkOKZnRl6f.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/knHM58GVNpTxdaqYrLkOKZnRl6f.jpg","language":"en","width":1365,"height":2048}]},"de":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/bZ7H0kCwEM6CQ0dyCs2H4RkU130.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/bZ7H0kCwE