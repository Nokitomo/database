ll,"reference":{"base":"streamingunity:images","path":"/images/3092fba0-71e7-4e0a-b6e1-f6c81a1f4fd5.webp"},"provider":"streamingunity"},{"id":709950,"filename":"97c3d3c4-b4f9-4283-8dcb-8de0c5329aa9.webp","type":"background","lang":null,"imageable_type":"title","imageable_id":57903,"created_at":"2026-05-20T18:15:09.000000Z","updated_at":"2026-05-20T18:15:09.000000Z","original_url_field":null,"reference":{"base":"streamingunity:images","path":"/images/97c3d3c4-b4f9-4283-8dcb-8de0c5329aa9.webp"},"provider":"streamingunity"},{"id":709955,"filename":"330e5daa-d84d-4e0a-9c26-2b833af2be76.webp","type":"cover_mobile","lang":"it","imageable_type":"title","imageable_id":57903,"created_at":"2026-05-20T18:15:11.000000Z","updated_at":"2026-05-20T18:15:11.000000Z","original_url_field":null,"reference":{"base":"streamingunity:images","path":"/images/330e5daa-d84d-4e0a-9c26-2b833af2be76.webp"},"provider":"streamingunity"}],"episodeMappingUncertain":false,"seasons":[],"provenance":{},"warnings":[],"externalIdsEvidence":{"wikidata":{"source":"wikidata","sourceUrl":"https://www.wikidata.org/wiki/Q2870286","wikidataId":"Q2870286","tmdbId":204709,"type":"movie","imdbId":"tt2129887","tvdbId":15082}},"externalMedia":{"tmdb":{"source":"tmdb-api","id":204709,"type":"movie","sourceUrl":"https://www.themoviedb.org/movie/204709","fetchedAt":"2026-11-08T00:01:40.076Z","originalLanguage":"fr-FR","title":{"value":"Il paradiso degli orchi","language":"it-IT"},"originalTitle":"Au bonheur des ogres","overview":{"value":"Tratto dal primo libro della fortunata saga di Monsieur Malaussène di Daniel Pennac, il film narra dello strampalato universo di Benjamin Malaussène. Professione capro espiatorio: un uomo pagato per prendersi la responsabilità di qualunque guasto di qualunque oggetto venduto ai Grandi Magazzini. Ogni volta che viene chiamato all’Ufficio Reclami deve ripetere la stessa partitura: impietosire a tal punto l’acquirente da costringerlo a ritirare il reclamo. Proprio dopo aver concluso una sua performance, nei Grandi Magazzini scoppia una bomba: un boato, delle urla, poi il silenzio. Una sola vittima: un uomo dilaniato, ritrovato con la patta aperta.  Benjamin diventa il sospettato numero uno, e aiutato dai fratelli e dall’amata “zia Julie”, dovrà per la prima volta scagionarsi e trovare il vero colpevole.","language":"it-IT"},"tagline":{"value":"È sempre colpa sua!","language":"it-IT"},"releaseDate":"2013-10-16","status":"Released","rating":6,"ratingCount":132,"genres":["Dramma"],"countries":["France","Belgium","Luxembourg"],"facts":{"Runtime":"92m"},"keywords":[],"networks":[],"socialLinks":{},"cast":[{"id":147041,"name":"Raphaël Personnaz","role":"Benjamin Malaussène","profile":"https://image.tmdb.org/t/p/original/4eR91pTh7ZvIYtCp5qLPKLHrP70.jpg"},{"id":82923,"name":"Bérénice Bejo","role":"Tante Julia","profile":"https://image.tmdb.org/t/p/original/geRiss2B8CWgmY0VZW0dHsWiAOt.jpg"},{"id":15254,"name":"Emir Kusturica","role":"Stojil","profile":"https://image.tmdb.org/t/p/original/fOseFlKN7CH0UfieRw735QrRYJ5.jpg"},{"id":132431,"name":"Mélanie Bernier","role":"Louna","profile":"https://image.tmdb.org/t/p/original/83BOjMLKFv7ygHmtyVNuNJ1oUA6.jpg"},{"id":17896,"name":"Guillaume de Tonquédec","role":"Sainclair","profile":"https://image.tmdb.org/t/p/original/mDPeqkKJgFMiH60gH32VTwgOHSp.jpg"},{"id":83813,"name":"Thierry Neuvic","role":"Inspecteur Carrega","profile":"https://image.tmdb.org/t/p/original/e0CvOz6q1hqunt57lrIzY4mtWnT.jpg"},{"id":1187034,"name":"Armande Boulanger","role":"Thérèse","profile":"https://image.tmdb.org/t/p/original/3qiFTfRl8x68D8u6aUXWmV5POEb.jpg"},{"id":1187035,"name":"Adrien Ferran","role":"Jérémy"},{"id":1154239,"name":"Dean Constantin","role":"Cazeneuve","profile":"https://image.tmdb.org/t/p/original/aHppSogWv8qWfMaRZUmd3FlK5jL.jpg"},{"id":129168,"name":"Alice Pol","role":"La pédopsychiatre","profile":"https://image.tmdb.org/t/p/original/hxEMwyGAfxkOFwKhhpL4Rp4VfUp.jpg"},{"id":1074716,"name":"Julia Piaton","role":"Journaliste ITélé","profile":"https://image.tmdb.org/t/p/original/10QGSeZaq121UJgOizGFcW0SRku.jpg"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","title":"Il paradiso degli orchi","overview":"Tratto dal primo libro della fortunata saga di Monsieur Malaussène di Daniel Pennac, il film narra dello strampalato universo di Benjamin Malaussène. Professione capro espiatorio: un uomo pagato per prendersi la responsabilità di qualunque guasto di qualunque oggetto venduto ai Grandi Magazzini. Ogni volta che viene chiamato all’Ufficio Reclami deve ripetere la stessa partitura: impietosire a tal punto l’acquirente da costringerlo a ritirare il reclamo. Proprio dopo aver concluso una sua performance, nei Grandi Magazzini scoppia una bomba: un boato, delle urla, poi il silenzio. Una sola vittima: un uomo dilaniato, ritrovato con la patta aperta.  Benjamin diventa il sospettato numero uno, e aiutato dai fratelli e dall’amata “zia Julie”, dovrà per la prima volta scagionarsi e trovare il vero colpevole.","tagline":"È sempre colpa sua!"},{"language":"en-US","title":"The Scapegoat","overview":"There is something strange - some would even say abnormal - about the Malaussène family. But if you take a closer look, no one could be happier than this cheerfully chaotic family, even though their mother is usually off on one romantic adventure or another. Life is never a bore for Benjamin Malaussène, professional scapegoat and the older brother responsible for this horde of kids. But when incidents happen wherever he goes, police and colleagues begin to eye him suspiciously. It soon becomes a matter of life and death to find out what is going on and who is so interested in ruining his life. Written by Pathe International"},{"language":"fr-FR","overview":"Dans la tribu Malaussène, il y a quelque chose de curieux, de louche, d’anormal même diraient certains. Mais à y regarder de près, c’est le bonheur qui règne dans cette famille joyeusement bordélique dont la mère sans cesse en cavale amoureuse a éparpillé les pères de ses enfants. Pour Benjamin Malaussène, bouc émissaire professionnel et frère aîné responsable de cette marmaille, la vie n’est jamais ennuyeuse. Mais quand les incidents surviennent partout où il passe, attirant les regards soupçonneux de la police et de ses collègues de travail, il devient rapidement vital pour le héros de trouver pourquoi, comment, et surtout qui pourrait bien lui en vouloir à ce point-là ?"}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/ydbqyy8GIllZ08CCPHlzFyvvlff.jpg","background":"https://image.tmdb.org/t/p/original/dbnOEL3DC2FRq2WAJuuQpB8Xzha.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":204709,"type":"movie","originalLanguage":"fr-FR","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/ydbqyy8GIllZ08CCPHlzFyvvlff.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/ydbqyy8GIllZ08CCPHlzFyvvlff.jpg","language":"it","width":1000,"height":1500},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/ydbqyy8GIllZ08CCPHlzFyvvlff.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/ydbqyy8GIllZ08CCPHlzFyvvlff.jpg","language":"it","width":1000,"height":1500},{"type":"poster","url":"https://image.tmdb.org/t/p/original/cgMufREylUZRbR5c7MlqkV3kazk.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/cgMufREylUZRbR5c7MlqkV3kazk.jpg","language":"it","width":860,"height":1290}]},"en":{"status":"missing","candidates":[]},"fr":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/3tCDPkbqhEwxMf1wVNiAt20RMdL.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/3tCDPkbqhEwxMf1wVNiAt20RMdL.jpg","language":"fr","width":2000,"height":3000},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/3tCDPkbqhEwxMf1wVNiAt20RMdL.jpg","previewUrl":"https://image.tmdb.org/t/p