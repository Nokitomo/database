a"],"countries":["Japan"],"facts":{"Runtime":"106m"},"keywords":[],"networks":[],"socialLinks":{},"cast":[{"id":1321982,"name":"Ryusei Yokohama","role":"Sousuke Aoyama","profile":"https://image.tmdb.org/t/p/original/7glBRqD3scDygis5PqJrt6Zd80X.jpg"},{"id":1671407,"name":"Kaya Kiyohara","role":"Shinoda Chiaki","profile":"https://image.tmdb.org/t/p/original/a0tDsusfKXPSbVGO9zBSSAoCcAP.jpg"},{"id":2236358,"name":"Kanata Hosoda","role":"Furumae","profile":"https://image.tmdb.org/t/p/original/jzAY3P40g705sXd3QEfM1BtwVul.jpg"},{"id":2797433,"name":"Yuumi Kawai","role":"Kawagishi","profile":"https://image.tmdb.org/t/p/original/pcYp2J96Kt0M2MuLE6BRb6b6nGG.jpg"},{"id":55784,"name":"Yosuke Eguchi","role":"Nishihama","profile":"https://image.tmdb.org/t/p/original/lRLNrQ4Nv4CdWxWwAUQsu3p3NGR.jpg"},{"id":33134,"name":"Tomokazu Miura","role":"Shinoda Kozan","profile":"https://image.tmdb.org/t/p/original/2tKusMF6dzGOfH7MM73FCsJzRoJ.jpg"},{"id":1211033,"name":"Yasuko Tomita","role":"Todo Suizan","profile":"https://image.tmdb.org/t/p/original/4pa7p8ccg4vcjbKXDJFxscig83d.jpg"},{"id":52713,"name":"Kenichi Yajima","role":"Museum director","profile":"https://image.tmdb.org/t/p/original/zcO6Y8VqFhuTAxFVf2OmJenKAKv.jpg"},{"id":1910723,"name":"Atom Shukugawa","role":"Takiyanagi","profile":"https://image.tmdb.org/t/p/original/vy6Rxhvb7SIOU4T4CblUvJonDE.jpg"},{"id":3139771,"name":"Inoue Sora","role":"Sasakubo","profile":"https://image.tmdb.org/t/p/original/lnKcOZkuThPCrsBvVZBiLOMOZld.jpg"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","title":"The Lines that Define Me","overview":"Durante un lavoro part-time in una mostra di pittura a inchiostro Sumi-e, il giovane studente universitario Sosuke viene improvvisamente invitato da un rinomato pittore a diventare suo apprendista. Sebbene all'inizio sia intimidito dalla proposta e molto sorpreso, Sosuke inizia a frequentare lo studio del maestro. Appresi gli insegnamenti base di pittura a inchiostro Sumi-e, Sosuke si appassiona rapidamente all'arte, ma dovrà fare i conti con un profondo fardello che lo blocca. L'incontro con Chiaki, nipote del pittore e lei stessa pittrice emergente, provocherà un graduale cambiamento nel giovane apprendista."},{"language":"en-US","title":"The Lines That Define Me","overview":"Sousuke Aoyama is a college student who suffers painfully from the loss of his parents in a traffic accident. He meets Kozan Shinoda, a suibokuga (India-ink painting) artist, at an exhibition. Kozan becomes interested in Sousuke and surprisingly accepts him as his disciple. However, Kozan's niece is dismissive of Sousuke and declares to compete with Sousuke for the \"Kozan Award.\" Although Sousuke seemed uninterested in painting at first, he gradually becomes drawn to it by each stroke he draws..."},{"language":"ja-JP","title":"線は、僕を描く","overview":"大学生の青山霜介（横浜流星）は、絵画展設営のアルバイト中に水墨画と出会い、白と黒のみで表現される世界に魅了される。水墨画家として知られる篠田湖山に声をかけられたことをきっかけに、霜介は水墨画を学び始める。真っ白な紙に筆と墨だけを使って描かれる芸術を知るにつれ、彼は次第に深遠な水墨画の世界に引き込まれていく。","tagline":"涙をぬぐい、心を描けー"}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/yEGntUceylAIDmTp9H6xckGCHmA.jpg","background":"https://image.tmdb.org/t/p/original/2airbzXybsQKxqCsjh5oizgkush.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":961266,"type":"movie","originalLanguage":"ja-JP","series":{"poster":{"it":{"status":"missing","candidates":[]},"en":{"status":"missing","candidates":[]},"ja":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/yEGntUceylAIDmTp9H6xckGCHmA.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/yEGntUceylAIDmTp9H6xckGCHmA.jpg","language":"ja","width":2000,"height":3000},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/yEGntUceylAIDmTp9H6xckGCHmA.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/yEGntUceylAIDmTp9H6xckGCHmA.jpg","language":"ja","width":2000,"height":3000},