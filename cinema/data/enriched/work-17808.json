ro","role":"Stage Player: Shakespeare Company"},{"id":1664600,"name":"Martin Engler","role":"Stage Player: Shakespeare Company"},{"id":1664601,"name":"Alfred Hartung","role":"Stage Player: Shakespeare Company","profile":"https://image.tmdb.org/t/p/original/hnaLy7JpNbmsrCC9b9zCtHFfTza.jpg"},{"id":1664602,"name":"Oliver Kube","role":"Stage Player: Shakespeare Company"},{"id":1664604,"name":"Christian Ludwig","role":"Stage Player: Shakespeare Company"},{"id":1664639,"name":"Oliver Rickenbacher","role":"Stage Player: Shakespeare Company","profile":"https://image.tmdb.org/t/p/original/cQsD4hEfm0k9OucoX9CURsLNQ5A.jpg"},{"id":1148517,"name":"Claudius von Stolzmann","role":"Stage Player: Shakespeare Company","profile":"https://image.tmdb.org/t/p/original/A4dtOAEGHahAoTxGgq4m9YusqLp.jpg"},{"id":1664640,"name":"Tjadke Biallowons","role":"Dancer"},{"id":1664642,"name":"Dafne-Maria Fielder","role":"Dancer"},{"id":1329774,"name":"Alexander Flache","role":"Dancer"},{"id":1624049,"name":"Antonia Gerke","role":"Dancer"},{"id":1664653,"name":"Sophie Hichert","role":"Dancer"},{"id":1664660,"name":"Vera Kreyer","role":"Dancer"},{"id":1664674,"name":"Stefanie Lanius","role":"Dancer"},{"id":1664676,"name":"Urban Luig","role":"Dancer"},{"id":1664682,"name":"Jasmin Mehling","role":"Dancer"},{"id":1664689,"name":"Elisabeth Milarch","role":"Dancer"},{"id":1512804,"name":"Robert Munzinger","role":"Dancer"},{"id":1664698,"name":"Benjamin Plath","role":"Dancer"},{"id":1664700,"name":"Erik Studte","role":"Dancer"},{"id":1664701,"name":"Johann Hakob Wurster","role":"Dancer"},{"id":53500,"name":"Steffi Sattler","role":"First Lady to King James I (uncredited)"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","title":"Anonymous","overview":"Il film è ambientato durante i disordini politici dell'Inghilterra elisabettiana e affronta una questione che per secoli ha affascinato studiosi e brillanti intellettuali come Mark Twain, Charles Dickens, e Sigmund Freud, ossia: chi ha realmente scritto le opere attribuite a William Shakespeare? Gli esperti hanno dibattuto, vari libri sono stati scritti e molti studiosi hanno dedicato la loro vita per proteggere o sfatare teorie che circondano la paternità delle opere più famose della letteratura inglese. Anonymous offre una possibile risposta, concentrandosi su un momento in cui gli scandalosi intrighi politici e le illecite storie d'amore alla Corte Reale vengono portati alla luce nel luogo più inaspettato: il teatro di Londra.Edward de Vere, conte di Oxford, era un poeta e un drammaturgo affermato alla corte della regina Elisabetta nel XVI secolo. Alcune teorie letterarie del XX secolo ritengono che sia lui in realtà l'autore dei lavori attribuiti a Shakespeare.","tagline":"Shakespeare era un impostore?"},{"language":"en-US","overview":"Set against the backdrop of the succession of Queen Elizabeth I, and the Essex Rebellion against her, the story advances the theory that it was in fact Edward De Vere, Earl of Oxford who penned Shakespeare's plays.","tagline":"Was Shakespeare a Fraud?"}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/qsPDa9CnWyE3CKtsootq3elVvDe.jpg","background":"https://image.tmdb.org/t/p/original/5fKDsHMfY3K7vV1JFECYaafnwwx.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":61891,"type":"movie","originalLanguage":"en-US","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/qsPDa9CnWyE3CKtsootq3elVvDe.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/qsPDa9CnWyE3CKtsootq3elVvDe.jpg","language":"it","width":1400,"height":2100},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/qsPDa9CnWyE3CKtsootq3elVvDe.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/qsPDa9CnWyE3CKtsootq3elVvDe.jpg","language":"it","width":1400,"height":2100},{"type":"poster","url":"https://image.tmdb.or