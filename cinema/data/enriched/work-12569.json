tre. Par hasard, il rencontre Colette, un amour d'adolescence. Elle traverse elle aussi une crise sentimentale, mais semble s'intéresser davantage au roman d'Antoine qu'à Antoine lui-même. Il revoit également monsieur Lucien, l'ancien amant de sa mère, qui a perdu sa fougue pour devenir un vieux monsieur respectable…","tagline":"Antoine Doinel. Il a quatre femmes... neuf vies... et beaucoup d'alibis !"}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/yviy484mFeBvVb7m8owJgLOMorn.jpg","background":"https://image.tmdb.org/t/p/original/7LmhNfSkSkE296AvQbLZK4jgbnp.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":259,"type":"movie","originalLanguage":"fr-FR","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/yviy484mFeBvVb7m8owJgLOMorn.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/yviy484mFeBvVb7m8owJgLOMorn.jpg","language":"it","width":522,"height":750},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/yviy484mFeBvVb7m8owJgLOMorn.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/yviy484mFeBvVb7m8owJgLOMorn.jpg","language":"it","width":522,"height":750},{"type":"poster","url":"https://image.tmdb.org/t/p/original/tJUEjMl9NiFYBgIrNbrHwSWz3Wt.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/tJUEjMl9NiFYBgIrNbrHwSWz3Wt.jpg","language":"it","width":1000,"height":1500}]},"en":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/nfRNUq4TG4isD236QJ8pSPXeGnC.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/nfRNUq4TG4isD236QJ8pSPXeGnC.jpg","language":"en","width":1066,"height":1600},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/nfRNUq4TG4isD236QJ8pSPXeGnC.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/nfRNUq4TG4isD236QJ8pSPXeGnC.jpg","language":"en","width":1066,"height":1600},{"type":"poster","url":"https://image.tm