ourceUrl":"https://www.wikidata.org/wiki/Q139700589","wikidataId":"Q139700589","tmdbId":315610,"type":"tv","imdbId":"tt41050785","tvdbId":478836}},"externalMedia":{"tmdb":{"source":"tmdb-api","id":315610,"type":"tv","sourceUrl":"https://www.themoviedb.org/tv/315610","fetchedAt":"2026-11-08T02:26:17.567Z","originalLanguage":"pl-PL","title":{"value":"Proud","language":"pl-PL"},"originalTitle":"Proud","overview":{"value":"Filip è un giovane gay impulsivo e spericolato. Arrogante, impaziente, bellissimo e molto giovane, Filip nasconde le proprie insicurezze dietro un atteggiamento spavaldo e l’ammirazione che riceve come modello. Quando un’improvvisa tragedia familiare sconvolge la sua realtà, il suo mondo inizia a crollare: la morte della sorella lo spinge infatti ad occuparsi della figlia della donna confrontandosi con l’omofobia culturale e sistemica del suo Paese…","language":"it-IT"},"tagline":{"value":"Nikt nie mówił, że będzie łatwo.","language":"pl-PL"},"startDate":"2026-06-12","endDate":"2026-07-31","status":"Ended","rating":7.196,"ratingCount":56,"numberOfEpisodes":8,"numberOfSeasons":1,"genres":["Dramma"],"countries":["Poland"],"facts":{"Runtime":"40m"},"keywords":[],"networks":[{"id":8304,"name":"HBO Max","logo":"https://image.tmdb.org/t/p/original/gqWI9y0owo9sxgzZD7TXOeILYI9.png"}],"socialLinks":{},"cast":[{"id":2932520,"name":"Ignacy Liss","role":"Filip Raczyński","profile":"https://image.tmdb.org/t/p/original/3fK3RMdqBoLrgl0FjFORKjS3rLb.jpg"},{"id":6284812,"name":"Alicja Lewczuk","role":"Tosia","profile":"https://image.tmdb.org/t/p/original/9Batzu01bjWHOAJOxFL81jE7Qyf.jpg"},{"id":1650385,"name":"Maria Sobocińska","role":"Kiki","profile":"https://image.tmdb.org/t/p/original/oiLsV1TIADSgtoyAIeavOBH3p5n.jpg"},{"id":2275038,"name":"Kamil Studnicki","role":"Olek","profile":"https://image.tmdb.org/t/p/original/jzW5wuPBroPU6z28tplWUERLZAM.jpg"},{"id":82312,"name":"Maja Ostaszewska","role":"Neighbor","profile":"https://image.tmdb.org/t/p/original/1d1QZzGSTfCX9zZHqG4ST8N3mj3.jpg"},{"id":1457940,"name":"Mateusz Więcławek","role":"Paweł","profile":"https://image.tmdb.org/t/p/original/zhZeFgDuvxQGfCEcKvCzr9FJJqq.jpg"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","overview":"Filip è un giovane gay impulsivo e spericolato. Arrogante, impaziente, bellissimo e molto giovane, Filip nasconde le proprie insicurezze dietro un atteggiamento spavaldo e l’ammirazione che riceve come modello. Quando un’improvvisa tragedia familiare sconvolge la sua realtà, il suo mondo inizia a crollare: la morte della sorella lo spinge infatti ad occuparsi della figlia della donna confrontandosi con l’omofobia culturale e sistemica del suo Paese…"},{"language":"en-US","overview":"When his carefree life is upended by an unexpected family tragedy, Filip is forced to grow up or risk losing all that he has left."},{"language":"pl-PL","overview":"Historia Filipa, młodego i nieodpowiedzialnego geja, który żyje w przekonaniu, że świat należy do niego i że to się nigdy nie zmieni. Jest bezczelny, bezkarny, bezmyślny, niecierpliwy, piękny i młody. Swój wewnętrzny brak pewności siebie rekompensuje arogancją, podziwem w oczach innych i pracą modela. Kiedy dochodzi do rodzinnej tragedii, cały jego świat wywraca się do góry nogami.","tagline":"Nikt nie mówił, że będzie łatwo."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/8k5jU8aEQYRN2MS054OmzvVCmyd.jpg","background":"https://image.tmdb.org/t/p/original/xVdm4eAmypUH7gwGYqPARLKSaSb.jpg","seasons":[{"seasonNumber":1,"name":{"value":"Stagione 1","language":"it-IT"},"year":2026,"episodeCount":8,"poster":"https://image.tmdb.org/t/p/original/v7xmSCuGqVwSHfXkjAgZEEtl1Gr.jpg","posters":[],"backgrounds":[],"sourceUrl":"https://www.themoviedb.org/tv/315610/season/1"}],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":315610,"type":"tv","originalLanguage":"pl-PL","series":{"poster":{"it":{"status"