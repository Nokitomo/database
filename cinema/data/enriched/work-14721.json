ame":"Xabier Perurena","role":"Entrenador Rodríguez","profile":"https://image.tmdb.org/t/p/original/dl5I8wT8qlHvJU6ordJGaQrcJFW.jpg"},{"id":6445992,"name":"Nora Negrete","role":"Amiga Carla"},{"id":6445995,"name":"Oier Echevarria","role":"Ligue Neizan"},{"id":6445998,"name":"Olmo Díez","role":"Luke Howland niño"},{"id":6446000,"name":"Tristán Díez","role":"Zack Howland niño"},{"id":6446004,"name":"Oier Díez López","role":"Pol Howland niño"},{"id":6446006,"name":"Adrián Intxausti","role":"Dependiente tienda vinilos"},{"id":5772751,"name":"Lander Goikoetxea","role":"Chico 1 pelea discoteca"},{"id":6446009,"name":"Hegoi Larrazabal","role":"Chico 2 pelea discoteca"},{"id":2560417,"name":"Gaizka Egilegor","role":"Segurata discoteca"},{"id":3247403,"name":"Lucía de la Puerta","role":"DJ","profile":"https://image.tmdb.org/t/p/original/pc4Y1zia8RxWe5PRI4jT5UXw7HX.jpg"},{"id":5867941,"name":"Flor M. Salvador","role":"Tatuadora","profile":"https://image.tmdb.org/t/p/original/xu9vnAnHXPZ0JCsNPyepPR7IGy6.jpg"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","overview":"Una nuova città, una nuova vita e un incontro inatteso con Luke, un ragazzo vitale e tormentato. Nonostante gli avvertimenti, Hasley non riesce a stargli lontana. Nel loro \"boulevard\" scoprono un amore autentico e liberatorio. Ma mentre il passato di lui minaccia di distruggerli entrambi, Hasley si trova di fronte a una scelta straziante: si può salvare qualcuno che non è pronto a essere salvato?"},{"language":"en-US","overview":"Hasley, a girl with a list of unfulfilled dreams, and Luke, a complex and vulnerable boy marked by a tragic past, find refuge on the boulevard where they discover if love can conquer all."},{"language":"es-ES","overview":"Cuando Hasley (Eve Ryan) se muda a una nueva ciudad con su madre, lo último que espera es cruzarse con Luke (Mikel Niso), un joven envuelto en un aura peligrosa y un pasado trágico. Atrapado en sus propios demonios, Luke es todo lo que Hasley debería temer... pero a lo que se siente irremediablemente atraída. A pesar de las sombras que lo rodean, Hasley descubre en Luke una vulnerabilidad y un mundo interior apasionante. Juntos, crearán su propio boulevard: un refugio escondido donde poder ser ellos mismos, cumplir sueños imposibles, atreverse a amar a pesar de los prejuicios, el dolor y las cicatrices que arrastran, y demostrar que el amor es capaz de florecer incluso en los corazones más insospechados."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/6QmYPv8KkK5sscksmAWFHTO3gkF.jpg","background":"https://image.tmdb.org/t/p/original/98uiDns59GUw26SQSCFmuSHTki3.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":1595852,"type":"movie","originalLanguage":"es-ES","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/6QmYPv8KkK5sscksmAWFHTO3gkF.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/6QmYPv8KkK5sscksmAWFHTO3gkF.jpg","language":"it","width":2000,"height":3000},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/6QmYPv8KkK5sscksmAWFHTO3gkF.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/6QmYPv8KkK5sscksmAWFHTO3gkF.jpg","language":"it","width":2000,"height":3000}]},"en":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/hAKOp4AHaDiVdDMlobMNCNgJVD7.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/hAKOp4AHaDiVdDMlobMNCNgJVD7.jpg","language":"en","width":1080,"height":1620},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/hAKOp4AHaDiVdDMlobMNCNgJVD7.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/hAKOp4AHaDiVdDMlobMNCNgJVD7.jpg","language":"en","width":1080,"height":1620},{"type":"poster","url":"https://image.tmdb.org/t/p/original/6Vh5LgcDh1eKJboeNdzkx4nxWsZ.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/6Vh5LgcDh1eKJboeNd