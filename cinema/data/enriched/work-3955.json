27a2f71502f.webp","type":"background","lang":null,"imageable_type":"title","imageable_id":17067,"created_at":"2025-09-23T04:29:52.000000Z","updated_at":"2025-09-23T04:29:52.000000Z","original_url_field":null,"reference":{"base":"streamingunity:images","path":"/images/e9fb13c9-c8e7-4947-a5d5-427a2f71502f.webp"},"provider":"streamingunity"},{"id":259839,"filename":"3685ecc9-837d-4e95-8563-dd5da8b2b845.webp","type":"cover_mobile","lang":"it","imageable_type":"title","imageable_id":17067,"created_at":"2025-09-23T14:07:53.000000Z","updated_at":"2025-09-23T14:07:53.000000Z","original_url_field":null,"reference":{"base":"streamingunity:images","path":"/images/3685ecc9-837d-4e95-8563-dd5da8b2b845.webp"},"provider":"streamingunity"}],"episodeMappingUncertain":false,"seasons":[{"number":1,"episodes":[{"number":1,"title":"Episodio 1","synopsis":"Viktor and Mika encounter massive chaos on their very first delivery together: not only do a high-maintenance neuroscientist, a monstrously large TV set, and a rickety wall lead to various mishaps – the first conflicts between father and son also begin to emerge. Will these two very different characters really be able to work together?","thumbnail":{"base":"streamingunity:images","path":"/images/a102795a-fd28-4748-a51b-351c3d4b72b5.webp"},"metadataSources":{"streamingunity:17067":{"title":"Episodio 1","synopsis":"Viktor and Mika encounter massive chaos on their very first delivery together: not only do a high-maintenance neuroscientist, a monstrously large TV set, and a rickety wall lead to various mishaps – the first conflicts between father and son also begin to emerge. Will these two very different characters really be able to work together?","thumbnail":{"base":"streamingunity:images","path":"/images/a102795a-fd28-4748-a51b-351c3d4b72b5.webp"}}},"externalMappings":{"tmdb":{"status":"unverified","reason":"missing-distinctive-provider-title"},"tvdb":{"status":"unverified","reason":"missing-distinctive-provider-title"}}},{"number":2,"title":"Episodio 2","synopsis":"Viktor and Mika try to get a sound system up and running, but it remains stubbornly silent – unlike the customer, an eccentric retired colonel with a hearing aid who would prefer to do their job himself. A heated exchange about masculinity and generational conflicts ensues, and a lie is exposed: did Viktor tell Mika’s mum that he has testicular cancer?","thumbnail":{"base":"streamingunity:images","path":"/images/d69a5544-b2c0-427c-aa26-7dfdae81fd31.webp"},"metadataSources":{"streamingunity:17067":{"title":"Episodio 2","synopsis":"Viktor and Mika try to get a sound system up and running, but it remains stubbornly silent – unlike the customer, an eccentric retired colonel with a hearing aid who would prefer to do their job himself. A heated exchange about masculinity and generational conflicts ensues, and a lie is exposed: did Viktor tell Mika’s mum that he has testicular cancer?","thumbnail":{"base":"streamingunity:images","path":"/images/d69a5544-b2c0-427c-aa26-7dfdae81fd31.webp"}}},"externalMappings":{"tmdb":{"status":"unverified","reason":"missing-distinctive-provider-title"},"tvdb":{"status":"unverified","reason":"missing-distinctive-provider-title"}}},{"number":3,"title":"Episodio 3","synopsis":"Viktor and Mika are sucked into a marital spat between Nora and Paul, a couple who seem hopelessly overwhelmed by a combination of working from home and raising their young twins. This makes it all the more critical that the expensive espresso machine delivers the longed-for coffee! Yet somehow, between tarot cards and bizarre insults, father and son again get to know each other a little better.","thumbnail":{"base":"streamingunity:images","path":"/images/38a3ad70-500f-4de6-aae8-04f838bf0932.webp"},"metadataSources":{"streamingunity:17067":{"title":"Episodio 3","synopsis":"Viktor and Mika are sucked into a marital spat between Nora and Paul, a couple who seem hopelessly overwhelmed by a combination of working from home and raising their young twins. This makes it all the more critical that the expensive espresso machine delivers the longed-for coffee! Yet somehow, between tarot cards and bizarre insults, father and son again get to know each other a little better.","thumbnail":{"base":"streamingunity:images","path":"/images/38a3ad70-500f-4de6-aae8-04f838bf0932.webp"}}},"externalMappings":{"tmdb":{"status":"unverified","reason":"missing-distinctive-provider-title"},"tvdb":{"status":"unverified","reason":"missing-distinctive-provider-title"}}},{"number":4,"title":"Episodio 4","synopsis":"Viktor e Mika si ritrovano inaspettatamente coinvolti in un bizzarro furto e in un'emozionale montagna russa mentre consegnano una friggitrice a immersione in un pub di Berlino. Mentre sono confrontati con questa situazione minacciosa e con una giovane donna autore del reato, vengono rivelati fondamentali conflitti generazionali: i padri possono essere in generale accusati di tutto?","thumbnail":{"base":"streamingunity:images","path":"/images/da24fe8e-a795-46d5-86ca-b4fe1f566d11.webp"},"metadataSources":{"streamingunity:17067":{"title":"Episodio 4","synopsis":"Viktor e Mika si ritrovano inaspettatamente coinvolti in un bizzarro furto e in un'emozionale montagna russa mentre consegnano una friggitrice a immersione in un pub di Berlino. Mentre sono confrontati con questa situazione minacciosa e con una giovane donna autore del reato, vengono rivelati fondamentali conflitti generazionali: i padri possono essere in generale accusati di tutto?","thumbnail":{"base":"streamingunity:images","path":"/images/da24fe8e-a795-46d5-86ca-b4fe1f566d11.webp"}}},"externalMappings":{"tmdb":{"status":"unverified","reason":"missing-distinctive-provider-title"},"tvdb":{"status":"unverified","reason":"missing-distinctive-provider-title"}}},{"number":5,"title":"Episodio 5","synopsis":"Viktor and Mika are mired in AI chaos when they install a new controller. Between dealing with a talking fridge and an overzealous Smart Home system, Felix, a professional ‘wait-person,’ informs them that most jobs will soon no longer exist anyway! And so a heated discussion erupts about the value of human labor in this age of AI: will service technicians soon be superfluous?","thumbnail":{"base":"streamingunity:images","path":"/images/b8b3638f-a03d-4b47-b396-1ad90749e369.webp"},"metadataSources":{"streamingunity:17067":{"title":"Episodio 5","synopsis":"Viktor and Mika are mired in AI chaos when they install a new controller. Between dealing with a talking fridge and an overzealous Smart Home system, Felix, a professional ‘wait-person,’ informs them that most jobs will soon no longer exist anyway! And so a heated discussion erupts about the value of human labor in this age of AI: will service technicians soon be superfluous?","thumbnail":{"base":"streamingunity:images","path":"/images/b8b3638f-a03d-4b47-b396-1ad90749e369.webp"}}},"externalMappings":{"tmdb":{"status":"unverified","reason":"missing-distinctive-provider-title"},"tvdb":{"status":"unverified","reason":"missing-distinctive-provider-title"}}},{"number":6,"title":"Episodio 6","synopsis":"Viktor is quite excited: he is to meet Mika’s girlfriend, Ruby, for the first time! An artist, she’s quite the fiery character – and reminds Viktor of his ex-wife, which really irritates Mika: His mother is nothing like her! Between discussions about pathogenic beauty ideals and weird photo shoots, things actually get dangerous for a moment: Did Viktor forget to check the power cables?","thumbnail":{"base":"streamingunity:images","path":"/images/6a586298-e6ba-4120-a18a-fa46a3ab6514.webp"},"metadataSources":{"streamingunity:17067":{"title":"Episodio 6","synopsis":"Viktor is quite excited: he is to meet Mika’s girlfriend, Ruby, for the first time! An artist, she’s quite the fiery character – and reminds Viktor of his ex-wife, which really irritates Mika: His mother is nothing like her! Between discussions about pathogenic beauty ideals and weird photo shoots, things actually get dangerous for a moment: Did Viktor forget to check the power cables?","thumbnail":{"base":"streamingunity:images","path":"/images/6a586298-e6ba-4120-a18a-fa46a3ab6514.webp"}}},"externalMappings":{"tmdb":{"status":"unverified","reason":"missing-distinctive-provider-title"},"tvdb":{"status":"unverified","reason":"missing-distinctive-provider-title"}}},{"number":7,"title":"Episodio 7","synopsis":"Viktor and Mika deliver a robotic lawnmower to an offbeat pastor who firmly believes that faith is a big help in these turbulent times. The topic of forgiveness also comes up sooner than Viktor would like: Mika finds out that Viktor lied about his testicular cancer story and is devastated. Will this break the newly formed bond between father and son?","thumbnail":{"base":"streamingunity:images","path":"/images/fbe63ee5-58ca-4170-94dd-49c7654d4ada.webp"},"metadataSources":{"streamingunity:17067":{"title":"Episodio 7","synopsis":"Viktor and Mika deliver a robotic lawnmower to an offbeat pastor who firmly believes that faith is a big help in these turbulent times. The topic of forgiveness also comes up sooner than Viktor would like: Mika finds out that Viktor lied about his testicular cancer story and is devastated. Will this break the newly formed bond between father and son?","thumbnail":{"base":"streamingunity:images","path":"/images/fbe63ee5-58ca-4170-94dd-49c7654d4ada.webp"}}},"externalMappings":{"tmdb":{"status":"unverified","reason":"missing-distinctive-provider-title"},"tvdb":{"status":"unverified","reason":"missing-distinctive-provider-title"}}},{"number":8,"title":"Episodio 8","synopsis":"Viktor confesses that he lied about his health in order to be closer to Mika. Luckily Mika forgives him – in any case, they have to mount a projector on the ceiling of a remarkable tantra temple! When Mika gets a tempting job offer here, another question arises: Should Mika perhaps go all-in and properly join Viktor’s business?","thumbnail":{"base":"streamingunity:images","path":"/images/8