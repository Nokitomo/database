issioni mettendo a repentaglio la propria vita e la propria reputazione."},{"language":"en-US","overview":"A six-part docuseries with fly on the wall access into the wider world of NASA, with cameras on Earth and in space. NASA astronaut Captain Chris Cassidy is on a quest to get back in his spacesuit for one last mission. This series follows Chris and the wider team who take on missions that risk life, limb and reputation for the greater good of humankind. Join them as their missions unfold."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/uEDAJZtZpcxjMSyvPVMI1c9zvms.jpg","background":"https://image.tmdb.org/t/p/original/r2bRI4Lb7R4hejHRWB0zwd0ucRr.jpg","seasons":[{"seasonNumber":1,"name":{"value":"Stagione 1","language":"it-IT"},"year":2021,"episodeCount":6,"poster":"https://image.tmdb.org/t/p/original/uEDAJZtZpcxjMSyvPVMI1c9zvms.jpg","posters":[],"backgrounds":[],"sourceUrl":"https://www.themoviedb.org/tv/133637/season/1"}],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":133637,"type":"tv","originalLanguage":"en-US","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/uEDAJZtZpcxjMSyvPVMI1c9zvms.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/uEDAJZtZpcxjMSyvPVMI1c9zvms.jpg","language":"it","width":2000,"height":3000},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/uEDAJZtZpcxjMSyvPVMI1c9zvms.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/uEDAJZtZpcxjMSyvPVMI1c9zvms.jpg","language":"it","width":2000,"height":3000},{"type":"poster","url":"https://image.tmdb.org/t/p/original/6WkbUbmS9n4P477DHcltdyNTnsf.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/6WkbUbmS9n4P477DHcltdyNTnsf.jpg","language":"it","width":1800,"height":2700},{"type":"poster","url":"https://image.tmdb.org/t/p/original/AkkJryoUvKxo3TonXdzhlV3jtU8.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/AkkJryoUvKxo3TonXdzhlV3jt