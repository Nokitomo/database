ssersi fermate troppo a lungo ad ammirare il panorama dalla cima della Tour Eiffel, le tre perdono il pullman della comitiva e rimangono a piedi. Per ripararsi dalla pioggia, si rifugiano in un hotel di lusso, dove Grace viene scambiata per la famigerata ereditiera inglese Cordelia Winthrop-Scott. Per le tre amiche è l'inizio di un'altra vacanza."},{"id":55053,"translatable_type":"title","translatable_id":3921,"locale":"it","key":"release_date","value":"2011-07-01"},{"id":55052,"translatable_type":"title","translatable_id":3921,"locale":"it","key":"slug","value":"monte-carlo"},{"id":10530,"translatable_type":"title","translatable_id":3921,"locale":"it","key":"views","value":"98751"}],"keywords":[{"id":3739,"name":"american abroad","created_at":"2023-05-18T12:11:42.000000Z","updated_at":"2023-05-18T12:11:42.000000Z","pivot":{"title_id":3921,"keyword_id":3739}},{"id":4676,"name":"mistaken identity","created_at":"2023-05-18T12:23:29.000000Z","updated_at":"2023-05-18T12:23:29.000000Z","pivot":{"title_id":3921,"keyword_id":4676}},{"id":4800,"name":"young woman","created_at":"2023-05-18T12:25:03.000000Z","updated_at":"2023-05-18T12:25:03.000000Z","pivot":{"title_id":3921,"keyword_id":4800}},{"id":4966,"name":"look-alike","created_at":"2023-05-18T12:26:52.000000Z","updated_at":"2023-05-18T12:26:52.000000Z","pivot":{"title_id":3921,"keyword_id":4966}},{"id":7018,"name":"monte carlo","created_at":"2023-05-18T12:57:18.000000Z","updated_at":"2023-05-18T12:57:18.000000Z","pivot":{"title_id":3921,"keyword_id":7018}},{"id":7019,"name":"texan","created_at":"2023-05-18T12:57:18.000000Z","updated_at":"2023-05-18T12:57:18.000000Z","pivot":{"title_id":3921,"keyword_id":7019}}]}}]},"images":[{"id":37947,"filename":"c4fcc050-ca53-4406-9a47-940ca7d7bd42.webp","type":"poster","lang":"it","imageable_type":"title","imageable_id":3921,"created_at":"2023-05-18T12:57:18.000000Z","updated_at":"2025-05-12T09:24:31.000000Z","original_url_field":null,"reference":{"base":"streamingunity:images","pa