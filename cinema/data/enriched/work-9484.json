gline":"All'improvviso il mondo cambierà per sempre"},{"language":"en-US","overview":"A father and his son walk alone through burned America. Nothing moves in the ravaged landscape save the ash on the wind and water. It is cold enough to crack stones and, when the snow falls, it is gray. Their destination is the warmer south, although they don't know what, if anything, awaits them there.","tagline":"In a moment, the world changed forever."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/1LM9yt0kysj7y3PFDBJ8HjH72hj.jpg","background":"https://image.tmdb.org/t/p/original/6188iOmUAitGThYUjyx20fO4LJd.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":20766,"type":"movie","originalLanguage":"en-US","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/1LM9yt0kysj7y3PFDBJ8HjH72hj.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/1LM9yt0kysj7y3PFDBJ8HjH72hj.jpg","language":"it","width":1080,"height":1620},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/1LM9yt0kysj7y3PFDBJ8HjH72hj.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/1LM9yt0kysj7y3PFDBJ8HjH72hj.jpg","language":"it","width":1080,"height":1620},{"type":"poster","url":"https://image.tmdb.org/t/p/original/zlepyq3CczHIpRad3LUnBlxGgbI.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/zlepyq3CczHIpRad3LUnBlxGgbI.jpg","language":"it","width":1000,"height":1500},{"type":"poster","url":"https://image.tmdb.org/t/p/original/eWJbWaXOeyoVUEMb4ckr3PqRPR0.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/eWJbWaXOeyoVUEMb4ckr3PqRPR0.jpg","language":"it","width":2000,"height":3000}]},"en":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/qLaXnLzqleBWQtjvZ6JGVSaKoC3.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/qLaXnLzqleBWQtjvZ6JGVSaKoC3.jpg","language":"en","width":800,"height":1200},"candidates