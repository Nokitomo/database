te voluto dal \"falco\" John Wayne, passerà alla storia come l'unico lavoro di grande impegno dove l'intervento Usa nel Sud-est asiatico è visto in luce favorevole. Osteggiato dai gruppi di sinistra in tutto il mondo, in sé è solo un film di guerra come tanti altri (senza l'impatto emotivo dell'opera precedente di Wayne, La battaglia di Alamo).","language":"it-IT"},"tagline":{"value":"Gli eroi non sono più di moda - d'accordo - ma c'è ancora un inferno per quelli che ieri si chiamavano Rangers e Commandos","language":"it-IT"},"releaseDate":"1968-07-04","status":"Released","rating":5.6,"ratingCount":198,"genres":["Guerra","Dramma"],"countries":["United States of America"],"facts":{"Runtime":"142m"},"keywords":[],"networks":[],"socialLinks":{},"cast":[{"id":4165,"name":"John Wayne","role":"Colonel Mike Kirby","profile":"https://image.tmdb.org/t/p/original/4VmiGmCwSnratHtYmT2AyXrdQ64.jpg"},{"id":51377,"name":"David Janssen","role":"George Beckworth","profile":"https://image.tmdb.org/t/p/original/jCINgUrQcyV7w3C1LSg81Io2QEX.jpg"},{"id":94550,"name":"Jim Hutton","role":"Sgt. Petersen","profile":"https://image.tmdb.org/t/p/original/nFetsgFtJAWwBMGORlrSswRcnN1.jpg"},{"id":45232,"name":"Aldo Ray","role":"Sgt. Muldoon","profile":"https://image.tmdb.org/t/p/original/x00IKE88CleZRaUg6lPtyx2xyYW.jpg"},{"id":54565,"name":"Raymond St. Jacques","role":"Sgt. Doc McGee","profile":"https://image.tmdb.org/t/p/original/a3vR8Ju5HJUKrCf6Zkxr1QtD7DQ.jpg"},{"id":3244,"name":"Bruce Cabot","role":"Colonel Morgan","profile":"https://image.tmdb.org/t/p/original/gWG4ECOOHeQWLEI4nwFlLSFiUpd.jpg"},{"id":87067,"name":"Jack Soo","role":"Colonel Cai","profile":"https://image.tmdb.org/t/p/original/hOvMfUsrCy3Kvx2qrucCEzw1FwB.jpg"},{"id":1752,"name":"George Takei","role":"Captain Nim","profile":"https://image.tmdb.org/t/p/original/kfpkgfcuxcOrw2OCoAyQpPamQVv.jpg"},{"id":30560,"name":"Patrick Wayne","role":"Lt. Jamison","profile":"https://image.tmdb.org/t/p/original/u0EjouQWSjqr5npkGW9EXLNNAnC.jpg"},{"