37652,"name":"Tim Russ","created_at":"2023-05-18T12:35:00.000000Z","updated_at":"2023-05-18T12:35:00.000000Z","pivot":{"title_id":12118,"credit_id":37652,"job":"actor","order":6}},{"id":64179,"name":"Dennis Lipscomb","created_at":"2023-05-18T13:20:51.000000Z","updated_at":"2023-05-18T13:20:51.000000Z","pivot":{"title_id":12118,"credit_id":64179,"job":"actor","order":7}}],"main_directors":[{"id":14751,"name":"Walter Hill","created_at":"2023-05-18T12:02:40.000000Z","updated_at":"2023-05-18T12:02:40.000000Z","pivot":{"title_id":12118,"credit_id":14751,"job":"director","order":0}}],"cam":null,"translations":[{"id":11267,"translatable_type":"title","translatable_id":12118,"locale":"it","key":"daily_views","value":"0"},{"id":205362,"translatable_type":"title","translatable_id":12118,"locale":"it","key":"last_air_date","value":"1986-03-14"},{"id":205358,"translatable_type":"title","translatable_id":12118,"locale":"it","key":"name","value":"Mississippi Adventure"},{"id":205359,"translatable_type":"title","translatable_id":12118,"locale":"it","key":"plot","value":"Eugene \"Talent Boy\", è un amante della chitarra che vuole diventare un bluesman. Quando scopre che in un ospizio della sua città vive Willie Brown, un grande mito del blues, fa di tutto per conoscerlo. Willie Brown, dopo un primo rifiuto, si lascia contagiare dall'entusiasmo del ragazzo, ed insieme cominciano un'avventura che li porterà nel Mississippi, patria del blues.Eugene sa che Willie in gioventù è stato amico di Robert Johnson, il leggendario musicista che si dice abbia fatto un patto col Diavolo per poter suonare la chitarra come nessun altro al mondo; sa anche che Johnson ha inciso solo 29 canzoni sulle 30 pattuite, e spera che Willie possa insegnargli la canzone perduta. Ma anche il vecchio Willie a suo tempo fece un patto col Diavolo, anche se la sua sorte fu diversa dall'amico Johnson: il ritorno nel Mississippi sarà per lui l'occasione di fare un bilancio della propria vita e...di riaffrontare il Diavolo."},{"id":205361,"translatable_type":"title","translatable_id":12118,"locale":"it","key":"release_date","value":"1986-03-14"},{"id":205360,"translatable_type":"title","translatable_id":12118,"locale":"it","key":"slug","value":"mississippi-adventure"},{"id":11266,"translatable_type":"title","translatable_id":12118,"locale":"it","key":"views","value":"4555"}],"keywords":[{"id":1877,"name":"blues","created_at":"2023-05-18T11:57:59.000000Z","updated_at":"2023-05-18T11:57:59.000000Z","pivot":{"title_id":12118,"keyword_id":1877}},{"id":3342,"name":"harmonica","created_at":"2023-05-18T12:07:06.000000Z","updated_at":"2023-05-18T12:07:06.000000Z","pivot":{"title_id":12118,"keyword_id":3342}}]}}]},"images":[{"id":159990,"filename":"8171583c-a9e5-4fee-a334-80c069f37329.webp","type":"poster","lang":"it","imageable_type":"title","imageable_id":12118,"created_at":"2025-04-23T13:07:02.000000Z","updated_at":"2025-05-12T09:25:35.000000Z","original_url_field":null,"reference":{"base":"streamingunity:images","path":"/images/8171583c-a9e5-4fee-a334-80c069f37329.webp"},"provider":"streamingunity"},{"id":159991,"filename":"ff06a97a-4c6a-4cc7-83ac-26675701c67d.webp","type":"cover","lang":"it","imageable_type":"title","imageable_id":12118,"created_at":"2025-04-23T13:07:02.000000Z","updated_at":"2025-05-12T09:25:35.000000Z","original_url_field":null,"reference":{"base":"streamingunity:images","path":"/images/ff06a97a-4c6a-4cc7-83ac-26675701c67d.webp"},"provider":"streamingunity"},{"id":159993,"filename":"ffdbfa3b-6d47-4b49-9f5a-a6f688bb81d1.webp","type":"background","lang":null,"imageable_type":"title","imageable_id":12118,"created_at":"2025-04-23T13:07:02.000000Z","updated_at":"2025-04-23T13:07:02.000000Z","original_url_field":null,"reference":{"base":"streamingunity:images","path":"/images/ffdbfa3b-6d47-4b49-9f5a-a6f688bb81d1.webp"},"provider":"streamingunity"},{"id":159994,"filename":"2c5a8537-7c2e-479c-aa89-632174872351.webp","type":"logo","lang":"it","imageable_type":"title","image