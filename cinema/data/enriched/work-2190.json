 sorte fu diversa dall'amico Johnson: il ritorno nel Mississippi sarà per lui l'occasione di fare un bilancio della propria vita e...di riaffrontare il Diavolo.","language":"it-IT"},"tagline":{"value":"Where second best never gets a second chance.","language":"en-US"},"releaseDate":"1986-03-14","status":"Released","rating":7.4,"ratingCount":503,"genres":["Dramma","Musica"],"countries":["United States of America"],"facts":{"Runtime":"99m"},"keywords":[],"networks":[],"socialLinks":{},"cast":[{"id":2877,"name":"Ralph Macchio","role":"Eugene Martone","profile":"https://image.tmdb.org/t/p/original/AoqqL9UlyPrcTLnpzbQvKXPvXrz.jpg"},{"id":51546,"name":"Joe Seneca","role":"Willie Brown","profile":"https://image.tmdb.org/t/p/original/aFQMZdbawo7tQHnPMk1ififirwZ.jpg"},{"id":9995,"name":"Jami Gertz","role":"Frances","profile":"https://image.tmdb.org/t/p/original/yYy06dtBff0WwBHyxUjkq0kUvpu.jpg"},{"id":3977,"name":"Joe Morton","role":"Scratch's Assistant","profile":"https://image.tmdb.org/t/p/original/w7rGWWSGKWWukojLbZOQJ5yh9jv.jpg"},{"id":474156,"name":"Robert Judd","role":"Scratch","profile":"https://image.tmdb.org/t/p/original/455awyMvalycerb0djurv38uN0t.jpg"},{"id":92704,"name":"Steve Vai","role":"Jack Butler","profile":"https://image.tmdb.org/t/p/original/518t2GJ6oBfXMfHi7WEYVPIzoPl.jpg"},{"id":55538,"name":"Tim Russ","role":"Robert Johnson","profile":"https://image.tmdb.org/t/p/original/pwCVxvFbkUnBr46pPFJLabNMHww.jpg"},{"id":12855,"name":"Dennis Lipscomb","role":"Lloyd","profile":"https://image.tmdb.org/t/p/original/bpvFPjCrpOABOWfE6H0bRQx4Khl.jpg"},{"id":4316,"name":"Harry Carey Jr.","role":"Bartender","profile":"https://image.tmdb.org/t/p/original/7O61xbnqAMDOKVCh9ZH8deW6M30.jpg"},{"id":6771,"name":"Wally Taylor","role":"O.Z.","profile":"https://image.tmdb.org/t/p/original/4e1YcTFGkYp1YcdR80I5lSrXzSY.jpg"},{"id":153619,"name":"Allan Arbus","role":"Dr. Santis","profile":"https://image.tmdb.org/t/p/original/tsQdkA9Fm7sVvvBt6C8StnLtkJr.jpg"},{"id":101747,"name":"Edward 