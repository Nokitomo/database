venance":{},"warnings":[],"externalIdsEvidence":{"wikidata":{"source":"wikidata","sourceUrl":"https://www.wikidata.org/wiki/Q133306326","wikidataId":"Q133306326","tmdbId":1313003,"type":"movie","imdbId":"tt32478708","tvdbId":364293}},"externalMedia":{"tmdb":{"source":"tmdb-api","id":1313003,"type":"movie","sourceUrl":"https://www.themoviedb.org/movie/1313003","fetchedAt":"2026-11-06T12:37:04.511Z","originalLanguage":"it-IT","title":{"value":"Close to Me","language":"en-US"},"originalTitle":"Muori di lei","overview":{"value":"Quando inizia il lockdown a Roma, Luca (Riccardo Scamarcio), insegnante di filosofia del liceo, si ritrova a viverlo da solo perché la moglie Sara (Maria Chiara Giannetta), medico, vive praticamente in ospedale per fronteggiare l'emergenza. Mentre il mondo si ferma, la sua attenzione si concentra sulla nuova vicina, Amanda (Mariela Garriga). Quando il desiderio lo spinge a rompere la distanza che li separa, Luca è travolto da una passione incontrollata che sconvolgerà la sua vita con conseguenze inaspettate. Durante il lockdown al protagonista del film accade qualcosa di travolgente con l'apparizione di Amanda che scatenerà una passione più pericolosa della stessa pandemia.","language":"it-IT"},"tagline":{"value":"Bisogna stare attenti a quello che si desidera","language":"it-IT"},"releaseDate":"2025-03-20","status":"Released","rating":5.786,"ratingCount":56,"genres":["Romance","Thriller"],"countries":["Italy","Serbia"],"facts":{"Runtime":"104m"},"keywords":[],"networks":[],"socialLinks":{},"cast":[{"id":59270,"name":"Riccardo Scamarcio","role":"Luca","profile":"https://image.tmdb.org/t/p/original/s3ZAW6QA6yZaOx9wmAZfGZ1Z8BP.jpg"},{"id":1729881,"name":"Mariela Garriga","role":"Amanda","profile":"https://image.tmdb.org/t/p/original/hQhh8h3q6fmsm5GW1vlAgLhqHgQ.jpg"},{"id":2086629,"name":"Maria Chiara Giannetta","role":"Sara","profile":"https://image.tmdb.org/t/p/original/hej1rYJi1qZ5LuIylFh0gMZqOHF.jpg"},{"id":482503,"name":"Paolo Pierobon","role"