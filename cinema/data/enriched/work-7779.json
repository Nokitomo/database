deşler Vlad ve Radu, çocukluklarını Fatih Sultan Mehmet’le beraber Edirne Sarayı’nda geçirirler. 2. Murat ve Romanya Kralı öldükten sonra, Vlad, Fatih Sultan Mehmet tarafından Eflak’a Voyvoda olarak atanır. Küçüklüğünden beri içinde derin bir şiddet barındıran Vlad, orada Vatikan’ın ve Ejder Tarikatı’nın yönlendirmeleri ve dikteleriyle Fatih Sultan Mehmet’e karşı çok büyük bir kin ve nefret beslemeye başlar. Vlad, 23.734 Türkmen, Boşnak, Sırp, Arnavut ve Bulgar kazığa oturttuğunu kendi beyan edince, Fatih Sultan Mehmet durumun sebebini öğrenmek için kendi habercisini gönderir. Vlad, gönderilen habercinin de başına sarığını çakıp geri gönderince, Fatih Sultan Mehmet de bu olayı çözmeleri için Deliler’i görevlendirir..."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/wUfUMwt52vYqZSj7AYMwmKvLXd.jpg","background":"https://image.tmdb.org/t/p/original/B4ZhigHvuOj0LRIbDQBWn7EF60.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":540841,"type":"movie","originalLanguage":"tr-TR","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/wUfUMwt52vYqZSj7AYMwmKvLXd.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/wUfUMwt52vYqZSj7AYMwmKvLXd.jpg","language":"it","width":1000,"height":1500},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/wUfUMwt52vYqZSj7AYMwmKvLXd.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/wUfUMwt52vYqZSj7AYMwmKvLXd.jpg","language":"it","width":1000,"height":1500}]},"en":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/cSCuvcNM4SvMK5hUNDD94V0NjRP.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/cSCuvcNM4SvMK5hUNDD94V0NjRP.jpg","language":"en","width":960,"height":1440},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/cSCuvcNM4SvMK5hUNDD94V0NjRP.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/cSCuvcNM4S