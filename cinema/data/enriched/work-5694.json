],"episodeMappingUncertain":false,"seasons":[],"provenance":{},"warnings":[],"externalIdsEvidence":{"wikidata":{"source":"wikidata","sourceUrl":"https://www.wikidata.org/wiki/Q124856152","wikidataId":"Q124856152","tmdbId":1251717,"type":"movie","imdbId":"tt31511689","tvdbId":358970}},"externalMedia":{"tmdb":{"source":"tmdb-api","id":1251717,"type":"movie","sourceUrl":"https://www.themoviedb.org/movie/1251717","fetchedAt":"2026-11-06T22:56:37.480Z","originalLanguage":"en-US","title":{"value":"Vicious - I tre doni del Male","language":"it-IT"},"originalTitle":"Vicious","overview":{"value":"Polly (Dakota Fanning) riceve una misteriosa scatola con un’istruzione: inserire qualcosa che ama, odia e di cui ha bisogno. Dopo averlo fatto, la realtà si spezza. Intrappolata in un incubo dove il tempo salta e i ricordi mentono, Polly affronta scelte impossibili e visioni inquietanti. Per salvarsi, dovrà confrontarsi con l’oscurità dentro di sé, prima che consumi tutto ciò che conosce. La scatola è più di un oggetto: è un varco.","language":"it-IT"},"tagline":{"value":"Give it something you hate, something you need, something you love.","language":"en-US"},"releaseDate":"2025-08-06","status":"Released","rating":6.019,"ratingCount":324,"genres":["Horror","Thriller"],"countries":["United States of America"],"facts":{"Runtime":"103m"},"keywords":[],"networks":[],"socialLinks":{},"cast":[{"id":501,"name":"Dakota Fanning","role":"Polly","profile":"https://image.tmdb.org/t/p/original/hwcO08SVWkelfvgfIa5HsTMxsK8.jpg"},{"id":72309,"name":"Kathryn Hunter","role":"The Woman","profile":"https://image.tmdb.org/t/p/original/ni98cNE8kOAj6kcpEVmIfi8iAsw.jpg"},{"id":1980,"name":"Mary McCormack","role":"Mother","profile":"https://image.tmdb.org/t/p/original/e2brLtFCfgLdOp356bcEyRzQkoJ.jpg"},{"id":52478,"name":"Rachel Blanchard","role":"Lainie","profile":"https://image.tmdb.org/t/p/original/l8vUgOu1xVE1BKVCyrBf4M5PCBG.jpg"},{"id":1352921,"name":"Devyn Nekoda","role":"Tara","profile":"https://image