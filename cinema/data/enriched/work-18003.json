antottino girato nel 2006 Ammesso fa per voi."},{"id":144235,"translatable_type":"title","translatable_id":8868,"locale":"it","key":"release_date","value":"2006-08-18"},{"id":144234,"translatable_type":"title","translatable_id":8868,"locale":"it","key":"slug","value":"ammesso"},{"id":144237,"translatable_type":"title","translatable_id":8868,"locale":"it","key":"views","value":"16981"}],"keywords":[{"id":11445,"name":"straitjacket ","created_at":"2024-06-13T10:48:02.000000Z","updated_at":"2024-06-13T10:48:02.000000Z","pivot":{"title_id":8868,"keyword_id":11445}},{"id":11446,"name":"electro shock","created_at":"2024-06-13T10:48:02.000000Z","updated_at":"2024-06-13T10:48:02.000000Z","pivot":{"title_id":8868,"keyword_id":11446}}]}}]},"images":[{"id":115656,"filename":"56cb8cb6-1c6b-4117-8404-e71248122143.webp","type":"poster","lang":"it","imageable_type":"title","imageable_id":8868,"created_at":"2024-06-13T10:48:04.000000Z","updated_at":"2025-05-12T09:25:09.000000Z","original_url_field":null,"reference":{"base":"streamingunity:images","path":"/images/56cb8cb6-1c6b-4117-8404-e71248122143.webp"},"provider":"streamingunity"},{"id":115671,"filename":"4bc7d83f-d553-4fb2-a120-db1a1242c408.webp","type":"cover","lang":"it","imageable_type":"title","imageable_id":8868,"created_at":"2024-06-13T10:52:13.000000Z","updated_at":"2025-05-12T09:25:09.000000Z","original_url_field":null,"reference":{"base":"streamingunity:images","path":"/images/4bc7d83f-d553-4fb2-a120-db1a1242c408.webp"},"provider":"streamingunity"},{"id":115657,"filename":"91f650f3-2a47-4fc3-b03c-cbce713d2408.webp","type":"background","lang":null,"imageable_type":"title","imageable_id":8868,"created_at":"2024-06-13T10:48:04.000000Z","updated_at":"2024-06-13T10:48:04.000000Z","original_url_field":null,"reference":{"base":"streamingunity:images","path":"/images/91f650f3-2a47-4fc3-b03c-cbce713d2408.webp"},"provider":"streamingunity"},{"id":115670,"filename":"373b3948-a18e-4de8-bac5-4bd7d06addba.webp","type":"cover_mobile"