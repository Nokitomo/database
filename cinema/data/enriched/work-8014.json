/t/p/original/mJDgqTokg7ohh7zf2qNN7k7Ub04.jpg"},{"id":54278,"name":"Mouss Zouheyri","role":"School guardian","profile":"https://image.tmdb.org/t/p/original/ztCVUblrXjXMqiGzSDXI6XaZoVb.jpg"},{"id":3507603,"name":"Hélène Hazaël","role":"Samu social employee","profile":"https://image.tmdb.org/t/p/original/d3lD1E38WEeeYtjtNdE9XuysOK9.jpg"},{"id":3507606,"name":"Subhashis Majumdar","role":"Chess player India"},{"id":2362166,"name":"Nilesh Gowda","role":"Kidnapper"},{"id":3507614,"name":"Rahul Sengupta","role":"Kidnapper"},{"id":3166086,"name":"Atif Ally Dagman","role":"Kidnapper"},{"id":3507625,"name":"Fahim Mohammad","role":"Self"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","title":"Qualcosa di meraviglioso","overview":"Costretto ad abbandonare il natio Bangladesh, Fahim a otto anni è già un prodigio degli scacchi quando arriva a Parigi con il padre. Poiché viene rifiutato loro asilo, vivono come immigrati clandestini e piombano in una spirale di vagabondaggio e disperazione. Con un colpo di fortuna, però, Fahim viene presentato a uno dei più importanti coach di scacchi di Francia, Sylvain, che lo trasformerà in un campione.","tagline":"Una favola moderna ispirata ad una storia vera"},{"language":"en-US","overview":"Fahim Mohammad, a Bangladeshi immigrant, becomes a world junior chess champion in France."},{"language":"fr-FR","overview":"Forcé de fuir son Bangladesh natal, le jeune Fahim et son père quittent le reste de la famille pour Paris. Dès leur arrivée, ils entament un véritable parcours du combattant pour obtenir l’asile politique, avec la menace d’être expulsés à tout moment. Grâce à son don pour les échecs, Fahim rencontre Sylvain, l’un des meilleurs entraîneurs d’échecs de France. Entre méfiance et attirance, ils vont apprendre à se connaître et se lier d’amitié. Alors que le Championnat de France commence, la menace d’expulsion se fait pressante et Fahim n’a plus qu’une seule chance pour s’en sortir: être Champion de France.","tagline":"Jusqu'au bout du monde pour réaliser son rêve."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/rTjkMfDZ3Ptv8U609Ab6n1Ao1co.jpg","background":"https://image.tmdb.org/t/p/original/aXGKyAbfYRK2LF9ZsdC3Xu0QFJy.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":589978,"type":"movie","originalLanguage":"fr-FR","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/rTjkMfDZ3Ptv8U609Ab6n1Ao1co.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/rTjkMfDZ3Ptv8U609Ab6n1Ao1co.jpg","language":"it","width":1220,"height":1830},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/rTjkMfDZ3Ptv8U609Ab6n1Ao1co.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/rTjkMfDZ3Ptv8U609Ab6n1Ao1co.jpg","language":"it","width":1220,"height":1830},{"type":"poster","url":"https://image.tmdb.org/t/p/original/58qxOz2SWjlGJCNNaMUlxszacOV.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/58qxOz2SWjlGJCNNaMUlxszacOV.jpg","language":"it","width":2000,"height":3000}]},"en":{"status":"missing","candidates":[]},"fr":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/u3QADuxXvHrddLGBAWmQdaFfXAw.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/u3QADuxXvHrddLGBAWmQdaFfXAw.jpg","language":"fr","width":2000,"height":3000},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/u3QADuxXvHrddLGBAWmQdaFfXAw.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/u3QADuxXvHrddLGBAWmQdaFfXAw.jpg","language":"fr","width":2000,"height":3000},{"type":"poster","url":"https://image.tmdb.org/t/p/original/jBaTBYSCGUMUznkcFQgGAm4nK87.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/jBaTBYSCGUMUznkcFQgGAm4nK87.jpg","language":"fr","width":627,"height":940},{"type":"poster","url":"https://image.tmdb.org/t/p/original/filylsIe4nCctn7TaApTfqAG3Hk.jpg","preview