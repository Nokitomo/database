come sia possibile fuggire dal Villaggio per ritornare alla propria vita a New York. Sei deve scoprire di chi, tra gli abitanti del Villaggio, può fidarsi - tra questi una dottoressa di nome 313, il tassista 147 e lo stesso figlio di Due di nome 11-12 - nella sua ricerca di un sistema per fuggire dal Villaggio. Sei ha anche ricorrenti flashback della sua vita a New York, incluso un incontro con una donna di nome Lucy, che potrebbe essere parte della chiave per scoprire perché si trovi nel Villaggio"},{"id":171928,"translatable_type":"title","translatable_id":10305,"locale":"it","key":"release_date","value":"2009-11-15"},{"id":171927,"translatable_type":"title","translatable_id":10305,"locale":"it","key":"slug","value":"the-prisoner"},{"id":3200,"translatable_type":"title","translatable_id":10305,"locale":"it","key":"views","value":"17488"}],"keywords":[{"id":347,"name":"memory loss","created_at":"2023-05-18T11:50:20.000000Z","updated_at":"2023-05-18T11:50:20.000000Z","pivot":{"title_id":10305,"keyword_id":347}},{"id":608,"name":"miniseries","created_at":"2023-05-18T11:51:37.000000Z","updated_at":"2023-05-18T11:51:37.000000Z","pivot":{"title_id":10305,"keyword_id":608}},{"id":2265,"name":"desert","created_at":"2023-05-18T12:00:07.000000Z","updated_at":"2023-05-18T12:00:07.000000Z","pivot":{"title_id":10305,"keyword_id":2265}},{"id":3465,"name":"trapped","created_at":"2023-05-18T12:08:38.000000Z","updated_at":"2023-05-18T12:08:38.000000Z","pivot":{"title_id":10305,"keyword_id":3465}}]}}]},"images":[{"id":139353,"filename":"6ed81f7a-b99d-4814-bf8e-194f20eef6ef.webp","type":"poster","lang":"it","imageable_type":"title","imageable_id":10305,"created_at":"2024-10-27T18:12:17.000000Z","updated_at":"2025-05-12T09:25:21.000000Z","original_url_field":null,"reference":{"base":"streamingunity:images","path":"/images/6ed81f7a-b99d-4814-bf8e-194f20eef6ef.webp"},"provider":"streamingunity"},{"id":139351,"filename":"f8876018-3835-4741-9d6c-316de65babf7.webp","type":"cover","lang":"