-9bb7-ce638aff05b6.webp"},"provider":"streamingunity"}],"episodeMappingUncertain":false,"seasons":[],"provenance":{},"warnings":[],"externalIdsEvidence":{"wikidata":{"source":"wikidata","sourceUrl":"https://www.wikidata.org/wiki/Q123738413","wikidataId":"Q123738413","tmdbId":959395,"type":"movie","imdbId":"tt15389042","tvdbId":350725}},"externalMedia":{"tmdb":{"source":"tmdb-api","id":959395,"type":"movie","sourceUrl":"https://www.themoviedb.org/movie/959395","fetchedAt":"2026-11-07T20:50:41.095Z","originalLanguage":"fr-FR","title":{"value":"Maria Montessori - La nouvelle femme","language":"it-IT"},"originalTitle":"La Nouvelle Femme","overview":{"value":"La vicenda si svolge nel 1900 e si concentra su Lili d'Aengy (Leila Bekhti), una cocotte parigina all'apice del suo splendore che fugge da Parigi per nascondere la figlia \"idiota\". Arrivata a Roma, la sua vita viene sconvolta dall'incontro con una dottoressa che ha messo a punto un metodo per i bambini con difficoltà di apprendimento: Maria Montessori (Jasmine Trinca). Ma colei che vuole incarnare pubblicamente la \"donna nuova\", una donna moderna ed emancipata, ne deve pagare il prezzo: una maternità fuori dal matrimonio e nascosta. Presto dovrà scegliere: suo figlio o il suo destino?","language":"it-IT"},"releaseDate":"2023-11-05","status":"Released","rating":7,"ratingCount":105,"genres":["Dramma","Storia"],"countries":["France","Italy"],"facts":{"Runtime":"100m"},"keywords":[],"networks":[],"socialLinks":{},"cast":[{"id":69489,"name":"Jasmine Trinca","role":"Maria Montessori","profile":"https://image.tmdb.org/t/p/original/zpwHVGrExns5NA83m72lawDu3n4.jpg"},{"id":23383,"name":"Leïla Bekhti","role":"Lili d’Alengy","profile":"https://image.tmdb.org/t/p/original/5ww2aTFrhAnQk3a0eb5VejtD7Xg.jpg"},{"id":4313385,"name":"Rafaëlle Sonneville-Caby","role":"Tina d'Alengy"},{"id":1831110,"name":"Raffaele Esposito","role":"Giuseppe Ferruccio Montesano","profile":"https://image.tmdb.org/t/p/original/7cto3G7fIrvU8GEf7WG6oLe6fFv.jpg"},{"id":4997224,"name":"Laura Borelli","role":"Carlotta"},{"id":1175803,"name":"Nancy Huston","role":"Betsy","profile":"https://image.tmdb.org/t/p/original/lZ3usKvUIv9Y1bUofvpnilKlX9o.jpg"},{"id":121533,"name":"Agathe Bonitzer","role":"Clarisse","profile":"https://image.tmdb.org/t/p/original/oqTUqHBdSq3uuIGmlwt3EDqgiVr.jpg"},{"id":1318257,"name":"Sébastien Pouderoux","role":"Jean Itard","profile":"https://image.tmdb.org/t/p/original/3TOhTuoDJMQJQ8GYL0Y9dVvqSAW.jpg"},{"id":141830,"name":"Pietro Ragusa","role":"Le prince","profile":"https://image.tmdb.org/t/p/original/3vuTW5ErxDFk1Ur1HcI5u9hEo2u.jpg"},{"id":4997229,"name":"Raffaella Ducrey Giordano","role":"Anna"},{"id":3911031,"name":"Georgia Ives","role":"Giorgia"},{"id":57877,"name":"Stefano Abbati","role":"Cesare Lombroso","profile":"https://image.tmdb.org/t/p/original/7bMgqpWQKi191Sbix9QORUQbE2g.jpg"},{"id":1188528,"name":"Gianfranco Poddighe","role":"Guido Baccelli"},{"id":1201286,"name":"Renato Sarti","role":"Alessandro Montessori","profile":"https://image.tmdb.org/t/p/original/7efq3oImV8qZTi869hicxG965LZ.jpg"},{"id":1303356,"name":"Patrizia La Fonte","role":"Renilde Montessori","profile":"https://image.tmdb.org/t/p/original/q9Yoj51wA1kNFnGm7i7prwLxAsJ.jpg"},{"id":4257416,"name":"Daniela Macaluso","role":"Sarta"},{"id":263002,"name":"Roberto Zibetti","role":"Le journaliste"},{"id":4997232,"name":"Irina Valvilova","role":"La russe chez Betsy"},{"id":1913493,"name":"Luciana Castellucci","role":"Mme Montesano"},{"id":4274154,"name":"Emily Di Ronza","role":"Une étudiante"},{"id":5213181,"name":"Claudio Giova","role":"Conseil Scientifique"},{"id":2626820,"name":"Enrico Basile","role":"Conseil Scientifique"},{"id":1123326,"name":"Giacomo Fadda","role":"Conseil Scientifique","profile":"https://image.tmdb.org/t/p/original/i4IG59qNv3u3Wreeq2jPcQ2V53B.jpg"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","title":"Maria Montessori - La nouvelle femme","overview":"La vicenda si svolge nel 1900 e si concentra su Lili d'Aengy (Leila Bekhti), una cocotte parigina all'apice del suo splendore che fugge da Parigi per nascondere la figlia \"idiota\". Arrivata a Roma, la sua vita viene sconvolta dall'incontro con una dottoressa che ha messo a punto un metodo per i bambini con difficoltà di apprendimento: Maria Montessori (Jasmine Trinca). Ma colei che vuole incarnare pubblicamente la \"donna nuova\", una donna moderna ed emancipata, ne deve pagare il prezzo: una maternità fuori dal matrimonio e nascosta. Presto dovrà scegliere: suo figlio o il suo destino?"},{"language":"en-US","title":"Maria Montessori","overview":"Set in 1900, Lili d’Alengy, a Parisian cocotte at the height of her fame, flees Paris to hide her “idiot” daughter. There she meets Maria Montessori, who is pioneering a teaching method that may help the child."},{"language":"fr-FR","overview":"En 1900, Lili d’Alengy, célèbre courtisane parisienne, a un secret honteux - sa fille Tina, née avec un handicap. Peu disposée à s’occuper d’une enfant qui menace sa carrière, elle décide de quitter Paris pour Rome. Elle y fait la connaissance de Maria Montessori, une femme médecin qui développe une méthode d’apprentissage révolutionnaire pour les enfants qu’on appelle alors « déficients ». Mais Maria cache elle aussi un secret : un enfant né hors mariage. Ensemble, les deux femmes vont s’entraider pour gagner leur place dans ce monde d’hommes et écrire l’Histoire."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/lFacML1YZ12HNoDYGykW6WO0Upn.jpg","background":"https://image.tmdb.org/t/p/original/sg2iCpfERyX4xyqZipfvNqSAHbx.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":959395,"type":"movie","originalLanguage":"fr-FR","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/lFacML1YZ12HNoDYGykW6WO0Upn.jpg","previewUrl":"https:/