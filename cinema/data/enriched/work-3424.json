works":[],"socialLinks":{},"cast":[{"id":1933688,"name":"Josh Goodman","role":"Narrator (voice)"},{"id":1029819,"name":"Parks Stephenson","role":"Self"},{"id":5367757,"name":"Jennifer Hooper","role":"Self"},{"id":5367758,"name":"Chris Hearn","role":"Self"},{"id":2107155,"name":"Yasmin Khan","role":"Self","profile":"https://image.tmdb.org/t/p/original/chKocTwbfs0EpEl4pucFlarkyvN.jpg"},{"id":5367761,"name":"Jeom-Kee Paik","role":"Self"},{"id":5367763,"name":"Simon Benson","role":"Self"},{"id":5367764,"name":"Stephen Payne","role":"Self"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","title":"Titanic: La rinascita digitale","overview":"Utilizzando un'innovativa tecnologia di scansione e una CGI all'avanguardia, un team di esperti produce il primo gemello digitale 3D ad alta risoluzione del relitto del Titanic. Attraverso un'indagine immersiva senza precedenti, il team rivela i fatali ultimi momenti della nave, l'eroismo e la codardia di coloro che erano a bordo, e la verità su come la nave \"inaffondabile\" affondò."},{"language":"en-US","overview":"Using cutting-edge scanning technology and state-of-the-art CGI, a team of experts creates the first high-resolution 3D digital twin of the Titanic wreck. Through a groundbreaking immersive investigation, they uncover the ship’s final moments, shedding light on the acts of heroism and cowardice aboard—and revealing the true story behind the sinking of the “unsinkable” ship."}],"images":{"logos":[{"type":"logo","url":"https://image.tmdb.org/t/p/original/gkuUF7GgYpEQiHGbBTfmB30yim6.png","previewUrl":"https://image.tmdb.org/t/p/w300/gkuUF7GgYpEQiHGbBTfmB30yim6.png","language":"en","width":1910,"height":459},{"type":"logo","url":"https://image.tmdb.org/t/p/original/z1ccSGuiDexRMwZMQPgtm04C9k6.png","previewUrl":"https://image.tmdb.org/t/p/w300/z1ccSGuiDexRMwZMQPgtm04C9k6.png","language":"en","width":1910,"height":632},{"type":"logo","url":"https://image.tmdb.org/t/p/original/4E