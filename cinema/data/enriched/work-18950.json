mingunity:images","path":"/images/b3a52937-afab-4fba-8bf5-53b8bb984acb.webp"},"provider":"streamingunity"},{"id":131265,"filename":"ce9dbef7-b77b-48aa-a11d-9bf349bc4991.webp","type":"cover_mobile","lang":"it","imageable_type":"title","imageable_id":9759,"created_at":"2024-08-25T15:07:02.000000Z","updated_at":"2025-05-12T09:25:16.000000Z","original_url_field":null,"reference":{"base":"streamingunity:images","path":"/images/ce9dbef7-b77b-48aa-a11d-9bf349bc4991.webp"},"provider":"streamingunity"}],"episodeMappingUncertain":false,"seasons":[],"provenance":{},"warnings":[],"externalIdsEvidence":{"wikidata":{"source":"wikidata","sourceUrl":"https://www.wikidata.org/wiki/Q116520583","wikidataId":"Q116520583","tmdbId":1000521,"type":"movie","imdbId":"tt20192062","tvdbId":339220}},"externalMedia":{"tmdb":{"source":"tmdb-api","id":1000521,"type":"movie","sourceUrl":"https://www.themoviedb.org/movie/1000521","fetchedAt":"2026-11-09T00:05:26.774Z","originalLanguage":"fr-FR","title":{"value":"Teo e Zodì - Un cammello per amico","language":"it-IT"},"originalTitle":"Zodi et Téhu, frères du désert","overview":{"value":"Zodi, nomade dodicenne, trova nel deserto un cucciolo di dromedario orfano. Lo accoglie, lo nutre, lo battezza Tehu e diventa il suo migliore amico. Zodi viene a sapere da una veterinaria, Julia, che Tehu è un corridore eccezionale e che può essere fonte di grandi guadagni per la sua tribù. Ma le qualità del giovane dromedario suscitano l'avidità del più temuto bracconiere della regione. Per evitare che Tehu venga venduto, Zodi decide quindi di fuggire e attraversare il Sahara.","language":"it-IT"},"tagline":{"value":"Une amitié hors du commun. Une aventure extraordinaire.","language":"fr-FR"},"releaseDate":"2023-02-08","status":"Released","rating":6.7,"ratingCount":30,"genres":["Avventura","Famiglia","Commedia"],"countries":["France"],"facts":{"Runtime":"105m"},"keywords":[],"networks":[],"socialLinks":{},"cast":[{"id":3820165,"name":"Yassir Drief","role":"Zodi","profile":"https://image.tmdb.org/t/p/original/cbNjPCyepuGsiq3wEMlZFhwpBIl.jpg"},{"id":113617,"name":"Alexandra Lamy","role":"Julia","profile":"https://image.tmdb.org/t/p/original/m52fdEhVo6sBjEhgyM6bqFwC1HA.jpg"},{"id":458904,"name":"Youssef Hajdi","role":"Tarek","profile":"https://image.tmdb.org/t/p/original/fSuiu7vQbGcLUA2ZW4eSwiZ3Fs2.jpg"},{"id":583919,"name":"Said Bey","role":"Abdallah","profile":"https://image.tmdb.org/t/p/original/fgYSU3ARAShZKXxygUVOomRJgnM.jpg"},{"id":1470255,"name":"Antonythasan Jesuthasan","role":"Kumail","profile":"https://image.tmdb.org/t/p/original/awXSDRRPXXVBB1YRy5mtpC49Ooy.jpg"},{"id":16352,"name":"Pierre Hancisse","role":"Jean-Louis","profile":"https://image.tmdb.org/t/p/original/cJeNz8xXHZrHVvYiZwESGG0Uylf.jpg"},{"id":1247539,"name":"Nadia Benzakour","role":"Amina","profile":"https://image.tmdb.org/t/p/original/dL66wslEEt2awrjpnj2dzi8TUw9.jpg"},{"id":1178745,"name":"Amine Ennaji","role":"Issouf","profile":"https://image.tmdb.org/t/p/original/c29gNwh767I2aDqBqX8YFQHSThR.jpg"},{"id":4725343,"name":"Driss Ouhssin","role":"Ali"},{"id":2847330,"name":"Mustapha Grumij","role":"Fouad"},{"id":568717,"name":"Anas El Baz","role":"Moetaz","profile":"https://image.tmdb.org/t/p/original/8QMyEnZJkW0nOA8pY8ros6PGYfK.jpg"},{"id":5236433,"name":"Mohammad Omrani","role":"Un homme louche"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","title":"Teo e Zodì - Un cammello per amico","overview":"Zodi, nomade dodicenne, trova nel deserto un cucciolo di dromedario orfano. Lo accoglie, lo nutre, lo battezza Tehu e diventa il suo migliore amico. Zodi viene a sapere da una veterinaria, Julia, che Tehu è un corridore eccezionale e che può essere fonte di grandi guadagni per la sua tribù. Ma le qualità del giovane dromedario suscitano l'avidità del più temuto bracconiere della regione. Per evitare che Tehu venga venduto, Zodi decide quindi di fuggire e attraversare il Sahara."},{"language":"en-US","title":"Zodi and Téhu: Princes of the Desert","overview":"Zodi, a 12 years old nomad, find an orphan baby dromedary in the desert. He takes in the animal, feeds it, calls it Téhu and becomes its best friend."},{"language":"fr-FR","overview":"Zodi, un jeune nomade de 12 ans, découvre dans le désert un bébé dromadaire orphelin. Il le recueille, le nourrit, le baptise Téhu et devient son meilleur ami. Zodi apprend par une vétérinaire, Julia, que Téhu est un coureur exceptionnel et qu’il peut rapporter beaucoup d’argent à sa tribu. Mais les qualités de son jeune dromadaire suscitent la convoitise de Tarek le braconnier de la région. Pour éviter que Téhu ne soit vendu, Zodi décide alors de s’enfuir et de traverser le Sahara. C’est pendant ce voyage que Zodi affrontera Tarek, survivra à une tempête de sable et traversera la mer de sel avec pour ultime objectif d'inscrire Téhu à la plus grande course de dromadaires au monde à Abu Dhabi. Avec l’aide de Julia, Zodi va se démener pour réaliser son rêve, faire de Téhu un champion et sauver sa tribu.","tagline":"Une amitié hors du commun. Une aventure extraordinaire."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/sYQWhCOPIoaA6JDxQIqtkNg0BB.jpg","background":"https://image.tmdb.org/t/p/original/eswPpSmt7lsMjYVQ5D2p7nDs7WW.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":1000521,"type":"movie","originalLanguage":"fr-FR","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/sYQWhCOPIoaA6JDxQIqtkNg0BB.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/sYQWhCOPIoaA6JDxQIqtkNg0BB.jpg","language":"it","width":1000,"height":1500},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/sYQWhCOPIoaA6JDxQIqtkNg0BB.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/sYQWhCOPIoaA6JDxQIqtkNg0BB.jpg","language":"it","width":1000,"height":1500}]},"en":{"status":"available","selec