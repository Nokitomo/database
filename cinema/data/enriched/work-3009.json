mdbId":1909,"type":"movie","imdbId":"tt0112883","tvdbId":7671}},"externalMedia":{"tmdb":{"source":"tmdb-api","id":1909,"type":"movie","sourceUrl":"https://www.themoviedb.org/movie/1909","fetchedAt":"2026-11-06T14:11:28.078Z","originalLanguage":"en-US","title":{"value":"Don Juan DeMarco - Maestro d'amore","language":"it-IT"},"originalTitle":"Don Juan DeMarco","overview":{"value":"Convinto di essere Don Giovanni, il giovane De Marco si appresta al suicidio dal cornicione di un albergo di New York. Interviene lo psichiatra Jack Mickler, che dal colloquio col ragazzo scopre la personalità complessa e tormentata di un seduttore involontario, più simile al Don Juan del poema di Byron che a uno sfrenato donnaiolo e libertino. Abbandonato l'insano proposito, in un finale onirico e quasi sconcertante, sarà il giovane a trascinare lo psichiatra nel suo mondo fantasioso, facendogli riscoprire emozioni dimenticate.","language":"it-IT"},"tagline":{"value":"La storia dell'uomo che pensava di essere il più grande amante del mondo... e le persone che hanno cercato di curarlo!","language":"it-IT"},"releaseDate":"1994-10-12","status":"Released","rating":6.754,"ratingCount":833,"genres":["Romance","Dramma","Commedia"],"countries":["United States of America"],"facts":{"Runtime":"97m"},"keywords":[],"networks":[],"socialLinks":{},"cast":[{"id":85,"name":"Johnny Depp","role":"Don Juan DeMarco","profile":"https://image.tmdb.org/t/p/original/k2xt6EUxQDwYRKIyI4IBdZxfs8n.jpg"},{"id":3084,"name":"Marlon Brando","role":"Dr. Jack Mickler","profile":"https://image.tmdb.org/t/p/original/yIvLpf9U9NfAvC7fuAgOQ8tu51T.jpg"},{"id":6450,"name":"Faye Dunaway","role":"Marilyn Mickler","profile":"https://image.tmdb.org/t/p/original/bwHJPkiDOjTslgrl0mri1Ndvx2V.jpg"},{"id":19888,"name":"Géraldine Pailhas","role":"Dona Ana","profile":"https://image.tmdb.org/t/p/original/e1xAdLDPKOO3sfMU2I52vL6pL2I.jpg"},{"id":19889,"name":"Bob Dishy","role":"Dr. Paul Showalter","profile":"https://image.tmdb.org/t/p/original/