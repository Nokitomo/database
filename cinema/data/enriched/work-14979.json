“ durch das albtraumhafte Frankfurt."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/xOLRpgtHEce1bfUcZbBQOlBQLR4.jpg","background":"https://image.tmdb.org/t/p/original/rgduSnz2ETdKPk1D3QigAceEqny.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":42206,"type":"movie","originalLanguage":"de-DE","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/xOLRpgtHEce1bfUcZbBQOlBQLR4.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/xOLRpgtHEce1bfUcZbBQOlBQLR4.jpg","language":"it","width":500,"height":750},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/xOLRpgtHEce1bfUcZbBQOlBQLR4.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/xOLRpgtHEce1bfUcZbBQOlBQLR4.jpg","language":"it","width":500,"height":750},{"type":"poster","url":"https://image.tmdb.org/t/p/original/rThMSNhGPfyfkdKxUspZoCIaWT2.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/rThMSNhGPfyfkdKxUspZoCIaWT2.jpg","language":"it","width":2000,"height":3000}]},"en":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/kauXmH1RQRNbFBiAKA1EpQZILP3.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/kauXmH1RQRNbFBiAKA1EpQZILP3.jpg","language":"en","width":2000,"height":3000},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/kauXmH1RQRNbFBiAKA1EpQZILP3.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/kauXmH1RQRNbFBiAKA1EpQZILP3.jpg","language":"en","width":2000,"height":3000},{"type":"poster","url":"https://image.tmdb.org/t/p/original/lgWL5wqoX9uJj04yJ2cwWueOwoy.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/lgWL5wqoX9uJj04yJ2cwWueOwoy.jpg","language":"en","width":800,"height":1200},{"type":"poster","url":"https://image.tmdb.org/t/p/original/gNyRGiBtHutdppMfeJRhgONqKbh.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/gNyRGiBtHutdppMfeJRhgONqKbh.jpg","language":"en","wi