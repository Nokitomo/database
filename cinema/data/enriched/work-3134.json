ia di casa e dei familiari. Decidono quindi di tornare sulla Terra per un'allegra rimpatriata. E, naturalmente, qui stupiscono tutti per le loro straordinarie manifestazioni di vitalità, prima di tornare nello spazio."},{"id":272657,"translatable_type":"title","translatable_id":13046,"locale":"it","key":"release_date","value":"1988-09-13"},{"id":272656,"translatable_type":"title","translatable_id":13046,"locale":"it","key":"slug","value":"cocoon-2-il-ritorno"},{"id":272659,"translatable_type":"title","translatable_id":13046,"locale":"it","key":"views","value":"3745"}],"keywords":[{"id":565,"name":"expectant mother","created_at":"2023-05-18T11:51:25.000000Z","updated_at":"2023-05-18T11:51:25.000000Z","pivot":{"title_id":13046,"keyword_id":565}},{"id":1555,"name":"pregnancy","created_at":"2023-05-18T11:56:18.000000Z","updated_at":"2023-05-18T11:56:18.000000Z","pivot":{"title_id":13046,"keyword_id":1555}},{"id":2362,"name":"pregnant wife","created_at":"2023-05-18T12:00:41.000000Z","updated_at":"2023-05-18T12:00:41.000000Z","pivot":{"title_id":13046,"keyword_id":2362}},{"id":4095,"name":"shape shifter","created_at":"2023-05-18T12:15:37.000000Z","updated_at":"2023-05-18T12:15:37.000000Z","pivot":{"title_id":13046,"keyword_id":4095}},{"id":4196,"name":"senior citizen","created_at":"2023-05-18T12:17:11.000000Z","updated_at":"2023-05-18T12:17:11.000000Z","pivot":{"title_id":13046,"keyword_id":4196}},{"id":6252,"name":"return","created_at":"2023-05-18T12:43:41.000000Z","updated_at":"2023-05-18T12:43:41.000000Z","pivot":{"title_id":13046,"keyword_id":6252}},{"id":6495,"name":"shape shifting alien","created_at":"2023-05-18T12:48:15.000000Z","updated_at":"2023-05-18T12:48:15.000000Z","pivot":{"title_id":13046,"keyword_id":6495}},{"id":8637,"name":"pregnant woman","created_at":"2023-05-18T13:33:12.000000Z","updated_at":"2023-05-18T13:33:12.000000Z","pivot":{"title_id":13046,"keyword_id":8637}},{"id":10885,"name":"adoring","created_at":"2024-04-23T02:16:04.000000Z","updated_at":"