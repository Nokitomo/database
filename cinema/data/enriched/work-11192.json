path":"/images/e6c5010b-cbe5-4a28-9973-be92c627691d.webp"}}}},{"number":2,"title":"Pensate che non veda CSI?","synopsis":"Il detective Denílson indaga su quanto successo alla madre di Liz. Durante una commemorazione per Patrícia, una banda irrompe nel condominio.","thumbnail":{"base":"streamingunity:images","path":"/images/88738acc-5ed1-4924-840d-b3177768372c.webp"},"metadataSources":{"streamingunity:5184":{"title":"Pensate che non veda CSI?","synopsis":"Il detective Denílson indaga su quanto successo alla madre di Liz. Durante una commemorazione per Patrícia, una banda irrompe nel condominio.","thumbnail":{"base":"streamingunity:images","path":"/images/88738acc-5ed1-4924-840d-b3177768372c.webp"}}}},{"number":3,"title":"Sono Patrícia Duque!","synopsis":"Liz inizia un'indagine tutta sua e stringe così amicizia con i residenti più famigerati del condominio. Poco dopo, finisce nel mirino del detective Denílson.","thumbnail":{"base":"streamingunity:images","path":"/images/22534720-78db-436d-8642-1442ac70673d.webp"},"metadataSources":{"streamingunity:5184":{"title":"Sono Patrícia Duque!","synopsis":"Liz inizia un'indagine tutta sua e stringe così amicizia con i residenti più famigerati del condominio. Poco dopo, finisce nel mirino del detective Denílson.","thumbnail":{"base":"streamingunity:images","path":"/images/22534720-78db-436d-8642-1442ac70673d.webp"}}}},{"number":4,"title":"Incendiaria","synopsis":"Denílson interroga Liz. Mentre Rayssa organizza uno spettacolo in piscina, una scoperta stravolge le indagini e porta a galla i segreti oscuri di Patrícia.","thumbnail":{"base":"streamingunity:images","path":"/images/92080ddd-c941-4d1b-9071-61f77b4f4cce.webp"},"metadataSources":{"streamingunity:5184":{"title":"Incendiaria","synopsis":"Denílson interroga Liz. Mentre Rayssa organizza uno spettacolo in piscina, una scoperta stravolge le indagini e porta a galla i segreti oscuri di Patrícia.","thumbnail":{"base":"streamingunity:images","path":"/images/92080ddd-c941-4d1b-9071-61f77b4f4cce.webp"}}}},{"number":5,"title":"Chiama Sandro","synopsis":"Liz trova nuove prove che cambiano completamente il corso delle indagini. Verônica si rivela profondamente coinvolta nella scomparsa di Patrícia.","thumbnail":{"base":"streamingunity:images","path":"/images/514a1bd5-1eb4-4253-9c19-6e7705a7a42c.webp"},"metadataSources":{"streamingunity:5184":{"title":"Chiama Sandro","synopsis":"Liz trova nuove prove che cambiano completamente il corso delle indagini. Verônica si rivela profondamente coinvolta nella scomparsa di Patrícia.","thumbnail":{"base":"streamingunity:images","path":"/images/514a1bd5-1eb4-4253-9c19-6e7705a7a42c.webp"}}}},{"number":6,"title":"Giocando con il fuoco","synopsis":"Un vecchio crimine è collegato a quanto avvenuto nell'appartamento di Patrícia. Verônica la aiuta a scomparire di nuovo... ma le due vanno incontro a una brutta sorpresa.","thumbnail":{"base":"streamingunity:images","path":"/images/657f753d-2cdd-4eef-b857-4008982e2a90.webp"},"metadataSources":{"streamingunity:5184":{"title":"Giocando con il fuoco","synopsis":"Un vecchio crimine è collegato a quanto avvenuto nell'appartamento di Patrícia. Verônica la aiuta a scomparire di nuovo... ma le due vanno incontro a una brutta sorpresa.","thumbnail":{"base":"streamingunity:images","path":"/images/657f753d-2cdd-4eef-b857-4008982e2a90.webp"}}}},{"number":7,"title":"È finita, Leia","synopsis":"Milene scopre il tradimento di Rayssa. Verônica confessa tutto riguardo all'incendio. Mentre Liz si prepara per il matrimonio, emerge la verità sulla sua famiglia.","thumbnail":{"base":"streamingunity:images","path":"/images/b8061654-322a-4846-8091-8485f4349168.webp"},"metadataSources":{"streamingunity:5184":{"title":"È finita, Leia","synopsis":"Milene scopre il tradimento di Rayssa. Verônica confessa tutto riguardo all'incendio. Mentre Liz si prepara per il matrimonio, emerge la verità sulla sua famiglia.","thumbnail":{"base":"streamingunity:images","path":"/images/b8061654-322a-4846-8091-8485f4349168.webp"}}}}],"images":[]}],"provenance":{},"warnings":[],"externalIdsEvidence":{"wikidata":{"source":"wikidata","sourceUrl":"https://www.wikidata.org/wiki/Q106546655","wikidataId":"Q106546655","tmdbId":134955,"type":"tv","imdbId":"tt13561292","tvdbId":391367}},"externalMedia":{"tmdb":{"source":"tmdb-api","id":134955,"type":"tv","sourceUrl":"https://www.themoviedb.org/tv/134955","fetchedAt":"2026-11-07T18:07:40.206Z","originalLanguage":"pt-BR","title":{"value":"Condominio Maldivas","language":"it-IT"},"originalTitle":"Maldivas","overview":{"value":"Liz si trasferisce da Goiania a Rio de Janeiro. Trova casa in un condominio noto come Maldivas. Sua madre è morta in un incendio che ha del misterioso e lei è giunta qui per indagare e ritrovare un certo legame con la sua memoria. Si ritroverà a immergersi in un universo ricco di personaggi alquanto particolari e unici. Tra loro vi è Milene, vera e propria regina di Maldivas, la cui vita matrimoniale è perfetta soltanto in apparenza. Spazio poi al chirurgo plastico Victor Hugo e Rayssa, ex cantante di axé diventata donna d’affari di grande successo. Kat è principalmente una madre a tempo pieno, che fa i conti con il marito, Gustavo, agli arresti domiciliari. Ci sono poi Veronica, un’estranea che non ha nulla in comune con le altre donne di Maldivas, e Miguel, fidanzato di Liz che viene dalla campagna. La protagonista proverà a portare avanti le indagini, sospettando un po’ di tutti, tenendosi alla larga dal detective Denilson, che non vuole che lei ficchi il naso.","language":"it-IT"},"startDate":"2022-06-15","endDate":"2022-06-15","status":"Canceled","rating":6.7,"ratingCount":31,"numberOfEpisodes":7,"numberOfSeasons":1,"genres":["Commedia","Dramma"],"countries":["Brazil"],"facts":{"Runtime":"30m"},"keywords":[],"networks":[{"id":213,"name":"Netflix","logo":"https://image.tmdb.org/t/p/original/wwemzKWzjKYJFfCeiB57q3r4Bcm.png"}],"socialLinks":{},"cast":[{"id":1622590,"name":"Bruna Marquezine","role":"Liz","profil