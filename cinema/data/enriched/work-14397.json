isser de hulp inroept van een duikersvereniging. Zo maakt hij kennis met de knappe Laura. Zijn nieuwe vriendin en zijn dochter komen uiteindelijk dichter bij de dader dan hijzelf..."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/vgCvwKbrYxfvIzZDlAK0ruMHUz5.jpg","background":"https://image.tmdb.org/t/p/original/cbo6XxLWVtZCJpKHx5IZ8C0q7OE.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":2093,"type":"movie","originalLanguage":"nl-NL","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/vgCvwKbrYxfvIzZDlAK0ruMHUz5.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/vgCvwKbrYxfvIzZDlAK0ruMHUz5.jpg","language":"it","width":1000,"height":1460},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/vgCvwKbrYxfvIzZDlAK0ruMHUz5.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/vgCvwKbrYxfvIzZDlAK0ruMHUz5.jpg","language":"it","width":1000,"height":1460},{"type":"poster","url":"https://image.tmdb.org/t/p/original/4zLoHg3Wq0bplkb4nYAoKp2PnGi.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/4zLoHg3Wq0bplkb4nYAoKp2PnGi.jpg","language":"it","width":1000,"height":1500}]},"en":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/uNPQUEd13n9fIDliOYfOyxfyY4Y.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/uNPQUEd13n9fIDliOYfOyxfyY4Y.jpg","language":"en","width":1500,"height":2250},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/uNPQUEd13n9fIDliOYfOyxfyY4Y.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/uNPQUEd13n9fIDliOYfOyxfyY4Y.jpg","language":"en","width":1500,"height":2250},{"type":"poster","url":"https://image.tmdb.org/t/p/original/rYM3ShiOUsM2vMVxsw4ZpAOdQKs.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/rYM3ShiOUsM2vMVxsw4ZpAOdQKs.jpg","language":"en","width":2000,"height":3000},{"type":"poster","url":"https://image.tmdb