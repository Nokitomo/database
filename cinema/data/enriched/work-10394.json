ounty Jailer"},{"id":71889,"name":"Michael Abbott Jr.","role":"Deputy","profile":"https://image.tmdb.org/t/p/original/af4hYV7WwEtL48eND0xDsdobJq9.jpg"},{"id":1647311,"name":"A. Smith Harrison","role":"Supreme Court Reporter","profile":"https://image.tmdb.org/t/p/original/z6DJ4TfWQBvLUfUz1Z5oIHrBP8N.jpg"},{"id":174106,"name":"Keith Flippen","role":"Press Conference Reporter","profile":"https://image.tmdb.org/t/p/original/cs9aNyWHNRYlnizulq0oST4EUJO.jpg"},{"id":2311212,"name":"Jason Alan Cook","role":"Soundman","profile":"https://image.tmdb.org/t/p/original/xjKPJYfaqYFJAZfntNDwtH0jdr6.jpg"},{"id":1158373,"name":"Lucas N. Hall","role":"Courtroom Spectator (uncredited)","profile":"https://image.tmdb.org/t/p/original/h5nm3zQHAzQRTQQPFos7K7dCCDd.jpg"},{"id":4441714,"name":"Benjamin Booker","role":"Shotgun Shack Musician #1"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","title":"Loving - L'amore deve nascere libero","overview":"Mildred e Richard Loving si amano e decidono di sposarsi. Niente di più normale se non fosse che lui è bianco e lei e nera e che ci troviamo nell'America segregazionista degli anni 50. Lo Stato della Virgina, dove i Loving hanno deciso di stabilirsi, li chiama davanti a un tribunale dove i due sono condannati alla reclusione, con la sospensione della pena a condizione che abbandonino la Virginia. Considerando la condanna come una violazione dei loro diritti civili, Richard e Milded iniziano una lunga e dura battaglia legale, arrivando fino alla Corte Suprema degli Stati Uniti cne nel 1967 annulla la decisione della Virginia. Da allora, la sentenza \"Loving contro Virginia\" diventa il simbolo del diritto di amare per tutti, senza alcuna distinzione.","tagline":"L'amore deve nascere libero"},{"language":"en-US","overview":"In 1958, in the state of Virginia, the idea of interracial marriage was not only considered to be immoral to many, it was also illegal. When Richard and Mildred fall in love, they are aware of the eyes staring at them and the words said behind their backs. It's when they get married, however, that words and looks become actions, and the two are arrested. The couple decide to take their case all of the way to the Supreme Court in order to fight for their love. Based on a true story.","tagline":"All love is created equal."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/sEkWKpkt5dS5ItV11JPGKc0jQ1D.jpg","background":"https://image.tmdb.org/t/p/original/zjvX2vJmm3f25JujVEp5DEu2eKi.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":339419,"type":"movie","originalLanguage":"en-US","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/sEkWKpkt5dS5ItV11JPGKc0jQ1D.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/sEkWKpkt5dS5ItV11JPGKc0jQ1D.jpg","language":"it","width":1200,"height":1800},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/sEkWKpkt5dS5ItV11JPGKc0jQ1D.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/sEkWKpkt5dS5ItV11JPGKc0jQ1D.jpg","language":"it","width":1200,"height":1800}]},"en":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/teNPeDIRGWxtvMaJsNa7lw5IgiL.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/teNPeDIRGWxtvMaJsNa7lw5IgiL.jpg","language":"en","width":2000,"height":3000},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/teNPeDIRGWxtvMaJsNa7lw5IgiL.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/teNPeDIRGWxtvMaJsNa7lw5IgiL.jpg","language":"en","width":2000,"height":3000},{"type":"poster","url":"https://image.tmdb.org/t/p/original/AkaHjeoRhBmpiWGZUwOEFeKiHeJ.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/AkaHjeoRhBmpiWGZUwOEFeKiHeJ.jpg","language":"en","width":2000,"height":3000},{"type":"poster","url":"https://image.tmdb.org/t/p/original/tUGgq6mc4u9l58du8uax1MdSdlm.jp