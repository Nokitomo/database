":"https://image.tmdb.org/t/p/original/iu7FrnrRhrlmPIwV7TpTELI5B9Y.jpg"},{"id":1787158,"name":"Igor Ogurtsov","profile":"https://image.tmdb.org/t/p/original/5W2xJmwiKs0SH2cpyxBye94kqRs.jpg"},{"id":2143526,"name":"Petr Sedláček"},{"id":1208633,"name":"Martin Cesar"},{"id":2220474,"name":"Sofya Markina","profile":"https://image.tmdb.org/t/p/original/wpCZMx2S2XtNZMsHifBQZb0kMVi.jpg"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","title":"Viy - La maschera del demonio","overview":"All'inizio del XVIII secolo il cartografo Jonathan Green intraprende un viaggio scientifico che dall'Europa lo conduce verso l'Oriente. Dopo aver attraversato la Transilvania e superato i Carpazi, si ritrova in un piccolo villaggio perso tra i boschi e circondato dalla nebbia. Le persone che lì vivono non somigliano a nessun altro popolo conosciuto e hanno scavato un profondo fossato che, secondo le loro convinzioni, li isolerebbe dal resto del mondo salvandoli dal male. Ignorano però che il male è già insito tra loro e che è in attesa dell'occasione giusta per venire fuori.","tagline":"Un viaggio avvincente nel cuore delle tenebre."},{"language":"en-US","title":"Forbidden Empire","overview":"Early 18th century. Cartographer Jonathan Green undertakes a scientific voyage from Europe to the East. Having passed through Transylvania and crossed the Carpathian Mountains, he finds himself in a small village lost in impassible woods. Nothing but chance and heavy fog could bring him to this cursed place. People who live here do not resemble any other people which the traveler saw before that. The villagers, having dug a deep moat to fend themselves from the rest of the world, share a naive belief that they could save themselves from evil, failing to understand that evil has made its nest in their souls and is waiting for an opportunity to gush out upon the world.","tagline":"The truth is in you"},{"language":"ru-RU","overview":"Начало XVIII века... Картограф Джонатан Грин совершает путешествие из Европы на Восток. Следуя через Трансильванию, он понимает, что заблудился. Изрядно поплутав в тумане, он оказывается в небольшом казацком поселении. Народ живет здесь в затворничестве, оградив себя от любых контактов с остальным миром. Что скрывают жители хутора? Чего боятся и почему прячутся? Ученый решает разгадать тайну, связанную с именем необыкновенного мифического создания — Вия. Древние славянские предания оживают…","tagline":"Не бойся..."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/86fs0wVtTjFCMKFkrXhpp0eooyn.jpg","background":"https://image.tmdb.org/t/p/original/d7SWh0taIIfWyO2Yuy2wrO6z6p6.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":208763,"type":"movie","originalLanguage":"ru-RU","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/86fs0wVtTjFCMKFkrXhpp0eooyn.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/86fs0wVtTjFCMKFkrXhpp0eooyn.jpg","language":"it","width":500,"height":750},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/86fs0wVtTjFCMKFkrXhpp0eooyn.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/86fs0wVtTjFCMKFkrXhpp0eooyn.jpg","language":"it","width":500,"height":750},{"type":"poster","url":"https://image.tmdb.org/t/p/original/knAXCousAEVpNgTckhgq0zFMJT3.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/knAXCousAEVpNgTckhgq0zFMJT3.jpg","language":"it","width":1400,"height":2100}]},"en":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/q0o9JQDp6PHY4zK0Aw1NHpyQyeo.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/q0o9JQDp6PHY4zK0Aw1NHpyQyeo.jpg","language":"en","width":1000,"height":1500},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/q0o9JQDp6PHY4zK0Aw1NHpyQyeo.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/q0o9JQDp6PHY4zK0Aw1NH