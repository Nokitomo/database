webp","type":"logo","lang":"it","imageable_type":"title","imageable_id":65463,"created_at":"2026-08-14T17:19:05.000000Z","updated_at":"2026-08-14T17:19:05.000000Z","original_url_field":null,"reference":{"base":"streamingunity:images","path":"/images/3c0df88b-beb1-4566-b22f-3d54bb589c36.webp"},"provider":"streamingunity"},{"id":793085,"filename":"13407c3b-6f84-4954-b1c2-dd630fdb51c9.webp","type":"cover_mobile","lang":"it","imageable_type":"title","imageable_id":65463,"created_at":"2026-08-14T17:19:04.000000Z","updated_at":"2026-08-14T17:19:04.000000Z","original_url_field":null,"reference":{"base":"streamingunity:images","path":"/images/13407c3b-6f84-4954-b1c2-dd630fdb51c9.webp"},"provider":"streamingunity"}],"episodeMappingUncertain":false,"seasons":[],"provenance":{},"warnings":[],"externalIdsEvidence":{"wikidata":{"source":"wikidata","sourceUrl":"https://www.wikidata.org/wiki/Q3359260","wikidataId":"Q3359260","tmdbId":60188,"type":"movie","imdbId":"tt0077465","tvdbId":46376}},"externalMedia":{"tmdb":{"source":"tmdb-api","id":60188,"type":"movie","sourceUrl":"https://www.themoviedb.org/movie/60188","fetchedAt":"2026-11-08T05:31:30.944Z","originalLanguage":"it-IT","title":{"value":"Where Are You Going on Holiday?","language":"en-US"},"originalTitle":"Dove vai in vacanza?","overview":{"value":"In \"Sarò tutta per te\" il dentista Enrico, lasciato dall'amante all'inizio delle vacanze, riesce a farsi invitare dall'ex moglie Giuliana. Ma la sua voglia di sesso è frustrata prima dalle confidenze erotiche di lei, poi da ospiti inattesi tra cui tre amiche femministe, infine dall'ex compagno di Giuliana, il depresso Armando. E l'eros di Enrico inizia a latitare. In \"Sì buana\" l'ex animatore di safari Arturo si fa  convincere da uno sconosciuto a raccontare di quella volta in cui una turista l'aveva coinvolto durante una battuta di caccia al leone nell'assassinio del suo amante. In \"Le vacanze intelligenti\" i figli universitari organizzano delle vacanze intelligenti e dimagranti per i due genitori fruttaroli, Romeo e Augusta: visita alle tombe etrusche, soggiorno depurativo a Montecatini, concerto di musica moderna a Firenze e visita finale alla Biennale d'arte di Venezia, dove per recuperare lo stress finiranno per strafogarsi in un ristorante.","language":"it-IT"},"releaseDate":"1978-12-21","status":"Released","rating":5.8,"ratingCount":85,"genres":["Commedia"],"countries":["Italy"],"facts":{"Runtime":"153m"},"keywords":[],"networks":[],"socialLinks":{},"cast":[{"id":32312,"name":"Ugo Tognazzi","role":"Enrico (episodio \"Sarò tutta per te\")","profile":"https://image.tmdb.org/t/p/original/oHnqb2oEWbUfAPuU2P351HNGRX7.jpg"},{"id":27433,"name":"Paolo Villaggio","role":"Arturo (episodio \"Si Buana\")","profile":"https://image.tmdb.org/t/p/original/teLgBlbIGoToECSfwwkjaehPUPr.jpg"},{"id":45982,"name":"Alberto Sordi","role":"Remo Proietti (episodio \"Le vacanze intelligenti\")","profile":"https://image.tmdb.org/t/p/original/xXCk1HKZM9MGUmQcorjuEV2vOI5.jpg"},{"id":34027,"name":"Stefania Sandrelli","role":"Giuliana (episodio \"Sarò tutta per te\")","profile":"https://image.tmdb.org/t/p/original/FgC2JtlrNTMs0nCs6C6BADg7lb.jpg"},{"id":41160,"name":"Anna Maria Rizzoli","role":"Margherita (episodio \"Si Buana\")","profile":"https://image.tmdb.org/t/p/original/hNZxckwxy4KvN4R5GYw0yQU1Ydh.jpg"},{"id":39020,"name":"Daniele Vargas","role":"Cavalier Colombi (episodio \"Si Buana\")","profile":"https://image.tmdb.org/t/p/original/fb5Qgqt8I4i0tNjAEcEsGemiMwl.jpg"},{"id":106346,"name":"Gigi Reder","role":"Dottor Panunti (episodio \"Si Buana\")","profile":"https://image.tmdb.org/t/p/original/8HPNYzMcLgIBaf2BYlovYjnBcOp.jpg"},{"id":15919,"name":"Anna Longhi","role":"Augusta Proietti (episodio \"Le vacanze intelligenti\")","profile":"https://image.tmdb.org/t/p/original/5LlM38HBCM0ydwOaqx6qp0K6EYs.jpg"},{"id":1041292,"name":"Pietro Brambilla","role":"Tommaso Enrico (episodio \"Sarò tutta per te\")","profile":"https://image.tmdb.org/t/p/original/iDBd3kapOX