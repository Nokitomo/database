ici cercano di impedire ad Alonzo Hawk di perseguire il suo sciagurato progetto."},{"id":834747,"translatable_type":"title","translatable_id":52555,"locale":"it","key":"slug","value":"herbie-il-maggiolino-sempre-piu-matto"}],"keywords":[{"id":75,"name":"sequel","created_at":"2023-05-18T11:48:55.000000Z","updated_at":"2023-05-18T11:48:55.000000Z","pivot":{"title_id":52555,"keyword_id":75}},{"id":1880,"name":"shopping mall","created_at":"2023-05-18T11:57:59.000000Z","updated_at":"2023-05-18T11:57:59.000000Z","pivot":{"title_id":52555,"keyword_id":1880}},{"id":9797,"name":"urban development","created_at":"2023-12-18T19:44:05.000000Z","updated_at":"2023-12-18T19:44:05.000000Z","pivot":{"title_id":52555,"keyword_id":9797}},{"id":9871,"name":"estate agent","created_at":"2023-12-24T11:47:03.000000Z","updated_at":"2023-12-24T11:47:03.000000Z","pivot":{"title_id":52555,"keyword_id":9871}},{"id":10055,"name":"san francisco, california","created_at":"2024-01-20T15:38:08.000000Z","updated_at":"2024-01-20T15:38:08.000000Z","pivot":{"title_id":52555,"keyword_id":10055}}]}}]},"images":[{"id":629097,"filename":"ec131478-8914-4ad5-b6a1-891222031052.webp","type":"poster","lang":"it","imageable_type":"title","imageable_id":52555,"created_at":"2026-01-28T17:13:04.000000Z","updated_at":"2026-01-28T17:13:04.000000Z","original_url_field":null,"reference":{"base":"streamingunity:images","path":"/images/ec131478-8914-4ad5-b6a1-891222031052.webp"},"provider":"streamingunity"},{"id":629095,"filename":"34e35a71-27af-45ef-8a9d-cee90986ddcb.webp","type":"cover","lang":"it","imageable_type":"title","imageable_id":52555,"created_at":"2026-01-28T17:13:03.000000Z","updated_at":"2026-01-28T17:13:03.000000Z","original_url_field":null,"reference":{"base":"streamingunity:images","path":"/images/34e35a71-27af-45ef-8a9d-cee90986ddcb.webp"},"provider":"streamingunity"},{"id":629090,"filename":"18f9a5f2-5034-409c-a21e-3d9bbe96dd67.webp","type":"background","lang":null,"imageable_type":"title","imageable_id"