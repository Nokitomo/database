db.org/t/p/original/2GCL9sKb5YuK7kgtdRQOMx9oZ8c.jpg"},{"id":209579,"name":"Eleanor Wyld","role":"Marie","profile":"https://image.tmdb.org/t/p/original/24wglAYXmyfYR5GqQstsy8XuiXU.jpg"},{"id":1312169,"name":"Owen Pugh","role":"Theo"},{"id":109333,"name":"David Broughton-Davies","role":"Strauss","profile":"https://image.tmdb.org/t/p/original/cJMOifFhwG3PigQvlxnGlITbWoi.jpg"},{"id":1016065,"name":"Emma Powell","role":"Miss Anderson","profile":"https://image.tmdb.org/t/p/original/hTtP8QifmE20NIofep03LyoatJp.jpg"},{"id":1312170,"name":"David Barnaby","role":"Mr. Fortune"},{"id":1312166,"name":"Dylan Llewellyn","role":"Zak (Teen)","profile":"https://image.tmdb.org/t/p/original/vZW7jsiSpMTzv75JPyBnyBHrYM0.jpg"},{"id":1312168,"name":"Georgina Minter-Brown","role":"Marie (Teen)","profile":"https://image.tmdb.org/t/p/original/dtdw3zyb6F6XFGdlfTFFOoP9pgK.jpg"},{"id":79936,"name":"Timothy Block","role":"Bridges"},{"id":1312172,"name":"Ria Carroll","role":"Nicola Tesla"},{"id":1312173,"name":"Tom England","role":"Theo (Teen)","profile":"https://image.tmdb.org/t/p/original/aGNkfDWfNMFKt4t6ibIdT1kIfrs.jpg"},{"id":47570,"name":"Joanna Hole","role":"Headmistress"},{"id":1154760,"name":"Lily Laight","role":"Marie (Child)","profile":"https://image.tmdb.org/t/p/original/rUkxrrauIF17txhTLhI6LYIPcdi.jpg"},{"id":3324854,"name":"Freddie Rose","role":"Child Thomas Edison","profile":"https://image.tmdb.org/t/p/original/hIM9zZYDYG2OXsNiDE8TeFqu2Ju.jpg"},{"id":2889581,"name":"Doris Zajer","role":"Mrs. Fortune"},{"id":4435750,"name":"Charlie Rixon","role":"Zak (Child)"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","overview":"In un mondo non definito nel tempo e nello spazio Zak e Marie si incontrano da bambini (i bambini della scuola che frequentano hanno tutti nomi di scienziati famosi, lui si chiama in realtà Isaac Newton e lei Marie Curie). Zak si innamora subito di Marie ma lei non ricambia, almeno apparentemente, perché una differenza basilare glielo impedisce. Lei corrisponde a una 'frequenza' altissima, lui bassissima: sono perciò incompatibili e se si incrociano per più di un minuto scatenano eventi violenti e assurdi. Inoltre, mentre la frequenza bassissima di lui si concretizza in un'estrema passionalità, nel caso di Marie è lei stessa a definirsi \"The Machine\", perché non prova emozioni (nemmeno nei confronti dei suoi familiari) e per mascherare questa incapacità finge costantemente, prendendo appunti sulle emozioni altrui e facendo esperimenti."},{"language":"en-US","overview":"The story of the forbidden relationship between a 'low born' boy and a 'high born' girl in an alternate reality where every person's relationships and life worth are determined by their innate 'frequencies'.","tagline":"It changes everything."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/5FdXcYLG40eve6UoZ8nMlNYH0bh.jpg","background":"https://image.tmdb.org/t/p/original/71TAboo7x1IQn45CmWWfRn6aDAP.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":218425,"type":"movie","originalLanguage":"en-US","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/5FdXcYLG40eve6UoZ8nMlNYH0bh.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/5FdXcYLG40eve6UoZ8nMlNYH0bh.jpg","language":"it","width":935,"height":1336},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/5FdXcYLG40eve6UoZ8nMlNYH0bh.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/5FdXcYLG40eve6UoZ8nMlNYH0bh.jpg","language":"it","width":935,"height":1336}]},"en":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/oAq4JsymeYtQHK5IqExvpBQEu4m.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/oAq4JsymeYtQHK5IqExvpBQEu4m.jpg","language":"en","width":1000,"height":1500},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/oAq4Jsy