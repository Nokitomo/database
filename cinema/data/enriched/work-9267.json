a son cómplices en mayor o menor grado de los crímenes del clan y viven de los beneficios obtenidos de los rescates que pagan los familiares de los secuestrados.","tagline":"El crimen era un asunto de familia."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/ee3Aqqlm13cGFRNxpKTd1HW1DcT.jpg","background":"https://image.tmdb.org/t/p/original/wbA13Xns8EtbIubDOPLl7kCYYA4.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":352161,"type":"movie","originalLanguage":"es-ES","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/ee3Aqqlm13cGFRNxpKTd1HW1DcT.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/ee3Aqqlm13cGFRNxpKTd1HW1DcT.jpg","language":"it","width":1000,"height":1500},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/ee3Aqqlm13cGFRNxpKTd1HW1DcT.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/ee3Aqqlm13cGFRNxpKTd1HW1DcT.jpg","language":"it","width":1000,"height":1500},{"type":"poster","url":"https://image.tmdb.org/t/p/original/oyrkrKGT8nIcgON1rNosxhhV6sJ.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/oyrkrKGT8nIcgON1rNosxhhV6sJ.jpg","language":"it","width":620,"height":930},{"type":"poster","url":"https://image.tmdb.org/t/p/original/fckx7k9wdfPkm3EshwrbWtn25BJ.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/fckx7k9wdfPkm3EshwrbWtn25BJ.jpg","language":"it","width":1400,"height":2100},{"type":"poster","url":"https://image.tmdb.org/t/p/original/vTAhMhuNsMmhutDVu53RBOaOQom.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/vTAhMhuNsMmhutDVu53RBOaOQom.jpg","language":"it","width":2000,"height":3000}]},"en":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/m6iPqGhtIAgGRQcfqxSYbRrlK3F.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/m6iPqGhtIAgGRQcfqxSYbRrlK3F.jpg","language":"en","width":2000,"height":3000},"candidates":[{"type":"poste