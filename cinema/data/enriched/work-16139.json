135c.webp"},"provider":"streamingunity"}],"episodeMappingUncertain":false,"seasons":[],"provenance":{},"warnings":[],"externalIdsEvidence":{"wikidata":{"source":"wikidata","sourceUrl":"https://www.wikidata.org/wiki/Q123677822","wikidataId":"Q123677822","tmdbId":878424,"type":"movie","imdbId":"tt15979222","tvdbId":318412}},"externalMedia":{"tmdb":{"source":"tmdb-api","id":878424,"type":"movie","sourceUrl":"https://www.themoviedb.org/movie/878424","fetchedAt":"2026-11-08T09:08:17.508Z","originalLanguage":"en-US","title":{"value":"Un Natale di cuore","language":"it-IT"},"originalTitle":"A Kindhearted Christmas","overview":{"value":"Jamie è titolare di un'agenzia di viaggi e visite guidate nella piccola cittadina di Cooperville, nello Stato di New York. Affrontare le festività natalizie con entusiasmo è più difficile per Jamie da quando suo marito Matt è venuto a mancare. Matt amava il Natale e provava una gioia immensa nel fare regali agli altri. Mentre rivive i ricordi con la famiglia, Jamie si rende conto che la città ha un disperato bisogno di qualcuno con la stessa genialità di Matt nel pensare a quei piccoli gesti che regalano vera felicità durante le festività.","language":"it-IT"},"releaseDate":"2021-11-20","status":"Released","rating":6.1,"ratingCount":71,"genres":["televisione film","Commedia","Romance"],"countries":["United States of America"],"facts":{"Runtime":"85m"},"keywords":[],"networks":[],"socialLinks":{},"cast":[{"id":1212139,"name":"Jennie Garth","role":"Jamie Monroe","profile":"https://image.tmdb.org/t/p/original/nqgP9o12FNDOeON6bfbnN8pvb72.jpg"},{"id":33669,"name":"Cameron Mathison","role":"Scott Morris","profile":"https://image.tmdb.org/t/p/original/eJQPwuq2Hpcn6GySKpgpbGwZT4.jpg"},{"id":59181,"name":"Emily Tennant","role":"Kylie Monroe","profile":"https://image.tmdb.org/t/p/original/feZDxU3OB9rJjqH3g7a3zH88mkG.jpg"},{"id":129986,"name":"Bronwen Smith","role":"Colleen","profile":"https://image.tmdb.org/t/p/original/eakVZe6yoBqMBYOHp2lPtXCexTv.jpg