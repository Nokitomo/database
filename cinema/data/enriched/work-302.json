el, è solo un altro giorno di lavoro per l'ispettore Tyador Borlú dell'Extreme Crime Squad.  Ma scopre le prove che la ragazza assassinata proveniva da Ul Qoma, una città che condivide una relazione pericolosa e instabile con Besźel, e questo caso sfiderà tutto ciò che Borlú ha di più caro.","poster":{"base":"streamingunity:images","path":"/images/7e71c7c1-14e2-4354-9166-28c42bbbd5c0.webp"},"background":{"base":"streamingunity:images","path":"/images/07c13110-634e-4ad5-bb34-7c6253ab149b.webp"},"logo":{"base":"streamingunity:images","path":"/images/1dba5d7c-50ba-466f-a4c9-26a406be9d7b.webp"},"rating":5.9,"cast":[{"id":53917,"name":"Danny Webb","role":"Major Syedr","profile":"https://image.tmdb.org/t/p/original/e7OhVUIsfGWYIrYxwD1KEWF7afP.jpg"},{"id":213083,"name":"Lara Pulver","role":"Katrynia Borlú","profile":"https://image.tmdb.org/t/p/original/uacMDTL4YnuJD6frGF35CHLFh43.jpg"},{"id":1399747,"name":"Mandeep Dhillon","role":"Constable Corwi","profile":"https://image.tmdb.org/t/p/original/rVlSWINjaCMFWqkHpkjYy3zECka.jpg"},{"id":18616,"name":"David Morrissey","role":"Tyador Borlú","profile":"https://image.tmdb.org/t/p/original/gj7ENB9pBobXA3wMfw6uKcWr2GM.jpg"},{"id":5319,"name":"Ron Cook","role":"Commissar Gadlem","profile":"https://image.tmdb.org/t/p/original/gRHsTI9gwajULovSd2TVHROEEMj.jpg"},{"id":22686,"name":"Maria Schrader","role":"Senior Detective Dhatt"},{"id":122029,"name":"Christian Camargo","role":"Doctor Bowden","profile":"https://image.tmdb.org/t/p/original/7smKRlZUxTJqt1smgarwzzks684.jpg"},{"id":4458,"name":"Paprika Steen","role":"Professor Mona Ul-Nadi","profile":"https://image.tmdb.org/t/p/original/c0OSsG2akVhYMOrCd3EYNGY4AuN.jpg"}],"runtime":60},"providers":{"streamingunity":[{"id":10292,"path":"/it/titles/10292-the-city-and-the-city","availability":"present","seasons":[{"id":6211,"number":1,"name":null,"plot":"","release_date":null,"title_id":10292,"created_at":"2024-10-26T20:25:47.000000Z","updated_at":"2025-05-12T09:58:40.000000Z","release_date_it":null,"translations":[],"episodes":[{"id":79710,"number":1,"name":"Besźel","plot":"Una ragazza morta viene trovata al confine tra Besźel e Ul Qoma, due città in guerra tra loro. Ispettore della Squadra Crimini Estremi, Tyador Borlú segue il caso. Mentre gli unificazionisti protestano per un'unica città, Borlú riceve una telefonata da qualcuno che identifica la ragazza morta: è Mahalia Geary, una studentessa americana che aveva scoperto qualcosa di losco...","duration":58,"scws_id":267676,"season_id":6211,"created_at":"2024-10-26T20:25:55.000000Z","updated_at":"2025-11-05T08:40:25.000000Z","quality":"HD","audio_orig":1,"dub_ita":1,"sub_ita":0,"uploaded_at":"2024-10-26 22:25:55","images":[{"id":139112,"filename":"ff15e291-d5f5-4385-905c-9e7c984be9e9.webp","type":"cover","lang":null,"imageable_type":"episode","imageable_id":79710,"created_at":"2024-10-26T20:25:56.000000Z","updated_at":"2024-10-26T20:25:56.000000Z","original_url_field":null,"reference":{"base":"streamingunity:images","path":"/images/ff15e291-d5f5-4385-905c-9e7c984be9e9.webp"}}],"translations":[{"id":235692,"translatable_type":"episode","translatable_id":79710,"locale":"it","key":"name","value":"Besźel"},{"id":235693,"translatable_type":"episode","translatable_id":79710,"locale":"it","key":"plot","value":"Una ragazza morta viene trovata al confine tra Besźel e Ul Qoma, due città in guerra tra loro. Ispettore della Squadra Crimini Estremi, Tyador Borlú segue il caso. Mentre gli unificazionisti protestano per un'unica città, Borlú riceve una telefonata da qualcuno che identifica la ragazza morta: è Mahalia Geary, una studentessa americana che aveva scoperto qualcosa di losco..."}]},{"id":79711,"number":2,"name":"Ul Qoma","plot":"Dopo aver tentato di entrare illegalmente a Ul Qoma, il signor Geary viene preso e espulso da Beszel. Borlú è alla ricerca del contatto di Geary, ma è fuori dalla sua giurisdizione. Il maggiore Syedr guida i Veri Cittadini, il gruppo nazionalista di estrema destra di Besźel. Borlú pensa che sia coinvolto nella morte di Mahalia, che nasconda qualcosa e sappia più di quanto lascia intendere.","duration":59,"scws_id":267650,"season_id":6211,"created_at":"2024-10-26T20:26:02.000000Z","updated_at":"2025-11-05T08:40:25.000000Z","quality":"HD","audio_orig":1,"dub_ita":1,"sub_ita":0,"uploaded_at":"2024-10-26 22:26:02","images":[{"id":139113,"filename":"5231d1cc-7227-4f1a-be16-ba0bd17ef22a.webp","type":"cover","lang":null,"imageable_type":"episode","imageable_id":79711,"created_at":"2024-10-26T20:26:03.000000Z","updated_at":"2024-10-26T20:26:03.000000Z","original_url_field":null,"reference":{"base":"streamingunity:images","path":"/images/5231d1cc-7227-4f1a-be16-ba0bd17ef22a.webp"}}],"translations":[{"id":235694,"translatable_type":"episode","translatable_id":79711,"locale":"it","key":"name","value":"Ul Qoma"},{"id":235695,"translatable_type":"episode","translatable_id":79711,"locale":"it","key":"plot","value":"Dopo aver tentato di entrare illegalmente a Ul Qoma, il signor Geary viene preso e espulso da Beszel. Borlú è alla ricerca del contatto di Geary, ma è fuori dalla sua giurisdizione. Il maggiore Syedr guida i Veri Cittadini, il gruppo nazionalista di estrema destra di Besźel. Borlú pensa che sia coinvolto nella morte di Mahalia, che nasconda qualcosa e sappia più di quanto lascia intendere."}]},{"id":79712,"number":3,"name":"Orciny","plot":"Yolanda, è scomparsa: è lei che il signor Geary stava cercando di incontrare? È lei che ha chiamato Borlú da Ul Qoma? Borlú e Dhatt incontrano il supervisore di Mahalia, la professoressa Ul-Nadi. Mahalia credeva nel lavoro di David Bowden il quale avanzò l'idea che ci fosse una terza città nascosta chiamata Orciny. Borlú vuole trovare Bowden: potrebbe sapere cosa è successo a Mahalia.","duration":59,"scws_id":267651,"season_id":6211,"created_at":"2024-10-26T20:26:09.000000Z","updated_at":"2025-11-05T08:40:25.000000Z","quality":"HD","audio_orig":1,"dub_ita":1,"sub_ita":0,"uploaded_at":"2024-10-26 22:26:09","images":[{"id":139114,"filename":"88ace8ae-bf64-44d4-be96-de268f8024fa.webp","type":"cover","lang":null,"imageable_type":"episode","imageable_id":79712,"created_at":"2024-10-26T20:26:09.000000Z","updated_at":"2024-10-26T20:26:09.000000Z","original_url_field":null,"reference":{"base":"streamingunity:images","path":"/images/88ace8ae-bf64-44d4-be96-de268f8024fa.webp"}}],"translations":[{"id":235696,"translatable_type":"episode","translatable_id":79712,"locale":"it","key":"name","value":"Orciny"},{"id":235697,"translatable_type":"episode","translatable_id":79712,"locale":"it","key":"plot","value":"Yolanda, è scomparsa: è lei che il signor Geary stava cercando di incontrare? È lei che ha chiamato Borlú da Ul Qoma? Borlú e Dhatt incontrano il supervisore di Mahalia, la professoressa Ul-Nadi. Mahalia credeva nel lavoro di David Bowden il quale avanzò l'idea che ci fosse una terza città nascosta chiamata Orciny. Borlú vuole trovare Bowden: potrebbe sapere cosa è successo a Mahalia."}]},{"id":79713,"number":4,"name":"La violazione","plot":"Borlú pensa che, Aikham, stia nascondendo qualcosa. Con Dhatt vanno a Bisham Ko, l'area che lasciano fuori dalle mappe di Ul Qoma. Borlú e Dhatt trovano Yolanda nascosta con un gruppo di unificazionisti illegali. Mahalia stava aiutando la gente di Orciny, si fidava di loro, e Yolanda pensa che Orciny governi tutto. Borlú vuole portare Yolanda fuori da Ul Qoma e al sicuro.","duration":59,"scws_id":267677,"season_id":6211,"created_at":"2024-10-26T20:26:19.000000Z","updated_at":"2025-11-05T08:40:25.000000Z","quality":"HD","audio_orig":1,"dub_ita":1,"sub_ita":0,"uploaded_at":"2024-10-26 22:26:19","images":[{"id":139115,"filename":"e2260c8f-1d8d-49a8-8d83-8dd5665a33d7.webp","type":"cover","lang":null,"imageable_type":"episode","imageable_id":79713,"created_at":"2024-10-26T20:26:20.000000Z","updated_at":"2024-10-26T20:26:20.000000Z","original_url_field":null,"reference":{"base":"streamingunity:images","path":"/images/e2260c8f-1d8d-49a8-8d83-8dd5665a33d7.webp"}}],"translations":[{"id":235698,"translatable_type":"episode","translatable_id":79713,"locale":"it","key":"name","value":"La violazione"},{"id":235699,"translatable_type":"episode","translatable_id":79713,"locale":"it","key":"plot","value":"Borlú pensa che, Aikham, stia nascondendo qualcosa. Con Dhatt vanno a Bisham Ko, l'area che lasciano fuori dalle mappe di Ul Qoma. Borlú e Dhatt trovano Yolanda nascosta con un gruppo di unificazionisti illegali. Mahalia stava aiutando la gente di Orciny, si fidava di loro, e Yolanda pensa che Orciny governi tutto. Borlú vuole portare Yolanda fuori da Ul Qoma e al sicuro."}]}],"path":"/it/titles/10292-the-city-and-the-city/season-1","images":[]}],"info":{"id":10292,"name":"The City and the City","slug":"the-city-and-the-city","plot":"Quando il corpo di uno studente straniero viene scoperto per le strade della squallida città di Besźel, è solo un altro giorno di lavoro per l'ispettore Tyador Borlú dell'Extreme Crime Squad.  Ma scopre le prove che la ragazza assassinata proveniva da Ul Qoma, una città che condivide una relazione pericolosa e instabile con Besźel, e questo caso sfiderà tutto ciò che Borlú ha di più caro.","quality":"HD","type":"tv","original_name":"The City and the City","original_language":"en","status":"Ended","runtime":null,"views":17469,"daily_views":1,"score":"6.9","tmdb_id":78317,"imdb_id":"tt7205264","netflix_id":null,"prime_id":null,"scws_id":null,"public":1,"release_date":"2018-04-06","last_air_date":"2018-04-06","sub_ita":0,"dub_ita":1,"created_at":"2024-10-26T20:25:35.000000Z","updated_at":"2026-10-31T05:00:00.000000Z","disney_id":null,"now_id":null,"apple_id":null,"paramount_id":null,"age":null,"audio_orig":1,"release_date_it":"2018-04-06","last_air_date_it":"2018-04-06","uploaded_at":null,"views_it":17469,"daily_views_it":1,"hbo_id":null,"seasons_count":1,"coming_soon":false,"trailers":[],"genres":[{"id":1,"name":"Dramma","type":"all","hidden":0,"created_at":"2023-05-18T11:48:43.000000Z","upd