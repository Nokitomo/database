e":"wikidata","sourceUrl":"https://www.wikidata.org/wiki/Q63440669","wikidataId":"Q63440669","tmdbId":89171,"type":"tv","imdbId":"tt8476166","tvdbId":348587}},"externalMedia":{"tmdb":{"source":"tmdb-api","id":89171,"type":"tv","sourceUrl":"https://www.themoviedb.org/tv/89171","fetchedAt":"2026-11-08T18:06:07.977Z","originalLanguage":"es-ES","title":{"value":"La brigata Costa del Sol","language":"it-IT"},"originalTitle":"Brigada Costa del Sol","overview":{"value":"Quattro agenti intrepidi e impulsivi creano un'unità speciale antinarcotici per combattere la nascita del traffico di droga sulla Costa del Sol spagnola negli anni '70.","language":"it-IT"},"startDate":"2019-05-06","endDate":"2019-07-22","status":"Ended","rating":6.5,"ratingCount":20,"numberOfEpisodes":13,"numberOfSeasons":1,"genres":["Action & Adventure","Dramma","Crime"],"countries":["Spain"],"facts":{"Runtime":"70m"},"keywords":[],"networks":[{"id":53,"name":"Telecinco","logo":"https://image.tmdb.org/t/p/original/nSksjyoitz94qhfon6uzJj6ekj9.png"},{"id":378,"name":"Cuatro","logo":"https://image.tmdb.org/t/p/original/pZtmQfr0z82ODDxZsqGzORZJJux.png"}],"socialLinks":{},"cast":[{"id":1167672,"name":"Sara Sálamo","role":"Yolanda 'La Buhíta'","profile":"https://image.tmdb.org/t/p/original/oFCyXMAZktpOpxnUyjPfLiWdE2i.jpg"},{"id":112901,"name":"Hugo Silva","role":"Bruno López","profile":"https://image.tmdb.org/t/p/original/aMhffSrBefGQstniOtsJf3kEfNH.jpg"},{"id":224874,"name":"Álvaro Cervantes","role":"Leo Villa","profile":"https://image.tmdb.org/t/p/original/6RAiI4SXIMxLRM1RejLJzMPK7wa.jpg"},{"id":1354964,"name":"Miki Esparbé","role":"Martín Pulido","profile":"https://image.tmdb.org/t/p/original/aoDKG2LSN9JKTKwntpD8AzyVwuf.jpg"},{"id":2025663,"name":"Carolina Yuste","role":"Sole","profile":"https://image.tmdb.org/t/p/original/WbPX1SzFmAEaF4ioMEwgumvqzW.jpg"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","title":"La brigata Costa del Sol","overview":"Quattro agenti intrepidi e impulsivi creano un'unità speciale antinarcotici per combattere la nascita del traffico di droga sulla Costa del Sol spagnola negli anni '70."},{"language":"en-US","title":"Drug Squad: Costa del Sol","overview":"Four intrepid and impulsive police officers form a special narcotics unit to combat the birth of drug trafficking on Spain's Costa del Sol in the 1970s."},{"language":"es-ES","overview":"Torremolinos, 1977. Un equipo de policías comienza a trabajar en el Grupo Especial de Estupefacientes Costa del Sol para combatir los delitos relacionados con el narcotráfico que se están cometiendo en la zona. Tienen muy pocos medios, mucho ingenio y el valor necesario para hacer frente a situaciones de máximo peligro. Sus espectaculares resultados pronto les convertirán en los policías más laureados de Europa.\n\nTres décadas después, la labor de este equipo servirá de inspiración a las tramas que vertebrarán Brigada Costa del Sol, una serie que combinará el género policíaco con el drama y el romance y que contará con una narrativa muy personal, en la que la voz en off del protagonista marcará el relato de la historia con un punto de vista subjetivo y cínico que servirá como contrapunto a la dureza de las situaciones a las que se enfrentará la unidad policial."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/z4dbQVKJjElrHY4PSSc7jaNrZvY.jpg","background":"https://image.tmdb.org/t/p/original/uxdAP2lUzVGR3gxlJhOYRE6vncJ.jpg","seasons":[{"seasonNumber":1,"name":{"value":"Stagione 1","language":"it-IT"},"year":2019,"episodeCount":13,"poster":"https://image.tmdb.org/t/p/original/rKKHMLBx3fvC1T5c0fONWk7fCcR.jpg","posters":[],"backgrounds":[],"sourceUrl":"https://www.themoviedb.org/tv/89171/season/1"}],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":89171,"type":"tv","originalLanguage":"es-ES","series":{"poster":{"it":{"status":"missing","candidates":[]},"en":{"status":"available","se