":2064633,"name":"Giustiniano Alpi","role":"Liberale"},{"id":128753,"name":"Orfeo Orlando","role":"Vita","profile":"https://image.tmdb.org/t/p/original/wcNJQTGnz1aHzGTqKAyKpSvxlkE.jpg"},{"id":1139380,"name":"Federica Fracassi","role":"Anziana","profile":"https://image.tmdb.org/t/p/original/mnhpoafRQjFvriQVHYiVkpCyC1h.jpg"},{"id":3441584,"name":"Giulia Quadrelli","role":"Giovane"},{"id":1201286,"name":"Renato Sarti","role":"Rettore","profile":"https://image.tmdb.org/t/p/original/7efq3oImV8qZTi869hicxG965LZ.jpg"},{"id":4086180,"name":"Flavia Baiku","role":"Simone"},{"id":2929117,"name":"Tonino Tosto","role":"Tagliacozzo"},{"id":4086182,"name":"Christian Mudu","role":"Elia"},{"id":4086186,"name":"Riccardo Bandiera","role":"Aronne"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","overview":"Nel 1858, nel quartiere ebraico di Bologna, i soldati del Papa irrompono nella casa della famiglia Mortara. Per ordine del cardinale, sono andati a prendere Edgardo, il loro figlio di sette anni. Secondo le dichiarazioni di una domestica, ritenuto in punto di morte, a sei mesi, il bambino era stato segretamente battezzato. La legge papale è inappellabile: deve ricevere un'educazione cattolica. I genitori di Edgardo, sconvolti, faranno di tutto per riavere il figlio. Sostenuta dall'opinione pubblica e dalla comunità ebraica internazionale, la battaglia dei Mortara assume presto una dimensione politica. Ma il Papa non accetta di restituire il bambino. Mentre Edgardo cresce nella fede cattolica, il potere temporale della Chiesa volge al tramonto e le truppe sabaude conquistano Roma."},{"language":"en-US","title":"Kidnapped","overview":"The story of Edgardo Mortara, a young Jewish boy living in Bologna, Italy, who in 1858, after being secretly baptized, was forcibly taken from his family to be raised as a Christian. His parents’ struggle to free their son became part of a larger political battle that pitted the papacy against forces of democracy and Italian unification."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/tFGQpFRzj9imHe3sKEph8b3e4LT.jpg","background":"https://image.tmdb.org/t/p/original/12GAm3EiHUUeCB5mk3NphURUh1R.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":801112,"type":"movie","originalLanguage":"it-IT","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/tFGQpFRzj9imHe3sKEph8b3e4LT.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/tFGQpFRzj9imHe3sKEph8b3e4LT.jpg","language":"it","width":2000,"height":3000},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/tFGQpFRzj9imHe3sKEph8b3e4LT.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/tFGQpFRzj9imHe3sKEph8b3e4LT.jpg","language":"it","width":2000,"height":3000},{"type":"poster","url":"https://image.tmdb.org/t/p/original/oSqxr6PRPC4jxIkD6al07W29KRh.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/oSqxr6PRPC4jxIkD6al07W29KRh.jpg","language":"it","width":1050,"height":1500},{"type":"poster","url":"https://image.tmdb.org/t/p/original/pu1uLeMQtWqEtXfRopybQ78qLBG.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/pu1uLeMQtWqEtXfRopybQ78qLBG.jpg","language":"it","width":1334,"height":2000},{"type":"poster","url":"https://image.tmdb.org/t/p/original/weRV0kSSLdH3HEhXOJh1dzhgSiO.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/weRV0kSSLdH3HEhXOJh1dzhgSiO.jpg","language":"it","width":1334,"height":2000}]},"en":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/3CJDRs0NxJXqG2jnlsJOwrADYQM.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/3CJDRs0NxJXqG2jnlsJOwrADYQM.jpg","language":"en","width":1000,"height":1500},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/3CJDRs0NxJXqG2jnlsJOwrADYQM.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/3CJDRs0NxJXqG2jnlsJOwrADYQM.jpg","language":"en",