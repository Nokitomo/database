"genres":["Romance","Dramma"],"countries":["France","United States of America"],"facts":{"Runtime":"94m"},"keywords":[],"networks":[],"socialLinks":{},"cast":[{"id":5441073,"name":"Vittoria Di Savoia","role":"Alma Lancaster","profile":"https://image.tmdb.org/t/p/original/uxlRv4jnvzagvnTR18dnIBTvQNJ.jpg"},{"id":6028736,"name":"Lucas Barski","role":"Vadim Arcadi","profile":"https://image.tmdb.org/t/p/original/bNJj7fynrB2ZMoPpDNfcVd4YBg.jpg"},{"id":2477804,"name":"Zoé Garcia","role":"Clémentine","profile":"https://image.tmdb.org/t/p/original/alBs6QVCSNvnz4zoHXYRXw1GHYq.jpg"},{"id":236119,"name":"Léo Legrand","role":"Timothé Vallas","profile":"https://image.tmdb.org/t/p/original/yTdqyHFID2EvZil1PvyYEFMlsID.jpg"},{"id":34259,"name":"Jean-Yves Berteloot","role":"Edward Lancaster","profile":"https://image.tmdb.org/t/p/original/x8uFQOAsLSbWcbRMyItUj2nMZuo.jpg"},{"id":984598,"name":"Suliane Brahim","role":"Marie Lancaster","profile":"https://image.tmdb.org/t/p/original/dxUO3EA9xPuj23MWXpFd8Sknv36.jpg"},{"id":3220450,"name":"Aymeric Fougeron","role":"Basile Lancaster","profile":"https://image.tmdb.org/t/p/original/2GiOfHcnoMqJGwDu7JiU8YMlgph.jpg"},{"id":6486088,"name":"Gabrielle Taittinger","role":"Lily Lancaster"},{"id":2981576,"name":"Bryan Trésor","role":"Oscar Johnson","profile":"https://image.tmdb.org/t/p/original/oKtmb7OrNauvgVUYGb7QlWtRIqj.jpg"},{"id":4973900,"name":"Aboubacar Bidanessy","role":"Félix Alonso"},{"id":3921802,"name":"Sami Nasri","role":"Marcus Bianchi"},{"id":6169276,"name":"Adam Abdo","role":"Isaac Sanders","profile":"https://image.tmdb.org/t/p/original/bRY8dsrQzKPAXtgZieZv04czBr5.jpg"},{"id":13609,"name":"Alex Descas","role":"Léonard Abrams","profile":"https://image.tmdb.org/t/p/original/1FUMJTbVflnDR8vZL3J1Hv8f7tV.jpg"},{"id":20526,"name":"Maï Anh Le","role":"Michelle Kerry","profile":"https://image.tmdb.org/t/p/original/4vZH5hfzY7CZ0Jj0rI6x5vyZZjM.jpg"},{"id":3955607,"name":"Carla Souary","role":"Billie Schmidt","profile":"https://image.tmdb.org/t/p/original/wZzuXR4m2HBTozIBzGPeKbMZT28.jpg"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","title":"Io+Te - Soli contro tutti","overview":"Alma Lancaster conduce una vita apparentemente perfetta in una famiglia benestante, convinta che stia studiando legge. In segreto, però, coltiva il suo vero sogno: il cinema. All'università però incontra Vadim Arcadi, un solitario ribelle e carismatico con un passato travagliato."},{"language":"en-US","title":"You+Me - Against the World","overview":"Alma Lancaster, 18, appears to lead a perfect life within a wealthy family who believes she is studying law. In secret, she pursues her true dream: filmmaking. On campus, she meets Vadim Arcadi, 20, a magnetic and solitary rebel with a troubled past. Forced to collaborate on a student film, they clash, grow closer and fall in love — despite themselves. But someone is watching them, determined to tear them apart and expose secrets that could destroy both Alma and Vadim.","tagline":"He runs from everything. Except her."},{"language":"fr-FR","overview":"Dans le dos de ses parents qui la pensent inscrite en droit, Alma Lancaster, jeune femme de bonne famille, s'est donné un an pour poursuivre son rêve de cinéma. Alors qu'elle est contrainte de réaliser un film avec Vadim Arcadi, jeune homme sans attaches, une attirance électrique naît entre eux. Dans l'ombre, une menace invisible les guette, bien décidée à les séparer au risque de tout révéler…","tagline":"Il fuit tout. Sauf elle."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/xXz5B7vDKLPfUVSQxFXfbw8seif.jpg","background":"https://image.tmdb.org/t/p/original/nkEhDomjmPHJSA4Tx8pxv0NlKEy.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":1641629,"type":"movie","originalLanguage":"fr-FR","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/o