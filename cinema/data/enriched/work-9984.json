/original/qZa6q7nV7ftScf1BOp0BGxl2ujc.jpg"},{"id":2410950,"name":"Jang Ji-yong","role":"Dal-pyo","profile":"https://image.tmdb.org/t/p/original/2CbX78H0QOY3Bt9jcTPdPVwuvk5.jpg"},{"id":2379037,"name":"Kim Woo-hyeon","role":"Domi","profile":"https://image.tmdb.org/t/p/original/cNnpctbQzNDquaHKAXNSToZBbc9.jpg"},{"id":5807768,"name":"Kwon Hyuk-sung","role":"Sea Staghorn","profile":"https://image.tmdb.org/t/p/original/qJlOeafkqQzGcOGBfYv2dMnwjCy.jpg"},{"id":6245547,"name":"Jang Nam-su","role":"Soybean","profile":"https://image.tmdb.org/t/p/original/55OZzszzJOy5AcfbIy6BRqPlR4a.jpg"},{"id":2134253,"name":"Kim Wook","role":"Military officer","profile":"https://image.tmdb.org/t/p/original/fTOBAlt3abct96pXAx7EoZ5vOW.jpg"},{"id":2166026,"name":"Park Hoon","role":"Mang-cho","profile":"https://image.tmdb.org/t/p/original/vo0sLb0h5vJPr7OIooq64TMExIR.jpg"},{"id":2097693,"name":"Lee Jung-hyun","role":"Aeng-doo","profile":"https://image.tmdb.org/t/p/original/2LJKgRqFczkhRSGJiVPdvy6ENpe.jpg"},{"id":6245547,"name":"Jang Nam-su","role":"Dae-doo","profile":"https://image.tmdb.org/t/p/original/55OZzszzJOy5AcfbIy6BRqPlR4a.jpg"},{"id":1974809,"name":"Hwang Choon-ha","role":"Hae-ma"},{"id":2863459,"name":"Mun Seong-bok","role":"Jak-doo","profile":"https://image.tmdb.org/t/p/original/raIjI3CtAW7hBF54w7WL9eLhpOd.jpg"},{"id":2291096,"name":"Kim Dae-han","role":"Go-dong","profile":"https://image.tmdb.org/t/p/original/eMq2on2tsA0WwpJgyXwbljFtuKB.jpg"},{"id":2244048,"name":"Song Yoo-ha","role":"Gang-chi","profile":"https://image.tmdb.org/t/p/original/27Q5SIeXCrC7znGw5JOmsg6oXDS.jpg"},{"id":4304766,"name":"Kim Woo-hyun","role":"Do-mi","profile":"https://image.tmdb.org/t/p/original/n7SeFpDa1mr2du0drHIOCWflXfR.jpg"},{"id":6340990,"name":"Lee Bong-gyun","role":"Teol-gye"},{"id":3172983,"name":"Lee Ga-kyung","role":"Cha-in","profile":"https://image.tmdb.org/t/p/original/gIVjKUM88FhrDSKLMJ5QdxJ6xUm.jpg"},{"id":6607509,"name":"Kim Mi-rae","role":"Maid"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","title":"The Pirates - Il tesoro reale","overview":"Il sequel di \"The Pirates\" del 2014 Questo è un film d'azione e avventura su una battaglia navale tra pirati, banditi e pionieri che cercano un sigillo scomparso in un attacco di balene prima della fondazione della dinastia Joseon."},{"language":"en-US","title":"The Pirates: The Last Royal Treasure","overview":"A gutsy crew of Joseon pirates and bandits battle stormy waters, puzzling clues and militant rivals in search of royal gold lost at sea."},{"language":"ko-KR","title":"해적: 도깨비 깃발","overview":"자칭 고려 제일검인 의적단 두목 무치와 바다를 평정한 해적선의 주인 해랑. 한 배에서 운명을 함께하게 된 이들이지만 산과 바다, 태생부터 상극으로 사사건건 부딪히며 바람 잘 날 없는 항해를 이어간다. 그러던 어느 날, 왜구선을 소탕하던 이들은 흔적도 없이 사라진 왕실의 보물이 어딘가 숨겨져 있다는 사실을 알게 되고 해적 인생에 다시없을 최대 규모의 보물을 찾아 위험천만한 모험에 나서기 시작한다. 하지만 사라진 보물을 노리는 건 이들뿐만이 아니었으니! 원하는 것을 얻기 위해 수단과 방법을 가리지 않는 역적 부흥수 또한 보물을 차지하기 위해 바다에 뛰어드는데...","tagline":"가자, 보물 찾으러!"}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/heXckjUdAP6Nuq36b9cl8V0HiTf.jpg","background":"https://image.tmdb.org/t/p/original/pwpw1veVNW2Sls5sGbA9mqMYN49.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":591120,"type":"movie","originalLanguage":"ko-KR","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/heXckjUdAP6Nuq36b9cl8V0HiTf.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/heXckjUdAP6Nuq36b9cl8V0HiTf.jpg","language":"it","width":1910,"height":2865},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/heXckjUdAP6Nuq36b9cl8V0HiTf.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/heXckjUdAP6Nuq36b9cl8V0HiTf.jpg","language":"it","width":1910,"height":2865}]},"en":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/50UQeTrUM7ErXzkvqCsV6EXcM3g.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/50UQeTrUM7ErX