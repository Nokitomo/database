417,"name":"Lina Boudreau","role":"Triplet (voice)"},{"id":58416,"name":"Betty Bonifassi","role":"Triplet (voice)","profile":"https://image.tmdb.org/t/p/original/gV2YmG3gEM9WFGl0M2sw5blwDc0.jpg"},{"id":58418,"name":"Michèle Caucheteux","role":"Triplet (voice)"},{"id":58419,"name":"Jean-Claude Donda","role":"General Gaulle / Sports Commentators / Homeless (voice)","profile":"https://image.tmdb.org/t/p/original/mvIHfv64XAWSdPBCWDm2iAdeOtc.jpg"},{"id":58420,"name":"Mari-Lou Gauthier","role":"Triplet (voice)"},{"id":58422,"name":"Charles Linton","role":"Additional Voice (voice)"},{"id":3503818,"name":"Monica Viegas","role":"Madame Souza (voice)"},{"id":32092,"name":"Michel Robin","role":"Adult Champion (voice)","profile":"https://image.tmdb.org/t/p/original/vjn7TVCPCfzSPmx0ECP5g7tQsbW.jpg"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","title":"Appuntamento a Belleville","overview":"La vecchia madame Souza è piuttosto preoccupata il nipote che non prova interesse per niente, salvo che per la sua collezione di foto del Tour de France e di campioni del ciclismo. Per questo la nonna decide di regalargli una bicicletta, nella speranza che in futuro possa vincere la prestigiosa gara. Ma la \"mafia francese\" coinvolge il giovane in un losco giro di scommesse clandestine. Con l'aiuto di tre anziane signore, dette \"Les Triplettes\", madame Souza si mette sulle tracce del nipote scomparso."},{"language":"en-US","title":"The Triplets of Belleville","overview":"When her grandson is kidnapped during the Tour de France, Madame Souza and her beloved pooch Bruno team up with the Belleville Sisters—an aged song-and-dance team from the days of Fred Astaire—to rescue him.","tagline":"Get your hands together for The Triplets of Belleville!"},{"language":"fr-FR","title":"Les Triplettes de Belleville","overview":"L'idée de génie qu'eût madame Souza en offrant un vélo à son neveu alla bien au-delà de ses espérances. L'entraînement, une alimentation adaptée et le Tour de France n'était pas loin... La \"mafia française\" non plus qui, repérant le futur champion cycliste, l'enlève. Madame Souza, accompagnée de trois vieilles dames, les Triplettes, devenues ses complices, devra braver tous les dangers dans une course poursuite ébouriffante."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/yyTL1llqFgrDj7HCQbLLmymuOR1.jpg","background":"https://image.tmdb.org/t/p/original/yciM9fhJ3er1eBXj4U32bjKb5R3.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":9662,"type":"movie","originalLanguage":"fr-FR","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/yyTL1llqFgrDj7HCQbLLmymuOR1.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/yyTL1llqFgrDj7HCQbLLmymuOR1.jpg","language":"it","width":1049,"height":1575},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/yyTL1llqFgrDj7HCQbLLmymuOR1.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/yyTL1llqFgrDj7HCQbLLmymuOR1.jpg","language":"it","width":1049,"height":1575},{"type":"poster","url":"https://image.tmdb.org/t/p/original/q6W4Eud1LS6f80brRNmyVeMkkpK.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/q6W4Eud1LS6f80brRNmyVeMkkpK.jpg","language":"it","width":720,"height":1081},{"type":"poster","url":"https://image.tmdb.org/t/p/original/nPXq6owyGI4s3HJLjpHIM975Mmk.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/nPXq6owyGI4s3HJLjpHIM975Mmk.jpg","language":"it","width":720,"height":1081},{"type":"poster","url":"https://image.tmdb.org/t/p/original/hFCGoxTkj23FKVOy7cFuuazcya0.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/hFCGoxTkj23FKVOy7cFuuazcya0.jpg","language":"it","width":1000,"height":1500}]},"en":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/enw6C4fDw88g0nOQgIJXjgH3NHi.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/enw6C4fDw88g