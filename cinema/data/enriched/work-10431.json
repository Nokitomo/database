ิตใจโดยมีพระบัว คอยชี้แนะจนก่อเกิด “นาฏยุทธ์” ภายใต้สภาวะแห่งจิตอันสงบนิ่ง แต่ขณะเดียวกันต้องเผชิญหน้ากับเหล่านักฆ่า ที่ล้วนแล้วแต่ยากในการต่อกรของจอมราชันย์ โดยเฉพาะอย่างยิ่งศัตรูที่น่าเกรงขามที่สุดของเทียน อย่าง ภูติ สางกา"}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/261iDmNJ42lMNGjaPnmIyMo4B5j.jpg","background":"https://image.tmdb.org/t/p/original/rtScIZjSyI0oV7YFCtUUthFNvqj.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":43209,"type":"movie","originalLanguage":"th-TH","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/261iDmNJ42lMNGjaPnmIyMo4B5j.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/261iDmNJ42lMNGjaPnmIyMo4B5j.jpg","language":"it","width":2000,"height":3000},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/261iDmNJ42lMNGjaPnmIyMo4B5j.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/261iDmNJ42lMNGjaPnmIyMo4B5j.jpg","language":"it","width":2000,"height":3000}]},"en":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/sIVrOJVeLqPz9NwNa0e4FpqJCWK.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/sIVrOJVeLqPz9NwNa0e4FpqJCWK.jpg","language":"en","width":1000,"height":1500},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/sIVrOJVeLqPz9NwNa0e4FpqJCWK.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/sIVrOJVeLqPz9NwNa0e4FpqJCWK.jpg","language":"en","width":1000,"height":1500},{"type":"poster","url":"https://image.tmdb.org/t/p/original/zR1SCRnQa0uRIJRZ7AqALD0MOax.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/zR1SCRnQa0uRIJRZ7AqALD0MOax.jpg","language":"en","width":1320,"height":1980},{"type":"poster","url":"https://image.tmdb.org/t/p/original/yi4FzWRQqRproB2rK9Vue0wfVYP.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/yi4FzWRQqRproB2rK9Vue0wfVYP.jpg","language":"en","width":1000,"height":1500