re all'aria aperta. Anche a questo ruolo Timon si dimostra ben presto inadatto: vagheggiando una vita migliore, la maldestra sentinella si distrae e lascia campo libero alle iene, che attaccano le altre suricate. Nessuno rimane ucciso, tuttavia la colonia perde la poca fiducia che ancora nutriva verso Timon, che decide di andarsene di casa in cerca di una vita migliore."},{"id":99073,"translatable_type":"title","translatable_id":6445,"locale":"it","key":"release_date","value":"2004-02-06"},{"id":99072,"translatable_type":"title","translatable_id":6445,"locale":"it","key":"slug","value":"il-re-leone-3-hakuna-matata"},{"id":78931,"translatable_type":"title","translatable_id":6445,"locale":"it","key":"views","value":"83861"}],"keywords":[{"id":75,"name":"sequel","created_at":"2023-05-18T11:48:55.000000Z","updated_at":"2023-05-18T11:48:55.000000Z","pivot":{"title_id":6445,"keyword_id":75}},{"id":979,"name":"royalty","created_at":"2023-05-18T11:53:20.000000Z","updated_at":"2023-05-18T11:53:20.000000Z","pivot":{"title_id":6445,"keyword_id":979}},{"id":1005,"name":"best friend","created_at":"2023-05-18T11:53:29.000000Z","updated_at":"2023-05-18T11:53:29.000000Z","pivot":{"title_id":6445,"keyword_id":1005}},{"id":1191,"name":"africa","created_at":"2023-05-18T11:54:32.000000Z","updated_at":"2023-05-18T11:54:32.000000Z","pivot":{"title_id":6445,"keyword_id":1191}},{"id":1768,"name":"lion","created_at":"2023-05-18T11:57:26.000000Z","updated_at":"2023-05-18T11:57:26.000000Z","pivot":{"title_id":6445,"keyword_id":1768}},{"id":2654,"name":"pig","created_at":"2023-05-18T12:02:22.000000Z","updated_at":"2023-05-18T12:02:22.000000Z","pivot":{"title_id":6445,"keyword_id":2654}}]}}]},"images":[{"id":135010,"filename":"fd9c97fd-495e-4ed5-a5b2-2c339d54d758.webp","type":"poster","lang":"it","imageable_type":"title","imageable_id":6445,"created_at":"2024-10-01T13:17:10.000000Z","updated_at":"2025-05-12T09:25:18.000000Z","original_url_field":null,"reference":{"base":"streamingunity:images",