/2NwP59xOf97Zb3MRvRMadZuWNGI.jpg"},{"id":4030318,"name":"A. Seemon","role":"Lucky"},{"id":1717670,"name":"Aathma Patrick","role":"Vettiyan","profile":"https://image.tmdb.org/t/p/original/tdoWAFJZFttcqRv5ko9q3yG1lTP.jpg"}]},"providers":{"streamingunity":[{"id":19020,"path":"/it/titles/19020-the-village","availability":"present","seasons":[{"id":9636,"number":1,"name":"Stagione 1","plot":"Nell'entroterra del Tamil Nadu, un cittadino rimasto bloccato sul posto chiede aiuto per ritrovare la sua famiglia scomparsa, che sembra essere stata rapita da esseri nefasti di un villaggio maledetto. Nel mentre, un maniaco, erede di un impero farmaceutico, invia un gruppo di mercenari nello stesso villaggio per recuperare una cosa dimenticata da tempo. Usciranno vivi da questa notte di terrore?","release_date":"2023-11-24","title_id":19020,"created_at":"2025-09-26T13:04:15.000000Z","updated_at":"2025-11-05T08:37:18.000000Z","release_date_it":"2023-11-24","translations":[{"id":353928,"translatable_type":"season","translatable_id":9636,"locale":"it","key":"name","value":"Stagione 1"},{"id":353929,"translatable_type":"season","translatable_id":9636,"locale":"it","key":"plot","value":"Nell'entroterra del Tamil Nadu, un cittadino rimasto bloccato sul posto chiede aiuto per ritrovare la sua famiglia scomparsa, che sembra essere stata rapita da esseri nefasti di un villaggio maledetto. Nel mentre, un maniaco, erede di un impero farmaceutico, invia un gruppo di mercenari nello stesso villaggio per recuperare una cosa dimenticata da tempo. Usciranno vivi da questa notte di terrore?"},{"id":353930,"translatable_type":"season","translatable_id":9636,"locale":"it","key":"release_date","value":"2023-11-24"}],"episodes":[{"id":122756,"number":1,"name":"Episodio 1","plot":"È il 2005. Un furgone pieno di persone in viaggio da Navamalai verso una città vicina è costretto a deviare per Kattiyal. Il furgone scompare nelle foresta, lasciando Sakthivel e Karunagam nel dolore a causa della perdita dei loro figli. Nel presente, Gautham e la sua famiglia partono per un viaggio ma una deviazione lungo lo stesso percorso cambia le loro vite per sempre.","duration":38,"scws_id":375193,"season_id":9636,"created_at":"2025-09-26T13:04:16.000000Z","updated_at":"2025-11-05T08:41:44.000000Z","quality":"HD","audio_orig":1,"dub_ita":0,"sub_ita":1,"uploaded_at":"2025-09-26 15:04:16","images":[{"id":277202,"filename":"c72e80de-b5f4-47f6-94d8-c70ffb299fa3.webp","type":"cover","lang":null,"imageable_type":"episode","imageable_id":122756,"created_at":"2025-09-26T13:04:16.000000Z","updated_at":"2025-09-26T13:04:16.000000Z","original_url_field":null,"reference":{"base":"streamingunity:images","path":"/images/c72e80de-b5f4-47f6-94d8-c70ffb299fa3.webp"}}],"translations":[{"id":353931,"translatable_type":"episode","translatable_id":122756,"locale":"it","key":"name","value":"Episodio 1"},{"id":353932,"translatable_type":"episode","translatable_id":122756,"locale":"it","key":"plot","value":"È il 2005. Un furgone pieno di persone in viaggio da Navamalai verso una città vicina è costretto a deviare per Kattiyal. Il furgone scompare nelle foresta, lasciando Sakthivel e Karunagam nel dolore a causa della perdita dei loro figli. Nel presente, Gautham e la sua famiglia partono per un viaggio ma una deviazione lungo lo stesso percorso cambia le loro vite per sempre."}]},{"id":122757,"number":2,"name":"Episodio 2","plot":"Gautham riesce a individuare il posto, insieme a un riluttante Shakthivel, a Karunagam e a Peter ma la sua auto e la sua famiglia non si trovano da nessuna parte. Tutto porta a un rapimento nel temuto villaggio di Kattiyal. Nel frattempo, i mercenari di Prakash, l’erede di Exogenyx, sono sbarcati sulla costa di Kattiyal e si sono addentrati nella foresta, iniziando la missione.","duration":40,"scws_id":375194,"season_id":9636,"created_at":"2025-09-26T13:05:16.000000Z","updated_at":"2025-11-05T08:41:44.000000Z","quality":"HD","audio_orig":1,"dub_ita":0,"sub_ita":1,"uploaded_at":"2025-09-26 15:05:16","images":[{"id":277232,"filename":"b5e17965-104a-4e13-b981-41e1c7d5d44f.webp","type":"cover","lang":null,"imageable_type":"episode","imageable_id":122757,"created_at":"2025-09-26T13:05:17.000000Z","updated_at":"2025-09-26T13:05:17.000000Z","original_url_field":null,"reference":{"base":"streamingunity:images","path":"/images/b5e17965-104a-4e13-b981-41e1c7d5d44f.webp"}}],"translations":[{"id":353950,"translatable_type":"episode","translatable_id":122757,"locale":"it","key":"name","value":"Episodio 2"},{"id":353951,"translatable_type":"episode","translatable_id":122757,"locale":"it","key":"plot","value":"Gautham riesce a individuare il posto, insieme a un riluttante Shakthivel, a Karunagam e a Peter ma la sua auto e la sua famiglia non si trovano da nessuna parte. Tutto porta a un rapimento nel temuto villaggio di Kattiyal. Nel frattempo, i mercenari di Prakash, l’erede di Exogenyx, sono sbarcati sulla costa di Kattiyal e si sono addentrati nella foresta, iniziando la missione."}]},{"id":122760,"number":3,"name":"Episodio 3","plot":"I mercenari, guidati da Farhan, si fanno strada nella foresta mentre Farhan capisce che Jagan sta ostacolando i piani di Prakash. Karunagam rivela i segreti sul villaggio di Kattiyal, sul perché è devastato, sul bigotto padre di Shakthi, Sairaj, e sulla sua follia. I quattro si addentrano nei meandri di Kattiyal e vengono attaccati da creature simili a mutanti che li fanno cadere in una caverna.","duration":37,"scws_id":375195,"season_id":9636,"created_at":"2025-09-26T13:06:12.000000Z","updated_at":"2025-11-05T08:41:44.000000Z","quality":"HD","audio_orig":1,"dub_ita":0,"sub_ita":1,"uploaded_at":"2025-09-26 15:06:12","images":[{"id":277245,"filename":"e8a86c38-cf5b-4e7a-b1f2-8613ebc692de.webp","type":"cover","lang":null,"imageable_type":"episode","imageable_id":122760,"created_at":"2025-09-26T13:06:13.000000Z","updated_at":"2025-09-26T13:06:13.000000Z","original_url_field":null,"reference":{"base":"streamingunity:images","path":"/images/e8a86c38-cf5b-4e7a-b1f2-8613ebc692de.webp"}}],"translations":[{"id":353962,"translatable_type":"episode","translatable_id":122760,"locale":"it","key":"name","value":"Episodio 3"},{"id":353963,"translatable_type":"episode","translatable_id":122760,"locale":"it","key":"plot","value":"I mercenari, guidati da Farhan, si fanno strada nella foresta mentre Farhan capisce che Jagan sta ostacolando i piani di Prakash. Karunagam rivela i segreti sul villaggio di Kattiyal, sul perché è devastato, sul bigotto padre di Shakthi, Sairaj, e sulla sua follia. I quattro si addentrano nei meandri di Kattiyal e vengono attaccati da creature simili a mutanti che li fanno cadere in una caverna."}]},{"id":122761,"number":4,"name":"Episodio 4","plot":"Quando Gautham e gli altri si rendono conto di essere nelle vecchie caverne minerarie di Kattiyal, si addentrano ancor di più e si imbattono nella nuova tana di Sairaj. I mercenari entrano nella fabbrica abbandonata e si dirigono verso il laboratorio sotterraneo, dove incontrano un grottesco altare di preghiera realizzato dai mutanti.","duration":51,"scws_id":375196,"season_id":9636,"created_at":"2025-09-26T13:06:15.000000Z","updated_at":"2025-11-05T08:41:44.000000Z","quality":"HD","audio_orig":1,"dub_ita":0,"sub_ita":1,"uploaded_at":"2025-09-26 15:06:15","images":[{"id":277246,"filename":"14ec3fec-3b25-450a-a626-841cf44d75c0.webp","type":"cover","lang":null,"imageable_type":"episode","imageable_id":122761,"created_at":"2025-09-26T13:06:16.000000Z","updated_at":"2025-09-26T13:06:16.000000Z","original_url_field":null,"reference":{"base":"streamingunity:images","path":"/images/14ec3fec-3b25-450a-a626-841cf44d75c0.webp"}}],"translations":[{"id":353964,"translatable_type":"episode","translatable_id":122761,"locale":"it","key":"name","value":"Episodio 4"},{"id":353965,"translatable_type":"episode","translatable_id":122761,"locale":"it","key":"plot","value":"Quando Gautham e gli altri si rendono conto di essere nelle vecchie cavern