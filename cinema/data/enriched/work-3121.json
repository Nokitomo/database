":{"title_id":13034,"credit_id":12290,"job":"actor","order":7}}],"main_directors":[{"id":50726,"name":"Emanuele Crialese","created_at":"2023-05-18T12:55:12.000000Z","updated_at":"2023-05-18T12:55:12.000000Z","pivot":{"title_id":13034,"credit_id":50726,"job":"director","order":0}}],"cam":null,"translations":[{"id":272683,"translatable_type":"title","translatable_id":13034,"locale":"it","key":"daily_views","value":"0"},{"id":272563,"translatable_type":"title","translatable_id":13034,"locale":"it","key":"last_air_date","value":"2006-09-22"},{"id":272559,"translatable_type":"title","translatable_id":13034,"locale":"it","key":"name","value":"Nuovomondo"},{"id":272560,"translatable_type":"title","translatable_id":13034,"locale":"it","key":"plot","value":"Nella Sicilia degli inizi del Novecento, Salvatore fa un voto e chiede un segno al cielo: vuole imbarcarsi per il nuovomondo e condurre in America i figli e l’anziana madre. Il segnale è una cartolina di propaganda che ritrae minuscoli contadini accanto a galline giganti o a carote sproporzionate. Venduta ogni cosa posseduta, Salvatore lascia la Sicilia alla volta dell’America. Durante la traversata oceanica incontra la bella Lucy, una young lady che indossa il cappello ed è più elegante della figlia del sindaco del paese. Luce parla la lingua dell’America e cerca un compagno da impalmare per ritornarci da signora. Salvatore, da vero galantuomo, accoglie la sua avance. Il lungo viaggio approderà ad Ellis Island, l’isola della quarantena dove si decideranno gli ingressi e i rimpatri."},{"id":272562,"translatable_type":"title","translatable_id":13034,"locale":"it","key":"release_date","value":"2006-09-22"},{"id":272561,"translatable_type":"title","translatable_id":13034,"locale":"it","key":"slug","value":"nuovomondo"},{"id":272564,"translatable_type":"title","translatable_id":13034,"locale":"it","key":"views","value":"663"}],"keywords":[{"id":81,"name":"italy","created_at":"2023-05-18T11:48:56.000000Z","updated_at":"2023-05