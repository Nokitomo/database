més il y a une quinzaine d’années. Puis séparés. Depuis, le temps a passé, chacun a suivi sa route et les plaies se sont refermées peu à peu. Quand Mathieu vient diluer sa mélancolie dans les bains à remous d’une thalasso, il retrouve Alice par hasard."}],"images":{"logos":[{"type":"logo","url":"https://image.tmdb.org/t/p/original/qmGroDiEXuSKKgljrcLdEUZBOrI.png","previewUrl":"https://image.tmdb.org/t/p/w300/qmGroDiEXuSKKgljrcLdEUZBOrI.png","language":"it","width":620,"height":212},{"type":"logo","url":"https://image.tmdb.org/t/p/original/hVlBvU4ODJp7u89wINeH5QiNosC.png","previewUrl":"https://image.tmdb.org/t/p/w300/hVlBvU4ODJp7u89wINeH5QiNosC.png","language":"en","width":919,"height":602},{"type":"logo","url":"https://image.tmdb.org/t/p/original/ttWDmtrJPMKQ7abkiTtkynv2Snj.png","previewUrl":"https://image.tmdb.org/t/p/w300/ttWDmtrJPMKQ7abkiTtkynv2Snj.png","language":"en","width":919,"height":602},{"type":"logo","url":"https://image.tmdb.org/t/p/original/2VfujSjK1FqwxryfqKEpZne5HHa.png","previewUrl":"https://image.tmdb.org/t/p/w300/2VfujSjK1FqwxryfqKEpZne5HHa.png","language":"fr","width":4269,"height":676},{"type":"logo","url":"https://image.tmdb.org/t/p/original/2HKGqXTzyz7AFS2oCHc9cSTy1w6.png","previewUrl":"https://image.tmdb.org/t/p/w300/2HKGqXTzyz7AFS2oCHc9cSTy1w6.png","language":"fr","width":4269,"height":676}],"posters":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/HHypMdtrOX6m61h2D5M1EAg5aQ.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/HHypMdtrOX6m61h2D5M1EAg5aQ.jpg","language":"it","width":762,"height":1143},{"type":"poster","url":"https://image.tmdb.org/t/p/original/lDQcpC4i6XOadNHuQkMi55gfo3a.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/lDQcpC4i6XOadNHuQkMi55gfo3a.jpg","language":"en","width":1274,"height":1911},{"type":"poster","url":"https://image.tmdb.org/t/p/original/v5v8TDnqf3SOXeZjRZmoa86WVE4.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/v5v8TDnqf3SOXeZjRZmoa86WVE4.jpg","language":"en","width":1274,"height":1800},{"type