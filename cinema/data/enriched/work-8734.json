ps://image.tmdb.org/t/p/original/y9B7O44HDjU7Bb3OIenMvXqx9DF.jpg"},{"id":2090122,"name":"Chen Chen","role":"Japanese Soldier","profile":"https://image.tmdb.org/t/p/original/t6LJRBCDhIdV4NpuoMtbygdvK0e.jpg"},{"id":3219518,"name":"Cheng Zuo","profile":"https://image.tmdb.org/t/p/original/bAvwZI0msRcI1gY5VOAMu5atl2J.jpg"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","title":"Tigri all’assalto","overview":"Nel 1941 in Cina durante la seconda guerra mondiale un ferroviere guida una squadra di combattenti per la libertà contro i giapponesi al fine di procurare il cibo per i poveri."},{"language":"en-US","title":"Railroad Tigers","overview":"A railroad worker in China in 1941 leads a team of freedom fighters against the Japanese in order to get food for the poor."},{"language":"zh-CN","overview":"1941年太平洋战争爆发以后，穿过山东境内的津浦铁路成为日军在中国大陆最重要的战略交通线之一。在津浦铁路枣庄段周边，活跃着一支民间抗日游击队，这支游击队主要由枣庄火车站的几名铁路工人组成，队长叫马原，是火车站的搬运工工头。他们白天在日本人占领并管理的火车站干活，晚上出来秘密活动，利用对铁路线的熟悉以及扒火车、开火车的特殊技能，以一支小小的游击队跟大批装备精良的日本正规军周旋较量，造成了非常大的影响，当地老百姓给这支队伍起了一个响亮的名头，叫铁道飞虎队。","tagline":"干票大的"}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/d3HuLPCHNJS0iuZ8jIWaev3PRn2.jpg","background":"https://image.tmdb.org/t/p/original/ygcbiJgTQMjnoSLyzKLmzR7u3gN.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":377447,"type":"movie","originalLanguage":"zh-CN","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/d3HuLPCHNJS0iuZ8jIWaev3PRn2.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/d3HuLPCHNJS0iuZ8jIWaev3PRn2.jpg","language":"it","width":500,"height":750},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/d3HuLPCHNJS0iuZ8jIWaev3PRn2.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/d3HuLPCHNJS0iuZ8jIWaev3PRn2.jpg","language":"it","width":500,"height":750}]},"en":{"status":"available","selected":{"ty