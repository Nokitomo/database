a noch die Referendarin Lisi Schnabelstedt, die ihm nicht nur dank ihrer pädagogischen Ratschläge etwas bedeutet... Zeki muss sich entscheiden, ob er die Chance auf ein anständiges Leben und die große Liebe ergreifen will."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/fHU6BjzWkdijoXKRIcoYlL90zuY.jpg","background":"https://image.tmdb.org/t/p/original/p8LlfRewGJkf67UhVM0s70IfNBt.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":233063,"type":"movie","originalLanguage":"de-DE","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/fHU6BjzWkdijoXKRIcoYlL90zuY.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/fHU6BjzWkdijoXKRIcoYlL90zuY.jpg","language":"it","width":1400,"height":2100},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/fHU6BjzWkdijoXKRIcoYlL90zuY.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/fHU6BjzWkdijoXKRIcoYlL90zuY.jpg","language":"it","width":1400,"height":2100},{"type":"poster","url":"https://image.tmdb.org/t/p/original/6JEsV0D8Sga5S4bpnteGG7xjQOA.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/6JEsV0D8Sga5S4bpnteGG7xjQOA.jpg","language":"it","width":1920,"height":2880}]},"en":{"status":"missing","candidates":[]},"de":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/hV88MiailtnGVF6rbp6Ug6UBKYS.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/hV88MiailtnGVF6rbp6Ug6UBKYS.jpg","language":"de","width":2000,"height":3000},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/hV88MiailtnGVF6rbp6Ug6UBKYS.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/hV88MiailtnGVF6rbp6Ug6UBKYS.jpg","language":"de","width":2000,"height":3000},{"type":"poster","url":"https://image.tmdb.org/t/p/original/3m0rI92ybIxMwSdd2Kfc2LA4pNL.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/3m0rI92ybIxMwSdd2Kfc2LA4pNL.jpg","