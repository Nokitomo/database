eo durante il processo e quindi a permettergli di precipitarsi in chiesa per impedire il matrimonio della sua amata.","language":"it-IT"},"releaseDate":"1981-11-21","status":"Released","rating":5.7,"ratingCount":78,"genres":["Commedia"],"countries":["Italy"],"facts":{"Runtime":"90m"},"keywords":[],"networks":[],"socialLinks":{},"cast":[{"id":70027,"name":"Jerry Calà","role":"Romeo","profile":"https://image.tmdb.org/t/p/original/rYVXvDyTyEfl6Zde7S7AC1B9v7E.jpg"},{"id":55912,"name":"Diego Abatantuono","role":"Felice","profile":"https://image.tmdb.org/t/p/original/i7idHOw21i3RNO8IrVKkGlcAyOd.jpg"},{"id":120632,"name":"Simona Mariani","role":"Giulietta","profile":"https://image.tmdb.org/t/p/original/fzjcWCyrmSdBEzEl3kc5u16ZfaM.jpg"},{"id":120633,"name":"Mauro Di Francesco","role":"Renato","profile":"https://image.tmdb.org/t/p/original/u8zNZ7O0Q9vOw866EJheij3Q7ly.jpg"},{"id":120636,"name":"Renato Cecchetto","role":"proprietario del bar","profile":"https://image.tmdb.org/t/p/original/qrdywLcLWFKOozTqEuChflSFWZe.jpg"},{"id":120634,"name":"Carmine Faraco","role":"fratello di Felice","profile":"https://image.tmdb.org/t/p/original/wSuMp8HvfHK0g0KTxCCB9qunbRv.jpg"},{"id":120635,"name":"Fabio Grossi","role":"fratello di Felice \"Ibrido\"","profile":"https://image.tmdb.org/t/p/original/qMnaCm8JRB2YvUI3n77axQTMYB4.jpg"},{"id":1206772,"name":"Barbara Herrera","role":"madre di Walter","profile":"https://image.tmdb.org/t/p/original/zxCHJpJ0kWhKAB3DJsRvGsH5d7S.jpg"},{"id":1886232,"name":"Loris Zanchi","role":"padre di Romeo"},{"id":1831105,"name":"Nicolina Papetti","role":"madre di Romeo","profile":"https://image.tmdb.org/t/p/original/nLGBSEpRNyKfibzq4kc72o6DV8p.jpg"},{"id":41153,"name":"Ugo Bologna","role":"avvocato Colombo","profile":"https://image.tmdb.org/t/p/original/wtJeAQOwHGqVvGKfGFHxXluolWM.jpg"},{"id":1928826,"name":"Saverio Fischetti","role":"datore di lavoro di Felice"},{"id":232888,"name":"Annabella Schiavone","role":"madre di Felice e Giulietta","profile":"https://image