riginal/fTP79GHhdI1xcwvHlacDnJymCUy.jpg"},{"id":2170735,"name":"Elena Stetsenko","role":"Stenographer","profile":"https://image.tmdb.org/t/p/original/eXURrgkXGW3EoqMz4UXKz9akpUe.jpg"},{"id":2776792,"name":"Gennadiy Fomin","role":"Farmer","profile":"https://image.tmdb.org/t/p/original/ySoPA6rlsWXSvaO5G81LsGikobU.jpg"},{"id":2187344,"name":"Anton Zhukov","role":"German Soldier Innsbruck","profile":"https://image.tmdb.org/t/p/original/dvodxtiYB9fGoUXAi9FDKd2IjuK.jpg"},{"id":2922227,"name":"Maximilian Anthony Hirschle","role":"American Soldier"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","title":"Lezioni di persiano","overview":"Nella Francia occupata del 1942, Gilles viene arrestato dalle SS insieme ad altri ebrei e mandato in un campo di concentramento in Germania. Riesce per poco a evitare la morte giurando di essere persiano ma non ebreo. Viene quindi scelto per insegnare il farsi al direttore del campo, un uomo che sogna di aprire un ristorante in Iran una volta finita la guerra. Il particolare rapporto tra i due uomini finisce però con la scatenare la gelosia di altri prigionieri e ufficiali..."},{"language":"en-US","title":"Persian Lessons","overview":"Occupied France, 1942. Gilles is arrested by SS soldiers alongside other Jews and sent to a camp in Germany. He narrowly avoids sudden execution by swearing to the guards that he is not Jewish, but Persian. This lie temporarily saves him, but Gilles gets assigned a life-or-death mission: to teach Farsi to Head of Camp Koch, who dreams of opening a restaurant in Iran once the war is over. Through an ingenious trick, Gilles manages to survive by inventing words of \"Farsi\" every day and teaching them to Koch."},{"language":"de-DE","overview":"1942. Gilles, ein junger Belgier, wird zusammen mit anderen Juden von der SS verhaftet und in ein Lager nach Deutschland gebracht. Er entgeht der Exekution, indem er schwört, kein Jude, sondern Perser zu sein – eine Lüge, die ihn zunächst rettet. Doch dann wird Gilles mit einer unmöglichen Mission beauftragt: Er soll Farsi unterrichten. Offizier Koch, Leiter der Lagerküche, träumt nämlich davon, nach Kriegsende ein Restaurant im Iran zu eröffnen. Wort für Wort muss Gilles eine Sprache erfinden, die er nicht beherrscht. Als in der besonderen Beziehung zwischen den beiden Männern Eifersucht und Misstrauen aufkommen, wird Gilles schmerzhaft bewusst, dass ihn jeder Fehltritt  auffliegen lassen könnte …"}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/osxYWMLC7oFxeWRSfdjjKdUc7IE.jpg","background":"https://image.tmdb.org/t/p/original/kgP4YOUWKhJZWL0Z8LJ6G6LBMEM.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":581577,"type":"movie","originalLanguage":"de-DE","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/osxYWMLC7oFxeWRSfdjjKdUc7IE.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/osxYWMLC7oFxeWRSfdjjKdUc7IE.jpg","language":"it","width":666,"height":1000},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/osxYWMLC7oFxeWRSfdjjKdUc7IE.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/osxYWMLC7oFxeWRSfdjjKdUc7IE.jpg","language":"it","width":666,"height":1000},{"type":"poster","url":"https://image.tmdb.org/t/p/original/fcRg4MuWOr66iNWpcQMrHXbslkl.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/fcRg4MuWOr66iNWpcQMrHXbslkl.jpg","language":"it","width":666,"height":1000}]},"en":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/ppReRGszmdZC2194keN4cGoLIPQ.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/ppReRGszmdZC2194keN4cGoLIPQ.jpg","language":"en","width":960,"height":1440},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/ppReRGszmdZC2194keN4cGoLIPQ.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/ppReRGszmdZC2194keN4cGoLIPQ.jpg","