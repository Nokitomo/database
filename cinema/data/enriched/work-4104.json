tA3HDwtHfTrk969DPR.jpg"},{"id":5473875,"name":"Shin Gi-rok","role":"Manager of Study Room"},{"id":2863366,"name":"Woo Sang-jeon","role":"Dog kennel","profile":"https://image.tmdb.org/t/p/original/j6tZRBus3TtFEgrnKBhxLmKOJ1m.jpg"},{"id":2931936,"name":"Moon Dong-hyeok","role":"Oh Dal Ho","profile":"https://image.tmdb.org/t/p/original/jvBYQNKI31wre5AjD2m25bNsMzn.jpg"},{"id":6286128,"name":"Bae Jin-ho","role":"Violent Crimes Unit 1, Team 2"},{"id":5629095,"name":"Lee Dong-joon","role":"Zeus Spa 1"},{"id":5474031,"name":"Jeong Mi-kyeong","role":"Victim's Family 1","profile":"https://image.tmdb.org/t/p/original/jJZcWBBsA4yDd1cBCtn7T0cldz1.jpg"},{"id":3967481,"name":"Kim Jin-ok","role":"Victim's Family 2","profile":"https://image.tmdb.org/t/p/original/mWSIWtauPsGTIwtDc2Dnj5VfmHB.jpg"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","title":"Il Gangster, il Poliziotto, il Diavolo","overview":"Il capo di una gang della malavita coreana finisce nel mirino di un killer psicopatico: salvatosi miracolosamente da un attacco, decide con riluttanza di fare squadra con Jung Tae-seok, uno dei migliori poliziotti in circolazione, famoso per la sua spietata e brutale lotta contro il crimine organizzato. I due non potrebbero essere più diversi, ma grazie all'obiettivo comune il bizzarro duo si ritrova dalla stessa parte nella ricerca del folle serial killer.","tagline":"Non lasciare che il diavolo vinca."},{"language":"en-US","title":"The Gangster, the Cop, the Devil","overview":"After barely surviving a brutal attack by a sadistic serial killer, crime boss Jang Dong-su is left humiliated. Determined to catch the killer known as K, he forms an uneasy alliance with Jung Tae-seok, a relentless and incorruptible detective who often disrupts his illegal business. However, while Jang Dong-su wants K dead, Jung Tae-suk is determined to bring him to justice. With a deal in place—whoever finds K first will decide his fate—the hunt begins, blurring the lines between crime and law.","tagline":"Don't let the devil win."},{"language":"ko-KR","overview":"중부권을 쥐고 흔드는 제우스파 조직의 보스 장동수, 비 내리던 밤 한적한 도로에서 접촉사고를 위장해 접근한 남자에게 불의의 습격을 받는다. 격투 끝에 가까스로 목숨은 건졌지만 조직 보스의 권위와 자존심은 무너지고 만다. 바짝 독이 오른 장동수 앞에 형사 정태석이 나타나 그를 찌른 놈이 연쇄살인범이라며 그날 밤 기억나는 것을 모두 말하라고 한다. 장동수는 얼굴 없는 연쇄살인마와 마주쳐 살아남은 유일한 생존자이자 목격자였다. 자신의 몸에 손 댄 그 놈을 살 떨리게 잡고 싶은 조직의 보스 장동수와 미치도록 범인을 잡고 싶은 강력반 미친개 정태석, 두 사람은 장동수의 조직력과 자본, 정태석의 정보력과 기술력을 이용해 \"K\"라 불리는 연쇄살인마를 함께 잡기로 하는데...","tagline":"악마를 잡기 위해 손잡다"}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/1In5JQ1gnLyNzKZj1mKEmP9GP3S.jpg","background":"https://image.tmdb.org/t/p/original/jJJQ1PPXUEchqyZ9YyWzgSNU39Z.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":581528,"type":"movie","originalLanguage":"ko-KR","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/1In5JQ1gnLyNzKZj1mKEmP9GP3S.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/1In5JQ1gnLyNzKZj1mKEmP9GP3S.jpg","language":"it","width":1000,"height":1500},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/1In5JQ1gnLyNzKZj1mKEmP9GP3S.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/1In5JQ1gnLyNzKZj1mKEmP9GP3S.jpg","language":"it","width":1000,"height":1500},{"type":"poster","url":"https://image.tmdb.org/t/p/original/7RrgAqx4aNU5aStG71lj6gKd8ZB.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/7RrgAqx4aNU5aStG71lj6gKd8ZB.jpg","language":"it","width":565,"height":847}]},"en":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/oHlM4abRm6BzrRcz9Nup1uidw9H.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/oHlM4abRm6BzrRcz9Nup1uidw9H.jpg","language":"en","width":2000,"height":3000},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/oHlM4abRm6BzrRcz9Nup1uidw9H.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/oHlM4a