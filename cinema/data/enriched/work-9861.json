AFOHBKiGkbDsGIVXZ.jpg"},{"id":1862877,"name":"Alessandro Betti","role":"Airoldi","profile":"https://image.tmdb.org/t/p/original/nPHx1JH7mLto6rXCaEnpWB21Gst.jpg"},{"id":1361236,"name":"Luciano Miele","role":"Cesare","profile":"https://image.tmdb.org/t/p/original/kGH7SjZ18wdq0ERtRNgojLKGLyq.jpg"},{"id":123548,"name":"Antonio Salines","role":"Ferrantini","profile":"https://image.tmdb.org/t/p/original/nLz6lePlHNQ7WDT9mRN8MTJ1BnB.jpg"},{"id":1144991,"name":"Valentina D'Agostino","role":"Fabiana Giuffrè","profile":"https://image.tmdb.org/t/p/original/lWGGF9iTRWTNKFB2eAXtDsFio39.jpg"},{"id":1464907,"name":"Leonardo Sbragia","role":"Enrico Giuffrè","profile":"https://image.tmdb.org/t/p/original/z9T8xRu5QDi8FdA0LkrELSWQrHl.jpg"},{"id":1949087,"name":"Piero Madaro","role":"Dante","profile":"https://image.tmdb.org/t/p/original/h7KFs4w87Ijr7Rw0ZTZGdXIs4WP.jpg"},{"id":2489190,"name":"Giulia Ricciardi","role":"Jenny"},{"id":1024233,"name":"Elisabetta De Palo","role":"Signora Caetani","profile":"https://image.tmdb.org/t/p/original/x49sbAfYSKydUJ5cMD9YKWL4hYq.jpg"},{"id":2456059,"name":"Martina Querini","role":"Costanza","profile":"https://image.tmdb.org/t/p/original/jYfykDN2BY4pi86kbLnRygdt3zp.jpg"},{"id":226384,"name":"Tommaso Ramenghi","role":"Lodovico","profile":"https://image.tmdb.org/t/p/original/wp3ek6yhQqYI9hCRDiElZfazHye.jpg"},{"id":5401673,"name":"Maria Luisa D'Amico","role":"Signora Peliciano"},{"id":2126818,"name":"Francesca Tomassoni","role":"Susy","profile":"https://image.tmdb.org/t/p/original/dXxexeSaOZ1tyhWNezZJCSub6YJ.jpg"},{"id":5401675,"name":"Elda Evelina Accardi","role":"Anziana in ospedale"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","overview":"Pierfrancesco Mai (Diego Abatantuono), 65 anni, è un dottore che lavora come guardia medica notturna. Ed è anche un uomo pieno di acciacchi, burbero e per nulla empatico con i pazienti.  Una notte ha un fortuito incidente con Mario (Frank Matano), un rider trentenne che consegna cibo a domicilio. Mario non si fa nulla, ma la sua bici è distrutta.  A causa dell’impatto, Pierfrancesco vede, invece, riacutizzarsi la sua perenne sciatalgia e non può più guidare. I due rischiano di perdere il lavoro, ma al dottore viene un’idea che salva entrambi: Mario, “guidato” a distanza da Pierfrancesco tramite un auricolare, andrà a fare le visite al posto suo e con l’auto del medico faranno anche le consegne a domicilio.  Dopo una serie di rocambolesche (dis)avventure i due impareranno a sostenersi a vicenda e la notte volgerà al termine cambiando in meglio le loro vite."},{"language":"en-US","title":"Doctor on Call","overview":"65 year old doctor Pierfrancesco works as a night-shift medical guard. He’s a grumpy man,  full of aches and pains and is very rough with his patients. One night, he’s involved in a road collision with 30 year old delivery man Mario. While uninjured, Mario's bicycle is destroyed, and Pierfrancesco's sciatica flares up, making it impossible for him to drive. With both of their jobs in jeopardy, the doctor has an idea that could help them both: “remotely guided” by Pierfrancesco via wireless headset, Mario will visit his patients, and they’ll also carry out Mario’s delivery in Pierfrancesco’s car. After a range of daring (mis)adventures, they will learn to support each other, and the night will end with their lives both changed for the better."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/jHao5iDtYN8MTydvuMSdIZ6W0JI.jpg","background":"https://image.tmdb.org/t/p/original/dYFwsbK7TKJYBqlaY6WQ6KcuWwd.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":802324,"type":"movie","originalLanguage":"it-IT","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/jHao5iDtYN8MTydvuMSdIZ6W0JI.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/jHao5iDtYN8MTydvuMSdIZ6W0JI.jp