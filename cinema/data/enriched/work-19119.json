a idilliaca, ma che non riconoscono più. Nell'impossibilità di fidarsi di vicini e amici, abbandonati dalle autorità e terrorizzati dall'idea di contrarre a loro volta la malattia, saranno costretti ad allearsi in una battaglia da incubo per la sopravvivenza."},{"id":164694,"translatable_type":"title","translatable_id":9931,"locale":"it","key":"release_date","value":"2010-02-26"},{"id":164693,"translatable_type":"title","translatable_id":9931,"locale":"it","key":"slug","value":"la-citta-verra-distrutta-allalba"},{"id":123686,"translatable_type":"title","translatable_id":9931,"locale":"it","key":"views","value":"24259"}],"keywords":[{"id":76,"name":"remake","created_at":"2023-05-18T11:48:55.000000Z","updated_at":"2023-05-18T11:48:55.000000Z","pivot":{"title_id":9931,"keyword_id":76}},{"id":460,"name":"virus","created_at":"2023-05-18T11:50:48.000000Z","updated_at":"2023-05-18T11:50:48.000000Z","pivot":{"title_id":9931,"keyword_id":460}},{"id":473,"name":"duringcreditsstinger","created_at":"2023-05-18T11:51:01.000000Z","updated_at":"2023-05-18T11:51:01.000000Z","pivot":{"title_id":9931,"keyword_id":473}},{"id":1155,"name":"biological weapon","created_at":"2023-05-18T11:54:23.000000Z","updated_at":"2023-05-18T11:54:23.000000Z","pivot":{"title_id":9931,"keyword_id":1155}},{"id":2297,"name":"madness","created_at":"2023-05-18T12:00:20.000000Z","updated_at":"2023-05-18T12:00:20.000000Z","pivot":{"title_id":9931,"keyword_id":2297}},{"id":4289,"name":"cover-up","created_at":"2023-05-18T12:18:43.000000Z","updated_at":"2023-05-18T12:18:43.000000Z","pivot":{"title_id":9931,"keyword_id":4289}},{"id":5602,"name":"psychosis","created_at":"2023-05-18T12:35:00.000000Z","updated_at":"2023-05-18T12:35:00.000000Z","pivot":{"title_id":9931,"keyword_id":5602}}]}}]},"images":[{"id":133532,"filename":"bb28affe-fa67-49b9-80f6-5ad98c8cdffd.webp","type":"poster","lang":"it","imageable_type":"title","imageable_id":9931,"created_at":"2024-09-17T20:36:33.000000Z","updated_at":"2025-05-12T09:25:17