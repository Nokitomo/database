e.tmdb.org/t/p/original/2P9vJGe4GQXHsgVoO9DQgtI2iNb.jpg"},{"id":40359,"name":"Amber Bongard","role":"Fanny","profile":"https://image.tmdb.org/t/p/original/3hn4s66CzOUuGHMGTmLb8lo0mEz.jpg"},{"id":1279897,"name":"Peter Meinhardt","role":"Landestrainer Hessen","profile":"https://image.tmdb.org/t/p/original/qErBwgIpcRWuwZe635PXVkuOOUf.jpg"},{"id":18936,"name":"Martin Butzke","role":"Lehrer","profile":"https://image.tmdb.org/t/p/original/nUfV5p3qLroDrC8wP8QwftOF1aC.jpg"},{"id":1309233,"name":"Neda Rahmanian","profile":"https://image.tmdb.org/t/p/original/tNNPwhfG9ulbahftehYyTTKGrYT.jpg"},{"id":3511011,"name":"Simone Henn","role":"Sanitäterin","profile":"https://image.tmdb.org/t/p/original/oghjlyyOhvAB20Qriu4zTIcUJ9u.jpg"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","title":"Windstorm - Liberi nel vento","overview":"La quattordicenne Mika sogna il campeggio estivo ma, come punizione per essere stata bocciata, i genitori decidono di mandarla nella fattoria della severa nonna. Una volta in campagna, oltre a conoscere Sam, il giovane ragazzo addetto alle stalle, Mika scopre qualcosa che cattura sin da subito la sua attenzione: il selvaggio stallone Ostwind. Poiché nessuno è capace di domare il cavallo, una notte Mika decide di introdursi nella stalla, dando inizio a una particolare amicizia che le permette di scoprire di essere in grado di \"parlare\" ai cavalli."},{"language":"en-US","title":"Windstorm","overview":"While spending the summer at her grandmother's farm, a girl discovers a talent for communicating with horses and tries to tame a fierce stallion.","tagline":"Wilder than her dreams"},{"language":"de-DE","overview":"Die rebellische Mika wird von ihren Akademiker-Eltern in den Sommerferien zum Straflernen zu ihrer Großmutter Maria geschickt, die ein Pferdegestüt hat. Mika interessiert sich nicht für Pferde, bis sie Ostwind kennenlernt, einen ungezähmten Hengst, der sich den Menschen verweigert. Nur bei Mika wird er sofort zahm und umgänglich. Als die 14-Jährige erfährt, dass ihre Großmutter überlegt, Ostwind zum Pferdeschlächter zu geben, will sie reiten lernen und bei einem Turnier beweisen, dass der Hengst eine zweite Chance verdient hat.","tagline":"Zusammen sind wir frei"}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/1rwEieky8lv968qDfYLX8hS10ld.jpg","background":"https://image.tmdb.org/t/p/original/yFKJ2hsafckmieuYHWrLskNlZJY.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":233639,"type":"movie","originalLanguage":"de-DE","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/1rwEieky8lv968qDfYLX8hS10ld.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/1rwEieky8lv968qDfYLX8hS10ld.jpg","language":"it","width":1500,"height":2250},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/1rwEieky8lv968qDfYLX8hS10ld.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/1rwEieky8lv968qDfYLX8hS10ld.jpg","language":"it","width":1500,"height":2250}]},"en":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/dshXuNNZHSLH25WPKcIKIs0OoJj.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/dshXuNNZHSLH25WPKcIKIs0OoJj.jpg","language":"en","width":1400,"height":2100},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/dshXuNNZHSLH25WPKcIKIs0OoJj.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/dshXuNNZHSLH25WPKcIKIs0OoJj.jpg","language":"en","width":1400,"height":2100}]},"de":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/b768EtAVFNyE4CbBsXsFMVRiike.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/b768EtAVFNyE4CbBsXsFMVRiike.jpg","language":"de","width":2000,"height":3000},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/b768EtAVFNyE4CbBsXsFMVRiike.jpg","previewUrl":"https://