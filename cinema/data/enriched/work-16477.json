vWeqMDhIeXPoORF.jpg"},{"id":572221,"name":"Charlie Alejandro","role":"Wealthy Zoo Patron (uncredited)","profile":"https://image.tmdb.org/t/p/original/dj7P5oGRxVjhmQc3mSb8lSHzwaa.jpg"},{"id":1657440,"name":"Brina","role":"Party Guest (uncredited)"},{"id":1395906,"name":"Mike Burton","role":"Car Customer (uncredited)"},{"id":1759621,"name":"Billy Concha","role":"TGIF Patron (uncredited)","profile":"https://image.tmdb.org/t/p/original/gDj5B3AtaHrexteO28pbIEVo0EY.jpg"},{"id":1750079,"name":"Danny Connelly","role":"Zookeeper (uncredited)","profile":"https://image.tmdb.org/t/p/original/39kvdSKUWA8n973Xdusk8y43h6W.jpg"},{"id":5469021,"name":"Christopher J. Davis","role":"Bar Fly(uncredited)"},{"id":1360004,"name":"Becki Dennis","role":"Zoo-worker (uncredited)","profile":"https://image.tmdb.org/t/p/original/ykVgKWZrWglpaZKSKfHkFl3ioh.jpg"},{"id":3342750,"name":"Simba Dibinga","role":"Simba the Zookeeper (uncredited)"},{"id":928638,"name":"John Franchi","role":"Construction Architect (uncredited)","profile":"https://image.tmdb.org/t/p/original/hkl0bmoxU5DmuTqCOSf7QKH28sM.jpg"},{"id":2704900,"name":"J. Gulinello","role":"Waiter (uncredited)"},{"id":5991577,"name":"Bart the Bear 2","role":"Jerome the Bear"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","title":"Il Signore dello Zoo","overview":"Dopo aver subito un trauma amoroso quando la fidanzata Stephanie si è rifiutata di sposarlo di fronte alla più romantica delle cornici, Griffin è tornato a svolgere con passione il suo lavoro come guardiano del Franklin Park Zoo di Boston, in mezzo agli animali che ama tanto e dai cui è amato a sua volta. Cinque anni più tardi, ritrova per caso la sua ex alla festa di fidanzamento del fratello e torna in crisi, iniziando a pensare che abbandonare l'amato lavoro come guardiano per cominciare a vendere auto di lusso assieme al fratello rappresenti l'unico modo per conquistare una donna come Stephanie. Una volta diffusa la notizia, gli animali dello zoo si riuniscono per trovare una soluzione e decidono di aiutare Griffin a riconquistare la sua ex. Per farlo, gli impartiranno lezioni di corteggiamento animale e gli sveleranno il più grande segreto della zoologia: gli animali sanno parlare.","tagline":"Non parlare agli animali... a meno che non siano loro a cominciare!"},{"language":"en-US","overview":"Kindhearted Griffin Keyes is one of the best-loved caretakers at the Franklin Park Zoo, but he's more comfortable with the animals than with females of his own species as proven by his failed marriage proposal to the self-absorbed Stephanie several years ago. The animals have listened to Griffin pine over her for years and, after she reappears in his life, they decide to help Griffin rekindle the relationship and become the alpha male she wants him to be. They inadvertently reveal their secret ability to talk and, after Griffin's initial shock, teach him the rules of courtship, animal-style. Surprisingly, the animals' advice really works and Griffin is about to get everything he's ever dreamed of--or is he?","tagline":"Don't talk to the animals...unless they talk to you first."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/h9GjPgvD01VibACXw1aQEPnC4j7.jpg","background":"https://image.tmdb.org/t/p/original/rzTw6K1TbmF8qCUHWFrGhgXkBp5.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":38317,"type":"movie","originalLanguage":"en-US","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/h9GjPgvD01VibACXw1aQEPnC4j7.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/h9GjPgvD01VibACXw1aQEPnC4j7.jpg","language":"it","width":600,"height":843},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/h9GjPgvD01VibACXw1aQEPnC4j7.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/h9GjPgvD01VibACXw1aQEPnC4j7.jpg","language":"it","width":600,