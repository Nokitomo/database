treamingunity:images","path":"/images/73c61cc5-3ea6-40b0-a2dc-3b373faf4e79.webp"},"provider":"streamingunity"},{"id":590737,"filename":"ba4b20e2-9412-4a32-86f0-b20861431ac8.webp","type":"cover_mobile","lang":"it","imageable_type":"title","imageable_id":49875,"created_at":"2026-01-05T03:06:55.000000Z","updated_at":"2026-01-05T03:06:55.000000Z","original_url_field":null,"reference":{"base":"streamingunity:images","path":"/images/ba4b20e2-9412-4a32-86f0-b20861431ac8.webp"},"provider":"streamingunity"}],"episodeMappingUncertain":false,"seasons":[],"provenance":{},"warnings":[],"externalIdsEvidence":{"wikidata":{"source":"wikidata","sourceUrl":"https://www.wikidata.org/wiki/Q1305200","wikidataId":"Q1305200","tmdbId":10210,"type":"movie","imdbId":"tt0140379","tvdbId":2912}},"externalMedia":{"tmdb":{"source":"tmdb-api","id":10210,"type":"movie","sourceUrl":"https://www.themoviedb.org/movie/10210","fetchedAt":"2026-11-07T16:51:14.704Z","originalLanguage":"en-US","title":{"value":"Sogno di una notte di mezza estate","language":"it-IT"},"originalTitle":"A Midsummer Night's Dream","overview":{"value":"Alla fine del 1800 nella località di Atena, in Italia, c'è grande agitazione: siamo alla vigilia delle nozze tra il duca Teseo e Ippolita. Ma a margine di queste nozze, procede anche la difficile storia d'amore tra Ermia e Lisandro: i due non possono coronare il loro sogno, perché il padre di Ermia ha destinato la figlia a Demetrio, innamorato non corrisposto di Ermia e a sua volta amato ma senza speranza da Elena. Durante la notte, gli amanti tentano la fuga e si inoltrano nel bosco, inseguiti da Demetrio ed Elena. Qui queste situazioni vengono osservate da Oberon e dagli Elfi e Fate del suo magico regno. Assegnando alcuni compiti a Puck ed altri a Titania, Oberon fa in modo che il corso degli eventi cambi e l'amore giusto ritrovi la retta via. Adesso può finalmente celebrarsi il matrimonio tra Teseo e Ippolita. Durante le nozze, la compagnia di attori dilettanti diretta da Nick Chiappa mette in scena la triste storia d'amore tra Piramo e Tisbe, ottenendo grande successo.","language":"it-IT"},"tagline":{"value":"L'amore ci prende tutti in giro.","language":"it-IT"},"releaseDate":"1999-05-20","status":"Released","rating":6.4,"ratingCount":441,"genres":["Fantasy","Commedia","Romance"],"countries":["Italy","United States of America","United Kingdom"],"facts":{"Runtime":"116m"},"keywords":[],"networks":[],"socialLinks":{},"cast":[{"id":8945,"name":"Kevin Kline","role":"Nick Bottom","profile":"https://image.tmdb.org/t/p/original/ArH5dACd9AmWNNMnI6bGEkiFYIM.jpg"},{"id":1160,"name":"Michelle Pfeiffer","role":"Titania","profile":"https://image.tmdb.org/t/p/original/8qwNMFzmM3BxGKIj1iIqiHHBpx3.jpg"},{"id":4757,"name":"Rupert Everett","role":"Oberon","profile":"https://image.tmdb.org/t/p/original/g0kqfIxf9eIV7rOMQcbebsgMS9Z.jpg"},{"id":2283,"name":"Stanley Tucci","role":"Puck","profile":"https://image.tmdb.org/t/p/original/q4TanMDI5Rgsvw4SfyNbPBh4URr.jpg"},{"id":49148,"name":"Calista Flockhart","role":"Helena","profile":"https://image.tmdb.org/t/p/original/s0YPPAaIO5fnWI9baxp4TIkUXmn.jpg"},{"id":58016,"name":"Anna Friel","role":"Hermia","profile":"https://image.tmdb.org/t/p/original/uY9ugiMtyvNp8cN7jvNZfin7sud.jpg"},{"id":3894,"name":"Christian Bale","role":"Demetrius","profile":"https://image.tmdb.org/t/p/original/7Pxez9J8fuPd2Mn9kex13YALrCQ.jpg"},{"id":17287,"name":"Dominic West","role":"Lysander","profile":"https://image.tmdb.org/t/p/original/6y2M3EWslBPwPlugEFg8XDHfSJ0.jpg"},{"id":11064,"name":"David Strathairn","role":"Theseus","profile":"https://image.tmdb.org/t/p/original/w5YM2cGefPnkoyIXCi2UrCQW53r.jpg"},{"id":1957,"name":"Sophie Marceau","role":"Hippolyta","profile":"https://image.tmdb.org/t/p/original/b56TRCVVMZ2LMZqzXg0FxeGMd0u.jpg"},{"id":16407,"name":"Roger Rees","role":"Peter Quince","profile":"https://image.tmdb.org/t/p/original/pVZwILdpzTXECMUvLOSu12RbTHa.jpg"},{"id":106772,"name":"Max Wright","role":"Robin Starveling","profile":"htt