name":"Hans Heinrich von Twardowski","role":"Alan","profile":"https://image.tmdb.org/t/p/original/kip8D2tvcdEJiPtZaGioQD6vSjV.jpg"},{"id":1016382,"name":"Rudolf Lettinger","role":"Dr. Olsen","profile":"https://image.tmdb.org/t/p/original/3NK7jmvEV3OMMZDy4ke1qxFlLZC.jpg"},{"id":1090550,"name":"Henri Peters-Arnolds","role":"Young Doctor (uncredited)","profile":"https://image.tmdb.org/t/p/original/cSAwbfXurAQ7RNQiTQ2zS4dHbV2.jpg"},{"id":77,"name":"Rudolf Klein-Rogge","role":"Criminal (uncredited)","profile":"https://image.tmdb.org/t/p/original/fbP75fGfXFQlkf3Q5oHbJ4wjG1g.jpg"},{"id":29568,"name":"Hans Lanser-Rudolf","role":"Old Man (uncredited)"},{"id":1090552,"name":"Ludwig Rex","role":"Murderer (uncredited)"},{"id":37889,"name":"Elsa Wagner","role":"Landlady (uncredited)","profile":"https://image.tmdb.org/t/p/original/f8ELn1caKeFZjxaGS3VAK2M4pA1.jpg"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","title":"Il gabinetto del Dr. Caligari","overview":"Un uomo chiamato Francis racconta la storia del suo amico Alan e della sua fidanzata. Recatosi ad una fiera, Alan visita il dottor Caligari, che mette in mostra un misterioso sonnambulo: a questo Alan chiede quanto gli resta da vivere e l'uomo risponde fino all'alba del giorno dopo..","tagline":"Devi diventare Caligari!"},{"language":"en-US","title":"The Cabinet of Dr. Caligari","overview":"Francis, a young man, recalls in his memory the horrible experiences he and his fiancée Jane recently went through. Francis and his friend Alan visit The Cabinet of Dr. Caligari, an exhibit where the mysterious doctor shows the somnambulist Cesare, and awakens him for some moments from his death-like sleep.","tagline":"You must become Caligari!"},{"language":"de-DE","overview":"Auf dem Jahrmarkt eines Städtchens führt der Magier und Schausteller Dr. Caligari seine schwarzen Künste vor. Sein Medium, der im Dauerschlaf liegende hypnotisierte Cesare, kann die Zukunft vorhersagen. Im faszinierten Publikum sind Francis und sein Freund Alan. Auf die Frage von Alan, wie lange er zu leben habe, antwortet Cesare: „Bis zum Morgengrauen“. In der Nacht wird Alan ermordet, wenig später Francis’ Freundin Jane verschleppt. Die Spur führt Francis zu Cesare und Dr. Caligari, der sich als Leiter einer Irrenanstalt entpuppt …","tagline":"Du musst zu Caligari werden!"}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/qO6Zs3haoU5pAa9XiilGSLaVEhR.jpg","background":"https://image.tmdb.org/t/p/original/sLq72hBx8Xs2IISVsZJqgjOd31b.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":234,"type":"movie","originalLanguage":"de-DE","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/qO6Zs3haoU5pAa9XiilGSLaVEhR.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/qO6Zs3haoU5pAa9XiilGSLaVEhR.jpg","language":"it","width":1000,"height":1500},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/qO6Zs3haoU5pAa9XiilGSLaVEhR.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/qO6Zs3haoU5pAa9XiilGSLaVEhR.jpg","language":"it","width":1000,"height":1500}]},"en":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/myK9DeIsXWGKgUTZyGXg2IfFk0W.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/myK9DeIsXWGKgUTZyGXg2IfFk0W.jpg","language":"en","width":1231,"height":1847},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/myK9DeIsXWGKgUTZyGXg2IfFk0W.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/myK9DeIsXWGKgUTZyGXg2IfFk0W.jpg","language":"en","width":1231,"height":1847},{"type":"poster","url":"https://image.tmdb.org/t/p/original/cXSzcOF6RINcXrExn0nR4ExFoR3.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/cXSzcOF6RINcXrExn0nR4ExFoR3.jpg","language":"en","width":1280,"height":1920},{"type":"poster","url":"https://image.tmdb.org/t/p/original/vw3QfEyIX1iK