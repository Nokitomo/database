provenance":{},"warnings":[],"externalIdsEvidence":{"wikidata":{"source":"wikidata","sourceUrl":"https://www.wikidata.org/wiki/Q699679","wikidataId":"Q699679","tmdbId":10839,"type":"movie","imdbId":"tt0074695","tvdbId":9552}},"externalMedia":{"tmdb":{"source":"tmdb-api","id":10839,"type":"movie","sourceUrl":"https://www.themoviedb.org/movie/10839","fetchedAt":"2026-11-14T17:49:26.934Z","originalLanguage":"en-US","title":{"value":"La croce di ferro","language":"it-IT"},"originalTitle":"Cross of Iron","overview":{"value":"Penisola di Taman, Crimea, 1943, durante la seconda guerra mondiale il caporale Rolf Steiner opera in un plotone di esploratori, un'unità scelta che compie azioni in profondità nelle linee sovietiche; è un uomo disilluso dalla guerra ma nel contempo un militare dalle grandi capacità e per questo tenuto in grande considerazione dal comandante del reggimento, il colonnello Brandt, che gli lascia ampia libertà di azione.","language":"it-IT"},"tagline":{"value":"Sergente Steiner dove è il tuo plotone? Tu Capitano Stransky sei il mio plotone!","language":"it-IT"},"releaseDate":"1977-01-28","status":"Released","rating":7.2,"ratingCount":512,"genres":["Dramma","Azione","Storia","Guerra"],"countries":["Germany","United Kingdom"],"facts":{"Runtime":"132m"},"keywords":[],"networks":[],"socialLinks":{},"cast":[{"id":5563,"name":"James Coburn","role":"Unteroffizier / Feldwebel Rolf Steiner","profile":"https://image.tmdb.org/t/p/original/9GApjInyrVvjnTAr652C1aViPqZ.jpg"},{"id":12150,"name":"Maximilian Schell","role":"Hauptmann Stransky","profile":"https://image.tmdb.org/t/p/original/nGUOlMAgcXzLAEoQnKXQJ2KvWxb.jpg"},{"id":2091,"name":"James Mason","role":"Oberst Brandt","profile":"https://image.tmdb.org/t/p/original/vCABivuMBCT78sh5G0q8jO5rkT.jpg"},{"id":2076,"name":"David Warner","role":"Hauptmann Kiesel","profile":"https://image.tmdb.org/t/p/original/AlsZcAY2c4chfOxMW69gHQzH1B2.jpg"},{"id":9927,"name":"Klaus Löwitsch","role":"Unteroffizier Krüger","profile":"https://image.tmdb.org/t/p/original/dMdQVN06vzi7Tn9qByIvxDHxE2S.jpg"},{"id":20016,"name":"Vadim Glowna","role":"Gefreiter Kern","profile":"https://image.tmdb.org/t/p/original/zIWBd4kknAY292OJc99GN9q6vRd.jpg"},{"id":37346,"name":"Roger Fritz","role":"Leutnant Treibig","profile":"https://image.tmdb.org/t/p/original/tRpBOaRmDGojNBy1wMc4K8orjCr.jpg"},{"id":37338,"name":"Dieter Schidor","role":"Anselm","profile":"https://image.tmdb.org/t/p/original/lF1YvzJWyG6EA6gCiPk72mK6cwV.jpg"},{"id":21833,"name":"Burkhard Driest","role":"Schütze Maag","profile":"https://image.tmdb.org/t/p/original/k2flWgifoErLajv2mSqAhMblVEG.jpg"},{"id":36496,"name":"Fred Stillkrauth","role":"Unteroffizier Schnurrbart","profile":"https://image.tmdb.org/t/p/original/f356J8CaC3vtoO4qLH6Jx1YwgJX.jpg"},{"id":1313503,"name":"Michael Nowka","role":"Dietz"},{"id":44439,"name":"Véronique Vendell","role":"Marga"},{"id":22623,"name":"Arthur Brauss","role":"Zoll","profile":"https://image.tmdb.org/t/p/original/agNKyZpIUdA0C7l7O7c1iynala2.jpg"},{"id":12776,"name":"Senta Berger","role":"Eva","profile":"https://image.tmdb.org/t/p/original/A6vTzs8BVX2XgOofzo6UiThBaoV.jpg"},{"id":584933,"name":"Demeter Bitenc","role":"Hauptmann Pucher (uncredited)"},{"id":590362,"name":"Igor Galo","role":"Leutnant Meyer (uncredited)"},{"id":1889231,"name":"Katherine Haber","role":"Nurse Sadie Finkelstein (uncredited)"},{"id":36845,"name":"Wolf C. Hartwig","role":"Hartwig (uncredited)"},{"id":1604364,"name":"Wolfgang Hess","role":"Schütze Maag (voice) (uncredited)"},{"id":1423212,"name":"Sweeney MacArthur","role":"Boy Soldier (uncredited)"},{"id":1043262,"name":"Irfan Mensur","role":"Partizan Soldier (uncredited)","profile":"https://image.tmdb.org/t/p/original/bJcy6exqBmi8AQvY6QaSzxazoNg.jpg"},{"id":1305892,"name":"Hermina Pipinić","role":"Ruskinja (uncredited)"},{"id":11841,"name":"Robert Rietti","role":"German Officer (voice) (uncredited)","profile":"https://image.tmdb.org/t/p/original/2Xa7VvAyV2zMqd2OhrgcUoorG0w.jpg"},{"id":556090,"name":"Dragomir Stanojević","role":"Corporal Joseph Keppler (uncredited)","profile":"https://image.tmdb.org/t/p/original/AnkYSAwE6kDsipSdVnykPWiuI7d.jpg"},{"id":70876,"name":"Slavko Štimac","role":"Michail (uncredited)","profile":"https://image.tmdb.org/t/p/original/mQMeX8rdkTVsKLNW17y1BrCgbqr.jpg"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","title":"La croce di ferro","overview":"Penisola di Taman, Crimea, 1943, durante la seconda guerra mondiale il caporale Rolf Steiner opera in un plotone di esploratori, un'unità scelta che compie azioni in profondità nelle linee sovietiche; è un uomo disilluso dalla guerra ma nel contempo un militare dalle grandi capacità e per questo tenuto in grande considerazione dal comandante del reggimento, il colonnello Brandt, che gli lascia ampia libertà di azione.","tagline":"Sergente Steiner dove è il tuo plotone? Tu Capitano Stransky sei il mio plotone!"},{"language":"en-US","overview":"It is 1943, and the German army—ravaged and demoralised—is hastily retreating from the Russian front. In the midst of the madness, conflict brews between the aristocratic yet ultimately pusillanimous Captain Stransky and the courageous Corporal Steiner. Stransky is the only man who believes that the Third Reich is still vastly superior to the Russian army. However, within his pompous persona lies a quivering coward who longs for the Iron Cross so that he can return to Berlin a hero. Steiner, on the other hand is cynical, defiantly non-conformist and more concerned with the safety of his own men rather than the horde of military decorations offered to him by his superiors.","tagline":"On the Eastern front in 1943, the German soldiers no longer had any ideals. They were not fighting for the Party—but for their lives!"}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/xXAK8ZXFjHeHCyXecnGBpl2vB7P.jpg","background":"https://image.tmdb.org/t/p/original/edU