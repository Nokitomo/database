mo.  La tribu es una película de comedia dirigida por Fernando Colomo (Isla bonita, Al sur de Granada) que cuenta con la presencia de Carmen Machi (Pieles, Ocho apellidos vascos) y Paco León (Embarazados, Kiki, el amor se hace) entre otros.","tagline":"Una Película de Fernando Colomo"}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/pASeM9pyZtqDqTkXD1mNvqqh9hK.jpg","background":"https://image.tmdb.org/t/p/original/kn9mkIS9Wawan5F18RpHl2lQer3.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":504345,"type":"movie","originalLanguage":"es-ES","series":{"poster":{"it":{"status":"missing","candidates":[]},"en":{"status":"missing","candidates":[]},"es":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/pASeM9pyZtqDqTkXD1mNvqqh9hK.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/pASeM9pyZtqDqTkXD1mNvqqh9hK.jpg","language":"es","width":2000,"height":3000},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/pASeM9pyZtqDqTkXD1mNvqqh9hK.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/pASeM9pyZtqDqTkXD1mNvqqh9hK.jpg","language":"es","width":2000,"height":3000},{"type":"poster","url":"https://image.tmdb.org/t/p/original/iFrqw3uWFHAPHIDBcVKtMLPLKNP.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/iFrqw3uWFHAPHIDBcVKtMLPLKNP.jpg","language":"es","width":699,"height":1000},{"type":"poster","url":"https://image.tmdb.org/t/p/original/hl8qArHSUKFxOYIaeACKfdNn7RV.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/hl8qArHSUKFxOYIaeACKfdNn7RV.jpg","language":"es","width":800,"height":1133},{"type":"poster","url":"https://image.tmdb.org/t/p/original/e3sFXOxDhyrrtcnOEqfZnkD8Juz.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/e3sFXOxDhyrrtcnOEqfZnkD8Juz.jpg","language":"es","width":2000,"height":3000}]},"xx":{"status":"missing","candidates":[]}},"background":{"it":{"status":"available","selected":{"type":"backdrop","url":"ht