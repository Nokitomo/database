"movie","imdbId":"tt0330229","tvdbId":13110}},"externalMedia":{"tmdb":{"source":"tmdb-api","id":870,"type":"movie","sourceUrl":"https://www.themoviedb.org/movie/870","fetchedAt":"2026-11-08T03:51:07.595Z","originalLanguage":"ja-JP","title":{"value":"Dolls","language":"it-IT"},"originalTitle":"ドールズ","overview":{"value":"Tre storie d'amore infelice si incontrano attraverso le quattro stagioni. Due vagabondi legati da una corda rossa, erano stati una coppia felice; un anziano capo yakuza torna nei giardini dove trent'anni prima era solito pranzare con la fidanzata; uno sfegatato fan di una cantante pop si acceca per incontrarla, sulla spiaggia dove lei, sfigurata, è ferma a fissare il mare.","language":"it-IT"},"tagline":{"value":"Three stories of never-ending love.","language":"en-US"},"releaseDate":"2002-10-12","status":"Released","rating":7.5,"ratingCount":384,"genres":["Dramma","Romance"],"countries":["Japan"],"facts":{"Runtime":"114m"},"keywords":[],"networks":[],"socialLinks":{},"cast":[{"id":13249,"name":"Miho Kanno","role":"Sawako","profile":"https://image.tmdb.org/t/p/original/yRiVsxGcbRHVxQOYTUBqvuxkjuY.jpg"},{"id":13250,"name":"Hidetoshi Nishijima","role":"Matsumoto","profile":"https://image.tmdb.org/t/p/original/3FBdbeMMWfyKmHS5j8IECwsZWcY.jpg"},{"id":13251,"name":"Tatsuya Mihashi","role":"Hiro","profile":"https://image.tmdb.org/t/p/original/s33XOrwOEEVoWeScWMK2Afs7Njl.jpg"},{"id":13252,"name":"Chieko Matsubara","role":"Ryoko","profile":"https://image.tmdb.org/t/p/original/t6ms64fzvYnAvvffxQST2kojvSe.jpg"},{"id":13253,"name":"Kyoko Fukada","role":"Haruna Yamaguchi","profile":"https://image.tmdb.org/t/p/original/qip0npPSxHyKG5xCiX9fkg3eSXa.jpg"},{"id":13254,"name":"Tsutomu Takeshige","role":"Nukui","profile":"https://image.tmdb.org/t/p/original/8VIIvD8EWkMSLZFEvvvqAw4tdt4.jpg"},{"id":13255,"name":"Kayoko Kishimoto","role":"Haruna's Aunt","profile":"https://image.tmdb.org/t/p/original/mJy9ycpWe2nfPly0PPDqObjp8On.jpg"},{"id":58604,"name":"Nao Omori","role":"Ma