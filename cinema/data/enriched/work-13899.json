.000000Z","updated_at":"2026-06-11T15:34:10.000000Z","original_url_field":null,"reference":{"base":"streamingunity:images","path":"/images/c6537437-403f-430e-aaba-b228ee5ed3a5.webp"},"provider":"streamingunity"}],"episodeMappingUncertain":false,"seasons":[],"provenance":{},"warnings":[],"externalIdsEvidence":{"wikidata":{"source":"wikidata","sourceUrl":"https://www.wikidata.org/wiki/Q2698704","wikidataId":"Q2698704","tmdbId":40149,"type":"movie","imdbId":"tt0122136","tvdbId":10391}},"externalMedia":{"tmdb":{"source":"tmdb-api","id":40149,"type":"movie","sourceUrl":"https://www.themoviedb.org/movie/40149","fetchedAt":"2026-11-08T02:06:49.421Z","originalLanguage":"ja-JP","title":{"value":"Kuroneko","language":"it-IT"},"originalTitle":"藪の中の黒猫","overview":{"value":"Giappone, epoca Jidai-geki (XVII-XVIII secolo dell'Era Volgare): durante una delle innumerevoli guerre civili, in una casa di campagna, vivono una donna e sua nuora mentre il marito è lontano a combattere quando una notte vengono derubate, violentate ed uccise da un gruppo di samurai senza legge e l'abitazione incendiata. Il giorno dopo un gatto nero (kuroneko in lingua nipponica) si aggira tra le macerie ed i poveri resti delle due donne.  Tempo dopo, nella stessa zona, alcuni samurai vengono ritrovati dissanguati nei boschi. Le due donne sono tornate in vita per vendicarsi dei torti subiti, seducendo ed uccidendo tutti i soldati che vagano per quelle terre. Il governatore Raiko, allo scopo di indagare su questi strani avvenimenti, invia Gintoki, un valoroso samurai, il quale, scovate le due assassine, trova ad attenderlo un'amarissima sorpresa: le due donne sono gli spettri di sua madre e sua moglie.","language":"it-IT"},"tagline":{"value":"Beware what lurks in the bamboo forest craving the blood of samurai!","language":"en-US"},"releaseDate":"1968-02-24","status":"Released","rating":7.4,"ratingCount":241,"genres":["Dramma","Fantasy","Horror"],"countries":["Japan"],"facts":{"Runtime":"100m"},"keywords":[],"networks":[],"socialLinks":{},"cast":[{"id":133602,"name":"Kichiemon Nakamura II","role":"Gintoki","profile":"https://image.tmdb.org/t/p/original/z8f9xZpVBKMTTYXll4pe0SaKbbC.jpg"},{"id":33728,"name":"Nobuko Otowa","role":"Yone","profile":"https://image.tmdb.org/t/p/original/6vcByiFlOE9JiLGWNKRtN8k0uil.jpg"},{"id":150378,"name":"Kiwako Taichi","role":"Shige","profile":"https://image.tmdb.org/t/p/original/ppsf28CStbirgMc1ZCBMFCWe7Tk.jpg"},{"id":33730,"name":"Kei Satō","role":"Raiko","profile":"https://image.tmdb.org/t/p/original/xyb1DI4HViq1aEvc3pgJV5Xw2Sn.jpg"},{"id":33732,"name":"Taiji Tonoyama","role":"Farmer","profile":"https://image.tmdb.org/t/p/original/k88bvJ91SiL2Nn6QtQf7hB8U4iv.jpg"},{"id":138748,"name":"Rokkō Toura","role":"Samurai","profile":"https://image.tmdb.org/t/p/original/ucHF4SWobpjSKj2qkLZgkXPdM08.jpg"},{"id":224658,"name":"Hideo Kanze","role":"Mikado","profile":"https://image.tmdb.org/t/p/original/8A9XTNNbAYFPcnA8qYYYinZFJrG.jpg"},{"id":133710,"name":"Eimei Esumi","role":"Subordinate","profile":"https://image.tmdb.org/t/p/original/Aibi5K9b1WgqhiXu8pqVS7fR3r0.jpg"},{"id":553430,"name":"Shōji Ōki","role":"Subordinate"},{"id":1274449,"name":"Kentarô Kaji","role":"Subordinate"},{"id":2113109,"name":"Joji Taki","role":"Subordinate"},{"id":1584149,"name":"Chiyo Okada","role":"Nehiko","profile":"https://image.tmdb.org/t/p/original/7sO2G7WOFJk60JCJwHnrWPUCDOX.jpg"},{"id":5637722,"name":"Miyako Kasai"},{"id":2467391,"name":"Kayoko Sebata"},{"id":5637724,"name":"Harumi Hirota"},{"id":5637727,"name":"Yoshiko Uchi"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","title":"Kuroneko","overview":"Giappone, epoca Jidai-geki (XVII-XVIII secolo dell'Era Volgare): durante una delle innumerevoli guerre civili, in una casa di campagna, vivono una donna e sua nuora mentre il marito è lontano a combattere quando una notte vengono derubate, violentate ed uccise da un gruppo di samurai senza legge e l'abitazione incendiata. Il giorno dopo un gatto nero (kuroneko in lingua nipponica) si aggira tra le macerie ed i poveri resti delle due donne.  Tempo dopo, nella stessa zona, alcuni samurai vengono ritrovati dissanguati nei boschi. Le due donne sono tornate in vita per vendicarsi dei torti subiti, seducendo ed uccidendo tutti i soldati che vagano per quelle terre. Il governatore Raiko, allo scopo di indagare su questi strani avvenimenti, invia Gintoki, un valoroso samurai, il quale, scovate le due assassine, trova ad attenderlo un'amarissima sorpresa: le due donne sono gli spettri di sua madre e sua moglie."},{"language":"en-US","title":"Kuroneko","overview":"In the Sengoku period, a woman and her daughter are raped and murdered by soldiers during a time of civil war. Afterwards, a series of samurai returning from the war through that area are found mysteriously dead with their throats torn out. The governor calls in a wild and fierce young hero to quell what is evidently an Onryō ghost.","tagline":"Beware what lurks in the bamboo forest craving the blood of samurai!"},{"language":"ja-JP","title":"藪の中の黒猫","overview":"平安時代の京都では、羅城門の外で相次いで侍殺害事件が相次いで発生しました。 夜に侍がこの門を通ると、必ず一人で歩く美しい女性(太地きわ子が演じる)を見かけ、その女性は怪物に変身し、美しく誘惑され、侍の準備不足に乗じて彼を殺すという噂が広まっています。\r 銀時(演:中村義衛門)は、庶民出身の侍で、将軍頼光(佐藤慶演)から怪物たちを鎮めるよう命じられました。 余羅成は城門の外でバンシーに会い、それが実は故郷の妻であることを知った。 銀時は妻と共に山に登り、長年不在だった母親(音葉信子が演じる)に会いました。 銀時は噂を信じてしまったことに苛立ち、毎晩妻に会いに来ていた。 8日目には妻の痕跡はなく、山には母親だけが残っていた。 この時点で銀時は、母と妻がもはや人間ではなく、妻が自分の人間的な思考のために魔界に送り返されたことを悟り、母は恨みと復讐に満ちた怪物となってしまった......"}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/eA8cojrIPs9q37Zyw9ktRHADepd.jpg","background":"https://image.tmdb.org/t/p/original/oLui5hnc8HnkVDXruisqu3LZb6H.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":40149,"type":"movie","originalLanguage":"ja-JP","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/eA8cojrIPs9q37Zyw