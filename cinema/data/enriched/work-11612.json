seDate":"2003-07-16","status":"Released","rating":6.2,"ratingCount":21,"genres":["Crime","Dramma"],"countries":["France"],"facts":{"Runtime":"90m"},"keywords":[],"networks":[],"socialLinks":{},"cast":[{"id":37758,"name":"Éric Cantona","role":"Le commissaire Séléna","profile":"https://image.tmdb.org/t/p/original/lMIXZd1QiHH7Y5emujCKGnRh6np.jpg"},{"id":56241,"name":"Rachida Brakni","role":"Elsa","profile":"https://image.tmdb.org/t/p/original/bsPgWJjtKcXI7IZH2ro0A7BlJfA.jpg"},{"id":16925,"name":"Caroline Silhol","role":"Anne Lachaume","profile":"https://image.tmdb.org/t/p/original/tC1HwuCIhRkTJeF6VLUQBoiG5Qb.jpg"},{"id":1977,"name":"Richard Bohringer","role":"Émile Lachaume","profile":"https://image.tmdb.org/t/p/original/v6372ku0d2Y28zUJ7mGrwaNQ04g.jpg"},{"id":2970,"name":"Jocelyn Quivrin","role":"Marc Brisset","profile":"https://image.tmdb.org/t/p/original/pkAf1NTirff030AuwBzRthqfrgk.jpg"},{"id":28787,"name":"Jean-Michel Noirey","role":"Benoît Collet","profile":"https://image.tmdb.org/t/p/original/pqsCpKhWPjikh6muLr97O4VsxTJ.jpg"},{"id":44560,"name":"Hubert Saint-Macary","role":"Le juge Salabert","profile":"https://image.tmdb.org/t/p/original/uSekF3E1h0BfA9PdMcewSBdWee8.jpg"},{"id":1318270,"name":"Valérie Messas","role":"Clara Gauthier"},{"id":136745,"name":"Lucien Jean-Baptiste","role":"Le légiste","profile":"https://image.tmdb.org/t/p/original/wjnap4CYD9y0SKGFsh06glK4ph2.jpg"},{"id":1318271,"name":"Richard Guedj","role":"Le médecin de l'hôpital","profile":"https://image.tmdb.org/t/p/original/9qGL2RbwOYoxN8jW4LnsigBEB4K.jpg"},{"id":1123091,"name":"Eric Averlant","role":"L'homme obèse","profile":"https://image.tmdb.org/t/p/original/4S4zr5dmNEjrrVjOTePEVF01pPT.jpg"},{"id":3518398,"name":"Mikaël Chiche","role":"Policier du prétoire"},{"id":3133323,"name":"Jean-Luc Bosso","profile":"https://image.tmdb.org/t/p/original/bth0yl5G5o4D6Zm6Ia9FjB5l0lj.jpg"},{"id":3777763,"name":"Armand Binisti"},{"id":3865686,"name":"Emmanuel Barilley","role":"Richard Séléns"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT"},{"language":"en-US","title":"The Overeater","overview":"Séléna is chief of the Marseille police. Respected and feared by his men, his sole enemy seems to be himself, along with his 300 pounds. Strangled by the bursting straight-jacket of his body, tortured by his past, he leads a solitary life in a large isolated house. Séléna is the only person who knows that Elsa was guilty of the murder of her uncle, a wealthy shipowner. Fascinated by the young woman’s beauty, he offers her a strange deal: in exchange for his silence, he demands that she dines with him every night for a year."},{"language":"fr-FR","title":"L'Outremangeur","overview":"160 kilos de chair et de volonté, alliés à une intuition magistrale, font du commissaire principal Séléna, une figure du SRPJ de Marseille. Inspirant crainte et respect, il ne semble avoir qu'un seul ennemi capable de l'abattre : lui-même. Fasciné par une très belle jeune femme, Elsa, qu'il sait coupable du meurtre de son oncle, Victor Lachaume, l'un des plus importants armateurs du port, il propose un étrange marché : contre son silence, il exige qu'elle vienne dîner chez lui tous les soirs pendant un an. Révoltée par la perversité de la situation, Elsa se plie tout de même à ce rituel imposé."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/hNO1HfOJpTshXlQ03khFOnwpsEl.jpg","background":"https://image.tmdb.org/t/p/original/a27p0TRn06YG3nfrm0q4Xs5TtmI.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":61361,"type":"movie","originalLanguage":"fr-FR","series":{"poster":{"it":{"status":"missing","candidates":[]},"en":{"status":"missing","candidates":[]},"fr":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/hNO1HfOJpTshXlQ03khFOnwpsEl.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/hNO1HfOJpTshXlQ03khFOnwpsEl.jpg","