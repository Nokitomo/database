7:44:12.000000Z","updated_at":"2025-10-14T17:44:12.000000Z","original_url_field":null,"reference":{"base":"streamingunity:images","path":"/images/852c063a-15ee-4f41-95ca-9fb459efdf7f.webp"},"provider":"streamingunity"}],"episodeMappingUncertain":false,"seasons":[],"provenance":{},"warnings":[],"externalIdsEvidence":{"wikidata":{"source":"wikidata","sourceUrl":"https://www.wikidata.org/wiki/Q116753139","wikidataId":"Q116753139","tmdbId":757796,"type":"movie","imdbId":"tt11623722","tvdbId":340664}},"externalMedia":{"tmdb":{"source":"tmdb-api","id":757796,"type":"movie","sourceUrl":"https://www.themoviedb.org/movie/757796","fetchedAt":"2026-11-07T03:53:14.377Z","originalLanguage":"el-EL","title":{"value":"Green Sea","language":"it-IT"},"originalTitle":"Πράσινη Θάλασσα","overview":{"value":"Anna has lost her memory but she hasn’t forgotten how to cook. One night she shows up in a working-class neighborhood. There she meets Roula and gets a job as a cook and a place to stay at his shabby seaside tavern. In the kitchen, amidst the scents of spices and old forgotten recipes, Anna struggles to rebuild her past. Her simple but delicious food awakens memories for the regulars who in turn help her to reconnect with herself. The story takes an unexpected turn when Roula suddenly stumbles upon the Green Sea and discovers Anna’s true identity.","language":"en-US"},"releaseDate":"2021-11-25","status":"Released","rating":6.4,"ratingCount":18,"genres":["Dramma"],"countries":["Germany","Greece"],"facts":{"Runtime":"94m"},"keywords":[],"networks":[],"socialLinks":{},"cast":[{"id":122426,"name":"Angeliki Papoulia","role":"Anna","profile":"https://image.tmdb.org/t/p/original/59vmhblokh20zXL19Velo0ri1jA.jpg"},{"id":980215,"name":"Yannis Tsortekis","role":"Roula","profile":"https://image.tmdb.org/t/p/original/bpMkkFGhZCRHBdEtv7zgxTEM2Qt.jpg"},{"id":1184200,"name":"Tasos Palatzidis","role":"Kyriakos","profile":"https://image.tmdb.org/t/p/original/qYqtHB1NUgo4kgFNzsU4eK4DvXm.jpg"},{"id":2707850,"name":"Christos Kontogeorgis","role":"Nikitas","profile":"https://image.tmdb.org/t/p/original/jt5eP0ythzUxuqrtNgegCvyAhIS.jpg"},{"id":1207403,"name":"Meletis Georgiadis","role":"Thomas","profile":"https://image.tmdb.org/t/p/original/1633SaHzzO5igIqNtKjCF7AH9gp.jpg"},{"id":2137558,"name":"Stefanos Kosmidis","role":"Andreas","profile":"https://image.tmdb.org/t/p/original/6r1ZQnLdqR2TCaRomvbp3MXYbh6.jpg"},{"id":3351550,"name":"Vaso Iatropoulou","role":"Maro"},{"id":3351551,"name":"Anastasia Dendia","role":"Nikoleta"},{"id":3335697,"name":"Fivos Papakostas","role":"Stathis","profile":"https://image.tmdb.org/t/p/original/r6GriJyOKSnnSLo9yaMstPXBefz.jpg"},{"id":1351133,"name":"Anneta Papathanasiou"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","title":"Green Sea"},{"language":"en-US","title":"Green Sea","overview":"Anna has lost her memory but she hasn’t forgotten how to cook. One night she shows up in a working-class neighborhood. There she meets Roula and gets a job as a cook and a place to stay at his shabby seaside tavern. In the kitchen, amidst the scents of spices and old forgotten recipes, Anna struggles to rebuild her past. Her simple but delicious food awakens memories for the regulars who in turn help her to reconnect with herself. The story takes an unexpected turn when Roula suddenly stumbles upon the Green Sea and discovers Anna’s true identity."},{"language":"el-EL","overview":"H Άννα υποφέρει από αμνησία, όμως θυμάται πώς να μαγειρεύει. Βρίσκει δουλειά και φιλοξενία σε μια λαϊκή παραθαλάσσια ταβέρνα που ανήκει στον μοναχικό Ρούλα. Στην κουζίνα, ανάμεσα στις μυρωδιές των μπαχαρικών και σε παλιές ξεχασμένες συνταγές, αγωνίζεται να ξαναθυμηθεί το παρελθόν της. Τα απλά αλλά πεντανόστιμα φαγητά της ξυπνάνε αναμνήσεις στους θαμώνες και δημιουργούν δεσμούς ανάμεσα σε αυτούς και στην Άννα. Όμως τα πράγματα παίρνουν απρόσμενη τροπή όταν ο Ρούλα πέφτει τυχαία πάνω στην Πράσινη Θάλασσα και ανακαλύπτει την πραγματική ταυτότητα της Άννας."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/1A8ud6idDQgQIrqTgcPIgimQtz8.jpg","background":"https://image.tmdb.org/t/p/original/1koDX96vRbXbhV4mlCdpRLpRzi2.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":757796,"type":"movie","originalLanguage":"el-EL","series":{"poster":{"it":{"status":"missing","candidates":[]},"en":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/7TtFZ3QY5T59NB4HzxXIBfAwwr5.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/7TtFZ3QY5T59NB4HzxXIBfAwwr5.jpg","language":"en","width":945,"height":1418},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/7TtFZ3QY5T59NB4HzxXIBfAwwr5.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/7TtFZ3QY5T59NB4HzxXIBfAwwr5.jpg","language":"en","width":945,"height":1418},{"type":"poster","url":"https://image.tmdb.org/t/p/original/emrxQ7mAV1ALouhB58njn2Xyn8F.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/emrxQ7mAV1ALouhB58njn2Xyn8F.jpg","language":"en","width":946,"height":1418}]},"el":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/1A8ud6idDQgQIrqTgcPIgimQtz8.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/1A8ud6idDQgQIrqTgcPIgimQtz8.jpg","language":"el","width":945,"height":1418},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/1A8ud6idDQgQIrqTgcPIgimQtz8.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/1A8ud6idDQgQIrqTgcPIgimQtz8.jpg","language":"el","width":945,"height":1418},{"type":"poster","url":"https://image.tmdb.org/t/p/original/1YnlbOnwARptChJjnp5XUJN7GEh.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/1YnlbOnwARptChJjnp5XUJN7GEh.jpg","language":"el","width":683,"height":1024}]},"xx":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/dpYPTC6i1TTK8AR43d80zZWMjW4.jpg","previewUrl":"https://ima