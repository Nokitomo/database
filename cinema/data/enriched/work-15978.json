66-4f34-841b-c7f50bbf275e.webp","type":"cover_mobile","lang":null,"imageable_type":"title","imageable_id":691,"created_at":"2023-07-30T05:38:48.000000Z","updated_at":"2023-07-30T05:38:48.000000Z","original_url_field":null,"reference":{"base":"streamingunity:images","path":"/images/c85afc93-7366-4f34-841b-c7f50bbf275e.webp"},"provider":"streamingunity"},{"id":9200,"filename":"e6671db9-c41f-4db5-bf12-d05a79a7a9d9.webp","type":"cover_mobile","lang":"it","imageable_type":"title","imageable_id":691,"created_at":"2023-05-18T12:00:29.000000Z","updated_at":"2025-05-12T09:24:21.000000Z","original_url_field":null,"reference":{"base":"streamingunity:images","path":"/images/e6671db9-c41f-4db5-bf12-d05a79a7a9d9.webp"},"provider":"streamingunity"}],"episodeMappingUncertain":false,"seasons":[],"provenance":{},"warnings":[],"externalIdsEvidence":{"wikidata":{"source":"wikidata","sourceUrl":"https://www.wikidata.org/wiki/Q86663401","wikidataId":"Q86663401","tmdbId":593660,"type":"movie","imdbId":"tt7997966","tvdbId":132729}},"externalMedia":{"tmdb":{"source":"tmdb-api","id":593660,"type":"movie","sourceUrl":"https://www.themoviedb.org/movie/593660","fetchedAt":"2026-11-08T08:32:04.084Z","originalLanguage":"it-IT","title":{"value":"My Brother Chases Dinosaurs","language":"en-US"},"originalTitle":"Mio fratello rincorre i dinosauri","overview":{"value":"Jack ha sempre desiderato un fratello maschio con cui giocare e quando nasce Gio, i suoi genitori gli raccontano che suo fratello è un bambino “speciale”. Da quel momento, nel suo immaginario, Gio diventa un supereroe, dotato di poteri incredibili, come un personaggio dei fumetti. Con il passare del tempo Jack scopre che in realtà il fratellino ha la sindrome di Down e per lui diventa un segreto da non svelare. Quando Jack arriva al liceo e si innamora di Arianna, decide di nascondere alla ragazza e ai nuovi amici l’esistenza del fratello. Ma non si può pretendere di essere amati nascondendo una parte così importante di sé. La verità verrà presto a galla e alla fine Jack riuscirà a farsi travolgere dall’energia e dalla vitalità di Gio, che grazie al suo originale punto di vista riuscirà a trasformare il mondo, proprio come un supereroe.","language":"it-IT"},"tagline":{"value":"My brother was more than special... he was a superhero.","language":"en-US"},"releaseDate":"2019-09-05","status":"Released","rating":7,"ratingCount":309,"genres":["Commedia","Famiglia"],"countries":["Italy","Spain"],"facts":{"Runtime":"101m"},"keywords":[],"networks":[],"socialLinks":{},"cast":[{"id":57345,"name":"Alessandro Gassmann","role":"Davide Mazzariol","profile":"https://image.tmdb.org/t/p/original/1RgJdkPXpwfQWumzZ4h3KKxVv4V.jpg"},{"id":9627,"name":"Isabella Ragonese","role":"Katia Mazzariol","profile":"https://image.tmdb.org/t/p/original/5X9Ll0FTE4jLZrX1uJpL0xxdk2W.jpg"},{"id":25258,"name":"Rossy de Palma","role":"Auntie Rock / Zia Dolores","profile":"https://image.tmdb.org/t/p/original/3IH9ZBUcFNwBr8IcS1RZhMKTpeg.jpg"},{"id":2024496,"name":"Francesco Gheghi","role":"Jack Mazzariol","profile":"https://image.tmdb.org/t/p/original/zwWLGq70LLgzy8G9VnRbOOC13Hu.jpg"},{"id":2323555,"name":"Roberto Nocchi","role":"Vittorio detto Vitto","profile":"https://image.tmdb.org/t/p/original/yMhsd8iIK1Vie2AgAC37mQDEEda.jpg"},{"id":1410131,"name":"Gea Dall'Orto","role":"Chiara Mazzariol","profile":"https://image.tmdb.org/t/p/original/DIzKp5ZmnMj1zu6qpXzncG1qhX.jpg"},{"id":2369436,"name":"Maria Vittoria Dallasta","role":"Alice Mazzariol","profile":"https://image.tmdb.org/t/p/original/93puKbo4r8rmitcBAF7Lud2f69M.jpg"},{"id":2369438,"name":"Lorenzo Sisto","role":"Giovanni Mazzariol detto Gio"},{"id":2487421,"name":"Arianna Becheroni","role":"Arianna","profile":"https://image.tmdb.org/t/p/original/6opeoXuViHlmzP5Hm9KYTtfXu9J.jpg"},{"id":2388344,"name":"Edoardo Pagliai","role":"Scar","profile":"https://image.tmdb.org/t/p/original/lDvSDZ5bOtzG1hGHsrIgenohlQJ.jpg"},{"id":1794470,"name":"Saul Nanni","role":"Brune","profile":"https://image.tmdb.org/t/p/original/1m9s0e8tz5W7pqyOlvD3X5S1ZXP.jpg"},{"id":3337729,"name":"Gabriele Scopel","role":"Pisone"},{"id":1251336,"name":"Iván Sánchez","role":"Doctor","profile":"https://image.tmdb.org/t/p/original/woVz8D7t1VUKjFJnsTAdc8tyz5C.jpg"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","overview":"Jack ha sempre desiderato un fratello maschio con cui giocare e quando nasce Gio, i suoi genitori gli raccontano che suo fratello è un bambino “speciale”. Da quel momento, nel suo immaginario, Gio diventa un supereroe, dotato di poteri incredibili, come un personaggio dei fumetti. Con il passare del tempo Jack scopre che in realtà il fratellino ha la sindrome di Down e per lui diventa un segreto da non svelare. Quando Jack arriva al liceo e si innamora di Arianna, decide di nascondere alla ragazza e ai nuovi amici l’esistenza del fratello. Ma non si può pretendere di essere amati nascondendo una parte così importante di sé. La verità verrà presto a galla e alla fine Jack riuscirà a farsi travolgere dall’energia e dalla vitalità di Gio, che grazie al suo originale punto di vista riuscirà a trasformare il mondo, proprio come un supereroe."},{"language":"en-US","title":"My Brother Chases Dinosaurs","overview":"As a child, Jack believed the tender lie his parents told him, that Gio was a special being with superpowers, as in a comic book. Now that he is about to go to high school, however, Jack no longer believes that his brother is a superhero, in fact, he is almost ashamed of him, especially since he met Arianna, the first love of his life.","tagline":"My brother was more than special... he was a superhero."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/jWdaKaodaBxYEIv31xJ5J7pf8rn.jpg","background":"https://image.tmdb.org/t/p/original/dPc9YDDynGaGY0zvcqjOvUmvkSm.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":593660,"type