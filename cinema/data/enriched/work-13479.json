"reference":{"base":"streamingunity:images","path":"/images/5f34ce51-92f7-4855-b4cb-91de3c447b23.webp"},"provider":"streamingunity"},{"id":724298,"filename":"24e60988-44dc-4d85-81d6-9f7f9f6fc7de.webp","type":"cover","lang":"it","imageable_type":"title","imageable_id":59062,"created_at":"2026-05-29T07:53:08.000000Z","updated_at":"2026-05-29T07:53:08.000000Z","original_url_field":null,"reference":{"base":"streamingunity:images","path":"/images/24e60988-44dc-4d85-81d6-9f7f9f6fc7de.webp"},"provider":"streamingunity"},{"id":724294,"filename":"8ebc848d-d7bb-4dc8-9a35-24231825bcca.webp","type":"background","lang":null,"imageable_type":"title","imageable_id":59062,"created_at":"2026-05-29T07:53:08.000000Z","updated_at":"2026-05-29T07:53:08.000000Z","original_url_field":null,"reference":{"base":"streamingunity:images","path":"/images/8ebc848d-d7bb-4dc8-9a35-24231825bcca.webp"},"provider":"streamingunity"},{"id":724300,"filename":"7bc54997-44c1-4eb2-9b52-6b9e849db273.webp","type":"cover_mobile","lang":"it","imageable_type":"title","imageable_id":59062,"created_at":"2026-05-29T07:53:08.000000Z","updated_at":"2026-05-29T07:53:08.000000Z","original_url_field":null,"reference":{"base":"streamingunity:images","path":"/images/7bc54997-44c1-4eb2-9b52-6b9e849db273.webp"},"provider":"streamingunity"}],"episodeMappingUncertain":false,"seasons":[],"provenance":{},"warnings":[],"externalIdsEvidence":{"wikidata":{"source":"wikidata","sourceUrl":"https://www.wikidata.org/wiki/Q130651173","wikidataId":"Q130651173","tmdbId":1180318,"type":"movie","imdbId":"tt29224082","tvdbId":362371}},"externalMedia":{"tmdb":{"source":"tmdb-api","id":1180318,"type":"movie","sourceUrl":"https://www.themoviedb.org/movie/1180318","fetchedAt":"2026-11-08T00:48:44.012Z","originalLanguage":"it-IT","title":{"value":"The House of Looks","language":"en-US"},"originalTitle":"La casa degli sguardi","overview":{"value":"Marco ha 20 anni e una grande capacità di sentire, avvertire ed empatizzare con il dolore del mondo, scrive poesie, e cerca nell’alcool e nelle droghe “la dimenticanza”, quello stato di incoscienza impenetrabile anche all’angoscia di esistere e di vivere.  Beve tanto Marco, beve troppo. È in fuga dal dolore ma soprattutto da se stesso. Per vivere si deve anestetizzare, dice. È incapace di “stare” nelle cose, a meno che il tasso alcolico del suo sangue non sia altissimo, e si è allontanato da tutti, amici e fidanzata, spaventati dalla sua voglia di distruggersi.  Anche il padre, testimone di questo lento suicidio, è incapace di gestire tanta sofferenza ma tenta almeno di “esserci”, la madre è mancata da qualche anno e ha lasciato un grande vuoto.  Quando dovrà andare a lavorare nella cooperativa di pulizie del Bambin Gesù è convinto che questa esperienza, a contatto con i bambini malati, lo ucciderà.","language":"it-IT"},"releaseDate":"2025-04-10","status":"Released","rating":7.2,"ratingCount":13,"genres":["Dramma"],"countries":["Italy"],"facts":{"Runtime":"109m"},"keywords":[],"networks":[],"socialLinks":{},"cast":[{"id":4278320,"name":"Gianmarco Franchini","role":"Marco","profile":"https://image.tmdb.org/t/p/original/dPejmhfmcaMKqat2068uMxabVRq.jpg"},{"id":91808,"name":"Federico Tocci","role":"Giovanni","profile":"https://image.tmdb.org/t/p/original/16vYseJbnyqEDiVs9H1mqeU6awN.jpg"},{"id":4278321,"name":"Riccardo Lai","role":"Luciano","profile":"https://image.tmdb.org/t/p/original/qvWFAMLbspJM79EwNHWMyY8B9jv.jpg"},{"id":3360453,"name":"Alessio Moneta","role":"Claudio","profile":"https://image.tmdb.org/t/p/original/rApbfEB5nAtQmuIViAmWKhUyOJO.jpg"},{"id":3185219,"name":"Chiara Celotto","role":"Paola","profile":"https://image.tmdb.org/t/p/original/voK0f2ZySelLco8PCERrVGIE7VI.jpg"},{"id":1925591,"name":"Marco Felli","role":"Stefano","profile":"https://image.tmdb.org/t/p/original/1GYWmaKLZ1gOLQfdGEdhwHPkfUb.jpg"},{"id":1279787,"name":"Cristian Di Sante","role":"Carmelo","profile":"https://image.tmdb.org/t/p/original/t68jpCL4H4eQo5aaEyorZJuZtxR.jpg"},{"id":72246,"name":"Luca Zingaretti","role":"Padre","profile":"https://image.tmdb.org/t/p/original/yHvitzNxavhVt6uK0Vf4ktZDAhh.jpg"},{"id":2045508,"name":"Filippo Tirabassi","role":"Davide"},{"id":2495796,"name":"Giulia Petrini"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","overview":"Marco ha 20 anni e una grande capacità di sentire, avvertire ed empatizzare con il dolore del mondo, scrive poesie, e cerca nell’alcool e nelle droghe “la dimenticanza”, quello stato di incoscienza impenetrabile anche all’angoscia di esistere e di vivere.  Beve tanto Marco, beve troppo. È in fuga dal dolore ma soprattutto da se stesso. Per vivere si deve anestetizzare, dice. È incapace di “stare” nelle cose, a meno che il tasso alcolico del suo sangue non sia altissimo, e si è allontanato da tutti, amici e fidanzata, spaventati dalla sua voglia di distruggersi.  Anche il padre, testimone di questo lento suicidio, è incapace di gestire tanta sofferenza ma tenta almeno di “esserci”, la madre è mancata da qualche anno e ha lasciato un grande vuoto.  Quando dovrà andare a lavorare nella cooperativa di pulizie del Bambin Gesù è convinto che questa esperienza, a contatto con i bambini malati, lo ucciderà."},{"language":"en-US","title":"The House of Looks","overview":"20-year-old Marco is remarkably attuned to the suffering of people everywhere. He writes poetry but turns to drugs and drink to achieve “the forgetting”, that unconscious state that is impenetrable to his existential angst and other fears. He’s fleeing pain but above all, he’s fleeing from himself. When he goes to work for the cleaners’ cooperative at Bambin Gesù Hospital, he’s sure that this experience, the contact with sick children, will be the death of him."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/ujenl0gLvI2eEdbrF7xbG9YVvrh.jpg","background":"https://image.tmdb.org/t/p/original/e0iGXpPcQcrvXU7VHn5tjYrcojC.jpg","seasons":[],"schema