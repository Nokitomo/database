KkYmOGOjQDKXtDbNJO9m.jpg"},{"id":95003,"name":"Maria Dinulescu","role":"Femme Genkine","profile":"https://image.tmdb.org/t/p/original/aAJZDsZM3QWxUe8dxyHJ2piCe8S.jpg"},{"id":1861647,"name":"Anamaria Ferentz","role":"Singer marriage Genkine","profile":"https://image.tmdb.org/t/p/original/cwKzOAPN46H9CKQg5dUTBjxhqXa.jpg"},{"id":62889,"name":"Mihai Călin","role":"Yitzhak","profile":"https://image.tmdb.org/t/p/original/2HeB2dkREMZ9u8g81Oa3X59dQet.jpg"},{"id":67714,"name":"Ramzy Bedia","role":"Boss Le Trou Normand","profile":"https://image.tmdb.org/t/p/original/fzGqj63WW6NFAK43oVjtYzVy75y.jpg"},{"id":48514,"name":"Éric Judor","profile":"https://image.tmdb.org/t/p/original/iWVPgew1yPFawRTRBz7DcYI3aKt.jpg"},{"id":19118,"name":"Anton Yakovlev","role":"Russian TV Operator","profile":"https://image.tmdb.org/t/p/original/hSDjeTeMaH9slfXGoLC3aGdG4pu.jpg"},{"id":1088087,"name":"Constantin Drăgănescu","role":"Homme Palier","profile":"https://image.tmdb.org/t/p/original/rUQa5Wo0t1mCI3oOgGRy0sK0m3u.jpg"},{"id":24818,"name":"Hervé Pauchon","role":"Barman Châtelet","profile":"https://image.tmdb.org/t/p/original/rTBa9i0cyD4dRLCe1PjSJVWCvmc.jpg"},{"id":113603,"name":"Philippe Uchan","role":"Boss French Restaurant","profile":"https://image.tmdb.org/t/p/original/sBfrwOm7wgJgitDdhLX6zHPYKR1.jpg"},{"id":1019987,"name":"Bing Yin","role":"Boss Chinese Restaurant","profile":"https://image.tmdb.org/t/p/original/AiwAuBLK8XjuZ4e5hPFCteQr7yf.jpg"},{"id":60657,"name":"Constantin Bărbulescu","role":"Makarov"},{"id":1861674,"name":"Tatiana Rotari","role":"wife Sacha","profile":"https://image.tmdb.org/t/p/original/4Dzqz9vb4gT14t5Naz57Vv4ar5W.jpg"},{"id":1351859,"name":"Patrick Zard","role":"Receptionist Hotel","profile":"https://image.tmdb.org/t/p/original/v2DqnW8lQrCR39Vab9819Eh4FhK.jpg"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","title":"Il concerto","overview":"Andreï Filipov è un direttore d'orchestra deposto dalla politica di Brežnev e derubato della musica e della bacchetta. Rifiutatosi di licenziare la sua orchestra, composta principalmente da musicisti ebrei, è costretto da trent'anni a spolverare e a lucidare la scrivania del nuovo e ottuso direttore del Bolshoi. Un fax indirizzato alla direzione del teatro è destinato a cambiare il corso della sua esistenza. Il Théâtre du Châtelet ha invitato l'orchestra del Bolshoi a suonare a Parigi. Impossessatosi illecitamente dell'invito concepisce il suo riscatto di artista, riunendo i componenti della sua vecchia orchestra e conducendoli sul palcoscenico francese sotto mentite spoglie. Scordati e ammaccati dal tempo e dalla rinuncia coatta alla musica, i musicisti accoglieranno la chiamata agli strumenti, stringendosi intorno al loro direttore e al primo violino. La loro vita e il loro concerto riprenderà da dove il regime li aveva interrotti, accordando finalmente presente e passato.","tagline":"Il grande inganno che divenne la performance di una vita."},{"language":"en-US","title":"The Concert","overview":"A former world-famous conductor of the Bolshoï orchestra, known as \"The Maëstro\", Andreï Filipov had seen his career publicly broken by Leonid Brezhnev for hiring Jewish musicians and now works cleaning the concert hall where he once directed. One day, he intercepts an official invitation from the prestigious Théâtre du Châtelet. Through a series of mad antics, he reunites his old orchestra, now composed of old alcoholic musicians, and flies to perform in Paris and complete the Tchaikovsky concerto interrupted 30 years earlier. For the concerto, he engages a young violin soloist with whom he has an unexpected connection.","tagline":"The grand deception that became the performance of a lifetime."},{"language":"fr-FR","overview":"A l'époque de Brejnev, Andrei Filipov était le plus grand chef d'orchestre d'Union soviétique et dirigeait le célèbre Orchestre du Bolchoï. Mais après avoir refusé de se séparer de ses musiciens juifs, dont son meilleur ami Sacha, il a été licencié en pleine gloire. Trente ans plus tard, il travaille toujours au Bolchoï mais... comme homme de ménage. Un soir, alors qu'Andrei est resté très tard pour astiquer le bureau du maître des lieux, il tombe sur un fax adressé au directeur : il s'agit d'une invitation du Théâtre du Châtelet conviant l'orchestre du Bolchoï à venir jouer à Paris... Soudain, Andrei a une idée de folie : pourquoi ne pas réunir ses anciens copains musiciens, qui vivent aujourd'hui de petits boulots, et les emmener à Paris, en les faisant passer pour le Bolchoï ? L'occasion tant attendue de prendre enfin leur revanche...","tagline":"Il était le plus grand chef d'orchestre. Écarté, humilié, homme de ménage, il revient pour..."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/pxmUVr5WjEQFWK2TzK16wPIUi0Z.jpg","background":"https://image.tmdb.org/t/p/original/Ng3bVep7dL8qQiWhWQlSo2OvpZ.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":25205,"type":"movie","originalLanguage":"fr-FR","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/pxmUVr5WjEQFWK2TzK16wPIUi0Z.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/pxmUVr5WjEQFWK2TzK16wPIUi0Z.jpg","language":"it","width":980,"height":1400},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/pxmUVr5WjEQFWK2TzK16wPIUi0Z.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/pxmUVr5WjEQFWK2TzK16wPIUi0Z.jpg","language":"it","width":980,"height":1400},{"type":"poster","url":"https://image.tmdb.org/t/p/original/6sH12VJ2W3PSwNKOuT6CbH0WDYW.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/6sH12VJ2W3PSwNKOuT6CbH0WDYW.jpg","language":"it","width":2000,"height":3000}]},"en":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/nMIDVIq7p2mcvolG93FH4Ku3aYJ.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/nMIDVIq7p2mcvolG93F