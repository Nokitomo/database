r en actionkomedie der billøp og moro er nøkkelingrediensene.","tagline":"Fra Trollstigen til Nürburgring"}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/8w9d1gVLsmdVu52mlQ9D4jAypgU.jpg","background":"https://image.tmdb.org/t/p/original/zxHHmvUYlYhBuBmZpIrjnamCO3c.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":505746,"type":"movie","originalLanguage":"no-NO","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/8w9d1gVLsmdVu52mlQ9D4jAypgU.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/8w9d1gVLsmdVu52mlQ9D4jAypgU.jpg","language":"it","width":530,"height":750},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/8w9d1gVLsmdVu52mlQ9D4jAypgU.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/8w9d1gVLsmdVu52mlQ9D4jAypgU.jpg","language":"it","width":530,"height":750},{"type":"poster","url":"https://image.tmdb.org/t/p/original/vhJjLV88rAKU32V4muWjLlE8JbX.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/vhJjLV88rAKU32V4muWjLlE8JbX.jpg","language":"it","width":537,"height":750},{"type":"poster","url":"https://image.tmdb.org/t/p/original/e8wlcGVUL4MITBtsZQgLunRT99h.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/e8wlcGVUL4MITBtsZQgLunRT99h.jpg","language":"it","width":960,"height":1440}]},"en":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/4xga1DMRKfdkS6uzLwzCGvbRiyL.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/4xga1DMRKfdkS6uzLwzCGvbRiyL.jpg","language":"en","width":1000,"height":1500},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/4xga1DMRKfdkS6uzLwzCGvbRiyL.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/4xga1DMRKfdkS6uzLwzCGvbRiyL.jpg","language":"en","width":1000,"height":1500},{"type":"poster","url":"https://image.tmdb.org/t/p/original/y7FowCQdiaTbmqjW6I9we9eoICs.jpg","previewUrl":"https://image.tm