aVKV4mPRBf0ofLGRAP5jguEBnrG.jpg"},{"id":20830,"name":"Isao Kimura","role":"Tsuchigumo Hyoei","profile":"https://image.tmdb.org/t/p/original/afLPuf3x7UYXryAbqAGqmRcVNNW.jpg"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","title":"Lone Wolf and Cub: White Heaven in Hell","overview":"Ogami decide di tornare a Edo per riscattarsi e uccidere Retsudo Yagyu, ma dovrà vedersela con Kaori Yagyu e affrontare la vera paura contro gli Tsuchigumo di Hyoei. Nello scontro finale il lupo solitario batte tutti i record di carneficine della storia del Chambara."},{"language":"en-US","title":"Lone Wolf and Cub: White Heaven in Hell","overview":"With most of his family already dead at Ogami Itto's hands, Retsudo launches one final plot to destroy him, and when that fails, unleashes the fury of every remaining member of the Yagyu clan."},{"language":"ja-JP","overview":"小池一夫、小島剛夕の人気劇画を若山富三郎の主演で映画化した娯楽時代劇シリーズの最終第6作。監督は「大魔神」シリーズの特撮監督として鳴らした黒田義之。\r 幼子の大五郎を乳母車に乗せて流浪の旅を続ける元公儀介錯人の拝一刀。3人の息子たちを一刀にことごとく殺された柳生烈堂は、最後の切り札として、ひとり娘の香織に一刀打倒の望みを託す。彼女は必殺技の“お手玉の剣”で一刀に勝負を挑むが、彼が盾代わりに利用した大五郎につい温情を注いで殺気をそがれ、これまた命を落とすはめに。娘の死を知った烈堂は、黒鍬、そして土蜘蛛一族の総力を結集して、一刀に最後の戦いを挑む。"}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/awPGJfTT62colbNItgiUpjKILkK.jpg","background":"https://image.tmdb.org/t/p/original/konLUHlmrw1UTOYJniEC0gZkUt9.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":41486,"type":"movie","originalLanguage":"ja-JP","series":{"poster":{"it":{"status":"missing","candidates":[]},"en":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/zRBOXoQDvcApwVWyY80G813qzHd.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/zRBOXoQDvcApwVWyY80G813qzHd.jpg","language":"en","width":929,"height":1394},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/zRBOXoQDvcApwVWyY80G813qzHd.jpg","previewUrl":"https://image.tmdb.