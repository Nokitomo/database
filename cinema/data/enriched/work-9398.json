bp"},"provider":"streamingunity"},{"id":522339,"filename":"86184f33-47a1-4b6a-bebe-f30e0a98e95e.webp","type":"cover_mobile","lang":"it","imageable_type":"title","imageable_id":44255,"created_at":"2025-12-06T13:33:40.000000Z","updated_at":"2025-12-06T13:33:40.000000Z","original_url_field":null,"reference":{"base":"streamingunity:images","path":"/images/86184f33-47a1-4b6a-bebe-f30e0a98e95e.webp"},"provider":"streamingunity"}],"episodeMappingUncertain":false,"seasons":[],"provenance":{},"warnings":[],"externalIdsEvidence":{"wikidata":{"source":"wikidata","sourceUrl":"https://www.wikidata.org/wiki/Q135206173","wikidataId":"Q135206173","tmdbId":1360946,"type":"movie","imdbId":"tt29731040","tvdbId":366920}},"externalMedia":{"tmdb":{"source":"tmdb-api","id":1360946,"type":"movie","sourceUrl":"https://www.themoviedb.org/movie/1360946","fetchedAt":"2026-11-07T13:29:51.212Z","originalLanguage":"it-IT","title":{"value":"Incanto","language":"en-US"},"originalTitle":"Incanto","overview":{"value":"In punto di morte, Ludovico affida la sua figlioletta alla governante di casa, Felicia, chiedendo che la loro villa venga trasformata in un orfanotrofio per permettere a Margot di crescere in allegria con altri bambini. Tuttavia, la perfida Felicia, interessata solo al patrimonio della piccola, sfrutta i bimbi orfani e tiene Margot segregata, al punto che la bambina smette di parlare. La storia prende una svolta magica quando la bambina riesce a fuggire e trova rifugio in un circo incantato, dove il clown bianco Charlie la introduce a un mondo straordinario. Nel grande tendone magico, Margot riscopre la sua voce e una nuova famiglia, ma la minaccia di Felicia è sempre in agguato. Riuscirà Margot a liberarsi dalle sue grinfie e a rivendicare le sue radici?","language":"it-IT"},"releaseDate":"2025-07-03","status":"Released","rating":5.875,"ratingCount":4,"genres":["Famiglia","Fantasy"],"countries":["Belgium","Italy"],"facts":{"Runtime":"96m"},"keywords":[],"networks":[],"socialLinks":{},"cast":[{"id":53422,"name":"Vittoria Puccini","role":"Felicia","profile":"https://image.tmdb.org/t/p/original/hLqob2uBRLwA615Jx3QStD1dqzz.jpg"},{"id":2907095,"name":"Mia McGovern Zaini","role":"Margot","profile":"https://image.tmdb.org/t/p/original/hUys41BBHf8rAvcVl8xd8WfgMHl.jpg"},{"id":1059861,"name":"Claudio Gregori","role":"Max","profile":"https://image.tmdb.org/t/p/original/kCLSbw5JYpLlQ3YazZrBfXdur08.jpg"},{"id":131670,"name":"Giorgio Panariello","role":"Charlie","profile":"https://image.tmdb.org/t/p/original/3etizLabObjEyNOymzfi8H36oba.jpg"},{"id":1124878,"name":"Mia Benedetta","role":"Stella","profile":"https://image.tmdb.org/t/p/original/cXZyaWoBYWVAq40DdlBQsCEZZrh.jpg"},{"id":129570,"name":"Stefano Pesce","role":"Cosmo","profile":"https://image.tmdb.org/t/p/original/xSQfqkM5Xh3CI0JUf86m4qUDXpH.jpg"},{"id":4032119,"name":"Massimo Pio Giunto","role":"Daniel"},{"id":4179618,"name":"Zackari Delmas","role":"Spoletta","profile":"https://image.tmdb.org/t/p/original/rF3pRFLaXEfTrtUXKcP9tfkv5L0.jpg"},{"id":4586308,"name":"Lorenzo Nohman","role":"Luca"},{"id":227242,"name":"Paolo Sassanelli","profile":"https://image.tmdb.org/t/p/original/iQNrMG857WG4rpjZrYsXK2RPXr8.jpg"},{"id":128227,"name":"Giorgio Colangeli","profile":"https://image.tmdb.org/t/p/original/3LxOBPqDPT4k0CJ4hJGMSrYKtP1.jpg"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","overview":"In punto di morte, Ludovico affida la sua figlioletta alla governante di casa, Felicia, chiedendo che la loro villa venga trasformata in un orfanotrofio per permettere a Margot di crescere in allegria con altri bambini. Tuttavia, la perfida Felicia, interessata solo al patrimonio della piccola, sfrutta i bimbi orfani e tiene Margot segregata, al punto che la bambina smette di parlare. La storia prende una svolta magica quando la bambina riesce a fuggire e trova rifugio in un circo incantato, dove il clown bianco Charlie la introduce a un mondo straordinario. Nel grande tendone magico, Margot riscopre la sua voce e una nuova famiglia, ma la minaccia di Felicia è sempre in agguato. Riuscirà Margot a liberarsi dalle sue grinfie e a rivendicare le sue radici?"},{"language":"en-US","title":"Incanto","overview":"On his deathbed, Ludovico entrusts his daughter Margot to the housekeeper, Felicia, asking that the family villa be transformed into an orphanage so that the little girl can grow up in joy with other children. But the wicked Felicia only wants the little girl's assets and not take care of her. With the complicity of her suitor, Max, she exploits the orphaned children and keeps Margot segregated and neglected to the point that the child withdraws into herself and no longer speaks. One night, however, Margot manages to escape and, after overcoming the darkness of the woods, she comes across a circus."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/AqjIBXRK5UN4rx7TItQRXjOxpHe.jpg","background":"https://image.tmdb.org/t/p/original/iNxZcPqkXws4Yj6mwObyrZ8knjo.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":1360946,"type":"movie","originalLanguage":"it-IT","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/AqjIBXRK5UN4rx7TItQRXjOxpHe.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/AqjIBXRK5UN4rx7TItQRXjOxpHe.jpg","language":"it","width":2000,"height":3000},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/AqjIBXRK5UN4rx7TItQRXjOxpHe.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/AqjIBXRK5UN4rx7TItQRXjOxpHe.jpg","language":"it","width":2000,"height":3000},{"type":"poster","url":"https://image.tmdb.org/t/p/original/sbZpj2P59xO0eANyG0TEipMcp8d.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/sbZpj2P59xO0eANyG0TEipMcp8d.jpg","language":"it","width":2000,"height":3000},{"type":"poster","url":"https://image.tmdb.org/t/p/original/4NQrOuxCvWaZ1ZkpImv