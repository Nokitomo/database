s":[],"provenance":{},"warnings":[],"externalIdsEvidence":{"wikidata":{"source":"wikidata","sourceUrl":"https://www.wikidata.org/wiki/Q133805273","wikidataId":"Q133805273","tmdbId":1374949,"type":"movie","imdbId":"tt36553493","tvdbId":365736}},"externalMedia":{"tmdb":{"source":"tmdb-api","id":1374949,"type":"movie","sourceUrl":"https://www.themoviedb.org/movie/1374949","fetchedAt":"2026-11-08T05:47:05.427Z","originalLanguage":"it-IT","title":{"value":"I Saw a King","language":"en-US"},"originalTitle":"Ho visto un re","overview":{"value":"Nel 1936, mentre l’Italia si inebria della vittoria in Etiopia, un evento eccezionale sconvolge la placida routine di una piccola città di provincia: la storia vera di Abraham Imirrù, un Ras etiope catturato e tenuto prigioniero in una voliera nel giardino della villa del Podestà. La sua presenza misteriosa accende l’immaginazione degli abitanti, abituati a una vita semplice e scandita dalla propaganda politica. Quella presenza in giardino per Emilio, un ragazzino di dieci anni, figlio dell’ambizioso Podestà Marcello, e di Regina, un’artista dall’animo fragile e inquieto, è come una apparizione. Per lui, appassionato lettore di Salgari che grazie alle avventure di Sandokan evade dal rigido mondo paterno, quando scorge Abraham, la linea tra sogno e realtà svanisce: il Ras etiope per Emilio non è un selvaggio esotico da guardare con sospetto o curiosità, ma è semplicemente Sandokan, il suo eroe da ammirare e seguire.","language":"it-IT"},"releaseDate":"2025-04-30","status":"Released","rating":7.1,"ratingCount":9,"genres":["Commedia","Storia"],"countries":["Italy","France"],"facts":{"Runtime":"95m"},"keywords":[],"networks":[],"socialLinks":{},"cast":[{"id":131630,"name":"Edoardo Pesce","role":"Podestà Marcello","profile":"https://image.tmdb.org/t/p/original/l4sfiRcFmyloNHBGyu0vWdJGdiH.jpg"},{"id":1171457,"name":"Sara Serraiocco","role":"Regina","profile":"https://image.tmdb.org/t/p/original/p2p9INcMpvs8IeDNJpnPPR5ssft.jpg"},{"id":2092374,"name":"Gabriel Gougsa","role":"Abraham Imirrù"},{"id":4378458,"name":"Marco Fiore","role":"Emilio"},{"id":1871368,"name":"Lino Musella","role":"Fausto","profile":"https://image.tmdb.org/t/p/original/xZuVRh6zyh4fo5QsxERHu25l3P4.jpg"},{"id":931963,"name":"Blu Yoshimi","role":"Gemma","profile":"https://image.tmdb.org/t/p/original/n7MWC7a0BuIR9Mr2yBd7dWtfLiw.jpg"},{"id":35103,"name":"Gaetano Bruno","role":"Filippo Maria","profile":"https://image.tmdb.org/t/p/original/2mZJtu1TXqnUozLERvgdcE8AAcq.jpg"},{"id":1346690,"name":"Giulio Forges Davanzati","profile":"https://image.tmdb.org/t/p/original/8wSltEl1vYGNV8Kqe2k59IvpCpz.jpg"},{"id":1163416,"name":"Elisa Di Eusanio","profile":"https://image.tmdb.org/t/p/original/sqtOcfFwZlNgZuwxFf3GKMiuy4W.jpg"},{"id":1871397,"name":"Michelangelo Dalisi","profile":"https://image.tmdb.org/t/p/original/uSS4iG8HJ2mM1BYXm0cVtgVJriR.jpg"},{"id":3771421,"name":"Patrizio Francioni"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","overview":"Nel 1936, mentre l’Italia si inebria della vittoria in Etiopia, un evento eccezionale sconvolge la placida routine di una piccola città di provincia: la storia vera di Abraham Imirrù, un Ras etiope catturato e tenuto prigioniero in una voliera nel giardino della villa del Podestà. La sua presenza misteriosa accende l’immaginazione degli abitanti, abituati a una vita semplice e scandita dalla propaganda politica. Quella presenza in giardino per Emilio, un ragazzino di dieci anni, figlio dell’ambizioso Podestà Marcello, e di Regina, un’artista dall’animo fragile e inquieto, è come una apparizione. Per lui, appassionato lettore di Salgari che grazie alle avventure di Sandokan evade dal rigido mondo paterno, quando scorge Abraham, la linea tra sogno e realtà svanisce: il Ras etiope per Emilio non è un selvaggio esotico da guardare con sospetto o curiosità, ma è semplicemente Sandokan, il suo eroe da ammirare e seguire."},{"language":"en-US","title":"I Saw a King","overview":"1936, in the aftermath of the Ethiopian occupation by Fascist Italy, under the incredulous gaze of the inhabitants of the small town in the Italian province Abraham Imirrù, an ethiopian prince and guerrila fighter is being held prisoner in the local Podesta garden's aviary. But for little Emilio, local recently force enlisted and reality-dissociated Balilla, he is Sandokan, the literal Salgari's character ...and he will be his hero."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/70zJmxsu8zKoWHVdQZMxECHzf5I.jpg","background":"https://image.tmdb.org/t/p/original/AdrFiCfmvHFvEdpvqkQHGX9r9Tc.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":1374949,"type":"movie","originalLanguage":"it-IT","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/70zJmxsu8zKoWHVdQZMxECHzf5I.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/70zJmxsu8zKoWHVdQZMxECHzf5I.jpg","language":"it","width":800,"height":1200},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/70zJmxsu8zKoWHVdQZMxECHzf5I.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/70zJmxsu8zKoWHVdQZMxECHzf5I.jpg","language":"it","width":800,"height":1200},{"type":"poster","url":"https://image.tmdb.org/t/p/original/tRKtL7JmKuCMThEFCnJn5xYdbMt.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/tRKtL7JmKuCMThEFCnJn5xYdbMt.jpg","language":"it","width":1000,"height":1500}]},"en":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/8nCxsWu7Fof3HiE40FC2aPprJdw.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/8nCxsWu7Fof3HiE40FC2aPprJdw.jpg","language":"en","width":2000,"height":2857},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/8nCxsWu7Fof3HiE40FC2aPprJdw.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/8nCxsWu7Fof3HiE40FC2aPprJdw.jpg","language":"en","width":200