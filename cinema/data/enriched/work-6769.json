の行動を起こす。まったく接点のなかった彼らは一軒の家を中心に引き寄せられていく。彼らを呪いの連鎖で結び付けたその家の恐るべき真実とは！？"}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/hmC8iG8Q7BROrXJMOkCCCJc3VM4.jpg","background":"https://image.tmdb.org/t/p/original/b95YFESueMaNpQ9AebQZpYSvYo2.jpg","seasons":[{"seasonNumber":1,"name":{"value":"Stagione 1","language":"it-IT"},"year":2020,"episodeCount":6,"poster":"https://image.tmdb.org/t/p/original/6onGKpGtz0K5AqaJ1xlLisJ4fQA.jpg","posters":[],"backgrounds":[],"sourceUrl":"https://www.themoviedb.org/tv/103445/season/1"}],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":103445,"type":"tv","originalLanguage":"ja-JP","series":{"poster":{"it":{"status":"missing","candidates":[]},"en":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/18cT0p9UbJGhKDlwcOF214SXnsZ.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/18cT0p9UbJGhKDlwcOF214SXnsZ.jpg","language":"en","width":2000,"height":3000},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/18cT0p9UbJGhKDlwcOF214SXnsZ.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/18cT0p9UbJGhKDlwcOF214SXnsZ.jpg","language":"en","width":2000,"height":3000},{"type":"poster","url":"https://image.tmdb.org/t/p/original/3UIdgIMiU9BryQNegbbHrJvOBgC.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/3UIdgIMiU9BryQNegbbHrJvOBgC.jpg","language":"en","width":800,"height":1200},{"type":"poster","url":"https://image.tmdb.org/t/p/original/zUi4XZrJuCdiHcqewJxN5Yh4kKI.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/zUi4XZrJuCdiHcqewJxN5Yh4kKI.jpg","language":"en","width":535,"height":750},{"type":"poster","url":"https://image.tmdb.org/t/p/original/wHLnTT5lQxARi02LqJaIqo6RnTQ.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/wHLnTT5lQxARi02LqJaIqo6RnTQ.jpg","language":"en","width":500,"height":750},{"type":"poster","url":"https://image.tmdb.org/t/p/original/16scxXRoR2fKa7M9cwcIqBNBXow.jpg","previewUrl":"https://image.tmd