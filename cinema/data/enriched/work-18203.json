 se marier, Alice et François décident de réunir leurs deux familles. Pour l’occasion, ils réservent à leurs parents un cadeau original : des tests ADN pour que chacun puisse découvrir les origines de ses ancêtres. Mais la surprise va virer au fiasco quand les Bouvier Sauvage, grande famille aristocrate, et les Martin, beaucoup plus modestes, découvrent les résultats, pour le moins… inattendus !","tagline":"On ne choisit pas ses ancêtres !"}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/tMZmtVsrcbwqddw9LiAPW1K6w5A.jpg","background":"https://image.tmdb.org/t/p/original/r3mNrASQwRvFg9keHAhK2f5BKa5.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":973912,"type":"movie","originalLanguage":"fr-FR","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/tMZmtVsrcbwqddw9LiAPW1K6w5A.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/tMZmtVsrcbwqddw9LiAPW1K6w5A.jpg","language":"it","width":667,"height":1000},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/tMZmtVsrcbwqddw9LiAPW1K6w5A.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/tMZmtVsrcbwqddw9LiAPW1K6w5A.jpg","language":"it","width":667,"height":1000}]},"en":{"status":"missing","candidates":[]},"fr":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/b0blE2Rk7ZED24qQhif5hBGT6Px.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/b0blE2Rk7ZED24qQhif5hBGT6Px.jpg","language":"fr","width":2000,"height":3000},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/b0blE2Rk7ZED24qQhif5hBGT6Px.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/b0blE2Rk7ZED24qQhif5hBGT6Px.jpg","language":"fr","width":2000,"height":3000},{"type":"poster","url":"https://image.tmdb.org/t/p/original/gmOwOSn1mFgV1DlWhWh9u8h8nM0.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/gmOwOSn1mFgV1DlWhWh9u8h8nM0.jpg