p","type":"cover","lang":null,"imageable_type":"episode","imageable_id":256740,"created_at":"2025-12-16T12:10:19.000000Z","updated_at":"2025-12-16T12:10:19.000000Z","original_url_field":null,"reference":{"base":"streamingunity:images","path":"/images/126f4a30-9336-40d1-9b08-3205ba731d08.webp"}}],"translations":[{"id":735971,"translatable_type":"episode","translatable_id":256740,"locale":"it","key":"name","value":"Ribelle (prima parte)"},{"id":735972,"translatable_type":"episode","translatable_id":256740,"locale":"it","key":"plot","value":"Nel primo episodio, \"Ribelle (prima parte)\", l'allenamento di Beck con Tron viene interrotto quando viene catturato da una pattuglia del Riconoscitore e inviato al Colosseo per combattere nei giochi. Lì Beck incontra un compagno di prigionia Cutler, un feroce programma di guerrieri che è stato ispirato dalle azioni de 'Il Ribelle'. Ricaricati dalla loro comune passione per la libertà, Beck e Cutler combattono per uscire dai letali giochi di dischi. Nel frattempo, Zed e Mara escono per la notte in città, ma finiscono nei guai quando Zed rimane incantato da Perl, un membro femminile di una banda criminale che attira Zed nel portarla nel garage di Able, dove ha rubato il light-cycle leggero ENCOM 786."}]}],"path":"/it/titles/47432-tron-la-serie/season-1","images":[]}],"info":{"id":47432,"name":"Tron - La serie","slug":"tron-la-serie","plot":"Ambientato tra \"Tron\" e \"Tron: Legacy\", \"Tron - La serie\" racconta la storia di Beck, un giovane programma che diventa l'abile leader di una rivoluzione nel mondo dei computer della Rete.","quality":"HD","type":"tv","original_name":"TRON: Uprising","original_language":"en","status":"Ended","runtime":null,"views":11246,"daily_views":6,"score":"7.8","tmdb_id":34356,"imdb_id":"tt1812523","netflix_id":null,"prime_id":null,"scws_id":null,"public":1,"release_date":"2012-06-07","last_air_date":"2012-06-07","sub_ita":1,"dub_ita":0,"created_at":"2025-12-16T12:10:17.000000Z","updated_at":"2026-10-31