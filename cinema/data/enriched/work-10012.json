amento di Beck con Tron viene interrotto quando viene catturato da una pattuglia del Riconoscitore e inviato al Colosseo per combattere nei giochi. Lì Beck incontra un compagno di prigionia Cutler, un feroce programma di guerrieri che è stato ispirato dalle azioni de 'Il Ribelle'. Ricaricati dalla loro comune passione per la libertà, Beck e Cutler combattono per uscire dai letali giochi di dischi. Nel frattempo, Zed e Mara escono per la notte in città, ma finiscono nei guai quando Zed rimane incantato da Perl, un membro femminile di una banda criminale che attira Zed nel portarla nel garage di Able, dove ha rubato il light-cycle leggero ENCOM 786.","thumbnail":{"base":"streamingunity:images","path":"/images/126f4a30-9336-40d1-9b08-3205ba731d08.webp"},"metadataSources":{"streamingunity:47432":{"title":"Ribelle (prima parte)","synopsis":"Nel primo episodio, \"Ribelle (prima parte)\", l'allenamento di Beck con Tron viene interrotto quando viene catturato da una pattuglia del Riconoscitore e inviato al Colosseo per combattere nei giochi. Lì Beck incontra un compagno di prigionia Cutler, un feroce programma di guerrieri che è stato ispirato dalle azioni de 'Il Ribelle'. Ricaricati dalla loro comune passione per la libertà, Beck e Cutler combattono per uscire dai letali giochi di dischi. Nel frattempo, Zed e Mara escono per la notte in città, ma finiscono nei guai quando Zed rimane incantato da Perl, un membro femminile di una banda criminale che attira Zed nel portarla nel garage di Able, dove ha rubato il light-cycle leggero ENCOM 786.","thumbnail":{"base":"streamingunity:images","path":"/images/126f4a30-9336-40d1-9b08-3205ba731d08.webp"}}}}],"images":[]}],"provenance":{},"warnings":[],"externalIdsEvidence":{"wikidata":{"source":"wikidata","sourceUrl":"https://www.wikidata.org/wiki/Q657855","wikidataId":"Q657855","tmdbId":34356,"type":"tv","imdbId":"tt1812523","tvdbId":258480}},"externalMedia":{"tmdb":{"source":"tmdb-api","id":34356,"type":"tv","sourceUrl":"https://www.