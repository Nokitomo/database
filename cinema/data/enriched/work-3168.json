,"imageable_type":"title","imageable_id":13079,"created_at":"2025-09-12T12:43:02.000000Z","updated_at":"2025-09-12T12:43:02.000000Z","original_url_field":null,"reference":{"base":"streamingunity:images","path":"/images/2b6f1a00-a097-4aff-b826-23cbd5f8c731.webp"},"provider":"streamingunity"},{"id":216145,"filename":"37f5ca99-db80-479e-b979-a79640629d74.webp","type":"background","lang":null,"imageable_type":"title","imageable_id":13079,"created_at":"2025-09-12T12:43:02.000000Z","updated_at":"2025-09-12T12:43:02.000000Z","original_url_field":null,"reference":{"base":"streamingunity:images","path":"/images/37f5ca99-db80-479e-b979-a79640629d74.webp"},"provider":"streamingunity"},{"id":216148,"filename":"13aa3457-04ce-4369-ba16-8add12dfdef3.webp","type":"background","lang":null,"imageable_type":"title","imageable_id":13079,"created_at":"2025-09-12T12:43:02.000000Z","updated_at":"2025-09-12T12:43:02.000000Z","original_url_field":null,"reference":{"base":"streamingunity:images","path":"/images/13aa3457-04ce-4369-ba16-8add12dfdef3.webp"},"provider":"streamingunity"},{"id":216150,"filename":"1acdec75-d4e4-46d5-9268-0f5a3a8920e2.webp","type":"cover_mobile","lang":"it","imageable_type":"title","imageable_id":13079,"created_at":"2025-09-12T12:43:02.000000Z","updated_at":"2025-09-12T12:43:02.000000Z","original_url_field":null,"reference":{"base":"streamingunity:images","path":"/images/1acdec75-d4e4-46d5-9268-0f5a3a8920e2.webp"},"provider":"streamingunity"}],"episodeMappingUncertain":false,"seasons":[],"provenance":{},"warnings":[],"externalIdsEvidence":{"wikidata":{"source":"wikidata","sourceUrl":"https://www.wikidata.org/wiki/Q137203326","wikidataId":"Q137203326","tmdbId":856367,"type":"movie","imdbId":"tt15137280"}},"externalMedia":{"tmdb":{"source":"tmdb-api","id":856367,"type":"movie","sourceUrl":"https://www.themoviedb.org/movie/856367","fetchedAt":"2026-11-06T14:38:43.328Z","originalLanguage":"it-IT","title":{"value":"Senza fine","language":"it-IT"},"originalTitle":"Senza fine","overview":{"value":"Una località termale fuori dal tempo, un hotel anni ’40, un luogo che sposta il presente chissà dove. Non il passato, la vita trascorsa di Ornella Vanoni, ma la rivelazione – attuale – della sua intimità, esibita attraverso una relazione: il rapporto con la regista.\r L’energia, il carattere, la musica, i confronti, il caldo, la fatica. Tutto viene ripreso senza risparmiare niente, nemmeno le discussioni tra Ornella ed Elisa. Il film asseconda quello che naturalmente Ornella genera e si piega all’imprevisto, al presente. E poi gli incontri con gli amici, i musicisti, Vinicio Capossela, Samuele Bersani, la tromba di Paolo Fresu che risuona negli spazi vuoti del grande albergo dove tra giornate identiche scandite da cure e trattamenti, prende spazio il racconto, la memoria, ma anche il futuro mentre Ornella si prepara a diventare creatura fantastica fatta di voce e sogno, destinata all’eternità.","language":"it-IT"},"releaseDate":"2022-02-24","status":"Released","rating":7,"ratingCount":2,"genres":["Documentario"],"countries":[],"facts":{"Runtime":"80m"},"keywords":[],"networks":[],"socialLinks":{},"cast":[{"id":1265935,"name":"Ornella Vanoni","profile":"https://image.tmdb.org/t/p/original/mHU9hzD4xhRdU0I9C5B8e2GsaXa.jpg"},{"id":1133000,"name":"Samuele Bersani","profile":"https://image.tmdb.org/t/p/original/xxDT8ABiXWNxHRRWXHGFgpOlbsA.jpg"},{"id":124766,"name":"Vinicio Capossela","profile":"https://image.tmdb.org/t/p/original/o4OZokR4sHmPGKntM5YQ29mdltA.jpg"},{"id":1153140,"name":"Paolo Fresu"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","overview":"Una località termale fuori dal tempo, un hotel anni ’40, un luogo che sposta il presente chissà dove. Non il passato, la vita trascorsa di Ornella Vanoni, ma la rivelazione – attuale – della sua intimità, esibita attraverso una relazione: il rapporto con la regista.\r L’energia, il carattere, la musica, i confronti, il caldo, la fatica. Tutto viene ripreso senza risparmiare niente, nemmeno le discussioni tra Ornella ed Elisa. Il film asseconda quello che naturalmente Ornella genera e si piega all’imprevisto, al presente. E poi gli incontri con gli amici, i musicisti, Vinicio Capossela, Samuele Bersani, la tromba di Paolo Fresu che risuona negli spazi vuoti del grande albergo dove tra giornate identiche scandite da cure e trattamenti, prende spazio il racconto, la memoria, ma anche il futuro mentre Ornella si prepara a diventare creatura fantastica fatta di voce e sogno, destinata all’eternità."},{"language":"en-US","overview":"A timeless spa town, a 1940s hotel, a place that transports the present to who knows where. Not the past, Ornella Vanoni's life, but the revelation—current—of her intimacy, exhibited through a relationship: her relationship with the director. The energy, the character, the music, the confrontations, the heat, the fatigue. Everything is filmed without sparing anything, not even the arguments between Ornella and Elisa. The film goes along with what Ornella naturally generates and bends to the unexpected, to the present. And then there are the encounters with friends, musicians, Vinicio Capossela, Samuele Bersani, Paolo Fresu's trumpet resounding in the empty spaces of the grand hotel where, between identical days marked by care and treatment, the story, the memory, but also the future take shape as Ornella prepares to become a fantastic creature made of voice and dreams, destined for eternity."}],"images":{"logos":[],"posters":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/kPQ1vivnAnF6pmMhpJnnYxZNtPC.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/kPQ1vivnAnF6pmMhpJnnYxZNtPC.jpg","language":"it","width":2000,"height":3000},{"type":"poster","url":"https://image.tmdb.org/t/p/original/g6WhpH0H58ROwqUhQdldGcs4tqg.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/g6WhpH0H58ROwqUhQdldGcs4tqg.jpg","language":"it","width":2000,"height":3000},{"type":"poster","url":"https://i