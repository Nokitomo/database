 souffle au cœur. Il part en compagnie de sa mère faire une cure dans le Morvan. Un tendre marivaudage s'instaure alors entre eux.","tagline":"Un souffle de film!"}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/8hgwPpsqWBcwCiqlo6WGcr9BUTl.jpg","background":"https://image.tmdb.org/t/p/original/d3u97tjDhvPJjeyYMTIEfodtk9j.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":42501,"type":"movie","originalLanguage":"fr-FR","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/8hgwPpsqWBcwCiqlo6WGcr9BUTl.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/8hgwPpsqWBcwCiqlo6WGcr9BUTl.jpg","language":"it","width":959,"height":1438},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/8hgwPpsqWBcwCiqlo6WGcr9BUTl.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/8hgwPpsqWBcwCiqlo6WGcr9BUTl.jpg","language":"it","width":959,"height":1438},{"type":"poster","url":"https://image.tmdb.org/t/p/original/9xCIyZ2uly2O9MImQ38MRvqJ7bW.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/9xCIyZ2uly2O9MImQ38MRvqJ7bW.jpg","language":"it","width":500,"height":751}]},"en":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/gJt4ojBYsaUDGnKqnIqGvQOLpjh.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/gJt4ojBYsaUDGnKqnIqGvQOLpjh.jpg","language":"en","width":500,"height":750},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/gJt4ojBYsaUDGnKqnIqGvQOLpjh.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/gJt4ojBYsaUDGnKqnIqGvQOLpjh.jpg","language":"en","width":500,"height":750},{"type":"poster","url":"https://image.tmdb.org/t/p/original/60aZrZWZqhjSSHxiUVYSUQEm6SD.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/60aZrZWZqhjSSHxiUVYSUQEm6SD.jpg","language":"en","width":1000,"height":1500},{"type":"poster","url":"https://image.tmdb.org/t/p/original/yn3XdTjD