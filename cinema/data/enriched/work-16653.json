eraugām tikai pārbaudes stundā."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/jyx1NjCpp4yrT8MO2OERblKGunr.jpg","background":"https://image.tmdb.org/t/p/original/vs5ji37MVqsDoTzUw2Mh018MzWd.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":432165,"type":"movie","originalLanguage":"lv-LV","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/jyx1NjCpp4yrT8MO2OERblKGunr.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/jyx1NjCpp4yrT8MO2OERblKGunr.jpg","language":"it","width":667,"height":1000},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/jyx1NjCpp4yrT8MO2OERblKGunr.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/jyx1NjCpp4yrT8MO2OERblKGunr.jpg","language":"it","width":667,"height":1000},{"type":"poster","url":"https://image.tmdb.org/t/p/original/rUsxwVtI4l5CNykSLqP7pORtiAC.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/rUsxwVtI4l5CNykSLqP7pORtiAC.jpg","language":"it","width":1000,"height":1500},{"type":"poster","url":"https://image.tmdb.org/t/p/original/ajQBlubrvy8CVXSRnts8bYLTivG.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/ajQBlubrvy8CVXSRnts8bYLTivG.jpg","language":"it","width":667,"height":1000}]},"en":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/h1dH8MmGfeTqbLh8ZoIZaq64bkg.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/h1dH8MmGfeTqbLh8ZoIZaq64bkg.jpg","language":"en","width":1000,"height":1500},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/h1dH8MmGfeTqbLh8ZoIZaq64bkg.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/h1dH8MmGfeTqbLh8ZoIZaq64bkg.jpg","language":"en","width":1000,"height":1500},{"type":"poster","url":"https://image.tmdb.org/t/p/original/kxqzAImrhtigIAUxxtrkAcHhxp2.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/kxqzAImrhtigIAUxxtrkAcHhxp2.jpg","language":"en","widt