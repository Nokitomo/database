.000000Z","updated_at":"2026-07-09T07:20:36.000000Z","release_date_it":"2025-04-11","translations":[{"id":1002693,"translatable_type":"season","translatable_id":29280,"locale":"it","key":"name","value":"Stagione 1"}],"episodes":[{"id":365017,"number":1,"name":"Episodio 1","plot":"Simu Liu presenta 20 concorrenti della reality, tutti ladri che complottano per fuggire dalla sua villa chiusa in cambio di un premio di un milione di dollari. Mescolando celebrità della tv reality con persone comuni, è un caos per soldi!","duration":43,"scws_id":770780,"season_id":29280,"created_at":"2026-07-09T07:20:38.000000Z","updated_at":"2026-07-09T07:20:41.000000Z","quality":"HD","audio_orig":1,"dub_ita":0,"sub_ita":1,"uploaded_at":"2026-07-09 09:20:41","images":[],"translations":[{"id":1002694,"translatable_type":"episode","translatable_id":365017,"locale":"it","key":"name","value":"Episodio 1"},{"id":1002695,"translatable_type":"episode","translatable_id":365017,"locale":"it","key":"plot","value":"Simu Liu presenta 20 concorrenti della reality, tutti ladri che complottano per fuggire dalla sua villa chiusa in cambio di un premio di un milione di dollari. Mescolando celebrità della tv reality con persone comuni, è un caos per soldi!"}]},{"id":365018,"number":2,"name":"Episodio 2","plot":"I tentativi di fuga aumentano quando viene introdotta una nuova svolta del gioco. C'è qualcuno abbastanza intelligente da uscirne sotto il radar? O saranno troppo impegnati a preparare il pollo alla piccata?","duration":43,"scws_id":770781,"season_id":29280,"created_at":"2026-07-09T07:20:45.000000Z","updated_at":"2026-07-09T07:20:48.000000Z","quality":"HD","audio_orig":1,"dub_ita":0,"sub_ita":1,"uploaded_at":"2026-07-09 09:20:48","images":[],"translations":[{"id":1002696,"translatable_type":"episode","translatable_id":365018,"locale":"it","key":"name","value":"Episodio 2"},{"id":1002697,"translatable_type":"episode","translatable_id":365018,"locale":"it","key":"plot","value":"I tentativi di fuga aumentano quando viene introdotta una nuova svolta del gioco. C'è qualcuno abbastanza intelligente da uscirne sotto il radar? O saranno troppo impegnati a preparare il pollo alla piccata?"}]},{"id":365019,"number":3,"name":"Episodio 3","plot":"Gli aspiranti artisti dell'escape sono costretti a lavorare in squadra, creando alleanze improbabili e azioni incredibili. Quando uno di loro concepisce un piano assurdo per fuggire, potrebbe proprio funzionare.","duration":43,"scws_id":770783,"season_id":29280,"created_at":"2026-07-09T07:20:51.000000Z","updated_at":"2026-07-09T07:20:55.000000Z","quality":"HD","audio_orig":1,"dub_ita":0,"sub_ita":1,"uploaded_at":"2026-07-09 09:20:55","images":[],"translations":[{"id":1002698,"translatable_type":"episode","translatable_id":365019,"locale":"it","key":"name","value":"Episodio 3"},{"id":1002699,"translatable_type":"episode","translatable_id":365019,"locale":"it","key":"plot","value":"Gli aspiranti artisti dell'escape sono costretti a lavorare in squadra, creando alleanze improbabili e azioni incredibili. Quando uno di loro concepisce un piano assurdo per fuggire, potrebbe proprio funzionare."}]},{"id":365020,"number":4,"name":"Episodio 4","plot":"Le persone stanno perdendo la testa, mentre una strana storia d'amore pervade la casa, e tutti hanno bisogno di USCIRE SUBITO. Alla fine, il successo o il fallimento dipendono da una sola porzione di polpette.","duration":43,"scws_id":770784,"season_id":29280,"created_at":"2026-07-09T07:20:58.000000Z","updated_at":"2026-07-09T07:21:01.000000Z","quality":"HD","audio_orig":1,"dub_ita":0,"sub_ita":1,"uploaded_at":"2026-07-09 09:21:01","images":[],"translations":[{"id":1002700,"translatable_type":"episode","translatable_id":365020,"locale":"it","key":"name","value":"Episodio 4"},{"id":1002701,"translatable_type":"episode","translatable_id":365020,"locale":"it","key":"plot","value":"Le persone stanno perdendo la testa, mentre una strana storia d'amore pervade la casa, e tutti hanno bisogno di USCIRE SUBITO. Alla fine, il successo o il fallimento dipendono da una sola porzione di polpette."}]},{"id":365021,"number":5,"name":"Episodio 5","plot":"Quasi a metà del blocco di dieci giorni, e i guanti sono tolti. Nuove strategie abbondano, mentre il gioco continua a riservare sorprese. Regali che continuano a dare.","duration":44,"scws_id":770785,"season_id":29280,"created_at":"2026-07-09T07:21:05.000000Z","updated_at":"2026-07-09T07:21:08.000000Z","quality":"HD","audio_orig":1,"dub_ita":0,"sub_ita":1,"uploaded_at":"2026-07-09 09:21:08","images":[],"translations":[{"id":1002702,"translatable_type":"episode","translatable_id":365021,"locale":"it","key":"name","value":"Episodio 5"},{"id":1002703,"translatable_type":"episode","translatable_id":365021,"locale":"it","key":"plot","value":"Quasi a metà del blocco di dieci giorni, e i guanti sono tolti. Nuove strategie abbondano, mentre il gioco continua a riservare sorprese. Regali che continuano a dare."}]},{"id":365022,"number":6,"name":"Episodio 6","plot":"Un'interruzione di corrente congela l'orologio del denaro, rivelando un modo segreto per uscire. Le alleanze si consolidano, la difesa diventa più difficile e un cattivo fa la sua mossa.","duration":43,"scws_id":770786,"season_id":29280,"created_at":"2026-07-09T07:21:12.000000Z","updated_at":"2026-07-09T07:21:16.000000Z","quality":"HD","audio_orig":1,"dub_ita":0,"sub_ita":1,"uploaded_at":"2026-07-09 09:21:15","images":[],"translations":[{"id":1002704,"translatable_type":"episode","translatable_id":365022,"locale":"it","key":"name","value":"Episodio 6"},{"id":1002705,"translatable_type":"episode","translatable_id":365022,"locale":"it","key":"plot","value":"Un'interruzione di corrente congela l'orologio del denaro, rivelando un modo segreto per uscire. Le alleanze si consolidano, la difesa diventa più difficile e un cattivo fa la sua mossa."}]},{"id":365023,"number":7,"name":"Episodio 7","plot":"Il mal di chiuso raggiunge un livello record mentre la trama prende una s