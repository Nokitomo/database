rendo che in fondo avevano ancora qualcosa da dirsi (civilmente).","language":"it-IT"},"tagline":{"value":"… sinon dites « Le volcan »","language":"fr-FR"},"releaseDate":"2013-10-02","status":"Released","rating":5.591,"ratingCount":695,"genres":["Commedia"],"countries":["Belgium","France"],"facts":{"Runtime":"92m"},"keywords":[],"networks":[],"socialLinks":{},"cast":[{"id":54324,"name":"Valérie Bonneton","role":"Valérie","profile":"https://image.tmdb.org/t/p/original/tHGojn1vMzGriINazQhMBBcG9u9.jpg"},{"id":37627,"name":"Dany Boon","role":"Alain","profile":"https://image.tmdb.org/t/p/original/6jMvseHpFra7tkfDIg64u5pJcI2.jpg"},{"id":81125,"name":"Denis Ménochet","role":"Ezechiel","profile":"https://image.tmdb.org/t/p/original/qpCPmm12kbzMKniYF6iKmKLZCjY.jpg"},{"id":1187236,"name":"Bérangère McNeese","role":"Cécile","profile":"https://image.tmdb.org/t/p/original/tzMuA6UYLDUTUbhkAULij5D1gg3.jpg"},{"id":3730,"name":"Albert Delpy","role":"Tonton Roger","profile":"https://image.tmdb.org/t/p/original/8j9s2hCN0IEdr7QCeHoxo5cbHTf.jpg"},{"id":74115,"name":"Constance Dollé","role":"Sylvie","profile":"https://image.tmdb.org/t/p/original/wS97F2irPNwsLAJPcWjWcZKeT3Y.jpg"},{"id":1180423,"name":"Malik Bentalha","role":"Ami de Cécile","profile":"https://image.tmdb.org/t/p/original/43F8PszssVIvGIxNjtakHOImkDS.jpg"},{"id":1496140,"name":"Myriam Azencot","role":"Voisine avion","profile":"https://image.tmdb.org/t/p/original/ntDzAtjxE4eaO6z0vtd9FUGn4k3.jpg"},{"id":19080,"name":"Arnaud Henriet","role":"Voisin avion Alain","profile":"https://image.tmdb.org/t/p/original/wBcCaNPEY0O6Ixb3oOEeRGfJLHC.jpg"},{"id":2108173,"name":"Yann Sorton","role":"Stewart grec","profile":"https://image.tmdb.org/t/p/original/2AvFkJYcLXiSUPkQwjbgtgftehv.jpg"},{"id":1321013,"name":"Jochen Hägele","role":"Agent Avis Allemagne","profile":"https://image.tmdb.org/t/p/original/p5u3tFIOIL6hhq7WeWUlMCzchow.jpg"},{"id":2108179,"name":"Barbara Ornellas","role":"Femme autocar"},{"id":1330947,"name":"Brigitte Böttrich","rol