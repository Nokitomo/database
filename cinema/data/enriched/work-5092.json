uen Stadt schwört Lilli, ihr Geheimnis für sich zu behalten. Doch dann macht ein gemeiner Tierdieb den städtischen Zoo, in dem Zoodirektorin „Oberst Essig“ mit dem gutmütigen Tierpfleger Toni arbeitet, unsicher – und Tonis berechnende Freundin, die aufgetakelte Vanessa spielt ein falsches Spiel. Nur Lilli kann – unterstützt vom Nachbarsjungen Jess – helfen, Babyelefant Ronni und die anderen Tiere zu retten. Das Abenteuer kann beginnen!"}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/5JrOkPYsRIj4ENWfyyTLdlgMfJz.jpg","background":"https://image.tmdb.org/t/p/original/Z6qsRVE80MMLOVLZKEQ3vtslS9.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":505204,"type":"movie","originalLanguage":"de-DE","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/5JrOkPYsRIj4ENWfyyTLdlgMfJz.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/5JrOkPYsRIj4ENWfyyTLdlgMfJz.jpg","language":"it","width":2000,"height":2832},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/5JrOkPYsRIj4ENWfyyTLdlgMfJz.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/5JrOkPYsRIj4ENWfyyTLdlgMfJz.jpg","language":"it","width":2000,"height":2832},{"type":"poster","url":"https://image.tmdb.org/t/p/original/ppoVOXEez7Cgw43fVTs4itBgHLi.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/ppoVOXEez7Cgw43fVTs4itBgHLi.jpg","language":"it","width":1200,"height":1600}]},"en":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/vlSeZqSFojm6Hh2fxTdvU9XCRGu.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/vlSeZqSFojm6Hh2fxTdvU9XCRGu.jpg","language":"en","width":800,"height":1200},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/vlSeZqSFojm6Hh2fxTdvU9XCRGu.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/vlSeZqSFojm6Hh2fxTdvU9XCRGu.jpg","language":"en","width":800,"height":1200},{