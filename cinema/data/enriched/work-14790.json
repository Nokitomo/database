riginalLanguage":"en-US","title":{"value":"Stalker - Prigioniera dell'incubo","language":"it-IT"},"originalTitle":"Stalker","overview":{"value":"Rose Hepburn, una giovane attrice che lavora nei film horror, torna nel suo albergo vuoto. Costretta a usare il vecchio montacarichi, questo si blocca al dodicesimo piano, lasciandola intrappolata con un insolito sconosciuto. Senza segnale per il cellulare, mentre si avvicina una tempesta, la tensione sale e i sospetti aumentano quando Rose scopre che l'identità dell'uomo misterioso è Daniel Reed, un operatore di ripresa del suo ultimo film, apparentemente ossessionato da lei. Mentre l'ascensore è in bilico e sta per precipitare da un momento all'altro, iniziano a emergere alcune crude verità e azioni.","language":"it-IT"},"tagline":{"value":"Chi è il cacciatore?","language":"it-IT"},"releaseDate":"2023-03-31","status":"Released","rating":5.7,"ratingCount":27,"genres":["Horror","Thriller"],"countries":["United Kingdom"],"facts":{"Runtime":"93m"},"keywords":[],"networks":[],"socialLinks":{},"cast":[{"id":1623273,"name":"Sophie Skelton","role":"Rose Hepburn","profile":"https://image.tmdb.org/t/p/original/oBkearm8XdrYTEK0VCWCGmwURt6.jpg"},{"id":549469,"name":"Stuart Brennan","role":"Daniel Reed","profile":"https://image.tmdb.org/t/p/original/iovoH2DnGo81TgzrDgdhnWSf3dh.jpg"},{"id":112217,"name":"Bret Hart","profile":"https://image.tmdb.org/t/p/original/uIkiMOyAf4wCieTXi3vOkvV66f6.jpg"},{"id":3637991,"name":"Olivia J. Night"},{"id":3108084,"name":"Doddi El-Gabry"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","title":"Stalker - Prigioniera dell'incubo","overview":"Rose Hepburn, una giovane attrice che lavora nei film horror, torna nel suo albergo vuoto. Costretta a usare il vecchio montacarichi, questo si blocca al dodicesimo piano, lasciandola intrappolata con un insolito sconosciuto. Senza segnale per il cellulare, mentre si avvicina una tempesta, la tensione sale e i sospetti aumentano quando Rose scopre che l'identità dell'uomo misterioso è Daniel Reed, un operatore di ripresa del suo ultimo film, apparentemente ossessionato da lei. Mentre l'ascensore è in bilico e sta per precipitare da un momento all'altro, iniziano a emergere alcune crude verità e azioni.","tagline":"Chi è il cacciatore?"},{"language":"en-US","overview":"Rose Hepburn, a young actor working in horror movies, returns to her empty hotel. Forced to use the old freight elevator, it jolts to a halt on the twelfth floor, leaving her trapped with an unusual stranger. Left with no mobile phone signal as a storm approaches, tensions escalate and suspicions rise when Rose discovers the identity of the mysterious man is Daniel Reed, a camera operator on her latest movie, who is seemingly obsessed with her. As the elevator hangs precariously high about to plunge down at any minute, some harsh truths and actions start unfolding.","tagline":"Who is the hunter?"}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/kNyEWSSVXzemoaWLlRvsJSsEZpw.jpg","background":"https://image.tmdb.org/t/p/original/dQoRGk9r0k0wfk1wMCCwzRMT2zm.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":1004130,"type":"movie","originalLanguage":"en-US","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/kNyEWSSVXzemoaWLlRvsJSsEZpw.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/kNyEWSSVXzemoaWLlRvsJSsEZpw.jpg","language":"it","width":1400,"height":2100},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/kNyEWSSVXzemoaWLlRvsJSsEZpw.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/kNyEWSSVXzemoaWLlRvsJSsEZpw.jpg","language":"it","width":1400,"height":2100}]},"en":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/g6aZ3KUntef8IbT16uMNSkcUPe1.jpg","previewUrl":"https://image.tmdb.org/t/p/w30