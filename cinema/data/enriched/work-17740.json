nal/rWSlHrbQb2kfc0x0pH595iINsSh.jpg"},{"id":963117,"name":"Bar Paly","role":"Krisztina","profile":"https://image.tmdb.org/t/p/original/u0ObQI94EUdcIt0eHhEBUrA4gGW.jpg"},{"id":119598,"name":"Phylicia Rashād","role":"Jane","profile":"https://image.tmdb.org/t/p/original/o0sQd9JvPsxRq7BJLOeP6ASsh5Q.jpg"},{"id":57412,"name":"Moisés Arias","role":"Luis","profile":"https://image.tmdb.org/t/p/original/fc7krDmEA4VkIY4KOJjpMXGdsfg.jpg"},{"id":1749296,"name":"Shanynn Samiyah Covington","role":"past jane","profile":"https://image.tmdb.org/t/p/original/fPeWtLaN5GgsbrDa2PQo1izimgd.jpg"}]},"providers":{"streamingunity":[{"id":8622,"path":"/it/titles/8622-jean-claude-van-johnson","availability":"present","seasons":[{"id":4846,"number":1,"name":null,"plot":"","release_date":null,"title_id":8622,"created_at":"2024-05-28T18:35:05.000000Z","updated_at":"2025-05-12T09:54:38.000000Z","release_date_it":null,"translations":[],"episodes":[{"id":63249,"number":1,"name":"Pilota","plot":"L'attore, nonché spia internazionale, Jean-Claude Van Damme, decide di tornare al lavoro, dopo essersi ritirato, per riconquistare la sua ex donna, parrucchiera e suo braccio destro, Vanessa. Malgrado i suoi dubbi, JCVD ben presto scopre di essere a suo agio sia sul set che sul campo... per un giorno, almeno. Dopidiché manda tutto all'aria.","duration":31,"scws_id":230310,"season_id":4846,"created_at":"2024-05-28T18:35:06.000000Z","updated_at":"2025-11-05T08:39:53.000000Z","quality":"HD","audio_orig":1,"dub_ita":1,"sub_ita":0,"uploaded_at":"2024-05-28 20:35:06","images":[{"id":110550,"filename":"80b4a578-8afe-459f-86ab-88cd8dc44ea9.webp","type":"cover","lang":null,"imageable_type":"episode","imageable_id":63249,"created_at":"2024-05-28T18:35:06.000000Z","updated_at":"2024-05-28T18:35:06.000000Z","original_url_field":null,"reference":{"base":"streamingunity:images","path":"/images/80b4a578-8afe-459f-86ab-88cd8dc44ea9.webp"}}],"translations":[{"id":201171,"translatable_type":"episode","translatable_id":63249,"locale":"it","key":"name","value":"Pilota"},{"id":201172,"translatable_type":"episode","translatable_id":63249,"locale":"it","key":"plot","value":"L'attore, nonché spia internazionale, Jean-Claude Van Damme, decide di tornare al lavoro, dopo essersi ritirato, per riconquistare la sua ex donna, parrucchiera e suo braccio destro, Vanessa. Malgrado i suoi dubbi, JCVD ben presto scopre di essere a suo agio sia sul set che sul campo... per un giorno, almeno. Dopidiché manda tutto all'aria."}]},{"id":63268,"number":2,"name":"Che anno pensi che sia?","plot":"In seguito alla disapprovazione di Vanessa riguardo il suo raffazzonato incarico, JCVD raddoppia gli sforzi per portare a termine il lavoro, infiltrandosi in un giro di corse automobilistiche clandestine... dove crea solo scompiglio. Fortunatamente per lui, Vanessa ha scoperto che la droga è solo la punta dell'iceberg e che avrà bisogno di tutto l'aiuto possibile... anche di quello di JCVD.","duration":31,"scws_id":230311,"season_id":4846,"created_at":"2024-05-28T19:28:04.000000Z","updated_at":"2025-11-05T08:39:53.000000Z","quality":"HD","audio_orig":1,"dub_ita":1,"sub_ita":0,"uploaded_at":"2024-05-28 21:28:04","images":[{"id":110574,"filename":"c7c6ec41-c92f-49a1-b6af-74a9b9dd1278.webp","type":"cover","lang":null,"imageable_type":"episode","imageable_id":63268,"created_at":"2024-05-28T19:28:04.000000Z","updated_at":"2024-05-28T19:28:04.000000Z","original_url_field":null,"reference":{"base":"streamingunity:images","path":"/images/c7c6ec41-c92f-49a1-b6af-74a9b9dd1278.webp"}}],"translations":[{"id":201227,"translatable_type":"episode","translatable_id":63268,"locale":"it","key":"name","value":"Che anno pensi che sia?"},{"id":201228,"translatable_type":"episode","translatable_id":63268,"locale":"it","key":"plot","value":"In seguito alla disapprovazione di Vanessa riguardo il suo raffazzonato incarico, JCVD raddoppia gli sforzi per portare a termine il lavoro, infiltrandosi in un giro di corse automobilistiche clandestine... dove crea solo scompiglio. Fortunatamente per lui, Vanessa ha scoperto che la droga è solo la punta dell'iceberg e che avrà bisogno di tutto l'aiuto possibile... anche di quello di JCVD."}]},{"id":63253,"number":3,"name":"Una breve conversazione sulla fiducia","plot":"Filip non ha mai chiesto molto. Solo un gruppo di buoni colleghi - cosa che ha - finché la sua vita, per una qualche ragione, non viene stravolta dal leggendario attore Jean-Claude Van Damme. Fortunatamente, un gruppo di mercenari è subito dietro l'angolo, pronto a offrire a Filip la possibilità di vendicarsi.","duration":28,"scws_id":230312,"season_id":4846,"created_at":"2024-05-28T18:38:06.000000Z","updated_at":"2025-11-05T08:39:53.000000Z","quality":"HD","audio_orig":1,"dub_ita":1,"sub_ita":0,"uploaded_at":"2024-05-28 20:38:06","images":[{"id":110554,"filename":"2e081825-dfd2-40a0-a4d1-4e488b131c17.webp","type":"cover","lang":null,"imageable_type":"episode","imageable_id":63253,"created_at":"2024-05-28T18:38:06.000000Z","updated_at":"2024-05-28T18:38:06.000000Z","original_url_field":null,"reference":{"base":"streamingunity:images","path":"/images/2e081825-dfd2-40a0-a4d1-4e488b131c17.webp"}}],"translations":[{"id":201186,"translatable_type":"episode","translatable_id":63253,"locale":"it","key":"name","value":"Una breve conversazione sulla fiducia"},{"id":201187,"translatable_type":"episode","translatable_id":63253,"locale":"it","key":"plot","value":"Filip non ha mai chiesto molto. Solo un gruppo di buoni colleghi - cosa che ha - finché la sua vita, per una qualche ragione, non viene stravolta dal leggendario attore Jean-Claude Van Damme. Fortunatamente, un gruppo di mercenari è subito dietro l'angolo, pronto a offrire a Filip la possibilità di vendicarsi."}]},{"id":63269,"number":4,"name":"Se sei fortunato","plot":"JCVD dovrà scoprire se il tempo è circolare o piuttosto un tetraedro. Filip rimane intrappolato in un incubo che ha creato da solo. Vanessa deve affrontare il dolore del passato e Luis si trova di fronte alla tetra desolazione della sua anima. Episodio catalogato come LS (Light Science).","duration":33,"scws_id":230313,"season_id":4846,"created_at":"2024-05-28T19:28:05.000000Z","updated_at":"2025-11-05T08:39:53.000000Z","quality":"HD","audio_orig":1,"dub_ita":1,"sub_ita":0,"uploaded_at":"2024-05-28 21:28:05","images":[{"id":110575,"filename":"dcc371b0-f489-4439-89c3-4ffa00cac694.webp","type":"cover","lang":null,"imageable_type":"episode","imageable_id":63269,"created_at":"2024-05-28T19:28:05.000000Z","updated_at":"2024-05-28T19:28:05.000000Z","original_url_field":null,"reference":{"base":"streamingunity:images","path":"/images/dcc371b0-f489-4439-89c3-4ffa00cac694.webp"}}],"translations":[{"id":201229,"translatable_type":"episode","translatable_id":63269,"locale":"it","key":"name","value":"Se sei fortunato"},{"id":201230,"translatable_type":"episode","translatable_id":63269,"locale":"it","key":"plot","value":"JCVD dovrà scoprire se il tempo è circolare o piuttosto un tetraedro. Filip rimane intrappolato in un incubo che ha creato da solo. Vanessa deve affrontare il dolore del passato e Luis si trova di fronte alla tetra desolazione della sua anima. Episodio catalogato come LS (Light Science)."}]},{"id":63254,"number":5,"name":"Non andare da nessuna parte","plot":"Dopo aver distrutto ciò che era rimasto della sua carriera ed essersi alienato tutti i suoi cari, JCVD torna nella sua città natale a leccarsi le ferite. Ma non si riesce mai a tornare a casa veramente, e certe ferite sono difficili da raggiungere con la lingua.","duration":30,"scws_id":230314,"season_id":4846,"created_at":"2024-05-28T18:38:07.000000Z","updated_at":"2025-11-05T08:39:53.000000Z","quality":"HD","audio_orig":1,"dub_ita":1,"sub_ita":0,"uploaded_at":"2024-05-28 20:38:07","images":[{"id":110555,"filename":"fcc2489c-10a4-4381-a241-c416b2e46730.webp","type":"cover","lang":null,"imageable_type":"episode","imageable_id":63254,"created_at":"2024-05-28T18:38:07.000000Z","updated_at":"20