29.000000Z","original_url_field":null,"reference":{"base":"streamingunity:images","path":"/images/a178449b-7e18-449c-bd9f-ed86df016e87.webp"},"provider":"streamingunity"}],"episodeMappingUncertain":false,"seasons":[],"provenance":{},"warnings":[],"externalIdsEvidence":{"wikidata":{"source":"wikidata","sourceUrl":"https://www.wikidata.org/wiki/Q97165685","wikidataId":"Q97165685","tmdbId":659943,"type":"movie","imdbId":"tt11060092","tvdbId":136044}},"externalMedia":{"tmdb":{"source":"tmdb-api","id":659943,"type":"movie","sourceUrl":"https://www.themoviedb.org/movie/659943","fetchedAt":"2026-11-07T08:12:36.629Z","originalLanguage":"fr-FR","title":{"value":"Poly","language":"fr-FR"},"originalTitle":"Poly","overview":{"value":"Cécile, 10 anni, si trasferisce nel sud della Francia con la madre Louise. L'integrazione con gli altri bambini nel villaggio non è facile. Quando un circo di passaggio si ferma nel loro paese, Cécile scopre che Poly, un pony stellato, subisce degli abusi e decide di proteggerlo e organizzare la sua fuga. Inseguiti da Brancalou, il direttore del circo, e il misterioso Victor, Cécile e Poly intraprendono un viaggio pieno di colpi di scena, un vero viaggio di iniziazione e un'incredibile storia di amicizia.","language":"it-IT"},"tagline":{"value":"Rejoignez l'aventure","language":"fr-FR"},"releaseDate":"2020-06-10","status":"Released","rating":6,"ratingCount":42,"genres":["Famiglia","Avventura"],"countries":["France"],"facts":{"Runtime":"102m"},"keywords":[],"networks":[],"socialLinks":{},"cast":[{"id":33161,"name":"François Cluzet","role":"Victor","profile":"https://image.tmdb.org/t/p/original/f6PO7Lkrem1N4UmklxHro2k6Jto.jpg"},{"id":37628,"name":"Julie Gayet","role":"Louise","profile":"https://image.tmdb.org/t/p/original/wt2ZtI2RFcOWcaUoXp8O5jv1bmx.jpg"},{"id":41526,"name":"Patrick Timsit","role":"Brancalou","profile":"https://image.tmdb.org/t/p/original/lS22SWFT4jo4mgfC0HsbgMstPf2.jpg"},{"id":2764693,"name":"Elisa de Lambert","role":"Cécile","profi