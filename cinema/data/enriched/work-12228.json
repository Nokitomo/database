 veut… Et encore moins Cédric !","tagline":"Il fait le bien… mais mal !"}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/7VsLlIMme1tbPsaplmwQ7siS3dW.jpg","background":"https://image.tmdb.org/t/p/original/oIxLAeuMiIST6OQfnoAftIVtf4U.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":746333,"type":"movie","originalLanguage":"fr-FR","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/7VsLlIMme1tbPsaplmwQ7siS3dW.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/7VsLlIMme1tbPsaplmwQ7siS3dW.jpg","language":"it","width":576,"height":864},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/7VsLlIMme1tbPsaplmwQ7siS3dW.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/7VsLlIMme1tbPsaplmwQ7siS3dW.jpg","language":"it","width":576,"height":864}]},"en":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/Aie2kiYOUgZeakpshM2N64PKof1.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/Aie2kiYOUgZeakpshM2N64PKof1.jpg","language":"en","width":1000,"height":1500},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/Aie2kiYOUgZeakpshM2N64PKof1.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/Aie2kiYOUgZeakpshM2N64PKof1.jpg","language":"en","width":1000,"height":1500},{"type":"poster","url":"https://image.tmdb.org/t/p/original/nrYZpqd8NMpBnVM6rMH74P39bfU.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/nrYZpqd8NMpBnVM6rMH74P39bfU.jpg","language":"en","width":680,"height":924}]},"fr":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/4nuElmKU1F53qGq0MskGgyRH8Q2.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/4nuElmKU1F53qGq0MskGgyRH8Q2.jpg","language":"fr","width":2000,"height":3000},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/4nuElmKU1F53qGq0MskGgyRH8Q2.jpg","previewU