":"title","imageable_id":52530,"created_at":"2026-01-27T17:09:42.000000Z","updated_at":"2026-01-27T17:09:42.000000Z","original_url_field":null,"reference":{"base":"streamingunity:images","path":"/images/278bc8b1-29a4-4460-b1eb-79e72503ff3f.webp"},"provider":"streamingunity"}],"episodeMappingUncertain":false,"seasons":[],"provenance":{},"warnings":[],"externalIdsEvidence":{"wikidata":{"source":"wikidata","sourceUrl":"https://www.wikidata.org/wiki/Q239668","wikidataId":"Q239668","tmdbId":42129,"type":"movie","imdbId":"tt0084151","tvdbId":54814}},"externalMedia":{"tmdb":{"source":"tmdb-api","id":42129,"type":"movie","sourceUrl":"https://www.themoviedb.org/movie/42129","fetchedAt":"2026-11-07T18:29:08.807Z","originalLanguage":"it-IT","title":{"value":"The Pool Hustlers","language":"en-US"},"originalTitle":"Io, Chiara e lo scuro","overview":{"value":"Francesco è un simpatico giovanotto toscano, abile giocatore di biliardo, tanto da riuscire a battere lo Scuro, un campione più volte nazionale e imbattuto; dapprima Francesco chiede di giocare senza soldi, ma lo Scuro insiste e alla fine si troverà travolto da perdite tali da costringerlo a impossessarsi del contante che i clienti dell'albergo nel quale lavora tengono in deposito nelle cassette. La sua vita che prima si svolgeva tra il posto di lavoro, i tavoli da biliardo e la casa, improvvisamente si anima per la presenza di Chiara, una ragazza che abita nello stesso edificio dove abita lui e che fa la sassofonista in un night. Prendendo insieme il tram senza volerlo, si scambiano le custodie dove Francesco tiene la sua stecca smontabile di alluminio e Chiara il suo prezioso sassofono. Così si incontrano, si conoscono e si amano e quando Francesco si troverà travolto dai debiti e con la prospettiva di finire in prigione, sarà proprio Chiara a tirarlo fuori dai guai.","language":"it-IT"},"releaseDate":"1983-03-11","status":"Released","rating":6.9,"ratingCount":62,"genres":["Commedia","Romance"],"countries":["Italy"],"facts":{"Runtime":"103m"},"keywords":[],"networks":[],"socialLinks":{},"cast":[{"id":225255,"name":"Francesco Nuti","role":"Francesco Piccioli detto \"Il Toscano\"","profile":"https://image.tmdb.org/t/p/original/kDzo1YfHRXYxftFLcZF5xnDCw4c.jpg"},{"id":224944,"name":"Giuliana De Sio","role":"Chiara","profile":"https://image.tmdb.org/t/p/original/hs8GhLekSv1CnTod6hmgZfsnBtI.jpg"},{"id":235824,"name":"Marcello Lotti","role":"Lo scuro","profile":"https://image.tmdb.org/t/p/original/v291FCALWlyGRFVtZ3BG952nIQK.jpg"},{"id":93722,"name":"Antonio Petrocelli","role":"Mancino","profile":"https://image.tmdb.org/t/p/original/iqYdxG48zrWbVJO05H1yb43467u.jpg"},{"id":225258,"name":"Novello Novelli","role":"Merlo","profile":"https://image.tmdb.org/t/p/original/mvk6Hzi9rMdWD6GSpWgjHKeIeVD.jpg"},{"id":120636,"name":"Renato Cecchetto","role":"Giovanni","profile":"https://image.tmdb.org/t/p/original/qrdywLcLWFKOozTqEuChflSFWZe.jpg"},{"id":119352,"name":"Claudio Spadaro","role":"pazzo alla fermata dell'autobus","profile":"https://image.tmdb.org/t/p/original/pYNbVlVGahYDMi7vOMgNUrZZL7L.jpg"},{"id":105114,"name":"Ricky Tognazzi","role":"Un pescatore (Uncredited)","profile":"https://image.tmdb.org/t/p/original/fBgtva5iaF2mUSzC4o7qqYbBEIb.jpg"},{"id":2197758,"name":"Claudio Casale"},{"id":1383025,"name":"Carlo Neri"},{"id":2197759,"name":"Stefano Cuneo"},{"id":1277577,"name":"Pierangelo Pozzato"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","overview":"Francesco è un simpatico giovanotto toscano, abile giocatore di biliardo, tanto da riuscire a battere lo Scuro, un campione più volte nazionale e imbattuto; dapprima Francesco chiede di giocare senza soldi, ma lo Scuro insiste e alla fine si troverà travolto da perdite tali da costringerlo a impossessarsi del contante che i clienti dell'albergo nel quale lavora tengono in deposito nelle cassette. La sua vita che prima si svolgeva tra il posto di lavoro, i tavoli da biliardo e la casa, improvvisamente si anima per la presenza di Chiara, una ragazza che abita nello stesso edificio dove abita lui e che fa la sassofonista in un night. Prendendo insieme il tram senza volerlo, si scambiano le custodie dove Francesco tiene la sua stecca smontabile di alluminio e Chiara il suo prezioso sassofono. Così si incontrano, si conoscono e si amano e quando Francesco si troverà travolto dai debiti e con la prospettiva di finire in prigione, sarà proprio Chiara a tirarlo fuori dai guai."},{"language":"en-US","title":"The Pool Hustlers","overview":"Francesco, nicknamed 'Toscano', is a very good pool player but he never wins when he plays for money. He meets Chiara, a saxophone player, on a late night bus by swapping his case containing the cue with her one, containing the sax. The two fall in love, but in the meantime Francesco loses a big amount of money playing versus 'Scuro', the long-time Italian champion. His only chance to pay the debt is to win the Italian Championships."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/amV19RiG266LeZAuBsCrEuKyEzw.jpg","background":"https://image.tmdb.org/t/p/original/m7jHFlYjuWpVn57xDSB8v8EgW32.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":42129,"type":"movie","originalLanguage":"it-IT","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/amV19RiG266LeZAuBsCrEuKyEzw.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/amV19RiG266LeZAuBsCrEuKyEzw.jpg","language":"it","width":1280,"height":1920},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/amV19RiG266LeZAuBsCrEuKyEzw.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/amV19RiG266LeZAuBsCrEuKyEzw.jpg","language":"it","width":1280,"height":1920},{"type":"poster","url":"https://image.tmdb.org/t/p/original/3eWcYkI7wrNCOUyxLUWo5uh46vF.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/3eWcYkI7wrNCOUyxLU