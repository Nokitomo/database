:[{"language":"it-IT","overview":"Quando Mitchie fa ritorno a Camp Rock, si aspetta di trascorrere un'estate romantica e divertente, ma il soggiorno si rivelerà invece pieno di problemi da affrontare. I Connect Three passeranno tutta la stagione a Camp Rock, ma Mitchie non potrà godere con tranquillità della compagnia di Shane a causa della gelosia dell'invidiosa Tess che architetterà un piano per separare i due innamorati."},{"language":"en-US","overview":"Mitchie can't wait to go back to Camp Rock and spend the summer making new music with her friends and superstar Shane Gray. But the slick new camp across the lake, Camp Star, has drummed up some serious competition – featuring newcomers Luke and Dana. In a sensational battle of the bands, with Camp Rock's future at stake, will Camp Star's flashy production and over-the-top antics win out, or will Camp Rockers prove that music, teamwork, and spirit are what truly matter?","tagline":"It's all about the music."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/lQGkxmozNzxPbUg7ZKFuRPuCVZ3.jpg","background":"https://image.tmdb.org/t/p/original/tGgDjve3sY6me6JtefocFycCgyD.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":44244,"type":"movie","originalLanguage":"en-US","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/lQGkxmozNzxPbUg7ZKFuRPuCVZ3.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/lQGkxmozNzxPbUg7ZKFuRPuCVZ3.jpg","language":"it","width":1000,"height":1500},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/lQGkxmozNzxPbUg7ZKFuRPuCVZ3.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/lQGkxmozNzxPbUg7ZKFuRPuCVZ3.jpg","language":"it","width":1000,"height":1500}]},"en":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/8RSdWqC259zR72Jjo6ANAM4ndhM.jpg","previewUrl":"https://image.tmdb.