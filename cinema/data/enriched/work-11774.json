"warnings":[],"externalMedia":{"tmdb":{"source":"tmdb-api","id":84644,"type":"movie","sourceUrl":"https://www.themoviedb.org/movie/84644","fetchedAt":"2026-11-07T20:09:03.638Z","originalLanguage":"fr-FR","title":{"value":"The Cousin","language":"en-US"},"originalTitle":"Le Cousin","overview":{"value":"Nounours is the nickname of a \"cousin\" an informer with a special arrangement with the police: he gets 10% of the drugs seized thanks to his help. When his personal contact, inspector Maurin, commits suicide, inspector Gérard Delvaux takes over. Meanwhile, judge Lambert is uncovering the illegal practices of the policemen. Her persistent investigations, which had cornered Maurin, are leading to Gérard, and also to Nounours as the source of heroin that led to recent cases of deadly overdoses. Nounours promises Gérard increasingly bigger catches which he is intent on realising before he is forced to reveal who Nounours is to judge Lambert.","language":"en-US"},"releaseDate":"1997-12-10","status":"Released","rating":6.3,"ratingCount":68,"genres":["Crime"],"countries":["France"],"facts":{"Runtime":"112m"},"keywords":[],"networks":[],"socialLinks":{},"cast":[{"id":41526,"name":"Patrick Timsit","role":"Nounours","profile":"https://image.tmdb.org/t/p/original/lS22SWFT4jo4mgfC0HsbgMstPf2.jpg"},{"id":4275,"name":"Alain Chabat","role":"Gérard Delvaux","profile":"https://image.tmdb.org/t/p/original/xRjymE6LIJd0useKWN2R1WgKDRy.jpg"},{"id":49025,"name":"Samuel Le Bihan","role":"Francis","profile":"https://image.tmdb.org/t/p/original/jN4hwWfhFaE8v5TGiS6cg9HKOxe.jpg"},{"id":76967,"name":"Caroline Proust","role":"Fanny","profile":"https://image.tmdb.org/t/p/original/5cTUI6EGnpnBqe3dyNQouLM5aIz.jpg"},{"id":35217,"name":"Mehdi El Glaoui","role":"Jeannot","profile":"https://image.tmdb.org/t/p/original/bHG4xvf7WpHn4MIuSZvSsb6oBHx.jpg"},{"id":881562,"name":"Christophe Peyroux","role":"Michel","profile":"https://image.tmdb.org/t/p/original/67G4W75xhxG2X3LnfTsbcmbQaZO.jpg"},{"id":39689,"na