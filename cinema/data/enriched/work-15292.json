":"2026-09-16T01:02:05.000000Z","original_url_field":null,"reference":{"base":"streamingunity:images","path":"/images/fca78a01-e221-4aa4-ba40-fb96522e4b07.webp"},"provider":"streamingunity"}],"episodeMappingUncertain":false,"seasons":[],"provenance":{},"warnings":[],"externalIdsEvidence":{"wikidata":{"source":"wikidata","sourceUrl":"https://www.wikidata.org/wiki/Q7304800","wikidataId":"Q7304800","tmdbId":27728,"type":"movie","imdbId":"tt0388365","tvdbId":84052}},"externalMedia":{"tmdb":{"source":"tmdb-api","id":27728,"type":"movie","sourceUrl":"https://www.themoviedb.org/movie/27728","fetchedAt":"2026-11-08T06:15:18.611Z","originalLanguage":"en-US","title":{"value":"Cappuccetto Rosso","language":"it-IT"},"originalTitle":"Red Riding Hood","overview":{"value":"Jenny McKenzie ha avuto un'infanzia molto difficile. È ancora troppo piccola quando suo padre, membro della Suprema Corte degli Stati Uniti, viene ucciso. L'uomo perseguiva un solo obbiettivo: ripristinare la giustizia e la moralità, valori sempre più trascurati dalla società moderna. La madre, viceversa, è troppo occupata a frequentare amanti più giovani, ma è proprio la scielta di inseguire un nuovo fidanzato a trasformare la vita noiosa e frustrante di Jenny. Trascinata a Roma dalla madre, la ragazza si trova in completa libertà con una carta di credito e un bellissimo appartamento nel centro della città. Finalmente Jenny può curare i propri interessi: migliorare la propria istruzione e portare avanti la missione del padre, applicare la giustizia... costi qul che costi!","language":"it-IT"},"tagline":{"value":"Verranno puniti... uno per uno!","language":"it-IT"},"releaseDate":"2003-05-20","status":"Released","rating":4.8,"ratingCount":19,"genres":["Horror","Dramma","Thriller"],"countries":["Italy"],"facts":{"Runtime":"92m"},"keywords":[],"networks":[],"socialLinks":{},"cast":[{"id":986831,"name":"Kathleen Archebald","role":"Rose McKenzie"},{"id":1083151,"name":"Susanna Satta","role":"Jennifer McKenzie (as Sus