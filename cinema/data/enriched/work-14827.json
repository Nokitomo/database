type":"movie","imdbId":"tt6879446","tvdbId":7318}},"externalMedia":{"tmdb":{"source":"tmdb-api","id":457332,"type":"movie","sourceUrl":"https://www.themoviedb.org/movie/457332","fetchedAt":"2026-11-08T05:08:10.195Z","originalLanguage":"en-US","title":{"value":"Project X-Traction","language":"it-IT"},"originalTitle":"Hidden Strike","overview":{"value":"Luo Feng (Jackie Chan) e Chris Van Horne (John Cena), due ex soldati delle forze speciali mandati a seguire una missione in Iraq. I due devono scortare un gruppo di civili in viaggio da Kuwait City alla zona verde di Baghdad. Il percorso prevede la traversata della famigerata \"autostrada della morte”, un tratto pericolosissimo che dal Kuwait porta in Iraq. I due ex soldati sono una coppia improbabile, Feng è piuttosto maldestro, tende a cacciarsi nei guai e Van Horne ha spesso il compito di rimediare. Con queste premesse, il viaggio del gruppo non mancherà di incontrare ostacoli e imprevisti, che metteranno in pericolo la vita di tutti. Scontri a fuoco e assalti esplosivi, che i due protagonisti dovranno sapere affrontare e combattere per proteggere e portare a destinazione sane e salve tutte le persone che stanno scortando...","language":"it-IT"},"tagline":{"value":"C'è un piano. Solo che non sanno quale sia.","language":"it-IT"},"releaseDate":"2023-07-06","status":"Released","rating":6.9,"ratingCount":1117,"genres":["Azione","Commedia","Thriller","Avventura"],"countries":["China","United States of America","Thailand"],"facts":{"Runtime":"103m"},"keywords":[],"networks":[],"socialLinks":{},"cast":[{"id":18897,"name":"Jackie Chan","role":"Dragon Luo","profile":"https://image.tmdb.org/t/p/original/nraZoTzwJQPHspAVsKfgl3RXKKa.jpg"},{"id":56446,"name":"John Cena","role":"Chris","profile":"https://image.tmdb.org/t/p/original/rgB2eIOt7WyQjdgJCOuESdDlrjg.jpg"},{"id":90060,"name":"Pilou Asbæk","role":"Paddock","profile":"https://image.tmdb.org/t/p/original/hUJAtjbYG7rqm54aoWtNWeeKjTY.jpg"},{"id":1477428,"name":"Amadeus Seraf