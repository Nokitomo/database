väliset palkkasoturit. Kasvottoman kostajan haastaessa kasvotonta korporaatiota alkavat molempien naamiot rakoilla. kukaan ei peräänny: totuuden hetki on nyt. Ensimmäinen suomalainen supersankarielokuva RENDEL perustuu ohjaajan, mikkeliläisen Jesse Haajan, luomaan sarjakuvahahmoon.","tagline":"Revenge"}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/puykxZOeeKjJjOqohTK3AwU8aWZ.jpg","background":"https://image.tmdb.org/t/p/original/tjo48bBTRicg4331EWMe1BWKZY8.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":397852,"type":"movie","originalLanguage":"fi-FI","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/puykxZOeeKjJjOqohTK3AwU8aWZ.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/puykxZOeeKjJjOqohTK3AwU8aWZ.jpg","language":"it","width":2000,"height":3000},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/puykxZOeeKjJjOqohTK3AwU8aWZ.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/puykxZOeeKjJjOqohTK3AwU8aWZ.jpg","language":"it","width":2000,"height":3000},{"type":"poster","url":"https://image.tmdb.org/t/p/original/xbcXKei4ezF0Y74KFBpGHtKKPMp.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/xbcXKei4ezF0Y74KFBpGHtKKPMp.jpg","language":"it","width":500,"height":750}]},"en":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/tZiNrIRYblaJZE9m0M80IU1E2zP.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/tZiNrIRYblaJZE9m0M80IU1E2zP.jpg","language":"en","width":960,"height":1440},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/tZiNrIRYblaJZE9m0M80IU1E2zP.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/tZiNrIRYblaJZE9m0M80IU1E2zP.jpg","language":"en","width":960,"height":1440}]},"fi":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/89Ra4YuPxPDGKfbgArDz1u4BDu4.jpg","previ