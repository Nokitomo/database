inungen äußern, sondern muss für immer die schöne junge Kaiserin bleiben. Um dieser Erwartung zu entsprechen, hält sie an einem rigiden Plan aus Hungern, Sport, Frisieren und täglichen Messungen der Taille fest"}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/cEo47Epl7CCF7z9JnC68KXg3ec5.jpg","background":"https://image.tmdb.org/t/p/original/p9R163gjE6Z5g4eWY1qnvU4vbW2.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":888321,"type":"movie","originalLanguage":"de-DE","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/cEo47Epl7CCF7z9JnC68KXg3ec5.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/cEo47Epl7CCF7z9JnC68KXg3ec5.jpg","language":"it","width":1200,"height":1800},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/cEo47Epl7CCF7z9JnC68KXg3ec5.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/cEo47Epl7CCF7z9JnC68KXg3ec5.jpg","language":"it","width":1200,"height":1800},{"type":"poster","url":"https://image.tmdb.org/t/p/original/o2vOfOz7XCKMJcEHwd4x4Y9PirU.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/o2vOfOz7XCKMJcEHwd4x4Y9PirU.jpg","language":"it","width":1667,"height":2500},{"type":"poster","url":"https://image.tmdb.org/t/p/original/gQKXC1wcZGx1HdZKOOUSOpxVDkN.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/gQKXC1wcZGx1HdZKOOUSOpxVDkN.jpg","language":"it","width":1200,"height":1800},{"type":"poster","url":"https://image.tmdb.org/t/p/original/zo7B0a8h1pjkyUfLOsAdYTcEr3z.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/zo7B0a8h1pjkyUfLOsAdYTcEr3z.jpg","language":"it","width":1400,"height":2100}]},"en":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/bhS9oqoJdMSoejB8keZpg9G5uVC.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/bhS9oqoJdMSoejB8keZpg9G5uVC.jpg","language":"en","width":2000,"height":3000},"candidates":[{"type":"po