o"},{"id":2470550,"name":"Andrea Di Bari","role":"Rosanna's Fascist Cousin"},{"id":2666221,"name":"Giuseppe Furia","role":"Requiem"},{"id":12773,"name":"Graziella Galvani","role":"Signora Migliorati","profile":"https://image.tmdb.org/t/p/original/2DQ7oKEtVaEDewcILSmpgh9hx7L.jpg"},{"id":2666222,"name":"Vinicio Gioli","role":"Belindia's Father"},{"id":33608,"name":"Evelina Gori","role":"Old Peasant Woman","profile":"https://image.tmdb.org/t/p/original/XOBozygTE94ERu1gMH0m47Zl0W.jpg"},{"id":2666224,"name":"Antonella Guidelli","role":"Renata"},{"id":1858659,"name":"Mirio Guidelli","role":"Duilio"},{"id":2666226,"name":"Giuseppe Lo Parco","role":"Fascist"},{"id":1335232,"name":"Norma Martelli","role":"Ivana"},{"id":2666228,"name":"Rinaldo Mirannalti","role":"Attorney Migliorati"},{"id":1203766,"name":"Mauro Monni","role":"Dante"},{"id":1203765,"name":"Walter Pardini","role":"Fascist"},{"id":1883069,"name":"Franco Piacentini","role":"Nicola's Father"},{"id":2666230,"name":"Roberta Pinzauti","role":"Old Peasant Woman's Niece"},{"id":51637,"name":"Antonio Prester","role":"Tuminello","profile":"https://image.tmdb.org/t/p/original/z8wGJL9bCiHrXi31zvmcngZP5S5.jpg"},{"id":2666231,"name":"Paolo Ricchi","role":"Singing German"},{"id":240266,"name":"David Riondino","role":"Giglioli","profile":"https://image.tmdb.org/t/p/original/4o7eOOsh102PyM7ESSsIT1XKwnI.jpg"},{"id":1875247,"name":"Gianfranco Salemi","role":"Man in the Bus","profile":"https://image.tmdb.org/t/p/original/k5u4uOwlQthywWywArEBHPRwavT.jpg"},{"id":2626302,"name":"Maria Toesca","role":"Rosanna's Friend"},{"id":1274557,"name":"Daniele Trambusti","role":"Fascist","profile":"https://image.tmdb.org/t/p/original/3rIH8hPS7gv7bQQH5V3maPmT33d.jpg"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","title":"La notte di San Lorenzo","overview":"La notte di San Lorenzo è quella del 10 agosto, quando le stelle cadono e si esprimono i desideri. La vicenda si snoda attorno a questo giorno e i fatti narrati sono realmente accaduti: gli stessi autori ne sono stati protagonisti durante l'infanzia. Siamo nel 1944, e la cittadina toscana di San Miniato è occupata dai tedeschi in vena di rappresaglie; un gruppo di contadini si mette in marcia per sfuggire all'accerchiamento. Nonostante l'atrocità della guerra, il racconto è visto con gli occhi sognanti dei bambini, mentre i paesaggi della campagna toscana rivestono un' importanza fondamentale nell'articolarsi della vicenda. Il film ottenne molti riconoscimenti, tra cui il gran premio della giuria a Cannes."},{"language":"en-US","title":"The Night of the Shooting Stars","overview":"The Night of San Lorenzo, the night of the shooting stars, is the night when dreams come true in Italian folklore. In 1944, a group of Italians flee their town after hearing rumours that the Nazis plan to blow it up and that the Americans are about to arrive to liberate them."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/1Y7QbJVL6vEHm32BGDoAZvXwq0P.jpg","background":"https://image.tmdb.org/t/p/original/oWtUJSIfN4umPrwiHwawhMuDZlL.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":42130,"type":"movie","originalLanguage":"it-IT","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/1Y7QbJVL6vEHm32BGDoAZvXwq0P.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/1Y7QbJVL6vEHm32BGDoAZvXwq0P.jpg","language":"it","width":682,"height":1000},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/1Y7QbJVL6vEHm32BGDoAZvXwq0P.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/1Y7QbJVL6vEHm32BGDoAZvXwq0P.jpg","language":"it","width":682,"height":1000},{"type":"poster","url":"https://image.tmdb.org/t/p/original/rzH9zhwVaZBBJDaYWOyno4qmkE4.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/rzH9zhwVaZBBJDaYWOyno4qmkE4.jpg","language":"it","width":800,"height":120