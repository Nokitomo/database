":6,"numberOfSeasons":1,"genres":["Dramma","Commedia"],"countries":["Spain","United States of America"],"facts":{"Runtime":"44m"},"keywords":[],"networks":[{"id":2552,"name":"Apple TV","logo":"https://image.tmdb.org/t/p/original/bngHRFi794mnMq34gfVcm9nDxN1.png"}],"socialLinks":{},"cast":[{"id":52605,"name":"Eva Longoria","role":"Gala Scott","profile":"https://image.tmdb.org/t/p/original/1u26GLWK1DE7gBugyI9P3OMFq4A.jpg"},{"id":34065,"name":"Santiago Cabrera","role":"Amat","profile":"https://image.tmdb.org/t/p/original/ig1nyOlNKXsRy8xggYPLMcohpJA.jpg"},{"id":4666978,"name":"Victoria Bazúa","role":"Kate","profile":"https://image.tmdb.org/t/p/original/sx3qTodeoacBCP8pSeYGVhzvEyN.jpg"},{"id":2744,"name":"Carmen Maura","role":"Julia","profile":"https://image.tmdb.org/t/p/original/sXvr7BvxscBkYpGTcYjpqbzkUSH.jpg"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","title":"Tierra de mujeres - Intrecci di vite","overview":"Gala (Eva Longoria) è una newyorkese, amante della vita mondana, in fuga in una pittoresca cittadina spagnola con sua madre e sua figlia. La nuova vita di Gala la porta in un'azienda vinicola, dove ne incontra il proprietario, sfacciato ma affascinate, e dove dovrà fare i conti con una serie di segreti di famiglia.","tagline":"Il posto perfetto per una fuga dal mondo."},{"language":"en-US","title":"Land of Women","overview":"Gala is a New York City socialite on the run in a quaint Spanish town with her mother and daughter. Gala's new life brings her into the path of a brash but charming winery owner—and a deep well of family secrets.","tagline":"The perfect place to make your escape."},{"language":"es-ES","overview":"Una mujer neoyorquina se ve obligada a escapar con su madre y su hija al mismo pueblo vinícola de Cataluña del que su madre huyó hace 50 años, y al que juró no volver jamás. Las tres buscan comenzar de nuevo y esperan que sus identidades permanezcan anónimas, pero los cotilleos se propagan rápida