sEGYC8AS3PLJldtgGdc.jpg"},{"id":2192242,"name":"Lorenzo Frediani","role":"Nicola","profile":"https://image.tmdb.org/t/p/original/bxuUgzoLvn3NOrUc4L6aMpxnHS9.jpg"},{"id":2238810,"name":"Martina Sammarco","role":"Sabra","profile":"https://image.tmdb.org/t/p/original/s8AhTBKBOA6KuSDbtelgKP7xIjs.jpg"},{"id":129576,"name":"Fabio Traversa","role":"Portiere"},{"id":3125589,"name":"Natalia Lungu","role":"Irina","profile":"https://image.tmdb.org/t/p/original/33SGyxsAaIG7v4HKY0EUYkttu3R.jpg"},{"id":2078024,"name":"Leonardo Maddalena","role":"Zio"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","overview":"Il mondo là fuori è bloccato da una pandemia, e in lockdown un appartamento a Roma diventa lo stesso di Milano, Napoli, Parigi e New York. Ognuno vive una storia identica a tutti gli altri e allo stesso tempo unica e personale. Ma questo è un film su un altro virus, ben più pericoloso, che si nasconde nella natura umana. Quattro ragazzi sotto i trent'anni condividono un appartamento da tempo e, fermati dal contagio, si trovano ad affrontare ombre più grandi che vivere in quella situazione. L’occasione per fare dei soldi facili a scapito del loro equivoco padrone di casa porterà il film a un crescendo di tensione e delirio. Le scelte e le azioni dei ragazzi diventeranno sempre più ambigue mentre le conseguenze sconvolgeranno i loro sogni e speranze, paure e amori, fino al finale inaspettato di questa commedia molto nera o di questa tragedia molto brillante."},{"language":"en-US","title":"#Stayhome","overview":"The world out there is halted by a pandemic, and during lockdown, an apartment in Rome becomes the same as one in Milan, Naples, Paris, and New York. Each one lives a story identical to all the others, yet unique and personal. Four young people under thirty have been sharing an apartment for some time and, stopped by the infection, find themselves facing shadows bigger than living there. The opportunity to make some easy money at the expense of their shady landlord will lead to a crescendo of tension and delirium. The young people's choices and actions will become increasingly ambiguous as the consequences upend their dreams and hopes, fears and loves, until the unexpected ending."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/5eIsRMO9BYkNH8Z6Eg6QiLKlyYF.jpg","background":"https://image.tmdb.org/t/p/original/A8gqlCbY7pfuVe28Y4LMtOJHB5a.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":798200,"type":"movie","originalLanguage":"it-IT","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/5eIsRMO9BYkNH8Z6Eg6QiLKlyYF.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/5eIsRMO9BYkNH8Z6Eg6QiLKlyYF.jpg","language":"it","width":2000,"height":3000},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/5eIsRMO9BYkNH8Z6Eg6QiLKlyYF.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/5eIsRMO9BYkNH8Z6Eg6QiLKlyYF.jpg","language":"it","width":2000,"height":3000}]},"en":{"status":"missing","candidates":[]},"xx":{"status":"missing","candidates":[]}},"background":{"it":{"status":"available","selected":{"type":"backdrop","url":"https://image.tmdb.org/t/p/original/hEK6lHPSIUAUXgq0B99PvFraxUY.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/hEK6lHPSIUAUXgq0B99PvFraxUY.jpg","language":"it","width":1280,"height":720},"candidates":[{"type":"backdrop","url":"https://image.tmdb.org/t/p/original/hEK6lHPSIUAUXgq0B99PvFraxUY.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/hEK6lHPSIUAUXgq0B99PvFraxUY.jpg","language":"it","width":1280,"height":720}]},"en":{"status":"missing","candidates":[]},"xx":{"status":"available","selected":{"type":"backdrop","url":"https://image.tmdb.org/t/p/original/A8gqlCbY7pfuVe28Y4LMtOJHB5a.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/A8gqlCbY7pfuVe28Y4LMtOJHB5a.jpg","language":"xx","width":3000,"