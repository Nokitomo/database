al/41UnzzXQWEe1CX5DuIeJvIoeegL.jpg"},{"id":2957524,"name":"Michael Lanuto","role":"Bank Patron / Street Pedestrian (uncredited)"},{"id":1033099,"name":"Pete Macnamara","role":"Irate Pedestrian (uncredited)","profile":"https://image.tmdb.org/t/p/original/wlDFiHQjLj9nuchuzlMv11m4QKS.jpg"},{"id":1360008,"name":"Joseph Oliveira","role":"Road Driver (uncredited)"},{"id":2295321,"name":"David C. Roehm Sr.","role":"Defendant in Custody (uncredited)","profile":"https://image.tmdb.org/t/p/original/mU91v7wioOz0S83z8OXrErtSmP6.jpg"},{"id":2916538,"name":"Sam Rovin","role":"Paralegal (uncredited)"},{"id":1453555,"name":"John H. Tobin","role":"AA Attendee (uncredited)","profile":"https://image.tmdb.org/t/p/original/yocYOqgL21GcEBPOHyiQBdFMCFn.jpg"},{"id":2957529,"name":"Jarred Treiber","role":"Park Avenue Businessman (uncredited)"},{"id":2562506,"name":"David Von Roehm","role":"Courtroom Observer (uncredited)"},{"id":1368459,"name":"Ray Wineteer","role":"Parishioner (uncredited)"},{"id":2543806,"name":"Waneeki Yokomee-Fung","role":"Tourist (uncredited)"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","title":"Ipotesi di reato","overview":"Un banale incidente stradale, nel giro convulso di una giornata, cambia la vita a due uomini tanto diversi fra loro, ma entrambi sull'orlo della disperazione. Il primo è Gavin Banek, un giovane avvocato in ritardo per un processo importantissimo, che cerca di farsi largo nel caotico traffico di New York. Il secondo invece è Doyle Gipson, un assicuratore ex alcolizzato e da poco divorziato, che sta tentando disperatamente di raggiungere il giudice che deve decidere del diritto di vedere i suoi figli. Nel turbine delle loro preoccupazioni, nel caos delle strade di Manhattan, le loro auto si urtano. I due sconosciuti, apparentemente innocui, trasportati dagli eventi, reagiranno in modo fuori misura e completamente irrazionale. In gara contro il tempo, i due sono disposti, pur di non lasciarsi sfuggire quello che gli stanno strappando - la carriera a Gavin e i figli a Doyle - a una guerra senza esclusione di colpi. Si trasformano in uomini senza pietà, ma provano lo stesso dolore...","tagline":"Quando la strada del successo incrocia quella della vendetta"},{"language":"en-US","overview":"A rush-hour fender-bender on New York City's crowded FDR Drive, under most circumstances, wouldn't set off a chain reaction that could decimate two people's lives. But on this day, at this time, a minor collision will turn two complete strangers into vicious adversaries. Their means of destroying each other might be different, but their goals, ultimately, will be the same: Each will systematically try to dismantle the other's life in a reckless effort to reclaim something he has lost.","tagline":"One wrong turn deserves another."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/j1YICeubS78KroICxrcplSPKcb.jpg","background":"https://image.tmdb.org/t/p/original/lCPOmWoqtmVrI2yUNUw8iaOaTJn.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":1537,"type":"movie","originalLanguage":"en-US","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/j1YICeubS78KroICxrcplSPKcb.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/j1YICeubS78KroICxrcplSPKcb.jpg","language":"it","width":2000,"height":3000},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/j1YICeubS78KroICxrcplSPKcb.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/j1YICeubS78KroICxrcplSPKcb.jpg","language":"it","width":2000,"height":3000},{"type":"poster","url":"https://image.tmdb.org/t/p/original/yHe3ys2LNMjsDLAIEhH1VbVCmU8.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/yHe3ys2LNMjsDLAIEhH1VbVCmU8.jpg","language":"it","width":620,"height":930},{"type":"poster","url":"https://image.tmdb.org/t/p/original/2DtP68VX6FP8e252DHPMZtEJ1no.jpg","previewU