太はキューとミューと名付けて見守るが、やがて恐竜を育てていくのが困難になる。彼らを元の時代に返すことにしたのび太は、ドラえもんや友人たちと一緒に6,600万年前の白亜紀へ旅立つ。","tagline":"ハロー！ 新のび太。"}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/qZQWW3HmHeV5kjyJS13aP9KdqHK.jpg","background":"https://image.tmdb.org/t/p/original/9aWXBrBe9ZnejsgGvDuN70prKEG.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":682153,"type":"movie","originalLanguage":"ja-JP","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/qZQWW3HmHeV5kjyJS13aP9KdqHK.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/qZQWW3HmHeV5kjyJS13aP9KdqHK.jpg","language":"it","width":733,"height":1100},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/qZQWW3HmHeV5kjyJS13aP9KdqHK.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/qZQWW3HmHeV5kjyJS13aP9KdqHK.jpg","language":"it","width":733,"height":1100}]},"en":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/wxCZmXRJa8hSv1Tpih8TBSR4o6b.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/wxCZmXRJa8hSv1Tpih8TBSR4o6b.jpg","language":"en","width":1999,"height":3000},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/wxCZmXRJa8hSv1Tpih8TBSR4o6b.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/wxCZmXRJa8hSv1Tpih8TBSR4o6b.jpg","language":"en","width":1999,"height":3000},{"type":"poster","url":"https://image.tmdb.org/t/p/original/59PEKeJt2tvLZw8rLaY3YbB1ted.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/59PEKeJt2tvLZw8rLaY3YbB1ted.jpg","language":"en","width":850,"height":1270}]},"ja":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/l0Vxil256XR87HkA2CWNwlbHGdz.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/l0Vxil256XR87HkA2CWNwlbHGdz.jpg","language":"ja","width":2000,"height":3000},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/origina