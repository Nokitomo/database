vinced that her son is still alive thanks to the heart now beating in the professor's chest?"}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/uURf3YoA8W3yTyD3DwduWdPcZkZ.jpg","background":"https://image.tmdb.org/t/p/original/zAGiEDpt7dGqEDZJ4byJMYJa8b.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":776325,"type":"movie","originalLanguage":"it-IT","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/uURf3YoA8W3yTyD3DwduWdPcZkZ.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/uURf3YoA8W3yTyD3DwduWdPcZkZ.jpg","language":"it","width":2000,"height":3000},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/uURf3YoA8W3yTyD3DwduWdPcZkZ.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/uURf3YoA8W3yTyD3DwduWdPcZkZ.jpg","language":"it","width":2000,"height":3000},{"type":"poster","url":"https://image.tmdb.org/t/p/original/rL7CYiVgk5G8ahp4rGOVSA5XFkC.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/rL7CYiVgk5G8ahp4rGOVSA5XFkC.jpg","language":"it","width":612,"height":918}]},"en":{"status":"missing","candidates":[]},"xx":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/zb408vAYO5tgrpqt2m8wJNxalle.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/zb408vAYO5tgrpqt2m8wJNxalle.jpg","language":"xx","width":682,"height":1024},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/zb408vAYO5tgrpqt2m8wJNxalle.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/zb408vAYO5tgrpqt2m8wJNxalle.jpg","language":"xx","width":682,"height":1024}]}},"background":{"it":{"status":"available","selected":{"type":"backdrop","url":"https://image.tmdb.org/t/p/original/kwyD5EFIFjpow5LWl1VjDRmwTkz.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/kwyD5EFIFjpow5LWl1VjDRmwTkz.jpg","language":"it","width":1280,"height":720},"candidates":[{"type":"backdrop","ur