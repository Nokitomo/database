gas arqueólogos le aceptasen como a uno más, pero siempre acaba liándola: destroza un sarcófago y desata un conjuro que pone en peligro la vida de sus amigos, Momia, Jeff y Belzoni. Con todos en contra y solo ayudado por Sara, Tadeo emprenderá una huida llena de aventuras, que le llevará de México a Chicago y de París a Egipto, para encontrar la manera de acabar con la maldición de la momia."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/qdudsXrNb1qL7cRiQRwfAjvsxNg.jpg","background":"https://image.tmdb.org/t/p/original/tUBN1paMQ1tmVA5Sjy1ZjPWVsiF.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":676701,"type":"movie","originalLanguage":"es-ES","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/qdudsXrNb1qL7cRiQRwfAjvsxNg.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/qdudsXrNb1qL7cRiQRwfAjvsxNg.jpg","language":"it","width":667,"height":1000},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/qdudsXrNb1qL7cRiQRwfAjvsxNg.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/qdudsXrNb1qL7cRiQRwfAjvsxNg.jpg","language":"it","width":667,"height":1000},{"type":"poster","url":"https://image.tmdb.org/t/p/original/7hFy88GRSOs84JTISueZfAexvmI.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/7hFy88GRSOs84JTISueZfAexvmI.jpg","language":"it","width":1000,"height":1500}]},"en":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/jvIVl8zdNSOAJImw1elQEzxStMN.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/jvIVl8zdNSOAJImw1elQEzxStMN.jpg","language":"en","width":1440,"height":2160},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/jvIVl8zdNSOAJImw1elQEzxStMN.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/jvIVl8zdNSOAJImw1elQEzxStMN.jpg","language":"en","width":1440,"height":2160},{"type":"poster","url":"https://image.tmdb.or