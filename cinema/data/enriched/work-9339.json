w today's upper classes actually live."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/mNhi8Xhtu2abtGqLCZqRxKzSVml.jpg","background":"https://image.tmdb.org/t/p/original/xdDnTXhPd7q0gKu6KpDoZ9F3xeC.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":427989,"type":"movie","originalLanguage":"it-IT","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/mNhi8Xhtu2abtGqLCZqRxKzSVml.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/mNhi8Xhtu2abtGqLCZqRxKzSVml.jpg","language":"it","width":2000,"height":3000},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/mNhi8Xhtu2abtGqLCZqRxKzSVml.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/mNhi8Xhtu2abtGqLCZqRxKzSVml.jpg","language":"it","width":2000,"height":3000},{"type":"poster","url":"https://image.tmdb.org/t/p/original/aL4eXfByYC21YChjXB5f5a2j7Bc.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/aL4eXfByYC21YChjXB5f5a2j7Bc.jpg","language":"it","width":1000,"height":1500}]},"en":{"status":"missing","candidates":[]},"xx":{"status":"missing","candidates":[]}},"background":{"it":{"status":"missing","candidates":[]},"en":{"status":"missing","candidates":[]},"xx":{"status":"available","selected":{"type":"backdrop","url":"https://image.tmdb.org/t/p/original/xdDnTXhPd7q0gKu6KpDoZ9F3xeC.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/xdDnTXhPd7q0gKu6KpDoZ9F3xeC.jpg","language":"xx","width":1920,"height":1080},"candidates":[{"type":"backdrop","url":"https://image.tmdb.org/t/p/original/xdDnTXhPd7q0gKu6KpDoZ9F3xeC.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/xdDnTXhPd7q0gKu6KpDoZ9F3xeC.jpg","language":"xx","width":1920,"height":1080},{"type":"backdrop","url":"https://image.tmdb.org/t/p/original/yWvBhH0jed0xClZjrhAEzOAlY8E.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/yWvBhH0jed0xClZjrhAEzOAlY8E.jpg","language":"xx","width":2048,"height":