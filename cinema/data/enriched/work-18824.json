 mystery with the help of Detective Lynwood, and the support of her husband, Jason. With every clue that Jennifer uncovers, she gets closer to either finding the long-missing groom, or uncovering a wedding day murder."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/xae9wfwffK0QQ0VT8nyQkj19RvW.jpg","background":"https://image.tmdb.org/t/p/original/y8YJ0yEFe7hDUcJlXIVJWKh2dRm.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":348630,"type":"movie","originalLanguage":"en-US","series":{"poster":{"it":{"status":"missing","candidates":[]},"en":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/xae9wfwffK0QQ0VT8nyQkj19RvW.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/xae9wfwffK0QQ0VT8nyQkj19RvW.jpg","language":"en","width":2000,"height":3000},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/xae9wfwffK0QQ0VT8nyQkj19RvW.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/xae9wfwffK0QQ0VT8nyQkj19RvW.jpg","language":"en","width":2000,"height":3000},{"type":"poster","url":"https://image.tmdb.org/t/p/original/cLv00qlD93bQL9HlanyroujANwH.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/cLv00qlD93bQL9HlanyroujANwH.jpg","language":"en","width":780,"height":1170}]},"xx":{"status":"missing","candidates":[]}},"background":{"it":{"status":"missing","candidates":[]},"en":{"status":"missing","candidates":[]},"xx":{"status":"available","selected":{"type":"backdrop","url":"https://image.tmdb.org/t/p/original/y8YJ0yEFe7hDUcJlXIVJWKh2dRm.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/y8YJ0yEFe7hDUcJlXIVJWKh2dRm.jpg","language":"xx","width":1920,"height":1080},"candidates":[{"type":"backdrop","url":"https://image.tmdb.org/t/p/original/y8YJ0yEFe7hDUcJlXIVJWKh2dRm.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/y8YJ0yEFe7hDUcJlXIVJWKh2dRm.jpg","language":"xx","width":1920,"height":1080},{"type":"backdrop","url":"https://