il cervello della madre.","language":"it-IT"},"tagline":{"value":"AI Combat Warrior Will be Unleashed.","language":"en-US"},"releaseDate":"2023-01-12","status":"Released","rating":6.07,"ratingCount":712,"genres":["Fantascienza","Azione","Avventura","Dramma"],"countries":["South Korea"],"facts":{"Runtime":"98m"},"keywords":[],"networks":[],"socialLinks":{},"cast":[{"id":560064,"name":"Kang Soo-youn","role":"Seo-hyun","profile":"https://image.tmdb.org/t/p/original/dW8KOz42bI6I5ZtDlGx5AsXlcws.jpg"},{"id":232599,"name":"Kim Hyun-joo","role":"Jung-yi","profile":"https://image.tmdb.org/t/p/original/AeYZSlVauG1BMJdzfyaw3u5jcyA.jpg"},{"id":2239782,"name":"Ryu Kyung-soo","role":"Sang-hoon","profile":"https://image.tmdb.org/t/p/original/4tjiTN3osUTaXE8lFAyK2Sjl8Lw.jpg"},{"id":1299243,"name":"Uhm Ji-won","role":"Se-yeon","profile":"https://image.tmdb.org/t/p/original/icqDRYRw9T99ZIHYCxTUrl0s6aS.jpg"},{"id":2352461,"name":"Lee Dong-hee","role":"Chairman","profile":"https://image.tmdb.org/t/p/original/opSP2ftJrDDFFMVCPmFKUSlK2na.jpg"},{"id":3214227,"name":"Han Woo-yeol","role":"Jae-kyung","profile":"https://image.tmdb.org/t/p/original/fxiZl6AiNyG1cJSYVC7mSEQTjXK.jpg"},{"id":4037322,"name":"Yun Ki-chang","role":"Researcher 1","profile":"https://image.tmdb.org/t/p/original/oY4ndQi0vvVoypehy9Yq8KFo4fS.jpg"},{"id":3172983,"name":"Lee Ga-kyung","role":"Researcher 2","profile":"https://image.tmdb.org/t/p/original/gIVjKUM88FhrDSKLMJ5QdxJ6xUm.jpg"},{"id":2097710,"name":"Shin Min-jae","role":"Researcher 3","profile":"https://image.tmdb.org/t/p/original/rTnK1g6ZCGab4qd0iN6uIwyTGsT.jpg"},{"id":4939806,"name":"Kim Sun-hyuk","role":"Researcher 5 / Voice over the Radio (voice)","profile":"https://image.tmdb.org/t/p/original/x7ktlZPukS8A5TRiF8bSQYvou1g.jpg"},{"id":3003869,"name":"Lee Hyun-kyun","role":"Doctor","profile":"https://image.tmdb.org/t/p/original/hxKnznyiPGFM7AuXwCcWBdORLBo.jpg"},{"id":2644771,"name":"Park So-i","role":"Young Seo-hyun","profile":"https://image.tmdb.org/t/p/original/7