ement tenaces: une ex-petite amie alsacienne qui s'accroche, un brigadier de police maniaco-depressif, un drogué en manque, une ravissante Cubaine en quête de papiers et bien d'autres encore qui vont tout faire pour empêcher son entreprise de séduction."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/7MyDVywaF6OcBSmPOUuhjbxI44i.jpg","background":"https://image.tmdb.org/t/p/original/rLiHrIoUbsBm6SgImA8JF244VEv.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":35818,"type":"movie","originalLanguage":"fr-FR","series":{"poster":{"it":{"status":"missing","candidates":[]},"en":{"status":"missing","candidates":[]},"fr":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/7MyDVywaF6OcBSmPOUuhjbxI44i.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/7MyDVywaF6OcBSmPOUuhjbxI44i.jpg","language":"fr","width":960,"height":1440},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/7MyDVywaF6OcBSmPOUuhjbxI44i.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/7MyDVywaF6OcBSmPOUuhjbxI44i.jpg","language":"fr","width":960,"height":1440},{"type":"poster","url":"https://image.tmdb.org/t/p/original/gaG3BCgoi476JG5zQn6ZdaXuTGD.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/gaG3BCgoi476JG5zQn6ZdaXuTGD.jpg","language":"fr","width":1000,"height":1500},{"type":"poster","url":"https://image.tmdb.org/t/p/original/opFRqTUbF1RUPI78jGlwTXowSwq.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/opFRqTUbF1RUPI78jGlwTXowSwq.jpg","language":"fr","width":600,"height":900},{"type":"poster","url":"https://image.tmdb.org/t/p/original/9xYY18GnpQnXeHrtFq365M2o2Vk.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/9xYY18GnpQnXeHrtFq365M2o2Vk.jpg","language":"fr","width":1000,"height":1500}]},"xx":{"status":"missing","candidates":[]}},"background":{"it":{"status":"missing","candidates":[]},"en":{"status":"missing","candidates":[]},"fr":{"status":"