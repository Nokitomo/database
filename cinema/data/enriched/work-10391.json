":[],"episodeGroups":[],"translations":[{"language":"it-IT","title":"Uccidete la colomba bianca","overview":"Mentre nei dintorni di Berlino si svolge un incontro diplomatico russo-americano ad alto livello - preparatorio di un vertice indetto a Chicago fra il Presidente degli Stati Uniti ed il Segretario generale del Partito Comunista Sovietico - in un attentato terroristico muoiono due ufficiali americani. Il sergente Johnny Gallagher, che comandava una pattuglia di sorveglianza, tacciato di negligenza, viene rispedito in Patria per scortare Walter Henke, un militare deferito alla Corte marziale. A Chicago, però, il sergente viene duramente pestato nella toilette dell'aeroporto ed un gruppetto di uomini fa sparire il suo sorvegliato...","tagline":"È un uomo che corre contro il tempo per fermare la cospirazione più esplosiva della storia."},{"language":"en-US","overview":"Experienced Green Beret sergeant Johnny Gallagher is escorting a prisoner, Airborne Ranger Thomas Boyette, back to the US, but Boyette escapes and Gallagher must risk life and limb to catch him.","tagline":"He's one man racing against time to stop the most explosive conspiracy in history."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/8bEumEJHGZTg7DTm73jUV4pRoQ.jpg","background":"https://image.tmdb.org/t/p/original/5P3EeDAzFPScaDx0IAJbPJJxWOW.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":31606,"type":"movie","originalLanguage":"en-US","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/8bEumEJHGZTg7DTm73jUV4pRoQ.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/8bEumEJHGZTg7DTm73jUV4pRoQ.jpg","language":"it","width":609,"height":914},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/8bEumEJHGZTg7DTm73jUV4pRoQ.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/8bEumEJHGZTg7DTm73jUV4pRoQ.jpg","language":"it","