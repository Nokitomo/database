iaggio porterà a risultati inaspettati, mettendo a dura prova la sua fedeltà.","language":"it-IT"},"releaseDate":"2021-05-13","status":"Released","rating":6.8,"ratingCount":307,"genres":["Crime","Dramma","Azione"],"countries":["Belgium"],"facts":{"Runtime":"106m"},"keywords":[],"networks":[],"socialLinks":{},"cast":[{"id":43643,"name":"Frank Lammers","role":"Ferry Bouman","profile":"https://image.tmdb.org/t/p/original/rGIikThUCilyt8rgHkeJAxxEhCO.jpg"},{"id":87678,"name":"Elise Schaap","role":"Danielle van Marken","profile":"https://image.tmdb.org/t/p/original/oaZZ5qgkGrZAxhrjDJ3y6vzk3f8.jpg"},{"id":1854,"name":"Huub Stapel","role":"Ralph Brink","profile":"https://image.tmdb.org/t/p/original/Ar41d7m6EA9eHGc7sMYTligjA77.jpg"},{"id":41356,"name":"Monic Hendrickx","role":"Claudia Bouman","profile":"https://image.tmdb.org/t/p/original/e8wYKDH0LNMyjrl8533p9y2kOj4.jpg"},{"id":83357,"name":"Raymond Thiry","role":"John Zwart","profile":"https://image.tmdb.org/t/p/original/eta0sCxA0bTJMIVxkIYFVdwe47S.jpg"},{"id":570351,"name":"Maarten Heijmans","role":"Rico","profile":"https://image.tmdb.org/t/p/original/1ykcid5vioZL2GnqepKv6Cp2k49.jpg"},{"id":82453,"name":"Yannick van de Velde","role":"Lars van Marken","profile":"https://image.tmdb.org/t/p/original/b9YkwfRHbXNVS6Mzec3u6HV8vBJ.jpg"},{"id":1655917,"name":"Olaf Ait Tami","role":"Robbert","profile":"https://image.tmdb.org/t/p/original/mX4gXHoLjAvuPyeeOdBM6IlD3Dy.jpg"},{"id":1102349,"name":"Juliette van Ardenne","role":"Keesje Bouman","profile":"https://image.tmdb.org/t/p/original/3NrqkQC4utT2PJW3zpRt83JiIBi.jpg"},{"id":1388974,"name":"Bob Stoop","role":"Jack Bouman","profile":"https://image.tmdb.org/t/p/original/jyRtXKjCY94iO2wPVClVlHvOOKj.jpg"},{"id":1258936,"name":"Tim Linde","role":"Matthijs Brink","profile":"https://image.tmdb.org/t/p/original/kVQICLowRKRedu1VGn9sClwCv4G.jpg"},{"id":1272048,"name":"Adison dos Reis","role":"Olav"},{"id":1367205,"name":"Mike Weerts","role":"Jason Kant","profile":"https://image.tmdb.org/t/p/ori