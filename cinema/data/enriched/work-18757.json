uono cinquantacinque giorni di speranza, paura, trattative, fallimenti, buone intenzioni e cattive azioni."},{"id":158165,"translatable_type":"title","translatable_id":9580,"locale":"it","key":"release_date","value":"2022-11-14"},{"id":158164,"translatable_type":"title","translatable_id":9580,"locale":"it","key":"slug","value":"esterno-notte"},{"id":79491,"translatable_type":"title","translatable_id":9580,"locale":"it","key":"views","value":"25266"}],"keywords":[{"id":524,"name":"vatican","created_at":"2023-05-18T11:51:18.000000Z","updated_at":"2023-05-18T11:51:18.000000Z","pivot":{"title_id":9580,"keyword_id":524}},{"id":944,"name":"terrorism","created_at":"2023-05-18T11:53:09.000000Z","updated_at":"2023-05-18T11:53:09.000000Z","pivot":{"title_id":9580,"keyword_id":944}},{"id":2436,"name":"italian history","created_at":"2023-05-18T12:00:55.000000Z","updated_at":"2023-05-18T12:00:55.000000Z","pivot":{"title_id":9580,"keyword_id":2436}},{"id":12136,"name":"red brigade","created_at":"2024-08-16T09:20:03.000000Z","updated_at":"2024-08-16T09:20:03.000000Z","pivot":{"title_id":9580,"keyword_id":12136}}]}}]},"images":[{"id":129073,"filename":"15aafb1b-ee3a-4a14-8a13-24aa7fd98438.webp","type":"poster","lang":"it","imageable_type":"title","imageable_id":9580,"created_at":"2024-08-16T09:20:04.000000Z","updated_at":"2025-05-12T09:25:15.000000Z","original_url_field":null,"reference":{"base":"streamingunity:images","path":"/images/15aafb1b-ee3a-4a14-8a13-24aa7fd98438.webp"},"provider":"streamingunity"},{"id":129074,"filename":"aab0bbc1-05f2-4804-a662-08df62e56c93.webp","type":"cover","lang":"it","imageable_type":"title","imageable_id":9580,"created_at":"2024-08-16T09:20:04.000000Z","updated_at":"2025-05-12T09:25:15.000000Z","original_url_field":null,"reference":{"base":"streamingunity:images","path":"/images/aab0bbc1-05f2-4804-a662-08df62e56c93.webp"},"provider":"streamingunity"},{"id":129072,"filename":"a920dd1e-6fb3-4259-8003-b7789e4082cf.webp","type":"background","lang":null