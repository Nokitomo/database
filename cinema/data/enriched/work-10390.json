er_mobile","lang":"it","imageable_type":"title","imageable_id":49049,"created_at":"2025-12-27T12:58:47.000000Z","updated_at":"2025-12-27T12:58:47.000000Z","original_url_field":null,"reference":{"base":"streamingunity:images","path":"/images/d2c46091-7d16-4d9e-ada4-947445d54d29.webp"},"provider":"streamingunity"}],"episodeMappingUncertain":false,"seasons":[],"provenance":{},"warnings":[],"externalIdsEvidence":{"wikidata":{"source":"wikidata","sourceUrl":"https://www.wikidata.org/wiki/Q1194413","wikidataId":"Q1194413","tmdbId":31542,"type":"movie","imdbId":"tt0077138","tvdbId":18737}},"externalMedia":{"tmdb":{"source":"tmdb-api","id":31542,"type":"movie","sourceUrl":"https://www.themoviedb.org/movie/31542","fetchedAt":"2026-11-07T16:20:38.806Z","originalLanguage":"it-IT","title":{"value":"The Tree of Wooden Clogs","language":"en-US"},"originalTitle":"L'albero degli zoccoli","overview":{"value":"La casa, le stalle, la terra, gli alberi, parte del bestiame e degli attrezzi appartenevano al padrone e a lui si dovevano due parti su tre del raccolto. Dall'autunno alla primavera, quando il lavoro dei campi concedeva respiro riprendevano le vicende degli uomini coi loro sentimenti, le loro paure, le speranze, sia nelle cose di ogni giorno, che negli avvenimenti più importanti e attesi, come la nascita di un bambino, un matrimonio o la festa del paese. La vita era povera e tutto questo acquistava valore e significato. Nulla andava perduto: tutto poteva essere utile al corpo e all'anima. Ma a volte la volontà del padrone poteva portare via tutto, come una stagione maligna.","language":"it-IT"},"tagline":{"value":"La vita raccontata di famiglie contadine.","language":"it-IT"},"releaseDate":"1978-09-21","status":"Released","rating":7.632,"ratingCount":243,"genres":["Dramma"],"countries":["Italy"],"facts":{"Runtime":"170m"},"keywords":[],"networks":[],"socialLinks":{},"cast":[{"id":1037917,"name":"Luigi Ornaghi","role":"Batistì"},{"id":1037918,"name":"Francesca Moriggi","role":"Batistina"},{"id":1037919,"name":"Omar Brignoli","role":"Minec"},{"id":1037920,"name":"Antonio Ferrari","role":"Tuni"},{"id":1037921,"name":"Teresa Brescianini","role":"Widow Runk"},{"id":1037922,"name":"Giuseppe Brignoli","role":"Anselmo"},{"id":2623590,"name":"Carlo Rota","role":"Peppino"},{"id":1037923,"name":"Pasqualina Brolis","role":"Teresina"},{"id":1037924,"name":"Massimo Fratus","role":"Pierino"},{"id":1037925,"name":"Francesca Villa","role":"Annetta"},{"id":1037926,"name":"Maria Grazia Caroli","role":"Bettina"},{"id":1037927,"name":"Battista Trevaini","role":"Il Finard"},{"id":1757130,"name":"Giuseppina Langalelli","role":"La Moglie Finarda"},{"id":1757131,"name":"Lorenzo Pedroni","role":"Il Nonno Finard"},{"id":1757132,"name":"Felice Cervi","role":"Uslì"},{"id":1757133,"name":"Pierangelo Bertoli","role":"Secondo"},{"id":1757134,"name":"Brunella Migliaccio","role":"Olga"},{"id":1757135,"name":"Giacomo Cavalleri","role":"Brena"},{"id":1757136,"name":"Lorenza Frigeni","role":"La Moglie di Brena"},{"id":1757137,"name":"Lucia Pezzoli","role":"Maddalena"},{"id":1757138,"name":"Franco Pilenga","role":"Stefano"},{"id":1757139,"name":"Guglielmo Badoni","role":"Father"},{"id":1757140,"name":"Laura Lecatelli","role":"Mother"},{"id":1757141,"name":"Carmelo Silva","role":"Don Carlo"},{"id":1757142,"name":"Mario Brignoli","role":"Padrone"},{"id":1757143,"name":"Emilio Pedroni","role":"Fattore"},{"id":1757144,"name":"Vittorio Capelli","role":"Fritz"},{"id":1757145,"name":"Francesca Bassurini","role":"Luca Maria"},{"id":1757146,"name":"Lina Ricci","role":"Donna del Segno"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","overview":"La casa, le stalle, la terra, gli alberi, parte del bestiame e degli attrezzi appartenevano al padrone e a lui si dovevano due parti su tre del raccolto. Dall'autunno alla primavera, quando il lavoro dei campi concedeva respiro riprendevano le vicende degli uomini coi loro sentimenti, le loro paure, le speranze, sia nelle cose di ogni giorno, che negli avvenimenti più importanti e attesi, come la nascita di un bambino, un matrimonio o la festa del paese. La vita era povera e tutto questo acquistava valore e significato. Nulla andava perduto: tutto poteva essere utile al corpo e all'anima. Ma a volte la volontà del padrone poteva portare via tutto, come una stagione maligna.","tagline":"La vita raccontata di famiglie contadine."},{"language":"en-US","title":"The Tree of Wooden Clogs","overview":"On a turn-of-the-20th-century northern Italian farm, a group of sharecroppers eke out a threadbare existence. A priest advises Batisti and his wife Batistina that their young son Minec should be formally educated, so they sacrifice his help in the fields and send him to school. When Minec's wooden shoe breaks one day, Batisti--in an act of desperation--puts the family's future at risk to replace the clog.","tagline":"When the family of man was still—a family."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/tJYP9DsJz5OMboAWj9dm3FRiZQR.jpg","background":"https://image.tmdb.org/t/p/original/viyEqVStJ9bjgyGh71TNMVqOZI.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":31542,"type":"movie","originalLanguage":"it-IT","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/tJYP9DsJz5OMboAWj9dm3FRiZQR.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/tJYP9DsJz5OMboAWj9dm3FRiZQR.jpg","language":"it","width":830,"height":1245},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/tJYP9DsJz5OMboAWj9dm3FRiZQR.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/tJYP9DsJz5OMboAWj9dm3FRiZQR.jpg","language":"it","width":830,"height":1245},{"type":"poster","url":"https://image.tmdb.org/t/p/original/qyDjQ7hAhfYvQR3rfrFrTSi1z93.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/qyDjQ7hAhfYvQR3rfrFrTSi1z93.jpg