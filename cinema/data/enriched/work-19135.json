 san Gennaro, 'a sirena Partenope e molti altri, tra cui l'identità del cantante.","language":"it-IT"},"releaseDate":"2024-05-09","status":"Released","rating":7.4,"ratingCount":29,"genres":["Animazione","Documentario","Musica"],"countries":["Italy"],"facts":{"Runtime":"94m"},"keywords":[],"networks":[],"socialLinks":{},"cast":[{"id":3572361,"name":"Liberato","role":"Self","profile":"https://image.tmdb.org/t/p/original/lBQChqJeW7zWjOsHWlAhsziX6ik.jpg"},{"id":2524808,"name":"Francesco Lettieri","role":"Self","profile":"https://image.tmdb.org/t/p/original/ldASj07FKMMvcZc8kGT5FZNpnNn.jpg"},{"id":3064129,"name":"Francesco Coppola","role":"Self"},{"id":3050573,"name":"Antonella Mignogna","role":"Self"},{"id":4950977,"name":"Cladio Biazzetti","role":"Self"},{"id":4950978,"name":"Cristiano De Majo","role":"Self"},{"id":4950991,"name":"Roby Saitov","role":"Self"},{"id":4950996,"name":"Reggio Saitov","role":"Self"},{"id":3202756,"name":"Adam Jendoubi","role":"Self"},{"id":3144511,"name":"Carlo Pastore","role":"Self","profile":"https://image.tmdb.org/t/p/original/AlQmOW8Wm02UKKwnbZSPNqXhELF.jpg"},{"id":4844650,"name":"Calcutta","role":"Self","profile":"https://image.tmdb.org/t/p/original/AvC3ru0ZIruU37zqeq665nd0RRp.jpg"},{"id":2952455,"name":"Alessandro Elia","role":"Self"},{"id":2680534,"name":"Walter De Majo","role":"Self"},{"id":3177450,"name":"Daniele Del Plavignano","role":"Self"},{"id":1355967,"name":"Simona Tabasco","role":"Lucia (voice)","profile":"https://image.tmdb.org/t/p/original/eHH3kzBwc69E9BvDRCtOEtY1CSc.jpg"},{"id":545137,"name":"Nando Paone","role":"Il nonno (voice)","profile":"https://image.tmdb.org/t/p/original/lUjUffdd1U96r3fGwRHnELoCe8c.jpg"},{"id":4951073,"name":"Antonio Varone","role":"Liberato bambino (voice)"},{"id":4951075,"name":"Michele Serino","role":"Alessio (voice)"},{"id":4951076,"name":"Maikol De Falco","role":"Biagio (voice)"},{"id":4951077,"name":"Alana Sinkey","role":"Athena (voice)"},{"id":3820450,"name":"Marcos Piacentini","role":"Ismael (