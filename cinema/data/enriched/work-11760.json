e individuals that live with him."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/14gtKiG3Xf2J3hziQVHHLVAg2Kx.jpg","background":"https://image.tmdb.org/t/p/original/7Cc0DHioxEX5PutoqvZp2y1rj9p.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":206328,"type":"movie","originalLanguage":"en-US","series":{"poster":{"it":{"status":"missing","candidates":[]},"en":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/14gtKiG3Xf2J3hziQVHHLVAg2Kx.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/14gtKiG3Xf2J3hziQVHHLVAg2Kx.jpg","language":"en","width":724,"height":1080},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/14gtKiG3Xf2J3hziQVHHLVAg2Kx.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/14gtKiG3Xf2J3hziQVHHLVAg2Kx.jpg","language":"en","width":724,"height":1080},{"type":"poster","url":"https://image.tmdb.org/t/p/original/w30KyjYlvi6KJ7Es2UkhGsVmGzy.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/w30KyjYlvi6KJ7Es2UkhGsVmGzy.jpg","language":"en","width":724,"height":1080}]},"xx":{"status":"missing","candidates":[]}},"background":{"it":{"status":"missing","candidates":[]},"en":{"status":"available","selected":{"type":"backdrop","url":"https://image.tmdb.org/t/p/original/ApKta9HW50KNJ5NrHkOYbJPX97c.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/ApKta9HW50KNJ5NrHkOYbJPX97c.jpg","language":"en","width":1920,"height":1080},"candidates":[{"type":"backdrop","url":"https://image.tmdb.org/t/p/original/ApKta9HW50KNJ5NrHkOYbJPX97c.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/ApKta9HW50KNJ5NrHkOYbJPX97c.jpg","language":"en","width":1920,"height":1080},{"type":"backdrop","url":"https://image.tmdb.org/t/p/original/wkMKVfyOMyaKrBtri2OdmHVQ40C.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/wkMKVfyOMyaKrBtri2OdmHVQ40C.jpg","language":"en","width":3840,"height":2160}]},"xx":{"status":"available","selected":{"ty