rnings":[],"externalMedia":{"tmdb":{"source":"tmdb-api","id":73659,"type":"tv","sourceUrl":"https://www.themoviedb.org/tv/73659","fetchedAt":"2026-11-07T10:34:31.486Z","originalLanguage":"ja-JP","title":{"value":"Final Fantasy XIV: Dad of Light","language":"en-US"},"originalTitle":"ファイナルファンタジーXIV 光のお父さん","overview":{"value":"La serie, ispirata ad una storia vera, racconta come il rapporto tra i protagonisti - un padre e suo figlio - sia vengano riallacciati grazie al gioco di ruolo Final Fantasy XIV.","language":"it-IT"},"startDate":"2017-04-17","endDate":"2017-09-01","status":"Ended","rating":7.3,"ratingCount":24,"numberOfEpisodes":8,"numberOfSeasons":1,"genres":["Dramma","Famiglia"],"countries":["Japan"],"facts":{"Runtime":"24m"},"keywords":[],"networks":[{"id":160,"name":"TBS","logo":"https://image.tmdb.org/t/p/original/lUACMATs6jcscXIrzNCQzbvNVN5.png"},{"id":94,"name":"MBS","logo":"https://image.tmdb.org/t/p/original/7RNXnyiMbjgqtPAjja13wchcrGI.png"}],"socialLinks":{},"cast":[{"id":1251345,"name":"Yudai Chiba","role":"Inaba Akio","profile":"https://image.tmdb.org/t/p/original/7RbBbH8QzhVJ5F6vWE5qnxbvXb.jpg"},{"id":137029,"name":"Ren Osugi","role":"Inaba Hirotarou","profile":"https://image.tmdb.org/t/p/original/u02dZDSJdzsiLeqB3mS8FffhXZO.jpg"},{"id":1409121,"name":"Fumika Baba","role":"Shouda Youko","profile":"https://image.tmdb.org/t/p/original/8OMeO92lSLYwvu4VcHKGXnd5FBG.jpg"},{"id":229504,"name":"Hatsunori Hasegawa","role":"Oono Hajime","profile":"https://image.tmdb.org/t/p/original/1A67SVH35pyebs16Cun7bxO9YEA.jpg"},{"id":123851,"name":"Mako Ishino","role":"Inaba Kimiko","profile":"https://image.tmdb.org/t/p/original/3Jf2mYMQfQQucjFFQydGOCTanMC.jpg"},{"id":96569,"name":"Yoshihiko Hakamada","role":"Hakamada Takahiro","profile":"https://image.tmdb.org/t/p/original/5uisJdVeVu5VsRHssOn0s3q5AHv.jpg"},{"id":2301723,"name":"Nao","profile":"https://image.tmdb.org/t/p/original/sctXMVvMId8PMfecbQN8bmHhJtx.jpg"},{"id":1208955,"name":"Masayuki Shida","profile":"https://image.tmdb.org/t/p/original/jEa7PsFEmUuQCk9QUxrQcW6sw23.jpg"},{"id":76165,"name":"Kentarō Shimazu","profile":"https://image.tmdb.org/t/p/original/b9VRItNnqM45kweHf50WfTVU8JO.jpg"},{"id":2722775,"name":"Kosuke Imai","profile":"https://image.tmdb.org/t/p/original/yNHJXujOVDTjbpZ57qe6wbkHbpF.jpg"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","overview":"La serie, ispirata ad una storia vera, racconta come il rapporto tra i protagonisti - un padre e suo figlio - sia vengano riallacciati grazie al gioco di ruolo Final Fantasy XIV."},{"language":"en-US","title":"Final Fantasy XIV: Dad of Light","overview":"A father and son rekindle their bond through the online role-playing game Final Fantasy XIV in this live-action series based on a true story."},{"language":"ja-JP","title":"ファイナルファンタジーXIV 光のお父さん","overview":"ネット上のゲーム仲間たちと共に、MMORPGゲーム『ファイナルファンタジーXIV』を楽しんでいる、ゲーム好きの青年であるハンドルネーム「マイディー」こと稲葉 光生。\n\n光生はある日、仕事熱心だった父親が突然退職したと聞きその心境を案じる。しかし、幼いころに行き違って以来、いつの間にか父子の間では会話がなくなっていた。その悩みを『FFXIV』の仲間（FCメンバー）に相談したところ、ゲーム内に父親を招待したらどうかと提案される。\n\n父親の博太郎が操作するキャラクター「インディ」に、息子であることを隠して近づいてフレンド登録して共に冒険を続け、現実とオンライン上を行き来しながら父親のゲーム攻略をサポートし、攻略終盤のボスを倒した後に正体を明かす……。それは数ヶ月がかりの、壮大なオンライン育成プロジェクトであった。\n\nフレンド達の協力のもと様々な困難を乗り越えて、父・博太郎を『FFXIV』の世界における勇者、「光の戦士」へと鍛え上げていく「光のお父さん計画」が、いま始まるのだった。"}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/mCBJddx5G3lXxKb8mQpPINB7BSJ.jpg","background":"https://image.tmdb.org/t/p/original/rOondMRTXQDQDIvCQ5AaCzcFUe7.jpg","seasons":[{"seasonNumber":1,"name":{"value":"Stagione 1","language":"it-IT"},"year":2017,"episodeCount":8,"poster":"https://image.tmdb.org/t/p/original/3kemOa7AQRXvnqwpmvhQxX6m4P9.jpg","posters":[],"backgrounds":[],"sourceUrl":"https://www.themoviedb.org/tv/73659/season/1"}],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":73659,"type":"tv","originalLanguage":"ja-JP","series":{"poster":{"it":{"status":"missing","candidates":[]},"en"