age.tmdb.org/t/p/original/ieQpL0Hzm6jfcyLQpieq3PPzvJO.jpg"},{"id":137644,"name":"Aleksandr Okunev","role":"Officer","profile":"https://image.tmdb.org/t/p/original/51pdUu8fpRYYgCDBpI3jebI3WQA.jpg"},{"id":83828,"name":"Andres Puustusmaa","role":"Officer","profile":"https://image.tmdb.org/t/p/original/nnnrN8Kh5SRBvtVizvQZG1mYAiG.jpg"},{"id":580832,"name":"Sulev Teppart","role":"Officer","profile":"https://image.tmdb.org/t/p/original/9GH5tZnkXhgUvym1q5IzQCiBlO4.jpg"},{"id":2478078,"name":"Igor Rogatšov","role":"Officer","profile":"https://image.tmdb.org/t/p/original/GRzPGnvlKAa1efXcVfghVSkC4E.jpg"},{"id":3484964,"name":"Ruslan Izmailov","role":"Officer"},{"id":1820151,"name":"Marko Leht","role":"Russian Border Guard","profile":"https://image.tmdb.org/t/p/original/4WmZVY3aAQ6aGkH0WiA4juuVL2m.jpg"},{"id":3229060,"name":"Toomas Täht","role":"Search Crew Leader","profile":"https://image.tmdb.org/t/p/original/Ad1efX8k4e2o82w647b0K48sa5F.jpg"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","title":"Sisu: Il vendicatore","overview":"Tornando alla casa dove la sua famiglia è stata brutalmente assassinata durante la guerra, 'l'uomo che si rifiuta di morire' la smonta, la carica su un camion ed è determinato a ricostruirla in un luogo sicuro in loro onore. Quando il comandante dell'Armata Rossa che ha ucciso la sua famiglia torna determinato a portare a termine il lavoro, ne segue un inseguimento incessante e mozzafiato attraverso il paese — una lotta all'ultimo sangue.","tagline":"Quando gli portarono via la famiglia, si vendicò."},{"language":"en-US","title":"Sisu: Road to Revenge","overview":"Returning to the house where his family was brutally murdered during the war, \"the man who refuses to die\" dismantles it, loads it on a truck, and is determined to rebuild it somewhere safe in their honor. When the commander who killed his family comes back hellbent on finishing the job, a relentless, eye-popping cross-country chase ensues.","tagline":"When they took his family, he took revenge."},{"language":"fi-FI","overview":"“Mies, joka ei suostu kuolemaan” palaa kotikonnuilleen neuvostomiehityksen alaiseen Karjalaan, purkaa talonsa, lastaa sen kuormurin kyytiin ja päättää vakaasti panna pirttinsä taas pystyyn Suomen puolelle. Kun hänen perheensä surmannut puna-armeijan komentaja palaa vimmalla hoitamaan tehtävänsä loppuun, seuraa silmitön takaa-ajo, sarja vauhdikkaita toimintajaksoja halki maiden ja mantujen - taistelu, joka käydään viimeiseen mieheen.","tagline":"Oma kosto kullan kallis"}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/kiNeaEXHkOauCB0jwwYrQV6sU2.jpg","background":"https://image.tmdb.org/t/p/original/dblYnDLvHAjTcjpYgWUEZyNYbqP.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":1223601,"type":"movie","originalLanguage":"fi-FI","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/kiNeaEXHkOauCB0jwwYrQV6sU2.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/kiNeaEXHkOauCB0jwwYrQV6sU2.jpg","language":"it","width":739,"height":985},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/kiNeaEXHkOauCB0jwwYrQV6sU2.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/kiNeaEXHkOauCB0jwwYrQV6sU2.jpg","language":"it","width":739,"height":985},{"type":"poster","url":"https://image.tmdb.org/t/p/original/AlappyUkuauegprVJHfiHXZTBgQ.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/AlappyUkuauegprVJHfiHXZTBgQ.jpg","language":"it","width":1800,"height":2400}]},"en":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/roCMOuMQ55Z2TxVx1vZZTevlo0n.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/roCMOuMQ55Z2TxVx1vZZTevlo0n.jpg","language":"en","width":1331,"height":1996},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/roCMOuMQ55Z2TxVx1vZZTevlo0n.jpg","