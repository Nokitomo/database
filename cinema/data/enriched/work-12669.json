"original_url_field":null,"reference":{"base":"streamingunity:images","path":"/images/864fcba1-1725-440b-ada0-522a940a1a26.webp"},"provider":"streamingunity"}],"episodeMappingUncertain":false,"seasons":[],"provenance":{},"warnings":[],"externalIdsEvidence":{"wikidata":{"source":"wikidata","sourceUrl":"https://www.wikidata.org/wiki/Q651982","wikidataId":"Q651982","tmdbId":833,"type":"movie","imdbId":"tt0045274","tvdbId":2896}},"externalMedia":{"tmdb":{"source":"tmdb-api","id":833,"type":"movie","sourceUrl":"https://www.themoviedb.org/movie/833","fetchedAt":"2026-11-07T22:22:20.195Z","originalLanguage":"it-IT","title":{"value":"Umberto D.","language":"it-IT"},"originalTitle":"Umberto D.","overview":{"value":"Un anziano funzionario ministeriale in pensione non se la passa particolarmente bene dal punto di vista economico e da quello degli affetti. Vive infatti solo, con un cane e la domestica. Le scarse risorse economiche non gli consentono più uno stile di vita consono alla sua cultura e al suo decoro ed è costantemente in ritardo con il pagamento della pigione, come l'arcigna padrona di casa gli sottolinea spesso. In un soprassalto di dignità decide allora di togliersi la vita per non essere più di peso agli altri: sarà però proprio il suo cane a riconciliarlo involontariamente con il mondo....\r .\r Uno dei capolavori del cinema neorealista, e il suo canto del cigno.","language":"it-IT"},"releaseDate":"1952-01-20","status":"Released","rating":7.887,"ratingCount":776,"genres":["Dramma"],"countries":["Italy"],"facts":{"Runtime":"91m"},"keywords":[],"networks":[],"socialLinks":{},"cast":[{"id":12336,"name":"Carlo Battisti","role":"Umberto Domenico Ferrari","profile":"https://image.tmdb.org/t/p/original/8KOx0me64ZHcLxH8mNi6tzGYVWD.jpg"},{"id":5363188,"name":"Napoleone the Dog","role":"Flike"},{"id":224209,"name":"Maria Pia Casilio","role":"Maria","profile":"https://image.tmdb.org/t/p/original/m8Da1gcaIzCqJ1quTt64HiWacrF.jpg"},{"id":12338,"name":"Lina Gennari","role":"Antonia Belloni","profile":"https://image.tmdb.org/t/p/original/3YnpdlOLrQz71cE20bhqkFD0Kb8.jpg"},{"id":12340,"name":"Elena Rea","role":"The Nun at the Hospital"},{"id":12341,"name":"Memmo Carotenuto","role":"The Patient at the Hospital","profile":"https://image.tmdb.org/t/p/original/4gqiAy02DoDiHX6AWY4OVBNpNpo.jpg"},{"id":12339,"name":"Ileana Simova","role":"The Woman in Umberto's Room"},{"id":42416,"name":"Lamberto Maggiorani","role":"(uncredited)","profile":"https://image.tmdb.org/t/p/original/qp3oZcD8UwTGRg1GiMMOyWLwSaX.jpg"},{"id":2255760,"name":"Pasquale Campagnola","role":"(uncredited)"},{"id":1893588,"name":"Riccardo Ferri","role":"(uncredited)"},{"id":1336866,"name":"Alberto Albani Barbieri","role":"Antonia's Friend (uncredited)"},{"id":3458739,"name":"De Silva","role":"Battistini (uncredited)"},{"id":5701699,"name":"Umberto Alivernini","role":"Young Doctor (uncredited)","profile":"https://image.tmdb.org/t/p/original/6PwjOeN3JmRqGiyOXqh1zNmEcRw.jpg"},{"id":2329675,"name":"Mario Pascucci","role":"Young Doctor (uncredited)","profile":"https://image.tmdb.org/t/p/original/ymeUU28dZMrAXbon0ZFq30GiviL.jpg"},{"id":543561,"name":"Mario Meniconi","role":"(uncredited)"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","overview":"Un anziano funzionario ministeriale in pensione non se la passa particolarmente bene dal punto di vista economico e da quello degli affetti. Vive infatti solo, con un cane e la domestica. Le scarse risorse economiche non gli consentono più uno stile di vita consono alla sua cultura e al suo decoro ed è costantemente in ritardo con il pagamento della pigione, come l'arcigna padrona di casa gli sottolinea spesso. In un soprassalto di dignità decide allora di togliersi la vita per non essere più di peso agli altri: sarà però proprio il suo cane a riconciliarlo involontariamente con il mondo....\r .\r Uno dei capolavori del cinema neorealista, e il suo canto del cigno."},{"language":"en-US","overview":"When elderly pensioner Umberto Domenico Ferrari returns to his boarding house from a protest calling for a hike in old-age pensions, his landlady demands her 15,000-lire rent by the end of the month or he and his small dog will be turned out onto the street. Unable to get the money in time, Umberto fakes illness to get sent to a hospital, giving his beloved dog to the landlady's pregnant and abandoned maid for temporary safekeeping."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/mbkQ4A04Er9WJNudlVZH5HS8IMf.jpg","background":"https://image.tmdb.org/t/p/original/dop0CEPeeW3BXDUGL1oDt9ywgK.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":833,"type":"movie","originalLanguage":"it-IT","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/mbkQ4A04Er9WJNudlVZH5HS8IMf.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/mbkQ4A04Er9WJNudlVZH5HS8IMf.jpg","language":"it","width":1000,"height":1500},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/mbkQ4A04Er9WJNudlVZH5HS8IMf.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/mbkQ4A04Er9WJNudlVZH5HS8IMf.jpg","language":"it","width":1000,"height":1500},{"type":"poster","url":"https://image.tmdb.org/t/p/original/zbNPDOeiu527tgvA7vobeeEqnyO.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/zbNPDOeiu527tgvA7vobeeEqnyO.jpg","language":"it","width":1000,"height":1500},{"type":"poster","url":"https://image.tmdb.org/t/p/original/hVhMVJXwjFmloVMzjAJCv6opq1I.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/hVhMVJXwjFmloVMzjAJCv6opq1I.jpg","language":"it","width":1170,"height":1755},{"type":"poster","url":"https://image.tmdb.org/t/p/original/fayAl6RBBvkruxZ4laI9peqeov7.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/fayAl6RBBvkruxZ4laI9peqeov7.jpg","language":"it","width":1000,"height":1500},{"type":"poster","url":"https://image.tmdb.org/t/p/orig