UGCMSlEwjQxiv28X.jpg"},{"id":131334,"name":"Jiang Yiyan","role":"'Xiao Jiang' Jiang Xiangjun","profile":"https://image.tmdb.org/t/p/original/xgbvSwNdwDXAbYVaEJ4kLFaZcm8.jpg"},{"id":1123522,"name":"Yao Di","role":"'May' Zhou Xiaomei","profile":"https://image.tmdb.org/t/p/original/8x4QbjENbyiF2LtR7ZMcCKo1uJ1.jpg"},{"id":2162634,"name":"Yisui Zhao","role":"Shunzi","profile":"https://image.tmdb.org/t/p/original/zyoni06KWujZopILH9geS9t0erX.jpg"},{"id":1044581,"name":"Sam Voutas","role":"Durdin","profile":"https://image.tmdb.org/t/p/original/s2py859Hqluo7TbWsaDgRfvOdpJ.jpg"},{"id":2162635,"name":"Aisling Dunne","role":"Doctor","profile":"https://image.tmdb.org/t/p/original/17CN3AT5RhT9shzTN3PaZ4f006g.jpg"},{"id":1168129,"name":"Junichi Kajioka","role":"Mr. Tomita","profile":"https://image.tmdb.org/t/p/original/wxKhKGxhcUy0aYXWQWWyECAkpnY.jpg"},{"id":2162636,"name":"Asano Nagahide","role":"Higashiguchi","profile":"https://image.tmdb.org/t/p/original/jDllI89RWidLckGxQgX7i3BKWtD.jpg"},{"id":1044576,"name":"Yuko Miyamoto","role":"Yuriko","profile":"https://image.tmdb.org/t/p/original/fRRCm3s3t47Zo4GHqGewzMg7GVb.jpg"},{"id":4355232,"name":"Kai Wang","role":"Tang Family Nanny","profile":"https://image.tmdb.org/t/p/original/9ZTQXdlhhpZ4xpVIU3idOT159jT.jpg"},{"id":4530188,"name":"Liu Bin","role":"Xiao Dou","profile":"https://image.tmdb.org/t/p/original/nF5TLUOMSxy9OufCYXENqKfbBFx.jpg"},{"id":5759953,"name":"Wang Jiahui"},{"id":2162636,"name":"Asano Nagahide","profile":"https://image.tmdb.org/t/p/original/jDllI89RWidLckGxQgX7i3BKWtD.jpg"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","overview":"Nel 1937, durante il culmine della seconda guerra sino-giapponese, l'esercito imperiale giapponese aveva appena conquistato Nanchino, allora capitale della Repubblica di Cina. Ciò che seguì fu noto come il massacro di Nanchino, o lo stupro di Nanchino, un periodo di sei settimane in cui decine di migliaia di soldati e civili cinesi furono uccisi."},{"language":"en-US","title":"City of Life and Death","overview":"In 1937, during the height of the Second Sino-Japanese War, the Imperial Japanese Army has just captured Nanjing, then-capital of the Republic of China. What followed was known as the Nanking Massacre, or the Rape of Nanking, a six week period wherein tens of thousands of Chinese soldiers and civilians were killed."},{"language":"zh-CN","title":"南京！南京！","overview":"1937年12月，侵华日军攻陷南京。面对即将沦陷的城市，以陆剑雄为代表的中国守军仍在街巷中进行最后的抵抗，但随着南京失守，大批中国军民沦为俘虏和难民，一场惨绝人寰的南京大屠杀随之发生。在南京安全区，唐先生、姜淑云等人竭力保护前来避难的同胞，而普通日军士兵角川也在亲历一幕幕暴行后陷入巨大的精神冲击。战争阴影笼罩下，不同身份的人们在这座满目疮痍的城市中挣扎求生，也不得不面对一次次关于生命、人性与尊严的艰难选择……"}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/nYz8Cqd5NcBWp5Nl1vTkx0LXMOC.jpg","background":"https://image.tmdb.org/t/p/original/bUxiZrkdLbDAV89ICbKNsuvnfu4.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":21345,"type":"movie","originalLanguage":"zh-CN","series":{"poster":{"it":{"status":"missing","candidates":[]},"en":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/xY6OUM2aRCmmq1ySTg2eu5rVmcq.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/xY6OUM2aRCmmq1ySTg2eu5rVmcq.jpg","language":"en","width":1000,"height":1500},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/xY6OUM2aRCmmq1ySTg2eu5rVmcq.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/xY6OUM2aRCmmq1ySTg2eu5rVmcq.jpg","language":"en","width":1000,"height":1500},{"type":"poster","url":"https://image.tmdb.org/t/p/original/swP1P2JoRcHnLBXRVjuIodfpDaY.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/swP1P2JoRcHnLBXRVjuIodfpDaY.jpg","language":"en","width":1000,"height":1500},{"type":"poster","url":"https://image.tmdb.org/t/p/original/aam9vfFXqYFbJBK86TtUeTxoz6D.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/aam9vfFXqYFbJBK86TtUeTxoz6D.jpg","language":"en","width":1000,"height":1500},{"type":"poster"