f trappen til loftet."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/kpwq6jFzyqjmkOypBA2EfhSByFZ.jpg","background":"https://image.tmdb.org/t/p/original/8OYSiDLuSiNA8XcCC9F7MZ80lpw.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":41391,"type":"movie","originalLanguage":"da-DA","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/kpwq6jFzyqjmkOypBA2EfhSByFZ.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/kpwq6jFzyqjmkOypBA2EfhSByFZ.jpg","language":"it","width":2000,"height":3000},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/kpwq6jFzyqjmkOypBA2EfhSByFZ.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/kpwq6jFzyqjmkOypBA2EfhSByFZ.jpg","language":"it","width":2000,"height":3000},{"type":"poster","url":"https://image.tmdb.org/t/p/original/o7k96mGEsX8WWTNTQYIv5NeLmYH.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/o7k96mGEsX8WWTNTQYIv5NeLmYH.jpg","language":"it","width":1400,"height":2100}]},"en":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/hC4BQB8afyagjZYCagRwqihERCZ.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/hC4BQB8afyagjZYCagRwqihERCZ.jpg","language":"en","width":500,"height":750},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/hC4BQB8afyagjZYCagRwqihERCZ.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/hC4BQB8afyagjZYCagRwqihERCZ.jpg","language":"en","width":500,"height":750},{"type":"poster","url":"https://image.tmdb.org/t/p/original/jEOqbGLFo8fxHHgYoZVTMVYMoQG.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/jEOqbGLFo8fxHHgYoZVTMVYMoQG.jpg","language":"en","width":1994,"height":2991},{"type":"poster","url":"https://image.tmdb.org/t/p/original/o7TmjzWiemgO3Gq0Vn6TPWKrsIq.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/o7TmjzWiemgO3Gq0Vn6TPWKrsIq.jpg","language":"en","width":605,"heig