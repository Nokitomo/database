 common goal: prevent this marriage at any cost! After fighting by any means in a struggle that will also involve their two bizarre families, will they manage to say no to the wedding?"}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/9D1yk79TLvxHLh5608IbJ5q28Hf.jpg","background":"https://image.tmdb.org/t/p/original/uSvhD1dGDm7Y9FNNDeoRJ54jMQ4.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":570454,"type":"movie","originalLanguage":"it-IT","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/9D1yk79TLvxHLh5608IbJ5q28Hf.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/9D1yk79TLvxHLh5608IbJ5q28Hf.jpg","language":"it","width":2000,"height":3000},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/9D1yk79TLvxHLh5608IbJ5q28Hf.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/9D1yk79TLvxHLh5608IbJ5q28Hf.jpg","language":"it","width":2000,"height":3000},{"type":"poster","url":"https://image.tmdb.org/t/p/original/4FTq53OYZ1UsXA522kJUQnMZ1u.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/4FTq53OYZ1UsXA522kJUQnMZ1u.jpg","language":"it","width":500,"height":750}]},"en":{"status":"missing","candidates":[]},"xx":{"status":"missing","candidates":[]}},"background":{"it":{"status":"available","selected":{"type":"backdrop","url":"https://image.tmdb.org/t/p/original/vqTIaDCL2yjTeMXujJRvS0lruAD.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/vqTIaDCL2yjTeMXujJRvS0lruAD.jpg","language":"it","width":1280,"height":720},"candidates":[{"type":"backdrop","url":"https://image.tmdb.org/t/p/original/vqTIaDCL2yjTeMXujJRvS0lruAD.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/vqTIaDCL2yjTeMXujJRvS0lruAD.jpg","language":"it","width":1280,"height":720}]},"en":{"status":"missing","candidates":[]},"xx":{"status":"available","selected":{"type":"backdrop","url":"https://image.tmdb.org/t/p/original/uSvhD1dGDm7Y