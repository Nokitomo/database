rina e imponendo lo strappo con la Chiesa Cattolica che porterà alla formazione della Chiesa Anglicana. Ma anche questa sarà una relazione tormentata."},{"id":916257,"translatable_type":"title","translatable_id":57527,"locale":"it","key":"slug","value":"laltra-donna-del-re"}],"keywords":[{"id":74,"name":"based on novel or book","created_at":"2023-05-18T11:48:55.000000Z","updated_at":"2023-05-18T11:48:55.000000Z","pivot":{"title_id":57527,"keyword_id":74}},{"id":140,"name":"kingdom","created_at":"2023-05-18T11:49:06.000000Z","updated_at":"2023-05-18T11:49:06.000000Z","pivot":{"title_id":57527,"keyword_id":140}},{"id":160,"name":"england","created_at":"2023-05-18T11:49:08.000000Z","updated_at":"2023-05-18T11:49:08.000000Z","pivot":{"title_id":57527,"keyword_id":160}},{"id":242,"name":"king","created_at":"2023-05-18T11:49:44.000000Z","updated_at":"2023-05-18T11:49:44.000000Z","pivot":{"title_id":57527,"keyword_id":242}},{"id":246,"name":"historical fiction","created_at":"2023-05-18T11:49:47.000000Z","updated_at":"2023-05-18T11:49:47.000000Z","pivot":{"title_id":57527,"keyword_id":246}},{"id":290,"name":"period drama","created_at":"2023-05-18T11:50:06.000000Z","updated_at":"2023-05-18T11:50:06.000000Z","pivot":{"title_id":57527,"keyword_id":290}},{"id":441,"name":"politics","created_at":"2023-05-18T11:50:41.000000Z","updated_at":"2023-05-18T11:50:41.000000Z","pivot":{"title_id":57527,"keyword_id":441}},{"id":449,"name":"sibling relationship","created_at":"2023-05-18T11:50:43.000000Z","updated_at":"2023-05-18T11:50:43.000000Z","pivot":{"title_id":57527,"keyword_id":449}},{"id":570,"name":"queen","created_at":"2023-05-18T11:51:27.000000Z","updated_at":"2023-05-18T11:51:27.000000Z","pivot":{"title_id":57527,"keyword_id":570}},{"id":979,"name":"royalty","created_at":"2023-05-18T11:53:20.000000Z","updated_at":"2023-05-18T11:53:20.000000Z","pivot":{"title_id":57527,"keyword_id":979}},{"id":981,"name":"palace intrigue","created_at":"2023-05-18T11:53:20.000000Z","updated_at":"2