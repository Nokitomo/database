b6q6R2gsmrtPRXs1097gTxOE2a.jpg"},{"id":1519144,"name":"Robert Kardashian","role":"Self - Defense (archive footage)","episodeCount":2,"profile":"https://image.tmdb.org/t/p/original/5rkvUZs5prCxCOlxvAQsbgFxbo.jpg"}]},"providers":{"streamingunity":[{"id":10389,"path":"/it/titles/10389-oj-made-in-america","availability":"present","seasons":[{"id":6256,"number":1,"name":null,"plot":"","release_date":null,"title_id":10389,"created_at":"2024-11-04T10:30:55.000000Z","updated_at":"2025-05-12T09:58:48.000000Z","release_date_it":null,"translations":[],"episodes":[{"id":80275,"number":1,"name":"Parte 1","plot":"Per molti, la storia del crimine del secolo ebbe inizio la notte in cui Nicole Brown Simpson e Ronald Goldman furono brutalmente uccisi fuori dal loro condominio a Brentwood. Ma per cogliere appieno il significato di quanto accadde non solo quella notte, ma anche durante tutta l’epopea che ne seguì, bisogna risalire a un‘origine molto antecedente.","duration":92,"scws_id":268882,"season_id":6256,"created_at":"2024-11-04T10:31:32.000000Z","updated_at":"2025-11-05T08:40:26.000000Z","quality":"HD","audio_orig":0,"dub_ita":1,"sub_ita":0,"uploaded_at":"2024-11-04 11:31:32","images":[{"id":140324,"filename":"c62f907d-a8dd-4cfb-a0f5-c7f16cf23915.webp","type":"cover","lang":null,"imageable_type":"episode","imageable_id":80275,"created_at":"2024-11-04T10:31:33.000000Z","updated_at":"2024-11-04T10:31:33.000000Z","original_url_field":null,"reference":{"base":"streamingunity:images","path":"/images/c62f907d-a8dd-4cfb-a0f5-c7f16cf23915.webp"}}],"translations":[{"id":236819,"translatable_type":"episode","translatable_id":80275,"locale":"it","key":"name","value":"Parte 1"},{"id":236820,"translatable_type":"episode","translatable_id":80275,"locale":"it","key":"plot","value":"Per molti, la storia del crimine del secolo ebbe inizio la notte in cui Nicole Brown Simpson e Ronald Goldman furono brutalmente uccisi fuori dal loro condominio a Brentwood. Ma per cogliere appieno il significato di quanto accadde non solo quella notte, ma anche durante tutta l’epopea che ne seguì, bisogna risalire a un‘origine molto antecedente."}]},{"id":80276,"number":2,"name":"Parte 2","plot":"Il mondo di O.J. Simpson era così: ricco, privilegiato e prevalentemente bianco. Un mondo in cui la celebrità significava potere, e in cui O.J. - al diavolo la razza - era uno dei personaggi più famosi. Ma a poca distanza dalla sua tenuta di Rockingham a Brentwood c’era una realtà completamente diversa. Una realtà vissuta da milioni di altri neri nelle mani della polizia di Los Angeles e del suo capo, Daryl Gates.","duration":97,"scws_id":268885,"season_id":6256,"created_at":"2024-11-04T10:31:50.000000Z","updated_at":"2025-11-05T08:40:26.000000Z","quality":"HD","audio_orig":0,"dub_ita":1,"sub_ita":0,"uploaded_at":"2024-11-04 11:31:50","images":[{"id":140325,"filename":"d104e4a5-b049-4a12-adca-a863358b1950.webp","type":"cover","lang":null,"imageable_type":"episode","imageable_id":80276,"created_at":"2024-11-04T10:31:50.000000Z","updated_at":"2024-11-04T10:31:50.000000Z","original_url_field":null,"reference":{"base":"streamingunity:images","path":"/images/d104e4a5-b049-4a12-adca-a863358b1950.webp"}}],"translations":[{"id":236821,"translatable_type":"episode","translatable_id":80276,"locale":"it","key":"name","value":"Parte 2"},{"id":236822,"translatable_type":"episode","translatable_id":80276,"locale":"it","key":"plot","value":"Il mondo di O.J. Simpson era così: ricco, privilegiato e prevalentemente bianco. Un mondo in cui la celebrità significava potere, e in cui O.J. - al diavolo la razza - era uno dei personaggi più famosi. Ma a poca distanza dalla sua tenuta di Rockingham a Brentwood c’era una realtà completamente diversa. Una realtà vissuta da milioni di altri neri nelle mani della polizia di Los Angeles e del suo capo, Daryl Gates."}]},{"id":80277,"number":3,"name":"Parte 3","plot":"La polizia arrivò all’appartamento di Bundy Drive alle 4:25 del mattino del 13 giugno 1994. Una scena del crimine raccapricciante, risultato evidente di una lite violenta che aveva provocato la morte di due persone. Uno dei cadaveri, come avrebbero scoperto ben presto, apparteneva alla ex moglie di O.J. Simpson. Era solo l’inizio di un capitolo della storia americana senza precedenti, un capitolo che avrebbe portato alla luce le realtà legate a razza, potere, sistema giudiziario, media e molto altro ancora a Los Angeles, in California, e oltre.","duration":95,"scws_id":268883,"season_id":6256,"created_at":"2024-11-04T10:32:14.000000Z","updated_at":"2025-11-05T08:40:26.000000Z","quality":"HD","audio_orig":0,"dub_ita":1,"sub_ita":0,"uploaded_at":"2024-11-04 11:32:14","images":[{"id":140326,"filename":"5c9c1e1f-bfd2-402e-97f7-2e45b7c9ddc4.webp","type":"cover","lang":null,"imageable_type":"episode","imageable_id":80277,"created_at":"2024-11-04T10:32:14.000000Z","updated_at":"2024-11-04T10:32:14.000000Z","original_url_field":null,"reference":{"base":"streamingunity:images","path":"/images/5c9c1e1f-bfd2-402e-97f7-2e45b7c9ddc4.webp"}}],"translations":[{"id":236823,"translatable_type":"episode","translatable_id":80277,"locale":"it","key":"name","value":"Parte 3"},{"id":236824,"translatable_type":"episode","translatable_id":80277,"locale":"it","key":"plot","value":"La polizia arrivò all’appartamento di Bundy Drive alle 4:25 del mattino del 13 giugno 1994. Una scena del crimine raccapricciante, risultato evidente di una lite violenta che aveva provocato la morte di due persone. Uno dei cadaveri, come avrebbero scoperto ben presto, apparteneva alla ex moglie di O.J. Simpson. Era solo l’inizio di un capitolo della storia americana senza precedenti, un capitolo che avrebbe portato alla luce le realtà legate a razza, potere, sistema giudiziario, media e molto altro ancora a Los Angeles, in California, e oltre."}]},{"id":80278,"number":4,"name":"Parte 4","plot":"Il crimine del secolo portò al processo del secolo, che ebbe inizio ufficialmente nel gennaio del 1995. Sarebbe stato un processo non paragonabile a nulla di quanto accaduto prima o dopo: avrebbe rivoluzionato il mondo dei media e, invero, tutta la cultura americana. E avrebbe altresì rappresentato la lotta per la vita di O.J. Simpson.","duration":94,"scws_id":268884,"season_id":6256,"created_at":"2024-11-04T10:32:25.000000Z","updated_at":"2025-11-05T08:40:26.000000Z","quality":"HD","audio_orig":0,"dub_ita":1,"sub_ita":0,"uploaded_at":"2024-11-04 11:32:25","images":[{"id":140327,"filename":"9c98ff11-d07c-48d3-8ad1-c8305560dceb.webp","type":"cover","lang":null,"imageable_type":"episode","imageable_id":80278,"created_at":"2024-11-04T10:32:25.000000Z","updated_at":"2024-11-04T10:32:25.000000Z","original_url_field":null,"reference":{"base":"streamingunity:images","path":"/images/9c98ff11-d07c-48d3-8ad1-c8305560dceb.webp"}}],"translations":[{"id":236825,"translatable_type":"episode","translatable_id":80278,"locale":"it","key":"name","value":"Parte 4"},{"id":236826,"translatable_type":"episode","translatable_id":80278,"locale":"it","key":"plot","value":"Il crimine del secolo portò al processo del secolo, che ebbe inizio ufficialmente nel gennaio del 1995. Sarebbe stato un processo non paragonabile a nulla di quanto accaduto prima o dopo: avrebbe rivoluzionato il mondo dei media e, invero, tutta la cultura americana. E avrebbe altresì rappresentato la lotta per la vita di O.J. Simpson."}]},{"id":80279,"number":5,"name":"Parte 5","plot":"Ci vollero meno di quattro ore per la decisione finale e, il 3 ottobre 1995, venne annunciato che O.J. Simpson era stato assolto da tutte le accuse. Tuttavia, come dimostrato dalla reazione in tribunale, nella città di Los Angeles e in tutti gli Stati Uniti, quel verdetto ebbe un significato ben più profondo. Era giunta l'ora che O.J. tornasse a casa, ma se sperava di poter tornare anche solo a una parvenza della vita che aveva vissuto prima degli omicidi, avrebbe presto scoperto quanto erano cambiate le cose.","duration":99,"scws_id":268886,"season_id"