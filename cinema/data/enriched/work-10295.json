age.tmdb.org/t/p/original/gLoOdH8mTc8nweE4daqve3lPeTR.jpg"},{"id":81510,"name":"Niccolò Senni","role":"Maestro","profile":"https://image.tmdb.org/t/p/original/uaMIXYdpbnQtgda5BSWxxpJLKhI.jpg"},{"id":1625453,"name":"Denny Mendez","role":"Faio","profile":"https://image.tmdb.org/t/p/original/88Uec8lMotZv5xSacOFPDo1qEbv.jpg"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","overview":"Lucio (Edoardo Pesce), conduttore di una nota trasmissione radiofonica, spigliato, brillante e dalle idee progressiste, è sposato con la bella Elena (Valentina Lodovini), insicura ed emotivamente dipendente del marito. I due hanno un’armoniosa famiglia allargata (che include la prima moglie ed una figlia di Lucio) ed un unico figlio: Blu (Daniele Scardini), 9 anni, che adora vestirsi da femmina, ed è libero di farlo, col permesso di mamma e papà, solo quando è a casa. In occasione della recita scolastica, però, il bambino vuole a tutti i costi indossare il costume della Sirenetta: i suoi genitori, divisi tra il desiderio di assecondarlo e quello di proteggerlo, saranno i primi a dover riconsiderare la loro apertura mentale e a intraprendere un percorso di consapevolezza e accettazione, in cui saranno accompagnati da un gruppo eterogeneo di coppie di “Genitori Unicorni”, guidato da un’accogliente psicologa (Michela Andreozzi)."},{"language":"en-US","overview":"Lucio, the host of a popular radio show, is confident, charismatic, and holds progressive views. He is married to the beautiful Elena, who is insecure and emotionally dependent on her husband. Together, they form a harmonious blended family (which includes Lucio’s first wife and daughter) and have one child together: Blu, a 9-year-old who loves dressing in girls’ clothes and is allowed to do so—by both mom and dad—but only at home. When the school play comes around, however, Blu is determined to wear a Little Mermaid costume on stage. His parents, caught between their desire to support him and their instinct to protect him, find themselves confronting the limits of their open-mindedness. They embark on a journey of self-awareness and acceptance, joined by a diverse group of “Unicorn Parents” led by a compassionate psychologist."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/nBUtKoEWqrtFWD0vyldo1p96a0Y.jpg","background":"https://image.tmdb.org/t/p/original/mDlGrKQbQXimxwUA7Hu1SNYWbpZ.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":1438969,"type":"movie","originalLanguage":"it-IT","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/nBUtKoEWqrtFWD0vyldo1p96a0Y.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/nBUtKoEWqrtFWD0vyldo1p96a0Y.jpg","language":"it","width":895,"height":1280},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/nBUtKoEWqrtFWD0vyldo1p96a0Y.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/nBUtKoEWqrtFWD0vyldo1p96a0Y.jpg","language":"it","width":895,"height":1280},{"type":"poster","url":"https://image.tmdb.org/t/p/original/7Tq7wUhJOtLgHyWkfjBo6TwyVHl.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/7Tq7wUhJOtLgHyWkfjBo6TwyVHl.jpg","language":"it","width":1920,"height":2743},{"type":"poster","url":"https://image.tmdb.org/t/p/original/yatBGL8P8oeu5q95ZhUatfCBEis.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/yatBGL8P8oeu5q95ZhUatfCBEis.jpg","language":"it","width":1920,"height":2560},{"type":"poster","url":"https://image.tmdb.org/t/p/original/oFO2W4VhBhgdq3HvbWOVxkpHa6f.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/oFO2W4VhBhgdq3HvbWOVxkpHa6f.jpg","language":"it","width":2000,"height":2818}]},"en":{"status":"missing","candidates":[]},"xx":{"status":"missing","candidates":[]}},"background":{"it":{"status":"available","selected":{"type":"backdrop","url":"https://image.tmdb.org/t/p/original/y4seWxDObew0ftUCAcKTA9B12b1.jpg","previewUrl