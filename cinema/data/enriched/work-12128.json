:"/images/f3c5eb3b-375a-4eb1-99c2-511d3c681ee0.webp"},"provider":"streamingunity"}],"episodeMappingUncertain":false,"seasons":[],"provenance":{},"warnings":[],"externalIdsEvidence":{"wikidata":{"source":"wikidata","sourceUrl":"https://www.wikidata.org/wiki/Q128208470","wikidataId":"Q128208470","tmdbId":1316147,"type":"movie","imdbId":"tt32897929","tvdbId":367576}},"externalMedia":{"tmdb":{"source":"tmdb-api","id":1316147,"type":"movie","sourceUrl":"https://www.themoviedb.org/movie/1316147","fetchedAt":"2026-11-07T20:59:07.855Z","originalLanguage":"de-DE","title":{"value":"Grand Prix","language":"it-IT"},"originalTitle":"Grand Prix of Europe","overview":{"value":"Edda è una giovane topolina figlia del gestore di un luna park in crisi. Il suo sogno è diventare una pilota di auto da corsa. Dopo un incontro sfortunato con il suo idolo, il leggendario pilota Ed, la giovane Edda si ritrova a doverlo sostituire in incognito per salvargli la carriera. Travestita da Ed, per Edda ha così inizio un’avventura fatta di travestimenti e corse mozzafiato, mentre i due cercano di collaborare e lei si cala nel ruolo di Ed per gareggiare nella competizione. Ma qualcosa di strano accade in pista: un sabotatore misterioso sta cercando di rovinare tutto per vincere la gara. Edda dovrà usare tutta la sua astuzia e il suo coraggio per scoprire l’identità del sabotatore, tagliare il traguardo e proteggere il parco divertimenti della sua famiglia, che rischia di chiudere per sempre.","language":"it-IT"},"tagline":{"value":"Sogna, corri, vinci!","language":"it-IT"},"releaseDate":"2025-07-18","status":"Released","rating":7.1,"ratingCount":68,"genres":["Animazione","Avventura","Commedia","Famiglia"],"countries":["Germany","United Kingdom"],"facts":{"Runtime":"98m"},"keywords":[],"networks":[],"socialLinks":{},"cast":[{"id":583154,"name":"Hannes Maurer","role":"Ed (voice)"},{"id":6269765,"name":"Maria Koschny","role":"Edda (voice)"},{"id":114682,"name":"DJ BoBo","role":"Böckli (voice)","profile":"https://image.tmdb.org/t/p/original/jPZtfIxKlf2hHRRwQzQvTWpk05V.jpg"},{"id":6269766,"name":"Rubina Nath","role":"Cindy (voice)","profile":"https://image.tmdb.org/t/p/original/Am7O1o8QL5C7Ob1YiSyXfY3s7YJ.jpg"},{"id":1121123,"name":"Hans Bayer","role":"Erwin (voice)"},{"id":1051347,"name":"Jan Delay","role":"Enzo (voice)","profile":"https://image.tmdb.org/t/p/original/48nF1khxxjVYDMPrrgigpEmK4oR.jpg"},{"id":1667182,"name":"Tom Vogt","role":"Nachtkraab (voice)","profile":"https://image.tmdb.org/t/p/original/6bCv34gKCtw8VGwERx9ENSem7iE.jpg"},{"id":2722676,"name":"Leonhard Mahlich","role":"Magnus (voice)","profile":"https://image.tmdb.org/t/p/original/fUhYnv3SsJLRNSubA6ZIhtXQAAE.jpg"},{"id":6269772,"name":"Kevin Kraus","role":"Richard (voice)"},{"id":1326626,"name":"Axel Malzacher","role":"Louis (voice)"},{"id":6269777,"name":"Katja Brügger","role":"Rosa (voice)"},{"id":4349392,"name":"Nico Capone","role":"Jorge (voice)","profile":"https://image.tmdb.org/t/p/original/dqx7D7tVAOCGaNkxViA6h2iKzLD.jpg"},{"id":2447466,"name":"Michael Iwannek","role":"Fluffy (voice)"},{"id":2044717,"name":"Axel Strothmann","role":"Mittens (voice)"},{"id":3929286,"name":"Clara Matthews","role":"Finja (voice)"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","title":"Grand Prix","overview":"Edda è una giovane topolina figlia del gestore di un luna park in crisi. Il suo sogno è diventare una pilota di auto da corsa. Dopo un incontro sfortunato con il suo idolo, il leggendario pilota Ed, la giovane Edda si ritrova a doverlo sostituire in incognito per salvargli la carriera. Travestita da Ed, per Edda ha così inizio un’avventura fatta di travestimenti e corse mozzafiato, mentre i due cercano di collaborare e lei si cala nel ruolo di Ed per gareggiare nella competizione. Ma qualcosa di strano accade in pista: un sabotatore misterioso sta cercando di rovinare tutto per vincere la gara. Edda dovrà usare tutta la sua astuzia e il suo coraggio per scoprire l’identità del sabotatore, tagliare il traguardo e proteggere il parco divertimenti della sua famiglia, che rischia di chiudere per sempre.","tagline":"Sogna, corri, vinci!"},{"language":"en-US","overview":"Edda, a young mouse and the daughter of fairground operator Erwin, dreams of becoming a race car driver. Ahead of the 50th anniversary of the European Grand Prix, Edda gets the opportunity to meet her idol, racing star Ed, and to help her father save his failing business. But to do so, she'll have to get behind the wheel herself."},{"language":"de-DE","overview":"Edda, eine junge Maus und die Tochter des Jahrmarktbetreibers Erwin, träumt davon, Rennfahrerin zu werden. Zum 50. Jubiläum des Großen Preises von Europa erhält Edda die Gelegenheit, ihr Idol, den Rennstar Ed, kennenzulernen und ihrem Vater dabei zu helfen, sein scheiterndes Unternehmen zu retten. Dafür muss sie jedoch selbst ans Steuer."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/z9j9hW8dykQllJVCZhEQaP4uhtt.jpg","background":"https://image.tmdb.org/t/p/original/keToI4XlwYVtImAXjoeoaLJKnfc.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":1316147,"type":"movie","originalLanguage":"de-DE","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/z9j9hW8dykQllJVCZhEQaP4uhtt.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/z9j9hW8dykQllJVCZhEQaP4uhtt.jpg","language":"it","width":2000,"height":3000},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/z9j9hW8dykQllJVCZhEQaP4uhtt.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/z9j9hW8dykQllJVCZhEQaP4uhtt.jpg","language":"it","width":2000,"height":3000}]},"en":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/jGGEqRaHAJ1pKJBj35WVxDyQBNw.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/jGGEqRaHAJ1pKJBj35WVxDyQBNw.jpg","languag