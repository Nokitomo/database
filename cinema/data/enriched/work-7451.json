idata.org/wiki/Q65158549","wikidataId":"Q65158549","tmdbId":502033,"type":"movie","imdbId":"tt5363618","tvdbId":141397}},"externalMedia":{"tmdb":{"source":"tmdb-api","id":502033,"type":"movie","sourceUrl":"https://www.themoviedb.org/movie/502033","fetchedAt":"2026-11-07T08:19:09.801Z","originalLanguage":"en-US","title":{"value":"Sound of Metal","language":"en-US"},"originalTitle":"Sound of Metal","overview":{"value":"Il batterista Ruben forma con la fidanzata Lou il duo Blackgammon: i due vivono insieme e sono sempre in viaggio per le strade d'America, in tour da un club all'altro. Ex tossicodipendente pulito da quattro anni, Ruben si accorge di percepire uno strano ronzio nelle orecchie e in poco tempo diventa quasi completamente sordo. Sopraffatto da ansia e depressione, si rifugia in una casa per sordomuti gestita da un veterano del Vietnam anch'egli sordo. Grazie al lavoro con altre persone nella sua situazione Ruben arriva ad accettare la sordità, anche se non perde la speranza di tornare a sentire grazie a un impianto artificiale e così riunirsi con Lou, nel frattempo trasferitasi in Francia dal padre.","language":"it-IT"},"tagline":{"value":"Music was his world. Then silence revealed a new one.","language":"en-US"},"releaseDate":"2020-11-20","status":"Released","rating":7.706,"ratingCount":3002,"genres":["Dramma","Musica"],"countries":["United States of America"],"facts":{"Runtime":"140m"},"keywords":[],"networks":[],"socialLinks":{},"cast":[{"id":53240,"name":"Riz Ahmed","role":"Ruben Stone","profile":"https://image.tmdb.org/t/p/original/1uP9RaX7BGVx7XGTEmwObBJJzsC.jpg"},{"id":1173984,"name":"Olivia Cooke","role":"Lou","profile":"https://image.tmdb.org/t/p/original/wf71ctooNlVmiT8dxx0QmRAzyiX.jpg"},{"id":1216195,"name":"Paul Raci","role":"Joe","profile":"https://image.tmdb.org/t/p/original/7ky9dBmNAMwkQuM4pMZkprtSN1Z.jpg"},{"id":2287101,"name":"Lauren Ridloff","role":"Diane","profile":"https://image.tmdb.org/t/p/original/eyMriacYFsWtdgzedVPfXmT0TFa.jpg"},{"i