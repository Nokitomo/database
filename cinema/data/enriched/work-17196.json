al/jGrK7pWHQmxqVfArmgCvX4VZe9Z.jpg"},{"id":549035,"name":"Aleksandr Mitta","profile":"https://image.tmdb.org/t/p/original/fcph0Y1BVUjbJmsfUCElxE10MlX.jpg"},{"id":2179077,"name":"Egor Morozov","role":"Valeriy Zinchenko (voice)","profile":"https://image.tmdb.org/t/p/original/7HGzE2rrOLMPvGuunjoup7jvXJA.jpg"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","title":"The Crew - Missione impossibile","overview":"Un militare viene espulso dall'aviazione per aver disobbedito ad un ordine ritenuto assurdo. Trova lavoro come co-pilota di linea, anche se non lega molto con i nuovi colleghi. Durante un volo per l'Asia, l'equipaggio riceve un SOS proveniente da un'isola vulcanica e si imbarca in una missione di soccorso. C'è un unico modo per sopravvivere: fare gioco di squadra e aiutarsi a vicenda.","tagline":"Volare o morire"},{"language":"en-US","title":"The Crew","overview":"A story about bravery, self-sacrifice and human dignity put on trial by the merciless power of nature. A young pilot is fired from military air force after disobeying an absurd order. He gets a job as a co-pilot with a civil airline. Being brutally honest and direct, he is not on best terms with his new colleagues. During a flight to Asia his crew receives a distress message from a volcanic island and makes a decision to attempt a rescue mission. Will it be a success? Will they survive the disaster? They have a single chance to find that out: by being a team and sticking up for one another.","tagline":"A mid air rescue mission"},{"language":"ru-RU","overview":"История талантливого молодого летчика Алексея Гущина. Он не признает авторитетов, предпочитая поступать в соответствии с личным кодексом чести. За невыполнение абсурдного приказа его выгоняют из военной авиации, и только чудом он получает шанс летать на гражданских самолетах.  Гущин начинает свою летную жизнь сначала. Его наставник — командир воздушного судна — суровый и принципиальный Леонид Зинченко. Его коллега — второй пилот, неприступная красавица Александра. Отношения складываются непросто. Но на грани жизни и смерти, когда земля уходит из-под ног, вокруг — огонь и пепел и только в небе есть спасение, Гущин показывает все, на что он способен. Только вместе экипаж сможет совершить подвиг и спасти сотни жизней."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/8lWzmOztne5aYIJVsswK9SJ6LSa.jpg","background":"https://image.tmdb.org/t/p/original/MrnSQzIwftHPAXJa9DrkebfnXu.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":380111,"type":"movie","originalLanguage":"ru-RU","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/8lWzmOztne5aYIJVsswK9SJ6LSa.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/8lWzmOztne5aYIJVsswK9SJ6LSa.jpg","language":"it","width":500,"height":750},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/8lWzmOztne5aYIJVsswK9SJ6LSa.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/8lWzmOztne5aYIJVsswK9SJ6LSa.jpg","language":"it","width":500,"height":750},{"type":"poster","url":"https://image.tmdb.org/t/p/original/y3q90iGtQSU31a5Rl6jrMUobVb4.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/y3q90iGtQSU31a5Rl6jrMUobVb4.jpg","language":"it","width":2000,"height":3000}]},"en":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/nL1WhzLiD2nZ7ixQcp5K0z4eEB7.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/nL1WhzLiD2nZ7ixQcp5K0z4eEB7.jpg","language":"en","width":1200,"height":1600},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/nL1WhzLiD2nZ7ixQcp5K0z4eEB7.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/nL1WhzLiD2nZ7ixQcp5K0z4eEB7.jpg","language":"en","width":1200,"height":1600},{"type":"poster","url":"https://image.tmdb.org/t/p/original/zz3ptj6u2vNtebmuN3Ht7OYC1Br.jpg","previewUrl":"https://image