e neue Sportart soll der Schlüssel zu Herz und Verstand seiner Eleven werden. Er hat Erfolg, erregt damit aber den Argwohn der preußisch gesinnten Lehrerschaft und einflussreicher Eltern. Jetzt müssen die Schüler um Konrad Koch kämpfen, wenn er weiter ihr Lehrer bleiben soll."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/k8HbXXZQV8Ci3uJefHSTNjnJMft.jpg","background":"https://image.tmdb.org/t/p/original/830lKrltDrfZgtjVC1Ya8PD4IbO.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":58166,"type":"movie","originalLanguage":"de-DE","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/k8HbXXZQV8Ci3uJefHSTNjnJMft.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/k8HbXXZQV8Ci3uJefHSTNjnJMft.jpg","language":"it","width":1000,"height":1500},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/k8HbXXZQV8Ci3uJefHSTNjnJMft.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/k8HbXXZQV8Ci3uJefHSTNjnJMft.jpg","language":"it","width":1000,"height":1500}]},"en":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/kvm2cmbnYerVUsYSomv5H2iYthn.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/kvm2cmbnYerVUsYSomv5H2iYthn.jpg","language":"en","width":2000,"height":3000},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/kvm2cmbnYerVUsYSomv5H2iYthn.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/kvm2cmbnYerVUsYSomv5H2iYthn.jpg","language":"en","width":2000,"height":3000}]},"de":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/cygw8nnwA84Tj64q8HXG1kuieoP.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/cygw8nnwA84Tj64q8HXG1kuieoP.jpg","language":"de","width":2000,"height":3000},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/cygw8nnwA84Tj64q8HXG1kuieoP.jpg","previewUrl":"h