:"https://image.tmdb.org/t/p/original/v44CyEhnW1oPt9uWJhizy5pbjCx.jpg"},{"id":6254,"name":"Gustav Knuth","role":"Duke Max","profile":"https://image.tmdb.org/t/p/original/1bB83bPDWPQCh39efGpD9KnN4o1.jpg"},{"id":6255,"name":"Vilma Degischer","role":"Archduchess Sophie"},{"id":6256,"name":"Josef Meinrad","role":"Major Böckl","profile":"https://image.tmdb.org/t/p/original/svPZ1mal3xGFW8QB754j2hh57Rl.jpg"},{"id":6260,"name":"Karl Fochler","role":"Grünne","profile":"https://image.tmdb.org/t/p/original/3FWW4ECSlWrMGwMa5bpRoPJI926.jpg"},{"id":591911,"name":"Franz Böheim","role":"Johann Petzmacher","profile":"https://image.tmdb.org/t/p/original/l3jBHE1e39KYR89ZeqEgD7XM5CV.jpg"},{"id":23754,"name":"Fritz Muliar","role":"Blumenbote","profile":"https://image.tmdb.org/t/p/original/319qoBvXe14OOkEoxm0V0RItWEu.jpg"},{"id":6262,"name":"Egon von Jordan","role":"Minister","profile":"https://image.tmdb.org/t/p/original/jf2ZoeQjiyMdIwHXeHWp4gtqoBE.jpg"},{"id":37677,"name":"Richard Eybner","role":"Von Ischl","profile":"https://image.tmdb.org/t/p/original/1PxynRRNf6YXPiuAUERwpdhsYq9.jpg"},{"id":6258,"name":"Peter Weck","role":"Archduke Karl Ludwig","profile":"https://image.tmdb.org/t/p/original/mgJXR5NxDK9kvY4Zu3fYDavCMdI.jpg"},{"id":6257,"name":"Erich Nikowitz","role":"Archduke Franz Karl"},{"id":6259,"name":"Hilde Wagener","role":"Baroness Wulffen","profile":"https://image.tmdb.org/t/p/original/9gS1kYsnye4uzDdq7e4jvYgyBxU.jpg"},{"id":6261,"name":"Otto Treßler","role":"Radetzky"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","title":"La principessa Sissi","overview":"Elisabetta, detta Sissi, e la sorella maggiore Elena sono figlie del granduca di Baviera. La più grande è stata designata a sposare il giovane imperatore d'Austria Francesco Giuseppe, ma il sovrano è afffascinato dalle grazie di Sissi e, al momento di annunciare la scelta della sua sposa, nonché futura imperatrice, proclama il nome della sorella più giovane.","tagline":"La magica storia d'amore della giovane imperatrice Elisabetta!"},{"language":"en-US","overview":"The young Bavarian princess Elisabeth, who all call Sissi, goes with her mother and older sister Néné to Austria where Néné will be wed to an emperor named Franz Joseph, Yet unexpectedly Franz runs into Sissi while out fishing and they fall in love.","tagline":"The magical love story of the young Empress Elisabeth!"},{"language":"de-DE","overview":"Der österreichische Kaiser Franz Joseph ist verliebt. Jedoch nicht in Prinzessin Nené, die seine Mutter Erzherzogin Sophie für ihn als zukünftige Kaiserin Österreichs ausgesucht hat. Sissi, die jüngere Schwester von Nené ist das Mädchen, dem er sein Herz schenken will. Franz Joseph ist hingerissen von ihrer Anmut und Schönheit. Sissi will aber dem Glück von Nené nicht im Wege stehen und möchte sich zurückziehen.Aber der junge Kaiser verkündet kurzentschlossen bei einem großen Empfang seine Verlobung mit Sissi - zum Entsetzen seiner Mutter. Bald reist Sissi über die Donau in ihre zukünftige Heimat Österreich. Die Wiener lieben ihre neue Prinzessin, und sie bereiten ihr zur Hochzeit einen prächtigen Empfang.","tagline":"Die zauberhafte Liebesgeschichte der jungen Kaiserin Elisabeth!"}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/8ZSizvip84udrp7eUUZtOm2mjvw.jpg","background":"https://image.tmdb.org/t/p/original/rKs8y5WlXcYX5GCbDkXcXybGteZ.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":457,"type":"movie","originalLanguage":"de-DE","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/8ZSizvip84udrp7eUUZtOm2mjvw.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/8ZSizvip84udrp7eUUZtOm2mjvw.jpg","language":"it","width":900,"height":1350},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/8ZSizvip84udrp7eUUZtOm2mjvw.jpg","previewUrl":"https://image.t