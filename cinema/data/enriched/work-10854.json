ed_at":"2026-01-15T22:02:30.000000Z","original_url_field":null,"reference":{"base":"streamingunity:images","path":"/images/71348696-2c5b-45a3-bebb-1f125fc307cf.webp"},"provider":"streamingunity"}],"episodeMappingUncertain":false,"seasons":[],"provenance":{},"warnings":[],"externalIdsEvidence":{"wikidata":{"source":"wikidata","sourceUrl":"https://www.wikidata.org/wiki/Q3549737","wikidataId":"Q3549737","tmdbId":62024,"type":"movie","imdbId":"tt0423813","tvdbId":84201}},"externalMedia":{"tmdb":{"source":"tmdb-api","id":62024,"type":"movie","sourceUrl":"https://www.themoviedb.org/movie/62024","fetchedAt":"2026-11-07T17:17:54.444Z","originalLanguage":"it-IT","title":{"value":"An Italian Romance","language":"en-US"},"originalTitle":"L'amore ritrovato","overview":{"value":"Il film, ambientato nel 1936 in Toscana, è tratto dal romanzo Una relazione di Carlo Cassola. Giovanni, sposato con un figlio, durante un viaggio in treno, incontra Maria, una sua vecchia fiamma. Giovanni, che non ha dimenticato Maria, la ricerca ed intrecciano una breve ma intensa relazione durante i 40 giorni in cui l'uomo è richiamato alle armi in Marina, in seguito allo scoppio della Guerra d'Etiopia. Una sera Maria vede a Livorno Giovanni che è accompagnato dalla moglie e dal figlio. A quella vista, Maria decide di troncare definitivamente la relazione per non soffrire più per un amore impossibile. Il tempo passa, e dopo nove anni Giovanni rincontra Maria alla fine della Seconda guerra mondiale: nel frattempo la donna si è sposata e ha una figlia.","language":"it-IT"},"releaseDate":"2004-09-17","status":"Released","rating":5.5,"ratingCount":26,"genres":["Dramma","Romance"],"countries":["France","Italy"],"facts":{"Runtime":"108m"},"keywords":[],"networks":[],"socialLinks":{},"cast":[{"id":65571,"name":"Stefano Accorsi","role":"Giovanni","profile":"https://image.tmdb.org/t/p/original/v0juBdStV3KECZL1nEL7AkbWQ0j.jpg"},{"id":54230,"name":"Maya Sansa","role":"Maria","profile":"https://image.tmdb.org/t/p/