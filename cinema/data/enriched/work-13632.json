ristmas film is filled with lots of holiday magic, and is something the whole family will enjoy together.","tagline":"Save Santa, save Christmas."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/8BN5bd4qVvLjW3WTo31pNcB3Gte.jpg","background":"https://image.tmdb.org/t/p/original/l4XVXkCFOuYHo2XltjW0w8xxjMY.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":828595,"type":"movie","originalLanguage":"en-US","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/8BN5bd4qVvLjW3WTo31pNcB3Gte.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/8BN5bd4qVvLjW3WTo31pNcB3Gte.jpg","language":"it","width":1175,"height":1763},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/8BN5bd4qVvLjW3WTo31pNcB3Gte.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/8BN5bd4qVvLjW3WTo31pNcB3Gte.jpg","language":"it","width":1175,"height":1763}]},"en":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/nEP2DSmUVpVrTmYEuObZzGigGr1.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/nEP2DSmUVpVrTmYEuObZzGigGr1.jpg","language":"en","width":2000,"height":3000},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/nEP2DSmUVpVrTmYEuObZzGigGr1.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/nEP2DSmUVpVrTmYEuObZzGigGr1.jpg","language":"en","width":2000,"height":3000},{"type":"poster","url":"https://image.tmdb.org/t/p/original/g7jqMJLFffIDanulvMRGGvHM3Th.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/g7jqMJLFffIDanulvMRGGvHM3Th.jpg","language":"en","width":2000,"height":3000}]},"xx":{"status":"missing","candidates":[]}},"background":{"it":{"status":"missing","candidates":[]},"en":{"status":"available","selected":{"type":"backdrop","url":"https://image.tmdb.org/t/p/original/zTxcJdEAM3a17lEMDeZlLTyow3T.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/zTxcJdEAM3a1