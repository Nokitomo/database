e":"title","imageable_id":64015,"created_at":"2026-06-26T13:49:59.000000Z","updated_at":"2026-06-26T13:49:59.000000Z","original_url_field":null,"reference":{"base":"streamingunity:images","path":"/images/d7f9e371-1dfa-4906-8601-a78ccbe5069a.webp"},"provider":"streamingunity"},{"id":768144,"filename":"a28826cb-5fba-4eb5-a69c-d7aba5e3c25e.webp","type":"background","lang":null,"imageable_type":"title","imageable_id":64015,"created_at":"2026-06-23T03:18:05.000000Z","updated_at":"2026-06-23T03:18:06.000000Z","original_url_field":null,"reference":{"base":"streamingunity:images","path":"/images/a28826cb-5fba-4eb5-a69c-d7aba5e3c25e.webp"},"provider":"streamingunity"},{"id":775448,"filename":"eb449352-3b8e-403b-a8d8-7dfa650dd91b.webp","type":"cover_mobile","lang":"it","imageable_type":"title","imageable_id":64015,"created_at":"2026-06-26T13:49:59.000000Z","updated_at":"2026-06-26T13:49:59.000000Z","original_url_field":null,"reference":{"base":"streamingunity:images","path":"/images/eb449352-3b8e-403b-a8d8-7dfa650dd91b.webp"},"provider":"streamingunity"}],"episodeMappingUncertain":false,"seasons":[],"provenance":{},"warnings":[],"externalIdsEvidence":{"wikidata":{"source":"wikidata","sourceUrl":"https://www.wikidata.org/wiki/Q258830","wikidataId":"Q258830","tmdbId":5991,"type":"movie","imdbId":"tt0015064","tvdbId":11196}},"externalMedia":{"tmdb":{"source":"tmdb-api","id":5991,"type":"movie","sourceUrl":"https://www.themoviedb.org/movie/5991","fetchedAt":"2026-11-08T03:58:09.055Z","originalLanguage":"de-DE","title":{"value":"L'ultima risata","language":"it-IT"},"originalTitle":"Der letzte Mann","overview":{"value":"L'ormai anziano ed esperto usciere dell'Hotel Atlantic è orgoglioso della sua posizione, delle sue responsabilità e della sua livrea. Una notte piovosa e indaffarata si sta riposando brevemente dopo aver trasportato un pesante bagaglio sotto la pioggia e proprio in quel mentre viene sorpreso dal direttore. Il giorno seguente apprende di essere stato sostituito e declassato al ruolo umiliante di assistente alle pulizie. Sbalordito e umiliato, si sforza di riuscire a mandare avanti lo stesso la sua vita.","language":"it-IT"},"releaseDate":"1924-12-23","status":"Released","rating":7.763,"ratingCount":375,"genres":["Dramma"],"countries":["Germany"],"facts":{"Runtime":"90m"},"keywords":[],"networks":[],"socialLinks":{},"cast":[{"id":2895,"name":"Emil Jannings","role":"Hotel Doorman","profile":"https://image.tmdb.org/t/p/original/yX7AFfYgYit6WlPshockLsP40LB.jpg"},{"id":35420,"name":"Maly Delschaft","role":"His Niece","profile":"https://image.tmdb.org/t/p/original/m1xP591e4pee4gnLMRq58M5l4Va.jpg"},{"id":47029,"name":"Max Hiller","role":"Bridegroom"},{"id":47030,"name":"Hans Unterkircher","role":"Hotel Manager","profile":"https://image.tmdb.org/t/p/original/wWJYqgF9G6Tz3HfQZr20WJVmchi.jpg"},{"id":47031,"name":"Hermann Vallentin","role":"Potbellied Guest","profile":"https://image.tmdb.org/t/p/original/sQMuiwy5Ifx0RzvNYVvzXV1nOFe.jpg"},{"id":47032,"name":"Emilie Kurz","role":"Bridegroom's Aunt","profile":"https://image.tmdb.org/t/p/original/aTco2ojDUT5in2GRhagnzTDSyTc.jpg"},{"id":29129,"name":"Georg John","role":"Night Watchman","profile":"https://image.tmdb.org/t/p/original/bBqQO3Z63tJ1DYo2XEipcSsdi1t.jpg"},{"id":48222,"name":"Emmy Wyda","role":"Thin Neighbor","profile":"https://image.tmdb.org/t/p/original/anyaMWy3zJD4ughOGQvrYIogz2K.jpg"},{"id":591199,"name":"Harald Madsen","role":"uncredited","profile":"https://image.tmdb.org/t/p/original/gaPNCHoVfVlBh0G1cduVol7L7X2.jpg"},{"id":591198,"name":"Carl Schenstrøm","role":"Wedding Musician","profile":"https://image.tmdb.org/t/p/original/e8rJKXjL38FlI01CLD2FHJ4YXfN.jpg"},{"id":82,"name":"Olaf Storm","role":"Young Guest","profile":"https://image.tmdb.org/t/p/original/xS5kAz8hax8kOSFO8QrbGpp0S4i.jpg"},{"id":38244,"name":"O.E. Hasse","role":"uncredited","profile":"https://image.tmdb.org/t/p/original/gbQudSFv6Io7W6mK5gSPfu8yJqm.jpg"},{"id":1543164,"name":"Neumann-Schüler","role":"uncredited"},{"id":1351084,"name":"Erich Schönfelder","role":"uncredited","profile":"https://image.tmdb.org/t/p/original/t7GwkKxEKjd0PQoG7Xogxw84xO0.jpg"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","title":"L'ultima risata","overview":"L'ormai anziano ed esperto usciere dell'Hotel Atlantic è orgoglioso della sua posizione, delle sue responsabilità e della sua livrea. Una notte piovosa e indaffarata si sta riposando brevemente dopo aver trasportato un pesante bagaglio sotto la pioggia e proprio in quel mentre viene sorpreso dal direttore. Il giorno seguente apprende di essere stato sostituito e declassato al ruolo umiliante di assistente alle pulizie. Sbalordito e umiliato, si sforza di riuscire a mandare avanti lo stesso la sua vita."},{"language":"en-US","title":"The Last Laugh","overview":"An aging doorman, after being fired from his prestigious job at a luxurious hotel, is forced to face the scorn of his friends, neighbours and society."},{"language":"de-DE","overview":"Berlin, Anfangs des 20. Jahrhunderts. Der alte Portier des Hotels \"Atlantic\" verdankt seiner prächtigen Uniform Selbstwertgefühl und Anerkennung: Vor der Drehtür des Hotels ist er stolzer Diener, der die Gäste begrüßt, zu Hause im Hinterhofmilieu ein viel bewunderter Mann. Doch eines Tages beobachtet der Geschäftsführer, wie schwer dem alten Portier das Hantieren mit den Koffern fällt: Er verbannt ihn daraufhin in den Keller, degradiert ihn zum Toilettenmann. In seinem Milieu wagt er nicht, den Abstieg einzugestehen. Als seine Tochter heiratet, stiehlt er die Uniform, um wenigstens hier den Schein zu wahren. Doch der Schwindel fliegt auf, er wird von seinen Hausbewohnern verlacht und gedemütigt, seine Verwandten wenden sich von ihm ab. Verzweifelt zieht sich der alte Mann in den Waschraum der Hoteltoilette zurück."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/v9T05eU3tlft7vN8PAEBE5o7fAR.jpg","background