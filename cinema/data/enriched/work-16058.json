 il destino gioca a un malcapitato mago che si ritrova ad essere ingaggiato a sua insaputa dal suo storico rivale in amore."},{"id":108929,"translatable_type":"title","translatable_id":6994,"locale":"it","key":"release_date","value":"2023-08-14"},{"id":108928,"translatable_type":"title","translatable_id":6994,"locale":"it","key":"slug","value":"i-peggiori-giorni"},{"id":108931,"translatable_type":"title","translatable_id":6994,"locale":"it","key":"views","value":"39048"}],"keywords":[{"id":8889,"name":"Film drammatici","created_at":"2023-05-27T10:36:44.000000Z","updated_at":"2023-05-27T10:36:44.000000Z","pivot":{"title_id":6994,"keyword_id":8889}},{"id":8910,"name":"Film commedia","created_at":"2023-05-28T11:56:13.000000Z","updated_at":"2023-05-28T11:56:13.000000Z","pivot":{"title_id":6994,"keyword_id":8910}},{"id":8961,"name":"Italiano","created_at":"2023-06-09T08:44:53.000000Z","updated_at":"2023-06-09T08:44:53.000000Z","pivot":{"title_id":6994,"keyword_id":8961}},{"id":9671,"name":"Film antologici","created_at":"2023-12-04T00:37:02.000000Z","updated_at":"2023-12-04T00:37:02.000000Z","pivot":{"title_id":6994,"keyword_id":9671}}]}}]},"images":[{"id":143912,"filename":"d64a8f71-7b0e-414a-b796-c5f258989484.webp","type":"poster","lang":"it","imageable_type":"title","imageable_id":6994,"created_at":"2024-12-04T10:29:14.000000Z","updated_at":"2025-05-12T09:25:24.000000Z","original_url_field":null,"reference":{"base":"streamingunity:images","path":"/images/d64a8f71-7b0e-414a-b796-c5f258989484.webp"},"provider":"streamingunity"},{"id":77344,"filename":"e6f6ef45-093c-451e-9bc3-19b2c12d8237.webp","type":"cover","lang":"it","imageable_type":"title","imageable_id":6994,"created_at":"2023-12-04T00:45:09.000000Z","updated_at":"2025-05-12T09:24:53.000000Z","original_url_field":null,"reference":{"base":"streamingunity:images","path":"/images/e6f6ef45-093c-451e-9bc3-19b2c12d8237.webp"},"provider":"streamingunity"},{"id":77341,"filename":"1abe349e-7bdc-4ca9-98df-1b72a0ae4f4d.webp",