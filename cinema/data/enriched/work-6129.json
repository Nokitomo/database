e":"Liu Xuan","profile":"https://image.tmdb.org/t/p/original/7WtSGIDnSkJEIDxXopAh68FWRJm.jpg"},{"id":3095557,"name":"Luo Yi","role":"Bai Xiaolin","profile":"https://image.tmdb.org/t/p/original/m8penGKLdI40is2plY2mgF5RN7G.jpg"},{"id":2565827,"name":"Wang Yizhou","role":"Li Yanliang","profile":"https://image.tmdb.org/t/p/original/zqL5WTtiF9eSI1dUYXwvHn10mXN.jpg"},{"id":3386343,"name":"Lu Yupeng","role":"Ma Qianli","profile":"https://image.tmdb.org/t/p/original/xuIgYZRrT9U1pJVVYzo3HCDKWsE.jpg"},{"id":2133763,"name":"Zhang Zhilu","role":"Ji Yuan","profile":"https://image.tmdb.org/t/p/original/hPXDCG6D9CPUyOAGZvYJFGCRd9l.jpg"},{"id":2082540,"name":"Zhou Yanchen","role":"Wang Dayin","profile":"https://image.tmdb.org/t/p/original/tO6R8vx3jJsaOhCRPE7PvGUWsU9.jpg"},{"id":1931226,"name":"Wang Ziwei","role":"Jiang Tong","profile":"https://image.tmdb.org/t/p/original/vLgKlbOZoHUkqx0k2rZsmjmRXfF.jpg"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","title":"Fuoco nel cuore","overview":"Huo Yan (Gong Jun) è un pompiere risoluto, dalla volontà ferrea, dotato di eccezionale forza, coraggio e determinazione, che lo hanno portato dalla condizione di studente della Civil Defence Academy a quella di astro nascente nel servizio antincendio e soccorso. In pochi anni, è riuscito a diventare vicecapitano della sua unità. Da quando ha sposato questo lavoro, però, nella sua mente non c'è mai stato il minimo spazio per il romanticismo e lui non ha mai provato attrazione neanche per una donna. Ma tutto cambia il fatidico giorno in cui il suo team è costretto a chiedere l'aiuto di un gruppo di medici del Pronto Soccorso. Tra questi ultimi lavora Yan Lan (Zhang Hui Wen), una frizzante, giovane dottoressa che, proprio come lui, è devota alla propria missione."},{"language":"en-US","title":"The Flaming Heart","overview":"A dedicated firefighter and a passionate doctor find their professional partnership igniting into unexpected romance as they face emergencies together."},{"language":"zh-CN","title":"你好，火焰蓝","overview":"霍言消防学院毕业，成为消防站的副站长。在一次剪拆出租车、营救孕妇事件中与急诊科医生晏蓝相识。两人的相识以误会开始，“老干部”霍言觉得“小太阳”晏蓝是自己生命中唯一的不确定因素，二人关系起起伏伏。一次地震事件的跨省增援中，霍言与晏蓝在目睹极端状况所激发出的种种生离死别后，二人的感情得到升华。消医联合让他们一起经历了营救养蜂人等一系列救援事件，有着医学理想的晏蓝为救死扶伤倾其所有，而霍言和其他所有曾经受过帮助的人都以各自的方式在背后默默支持着晏蓝。另一方面，新训消防员江桐渐渐喜欢上了看似退缩、怕事的消防员王大印。夹在家庭的极力反对和王大印的躲躲藏藏中，江桐想要探究王大印背后的故事，也在这个过程中让王大印慢慢成为了有使命感和责任心的男人。"}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/8UE4BoHjArDmvj4UH2xdrQpIFkH.jpg","background":"https://image.tmdb.org/t/p/original/4yPlznXqzMft6RjH6827SQuvohw.jpg","seasons":[{"seasonNumber":1,"name":{"value":"Stagione 1","language":"it-IT"},"year":2021,"episodeCount":24,"poster":"https://image.tmdb.org/t/p/original/8UE4BoHjArDmvj4UH2xdrQpIFkH.jpg","posters":[],"backgrounds":[],"sourceUrl":"https://www.themoviedb.org/tv/128699/season/1"}],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":128699,"type":"tv","originalLanguage":"zh-CN","series":{"poster":{"it":{"status":"missing","candidates":[]},"en":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/5CgcQRypLKD85syz8dXFYR7D3ar.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/5CgcQRypLKD85syz8dXFYR7D3ar.jpg","language":"en","width":2000,"height":3000},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/5CgcQRypLKD85syz8dXFYR7D3ar.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/5CgcQRypLKD85syz8dXFYR7D3ar.jpg","language":"en","width":2000,"height":3000},{"type":"poster","url":"https://image.tmdb.org/t/p/original/ahSobtp9gGP8WEORUZ8tnYdH6qG.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/ahSobtp9gGP8WEORUZ8tnYdH6qG.jpg","language":"en","width":960,"height":1440}]},"zh":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/8UE4BoHjArDmvj4UH2xdrQpIFkH.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/8UE4BoHjArDmvj4UH2xdrQpIFkH.jpg","language":"z