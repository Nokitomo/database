g"},{"id":142855,"name":"Tuba Büyüküstün","role":"Neval","profile":"https://image.tmdb.org/t/p/original/14QRLZqXAZglMB7Z25uXg6IG3LG.jpg"},{"id":98834,"name":"Nejat İşler","role":"Deniz","profile":"https://image.tmdb.org/t/p/original/xFhmBekB2odhRY335lJ6rWiIdyw.jpg"},{"id":96977,"name":"Mehmet Günsür","role":"Yusuf","profile":"https://image.tmdb.org/t/p/original/wwIYzgt3lBDrqinpzdvcUGmlK6A.jpg"},{"id":1607120,"name":"Çiğdem Selişik Onat","role":"Süreyya","profile":"https://image.tmdb.org/t/p/original/4J2AfYd000Ubj1iQTSEYaLmNOua.jpg"},{"id":1246608,"name":"Zerrin Tekindor","role":"Aylin","profile":"https://image.tmdb.org/t/p/original/7hzKdJuNDknwx4TLK4IrvloNrQ.jpg"},{"id":90317,"name":"Serra Yılmaz","role":"Sibel","profile":"https://image.tmdb.org/t/p/original/v7dI37lIuoEaQ0YlbImsoKzviZN.jpg"},{"id":1109362,"name":"Reha Özcan","role":"Ali","profile":"https://image.tmdb.org/t/p/original/gabSe1RiXKvCXy6X7amM9Y2cjue.jpg"},{"id":1434878,"name":"Ayten Gökçer","role":"Betül","profile":"https://image.tmdb.org/t/p/original/2UnfHUTCMBxp1fY8wM3xYfhRd6A.jpg"},{"id":1253158,"name":"Selim Bayraktar","role":"Ömer","profile":"https://image.tmdb.org/t/p/original/2c5JSkUqHpClGIH6UjvFjrYsnne.jpg"},{"id":1587469,"name":"Cemre Ebüzziya","role":"Sultan","profile":"https://image.tmdb.org/t/p/original/78oVGVWhghoSW6swSgFIgHXfhmq.jpg"},{"id":2679254,"name":"Yelin Bilgin","role":"Zeynep"},{"id":1048460,"name":"Nergis Öztürk","role":"Komiser","profile":"https://image.tmdb.org/t/p/original/igEAbtfmzAeBtUaMUAFMgILcxOf.jpg"},{"id":2566326,"name":"Gaye Su Akyol","role":"Parti Solisti","profile":"https://image.tmdb.org/t/p/original/iYUmo5yrdWaxPS3Ql7u8JzFNbqq.jpg"},{"id":1576308,"name":"İpek Bilgin","role":"Güzin","profile":"https://image.tmdb.org/t/p/original/cmFNIqTHgVzZG7wFjES9HMQs1fn.jpg"},{"id":1083398,"name":"Tuğrul Çetiner","role":"Oğuz","profile":"https://image.tmdb.org/t/p/original/bBTUS5HHz1etmCKL5rKzAnAWMly.jpg"},{"id":142769,"name":"Şerif Sezer","role":"Yusuf'un Annesi","profile":"https://image.tmdb.org/t/p/original/iNCTcx874hP31X1LmA74DuFDzY5.jpg"},{"id":145735,"name":"Rıza Kocaoğlu","role":"Kağıt Toplayıcı","profile":"https://image.tmdb.org/t/p/original/b0Bp9W1VIaVzCzzUCMwBc7fe005.jpg"},{"id":4798621,"name":"Salih Saygı","role":"Piyanist"}],"crew":[],"videos":[],"watchProviders":[],"episodeGroups":[],"translations":[{"language":"it-IT","title":"Rosso Istanbul","overview":"13 MAGGIO 2016. Orhan Sahin torna a Istanbul dopo 20 anni di assenza volontaria. Come editor deve aiutare Deniz Soysal, famoso regista cinematografico, a finire la scrittura del suo libro. Ma Orhan rimane intrappolato in una città carica di ricordi rimossi. Si ritrova sempre più coinvolto nei legami con i famigliari e gli amici di Deniz che sono anche i protagonisti del libro che il regista avrebbe dovuto finire. Soprattutto Neval e Yusuf, la donna e l’uomo a cui Deniz è più legato, entrano prepotentemente anche nella vita di Orhan. Quasi prigioniero nella storia di un altro, Orhan però finisce per indagare soprattutto su se stesso, riscoprendo emozioni e sentimenti che credeva morti per sempre e che invece tornano a chiedergli il conto per poter riuscire a cambiare la sua vita.","tagline":"Niente è più importante dell'amore"},{"language":"en-US","title":"Red Istanbul","overview":"Orhan who lived in London for years and did not come back to Turkey agrees to help Deniz -a famous director- edit his first book. Deniz has been living in a mansion with his family which started to lose its old brightness and power. Orhan finds himself in the middle of Deniz's complicated relationships, mysterious friends and stange family members. This is the first movie of Ferzan Ozpetek which is shot in Turkey after a long time. It is also based on his own book which has the same name with the movie.","tagline":"Nothing is more important than love."},{"language":"tr-TR","overview":"Orhan travmatik bir kayıptan sonra her şeyini kaybetmiş ve vahşi bir yaşama yönelmiş eski bir yazardır. Her şeyi bırakarak Londra’ya yerleşir ve editör olarak çalışmaya başlar. Yıllar sonra İstanbul’a geri döner. Bu geri dönüşün nedeni zamanını Paris, Londra ve Berlin’de geçirmiş ünlü yönetmen Deniz Soysal ile tanışmaktır. Deniz hem tarihi aile köşkünden annesini taşımak hem de yeni filmi için hazırlık yapmak için İstanbul’dadır. Deniz doğup büyüdüğü şehirdeki çocukluk anıların anlattığı bir kitap yazmıştır. Orhan’ın İstanbul’daki işi, yayınlanmadan önce kitaba son dokunuşları yapmaktır. Uzun yazışmalardan sonra İstanbul’da buluşurlar. Ancak ertesi sabah Deniz ortadan kaybolur. Orhan’ın gelişi ve Deniz’in ortadan kayboluşu ilginç bir rastlantıya işarettir. Gizli bir soruşturma başlatılır. Herkes Deniz’in bir daha geri dönmeyeceğinden endişelidir.","tagline":"Hiçbir şey aşktan daha önemli değildir."}],"images":{"logos":[],"posters":[],"backdrops":[]},"poster":"https://image.tmdb.org/t/p/original/bROOXcRwF61Wz4yLwInW4Uohkii.jpg","background":"https://image.tmdb.org/t/p/original/qa2Oonwq1hNews3snq0aWgL0w24.jpg","seasons":[],"schema":{}}},"artworkLibrary":{"tmdb":{"schemaVersion":1,"source":"tmdb","id":443486,"type":"movie","originalLanguage":"tr-TR","series":{"poster":{"it":{"status":"available","selected":{"type":"poster","url":"https://image.tmdb.org/t/p/original/bROOXcRwF61Wz4yLwInW4Uohkii.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/bROOXcRwF61Wz4yLwInW4Uohkii.jpg","language":"it","width":1400,"height":2100},"candidates":[{"type":"poster","url":"https://image.tmdb.org/t/p/original/bROOXcRwF61Wz4yLwInW4Uohkii.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/bROOXcRwF61Wz4yLwInW4Uohkii.jpg","language":"it","width":1400,"height":2100},{"type":"poster","url":"https://image.tmdb.org/t/p/original/Ad8uGQ3TXC6GGc8BAoipCz5i7oH.jpg","previewUrl":"https://image.tmdb.org/t/p/w300/Ad8uGQ3TXC6GGc8BAoipCz5i7oH.jpg","language":"it","width":700,"height":1050},{"type":"poster","url":"https://image.tmdb.org/t/p/original/d1OEKP3BCfsQFtyalGYbdsj7Xfm.jpg","previewUrl":"https://image.tmdb.org/t/