streamingunity:images","path":"/images/1cf5ed99-9109-4821-9503-788ef4641cf4.webp"},"provider":"streamingunity"},{"id":590649,"filename":"9ed2d40d-7372-43d7-bc38-90db8c58624c.webp","type":"cover_mobile","lang":"it","imageable_type":"title","imageable_id":49864,"created_at":"2026-01-05T02:27:27.000000Z","updated_at":"2026-01-05T02:27:27.000000Z","original_url_field":null,"reference":{"base":"streamingunity:images","path":"/images/9ed2d40d-7372-43d7-bc38-90db8c58624c.webp"},"provider":"streamingunity"}],"episodeMappingUncertain":false,"seasons":[],"provenance":{},"warnings":[],"externalIdsEvidence":{"wikidata":{"source":"wikidata","sourceUrl":"https://www.wikidata.org/wiki/Q387370","wikidataId":"Q387370","tmdbId":2690,"type":"movie","imdbId":"tt0057187","tvdbId":7864}},"externalMedia":{"tmdb":{"source":"tmdb-api","id":2690,"type":"movie","sourceUrl":"https://www.themoviedb.org/movie/2690","fetchedAt":"2026-11-07T16:50:50.443Z","originalLanguage":"en-US","title":{"value":"Irma la dolce","language":"it-IT"},"originalTitle":"Irma la Douce","overview":{"value":"Irma è una graziosa prostituta parigina, che trova l'amore vero incontrando Nestore, un poliziotto squattrinato; Irma però non vuole assolutamente abbandonare la \"professione\", infatti è per lei motivo di orgoglio poter mantenere Nestore con tutti gli agi possibili.  Nestore non è contento di questa decisione e, per limitare l'attività professionale di Irma, si traveste da  facoltoso lord, diventando presto il suo unico cliente. Per corrispondere quanto dovuto dal generoso Lord X però Nestore dovrà massacrarsi di lavoro notturno ai mercati generali delle Halles di Parigi. Quando però egli si accorge che la sua donna inizia ad innamorarsi del suo alter ego, decide di inscenare un finto suicidio per liberarsi della sua doppia personalità.  L'equivoco genera un'indagine della polizia francese, che accusa Nestore di omicidio, condannandolo a 15 anni di carcere.  Alla fine Nestore riuscirà ad evadere e, presentandosi nelle vesti di Lord X, dimostrerà così la sua innocenza e sposerà Irma.","language":"it-IT"},"tagline":{"value":"A story of passion, bloodshed, desire and death... everything, in fact, that makes life worth living.","language":"en-US"},"releaseDate":"1963-01-30","status":"Released","rating":7.4,"ratingCount":497,"genres":["Romance","Commedia"],"countries":["United States of America"],"facts":{"Runtime":"147m"},"keywords":[],"networks":[],"socialLinks":{},"cast":[{"id":4090,"name":"Shirley MacLaine","role":"Irma La Douce","profile":"https://image.tmdb.org/t/p/original/vU4QsP3GRj03S8Z92vrZfkdb7rO.jpg"},{"id":3151,"name":"Jack Lemmon","role":"Nestor Patou","profile":"https://image.tmdb.org/t/p/original/7jWVWLr1VJqQrN3d4YJaATCIHRw.jpg"},{"id":23708,"name":"Lou Jacobi","role":"Moustache","profile":"https://image.tmdb.org/t/p/original/xCm6ntT3faWFIr5IagDdeHtvRlv.jpg"},{"id":27034,"name":"Bruce Yarnell","role":"Hippolyte","profile":"https://image.tmdb.org/t/p/original/Aa6vOxmG7bQXvM6fEYU9x8BuyBt.jpg"},{"id":18860,"name":"Herschel Bernardi","role":"Inspector Lefevre","profile":"https://image.tmdb.org/t/p/original/bpsJvAsb2bRrcmGKIJJaQTwQqjl.jpg"},{"id":4097,"name":"Hope Holiday","role":"Lolita"},{"id":3161,"name":"Joan Shawlee","role":"Amazon Annie","profile":"https://image.tmdb.org/t/p/original/oUmK5YF1jcGs5eEGStI1I3iF5vd.jpg"},{"id":1759,"name":"Grace Lee Whitney","role":"Kiki","profile":"https://image.tmdb.org/t/p/original/3ItcKdBxe6rP7PeCg9lo7JoL2T4.jpg"},{"id":27035,"name":"Paul Dubov","role":"Andre","profile":"https://image.tmdb.org/t/p/original/16gXmonE03PgRmxhOFKsDn4nmqR.jpg"},{"id":19786,"name":"Howard McNear","role":"Concierge","profile":"https://image.tmdb.org/t/p/original/jCs4yOWiWMLi3a9F7Rew3KlKUFW.jpg"},{"id":14834,"name":"Cliff Osmond","role":"Police Sergeant","profile":"https://image.tmdb.org/t/p/original/y7MZ3R1zw4a2hr6hLpNMTGjeXvG.jpg"},{"id":164843,"name":"Diki Lerner","role":"Jojo"},{"id":2729390,"name":"Herb Jones","role":"Casablanca Charlie"},{"id":2729