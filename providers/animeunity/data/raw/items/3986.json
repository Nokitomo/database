 due ventunenni amici pro-wrestler della Jipang Pro Wrestling, una sigla indipendente. Un giorno però la compagnia viene assorbita dalla GWM, una grande federazione, e da quel momento in poi le loro vite prendono strade diverse. Azuma viene trasformato nel nuovo Tiger Mask, mentre Takuma, dopo aver subito un infortunio, cerca vendetta nei confronti della GWM, entrando nella nuova Tana delle Tigri, che ha ora sede negli Stati Uniti, e diventando l'oscuro Tiger the Dark.","date":"2016","episodes_count":38,"episodes_length":24,"author":" ","created_at":"2019-11-07 16:17:50","status":"Terminato","imageurl_cover":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/21682-WjVh82Dx9WrP.jpg","type":"TV","slug":"tiger-mask-w","title_eng":"Tiger Mask W","day":"Sabato","favorites":55,"score":"7.32","visite":98957,"studio":"Toei Animation","dub":0,"always_home":0,"members":231,"cover":null,"anilist_id":21682,"season":"Autunno","title_it":null,"mal_id":32881,"crunchy_id":null,"netflix_id":null,"prime_id":null,"disney_id":null,"pivot":{"anime_id":3986,"related_id":1761,"number":1}}]},"htmlError":null,"episodes":[{"id":64675,"anime_id":3986,"user_id":2,"number":"1","created_at":"2022-08-28 19:26:12","link":"https://www.angel-beats.eu/DDL/ANIME/TigerMan/TigerMan_Ep_001_ITA.mp4","visite":27119,"hidden":0,"public":1,"scws_id":131739,"file_name":"TigerMan_Ep_001_ITA.mp4","tg_post":0},{"id":64676,"anime_id":3986,"user_id":2,"number":"2","created_at":"2022-08-28 19:26:14","link":"https://www.angel-beats.eu/DDL/ANIME/TigerMan/TigerMan_Ep_002_ITA.mp4","visite":8613,"hidden":0,"public":1,"scws_id":131740,"file_name":"TigerMan_Ep_002_ITA.mp4","tg_post":0},{"id":64677,"anime_id":3986,"user_id":2,"number":"3","created_at":"2022-08-28 19:26:17","link":"https://www.angel-beats.eu/DDL/ANIME/TigerMan/TigerMan_Ep_003_ITA.mp4","visite":6807,"hidden":0,"public":1,"scws_id":131741,"file_name":"TigerMan_Ep_003_ITA.mp4","tg_post":0},{"id":64678,"anime_id":3986,"user_id":2,"number":"4","created_at"