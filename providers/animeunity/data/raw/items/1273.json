parità\" privando del loro dominio tutti i dominatori. Durante la sua permanenza in città, Korra conosce Mako e Bolin, due fratelli orfani che lottano nel campionato di Dominio Sportivo: Mako domina il Fuoco mentre Bolin la Terra. Korra si innamorerà di Mako, ma tra loro si inserirà Asami Sato, la figlia del più potente industriale di Città della Repubblica, che li aiuterà nella lotta contro il subdolo Amon.","date":"2012","episodes_count":52,"episodes_length":22,"author":" ","created_at":"2019-08-08 12:53:08","status":"Terminato","imageurl_cover":"","type":"TV","slug":"avatar-la-leggenda-di-korra-ita","title_eng":"Avatar - La leggenda di Korra (ITA)","day":"Lunedì","favorites":244,"score":"8.10","visite":965892,"studio":"Nickelodeon Animation Studio","dub":1,"always_home":0,"members":1452,"cover":null,"anilist_id":null,"season":"Primavera","title_it":null,"mal_id":null,"crunchy_id":null,"netflix_id":null,"prime_id":null,"disney_id":null,"pivot":{"anime_id":1273,"related_id":1274,"number":1}}]},"htmlError":null,"episodes":[{"id":24253,"anime_id":1273,"user_id":null,"number":"1","created_at":"2019-08-08 12:13:24","link":"https://server16.streamingaw.online/DDL/ANIME/AvatarLaLeggendaDiAang/AvatarLaLeggendaDiAang_Ep_01_ITA.mp4","visite":71728,"hidden":0,"public":1,"scws_id":64519,"file_name":"AvatarLaLeggendaDiAang_Ep_01_ITA.mp4","tg_post":0},{"id":24254,"anime_id":1273,"user_id":null,"number":"2","created_at":"2019-08-08 12:13:24","link":"https://server16.streamingaw.online/DDL/ANIME/AvatarLaLeggendaDiAang/AvatarLaLeggendaDiAang_Ep_02_ITA.mp4","visite":28970,"hidden":0,"public":1,"scws_id":64520,"file_name":"AvatarLaLeggendaDiAang_Ep_02_ITA.mp4","tg_post":0},{"id":24263,"anime_id":1273,"user_id":null,"number":"3","created_at":"2019-08-08 12:13:24","link":"https://server16.streamingaw.online/DDL/ANIME/AvatarLaLeggendaDiAang/AvatarLaLeggendaDiAang_Ep_03_ITA.mp4","visite":27456,"hidden":0,"public":1,"scws_id":64521,"file_name":"AvatarLaLeggendaDiAang_Ep_03_ITA.mp4","tg_p