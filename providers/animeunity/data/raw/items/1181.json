to. Nel mondo delle lettere, Logos World, sta accadendo un fenomeno anormale che influenza anche il mondo reale. Akira Kaibuki e gli altri del club Sōsei affrontano la crisi del mondo svelando il significato contenuto nelle lettere.","date":"2015","episodes_count":26,"episodes_length":24,"author":" ","created_at":"2019-07-18 23:24:01","status":"Terminato","imageurl_cover":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/21115-y7ll8s8Vo3Bn.jpg","type":"TV","slug":"aquarion-logos","title_eng":"Aquarion Logos","day":"Giovedì","favorites":41,"score":"6.47","visite":31929,"studio":"Satelight","dub":0,"always_home":0,"members":235,"cover":null,"anilist_id":21115,"season":"Estate","title_it":null,"mal_id":30382,"crunchy_id":null,"netflix_id":null,"prime_id":null,"disney_id":null,"pivot":{"anime_id":1181,"related_id":1182,"number":1}},{"id":5885,"user_id":2,"title":"Sousei no Aquarion: Myth of Emotions","imageurl":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/bx162921-ByoCP2VvLjeT.jpg","plot":"Quarta serie per il franchise di Aquarion.","date":"2025","episodes_count":12,"episodes_length":23,"author":" ","created_at":"2025-01-09 18:51:37","status":"Terminato","imageurl_cover":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/162921-2OyrSo97wZnX.jpg","type":"TV","slug":"aquarion-myth-of-emotions","title_eng":"Aquarion: Myth of Emotions","day":"Giovedì","favorites":20,"score":"6.25","visite":31962,"studio":"Satelight","dub":0,"always_home":1,"members":89,"cover":"https://img.animeworld.so/copertine/ijaT6.png","anilist_id":162921,"season":"Inverno","title_it":null,"mal_id":54769,"crunchy_id":"G3KHEVDDD","netflix_id":null,"prime_id":null,"disney_id":null,"pivot":{"anime_id":1181,"related_id":5885,"number":1}}]},"htmlError":null,"episodes":[{"id":22773,"anime_id":1181,"user_id":null,"number":"1-2","created_at":"2019-07-18 23:43:36","link":"https://www.asobiasobase.it/DLL/ANIME/AquarionEvol/AquarionEvol_Ep_01_02_SUB_ITA.mp4","visite":34706,"hidde