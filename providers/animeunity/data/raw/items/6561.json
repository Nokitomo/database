null,"disney_id":null,"genres":[{"id":9,"name":"Fantasy","pivot":{"anime_id":6561,"genre_id":9}},{"id":57,"name":"Mahou Shoujo","pivot":{"anime_id":6561,"genre_id":57}}],"related":[{"id":6560,"user_id":2,"title":"Mahou no Princess Minky Momo","imageurl":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/bx518-wOLKHgeKCJvj.png","plot":"Minky Momo (Gigì in Italia) è la piccola principessa del regno di Fenarinarsa, una dimensione retta dai sogni degli umani, che anticamente era unita al nostro mondo ma vi si è distaccata una volta che gli umani hanno smesso di sognare. La ragazzina viene inviata sulla Terra con la missione di far tornare a sognare gli esseri umani in modo da poter riavvicinare i due mondi. Adottata da una coppia di genitori terrestri, la piccola vive diverse avventure tra sogno e realtà insieme agli amici animali che la accompagnano nella sua missione: il cane Shindobuk (Bonky in Italia), la scimmietta Moccha (Cocò in Italia) e l'uccellino Pipil (YunYun in Italia). Grazie ad una bacchetta magica, può trasformarsi in un'adulta in grado di svolgere qualsiasi professione, e così facendo aiuterà sia gli esseri umani che le creature fantastiche di Fenarinarsa a risolvere i loro problemi.","date":"1982","episodes_count":63,"episodes_length":22,"author":" ","created_at":"2025-04-19 08:38:12","status":"Terminato","imageurl_cover":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/518-VIYAridDDobP.jpg","type":"TV","slug":"il-magico-mondo-di-gigi","title_eng":"Il magico mondo di Gigì","day":"Indeterminato","favorites":13,"score":"7.80","visite":5373,"studio":"Ashi Productions","dub":0,"always_home":0,"members":45,"cover":null,"anilist_id":518,"season":"Primavera","title_it":"Fairy Princess Minky Momo","mal_id":518,"crunchy_id":null,"netflix_id":null,"prime_id":null,"disney_id":null,"pivot":{"anime_id":6561,"related_id":6560,"number":1}},{"id":6561,"user_id":2,"title":"Mahou no Princess Minky Momo: Yume wo Dakishimete","imageurl":"https://s4.a