onfitto e distrutto.\r\n\r\nNegli ultimi tredici episodi della serie, Lief, Barda e Jasmine decidono di lasciare la città di Del e viaggiare per Deltora distruggendo gli Ol che non sono scomparsi insieme al Signore dell'Ombra. Completata la missione, Lief torna a palazzo venendo incoronato nuovo re di Deltora.","date":"2007","episodes_count":52,"episodes_length":25,"author":" ","created_at":"2019-08-30 14:56:36","status":"Terminato","imageurl_cover":"","type":"TV","slug":"deltora-quest-ita","title_eng":"Deltora Quest (ITA)","day":"Indeterminato","favorites":93,"score":"7.94","visite":96685,"studio":"Oriental Light and Magic","dub":1,"always_home":0,"members":464,"cover":null,"anilist_id":1826,"season":"Inverno","title_it":null,"mal_id":1826,"crunchy_id":null,"netflix_id":null,"prime_id":null,"disney_id":null,"genres":[{"id":21,"name":"Adventure","pivot":{"anime_id":1417,"genre_id":21}},{"id":9,"name":"Fantasy","pivot":{"anime_id":1417,"genre_id":9}},{"id":14,"name":"Kids","pivot":{"anime_id":1417,"genre_id":14}}],"related":[]},"htmlError":null,"episodes":[{"id":27145,"anime_id":1417,"user_id":null,"number":"1","created_at":"2019-08-30 15:07:06","link":"https://www.animestone.cloud/DDL/ANIME/DeltoraQuest/DeltoraQuest_Ep_01_ITA.mp4","visite":18670,"hidden":0,"public":1,"scws_id":124434,"file_name":"DeltoraQuest_Ep_01_ITA.mp4","tg_post":0},{"id":27144,"anime_id":1417,"user_id":null,"number":"2","created_at":"2019-08-30 15:07:06","link":"https://www.animestone.cloud/DDL/ANIME/DeltoraQuest/DeltoraQuest_Ep_02_ITA.mp4","visite":3319,"hidden":0,"public":1,"scws_id":124435,"file_name":"DeltoraQuest_Ep_02_ITA.mp4","tg_post":0},{"id":27149,"anime_id":1417,"user_id":null,"number":"3","created_at":"2019-08-30 15:07:06","link":"https://www.animestone.cloud/DDL/ANIME/DeltoraQuest/DeltoraQuest_Ep_03_ITA.mp4","visite":2737,"hidden":0,"public":1,"scws_id":124437,"file_name":"DeltoraQuest_Ep_03_ITA.mp4","tg_post":0},{"id":27150,"anime_id":1417,"user_id":null,"number":"4","created_at":