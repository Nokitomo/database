erciti a perdere qualcosa di davvero prezioso nella battaglia di Anegawa. Ed è proprio in questo terribile scenario che Chidori si risveglia. Per unire il paese, sono richiesti grandi sacrifici, persino combattere contro il proprio sangue! Si entra finalmente nell'arco Anegawa/Ishiyama!","date":"2018","episodes_count":26,"episodes_length":4,"author":" ","created_at":"2024-08-08 21:45:42","status":"Terminato","imageurl_cover":"","type":"TV Short","slug":"ninja-girl-samurai-master-3","title_eng":"Ninja Girl & Samurai Master 3","day":"Venerdì","favorites":4,"score":"8.25","visite":2845,"studio":"TMS Entertainment","dub":0,"always_home":0,"members":10,"cover":null,"anilist_id":100966,"season":"Primavera","title_it":null,"mal_id":37126,"crunchy_id":null,"netflix_id":null,"prime_id":null,"disney_id":null,"pivot":{"anime_id":5517,"related_id":5518,"number":1}}]},"htmlError":null,"episodes":[{"id":83911,"anime_id":5517,"user_id":2,"number":"1","created_at":"2024-08-08 21:44:55","link":"https://srv22-ayaka.sweetpixel.org/DDL/ANIME/NobunagaNoShinobi/NobunagaNoShinobi_Ep_01_SUB_ITA.mp4","visite":2573,"hidden":0,"public":1,"scws_id":253041,"file_name":"NobunagaNoShinobi_Ep_01_SUB_ITA.mp4","tg_post":0},{"id":83912,"anime_id":5517,"user_id":2,"number":"2","created_at":"2024-08-08 21:44:55","link":"https://srv22-ayaka.sweetpixel.org/DDL/ANIME/NobunagaNoShinobi/NobunagaNoShinobi_Ep_02_SUB_ITA.mp4","visite":102,"hidden":0,"public":1,"scws_id":253042,"file_name":"NobunagaNoShinobi_Ep_02_SUB_ITA.mp4","tg_post":0},{"id":83913,"anime_id":5517,"user_id":2,"number":"3","created_at":"2024-08-08 21:44:56","link":"https://srv22-ayaka.sweetpixel.org/DDL/ANIME/NobunagaNoShinobi/NobunagaNoShinobi_Ep_03_SUB_ITA.mp4","visite":77,"hidden":0,"public":1,"scws_id":253043,"file_name":"NobunagaNoShinobi_Ep_03_SUB_ITA.mp4","tg_post":0},{"id":83915,"anime_id":5517,"user_id":2,"number":"4","created_at":"2024-08-08 21:44:57","link":"https://srv22-ayaka.sweetpixel.org/DDL/ANIME/NobunagaNoShinobi/NobunagaNoS