 il medium che permette alla bambola di prendere vita, e di battaglia in battaglia, inesorabilmente, anche ad affrontare e risolvere i suoi problemi personali fino a riguadagnare finalmente la serenità  di un tempo. Risolta però la situazione personale di Jun, ancora molti sembrano i misteri legati all'Alice Game e alle misteriose bambole di Rozen: ecco quindi tornare anche gli altri vecchi personaggi della prima serie, come la graziosa Hina Ichigo o la perfida Suiseiseki accompagnata dal più misurato fratello Souseiseki, tutti in forze al seguito di quella che è stata una prima stagione di successo.","date":"2013","episodes_count":13,"episodes_length":24,"author":" ","created_at":"2023-03-17 20:57:47","status":"Terminato","imageurl_cover":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/18041-oglVd4aPy9zF.jpg","type":"TV","slug":"rozen-maiden-2013","title_eng":"Rozen Maiden (2013)","day":"Indeterminato","favorites":15,"score":"7.41","visite":10785,"studio":"Studio Deen","dub":0,"always_home":0,"members":143,"cover":null,"anilist_id":18041,"season":"Estate","title_it":null,"mal_id":18041,"crunchy_id":null,"netflix_id":null,"prime_id":null,"disney_id":null,"pivot":{"anime_id":6937,"related_id":4484,"number":1}}]},"htmlError":null,"episodes":[{"id":99777,"anime_id":6937,"user_id":2,"number":"1","created_at":"2025-08-01 11:23:40","link":"[AnimeSaga]  Rozen Maiden - 01 [E2605F04].avi","visite":6197,"hidden":0,"public":1,"scws_id":331960,"file_name":"[AnimeSaga]  Rozen Maiden - 01 [E2605F04].avi","tg_post":0},{"id":99778,"anime_id":6937,"user_id":2,"number":"2","created_at":"2025-08-01 11:23:41","link":"[AnimeSaga]  Rozen Maiden - 02 [65D52FB7].avi","visite":504,"hidden":0,"public":1,"scws_id":331961,"file_name":"[AnimeSaga]  Rozen Maiden - 02 [65D52FB7].avi","tg_post":0},{"id":99779,"anime_id":6937,"user_id":2,"number":"3","created_at":"2025-08-01 11:23:41","link":"[AnimeSaga]  Rozen Maiden - 03 [09E27833].avi","visite":400,"hidden":0,"public":1,"scws_id":33196