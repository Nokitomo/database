ki!)","date":"2020","episodes_count":1,"episodes_length":85,"author":" ","created_at":"2020-09-22 22:50:27","status":"Terminato","imageurl_cover":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/109171-EhGBzwDvN3ZT.jpg","type":"Movie","slug":"saezuru-tori-wa-habatakanai-the-clouds-gather","title_eng":"Saezuru Tori wa Habatakanai: The Clouds Gather","day":"Indeterminato","favorites":182,"score":"7.82","visite":51297,"studio":"GRIZZLY","dub":0,"always_home":1,"members":1052,"cover":null,"anilist_id":109171,"season":"Inverno","title_it":null,"mal_id":39761,"crunchy_id":null,"netflix_id":null,"prime_id":null,"disney_id":null,"pivot":{"anime_id":3191,"related_id":2779,"number":1}},{"id":3191,"user_id":78495,"title":"Saezuru Tori wa Habatakanai: Don't Stay Gold","imageurl":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/bx115567-iVP26dCe4Vwo.jpg","plot":"Adattamento animato della short-story \"Don't Stay Gold\" inclusa nel volume 7 del manga.","date":"2021","episodes_count":1,"episodes_length":24,"author":" ","created_at":"2021-08-14 19:58:17","status":"Terminato","imageurl_cover":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/115567-8hMWE9NCRS0e.jpg","type":"OVA","slug":"twittering-birds-never-fly-ova","title_eng":"Twittering Birds Never Fly OVA","day":"Indeterminato","favorites":78,"score":"7.80","visite":33760,"studio":"GRIZZLY","dub":0,"always_home":0,"members":440,"cover":null,"anilist_id":115567,"season":"Inverno","title_it":null,"mal_id":41290,"crunchy_id":null,"netflix_id":null,"prime_id":null,"disney_id":null,"pivot":{"anime_id":3191,"related_id":3191,"number":1}}]},"htmlError":null,"episodes":[{"id":53227,"anime_id":3191,"user_id":2,"number":"1","created_at":"2021-08-14 19:58:52","link":"https://server6.streamingaw.online/DDL/ANIME/SaezuruToriWaHabatakanaiDontStayGold/SaezuruToriWaHabatakanaiDontStayGold_OVA_SUB_ITA_v0.mp4","visite":33760,"hidden":0,"public":1,"scws_id":154471,"file_name":"SaezuruToriWaHabatakanaiDontStayGold_