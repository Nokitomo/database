anguage":"it-IT"},"runtimeMinutes":25,"rating":6.5,"thumbnail":"https://image.tmdb.org/t/p/w300/haEvWP4gyMLgZrKaOANCZ2aBuND.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/haEvWP4gyMLgZrKaOANCZ2aBuND.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/45857/season/1/episode/25"},{"id":"904841","seasonNumber":1,"episodeNumber":26,"title":{"value":"La fine e l'inizio","language":"it-IT"},"overview":{"value":"Tsuna comprende il potere del nuovo proiettile e degli X Gloves generati da Leon e si appresta ad affrontare Mukuro.","language":"it-IT"},"airDateText":{"value":"2007-04-07","language":"it-IT"},"runtimeMinutes":25,"rating":6.5,"thumbnail":"https://image.tmdb.org/t/p/w300/t2oDMOtiQe4ogvZ9TQrGfqF8DLS.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/t2oDMOtiQe4ogvZ9TQrGfqF8DLS.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/45857/season/1/episode/26"},{"id":"904844","seasonNumber":1,"episodeNumber":27,"title":{"value":"Sushi per tutti","language":"it-IT"},"overview":{"value":"Inizia il secondo anno scolastico per Tsuna e Famiglia, ma ognuno è finito in una sezione diversa. Reborn decide di dare la possibilita' ai ragazzi di tornare nella stessa sezione, ma a patto che vincano una sfida.","language":"it-IT"},"airDateText":{"value":"2007-04-14","language":"it-IT"},"runtimeMinutes":25,"rating":6.5,"thumbnail":"https://image.tmdb.org/t/p/w300/8qrTvgpVFSYRFWQ73IjsO62kVn8.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/8qrTvgpVFSYRFWQ73IjsO62kVn8.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/45857/season/1/episode/27"},{"id":"904843","seasonNumber":1,"episodeNumber":28,"title":{"value":"Ipotesi di reato","language":"it-IT"},"overview":{"value":"Tsuna si sveglia una domenica felice perché di lì a poco riceverà una visita di Kyoko, ma si accorge che sul suo letto c'è un cadavere. A detta di Reborn, è stato proprio il ragazzo a farlo fuori!","language":"it-IT"},"airDateText":{"value":"2007-04-21","language":"it-IT"},"runtimeMinutes":25,"rating":6.5,"thumbnail":"https://image.tmdb.org/t/p/w300/yJlP5ae79IqsOoYIjrgcW3OgjZU.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/yJlP5ae79IqsOoYIjrgcW3OgjZU.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/45857/season/1/episode/28"},{"id":"904845","seasonNumber":1,"episodeNumber":29,"title":{"value":"Scambio di personalità","language":"it-IT"},"overview":{"value":"Nel solito caos a casa di Tsuna, Lambo danneggia il suo bazooka e poi si trasforma: appare Lambo adulto ma con il carattere della sua versione bambino.","language":"it-IT"},"airDateText":{"value":"2007-04-28","language":"it-IT"},"runtimeMinutes":25,"rating":6.5,"thumbnail":"https://image.tmdb.org/t/p/w300/1rN1QPgL3H1lMgOxshNq7GKqYzl.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/1rN1QPgL3H1lMgOxshNq7GKqYzl.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/45857/season/1/episode/29"},{"id":"904846","seasonNumber":1,"episodeNumber":30,"title":{"value":"Tutti in crociera","language":"it-IT"},"overview":{"value":"Tsuna e sua madre vincono una crociera che li porterà su una stupenda isola tropicale. La tranquillità dura pochissimo, infatti si ritrovano sulla nave tutta la banda di scalmanati.","language":"it-IT"},"airDateText":{"value":"2007-05-05","language":"it-IT"},"runtimeMinutes":25,"rating":6.5,"thumbnail":"https://image.tmdb.org/t/p/w300/fNMdVODPYzPm4AAb0Arzw7wFO2f.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/fNMdVODPYzPm4AAb0Arzw7wFO2f.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/45857/season/1/episode/30"},{"id":"904847","seasonNumber":1,"episodeNumber":31,"title":{"value":"Benvenuti a Mafialand","language":"it-IT"},"overview":{"value":"Tsuna e i suoi amici vengono portati al parco divertimenti “Mafialand” da Reborn. Tuttavia, durante questa gita, Tsuna dovrà affrontare alcune prove per dimostrare di essere un vero boss.","language":"it-IT"},"airDateText":{"value":"2007-05-12","language":"it-IT"},"runtimeMinutes":25,"rating":6.5,"thumbnail":"https://image.tmdb.org/t/p/w300/8wyr0rbBcggEjwVfBXesYeBHzmE.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/8wyr0rbBcggEjwVfBXesYeBHzmE.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/45857/season/1/episode/31"},{"id":"904851","seasonNumber":1,"episodeNumber":32,"title":{"value":"Uno squalo in piscina","language":"it-IT"},"overview":{"value":"Tsuna deve imparare a nuotare e i suoi amici si offrono di aiutarlo. Ma, come prevedibile, i loro metodi si rivelano alquanto particolari.","language":"it-IT"},"airDateText":{"value":"2007-05-19","language":"it-IT"},"runtimeMinutes":25,"rating":6.5,"thumbnail":"https://image.tmdb.org/t/p/w300/eJOYWpfkDxHLkNT7N4N3ggONOvY.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/eJOYWpfkDxHLkNT7N4N3ggONOvY.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/45857/season/1/episode/32"},{"id":"904848","seasonNumber":1,"episodeNumber":33,"title":{"value":"Un'estate nel debito","language":"it-IT"},"overview":{"value":"Per ripagare i danni causati allo scivolo della piscina, Tsuna e i suoi amici devono lavorare come bagnini insieme a Ryohei, solo che vengono sfidati a una gara di nuoto dai suoi senpai.","language":"it-IT"},"airDateText":{"value":"2007-05-26","language":"it-IT"},"runtimeMinutes":25,"rating":6.5,"thumbnail":"https://image.tmdb.org/t/p/w300/nt7opMXDEc7ZL75GkaYqmE6TMIJ.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/nt7opMXDEc7ZL75GkaYqmE6TMIJ.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/45857/season/1/episode/33"}],"sourceUrl":"https://www.themoviedb.org/tv/45857/season/1"},"failure":null,"fields":{},"episodes":{"1":{"checkedAt":1793480574467,"status":"ok","retryCount":0},"2":{"checkedAt":1793480574467,"status":"ok","retryCount":0},"3"