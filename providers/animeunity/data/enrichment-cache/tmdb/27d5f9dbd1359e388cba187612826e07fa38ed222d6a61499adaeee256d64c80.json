{"schemaVersion":1,"source":"tmdb","kind":"episodes","input":{"mediaId":63525,"seasonNumber":1},"checkedAt":1793447432976,"status":"ok","retryCount":0,"value":{"seasonNumber":1,"name":{"value":"Stagione 1","language":"it-IT"},"year":2013,"episodeCount":12,"poster":"https://image.tmdb.org/t/p/original/5LY7socoCOS9zfGQW4ZFaeJNIoF.jpg","posters":[],"backgrounds":[],"episodes":[{"id":"1094979","seasonNumber":1,"episodeNumber":1,"title":{"value":"Episodio 1","language":"it-IT"},"overview":{"value":"After long years of war, peace has finally come to Gamindustri. As usual, though, the goddess of Planeptune is a little TOO peaceful--gaming is so much more fun than running a country! With the Console Wars over, will the next war be Neptune vs. inertia?!","language":"en-US"},"airDateText":{"value":"2013-07-12","language":"it-IT"},"runtimeMinutes":24,"rating":7,"thumbnail":"https://image.tmdb.org/t/p/w300/bpY4bWLKuIMyXKPv8nFvCqPzBSm.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/bpY4bWLKuIMyXKPv8nFvCqPzBSm.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/63525/season/1/episode/1"},{"id":"1094983","seasonNumber":1,"episodeNumber":2,"title":{"value":"Episodio 2","language":"it-IT"},"overview":{"value":"A day at the amusement park takes a sinister turn when two (mostly) innocent girls are kidnapped by a monster. And then a stranger with a camera crew barges into the Basilicom, and things kinda start to get weird.","language":"en-US"},"airDateText":{"value":"2013-07-19","language":"it-IT"},"runtimeMinutes":24,"rating":7,"thumbnail":"https://image.tmdb.org/t/p/w300/aVWEN4ecncHhwnMFelETTVPf3zE.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/aVWEN4ecncHhwnMFelETTVPf3zE.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/63525/season/1/episode/2"},{"id":"1094984","seasonNumber":1,"episodeNumber":3,"title":{"value":"Episodio 3","language":"it-IT"},"overview":{"value":"Vert offers to throw all the goddes