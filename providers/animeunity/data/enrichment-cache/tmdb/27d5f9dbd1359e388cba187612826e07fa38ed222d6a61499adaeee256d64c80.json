iedb.org/tv/63525/season/1/episode/5"},{"id":"1094988","seasonNumber":1,"episodeNumber":6,"title":{"value":"Episodio 6","language":"it-IT"},"overview":{"value":"Noire's up to something at night behind closed doors, and Uni's dying to know what it is. Luckily, she's got tech expert Nepgear to help her out. But as it turns out, Uni's not the only one interested in what Noire's doing.","language":"en-US"},"airDateText":{"value":"2013-08-16","language":"it-IT"},"runtimeMinutes":24,"rating":7,"thumbnail":"https://image.tmdb.org/t/p/w300/2PL4LsOkrLWi5a8Npn2XTizBzL3.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/2PL4LsOkrLWi5a8Npn2XTizBzL3.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/63525/season/1/episode/6"},{"id":"1094989","seasonNumber":1,"episodeNumber":7,"title":{"value":"Episodio 7","language":"it-IT"},"overview":{"value":"The gang learns more about Plutia, and Neptune's very worst, most hated enemy appears.","language":"en-US"},"airDateText":{"value":"2013-08-23","language":"it-IT"},"runtimeMinutes":24,"rating":7,"thumbnail":"https://image.tmdb.org/t/p/w300/zRLFZsFrkxh3TCMvPt8jWnkuz1m.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/zRLFZsFrkxh3TCMvPt8jWnkuz1m.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/63525/season/1/episode/7"},{"id":"1094991","seasonNumber":1,"episodeNumber":8,"title":{"value":"Episodio 8","language":"it-IT"},"overview":{"value":"The CPUs visit an adults-only island full of forbidden pleasures--for work reasons, of course. Meanwhile, Peashy is stuck at home sulking after a fight with Neptune.","language":"en-US"},"airDateText":{"value":"2013-08-30","language":"it-IT"},"runtimeMinutes":24,"rating":7,"thumbnail":"https://image.tmdb.org/t/p/w300/iOso9fMRRij7NYkYjEoyhlZbwe3.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/iOso9fMRRij7NYkYjEoyhlZbwe3.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/63525/season/1/ep