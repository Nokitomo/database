.org/tv/129599/season/1/episode/43"},{"id":"3821312","seasonNumber":1,"episodeNumber":44,"title":{"value":"Episodio 44","language":"it-IT"},"overview":{"value":"Miruki wants to unlock her Heavens Form right NOW! But the Element who just came calling has a rather odd request. Is changing who she is really worth all this!?","language":"en-US"},"airDateText":{"value":"2022-08-21","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/y0C61XQIVNb5RWIHuoQn742SivE.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/y0C61XQIVNb5RWIHuoQn742SivE.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/129599/season/1/episode/44"},{"id":"3821313","seasonNumber":1,"episodeNumber":45,"title":{"value":"Episodio 45","language":"it-IT"},"overview":{"value":"To reach Jennifer, the PriMagi Superstars need an unprecedented amount of Waccha. Can Auru help them manage this very charged situation?","language":"en-US"},"airDateText":{"value":"2022-08-28","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/dxkJU9SgJrIZ5DREHvWFqf4lHKo.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/dxkJU9SgJrIZ5DREHvWFqf4lHKo.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/129599/season/1/episode/45"},{"id":"3821314","seasonNumber":1,"episodeNumber":46,"title":{"value":"Episodio 46","language":"it-IT"},"overview":{"value":"To reach Jennifer, they’ll need part of a powerful gem from the Magical Realm. But there are conditions that must be met before it’s handed over.","language":"en-US"},"airDateText":{"value":"2022-09-04","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/cLRPk5G90BBTHOYwJpzjf18H6Cw.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/cLRPk5G90BBTHOYwJpzjf18H6Cw.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/129599/season/1/episode/46"},{"id":"3821315","seasonNumber":1,"episodeNumber":47,"title":{"value":"Episodio 47","language":"it-IT"},"overview":{"value":"The PriMagi Superstars are all set to perform while wearing their legendary Heavens Ensembles! It’s the moment they’ve been waiting for, but pressure is mounting…","language":"en-US"},"airDateText":{"value":"2022-09-11","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/wozGknDem3RJBjwKiCq9SUIqkUY.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/wozGknDem3RJBjwKiCq9SUIqkUY.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/129599/season/1/episode/47"},{"id":"3821316","seasonNumber":1,"episodeNumber":48,"title":{"value":"Episodio 48","language":"it-IT"},"overview":{"value":"The Euphoria Revue is now open, and it will take everyone working in concert to pull off the performance of a lifetime!","language":"en-US"},"airDateText":{"value":"2022-09-18","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/tUomC5O7ddcZsBSUFBUKjoyv17D.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/tUomC5O7ddcZsBSUFBUKjoyv17D.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/129599/season/1/episode/48"},{"id":"3821317","seasonNumber":1,"episodeNumber":49,"title":{"value":"Episodio 49","language":"it-IT"},"overview":{"value":"The fate of the PriMagi is at stake, and a final confrontation will decide the future of Matsuri’s favorite stage forevermore.","language":"en-US"},"airDateText":{"value":"2022-09-25","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/4TLR3GgToGdrYv3dNFcnO0U2WHv.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/4TLR3GgToGdrYv3dNFcnO0U2WHv.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/129599/season/1/episode/49"},{"id":"3965716","seasonNumber":1,"episodeNumber":50,"title":{"value":"Episodio 50","language":"it-IT"},"overview":{"value":"The crisis is over — at least upon the PriMagi stage. Myamu and Matsuri, on the other hand, must manage an upheaval all their own.","language":"en-US"},"airDateText":{"value":"2022-10-02","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/yh6x6WqWR3DmKfdsktHG2J5Tc0X.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/yh6x6WqWR3DmKfdsktHG2J5Tc0X.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/129599/season/1/episode/50"},{"id":"3965717","seasonNumber":1,"episodeNumber":51,"title":{"value":"Episodio 51","language":"it-IT"},"overview":{"value":"Winners will have wishes granted, but the only prize Matsuri wants is an entire world away. How will Matsuri make her choice? The future awaits; good luck, Matsuri and Myamu!","language":"en-US"},"airDateText":{"value":"2022-10-09","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/pafVh5nO87q8RkZt8mGmtwNrqFh.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/pafVh5nO87q8RkZt8mGmtwNrqFh.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/129599/season/1/episode/51"}],"sourceUrl":"https://www.themoviedb.org/tv/129599/season/1"},"fields":{},"episodes":{"1":{"checkedAt":1793358085482,"status":"ok"},"2":{"checkedAt":1793358085482,"status":"ok"},"3":{"checkedAt":1793358085482,"status":"ok"},"4":{"checkedAt":1793358085482,"status":"ok"},"5":{"checkedAt":1793358085482,"status":"ok"},"6":{"checkedAt":1793358085482,"status":"ok"},"7":{"checkedAt":1793358085482,"status":"ok"},"8":{"checkedAt":1793358085482,"status":"ok"},"9":{"checkedAt":1793358085482,"status":"ok"},"10":{"checkedAt":1793358085482,"status":"ok"},"11":{"checkedAt":1793358085482,"status":"ok"},"12":{"checkedAt":1793358085482,"status":"ok"},"13":{"checkedAt":1793358085482,"status":"ok"},"14":{"checkedAt":1793358085482,"status":"ok"},"15":{"checkedAt":1793358085482,"status":"ok"},"16":{"checkedAt":1793358085482,"status":"ok"},"17":{"checkedAt":1793358085482,"status":"ok"