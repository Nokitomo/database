NJb.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/129599/season/1/episode/12"},{"id":"3294285","seasonNumber":1,"episodeNumber":13,"title":{"value":"Episodio 13","language":"it-IT"},"overview":{"value":"Something is wrong with Myamu. Between her troubles and Matsuri’s doubts, the pair will have to pull off a miracle to get Matsuri to the top — but they’re up to the challenge!","language":"en-US"},"airDateText":{"value":"2021-12-26","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/d8AGZXzbyeDxbqP2qpAL70BrS2p.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/d8AGZXzbyeDxbqP2qpAL70BrS2p.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/129599/season/1/episode/13"},{"id":"3431923","seasonNumber":1,"episodeNumber":14,"title":{"value":"Episodio 14","language":"it-IT"},"overview":{"value":"Prince Amane is in trouble, or at least that’s what her PriMagi partner claims. Amane says everything is fine, but Hina suspects Amane’s acting skills are working overtime.","language":"en-US"},"airDateText":{"value":"2022-01-16","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/h4FJUllafvGAohe0rbP4ToeQrcX.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/h4FJUllafvGAohe0rbP4ToeQrcX.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/129599/season/1/episode/14"},{"id":"3431925","seasonNumber":1,"episodeNumber":15,"title":{"value":"Episodio 15","language":"it-IT"},"overview":{"value":"At a special training camp for top stars, the team of hopefuls must work together to survive the week, but some students don’t want to shoulder their fair share of chores…","language":"en-US"},"airDateText":{"value":"2022-01-23","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/pHjWkRRAoxaAbyyHVaDuuhloMO4.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/pHjWkRRAoxaAbyyHVaDuuhloMO4.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/129599/season/1/episode/15"},{"id":"3431926","seasonNumber":1,"episodeNumber":16,"title":{"value":"Episodio 16","language":"it-IT"},"overview":{"value":"An impromptu trip to the magical world with the mysterious Hughie puts Touma in grave danger, but Matsuri and her friends are on their way to help!","language":"en-US"},"airDateText":{"value":"2022-01-30","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/f2RgitRoxDdobxN85rcFfY4hgAF.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/f2RgitRoxDdobxN85rcFfY4hgAF.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/129599/season/1/episode/16"},{"id":"3431927","seasonNumber":1,"episodeNumber":17,"title":{"value":"Episodio 17","language":"it-IT"},"overview":{"value":"The stars of the training camp aren’t the only ones who need to get serious about their craft. Their magical partners have work to do, too!","language":"en-US"},"airDateText":{"value":"2022-02-06","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/qr75AKa2NvB0yxXUzHENInU8IzV.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/qr75AKa2NvB0yxXUzHENInU8IzV.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/129599/season/1/episode/17"},{"id":"3431928","seasonNumber":1,"episodeNumber":18,"title":{"value":"Episodio 18","language":"it-IT"},"overview":{"value":"When a magical rose reveals Amane’s hidden feelings, animosity flowers amid the stars at the special training camp.","language":"en-US"},"airDateText":{"value":"2022-02-13","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/lHPPb6YwNPvS9byAcwiJIpBiWCu.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/lHPPb6YwNPvS9byAcwiJIpBiWCu.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/129599/season/1/episode/18"},{"id":"3431929","seasonNumber":1,"episodeNumber":19,"title":{"value":"Episodio 19","language":"it-IT"},"overview":{"value":"During a surprise day off, the stars take a break from the cameras and visit the Magical Realm… but the magical paparazzi wants to put them right back in the spotlight!","language":"en-US"},"airDateText":{"value":"2022-02-20","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/gHevmeL43mqE3BX43YE8FrIUfQa.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/gHevmeL43mqE3BX43YE8FrIUfQa.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/129599/season/1/episode/19"},{"id":"3431930","seasonNumber":1,"episodeNumber":20,"title":{"value":"Episodio 20","language":"it-IT"},"overview":{"value":"The results of the audience poll leave the stars in turmoil — and with an unprecedented decision to make. But Miruki has a (slightly suspicious) plan to get the votes.","language":"en-US"},"airDateText":{"value":"2022-02-27","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/6cKlzqC2aqKrEuHeiy0Sbz2oe2a.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/6cKlzqC2aqKrEuHeiy0Sbz2oe2a.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/129599/season/1/episode/20"},{"id":"3431932","seasonNumber":1,"episodeNumber":21,"title":{"value":"Episodio 21","language":"it-IT"},"overview":{"value":"It’s Jennifer-mania when the legendary star returns for an unexpected performance! But something about her energy feels off. Looks like even champions struggle sometimes…","language":"en-US"},"airDateText":{"value":"2022-03-06","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/irB3nBqaf3qLrktQ1kkPe8S8wm8.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/irB3nBqaf3qLrktQ1kkPe8S8wm8.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/129599/season/1/episode/21"},{"id":"3431933","seasonNumber":1,"episodeNumber":22,"title":{"value":"Episodio 22","language":"it-IT"},"overview":{"value":"In a pre-exhibition special, the Superstars showcase their past performances to pick the most impressive among them — but not all feel ready to shine their brightest.","language":"en-US"},"airDateText":{"value":"2022-03-13","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/90e5UPMXrZdmmmbmbqWQKmbjJnk.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/90e5UPMXrZdmmmbmbqWQKmbjJnk.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/129599/season/1/episode/22"},{"id":"3431934","seasonNumber":1,"episodeNumber":23,"title":{"value":"Episodio 23","language":"it-IT"},"overview":{"value":"It's time to face the music. The top stars must band together to put on a performance of a lifetime!","language":"en-US"},"airDateText":{"value":"2022-03-20","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/cquouegKPZJdpjvyVFH9dcaTacX.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/cquouegKPZJdpjvyVFH9dcaTacX.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/129599/season/1/episode/23"},{"id":"3431935","seasonNumber":1,"episodeNumber":24,"title":{"value":"Episodio 24","language":"it-IT"},"overview":{"value":"The girls celebrate the success of their five-man center, but the reality of the PriMagi is waiting in the wings. What comes after this feeling of happiness…?","language":"en-US"},"airDateText":{"value":"2022-03-27","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/gYSDrO1FfNmWzpdSiVwV06zYLas.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/gYSDrO1FfNmWzpdSiVwV06zYLas.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/129599/season/1/episode/24"},{"id":"3630027","seasonNumber":1,"episodeNumber":25,"title":{"value":"Episodio 25","language":"it-IT"},"overview":{"value":"A new challenger has emerged, but Auru Omega has an unorthodox view of the PriMagi. She intends to win not with magic, but with science! Can her clinical approach get results?","language":"en-US"},"airDateText":{"value":"2022-04-10","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/cTZISssdCrq1JpbQeAgOjY1MrQ7.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/cTZISssdCrq1JpbQeAgOjY1MrQ7.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/129599/season/1/episode/25"},{"id":"3630028","seasonNumber":1,"episodeNumber":26,"title":{"value":"Episodio 26","language":"it-IT"},"overview":{"value":"Auru’s newest research mission: understanding Matsuri and her PriMagi skills! Will spending time with Matsuri and her family unlock the next step in Auru’s PriMagi evolution?","language":"en-US"},"airDateText":{"value":"2022-04-17","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/cRHdmsIgSLtwt4e3du8ByNxSYNo.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/cRHdmsIgSLtwt4e3du8ByNxSYNo.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/129599/season/1/episode/26"},{"id":"3630029","seasonNumber":1,"episodeNumber":27,"title":{"value":"Episodio 27","language":"it-IT"},"overview":{"value":"Behind the glittering face of the PriMagi stage, ominous forces move in the shadows. A new future for the PriMagi approaches, but what does this mean for Matsuri and Myamu?","language":"en-US"},"airDateText":{"value":"2022-04-24","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/q1Swj0A3JX5vuCQ4Ff2mJ7s1ATu.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/q1Swj0A3JX5vuCQ4Ff2mJ7s1ATu.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/129599/season/1/episode/27"},{"id":"3630030","seasonNumber":1,"episodeNumber":28,"title":{"value":"Episodio 28","language":"it-IT"},"overview":{"value":"The Earthly and the Treasured have worked together for centuries, but if Omega has their way, things for the PriMagi are about to change — permanently.","language":"en-US"},"airDateText":{"value":"2022-05-01","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/9z8eoFZ3v0bIrY2axP5TKb6Omul.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/9z8eoFZ3v0bIrY2axP5TKb6Omul.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/129599/season/1/episode/28"},{"id":"3630031","seasonNumber":1,"episodeNumber":29,"title":{"value":"Episodio 29","language":"it-IT"},"overview":{"value":"After witnessing a surprise performance from an unlikely pair, the rest of the superstars want to try a duo PriMagi, too! But Miruki has some reservations about teaming up…","language":"en-US"},"airDateText":{"value":"2022-05-08","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/95pbmeju8kwcblKq0ojUJVFnckC.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/95pbmeju8kwcblKq0ojUJVFnckC.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/129599/season/1/episode/29"},{"id":"3630032","seasonNumber":1,"episodeNumber":30,"title":{"value":"Episodio 30","language":"it-IT"},"overview":{"value":"Matsuri wants to perform a duo PriMagi with Auru, but Auru has always done things better alone. In fact, she’s ALWAYS been alone… hasn’t she?","language":"en-US"},"airDateText":{"value":"2022-05-15","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/1Ea7lnXbDsG4vRi8OWQeUXYOSaE.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/1Ea7lnXbDsG4vRi8OWQeUXYOSaE.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/129599/season/1/episode/30"},{"id":"3630033","seasonNumber":1,"episodeNumber":31,"title":{"value":"Episodio 31","language":"it-IT"},"overview":{"value":"Auru and Matsuri are performing together? Talk about an odd couple! Can magic and technology learn to work in harmony, or will this team-up end in discord?","language":"en-US"},"airDateText":{"value":"2022-05-22","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/ixWa36DuaIiWVSYIPowLeonmOSf.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/ixWa36DuaIiWVSYIPowLeonmOSf.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/129599/season/1/episode/31"},{"id":"3630034","seasonNumber":1,"episodeNumber":32,"title":{"value":"Episodio 32","language":"it-IT"},"overview":{"value":"Amane and Hina have a duo to perform, but how can you pour your heart into something when you don’t know what your heart holds? Amane must look inward to discover the truth.","language":"en-US"},"airDateText":{"value":"2022-05-29","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/eUqdPWMB9rf6zXhGDY976nozz1B.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/eUqdPWMB9rf6zXhGDY976nozz1B.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/129599/season/1/episode/32"},{"id":"3630035","seasonNumber":1,"episodeNumber":33,"title":{"value":"Episodio 33","language":"it-IT"},"overview":{"value":"Hina is this year’s Samba Sun Goddess, but the arrival of another PriMagi Superstar has cast a shadow over her shining moment...","language":"en-US"},"airDateText":{"value":"2022-06-05","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/6G5uIdieVzsIpDU3dm7AGZYGNJ8.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/6G5uIdieVzsIpDU3dm7AGZYGNJ8.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/129599/season/1/episode/33"},{"id":"3630036","seasonNumber":1,"episodeNumber":34,"title":{"value":"Episodio 34","language":"it-IT"},"overview":{"value":"PriMagi Superstars may be rivals, but they’re also friends. No matter what, they’ll be there for Hina while she finds her footing after her confrontation with Jennifer.","language":"en-US"},"airDateText":{"value":"2022-06-12","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/xpTbbq1D8aGF2XReydhpPGoroDZ.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/xpTbbq1D8aGF2XReydhpPGoroDZ.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/129599/season/1/episode/34"},{"id":"3630037","seasonNumber":1,"episodeNumber":35,"title":{"value":"Episodio 35","language":"it-IT"},"overview":{"value":"Hina fans vs. Amane fans — two households, both alike in dignity, in fair PriMagi, where we lay our scene. Can a duo between Amane and Hina strive to mend this ancient grudge?","language":"en-US"},"airDateText":{"value":"2022-06-19","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/ipzXqlOnGgwGfr2GQjOMhw07jHW.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/ipzXqlOnGgwGfr2GQjOMhw07jHW.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/129599/season/1/episode/35"},{"id":"3630038","seasonNumber":1,"episodeNumber":36,"title":{"value":"Episodio 36","language":"it-IT"},"overview":{"value":"When Lemon’s nerves get the best of her, Miruki sees an opportunity to shine solo — and Carron runs out of patience with her PriMagi partner.","language":"en-US"},"airDateText":{"value":"2022-06-26","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/be6Vz3WSYhjfNkobnCHq6MY2d4R.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/be6Vz3WSYhjfNkobnCHq6MY2d4R.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/129599/season/1/episode/36"},{"id":"3810116","seasonNumber":1,"episodeNumber":37,"title":{"value":"Episodio 37","language":"it-IT"},"overview":{"value":"Lemon and Miruki go on a date, but things don't go according to plan.","language":"en-US"},"airDateText":{"value":"2022-07-03","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/8K7nPDt1J2Vt29IUA7qJ6TDmDgy.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/8K7nPDt1J2Vt29IUA7qJ6TDmDgy.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/129599/season/1/episode/37"},{"id":"3810117","seasonNumber":1,"episodeNumber":38,"title":{"value":"Episodio 38","language":"it-IT"},"overview":{"value":"Lemon learns something surprising about Miruki.","language":"en-US"},"airDateText":{"value":"2022-07-10","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/zFxS5oGxr17RNwrxvrMT22IzdUr.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/zFxS5oGxr17RNwrxvrMT22IzdUr.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/129599/season/1/episode/38"},{"id":"3810118","seasonNumber":1,"episodeNumber":39,"title":{"value":"Episodio 39","language":"it-IT"},"overview":{"value":"The CEO of the mysterious Omega Corporation reveals the philosophy driving his ambitions during a special look back at the meteoric rise of the latest PriMagi superstars.","language":"en-US"},"airDateText":{"value":"2022-07-17","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/hrCXxAuW0oDY4UFiH7OFFPh54Q4.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/hrCXxAuW0oDY4UFiH7OFFPh54Q4.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/129599/season/1/episode/39"},{"id":"3810119","seasonNumber":1,"episodeNumber":40,"title":{"value":"Episodio 40","language":"it-IT"},"overview":{"value":"As various players' motivations come to light, PriMagi as an institution faces a reckoning that could change the landscape of that magical stage forevermore.","language":"en-US"},"airDateText":{"value":"2022-07-24","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/bCzNlzHiKCsQpvfsiMV1nFrzoV7.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/bCzNlzHiKCsQpvfsiMV1nFrzoV7.jpg"