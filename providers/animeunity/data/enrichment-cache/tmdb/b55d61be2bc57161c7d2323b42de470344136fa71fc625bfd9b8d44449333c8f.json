still","url":"https://image.tmdb.org/t/p/original/kf4caurh7UewKyGwcIF5SyWpsYR.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/92892/season/1/episode/12"},{"id":"2027950","seasonNumber":1,"episodeNumber":13,"title":{"value":"Episodio 13","language":"it-IT"},"overview":{"value":"True passion for the game drives players like Sora to succeed. But can passion for basketball be taught — especially to players still new to the sport?","language":"en-US"},"airDateText":{"value":"2019-12-25","language":"it-IT"},"runtimeMinutes":24,"thumbnail":"https://image.tmdb.org/t/p/w300/3yIMfWvkzY65XmRahCeABciqp6o.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/3yIMfWvkzY65XmRahCeABciqp6o.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/92892/season/1/episode/13"},{"id":"2034026","seasonNumber":1,"episodeNumber":14,"title":{"value":"Episodio 14","language":"it-IT"},"overview":{"value":"It’s hard to stay motivated when the inter-high tournament is so far away, but Nao has a plan to keep the team on its toes. First item on the agenda: learning how to screen.","language":"en-US"},"airDateText":{"value":"2020-01-08","language":"it-IT"},"runtimeMinutes":24,"thumbnail":"https://image.tmdb.org/t/p/w300/sJaiP1a7JNaNaOKoPYYIzjJEafN.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/sJaiP1a7JNaNaOKoPYYIzjJEafN.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/92892/season/1/episode/14"},{"id":"2050049","seasonNumber":1,"episodeNumber":15,"title":{"value":"Episodio 15","language":"it-IT"},"overview":{"value":"The players of Kuzu High have just one practice game to prove they’re worth taking seriously. Has their training camp paid off, or will Kitasumi High dominate the court?","language":"en-US"},"airDateText":{"value":"2020-01-15","language":"it-IT"},"runtimeMinutes":24,"thumbnail":"https://image.tmdb.org/t/p/w300/arteatEIjxj7PAAU7Z9Toy9yUZS.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/arteatEIjxj7PAAU7Z9Toy9yUZS.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/92892/season/1/episode/15"},{"id":"2059030","seasonNumber":1,"episodeNumber":16,"title":{"value":"Episodio 16","language":"it-IT"},"overview":{"value":"As Kitasumi High gets serious, Nao unveils Kuzu High’s super secret defense strategy. It’s time to knock out the competition — and Sora is the key to victory.","language":"en-US"},"airDateText":{"value":"2020-01-22","language":"it-IT"},"runtimeMinutes":24,"thumbnail":"https://image.tmdb.org/t/p/w300/dOzwQMoraKiHbeH0dXMpJcTYVqt.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/dOzwQMoraKiHbeH0dXMpJcTYVqt.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/92892/season/1/episode/16"},{"id":"2059031","seasonNumber":1,"episodeNumber":17,"title":{"value":"Episodio 17","language":"it-IT"},"overview":{"value":"Although guarding Taro is exhausting, Sora’s intense eyes make it clear that he’s ready to face the challenge head on. But can Chucky say the same when he takes to the court?","language":"en-US"},"airDateText":{"value":"2020-01-29","language":"it-IT"},"runtimeMinutes":24,"thumbnail":"https://image.tmdb.org/t/p/w300/lQp40Sfh3lxYvcWyYdBI7RfZadf.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/lQp40Sfh3lxYvcWyYdBI7RfZadf.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/92892/season/1/episode/17"},{"id":"2059032","seasonNumber":1,"episodeNumber":18,"title":{"value":"Episodio 18","language":"it-IT"},"overview":{"value":"With Sora on the sidelines, Tobi becomes the target of Kitasumi High’s latest defense strategy: the insidious 2-2-1 zone press.","language":"en-US"},"airDateText":{"value":"2020-02-05","language":"it-IT"},"runtimeMinutes":24,"thumbnail":"https://image.tmdb.org/t/p/w300/eSVUQOVQkFz6TJqaHYzfjcNyYKA.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/eSVUQOVQkFz6TJqaHYzfjcNyYKA.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/92892/season/1/episode/18"},{"id":"2059033","seasonNumber":1,"episodeNumber":19,"title":{"value":"Episodio 19","language":"it-IT"},"overview":{"value":"Dedication. Perseverance. Commitment. These are the qualities that make a basketball champion — and thanks to Konishi, Momoharu isn’t sure if he possesses any of them.","language":"en-US"},"airDateText":{"value":"2020-02-12","language":"it-IT"},"runtimeMinutes":24,"thumbnail":"https://image.tmdb.org/t/p/w300/7v6QwaAOvb7K6HsYwHKDrQZTAkw.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/7v6QwaAOvb7K6HsYwHKDrQZTAkw.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/92892/season/1/episode/19"},{"id":"2059034","seasonNumber":1,"episodeNumber":20,"title":{"value":"Episodio 20","language":"it-IT"},"overview":{"value":"As Sora steps into the role of pointguard, Chiaki steps into the spotlight. The fate of the game hangs in the balance, but will their change-up lead to victory or defeat?","language":"en-US"},"airDateText":{"value":"2020-02-19","language":"it-IT"},"runtimeMinutes":24,"thumbnail":"https://image.tmdb.org/t/p/w300/wtMNxP7vXvl6lhtmniPbtuRPQJ1.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/wtMNxP7vXvl6lhtmniPbtuRPQJ1.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/92892/season/1/episode/20"},{"id":"2174327","seasonNumber":1,"episodeNumber":21,"title":{"value":"Episodio 21","language":"it-IT"},"overview":{"value":"A final shot will decide the fate of the match against Kitasumiyoshi High. As the dust settles, Madoka makes a difficult decision.","language":"en-US"},"airDateText":{"value":"2020-02-26","language":"it-IT"},"runtimeMinutes":24,"thumbnail":"https://image.tmdb.org/t/p/w300/bfPQ1YN5mjRIsDmy582OpJv0I4D.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/bfPQ1YN5mjRIsDmy582OpJv0I4D.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/92892/season/1/epi