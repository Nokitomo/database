[{"type":"still","url":"https://image.tmdb.org/t/p/original/4C9wTHgyoWFfGn0l3k7QgZbHy8d.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/45502/season/0/episode/21"},{"id":"902954","seasonNumber":0,"episodeNumber":22,"title":{"value":"Episodio 22","language":"it-IT"},"overview":{"value":"Queen's Blade: Rebellion OVA, Special 02.","language":"en-US"},"airDateText":{"value":"2012-01-28","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/gDOeRysYAV3korE7OC2cXea78Fx.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/gDOeRysYAV3korE7OC2cXea78Fx.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/45502/season/0/episode/22"},{"id":"2278298","seasonNumber":0,"episodeNumber":23,"title":{"value":"Episodio 23","language":"it-IT"},"overview":{"value":"Queen's Blade: Rebellion, Special 01.","language":"en-US"},"airDateText":{"value":"2012-06-07","language":"it-IT"},"runtimeMinutes":3,"thumbnail":"https://image.tmdb.org/t/p/w300/qQZQRhVp0eOoqjtLBXQrg9zHnsI.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/qQZQRhVp0eOoqjtLBXQrg9zHnsI.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/45502/season/0/episode/23"},{"id":"2278299","seasonNumber":0,"episodeNumber":24,"title":{"value":"Episodio 24","language":"it-IT"},"overview":{"value":"Queen's Blade: Rebellion, Special 02.","language":"en-US"},"airDateText":{"value":"2012-07-25","language":"it-IT"},"runtimeMinutes":3,"thumbnail":"https://image.tmdb.org/t/p/w300/sG1bAMGHLjW0bfno0zI8SkzV7vm.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/sG1bAMGHLjW0bfno0zI8SkzV7vm.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/45502/season/0/episode/24"},{"id":"2278300","seasonNumber":0,"episodeNumber":25,"title":{"value":"Episodio 25","language":"it-IT"},"overview":{"value":"Queen's Blade: Rebellion, Special 03.\n\nDeep in Dogura's dungeon, Dogura proceeds to punish Branwen for an unknown issue. After whipping and tying her up, Dogura remarks on how unsightly Branwen appears, and attaches cords to her nipples with another attached between her legs, and electrocutes her. After several shocks, Dogura realizes that the device is malfunctioning, and in trying to ascertain what's wrong shocks himself and Branwen by accident.","language":"en-US"},"airDateText":{"value":"2012-08-29","language":"it-IT"},"runtimeMinutes":3,"thumbnail":"https://image.tmdb.org/t/p/w300/r6sfPoW2MSmwQ8puSuHZowdvaCc.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/r6sfPoW2MSmwQ8puSuHZowdvaCc.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/45502/season/0/episode/25"},{"id":"2278301","seasonNumber":0,"episodeNumber":26,"title":{"value":"Episodio 26","language":"it-IT"},"overview":{"value":"Queen's Blade: Rebellion, Special 04.\n\nWhile taking a bath in her floating ship, Liliana overhears the conversation between Ymir and Eilin who are also taking a bath, with their topic regarding their age. Liliana, surprised at the age of the two, then recites the first rule of Pirate Aesthetics. She then begins to clean Ymir and Eilin, and provides several remedies (Breast-enhancing massages, dead skin eating fish) to make them appear younger. The dwarf duo then thank Liliana, and head back to Gainos, leaving Liliana remarking on how she forgot something (presumably her clothes) as she starts to get a cold.","language":"en-US"},"airDateText":{"value":"2012-09-26","language":"it-IT"},"runtimeMinutes":3,"thumbnail":"https://image.tmdb.org/t/p/w300/dw5i48EIJ1rvXXlAhqnUyq3KibZ.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/dw5i48EIJ1rvXXlAhqnUyq3KibZ.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/45502/season/0/episode/26"},{"id":"2278302","seasonNumber":0,"episodeNumber":27,"title":{"value":"Episodio 27","language":"it-IT"},"overview":{"value":"Queen's Blade: Rebellion, Special 05.\n\nIn Aldra's home, her husband brings home what Aldra calls a magical machine.(Video Camera) Her Husband begins candidly filming her performing duties around the house, such as: preparing food, dusting shelves, and cleaning windows. Throughout the several activities, Aldra unintentionally damages the camera. Later, her husband films her in the dark, and toys with her, and she unintentionally damages the camera once more. Lastly, her husband attempts to film her in the shower, but during the process water splashes upon the camera, rendering it useless. As an apology, Aldra kisses her husband.","language":"en-US"},"airDateText":{"value":"2012-10-24","language":"it-IT"},"runtimeMinutes":3,"thumbnail":"https://image.tmdb.org/t/p/w300/HmUGkr421F3l5ZdHNsszFAwbiJ.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/HmUGkr421F3l5ZdHNsszFAwbiJ.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/45502/season/0/episode/27"},{"id":"2278303","seasonNumber":0,"episodeNumber":28,"title":{"value":"Episodio 28","language":"it-IT"},"overview":{"value":"Queen's Blade: Rebellion, Special 06.\n\nAt the Rebellion Hideout, Annelotte remarks that something is gone. Puzzled, Yuit, Sainyang and Tarnyang ask Annelotte what is gone. Emotionally disturbed, Demon Annelotte turns around and asks who ate her pudding. After no clear answer, Demon Annelotte harasses Yuit, and then turns to Tarnyang, mysteriously divulging the truth from them. They both run away to find out who ate Annelotte's pudding, and Laila arrives, ready to purify Demon Annelotte. Just as Laila is about to do so, Tarnyang and Yuit come back with Annelotte's pudding which they found in the well. Laila, already having pulled the trigger, splashes Holy Milk all over them. Tarnyang then asks Annelotte how her pudding tastes, in which she replies it's even better with Holy Milk.","language":"en-US"},"airDateText":{"value":"2012-11-28","language":"it-IT"},"runtimeMinutes":3,"thumbnail":"https://image.tmdb.org/t/p/w300/r6zy8KWtWG5OzgokZrO6sobPdNl.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/r6zy8KWtWG5OzgokZrO6sobPdNl.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/45502/season/0/episode/28"}],"sourceUrl":"https://www.themoviedb.org/tv/45502/season/0","name":{"value":"Speciali","language":"it-IT"},"year":2009,"poster":"https://image.tmdb.org/t/p/original/tNVtz6oB0HbFWwiLvPxqJuu3tpu.jpg"},"failure":null,"fields":{},"episodes":{"1":{"checkedAt":1793444684468,"status":"ok","retryCount":0},"2":{"checkedAt":1793444684468,"status":"ok","retryCount":0},"13":{"checkedAt":1793444822431,"status":"ok","retryCount":0},"14":{"checkedAt":1793444822431,"status":"ok","retryCount":0},"15":{"checkedAt":1793444822431,"status":"ok","retryCount":0},"16":{"checkedAt":1793444822431,"status":"ok","retryCount":0},"17":{"checkedAt":1793444822431,"status":"ok","retryCount":0},"18":{"checkedAt":1793444822431,"status":"ok","retryCount":0},"29":{"checkedAt":1793444731894,"status":"missing","retryCount":0},"30":{"checkedAt":1793444731894,"status":"missing","retryCount":0},"31":{"checkedAt":1793444731894,"status":"missing","retryCount":0},"32":{"checkedAt":1793444731894,"status":"missing","retryCount":0},"37":{"checkedAt":1793444653547,"status":"missing","retryCount":0},"38":{"checkedAt":1793444653547,"status":"missing","retryCount":0}}}
