ge.tmdb.org/t/p/original/m16K2KtRnUtZFVTsWkVszlX7L7B.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/87456/season/1/episode/8"},{"id":"1803807","seasonNumber":1,"episodeNumber":9,"title":{"value":"È una grande notizia, giusto?","language":"it-IT"},"overview":{"value":"La partita di allenamento tra Meisei e Toushuu continua, e le prestazioni di Touma ricordano sempre più quelle del Mita Hiroki del passato. Per il Meisei, però, l'incontro sembra irrecuperabile. Come andrà a finire?","language":"it-IT"},"airDateText":{"value":"2019-06-01","language":"it-IT"},"runtimeMinutes":23,"thumbnail":"https://image.tmdb.org/t/p/w300/4r0PQYYWFv0mVNDy1DymVOkG9wM.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/4r0PQYYWFv0mVNDy1DymVOkG9wM.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/87456/season/1/episode/9"},{"id":"1819030","seasonNumber":1,"episodeNumber":10,"title":{"value":"Una semplice passeggiata","language":"it-IT"},"overview":{"value":"Haruka invia una lettera a Touma, invitandolo a fare una passeggiata. Quest'ultimo vorrebbe rifiutare per non indisporre il fratello, ma è costretto ad acconsentire. I due si erano già incontrati molto tempo prima...","language":"it-IT"},"airDateText":{"value":"2019-06-08","language":"it-IT"},"runtimeMinutes":23,"thumbnail":"https://image.tmdb.org/t/p/w300/aPodjnjxlhevRHYTtnRkCjUa6XY.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/aPodjnjxlhevRHYTtnRkCjUa6XY.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/87456/season/1/episode/10"},{"id":"1819031","seasonNumber":1,"episodeNumber":11,"title":{"value":"Prova a lanciare!","language":"it-IT"},"overview":{"value":"Touma rientra dalla passeggiata con Haruka, suscitando la gelosia di Nanchan e Souichirou. Durante un allenamento, l'allenatore si accorge che quest'ultimo è dotato anche come lanciatore. Il Koushien estivo è alle porte.","language":"it-IT"},"airDateText":{"value":"2019-06-15","language":"it-IT"},"runtimeMinutes":23,"thumbnail":"https://image.tmdb.org/t/p/w300/5F57dpgLNSRWGCIdF3Dqvgs84Vm.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/5F57dpgLNSRWGCIdF3Dqvgs84Vm.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/87456/season/1/episode/11"},{"id":"1839731","seasonNumber":1,"episodeNumber":12,"title":{"value":"Non lo stai sottostimando?","language":"it-IT"},"overview":{"value":"Sawai Keiichi, padre di Souichirou e Otomi, è stato l'asso del club di baseball del Meisei. Nel solco da lui tracciato, i Tachibana stanno per affrontare il torneo estivo, ma sulla loro strada c'è già un primo rivale.","language":"it-IT"},"airDateText":{"value":"2019-06-22","language":"it-IT"},"runtimeMinutes":23,"thumbnail":"https://image.tmdb.org/t/p/w300/bsr4r9ojcbZlrJRcEz8x1NPblDp.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/bsr4r9ojcbZlrJRcEz8x1NPblDp.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/87456/season/1/episode/12"},{"id":"1839732","seasonNumber":1,"episodeNumber":13,"title":{"value":"È perché siamo fratelli","language":"it-IT"},"overview":{"value":"Il Meisei affronta la scuola superiore Kenjou, trascinata da Akai Tomohito. Quest'ultima è la favorita, ma Touma mostra di non essere inferiore al lanciatore avversario. Quale delle due squadre sarà eliminata dal torneo?","language":"it-IT"},"airDateText":{"value":"2019-06-29","language":"it-IT"},"runtimeMinutes":23,"thumbnail":"https://image.tmdb.org/t/p/w300/fayoVvuuGi0My50qG67sL4j4CJr.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/fayoVvuuGi0My50qG67sL4j4CJr.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/87456/season/1/episode/13"},{"id":"1850177","seasonNumber":1,"episodeNumber":14,"title":{"value":"Stanno perdendo","language":"it-IT"},"overview":{"value":"Continua la partita contro la Kenjou. Touma realizza un fuoricampo facendo segnare il primo punto dell'incontro, ma la Ke