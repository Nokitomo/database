rg/t/p/original/gRkhYbFsTPcbDgLNH88Vfpuuk1x.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/45801/season/1/episode/8"},{"id":"904552","seasonNumber":1,"episodeNumber":9,"title":{"value":"Pesce d'aprile","language":"it-IT"},"overview":{"value":"うそ～、やよいちゃん、転校しちゃうの!? しかも明日だなんて！ 一緒にプリキュアをがんばっていこうと思ってたのに。やよいちゃんも悲しそう…。寂しくなるけど、みんなでお別れ会を開いて、笑顔で見送ってあげなくちゃ！","language":"ja-JP"},"airDateText":{"value":"2012-04-01","language":"it-IT"},"runtimeMinutes":24,"rating":7,"thumbnail":"https://image.tmdb.org/t/p/w300/1XerYvGwc4D4VfOi7HD6msmAaUn.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/1XerYvGwc4D4VfOi7HD6msmAaUn.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/45801/season/1/episode/9"},{"id":"904553","seasonNumber":1,"episodeNumber":10,"title":{"value":"Episodio 10","language":"it-IT"},"overview":{"value":"あかねちゃんのお父さんが、ぎっくり腰で入院しちゃったの。今度の日曜日は、お店で町内会長さんたちの食事会…。そこで、あかねちゃんが、代わりにお好み焼き屋さんの店長を務めるんだって。さっそく食べに行かなくちゃ！","language":"ja-JP"},"airDateText":{"value":"2012-04-08","language":"it-IT"},"runtimeMinutes":24,"rating":7,"thumbnail":"https://image.tmdb.org/t/p/w300/pEXaKHNZ952D2w2m6wEU46ZsS3u.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/pEXaKHNZ952D2w2m6wEU46ZsS3u.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/45801/season/1/episode/10"},{"id":"904554","seasonNumber":1,"episodeNumber":11,"title":{"value":"Rimpicciolite","language":"it-IT"},"overview":{"value":"不思議なこづちを拾ったの。まるで「一寸法師」に出てくる、うちでのこづちみたい。キャンディが振ってみたら…キャンディが大きくなっちゃった！…じゃなくて、私たちがすごく小さくなったの!? どうしよう～！","language":"ja-JP"},"airDateText":{"value":"2012-04-15","language":"it-IT"},"runtimeMinutes":24,"rating":7,"thumbnail":"https://image.tmdb.org/t/p/w300/y5INnhqMmOemeuVxYh7Xd2jf2rC.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/y5INnhqMmOemeuVxYh7Xd2jf2rC.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/45801/season/1/episode/11"},{"id":"904555","seasonNumber":1,"episodeNumber":12,"title":{"value":"Malinconia","language":"it-IT"},"overview":{"value":"As the girls prepare to go on a school trip to Kyoto, Candy becomes upset when she isn't invited. Meanwhile, Pierrot's right hand man, Joker, gives Wolfrun, Red Ogre and Majorina special blue noses which doesn't require Cure Decors to summon Akanbe. Candy tries her hardest to help the girls plan their trip, only to make things worse. She runs off, feeling she is unwanted, and gets captured by Wolfrun. Wolfrun then confronts the girls and uses the blue nose to summon a Gumball Akanbe, which proves resilient against the Cures' attacks. As the Cures find themselves helpless, Candy breaks free and, upon hearing the kind words of the Cures, brings forth new Decors which allow the Cures to perform a new attack, Rainbow Healing, to defeat the Akanbe. With their team powered up, the girls decide to take Candy along with them on their trip.","language":"en-US"},"airDateText":{"value":"2012-04-22","language":"it-IT"},"runtimeMinutes":24,"rating":7,"thumbnail":"https://image.tmdb.org/t/p/w300/25iL6FZ6bSALG04NNlc3WQtSxQr.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/25iL6FZ6bSALG04NNlc3WQtSxQr.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/45801/season/1/episode/12"},{"id":"904556","seasonNumber":1,"episodeNumber":13,"title":{"value":"Il giorno sfortunato di Emily","language":"it-IT"},"overview":{"value":"今日からいよいよ修学旅行、ウルトラハッピー！…のはずなのに、おみくじが大凶！ それからというもの、ついてないことばかり続いて…そして、とうとう、私のドジのせいで、みんなまで大ピンチになっちゃった！","language":"ja-JP"},"airDateText":{"value":"2012-04-29","language":"it-IT"},"runtimeMinutes":24,"rating":7,"thumbnail":"https://image.tmdb.org/t/p/w300/lpMldUqMnu7lKrr6VbNsNuyaoKB.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/lpMldUqMnu7lKrr6VbNsNuyaoKB.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/45801/season/1/episode/13"},{"id":"904557","seasonNumber":1,"episodeNumber":14,"title":{"value":"Le Glitter smarrite","language":"it-IT"},"overview":{"value":"楽しい修学旅行も最後の日。グループに分かれて、あかねちゃんの故郷・大阪をまわるの。私たちも早速、最初の目的地の大阪城へ。あれ？ あかねちゃんとはぐれちゃった！ みんなで美味しいもの食べたかったのに～！","language":"ja-JP"},"airDateText":{"value":"2012-05-06","language":"it-IT"},"runtimeMinutes":24,"rating":7,"thumbnail":"https://image.tmdb.org/t/p/w300/iOj72iHj7HpNonBK5I2D8wvLbwW.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/iOj72iHj7HpNonBK5I2D8wvLbwW.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/45801/season/1/episode/14"},{"id":"904558","seasonNumber":1,"episodeNumber":15,"title":{"value":"La festa della mamma","language":"it-IT"},"overview":{"value":"みんなが一生懸命に母の日のプレゼントを作ってるのに、私すっかり忘れてた！ どうしよう！ お母さんのお手伝いをしたけれど失敗ばかり。これじゃ、お母さんに喜んでもらえないよ。やっぱり、手作りのプレゼントにしよう！","language":"ja-JP"},"airDateText":{"value":"2012-05-13","language":"it-IT"},"runtimeMinutes":24,"rating":7,"thumbnail":"https://image.tmdb.org/t/p/w300/82CI3r5zj7GirztDiizsbFLsSNI.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/82CI3r5zj7GirztDiizsbFLsSNI.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/45801/season/1/episode/15"},{"id":"904559","seasonNumber":1,"episodeNumber":16,"title":{"value":"Chloe se ne va","language":"it-IT"},"overview":{"value":"れいかちゃんが、勉強も弓道もプリキュアもやめるって！ そんなことを言うなんて、いったいどうしちゃったの!? 自分が本当にやりたいことを、見つけたいって言うんだけど…。","language":"ja-JP"},"airDateText":{"value":"2012-05-20","language":"it-IT"},"runtimeMinutes":24,"rating":7,"thumbnail":"https://image.tmdb.org/t/p/w300/2DqCAC2SixfU3DbwTqG6gsKSQ3s.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/2DqCAC2SixfU3DbwTqG6gsKSQ3s.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/45801/season/1/episode/16"},{"id":"904560","seasonNumber":1,"episodeNumber":17,"title":{"value":"Episodio 17","language":"it-IT"},"overview":{"value":"明日はお笑いコンテスト。お笑い芸人・FUJIWARAさんが来るっていうので、大ファンのあかねちゃんは気合い入りまくり！ 私たち、5人で舞台に上がることになったけど、緊張しちゃうよー！","language":"ja-JP"},"airDateText":{"value":"2012-05-27","languag