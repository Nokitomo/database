0/nth90D16hQrcRxfkTKER2PFJK4S.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/nth90D16hQrcRxfkTKER2PFJK4S.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/218843/season/1/episode/21"},{"id":"5074345","seasonNumber":1,"episodeNumber":22,"title":{"value":"Cuore di fuoco e ghiaccio","language":"it-IT"},"overview":{"value":"I Quattro Cavalieri fanno squadra per combattere gli apostoli del Caos. Nel frattempo, Lancelot percepisce un pericolo imminente e si dirige verso il castello.","language":"it-IT"},"airDateText":{"value":"2024-03-17","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/nUYRParvVFbEqS2H9B82u9xNcIs.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/nUYRParvVFbEqS2H9B82u9xNcIs.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/218843/season/1/episode/22"},{"id":"5074346","seasonNumber":1,"episodeNumber":23,"title":{"value":"Cavalieri Sacri del Regno vs. Melagaland","language":"it-IT"},"overview":{"value":"Con Lancelot scomparso, Galland e Melascula risorgono fondendosi insieme. Messi alle strette, Percival, Tristan e Gawain hanno bisogno di tutto l'aiuto possibile.","language":"it-IT"},"airDateText":{"value":"2024-03-24","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/k5NjOPZAQB6VZP2xhpk87miG3vN.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/k5NjOPZAQB6VZP2xhpk87miG3vN.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/218843/season/1/episode/23"},{"id":"5074347","seasonNumber":1,"episodeNumber":24,"title":{"value":"Avvento","language":"it-IT"},"overview":{"value":"Percival trae forza dalla speranza del popolo e affronta Mela-Galland, che si rivela troppo potente. Tristan contrattacca correndo un grosso rischio.","language":"it-IT"},"airDateText":{"value":"2024-03-31","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/lvHzix2q33QTR