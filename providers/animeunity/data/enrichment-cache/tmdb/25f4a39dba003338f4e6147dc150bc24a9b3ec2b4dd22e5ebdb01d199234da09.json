0/7EYZ6HpvqXikCW0411W5lUTCkcj.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/7EYZ6HpvqXikCW0411W5lUTCkcj.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/218843/season/1/episode/12"},{"id":"5074336","seasonNumber":1,"episodeNumber":13,"title":{"value":"Con le spalle al muro","language":"it-IT"},"overview":{"value":"Percival affronta Kellie, una bestia mitologica potente e spietata. La banda insegue Ardbeg in una grotta misteriosa, ma scopre che si tratta di una trappola.","language":"it-IT"},"airDateText":{"value":"2024-01-14","language":"it-IT"},"runtimeMinutes":25,"rating":10,"thumbnail":"https://image.tmdb.org/t/p/w300/2MFLaUfAc9fYTAoqfyzEJrNAwgd.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/2MFLaUfAc9fYTAoqfyzEJrNAwgd.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/218843/season/1/episode/13"},{"id":"5074337","seasonNumber":1,"episodeNumber":14,"title":{"value":"Il peccato dell'Ariete","language":"it-IT"},"overview":{"value":"La magia di Ardbeg trasforma Percival e la sua banda in neonati indifesi. L'anziano del villaggio del clan dei demoni arriva in loro soccorso presentando un ultimatum.","language":"it-IT"},"airDateText":{"value":"2024-01-21","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/qVtA7CPfljwgZ7vkXLwGsP0kxnA.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/qVtA7CPfljwgZ7vkXLwGsP0kxnA.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/218843/season/1/episode/14"},{"id":"5074338","seasonNumber":1,"episodeNumber":15,"title":{"value":"I talismani dell'oscurità","language":"it-IT"},"overview":{"value":"Nascosti in lontananza, gli uomini di Arthur tendono un'imboscata a Gowther e Ardbeg. Ritornati alla loro forma originale, Percival e la banda proseguono il rischioso viaggio.","language":"it-IT"},"airDateText":{"value":"2024-01-28","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https: