/14"},{"id":"5238252","seasonNumber":1,"episodeNumber":15,"title":{"value":"Episodio 15","language":"it-IT"},"overview":{"value":"With no real information on how to get to Yoitsu, Lawrence uses all his resources to find more information. Will pagan stories of the North yield any clues?","language":"en-US"},"airDateText":{"value":"2024-07-09","language":"it-IT"},"runtimeMinutes":23,"rating":6.5,"thumbnail":"https://image.tmdb.org/t/p/w300/vq1Fp3xeKXNHWOHcU8c9x81H7As.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/vq1Fp3xeKXNHWOHcU8c9x81H7As.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/229676/season/1/episode/15"},{"id":"5238253","seasonNumber":1,"episodeNumber":16,"title":{"value":"Episodio 16","language":"it-IT"},"overview":{"value":"Amati learns about Holo's debt to Lawrence and announces that he will take on the debt and ask Holo to marry him.","language":"en-US"},"airDateText":{"value":"2024-07-16","language":"it-IT"},"runtimeMinutes":23,"rating":7.5,"thumbnail":"https://image.tmdb.org/t/p/w300/tArbmboOTQbfMniBSfDQklyRgic.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/tArbmboOTQbfMniBSfDQklyRgic.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/229676/season/1/episode/16"},{"id":"5238254","seasonNumber":1,"episodeNumber":17,"title":{"value":"Episodio 17","language":"it-IT"},"overview":{"value":"Lawrence tries to persuade Amati into a special deal. This could determine the outcome of their agreement...","language":"en-US"},"airDateText":{"value":"2024-07-23","language":"it-IT"},"runtimeMinutes":23,"rating":6,"thumbnail":"https://image.tmdb.org/t/p/w300/m3dwFKo90UeUWDEC5cs7XczHO6Q.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/m3dwFKo90UeUWDEC5cs7XczHO6Q.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/229676/season/1/episode/17"},{"id":"5238255","seasonNumber":1,"episodeNumber":18,"title":{"value":"Episodio 18","language":"it-IT"},"