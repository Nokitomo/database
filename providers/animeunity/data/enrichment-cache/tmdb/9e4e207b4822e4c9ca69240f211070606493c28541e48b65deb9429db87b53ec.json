Pq.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/arMEtMgByamnrbYtymrOMAPpNPq.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/117024/season/1/episode/11"},{"id":"4557254","seasonNumber":1,"episodeNumber":12,"title":{"value":"Episodio 12","language":"it-IT"},"overview":{"value":"While Queen Calra continues to delay the rite of blessing, Sariphi finds herself at the mercy of the young Pricess Tetra. The haughty girl has a long list of demands, but what does she really want?","language":"en-US"},"airDateText":{"value":"2023-07-06","language":"it-IT"},"runtimeMinutes":24,"rating":7,"thumbnail":"https://image.tmdb.org/t/p/w300/x1zCUJalfdMGswdFFajVyBec9Pv.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/x1zCUJalfdMGswdFFajVyBec9Pv.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/117024/season/1/episode/12"},{"id":"4571043","seasonNumber":1,"episodeNumber":13,"title":{"value":"Episodio 13","language":"it-IT"},"overview":{"value":"Sariphi sets out on her first royal duty without the king at her side. For protection, she must rely on Lanteveldt, the new captain of her personal guard. But can he be trusted? And can Sariphi play the part of queen alone?","language":"en-US"},"airDateText":{"value":"2023-07-13","language":"it-IT"},"runtimeMinutes":24,"rating":7.8,"thumbnail":"https://image.tmdb.org/t/p/w300/hV2skt2Yyk5SFfpD4QlTrVwzi0J.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/hV2skt2Yyk5SFfpD4QlTrVwzi0J.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/117024/season/1/episode/13"},{"id":"4587813","seasonNumber":1,"episodeNumber":14,"title":{"value":"Episodio 14","language":"it-IT"},"overview":{"value":"The new captain of Sariphi's guard is accused of attacking a local lord! Sariphi sets out to prove his innocence, but can she overcome prejudice against Hyenians on top of the distrust of humans that she already faces?","language":"en-US"},"airDateText":{"value":"2023-07-20","language":"it-IT"},"runtimeMinutes":24,"rating":7.8,"thumbnail":"https://image.tmdb.org/t/p/w300/qXWqs6Jnmudy7raYwYaXfdzLPpU.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/qXWqs6Jnmudy7raYwYaXfdzLPpU.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/117024/season/1/episode/14"},{"id":"4589935","seasonNumber":1,"episodeNumber":15,"title":{"value":"Episodio 15","language":"it-IT"},"overview":{"value":"Princess Amit is stunned when Jormungand returns her amulet. But is there more to his rejection than meets the eye? Meanwhile, Ilya's beliefs are challenged when he investigates a string of kidnappings.","language":"en-US"},"airDateText":{"value":"2023-07-27","language":"it-IT"},"runtimeMinutes":24,"rating":7.5,"thumbnail":"https://image.tmdb.org/t/p/w300/dZKy9BmjIzNN1M0l7s8GPiHuCnH.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/dZKy9BmjIzNN1M0l7s8GPiHuCnH.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/117024/season/1/episode/15"},{"id":"4589970","seasonNumber":1,"episodeNumber":16,"title":{"value":"Episodio 16","language":"it-IT"},"overview":{"value":"Sariphi and Leonhart set out on a new royal visit, but disaster strikes when a mysterious new force invades Ozmargo. And Sariphi comes face-to-face with its leader! Can she strike a bargain to save her friends, her people—and herself?","language":"en-US"},"airDateText":{"value":"2023-08-03","language":"it-IT"},"runtimeMinutes":24,"rating":6.7,"thumbnail":"https://image.tmdb.org/t/p/w300/9JfQ8HdvyCEsmKQhRZylXX0zR2h.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/9JfQ8HdvyCEsmKQhRZylXX0zR2h.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/117024/season/1/episode/16"},{"id":"4589973","seasonNumber":1,"episodeNumber":17,"title":{"value":"Episodio 17","language":"it-IT"},"overview":{"value":"While Anubis leads an army against Fenrir's forces, Sariphi confronts the wolf king in his lair. Are either of them prepared to face this vicious and mercurial foe? And can Sariphi's friends make a difference before they need saving themselves?","language":"en-US"},"airDateText":{"value":"2023-08-10","language":"it-IT"},"runtimeMinutes":24,"rating":6.7,"thumbnail":"https://image.tmdb.org/t/p/w300/qIewcTAnzTQ0SRJhJJ4UoLIkm5.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/qIewcTAnzTQ0SRJhJJ4UoLIkm5.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/117024/season/1/episode/17"},{"id":"4623265","seasonNumber":1,"episodeNumber":18,"title":{"value":"Episodio 18","language":"it-IT"},"overview":{"value":"Leonhart arrives just as Sariphi and her would-be rescuers near the end of their rope. Now the king must face the pretender to his throne. But how will he fare against a rival who has lived his life for this moment?","language":"en-US"},"airDateText":{"value":"2023-08-17","language":"it-IT"},"runtimeMinutes":24,"rating":6.7,"thumbnail":"https://image.tmdb.org/t/p/w300/mD7OCRTedui2oEemZkXYTpvY0lA.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/mD7OCRTedui2oEemZkXYTpvY0lA.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/117024/season/1/episode/18"},{"id":"4623267","seasonNumber":1,"episodeNumber":19,"title":{"value":"Episodio 19","language":"it-IT"},"overview":{"value":"Peace is restored to Ozmargo, but the future is far from certain. After a heart to heart, Sariphi and Leonhart resolve to take a drastic step for the future. But how will the king's advisers take their decision?","language":"en-US"},"airDateText":{"value":"2023-08-24","language":"it-IT"},"runtimeMinutes":24,"rating":6.3,"thumbnail":"https://image.tmdb.org/t/p/w300/bAQKdkY3inA0Pw3eWxzA3JKNEmj.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/bAQKdkY3inA0Pw3eWxzA3JKNEmj.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/117024/season/1/episode/19"},{"id":"4623268","sea