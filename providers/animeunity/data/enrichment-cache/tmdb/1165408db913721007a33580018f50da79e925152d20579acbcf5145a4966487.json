"it-IT"},"airDateText":{"value":"2004-10-20","language":"it-IT"},"runtimeMinutes":25,"rating":7,"thumbnail":"https://image.tmdb.org/t/p/w300/hh2OfeJfPwG2cq4mxIEZvMTOOD.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/hh2OfeJfPwG2cq4mxIEZvMTOOD.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/9543/season/1/episode/3"},{"id":"408254","seasonNumber":1,"episodeNumber":4,"title":{"value":"Il Segreto Di Mia Madre","language":"it-IT"},"overview":{"value":"Le domande che circondano il Conte si moltiplicano quando Albert visita la sua sontuosa dimora sugli Champs Elysees, piena di complicati inganni e ornamenti d'oro.","language":"it-IT"},"airDateText":{"value":"2004-10-27","language":"it-IT"},"runtimeMinutes":25,"rating":7,"thumbnail":"https://image.tmdb.org/t/p/w300/qm7eLfd3obimNc2QHROjS2WOZuF.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/qm7eLfd3obimNc2QHROjS2WOZuF.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/9543/season/1/episode/4"},{"id":"408255","seasonNumber":1,"episodeNumber":5,"title":{"value":"Sei Innamorato Della Tua Fidanzata?","language":"it-IT"},"overview":{"value":"Durante una crociera di piacere organizzata dal conte, un disaccordo porta a un duello tra Albert e Maximilien. Le emozioni incontrollate di Albert consentono al suo ospite di acquisire ancora più potere sul suo destino.","language":"it-IT"},"airDateText":{"value":"2004-11-03","language":"it-IT"},"runtimeMinutes":25,"rating":8,"thumbnail":"https://image.tmdb.org/t/p/w300/u0FzqPjQOZ6egeALmJrGBTwuA3E.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/u0FzqPjQOZ6egeALmJrGBTwuA3E.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/9543/season/1/episode/5"},{"id":"408256","seasonNumber":1,"episodeNumber":6,"title":{"value":"La Sua Malinconia, La Mia Malinconia","language":"it-IT"},"overview":{"value":"Il Conte di Montecristo si insinua sempre più nelle vite delle persone vicine