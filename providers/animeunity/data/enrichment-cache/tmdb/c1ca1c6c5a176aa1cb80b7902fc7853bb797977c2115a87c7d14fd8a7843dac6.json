240/season/1/episode/5"},{"id":"1472642","seasonNumber":1,"episodeNumber":6,"title":{"value":"Calcio d'inizio! Nankatsu Vs Shutetsu","language":"it-IT"},"overview":{"value":"Inizia il torneo tra la scuola Nankatsu e la scuola Shutetsu. Tutte le competizioni si completano portando le scuole a un pareggio e resta solo la partita di calcio per definire il vincitore.","language":"it-IT"},"airDateText":{"value":"2018-05-08","language":"it-IT"},"runtimeMinutes":24,"rating":7.3,"thumbnail":"https://image.tmdb.org/t/p/w300/5H2CX319NaoUmiQfs2qWhMoJBSK.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/5H2CX319NaoUmiQfs2qWhMoJBSK.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/77240/season/1/episode/6"},{"id":"1472643","seasonNumber":1,"episodeNumber":7,"title":{"value":"Il fantasista Tsubasa","language":"it-IT"},"overview":{"value":"La partita tra Nankatsu e Shutetsu ha inizio e tra gli spettatori ci sono anche il papà di Tsubasa e Misaki.","language":"it-IT"},"airDateText":{"value":"2018-05-15","language":"it-IT"},"runtimeMinutes":24,"rating":8.5,"thumbnail":"https://image.tmdb.org/t/p/w300/5dogAzfq77M3CICm376uX7CJUze.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/5dogAzfq77M3CICm376uX7CJUze.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/77240/season/1/episode/7"},{"id":"1472644","seasonNumber":1,"episodeNumber":8,"title":{"value":"Eccola! La coppia d'oro della Nankatsu","language":"it-IT"},"overview":{"value":"Genzo ordina alla squadra di applicare la tattica della gabbia, una situazione di stallo usata per guadagnare tempo.","language":"it-IT"},"airDateText":{"value":"2018-05-22","language":"it-IT"},"runtimeMinutes":24,"rating":9,"thumbnail":"https://image.tmdb.org/t/p/w300/xoaEFtPbmWMxkb4OihC8DYZGszq.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/xoaEFtPbmWMxkb4OihC8DYZGszq.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/77240/season/1/episo