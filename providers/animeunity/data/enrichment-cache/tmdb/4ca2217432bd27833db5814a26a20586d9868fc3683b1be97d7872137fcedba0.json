.org/t/p/original/36PpeQC0w8oyIlrdmucm6H6JBa1.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/62273/season/2/episode/8"},{"id":"1219197","seasonNumber":2,"episodeNumber":9,"title":{"value":"Episodio 9","language":"it-IT"},"overview":{"value":"The Fall Elections Finals are finally here, with a historic face-off between three finalists at once. While Hayama and Kurokiba produce fresh pacific saury glinting like swords, Soma's pacific saury is a bit different…","language":"en-US"},"airDateText":{"value":"2016-08-27","language":"it-IT"},"runtimeMinutes":24,"rating":8.3,"thumbnail":"https://image.tmdb.org/t/p/w300/ny92yrU29NRcUueIVA6sN4m6pKE.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/ny92yrU29NRcUueIVA6sN4m6pKE.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/62273/season/2/episode/9"},{"id":"1222449","seasonNumber":2,"episodeNumber":10,"title":{"value":"Episodio 10","language":"it-IT"},"overview":{"value":"Though presumed inferior to Kurokiba's cartoccio and Hayama's carpaccio, Soma's pacific saury dish had been hiding a secret. Will Soma's strategy work to sway the judges","language":"en-US"},"airDateText":{"value":"2016-09-03","language":"it-IT"},"runtimeMinutes":24,"rating":8.3,"thumbnail":"https://image.tmdb.org/t/p/w300/4fhQLvFg16ZYuNSD8eznR4GXBhA.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/4fhQLvFg16ZYuNSD8eznR4GXBhA.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/62273/season/2/episode/10"},{"id":"1222451","seasonNumber":2,"episodeNumber":11,"title":{"value":"Episodio 11","language":"it-IT"},"overview":{"value":"After a brief respite following the Fall Elections, Soma's class is sent off to the Stagiare, a training program out in the real world where students must succeed in leaving visible results at their training location. Soma ends up at a Western restaurant with Arato. He draws on his experience and readily steps up to the challenge, but will tha