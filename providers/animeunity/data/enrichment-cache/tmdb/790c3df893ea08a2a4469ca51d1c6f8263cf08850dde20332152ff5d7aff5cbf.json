/p/w300/vFqwYSPXANnkkfT7uzdmU15eYUp.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/vFqwYSPXANnkkfT7uzdmU15eYUp.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/1097/season/1/episode/11"},{"id":"56605","seasonNumber":1,"episodeNumber":12,"title":{"value":"Se tu sorridi","language":"it-IT"},"overview":{"value":"Vincent, Pino e Re-L cominciano a viaggiare insieme e vengono attaccati da un proxy.","language":"it-IT"},"airDateText":{"value":"2006-05-27","language":"it-IT"},"runtimeMinutes":25,"rating":7.4,"thumbnail":"https://image.tmdb.org/t/p/w300/pnlDVvPrfStTD8DqqrYgkfb3STj.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/pnlDVvPrfStTD8DqqrYgkfb3STj.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/1097/season/1/episode/12"},{"id":"56606","seasonNumber":1,"episodeNumber":13,"title":{"value":"Punti morti concettuali","language":"it-IT"},"overview":{"value":"I pericoli continuano. Questa volta causati da Autoreiv.","language":"it-IT"},"airDateText":{"value":"2006-06-03","language":"it-IT"},"runtimeMinutes":25,"rating":7.6,"thumbnail":"https://image.tmdb.org/t/p/w300/aURmis9sa1ZXyyTfcIrooh2ah9M.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/aURmis9sa1ZXyyTfcIrooh2ah9M.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/1097/season/1/episode/13"},{"id":"56607","seasonNumber":1,"episodeNumber":14,"title":{"value":"Qualcuno che assomiglia a te","language":"it-IT"},"overview":{"value":"I protagonisti giungono in una città-cupola disabitata. Ma lo è davvero?","language":"it-IT"},"airDateText":{"value":"2006-06-10","language":"it-IT"},"runtimeMinutes":25,"rating":6.8,"thumbnail":"https://image.tmdb.org/t/p/w300/e48QJCdAPR6vVjU8b8PGyygbVFp.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/e48QJCdAPR6vVjU8b8PGyygbVFp.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/1097/season/1/episode/14"},{"id":"56608","seasonNu