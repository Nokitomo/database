/p/original/ulYQJ1Mq3gxnj5WJfhxFxtGUkzT.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/37468/season/1/episode/18"},{"id":"846362","seasonNumber":1,"episodeNumber":19,"title":{"value":"Dieta dimagrante","language":"it-IT"},"overview":{"value":"Gigi, molle nei movimenti, viene costretto dall'allenatrice Gloria a dimagrire. Salomone combina uno dei suo scherzi appoggiando la zampa sulla bilancia quando Gigi si pesa.","language":"it-IT"},"airDateText":{"value":"1982-02-07","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/dfvTnYyyhTi44BDzRhgszsBZraJ.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/dfvTnYyyhTi44BDzRhgszsBZraJ.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/37468/season/1/episode/19"},{"id":"846363","seasonNumber":1,"episodeNumber":20,"title":{"value":"Lo scherzo","language":"it-IT"},"overview":{"value":"L'allenatrice Gloria, per qualche giorno, è costretta ad assentarsi e viene sostituita dal professor Arashi che mette subito in riga la squadra ma la squadra gli organizza uno scherzo che lo fa cadere in un forte stato di shock.","language":"it-IT"},"airDateText":{"value":"1982-02-14","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/ugIUZJTr1OntFvfP4zybWlYzqdR.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/ugIUZJTr1OntFvfP4zybWlYzqdR.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/37468/season/1/episode/20"},{"id":"846364","seasonNumber":1,"episodeNumber":21,"title":{"value":"La gara volante","language":"it-IT"},"overview":{"value":"Gigi legge su un giornale che un campione di gare volanti cerca uno sfidante.","language":"it-IT"},"airDateText":{"value":"1982-02-21","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/lQwAnSdvICQPGzCN0bAUB5i2oT6.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/lQwAnSdvICQPGzCN0bAUB5i2oT6.jpg"