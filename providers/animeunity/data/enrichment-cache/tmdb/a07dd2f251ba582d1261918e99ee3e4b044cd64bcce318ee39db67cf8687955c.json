moviedb.org/tv/37468/season/1/episode/9"},{"id":"846343","seasonNumber":1,"episodeNumber":10,"title":{"value":"Il rivale","language":"it-IT"},"overview":{"value":"Il preside della scuola chiede all'allenatrice Gloria di inserire in squadra suo figlio Tomato gravemente malato ma entrerà in lite con Gigi durante una partita.","language":"it-IT"},"airDateText":{"value":"1981-12-06","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/fmtyUYjCNiaPVZQM4wDJcXc2cvY.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/fmtyUYjCNiaPVZQM4wDJcXc2cvY.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/37468/season/1/episode/10"},{"id":"846344","seasonNumber":1,"episodeNumber":11,"title":{"value":"Gli esami","language":"it-IT"},"overview":{"value":"I membri della squadra di basket devono sostenere gli esami ma il loro rendimento scolastico è molto scarso. Gigi tenterà di aiutarli in ogni modo trascurando però i suoi esami.","language":"it-IT"},"airDateText":{"value":"1981-12-13","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/xjcAYdfOkfyE1YvvVWUxCylzAVj.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/xjcAYdfOkfyE1YvvVWUxCylzAVj.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/37468/season/1/episode/11"},{"id":"846345","seasonNumber":1,"episodeNumber":12,"title":{"value":"Il colpo micidiale di Alan","language":"it-IT"},"overview":{"value":"Alan, offeso e deriso da Gigi, vuole vendicarsi inventando un nuovo colpo micidiale.","language":"it-IT"},"airDateText":{"value":"1981-12-20","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/dSFxRjzTQyQQSzdVpdnCTP6OcW2.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/dSFxRjzTQyQQSzdVpdnCTP6OcW2.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/37468/season/1/episode/12"},{"id":"846346","seasonNumber":1,"episodeNumber":13,"tit