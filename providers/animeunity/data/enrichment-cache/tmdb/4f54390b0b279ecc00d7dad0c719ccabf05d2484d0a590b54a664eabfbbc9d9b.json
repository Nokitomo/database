{"schemaVersion":1,"source":"tmdb","kind":"episodes","input":{"mediaId":60819,"seasonNumber":1},"checkedAt":1793376858756,"status":"ok","value":{"seasonNumber":1,"name":{"value":"Stagione 1","language":"it-IT"},"year":2014,"episodeCount":12,"poster":"https://image.tmdb.org/t/p/original/wRVkIZibvJLw2KsjPm9WbpkHpdY.jpg","posters":[],"backgrounds":[],"episodes":[{"id":"984773","seasonNumber":1,"episodeNumber":1,"title":{"value":"Episodio 1","language":"it-IT"},"overview":{"value":"Escha Malier starts her first day as an official alchemist at the city of Colset's R&D division, where she has an awkward first meeting with fellow alchemist Logix \"Logy\" Fiscario, who is also a newcomer to the division.","language":"en-US"},"airDateText":{"value":"2014-04-10","language":"it-IT"},"runtimeMinutes":25,"rating":6.5,"thumbnail":"https://image.tmdb.org/t/p/w300/7orWeCJnQyvqRWHD4Lg2RjzNHgo.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/7orWeCJnQyvqRWHD4Lg2RjzNHgo.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/60819/season/1/episode/1"},{"id":"989339","seasonNumber":1,"episodeNumber":2,"title":{"value":"Episodio 2","language":"it-IT"},"overview":{"value":"Escha and Logy are tasked to provide assistance to a nearby village which is on shortage of water and along the way, they befriend two travelers, Nio and Wilbell, who assist them on their quest.","language":"en-US"},"airDateText":{"value":"2014-04-17","language":"it-IT"},"runtimeMinutes":25,"rating":6.5,"thumbnail":"https://image.tmdb.org/t/p/w300/a6TedZ3tyjr2q8pXDOtOLYZ6I33.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/a6TedZ3tyjr2q8pXDOtOLYZ6I33.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/60819/season/1/episode/2"},{"id":"989782","seasonNumber":1,"episodeNumber":3,"title":{"value":"Episodio 3","language":"it-IT"},"overview":{"value":"Escha's recipe to purify the village's reservoir works, but the pollution continues and she travels upstream with Logy in search for the cause.","language":"en-US"},"airDateText":{"value":"2014-04-24","language":"it-IT"},"runtimeMinutes":25,"rating":7,"thumbnail":"https://image.tmdb.org/t/p/w300/919XT2JVWNhgnjAR6jyqnQkt3wq.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/919XT2JVWNhgnjAR6jyqnQkt3wq.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/60819/season/1/episode/3"},{"id":"989337","seasonNumber":1,"episodeNumber":4,"title":{"value":"Episodio 4","language":"it-IT"},"overview":{"value":"By suggestion of her friends, Escha attempts to make a copy of her artificial tail but despite being a profitable opportunity, she is more interested in doing so to learn more about her late mother, who created it for her.","language":"en-US"},"airDateText":{"value":"2014-05-01","language":"it-IT"},"runtimeMinutes":25,"rating":7,"thumbnail":"https://image.tmdb.org/t/p/w300/4KpBr4CDA2qJtwZOrwZsh9vHOVh.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/4KpBr4CDA2qJtwZOrwZsh9vHOVh.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/60819/season/1/episode/4"},{"id":"989336","seasonNumber":1,"episodeNumber":5,"title":{"value":"Episodio 5","language":"it-IT"},"overview":{"value":"Lucille Ernella, a specialist in medicine, arrives from central to work on the R&D division under Escha and Logy. Despite proving herself quite capable compared to her peers, Lucille gets herself in trouble when she attempts to perform her duties without asking for assistance, until Escha and the others come to her aid.","language":"en-US"},"airDateText":{"value":"2014-05-08","language":"it-IT"},"runtimeMinutes":25,"rating":6.5,"thumbnail":"https://image.tmdb.org/t/p/w300/6zatdkIcNpOZJTT6NVEuoxFGUvU.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/6zatdkIcNpOZJTT6NVEuoxFGUvU.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/60819/season/1/episode/5"},{"id":"989335","seasonNumber":1,"episodeNumber":6,"title":{"value":"Episodio 6","language":"it-IT"},"overview":{"value":"Escha is tasked to find a new way to improve the harvest on the local orchard and while looking for some ideas, she and her friends decide to hold a contest to look for recipes to make with the discarded apples while an eating contest is held at the local restaurant.","language":"en-US"},"airDateText":{"value":"2014-05-15","language":"it-IT"},"runtimeMinutes":25,"rating":7,"thumbnail":"https://image.tmdb.org/t/p/w300/b6KBCZfKWa5jhBGh6ZwevthQfXy.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/b6KBCZfKWa5jhBGh6ZwevthQfXy.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/60819/season/1/episode/6"},{"id":"989334","seasonNumber":1,"episodeNumber":7,"title":{"value":"Episodio 7","language":"it-IT"},"overview":{"value":"The members of the R&D division prepare for the arrival of an auditor to check on their work, when one of their members, the swordswoman Linca is spotted causing trouble around town and is put under suspicion, despite claiming innocence, until Escha and Logy learn from Marion the truth about her.","language":"en-US"},"airDateText":{"value":"2014-05-22","language":"it-IT"},"runtimeMinutes":25,"rating":7,"thumbnail":"https://image.tmdb.org/t/p/w300/whksZa10Ot5qlgYFs76hRxjY7JG.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/whksZa10Ot5qlgYFs76hRxjY7JG.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/60819/season/1/episode/7"},{"id":"989333","seasonNumber":1,"episodeNumber":8,"title":{"value":"Episodio 8","language":"it-IT"},"overview":{"value":"With their assignments done for a while, the R&D division is up for some well deserved vacation, when Wilbell appears and convinces them to accompany her on a hot springs trip near a volcano, unaware of her true intentions.","language":"en-US"},"airDateText":{"value":"2014-05-29","language":"it-IT"},"runtimeMinutes":25,"rating":6,"thumbnail":"https://image.tmdb.org/t/p/w300/fXgFB1C4REaZV9GQln7SYtH94kk.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/fXgFB1C4REaZV9GQln7SYtH94kk.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/60819/season/1/episode/8"},{"id":"989332","seasonNumber":1,"episodeNumber":9,"title":{"value":"Episodio 9","language":"it-IT"},"overview":{"value":"Escha always dreamed of reaching the unexplored ruins that float near her city. When their friend Threia decides to issue a request to look for a mean to reach the ruins, Escha cheers up, just to have her dreams crushed when they are ordered by the higher ups to make preparations for another team to attempt it. However, Escha's friends decide to not give up and make plans to form their own exploration party instead.","language":"en-US"},"airDateText":{"value":"2014-06-05","language":"it-IT"},"runtimeMinutes":25,"rating":7.5,"thumbnail":"https://image.tmdb.org/t/p/w300/b2yhCzwEz3I19pXWs39LgcSoOkP.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/b2yhCzwEz3I19pXWs39LgcSoOkP.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/60819/season/1/episode/9"},{"id":"989331","seasonNumber":1,"episodeNumber":10,"title":{"value":"Episodio 10","language":"it-IT"},"overview":{"value":"While looking for key components to complete an airship, Escha learns about Logy's dreams, but that a tragic accident made him abandon them.","language":"en-US"},"airDateText":{"value":"2014-06-12","language":"it-IT"},"runtimeMinutes":25,"rating":7,"thumbnail":"https://image.tmdb.org/t/p/w300/cBt5nTYDU5K5QLUEumavOcMhoyR.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/cBt5nTYDU5K5QLUEumavOcMhoyR.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/60819/season/1/episode/10"},{"id":"989330","seasonNumber":1,"episodeNumber":11,"title":{"value":"Episodio 11","language":"it-IT"},"overview":{"value":"The group meets an enigmatic girl named Flameu who drives them away from the ruins. After hearing about her story, Escha decides to return to the ruins in order to help her.","language":"en-US"},"airDateText":{"value":"2014-06-19","language":"it-IT"},"runtimeMinutes":25,"rating":8,"thumbnail":"https://image.tmdb.org/t/p/w300/a84h0eo6N3rts1lYU0qrJ8TGuxI.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/a84h0eo6N3rts1lYU0qrJ8TGuxI.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/60819/season/1/episode/11"},{"id":"989329","seasonNumber":1,"episodeNumber":12,"title":{"value":"Episodio 12","language":"it-IT"},"overview":{"value":"Escha and her friends return to the ruins to face Flameu. They attempt to free her from what binds her to the ruins, but in the end, it is up to Flameu.","language":"en-US"},"airDateText":{"value":"2014-06-26","language":"it-IT"},"runtimeMinutes":25,"rating":6.5,"thumbnail":"https://image.tmdb.org/t/p/w300/cwiqYuVgE9a5QVvL9Z2LJdu0sHv.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/cwiqYuVgE9a5QVvL9Z2LJdu0sHv.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/60819/season/1/episode/12"}],"sourceUrl":"https://www.themoviedb.org/tv/60819/season/1"},"fields":{},"episodes":{"1":{"checkedAt":1793376858756,"status":"ok"},"2":{"checkedAt":1793376858756,"status":"ok"},"3":{"checkedAt":1793376858756,"status":"ok"},"4":{"checkedAt":1793376858756,"status":"ok"},"5":{"checkedAt":1793376858756,"status":"ok"},"6":{"checkedAt":1793376858756,"status":"ok"},"7":{"checkedAt":1793376858756,"status":"ok"},"8":{"checkedAt":1793376858756,"status":"ok"},"9":{"checkedAt":1793376858756,"status":"ok"},"10":{"checkedAt":1793376858756,"status":"ok"},"11":{"checkedAt":1793376858756,"status":"ok"},"12":{"checkedAt":1793376858756,"status":"ok"}}}
