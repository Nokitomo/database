://image.tmdb.org/t/p/original/fMwZrJ9D4UPzmus2ihjDzDCApgG.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/37513/season/1/episode/12"},{"id":"847456","seasonNumber":1,"episodeNumber":13,"title":{"value":"Episodio 13","language":"it-IT"},"overview":{"value":"The Four Musketeers meet with the French Ambassador to England, and they attend a party thrown by the English king and queen intending to steal important documents held by the British Undersecretary of Foreign Affairs.","language":"en-US"},"airDateText":{"value":"2006-11-18","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/lES5dMMf2DsXTupWzinPbxHKVn4.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/lES5dMMf2DsXTupWzinPbxHKVn4.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/37513/season/1/episode/13"},{"id":"847437","seasonNumber":1,"episodeNumber":14,"title":{"value":"Episodio 14","language":"it-IT"},"overview":{"value":"The Four Musketeers plan to copy Wood’s documents with Guercy’s help, but Robin’s hand is cursed rummaging through papers.","language":"en-US"},"airDateText":{"value":"2006-11-25","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/eVdvp1FRgzsPg6h2l0TAOBDjd8H.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/eVdvp1FRgzsPg6h2l0TAOBDjd8H.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/37513/season/1/episode/14"},{"id":"847438","seasonNumber":1,"episodeNumber":15,"title":{"value":"Episodio 15","language":"it-IT"},"overview":{"value":"Robert Wood and Lord Sandwich find out someone has tampered with their documents; King Louis XV orders Durand to kill anyone who has read the Psalm of the King, and to do away with D’Eon whether he has or not.","language":"en-US"},"airDateText":{"value":"2006-12-09","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/i5tyw8UMCfAP3xLDkFBGKQKmgvZ.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/i5tyw8UMCfAP3xLDkFBGKQKmgvZ.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/37513/season/1/episode/15"},{"id":"847439","seasonNumber":1,"episodeNumber":16,"title":{"value":"Episodio 16","language":"it-IT"},"overview":{"value":"Robespierre captures and interrogates Durand; D’Eon and the others attempt to rescue him.","language":"en-US"},"airDateText":{"value":"2006-12-16","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/zTm2qlE9OAuAtHmbljB9iLdkOkC.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/zTm2qlE9OAuAtHmbljB9iLdkOkC.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/37513/season/1/episode/16"},{"id":"847440","seasonNumber":1,"episodeNumber":17,"title":{"value":"Episodio 17","language":"it-IT"},"overview":{"value":"After D’Eon speaks to the Queen about two souls existing together in one vessel and Durand is released, the Four Musketeers head for Medmenham Abbey.","language":"en-US"},"airDateText":{"value":"2006-12-23","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/nqbSIdZ4W5uS9hEYkJIjDv1GJ6f.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/nqbSIdZ4W5uS9hEYkJIjDv1GJ6f.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/37513/season/1/episode/17"},{"id":"847441","seasonNumber":1,"episodeNumber":18,"title":{"value":"Episodio 18","language":"it-IT"},"overview":{"value":"Lia continues reciting Psalms until Teillagory calms her down. King Louis receives copies of Robert Wood’s documents.","language":"en-US"},"airDateText":{"value":"2007-01-06","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/tmFcFI5TDM8232m00z5vpOO56tT.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/tmFcFI5TDM8232m00z5vpOO56tT.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/37513/season/1/episode/18"},{"id":"847442","seasonNumber":1,"episodeNumber":19,"title":{"value":"Episodio 19","language":"it-IT"},"overview":{"value":"The Four Musketeers obtain the Psalm of Kings. Durand goes to the French Embassy, attempting to return to France alone so as not to have to kill his comrades.","language":"en-US"},"airDateText":{"value":"2007-01-13","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/tc6DjUHL8e8TMqK2Tj8UbtyoBZP.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/tc6DjUHL8e8TMqK2Tj8UbtyoBZP.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/37513/season/1/episode/19"},{"id":"847443","seasonNumber":1,"episodeNumber":20,"title":{"value":"Episodio 20","language":"it-IT"},"overview":{"value":"Durand’s back-up plan begins to unfold; he asked in a written confession that the authorities search the French Embassy. D’Eon, Robin, and Teillagory return to France, just in time for D’Eon to be captured by the Duke of Orleans.","language":"en-US"},"airDateText":{"value":"2007-01-27","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/9s61rTeKu721Yt2ARaLj4erR9XP.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/9s61rTeKu721Yt2ARaLj4erR9XP.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/37513/season/1/episode/20"},{"id":"847444","seasonNumber":1,"episodeNumber":21,"title":{"value":"Episodio 21","language":"it-IT"},"overview":{"value":"D’Eon is taken to Le Chateau d’Orleans. Robin eludes capture and follows to the mansion to rescue D’Eon, who manages to escape and ends up dueling with Teillagory.","language":"en-US"},"airDateText":{"value":"2007-02-03","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/6bwjUOz8B1vnt90x4DYQJcUItQc.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/6bwjUOz8B1vnt90x4DYQJcUItQc.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/37513/season/1/episode/21"},{"id":"847458","seasonNumber":1,"episodeNumber":22,"title":{"value":"Episodio 22","language":"it-IT"},"overview":{"value":"Saint-Germain tries to win Queen Marie over to his cause, which she refuses and they fight. Later, Broglie and the King prepare to kill the Queen.","language":"en-US"},"airDateText":{"value":"2007-02-10","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/shNCgBCE4OLMaKTEK1xdDPrcpQr.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/shNCgBCE4OLMaKTEK1xdDPrcpQr.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/37513/season/1/episode/22"},{"id":"847457","seasonNumber":1,"episodeNumber":23,"title":{"value":"Episodio 23","language":"it-IT"},"overview":{"value":"Upon witnessing the deaths of the Queen and Anna, Robin shoots at the king, but Broglie protects him and allows him to escape. D'Eon sees another of Lia's memories of her and Maximilien, finding out that he had proposed to her and that she had agreed happily, and that Maximilien disliked the King for keeping him and Lia apart. Maximilien abandoned the King's orders for him to go to Russia, stealing the Royal Psalms and giving them to Lia for her to read instead. While she manages to read the Psalms, she wrote Maximilien a letter claiming that she was unable to do so and rejecting his love. Meanwhile, Maximilien approaches a now hateful Robin, commenting that Robin's ability to actually carry the Psalms is a sign that the Psalms want change to occur in France, and telling him to take revenge for his murdered friends. D'Eon is chased down by palace guards, but Lorenza kills them, and once free he visits Anna's coffin. He then sneaks into Broglie's room and forces him to bring him to the King's chambers. Lia then takes over, asking the King whether he was responsible for the deaths of Anna, Queen Marie, and Lia herself.","language":"en-US"},"airDateText":{"value":"2007-02-17","language":"it-IT"},"runtimeMinu