3,"episodeNumber":9,"title":{"value":"Episodio 9","language":"it-IT"},"overview":{"value":"The Autoscorers' goal is revealed, and the Symphogear wielders must split up to stop them. Tsubasa visits her dad's house, while Hibiki is still uncertain about her own father.","language":"en-US"},"airDateText":{"value":"2015-08-29","language":"it-IT"},"runtimeMinutes":24,"thumbnail":"https://image.tmdb.org/t/p/w300/tBMMBBz54IAnzuXrANLhcYf7lwG.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/tBMMBBz54IAnzuXrANLhcYf7lwG.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/63322/season/3/episode/9"},{"id":"1100529","seasonNumber":3,"episodeNumber":10,"title":{"value":"Episodio 10","language":"it-IT"},"overview":{"value":"Dr. Ver is back, and the truth behind Carol's plot is revealed. Will the Symphogear wielders be able to stop them in time?","language":"en-US"},"airDateText":{"value":"2015-09-05","language":"it-IT"},"runtimeMinutes":24,"thumbnail":"https://image.tmdb.org/t/p/w300/b8a1knu6Fn6tbtD2EMNj1qJgFBR.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/b8a1knu6Fn6tbtD2EMNj1qJgFBR.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/63322/season/3/episode/10"},{"id":"1104781","seasonNumber":3,"episodeNumber":11,"title":{"value":"Episodio 11","language":"it-IT"},"overview":{"value":"Carol's World Destructor device is complete, and she's ready to dissect the world. Will the Symphogear wielders be able to stop her in time?","language":"en-US"},"airDateText":{"value":"2015-09-12","language":"it-IT"},"runtimeMinutes":24,"thumbnail":"https://image.tmdb.org/t/p/w300/l1Of4izaRRY02UobuBEYBSsOb74.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/l1Of4izaRRY02UobuBEYBSsOb74.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/63322/season/3/episode/11"},{"id":"1104782","seasonNumber":3,"episodeNumber":12,"title":{"value":"Episodio 12","language":"it-IT"},"overview":{"value":