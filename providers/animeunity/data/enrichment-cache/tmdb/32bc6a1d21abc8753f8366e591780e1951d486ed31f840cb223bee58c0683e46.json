qIr6M3H1WFzSZjh.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/5HWdIVR8TA5qqIr6M3H1WFzSZjh.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/45790/season/1/episode/17"},{"id":"904510","seasonNumber":1,"episodeNumber":18,"title":{"value":"La vendetta di von Stroheim","language":"it-IT"},"overview":{"value":"Joseph e Caesar combinano le loro onde concentriche contro gli uomini del pilastro che hanno preso il controllo del corpo di Suzi Q per rubare la Pietra rossa dell'Aja.","language":"it-IT"},"airDateText":{"value":"2013-02-09","language":"it-IT"},"runtimeMinutes":24,"rating":7.2,"thumbnail":"https://image.tmdb.org/t/p/w300/jiNmwMUqX0AKaP20tyQ626E4dMK.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/jiNmwMUqX0AKaP20tyQ626E4dMK.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/45790/season/1/episode/18"},{"id":"904511","seasonNumber":1,"episodeNumber":19,"title":{"value":"Corsa lungo il Baratro della Morte","language":"it-IT"},"overview":{"value":"Stroheim inizia a combattere contro Kars nel suo nuovo corpo meccanico. Nel frattempo, Joseph e Kars cadono da un dirupo mentre cercano di afferrare la Pietra rossa.","language":"it-IT"},"airDateText":{"value":"2013-02-16","language":"it-IT"},"runtimeMinutes":24,"rating":7.5,"thumbnail":"https://image.tmdb.org/t/p/w300/pU27dEESLs2WqOq8iuzB8q82bS4.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/pU27dEESLs2WqOq8iuzB8q82bS4.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/45790/season/1/episode/19"},{"id":"904508","seasonNumber":1,"episodeNumber":20,"title":{"value":"Il giovane Caesar","language":"it-IT"},"overview":{"value":"Caesar arriva al rifugio del nemico con una nuova mossa a sorpresa mentre Lisa Lisa rivela il suo passato a Joseph.","language":"it-IT"},"airDateText":{"value":"2013-02-23","language":"it-IT"},"runtimeMinutes":24,"rating":8.2,"thumbnail":"https://image.tmdb.org/t/p/w300/nKENXHCZPB