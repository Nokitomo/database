iginal/haJRk3SMHuuemXQGYPjfTrMJNLH.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/45790/season/1/episode/5"},{"id":"904514","seasonNumber":1,"episodeNumber":6,"title":{"value":"Il coraggio di domani","language":"it-IT"},"overview":{"value":"Bruford, il leggendario cavaliere resuscitato, riacquista la sua anima umana e affida a JoJo la sua spada. Tarkus attacca JoJo con il suo potere travolgente.","language":"it-IT"},"airDateText":{"value":"2012-11-10","language":"it-IT"},"runtimeMinutes":24,"rating":7.3,"thumbnail":"https://image.tmdb.org/t/p/w300/3MFnoOuLi2XDJOv07JqXQjIZ0Ir.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/3MFnoOuLi2XDJOv07JqXQjIZ0Ir.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/45790/season/1/episode/6"},{"id":"904521","seasonNumber":1,"episodeNumber":7,"title":{"value":"L'erede","language":"it-IT"},"overview":{"value":"Zeppeli affronta Tarkus nonostante sappia già come andrà a finire. Nel suo ultimo atto, usa le poche forze rimaste per trasmettere i suoi poteri a JoJo, suo successore.","language":"it-IT"},"airDateText":{"value":"2012-11-17","language":"it-IT"},"runtimeMinutes":24,"rating":7.2,"thumbnail":"https://image.tmdb.org/t/p/w300/2siQRWUBiDJptmBA0JuIBFTaJrg.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/2siQRWUBiDJptmBA0JuIBFTaJrg.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/45790/season/1/episode/7"},{"id":"986250","seasonNumber":1,"episodeNumber":8,"title":{"value":"Scontro decisivo! JoJo e Dio","language":"it-IT"},"overview":{"value":"JoJo salva la sorella di Poco, ma Dire, amico di Zeppeli, viene completamente annientato da Dio. Impugnando la spada di Bruford, JoJo affronta Dio ancora una volta.","language":"it-IT"},"airDateText":{"value":"2012-11-24","language":"it-IT"},"runtimeMinutes":24,"rating":7.4,"thumbnail":"https://image.tmdb.org/t/p/w300/LzSUjDo8qoNySPF5Yyfu11QJ4g.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/LzSUjDo8qoNySPF5Yyfu11QJ4g.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/45790/season/1/episode/8"},{"id":"904519","seasonNumber":1,"episodeNumber":9,"title":{"value":"L'ultima onda!","language":"it-IT"},"overview":{"value":"Dopo il matrimonio, JoJo ed Erina vanno in crociera per la loro luna di miele, ma JoJo rimane scioccato dalla presenza di uno dei servi di Dio sulla nave.","language":"it-IT"},"airDateText":{"value":"2012-12-01","language":"it-IT"},"runtimeMinutes":24,"rating":7.8,"thumbnail":"https://image.tmdb.org/t/p/w300/dkKVrQZl55QazoySIXMPA2wPfKU.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/dkKVrQZl55QazoySIXMPA2wPfKU.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/45790/season/1/episode/9"},{"id":"904513","seasonNumber":1,"episodeNumber":10,"title":{"value":"JoJo di New York","language":"it-IT"},"overview":{"value":"Nel 1938, molte maschere di pietra sono rinvenute vicino a una rovina messicana. Nel frattempo a New York, Joseph, nipote di JoJo, aiuta un ragazzo di nome Smokey.","language":"it-IT"},"airDateText":{"value":"2012-12-08","language":"it-IT"},"runtimeMinutes":24,"rating":7.6,"thumbnail":"https://image.tmdb.org/t/p/w300/yjg2iTRgFaJpjOO8Ofkfk2NfzeV.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/yjg2iTRgFaJpjOO8Ofkfk2NfzeV.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/45790/season/1/episode/10"},{"id":"904525","seasonNumber":1,"episodeNumber":11,"title":{"value":"Maestro del gioco","language":"it-IT"},"overview":{"value":"Joseph lotta contro Straizo, diventato un vampiro dopo aver tradito l'amico Speedwagon. Dopo lo scontro, Straizo lo mette in guardia su \"l'uomo del pilastro\".","language":"it-IT"},"airDateText":{"value":"2012-12-15","language":"it-IT"},"runtimeMinutes":24,"rating":7.7,"thumbnail":"https://image.tmdb.org/t/p/w300/3daivEmX75UfB76yXaWeVQnRgLP.jpg","stills":[{"type":"still","url":"https://image.tmdb.