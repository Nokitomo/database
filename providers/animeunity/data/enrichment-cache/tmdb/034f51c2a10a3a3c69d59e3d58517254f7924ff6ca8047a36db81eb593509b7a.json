r":4,"episodeNumber":25,"title":{"value":"I bicchieri misteriosi","language":"it-IT"},"overview":{"value":"Vengono spediti dei misteriosi bicchieri in vetro alle apprendiste streghe, che si rivelano essere magici. Baba ricorda uno dei nipoti dell'ex Regina per la somiglianza delle tazze.","language":"it-IT"},"airDateText":{"value":"2002-07-21","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/g9UfaXz9ODzROgDBz8F9eul2fp3.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/g9UfaXz9ODzROgDBz8F9eul2fp3.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/20353/season/4/episode/25"},{"id":"582650","seasonNumber":4,"episodeNumber":26,"title":{"value":"Il campeggio","language":"it-IT"},"overview":{"value":"I ragazzi vanno in campeggio. Durante una caccia al tesoro, Doremì e Tetsuya si perdono.","language":"it-IT"},"airDateText":{"value":"2002-07-26","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/mlZZk0v0L4Zsu9S7Acz4MeWUYVg.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/mlZZk0v0L4Zsu9S7Acz4MeWUYVg.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/20353/season/4/episode/26"},{"id":"582620","seasonNumber":4,"episodeNumber":27,"title":{"value":"L'elefantina bianca","language":"it-IT"},"overview":{"value":"Durante un festival, Hanna fa la conoscenza di un'elefantina bianca che è stata abbandonata. Le due fanno subito amicizia e Hanna decide di chiamarla Pao.","language":"it-IT"},"airDateText":{"value":"2002-08-04","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/a2mvKucjHOIXqKf9UnJ8tpFQMfd.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/a2mvKucjHOIXqKf9UnJ8tpFQMfd.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/20353/season/4/episode/27"},{"id":"582621","seasonNumber":4,"episodeNumber":28,"title":{"value":"Nonni tutto pepe","language":"it-IT"},"overview":{"value":"Le ragazze visitano una casa di riposo.","language":"it-IT"},"airDateText":{"value":"2002-08-11","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/9ltKEXs3o8EJvivbKLU2YCmlJtm.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/9ltKEXs3o8EJvivbKLU2YCmlJtm.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/20353/season/4/episode/28"},{"id":"582572","seasonNumber":4,"episodeNumber":29,"title":{"value":"Tienimi per mano","language":"it-IT"},"overview":{"value":"Hanna si perde al festival estivo, ma incontra un misterioso ragazzo e gli fa promettere di non lasciare andare la sua mano.","language":"it-IT"},"airDateText":{"value":"2002-08-18","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/oL12h3n9gRdGSOd3QcUnaVni3A1.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/oL12h3n9gRdGSOd3QcUnaVni3A1.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/20353/season/4/episode/29"},{"id":"582574","seasonNumber":4,"episodeNumber":30,"title":{"value":"Preoccupazioni nel Mondo delle Streghe","language":"it-IT"},"overview":{"value":"La Regina del Mondo delle Streghe si ammala e le apprendiste si recano al suo castello.","language":"it-IT"},"airDateText":{"value":"2002-08-25","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/pFS3T1qKGSMnhTTSrBQ8AbREe5w.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/pFS3T1qKGSMnhTTSrBQ8AbREe5w.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/20353/season/4/episode/30"},{"id":"582575","seasonNumber":4,"episodeNumber":31,"title":{"value":"Pao, l'elefantina magica","language":"it-IT"},"overview":{"value":"Esiste una leggenda secondo cui un elefante bianco può curare coloro che sono feriti; Pao potrebbe essere l'elefante in questione, quando Eufonia cade sotto una maledizione.","language":"it-IT"},"airDateText":{"value":"2002-09-01","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/lo0ZblnY60dEj0WB6zbjKyceQ7k.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/lo0ZblnY60dEj0WB6zbjKyceQ7k.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/20353/season/4/episode/31"},{"id":"582622","seasonNumber":4,"episodeNumber":32,"title":{"value":"L'apparenza inganna","language":"it-IT"},"overview":{"value":"Hanna si ammala e le ragazze devono costantemente tenerla sotto controllo. Nel frattempo diventa amica di Sachiko Ijuuin, studentessa modello che vorrebbe che i suoi genitori, entrambi insegnanti, avessero più tempo libero da dedicarle.","language":"it-IT"},"airDateText":{"value":"2002-09-08","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/4BaBbUTwxuo2j4OqW0l6aPnYlMo.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/4BaBbUTwxuo2j4OqW0l6aPnYlMo.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/20353/season/4/episode/32"},{"id":"582623","seasonNumber":4,"episodeNumber":33,"title":{"value":"L'attrice famosa","language":"it-IT"},"overview":{"value":"Con sorpresa di tutti, Lullaby non passa il provino per un film che avrebbe segnato il suo debutto a Hollywood.","language":"it-IT"},"airDateText":{"value":"2002-09-15","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/rseDi0LobRvzNsl3N8EJAnV5BKP.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/rseDi0LobRvzNsl3N8EJAnV5BKP.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/20353/season/4/episode/33"},{"id":"582579","seasonNumber":4,"episodeNumber":34,"title":{"value":"La gattina Baba","language":"it-IT"},"overview":{"value":"Anche Baba si ammala e, mentre dorme, sogna uno dei nipoti di Majo Tourbillon.","language":"it-IT"},"airDateText":{"value":"2002-09-22","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/khGHERbYGeFYTYGsnWTBRuAkG38.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/khGHERbYGeFYTYGsnWTBRuAkG38.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/20353/season/4/episode/34"},{"id":"582625","seasonNumber":4,"episodeNumber":35,"title":{"value":"L'esame del quarto livello","language":"it-IT"},"overview":{"value":"Le ragazze preparano Hanna e la sua fatina Totò a sostenere l'esame di quarto livello.","language":"it-IT"},"airDateText":{"value":"2002-09-29","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/tUybj2tGC6JcThie0aLg1Esen4m.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/tUybj2tGC6JcThie0aLg1Esen4m.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/20353/season/4/episode/35"},{"id":"582626","seasonNumber":4,"episodeNumber":36,"title":{"value":"La bicicletta, che passione!","language":"it-IT"},"overview":{"value":"Hanna impara ad andare in bicicletta e, insieme a Morikawa, cerca di far passare la paura delle bici a Hiroko.","language":"it-IT"},"airDateText":{"value":"2002-10-06","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/nI0gO3ckjv4X34qERVXmaOjay2S.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/nI0gO3ckjv4X34qERVXmaOjay2S.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/20353/season/4/episode/36"},{"id":"582630","seasonNumber":4,"episodeNumber":37,"title":{"value":"I maghi addormentati","language":"it-IT"},"overview":{"value":"Anche il Regno dei Maghi viene invaso dalla maledizione dell'ex Regina.","language":"it-IT"},"airDateText":{"value":"2002-10-13","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/6fnSl9dh2LN3dRsk3j8HQsDJR3V.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/6fnSl9dh2LN3dRsk3j8HQsDJR3V.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/20353/season/4/episode/37"},{"id":"582632","seasonNumber":4,"episodeNumber":38,"title":{"value":"Voglia di tornare insieme","language":"it-IT"},"overview":{"value":"Sinfony trascorre del tempo con suo padre e sua madre.","language":"it-IT"},"airDateText":{"value":"2002-10-20","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/m92nzt0ZDwzGuuJsBnj84Xv432y.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/m92nzt0ZDwzGuuJsBnj84Xv432y.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/20353/season/4/episode/38"},{"id":"582634","seasonNumber":4,"episodeNumber":39,"title":{"value":"Al cuor non si comanda","language":"it-IT"},"overview":{"value":"Le apprendiste si recano da Majo Roxanne, che in passato è stata la cuoca personale dell'ex Regina, per raccogliere maggiori informazioni su Ingrid, nipote di Majo Tourbillon.","language":"it-IT"},"airDateText":{"value":"2002-10-27","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/dMqzDFBnLMPq9LFVb0G3zviCXB0.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/dMqzDFBnLMPq9LFVb0G3zviCXB0.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/20353/season/4/episode/39"},{"id":"582636","seasonNumber":4,"episodeNumber":40,"title":{"value":"Una strega particolare","language":"it-IT"},"overview":{"value":"Doremì, che non ha idea su cosa fare in futuro, incontra una strega di nome Mirai che non usa la magia per scelta e che le dà consigli.","language":"it-IT"},"airDateText":{"value":"2002-11-10","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/t2VRuu68v0kOiDwvhVFNeFafCKG.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/t2VRuu68v0kOiDwvhVFNeFafCKG.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/20353/season/4/episode/40"},{"id":"582638","seasonNumber":4,"episodeNumber":41,"title":{"value":"L'esame di primo livello","language":"it-IT"},"overview":{"value":"Bibì deve affrontare l'esame di primo livello, ma è preoccupata perché non sa se, diventando una vera strega, può restare nel mondo umano insieme ai suoi cari.","language":"it-IT"},"airDateText":{"value":"2002-11-17","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/b71wijMEnVoBlnqGsQl9HoHKw0n.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/b71wijMEnVoBlnqGsQl9HoHKw0n.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/20353/season/4/episode/41"},{"id":"582580","seasonNumber":4,"episodeNumber":42,"title":{"value":"Voglio decidere da sola","language":"it-IT"},"overview":{"value":"Melody scopre che sua madre l'ha iscritta al test d'ingresso per entrare alla Karen Girls Academy senza il suo permesso. In realtà dietro il gesto della madre si nasconde un segreto.","language":"it-IT"},"airDateText":{"value":"2002-11-24","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/pRbtMKwA0npR22fIU6HgxF8tB2p.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/pRbtMKwA0npR22fIU6HgxF8tB2p.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/20353/season/4/episode/42"},{"id":"582651","seasonNumber":4,"episodeNumber":43,"title":{"value":"L'esame","language":"it-IT"},"overview":{"value":"Reika cade sotto l'influsso della maledizione delle streghe. Hanna decide di curarla come esame di primo livello.","language":"it-IT"},"airDateText":{"value":"2002-12-01","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/iQew5BZJtRdFEnCp3DC9U6CNaGA.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/iQew5BZJtRdFEnCp3DC9U6CNaGA.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/20353/season/4/episode/43"},{"id":"582582","seasonNumber":4,"episodeNumber":44,"title":{"value":"Alla ricerca dell'ultimo indizio","language":"it-IT"},"overview":{"value":"Le ragazze incontrano Robby, il nipote di Roy e colui che possedeva un arazzo, l'ultimo indizio in grado di liberare l'ex Regina dalla maledizione.","language":"it-IT"},"airDateText":{"value":"2002-12-08","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/9s3hPNtwIoUI5zitOBb39x6wFtc.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/9s3hPNtwIoUI5zitOBb39x6wFtc.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/20353/season/4/episode/44"},{"id":"582641","seasonNumber":4,"episodeNumber":45,"title":{"value":"L'ultimo rovo","language":"it-IT"},"overview":{"value":"Mentre le ragazze finiscono di realizzare l'arazzo, i rovi si diffondono sempre di più.","language":"it-IT"},"airDateText":{"value":"2002-12-15","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/bMUxluL1ywdm0MtevJntIF5T0BJ.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/bMUxluL1ywdm0MtevJntIF5T0BJ.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/20353/season/4/episode/45"},{"id":"582583","seasonNumber":4,"episodeNumber":46,"title":{"value":"L'incantesimo delle ranocchie","language":"it-IT"},"overview":{"value":"La Regina viene liberata e l'incantesimo delle streghe-ranocchie, secondo cui se una strega viene riconosciuta da un umano si trasforma in ranocchia, viene sciolto.","language":"it-IT"},"airDateText":{"value":"2002-12-22","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/2XW0IXdQCoQDxExpI2X3W3m9iYd.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/2XW0IXdQCoQDxExpI2X3W3m9iYd.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/20353/season/4/episode/46"},{"id":"582642","seasonNumber":4,"episodeNumber":47,"title":{"value":"Anche se saremo lontane","language":"it-IT"},"overview":{"value":"Lullaby viene accettata in una scuola media diversa, mentre Mindy non sa se tornare a New York o stare in Giappone.","language":"it-IT"},"airDateText":{"value":"2002-12-29","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/zolK7sEOAzRzOYxhomYVhMq4lZI.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/zolK7sEOAzRzOYxhomYVhMq4lZI.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/20353/season/4/episode/47"},{"id":"582643","seasonNumber":4,"episodeNumber":48,"title":{"value":"Il giorno più bello per Sinfony","language":"it-IT"},"overview":{"value":"Sinfony va a Osaka per fare visita al nonno che è in ospedale. I suoi genitori decidono, per il bene comune e per prendersi cura del nonno, di tornare a vivere a Osaka.","language":"it-IT"},"airDateText":{"value":"2003-01-05","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/6MmH8FDarHIbvOEjJkff6EfJg89.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/6MmH8FDarHIbvOEjJkff6EfJg89.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/20353/season/4/episode/48"},{"id":"582644","seasonNumber":4,"episodeNumber":49,"title":{"value":"Amiche per sempre","language":"it-IT"},"overview":{"value":"Melody vuole andare a studiare nella scuola che ha sempre sognato, ma allo stesso tempo vuole stare insieme a Doremì.","language":"it-IT"},"airDateText":{"value":"2003-01-12","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/zrKQPXoCdJSf88VqzcS4EhyM6qw.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/zrKQPXoCdJSf88VqzcS4EhyM6qw.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/20353/season/4/episode/49"},{"id":"582584","seasonNumber":4,"episodeNumber":50,"title":{"value":"La regina","language":"it-IT"},"overview":{"value":"La Regina del Mondo delle Streghe svela la sua identità: si tratta della dottoressa Yuki, infermiera della scuola di Doremì e le altre, venuta sulla Terra per conoscere meglio gli umani e instaurare così un rapporto con le streghe, come in passato. Intanto, avendo finito l'apprendistato, Doremì fa riprendere a Raganella le sue vere sembianze di Eufonia. Inoltre le ragazze devono prendere la loro più grande decisione: se vogliono diventare streghe a tutti gli effetti devono rimanere nel Mondo delle Streghe senza avere contatti con gli esseri umani, altrimenti se scelgono di rimanere umane, non potranno più vedere Hanna e nemmeno andare nel mondo magico. Le ragazze rinunciano alla magia per mantenere la loro vita e le loro relazioni sulla Terra e fondono i loro Cristalli Fatati in quello di Hanna, la quale diventerà la futura Regina del Regno delle Streghe.","language":"it-IT"},"airDateText":{"value":"2003-01-19","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/u9KGnus9gnYcF1OG78f6JKciJoD.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/u9KGnus9gnYcF1OG78f6JKciJoD.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/20353/season/4/episode/50"},{"id":"582674","seasonNumber":4,"episodeNumber":51,"title":{"value":"Episodio 51","language":"it-IT"},"overview":{"value":"È arrivato il giorno della cerimonia di diploma delle elementari. Doremì si rifiuta di andare a ritirarlo, perché ciò significa che dovrà separarsi dai suoi compagni di scuola, e si rifugia dentro il MAHO, ormai chiuso perché Eufonia è tornata nel Mondo delle Streghe. Tuttavia grazie a una strategia di Hanna, Doremì esce dal negozio e va a scuola insieme agli altri a ritirare il diploma. Mentre Hanna torna nel Mondo delle Streghe, Doremì comincia le scuole medie, Melody va in una prestigiosa scuola privata, Sinfony è riandata a vivere a Osaka con i suoi genitori, tornati assieme, Lullaby continua a lavorare come idol e Mindy ritorna in America. Due anni dopo, Doremì consegna una lettera d'amore a un ragazzo, il quale si rivela essere Tetsuya.","language":"it-IT"},"airDateText":{"value":"2003-01-26","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/mo1pLIXN7NvKNJX3x2sZz37dKR5.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/mo1pLIXN7NvKNJX3x2sZz37dKR5.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/20353/season/4/episode/51"}],"sourceUrl":"https://www.themoviedb.org/tv/20353/season/4"},"failure":null,"fields":{},"episodes":{"1":{"checkedAt":1793476867917,"status":"ok","retryCount":0},"2":{"checkedAt":1793476867917,"status":"ok","retryCount":0},"3":{"checkedAt":1793476867917,"status":"ok","retryCount":0},"4":{"checkedAt":1793476867917,"status":"ok","retryCount":0},"5":{"checkedAt":1793476867917,"status":"ok","retryCount":0},"6":{"checkedAt":1793476867917,"status":"ok","retryCount":0},"7":{"checkedAt":1793476867917,"status":"ok","retryCount":0},"8":{"checkedAt":1793476867917,"status":"ok","retryCount":0},"9":{"checkedAt":1793476867917,"status":"ok","retryCount":0},"10":{"checkedAt":1793476867917,"status":"ok","retryCount":0},"11":{"checkedAt":1793476867917,"status":"ok","retryCount":0},"12":{"checkedAt":1793476867917,"status":"ok","retryCount":0},"13":{"checkedAt":1793476867917,"status":"ok","retryCount":0},"14":{"checkedAt":1793476867917,"status":"ok","retryCount":0},"15":{"checkedAt":1793476867917,"status":"ok","retryCount":0},"16":{"checkedAt":1793476867917,"status":"ok","retryCount":0},"17":{"checkedAt":1793476867917,"status":"ok","retryCount":0},"18":{"checkedAt":1793476867917,"status":"ok","retryCount":0},"19":{"checkedAt":1793476867917,"status":"ok","retryCount":0},"20":{"checkedAt":1793476867917,"status":"ok","retryCount":0},"21":{"checkedAt":1793476867917,"status":"ok","retryCount":0},"22":{"checkedAt":1793476867917,"status":"ok","retryCount":0},"23":{"checkedAt":1793476867917,"status":"ok","retryCount":0},"24":{"checkedAt":1793476867917,"status":"ok","retryCount":0},"25":{"checkedAt":1793476867917,"status":"ok","retryCount":0},"26":{"checkedAt":1793476867917,"status":"ok","retryCount":0},"27":{"checkedAt":1793476867917,"status":"ok","retryCount":