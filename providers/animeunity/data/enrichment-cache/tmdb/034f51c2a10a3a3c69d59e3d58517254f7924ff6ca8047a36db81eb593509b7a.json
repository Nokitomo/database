ta.","language":"it-IT"},"airDateText":{"value":"2002-06-02","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/oowIR8rJY5tXrodwFTb7pcnvLvo.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/oowIR8rJY5tXrodwFTb7pcnvLvo.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/20353/season/4/episode/18"},{"id":"582587","seasonNumber":4,"episodeNumber":19,"title":{"value":"Cuore di papà","language":"it-IT"},"overview":{"value":"Yukari e Aya vogliono una pausa.","language":"it-IT"},"airDateText":{"value":"2002-06-09","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/uTK6rJp0lyOwSUf6I2veDBeblLE.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/uTK6rJp0lyOwSUf6I2veDBeblLE.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/20353/season/4/episode/19"},{"id":"582588","seasonNumber":4,"episodeNumber":20,"title":{"value":"Mindy alla ricerca di un sogno","language":"it-IT"},"overview":{"value":"Le ragazze riflettono su cosa vogliono fare in futuro. Mindy non sa ancora qual è il suo sogno e incontra un ragazzo che si trova nella stessa situazione.","language":"it-IT"},"airDateText":{"value":"2002-06-16","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/8VdqxGVnc3Q4SnH8fKPadPLWGNC.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/8VdqxGVnc3Q4SnH8fKPadPLWGNC.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/20353/season/4/episode/20"},{"id":"582645","seasonNumber":4,"episodeNumber":21,"title":{"value":"Ti voglio bene, Alexander!","language":"it-IT"},"overview":{"value":"Hanna trascorre del tempo con Alexander.","language":"it-IT"},"airDateText":{"value":"2002-06-23","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/oMESwG7M8gidWNl7a5TCDoaTDnl.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/oMESwG7M8gidWNl7a5TC