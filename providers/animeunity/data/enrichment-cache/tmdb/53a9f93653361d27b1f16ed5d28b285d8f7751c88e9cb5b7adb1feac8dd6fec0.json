g","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/37585/season/1/episode/33"},{"id":"850138","seasonNumber":1,"episodeNumber":34,"title":{"value":"Episodio 34","language":"it-IT"},"overview":{"value":"Kenichi and Hermit's fight is interrupted by Loki, who using Honoka as a hostage, renders Kenichi unable to fight back, much to Hermit's anger.","language":"en-US"},"airDateText":{"value":"2007-06-09","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/1G3MWL0pw04kGvASH2Y5Xyzmovy.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/1G3MWL0pw04kGvASH2Y5Xyzmovy.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/37585/season/1/episode/34"},{"id":"850139","seasonNumber":1,"episodeNumber":35,"title":{"value":"Episodio 35","language":"it-IT"},"overview":{"value":"Even after rescuing Honoka and breaking his ties with Ragnarok, Tanimoto is determined to finish his fight with Kenichi.","language":"en-US"},"airDateText":{"value":"2007-06-16","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/dsinit4xFADkgqGT8gnyr1Gm63o.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/dsinit4xFADkgqGT8gnyr1Gm63o.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/37585/season/1/episode/35"},{"id":"850140","seasonNumber":1,"episodeNumber":36,"title":{"value":"Episodio 36","language":"it-IT"},"overview":{"value":"Renka discovers where Kensei Ma is living and appears in Ryouzanpaku, determined not only to bring her father back home, but to win Kenichi's heart too, much to Miu's jealousy.","language":"en-US"},"airDateText":{"value":"2007-06-23","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/5CdriEceZsr8xcpcTzjpapAx0L.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/5CdriEceZsr8xcpcTzjpapAx0L.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/37585/season/1/episode/36"},{"id":"850141","seasonNumber":1,"episodeNumber":37,"title":{"value":"Episodio 37","language":"it-IT"},"overview":{"value":"Instead of waiting for another attack from Ragnarok, Kenichi decides to take the initiative and confront Thor, another member of the Eight Fists, after he hears about his location from Niijima.","language":"en-US"},"airDateText":{"value":"2007-06-30","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/tOp4HUHH62d5F5GL0idPl99L0nH.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/tOp4HUHH62d5F5GL0idPl99L0nH.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/37585/season/1/episode/37"},{"id":"850122","seasonNumber":1,"episodeNumber":38,"title":{"value":"Episodio 38","language":"it-IT"},"overview":{"value":"Thor gets punished by the rest of the Eight Fists League after he chooses to leave the gang. Kisara's unwillingness to join in the punishment makes the others suspicious of her allegiance. Later, Kenichi and Miu spots Kisara taking care of an abandoned kitten, and decides to help her find a home for the kitten. Seeing that Kisara has made contact with Kenichi and Miu, Freya's personal guards attack her for her supposed betrayal.","language":"en-US"},"airDateText":{"value":"2007-07-07","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/zNZpSXURIFqHR7hdTiUN2nXAQs9.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/zNZpSXURIFqHR7hdTiUN2nXAQs9.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/37585/season/1/episode/38"},{"id":"850166","seasonNumber":1,"episodeNumber":39,"title":{"value":"Episodio 39","language":"it-IT"},"overview":{"value":"While Miu takes the kitten to a vet, Kenichi tries to protect Kisara from the Valkyries unit, but his oath to not hit women puts him at a serious disadvantage against them, until Shigure comes to his aid.","language":"en-US"},"airDateText":{"value":"2007-07-14","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/49X4k8BNQOsmKfrg4OduNlkHbIi.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/49X4k8BNQOsmKfrg4OduNlkHbIi.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/37585/season/1/episode/39"},{"id":"850148","seasonNumber":1,"episodeNumber":40,"title":{"value":"Episodio 40","language":"it-IT"},"overview":{"value":"While trying to recall his memories involving his ying-yang badge, Kenichi ends up meeting Odin, the supreme leader of Ragnarok, and their past connection is revealed","language":"en-US"},"airDateText":{"value":"2007-07-21","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/8744Fdh6pPPZNPyDIc7mRyzqrzf.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/8744Fdh6pPPZNPyDIc7mRyzqrzf.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/37585/season/1/episode/40"},{"id":"850149","seasonNumber":1,"episodeNumber":41,"title":{"value":"Episodio 41","language":"it-IT"},"overview":{"value":"Kenichi fails to convince his childhood friend to reconsider and must face his amazing power. Meanwhile, Niijima tries to recruit Tanimoto to the Shinpaku Alliance using a trump card of his.","language":"en-US"},"airDateText":{"value":"2007-07-28","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/kBFLSgjBV24KGyW0ZTgaoxurGMA.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/kBFLSgjBV24KGyW0ZTgaoxurGMA.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/37585/season/1/episode/41"},{"id":"850123","seasonNumber":1,"episodeNumber":42,"title":{"value":"Episodio 42","language":"it-IT"},"overview":{"value":"Kenichi trains with the Elder himself in order to surpass Ryuto's technique by training in the center of Japan called Yamagata which Kenichi has to survive in for 7 days and 7 nights but, can he survive? And Niijima tries to recruit Kisara by using her love for cats.","language":"en-US"},"airDateText":{"value":"2007-08-04","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/asiKzUdXJFbZXABkcQArIhZE8Yp.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/asiKzUdXJFbZXABkcQArIhZE8Yp.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/37585/season/1/episode/42"},{"id":"850150","seasonNumber":1,"episodeNumber":43,"title":{"value":"Episodio 43","language":"it-IT"},"overview":{"value":"While training in the mountains, Kenichi gets lost but is rescued by a mysterious man named Ogata Ishinsai, and receives from him a tempting proposal that could change his destiny.","language":"en-US"},"airDateText":{"value":"2007-08-11","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/5nHMCsAex5ztLSR66vqM4hAySu.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/5nHMCsAex5ztLSR66vqM4hAySu.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/37585/season/1/episode/43"},{"id":"850124","seasonNumber":1,"episodeNumber":44,"title":{"value":"Episodio 44","language":"it-IT"},"overview":{"value":"Kenichi continues his training with The Elder while the Shinpaku Alliance tries to develop a unification with Kisara's subordinates. Meanwhile, Berserker and Freya begin to hunt down the Shinpaku Alliance.","language":"en-US"},"airDateText":{"value":"2007-08-18","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/yJzN7cZhuZMsTImsjuEzAzBT5gU.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/yJzN7cZhuZMsTImsjuEzAzBT5gU.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/37585/season/1/episode/44"},{"id":"850151","seasonNumber":1,"episodeNumber":45,"title":{"value":"Episodio 45","language":"it-IT"},"overview":{"value":"Siegfried appears in the last moment to protect Niijima from Berserker. Meanwhile, Miu deals with the Valkyrie unit by herself as Kisara has an one on one match with Freya.","language":"en-US"},"airDateText":{"value":"2007-08-25","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/fyfHyQdzXGom2Qzg4lVd5W9KUNk.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/fyfHyQdzXGom2Qzg4lVd5W9KUNk.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/37585/season/1/episode/45"},{"id":"850152","seasonNumber":1,"episodeNumber":46,"title":{"value":"Episodio 46","language":"it-IT"},"overview":{"value":"Ragnarok discovers Niijima's Shinpaku Alliance hideout. Loki has his underlings surrounding the building to put an end to the Shinpaku Alliance. The rival gangs go all out in this decisive battle. Kenichi receives a message from Niijima and becomes concerned about the situation back home.","language":"en-US"},"airDateText":{"value":"2007-09-01","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/lJhPeXWJq7QCRJO90JvkMzkKBbw.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/lJhPeXWJq7QCRJO90JvkMzkKBbw.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/37585/season/1/episode/46"},{"id":"850167","seasonNumber":1,"episodeNumber":47,"title":{"value":"Episodio 47","language":"it-IT"},"overview":{"value":"Kenichi arrives just in time to save his comrades. Kenichi is enraged after discovering the defeat of Takeda, Ukita and Siegfried so he charges towards Berserker but Hermit stops him. Hermit fights Berserker instead so that Kenichi is at his best physical form when he fights Odin. Berserker becomes excited in the fight with Hermit and unleashes his most feared fighting style, Berserk mode.","language":"en-US"},"airDateText":{"value":"2007-09-08","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/3JQUMjaKrYI8YGVM4WEGv3xDXt9.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/3JQUMjaKrYI8YGVM4WEGv3xDXt9.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/37585/season/1/episode/47"},{"id":"850158","seasonNumber":1,"episodeNumber":48,"title":{"value":"Episodio 48","language":"it-IT"},"overview":{"value":"Berserker has been defeated by Hermit, so Kenichi challenges Odin to a second fight. Ryoto accepts the challenge and the long awaited battle begins. Kenichi makes full use of the training he had received from Furinji-sama. Kensei eagerly watches the fight between First Fist Odin and Kenichi from a distance.","language":"en-US"},"airDateText":{"value":"2007-09-15","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/9Zd2rdRN7dIDn7IgodT8OagCKuI.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/9Zd2rdRN7dIDn7IgodT8OagCKuI.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/37585/season/1/episode/48"},{"id":"850169","seasonNumber":1,"episodeNumber":49,"title":{"value":"Episodio 49","language":"it-IT"},"overview":{"value":"Unable to evade Ryuto's punches at all, Kenichi starts to counter attack by constantly changing his fighting style, imitating his masters' personalities (to their combined horror and amusement).","language":"en-US"},"airDateText":{"value":"2007-09-22","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/hu9rCnrasGGBCRL95n4NM4Ey2eP.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/hu9rCnrasGGBCRL95n4NM4Ey2eP.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/37585/season/1/episode/49"},{"id":"850168","seasonNumber":1,"episodeNumber":50,"title":{"value":"Episodio 50","language":"it-IT"},"overview":{"value":"Cornered by Kenichi's unexpected reaction, Ryuto utilizes a dangerous technique to rise up his power beyond his body's limits, and the reason for his grudge on him is revealed. As their fight comes close to a conclusion, Kenichi continues determined to win, not only for his own sake, but for his childhood friend's too.","language":"en-US"},"airDateText":{"value":"2007-09-29","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/gQbn5Z8NsdXRTuqvmKCl2YwEWcp.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/gQbn5Z8NsdXRTuqvmKCl2YwEWcp.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/37585/season/1/episode/50"}],"sourceUrl":"https://www.themoviedb.org/tv/37585/season/1"},"failure":null,"fields":{},"episodes":{"1":{"checkedAt":1793476585548,"status":"ok","retryCount":0},"2":{"checkedAt":1793476585548,"status":"ok","retryCount":0},"3":{"checkedAt":1793476585548,"status":"ok","retryCount":0},"4":{"checkedAt":1793476585548,"status":"ok","retryCount":0},"5":{"checkedAt":1793476585548,"status":"ok","retryCount":0},"6":{"checkedAt":1793476585548,"status":"ok","retryCount":0},"7":{"checkedAt":1793476585548,"status":"ok","retryCount":0},"8":{"checkedAt":1793476585548,"status":"ok","retryCount":0},"9":{"checkedAt":1793476585548,"status":"ok","retryCount":0},"10":{"checkedAt":1793476585548,"status":"ok","retryCount":0},"11":{"checkedAt":1793476585548,"status":"ok","retryCount":0},"12":{"checkedAt":1793476585548,"status":"ok","retryCount":0},"13":{"checkedAt":1793476585548,"status":"ok","retryCount":0},"14":{"checkedAt":1793476585548,"status":"ok","retryCount":0},"15":{"checkedAt":1793476585548,"status":"ok","retryCount":0},"16":{"checkedAt":1793476585548,"status":"ok","retryCount":0},"17":{"checkedAt":1793476585548,"status":"ok","retryCount":0},"18":{"checkedAt":1793476585548,"status":"ok","retryCount":0},"19":{"checkedAt":1793476585548,"status":"ok","retryCount":0},"20":{"checkedAt":1793476585548,"status":"ok","retryCount":0},"21":{"checkedAt":1793476585548,"status":"ok","retryCount":0},"22":{"checkedAt":1793476585548,"status":"ok","retryCount":0},"23":{"checkedAt":1793476585548,"status":"ok","retryCount":0},"24":{"checkedAt":1793476585548,"status":"ok","retryCount":0},"25":{"checkedAt":1793476585548,"status":"ok","retry