":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/65292/season/2/episode/5"},{"id":"1228366","seasonNumber":2,"episodeNumber":6,"title":{"value":"Episodio 6","language":"it-IT"},"overview":{"value":"Tosaki has been captured. Izumi rushes back to the hideout and insists they rescue him. Initially refusing, Nagai ultimately leads a team to rescue Tosaki from the Americans.","language":"en-US"},"airDateText":{"value":"2016-11-11","language":"it-IT"},"runtimeMinutes":22,"rating":7,"thumbnail":"https://image.tmdb.org/t/p/w300/h3g3S0n0ZWdTMspMSOSLWbLl0IS.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/h3g3S0n0ZWdTMspMSOSLWbLl0IS.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/65292/season/2/episode/6"},{"id":"1228367","seasonNumber":2,"episodeNumber":7,"title":{"value":"Episodio 7","language":"it-IT"},"overview":{"value":"Nagai and the group pursue the Americans and Tosaki. Izumi manages to catch up with them and ultimately rescue Tosaki. Unfortunately, this means they missed their window to catch Sato.","language":"en-US"},"airDateText":{"value":"2016-11-18","language":"it-IT"},"runtimeMinutes":24,"rating":7.5,"thumbnail":"https://image.tmdb.org/t/p/w300/svJmw1gELFtulacCXpzLWPJBFCZ.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/svJmw1gELFtulacCXpzLWPJBFCZ.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/65292/season/2/episode/7"},{"id":"1228368","seasonNumber":2,"episodeNumber":8,"title":{"value":"Episodio 8","language":"it-IT"},"overview":{"value":"Tosaki manages to get his team allowed into the building where Sato's next target is. Just as the clock ticks closer, a truck rushes in and sets off an E.M.P. bomb, rendering all electronics and new anti-Ajin guns useless. Sato charges in for an old fashioned gun fight.","language":"en-US"},"airDateText":{"value":"2016-11-25","language":"it-IT"},"runtimeMinutes":22,"rating":7,"thumbnail":"https://image.tmdb.org/t/p/w300/jme7BfQgbEMtQlLLnKX67ECxvMF.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/jme7BfQgbEMtQlLLnKX67ECxvMF.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/65292/season/2/episode/8"},{"id":"1244877","seasonNumber":2,"episodeNumber":9,"title":{"value":"Episodio 9","language":"it-IT"},"overview":{"value":"Ajin are humans that cannot die. Seventeen years ago, they first appeared on a battlefield in Africa. From then on, more of their kind are discovered within the human society. Their rarity in appearance means that, for experimental purposes, the government will generously reward anyone who captures one. In the present day, for what a certain high school student expects to be a typical summer holiday, his life is about to turn unexpected...","language":"en-US"},"airDateText":{"value":"2016-12-04","language":"it-IT"},"runtimeMinutes":23,"rating":8,"thumbnail":"https://image.tmdb.org/t/p/w300/qGuTZTztMJnyPCeq8mYxb5aGZKE.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/qGuTZTztMJnyPCeq8mYxb5aGZKE.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/65292/season/2/episode/9"},{"id":"1228369","seasonNumber":2,"episodeNumber":10,"title":{"value":"Episodio 10","language":"it-IT"},"overview":{"value":"Nagai and the group return after being defeated by Sato. Nagai struggles to deal with his failures. Sato continues towards his third and final wave, an Ajin run Japan. Tosaki tries to mobilize everyone once more to stop Sato, but Nagai refuses.","language":"en-US"},"airDateText":{"value":"2016-12-02","language":"it-IT"},"runtimeMinutes":23,"rating":7,"thumbnail":"https://image.tmdb.org/t/p/w300/6pcMZcRK1CVhl6wgCdR3DmCwpg1.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/6pcMZcRK1CVhl6wgCdR3DmCwpg1.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/65292/season/2/episode/10"},{"id":"1228370","seasonNumber":2,"episodeNumber":11,"title":{"value":"Episodio 11","language":"it-IT"},"ov