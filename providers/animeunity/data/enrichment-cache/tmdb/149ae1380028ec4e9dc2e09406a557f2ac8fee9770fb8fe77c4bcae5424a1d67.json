xx"}],"sourceUrl":"https://www.themoviedb.org/tv/131041/season/1/episode/21"},{"id":"4114402","seasonNumber":1,"episodeNumber":22,"title":{"value":"Voce","language":"it-IT"},"airDateText":{"value":"2023-03-12","language":"it-IT"},"runtimeMinutes":23,"rating":7.2,"thumbnail":"https://image.tmdb.org/t/p/w300/lW6B2udjVzh4E9WLSWCAbP6jvEk.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/lW6B2udjVzh4E9WLSWCAbP6jvEk.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/131041/season/1/episode/22"},{"id":"4114403","seasonNumber":1,"episodeNumber":23,"title":{"value":"LUCK","language":"it-IT"},"airDateText":{"value":"2023-03-19","language":"it-IT"},"runtimeMinutes":24,"rating":7.1,"thumbnail":"https://image.tmdb.org/t/p/w300/buytu8R9oVv4QIAA0FW9swSGBTB.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/buytu8R9oVv4QIAA0FW9swSGBTB.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/131041/season/1/episode/23"},{"id":"4114404","seasonNumber":1,"episodeNumber":24,"title":{"value":"Il momento è arrivato","language":"it-IT"},"airDateText":{"value":"2023-03-26","language":"it-IT"},"runtimeMinutes":23,"rating":7.4,"thumbnail":"https://image.tmdb.org/t/p/w300/kCufxxbyqEwOjxlQ1B1Zztc7gPp.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/kCufxxbyqEwOjxlQ1B1Zztc7gPp.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/131041/season/1/episode/24"},{"id":"5646889","seasonNumber":1,"episodeNumber":25,"title":{"value":"Tryout","language":"it-IT"},"overview":{"value":"Ego annuncia la partita contro la nazionale U-20 giapponese. Per determinare chi giocherà in quella partita, ha inizio la third selection. La squadra sarà incentrata sugli attuali 6 migliori giocatori del Blue Lock, mentre gli altri, per aggiudicarsi i posti rimanenti, dovranno dimostrare il loro valore in una partita cinque contro cinque.","language":"it-IT"},"airDateText":{"value":"2024-10-06","language":"it-IT"},"runtimeMinutes":25,"rating":7.4,"thumbnail":"https://image.tmdb.org/t/p/w300/gBSF3tkgvFL4y9qemahLwH4CIyP.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/gBSF3tkgvFL4y9qemahLwH4CIyP.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/131041/season/1/episode/25"},{"id":"5646891","seasonNumber":1,"episodeNumber":26,"title":{"value":"L'assasino e il ninja","language":"it-IT"},"overview":{"value":"Isagi viene scelto a far parte del Team A insieme a Nanase e Hiori per giocare contro il Team B dove giocano Karasu, Otoya e Chigiri. Mentre Isagi fatica a trovare un modo per entrare in partita, Chigiri e Hiori dimostrano il loro valore.","language":"it-IT"},"airDateText":{"value":"2024-10-12","language":"it-IT"},"runtimeMinutes":23,"rating":6.1,"thumbnail":"https://image.tmdb.org/t/p/w300/97NloZcN94eEMjCqdgtLwWwMs5.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/97NloZcN94eEMjCqdgtLwWwMs5.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/131041/season/1/episode/26"},{"id":"5646892","seasonNumber":1,"episodeNumber":27,"title":{"value":"Il mondo percepito","language":"it-IT"},"overview":{"value":"Isagi nota l'incompatibilità tra Rin e Shido e cerca di approfittarne. Tuttavia, le sue capacità fisiche non sono sufficienti per farlo e così Hiori gli suggerisce di non pensare meccanicamente ma d'impulso.","language":"it-IT"},"airDateText":{"value":"2024-10-19","language":"it-IT"},"runtimeMinutes":23,"rating":6.4,"thumbnail":"https://image.tmdb.org/t/p/w300/fjJSz4GfdNtIKRdTnDOMGG88k0E.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/fjJSz4GfdNtIKRdTnDOMGG88k0E.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/131041/season/1/episode/27"},{"id":"5646893","seasonNumber":1,"episodeNumber":28,"title":{"value":"Chameleon","language":"it-IT"},"overview":{"value":"Isagi analizza cosa ha fatto quando ha segnato un gol agendo d'impulso. Nel frattempo, durante la seconda partita, Reo trova il suo nuovo stile di gioco: \"Chameleon\".","language":"it-IT"},"airDateText":{"value":"2024-10-26","language":"it-IT"},"runtimeMinutes":25,"rating":6.1,"thumbnail":"https://image.tmdb.org/t/p/w300/1u0NF2WEcTOUrSZajaVgAnvpRv1.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/1u0NF2WEcTOUrSZajaVgAnvpRv1.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/131041/season/1/episode/28"},{"id":"5646894","seasonNumber":1,"episodeNumber":29,"title":{"value":"Flow","language":"it-IT"},"overview":{"value":"I tryout sono finiti e Isagi è stato scelto come titolare della squadra del Blue Lock. Shido viene invece selezionato da Sae per giocare nella nazionale U-20. Nel frattempo, Ego spiega ai Blue Lock Eleven il segreto dello stato chiamato \"Flow\".","language":"it-IT"},"airDateText":{"value":"2024-11-02","language":"it-IT"},"runtimeMinutes":25,"rating":5.9,"thumbnail":"https://image.tmdb.org/t/p/w300/fbRSuvxoN998M9EGCJGFjfMBFUn.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/fbRSuvxoN998M9EGCJGFjfMBFUn.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/131041/season/1/episode/29"},{"id":"5646898","seasonNumber":1,"episodeNumber":30,"title":{"value":"Grande palcoscenico","language":"it-IT"},"overview":{"value":"L'amichevole tra il Blue Lock e la nazionale giapponese U-20 è finalmente iniziata. La prima mossa preparata da Bachira e Isagi viene subito fermata dal capitano della nazionale giapponese U-20, Aiku. È così che Isagi trova in lui una nuova sfida.","language":"it-IT"},"airDateText":{"value":"2024-11-09","language":"it-IT"},"runtimeMinutes":24,"rating":5.9,"thumbnail":"https://image.tmdb.org/t/p/w300/7OjN7l3fPFuaGms9OryxKvtGUjh.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/7OjN7l3fPFuaGms9OryxKvtGUjh.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/131041/season/1/episode/30"},{"id":"5646899","seasonNumber":1,"episodeNumber":31,"title":{"value":"Sae Itoshi","language":"it-IT"},"overview":{"value":"Il primo gol della partita segnato da Sae Itoshi fa scatenare il pubblico e fa anche capire alla squadra del Blue Lock che tutti sono lì per vedere Sae. Rin cambia strategia e Nagi segna il primo gol per il Blue Lock.","language":"it-IT"},"airDateText":{"value":"2024-11-16","language":"it-IT"},"runtimeMinutes":23,"rating":6.3,"thumbnail":"https://image.tmdb.org/t/p/w300/u66y3p2IpiK9sem8dNCL2KvnQqJ.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/u66y3p2IpiK9sem8dNCL2KvnQqJ.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/131041/season/1/episode/31"},{"id":"5646901","seasonNumber":1,"episodeNumber":32,"title":{"value":"Gene blu","language":"it-IT"},"overview":{"value":"Il duello tra Rin e Sae va a favore di Sae, che prende la palla. Tuttavia, Niko, Karasu, Otoya e Chigiri creano un'altra occasione per segnare. Rin tira, nonostante la gamba non dominante, e segna. Con il punteggio di 1 a 2, la nazionale U-20 è pronta a dare il massimo.","language":"it-IT"},"airDateText":{"value":"2024-11-23","language":"it-IT"},"runtimeMinutes":25,"rating":6.6,"thumbnail":"https://image.tmdb.org/t/p/w300/cRKglbo9fdGNNL05qfXJctyLyIt.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/cRKglbo9fdGNNL05qfXJctyLyIt.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/131041/season/1/episode/32"},{"id":"5646903","seasonNumber":1,"episodeNumber":33,"title":{"value":"Night snow","language":"it-IT"},"overview":{"value":"Le famiglie di Isagi, Bachira e Chigiri sono felici di vedere i loro figli in campo. Nel frattempo, c'è un tuffo nel passato di Rin e Sae. Sae è sul punto di abbandonare la partita, ma decide di restare quando Shido viene fatto scendere in campo.","language":"it-IT"},"airDateText":{"value":"2024-11-30","language":"it-IT"},"runtimeMinutes":25,"rating":6.1,"thumbnail":"https://image.tmdb.org/t/p/w300/nsy1v5ix0TTKWJIDe80XCGaPZuP.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/nsy1v5ix0TTKWJIDe80XCGaPZuP.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/131041/season/1/episode/33"},{"id":"5646905","seasonNumber":1,"episodeNumber":34,"title":{"value":"Sostituzioni","language":"it-IT"},"overview":{"value":"Nel secondo tempo entra in campo Shido e sconvolge tutti con le sue folli giocate. Dopo aver trasformato un calcio di punizione, Chigiri e Niko vengono sostituiti da Reo e Hiori. Con la nuova formazione del Blue Lock, Reo dimostra il suo valore.","language":"it-IT"},"airDateText":{"value":"2024-12-07","language":"it-IT"},"runtimeMinutes":25,"rating":6.3,"thumbnail":"https://image.tmdb.org/t/p/w300/7hGZTxmz987nCC1e1qRNLPx0eUs.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/7hGZTxmz987nCC1e1qRNLPx0eUs.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/131041/season/1/episode/34"},{"id":"5646920","seasonNumber":1,"episodeNumber":35,"title":{"value":"Ciò che ci hai insegnato","language":"it-IT"},"overview":{"value":"Shidou entra nello stato di \"Flow\" e si scatena per segnare un altro gol. Isagi chiede a Ego di condurli alla vittoria. Ego fa entrare in campo Baro per creare il caos in campo. Gli altri giocatori, uno dopo l'altro, iniziano a entrare nel \"Flow\".","language":"it-IT"},"airDateText":{"value":"2024-12-14","language":"it-IT"},"runtimeMinutes":24,"rating":6.3,"thumbnail":"https://image.tmdb.org/t/p/w300/gF77hRplC3bZTir41fQaOjkbQG0.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/gF77hRplC3bZTir41fQaOjkbQG0.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/131041/season/1/episode/35"},{"id":"5646926","seasonNumber":1,"episodeNumber":36,"title":{"value":"Fiori","language":"it-IT"},"overview":{"value":"Aiku ripensa al motivo per cui è diventato un difensore e la nazionale U-20 utilizza la sua forza per attaccare. Reo copia l'abilità di Nagi per tenere a bada l'avversario. Baro che ha atteso la sua occasione nell'oscurità, ruba l'occasione a Rin.","language":"it-IT"},"airDateText":{"value":"2024-12-21","language":"it-IT"},"runtimeMinutes":24,"rating":6.3,"thumbnail":"https://image.tmdb.org/t/p/w300/oZOFRHtqJa9apbt9WcvkBFBGZHh.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/oZOFRHtqJa9apbt9WcvkBFBGZHh.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/131041/season/1/episode/36"},{"id":"5646928","seasonNumber":1,"episodeNumber":37,"title":{"value":"Non sono solo","language":"it-IT"},"overview":{"value":"Vedendo il miglioramento dei giocatori, Sae porta il suo gioco al livello sucessivo. Rin inizia ad allinearsi con Sae cambiando il suo stile di gioco.","language":"it-IT"},"airDateText":{"value":"2024-12-28","language":"it-IT"},"runtimeMinutes":24,"rating":7,"thumbnail":"https://image.tmdb.org/t/p/w300/i8SuEsAv0GE4a68sa0R6tmNdoCR.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/i8SuEsAv0GE4a68sa0R6tmNdoCR.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/131041/season/1/episode/37"},{"id":"5646931","seasonNumber":1,"episodeNumber":38,"title":{"value":"Ultimo attacco","language":"it-IT"},"overview":{"value":"A pochi minuti dalla fine della partita, il Blue Lock ha la possibilità di sferrare l'attacco finale con Rin, pronto a far fuori tutti gli avversari che lo ostacolano.","language":"it-IT"},"airDateText":{"value":"2024-12-28","language":"it-IT"},"runtimeMinutes":24,"rating":8.4,"thumbnail":"https://image.tmdb.org/t/p/w300/4GReHZj6E9ePuKMAoQEPWgZBSH7.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/4GReHZj6E9ePuKMAoQEPWgZBSH7.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/131041/season/1/episode/38"}],"sourceUrl":"https://www.themoviedb.org/tv/131041/season/1"},"failure":null,"fields":{},"episodes":{"25":{"checkedAt":1793434163676,"status":"ok","retryCount":0},"26":{"checkedAt":1793434163676,"status":"ok","retry