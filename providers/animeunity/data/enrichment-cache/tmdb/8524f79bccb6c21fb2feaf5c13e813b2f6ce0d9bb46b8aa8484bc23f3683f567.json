/p/w300/orQs4gyQqMQk6GvELIb3CVzF1wi.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/orQs4gyQqMQk6GvELIb3CVzF1wi.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/84665/season/1/episode/5"},{"id":"1659771","seasonNumber":1,"episodeNumber":6,"title":{"value":"Episodio 6","language":"it-IT"},"overview":{"value":"Ex and his friends find themselves in Snow White's Story Zone. But thanks to a zany misunderstanding, Snow White mistakes Ex for her prince!","language":"en-US"},"airDateText":{"value":"2019-02-15","language":"it-IT"},"runtimeMinutes":23,"thumbnail":"https://image.tmdb.org/t/p/w300/z7YF1wHF4R4OtNDXdFPpbNa4zhC.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/z7YF1wHF4R4OtNDXdFPpbNa4zhC.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/84665/season/1/episode/6"},{"id":"1659772","seasonNumber":1,"episodeNumber":7,"title":{"value":"Episodio 7","language":"it-IT"},"overview":{"value":"In a snowy story zone, Ex saves a girl who's collapsed. Her name is Gelda and she's trying to rescue her brother. But something seems off about her...","language":"en-US"},"airDateText":{"value":"2019-02-22","language":"it-IT"},"runtimeMinutes":23,"thumbnail":"https://image.tmdb.org/t/p/w300/dmVxK2xkeZcemiwgLi36J7wJf11.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/dmVxK2xkeZcemiwgLi36J7wJf11.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/84665/season/1/episode/7"},{"id":"1659773","seasonNumber":1,"episodeNumber":8,"title":{"value":"Episodio 8","language":"it-IT"},"overview":{"value":"Ex goes to the story zone of Momotaro. There he learns of the past of Tao and Shayne, and the sad events that brought them together.","language":"en-US"},"airDateText":{"value":"2019-03-01","language":"it-IT"},"runtimeMinutes":23,"thumbnail":"https://image.tmdb.org/t/p/w300/c3KZhyyGW0HQ7pOruEHRaRuSAXJ.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/c3KZ