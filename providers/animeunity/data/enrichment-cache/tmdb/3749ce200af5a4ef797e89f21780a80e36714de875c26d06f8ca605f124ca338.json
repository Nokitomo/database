":"it-IT"},"runtimeMinutes":25,"rating":9,"thumbnail":"https://image.tmdb.org/t/p/w300/oVUPde8u9kfRmGftqadZeevfyr8.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/oVUPde8u9kfRmGftqadZeevfyr8.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/21732/season/1/episode/18"},{"id":"599639","seasonNumber":1,"episodeNumber":19,"title":{"value":"Episodio 19","language":"it-IT"},"overview":{"value":"Having determined that Team Trinity itself is promoting conflict, Setsuna confronts the Gundam Thrones. Tieria comes to his assistance, and the two Gundam Meisters fight as a team for the first time.","language":"en-US"},"airDateText":{"value":"2008-02-16","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/3aajdWj1smHxHppYbJRLdcVC4ed.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/3aajdWj1smHxHppYbJRLdcVC4ed.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/21732/season/1/episode/19"},{"id":"599640","seasonNumber":1,"episodeNumber":20,"title":{"value":"Episodio 20","language":"it-IT"},"overview":{"value":"A mysterious benefactor has provided the three superpower blocs with a new weapon against the Gundams. Quickly establishing a military alliance, the superpowers organize an elite fighting force under the aegis of the United Nations.","language":"en-US"},"airDateText":{"value":"2008-02-23","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/6XyLnPwhlmdTXINA8gWwlmLKZyD.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/6XyLnPwhlmdTXINA8gWwlmLKZyD.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/21732/season/1/episode/20"},{"id":"599641","seasonNumber":1,"episodeNumber":21,"title":{"value":"Episodio 21","language":"it-IT"},"overview":{"value":"The United Nations forces have deployed their new weapon, a mobile suit model known as the GN-X which is powered by a pseudo solar reactor. While Sergei Smirnov and Soma Peries lead a GN-X team in pursuit of the Gundam Thrones.","language":"en-US"},"airDateText":{"value":"2008-03-01","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/rVFVCdLCTPngsi0lF45nzpaRypF.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/rVFVCdLCTPngsi0lF45nzpaRypF.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/21732/season/1/episode/21"},{"id":"599642","seasonNumber":1,"episodeNumber":22,"title":{"value":"Episodio 22","language":"it-IT"},"overview":{"value":"The United Nations reveals the existence of the GN-X to the world, and announces the launch of a Gundam elimination operation with the code name \"Fallen Angels.\" The operation begins with the renewed pursuit of Team Trinity.","language":"en-US"},"airDateText":{"value":"2008-03-08","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/Aj5JWA2NfQfb1Q4vG23uVT1IPlC.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/Aj5JWA2NfQfb1Q4vG23uVT1IPlC.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/21732/season/1/episode/22"},{"id":"599643","seasonNumber":1,"episodeNumber":23,"title":{"value":"Episodio 23","language":"it-IT"},"overview":{"value":"Alejandro Corner and Ribbons Almark have forced their way into the heart of Veda and taken control of Celestial Being's master computer. But their actions have triggered an unexpected programmed response.","language":"en-US"},"airDateText":{"value":"2008-03-15","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/i0T9X4xo8Fy0LNs9HaZLk7HW2Hg.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/i0T9X4xo8Fy0LNs9HaZLk7HW2Hg.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/21732/season/1/episode/23"},{"id":"599644","seasonNumber":1,"episodeNumber":24,"title":{"value":"Episodio 24","language":"it-IT"},"overview":{"value":"Despite the loss of Lockon, 