t-IT"},"airDateText":{"value":"2017-03-05","language":"it-IT"},"runtimeMinutes":25,"rating":9,"thumbnail":"https://image.tmdb.org/t/p/w300/jLbGzHlmFBTWhKOEb3J4AN8Ce3s.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/jLbGzHlmFBTWhKOEb3J4AN8Ce3s.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/64375/season/1/episode/46"},{"id":"3577747","seasonNumber":1,"episodeNumber":47,"title":{"value":"Capro espiatorio","language":"it-IT"},"overview":{"value":"McGillis impara che le sue azioni hanno delle conseguenze e Tekkadan è ora considerata un'organizzazione criminale.","language":"it-IT"},"airDateText":{"value":"2017-03-12","language":"it-IT"},"runtimeMinutes":25,"rating":9,"thumbnail":"https://image.tmdb.org/t/p/w300/6ZVDVIhnAUELdFHia4elG3PxvZn.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/6ZVDVIhnAUELdFHia4elG3PxvZn.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/64375/season/1/episode/47"},{"id":"3577749","seasonNumber":1,"episodeNumber":48,"title":{"value":"Promessa","language":"it-IT"},"overview":{"value":"Determinata a ristabilire la propria reputazione sconfiggendo Tekkadan, Gjallarhorn circonda il quartier generale del nemico su Marte.","language":"it-IT"},"airDateText":{"value":"2017-03-19","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/rY0pU4n33qZiTfOmWTqOJtrEK4M.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/rY0pU4n33qZiTfOmWTqOJtrEK4M.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/64375/season/1/episode/48"},{"id":"3577751","seasonNumber":1,"episodeNumber":49,"title":{"value":"Mcgillis Fareed","language":"it-IT"},"overview":{"value":"Benché ancora in lutto i membri di Tekkadan rifiutano di perdere la speranza, ma Gjallarhorn inizia l'assalto alla loro base.","language":"it-IT"},"airDateText":{"value":"2017-03-26","language":"it-IT"},"runtimeMinutes":25,"rating":10,"thumbnail":"https://image.tmd