riginal/oi2eF2rJcu5M4UCVJvTInZInDYV.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/12501/season/1/episode/23"},{"id":"482459","seasonNumber":1,"episodeNumber":24,"title":{"value":"Episodio 24","language":"it-IT"},"overview":{"value":"Layla and Sora continue their super-intensive training as they prepare to attempt the death-defying Legendary Great Maneuver, but when Sora’s confidence is shaken, it could spell the end for them both!","language":"en-US"},"airDateText":{"value":"2003-09-11","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/dw5soKFd9NXk4D74Hxj20d7NftY.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/dw5soKFd9NXk4D74Hxj20d7NftY.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/12501/season/1/episode/24"},{"id":"482468","seasonNumber":1,"episodeNumber":25,"title":{"value":"Episodio 25","language":"it-IT"},"overview":{"value":"The girls return to Kaledio Stage to continue rehearsing for the Legendary Great Maneuver, but after a heated argument with Yuri, Layla is no longer able to hide her devastating injury!","language":"en-US"},"airDateText":{"value":"2003-09-18","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/xOMf3Wc00MlYPYb5ltY81BcSbPz.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/xOMf3Wc00MlYPYb5ltY81BcSbPz.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/12501/season/1/episode/25"},{"id":"482460","seasonNumber":1,"episodeNumber":26,"title":{"value":"Episodio 26","language":"it-IT"},"overview":{"value":"Despite her very serious injury, Layla is determined to give the greatest performance of her life! All she needs is Sora by her side - and a little help from the mischievous Fool!","language":"en-US"},"airDateText":{"value":"2003-09-25","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/1GoFxVMQtXSIAqRNoAGuGdalOx6.jpg","stills":[{"type":"still",