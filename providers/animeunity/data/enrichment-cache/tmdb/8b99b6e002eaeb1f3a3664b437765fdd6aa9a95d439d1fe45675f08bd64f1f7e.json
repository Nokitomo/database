/rvk0de9fgxHmwQ9IfdhurRQyMk2.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/234776/season/1/episode/11"},{"id":"5688085","seasonNumber":1,"episodeNumber":12,"title":{"value":"Episodio 12","language":"it-IT"},"overview":{"value":"Nio risks his life in a desperate bid to buy time for Iemochi's escape, but the Shogun can't bring himself to abandon a child. When all seems lost, Hijikata joins the battle. But can even he defeat the white-clad assassin?","language":"en-US"},"airDateText":{"value":"2025-01-04","language":"it-IT"},"runtimeMinutes":24,"rating":8,"thumbnail":"https://image.tmdb.org/t/p/w300/vV32Y5SRBToT0loj19daRINhxJh.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/vV32Y5SRBToT0loj19daRINhxJh.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/234776/season/1/episode/12"},{"id":"5688086","seasonNumber":1,"episodeNumber":13,"title":{"value":"Episodio 13","language":"it-IT"},"overview":{"value":"A wounded Nio wakes up in a luxurious sickbed in Nijo Castle. After a night of unsettling experiences, Kikuchiyo makes him a startling offer: leave the Miburo to serve the Shogun directly. Where do Nio's loyalties lie, and what has he learned from his encounter with the Blood Risshidan?","language":"en-US"},"airDateText":{"value":"2025-01-11","language":"it-IT"},"runtimeMinutes":24,"rating":8,"thumbnail":"https://image.tmdb.org/t/p/w300/xngD83ioVRdmuudkyh7D0KDvqjW.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/xngD83ioVRdmuudkyh7D0KDvqjW.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/234776/season/1/episode/13"},{"id":"5688087","seasonNumber":1,"episodeNumber":14,"title":{"value":"Episodio 14","language":"it-IT"},"overview":{"value":"The Miburo set out to earn the small fortune their uniform coats will cost. While they each rack their brains and try their luck, a woman approaches Hijikata, offering a tempting new sword.","language":"en-US"},"airDateText":{"value":"20