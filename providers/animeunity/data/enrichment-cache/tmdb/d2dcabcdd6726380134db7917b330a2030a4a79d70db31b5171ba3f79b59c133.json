e":"still","url":"https://image.tmdb.org/t/p/original/l7iiFtOMmkf7XFgRA7mAbCt5Uxb.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/23374/season/1/episode/9"},{"id":"623424","seasonNumber":1,"episodeNumber":10,"title":{"value":"Episodio 10","language":"it-IT"},"overview":{"value":"Troubled by advice from Chichiri, and in search of the missing Yui, Miaka travels to Kuto alone, leaving Tamahome with an aching heart.","language":"en-US"},"airDateText":{"value":"1995-06-08","language":"it-IT"},"runtimeMinutes":25,"rating":7,"thumbnail":"https://image.tmdb.org/t/p/w300/jNLms5CdZgYqPp3LMRTRnUaBpBJ.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/jNLms5CdZgYqPp3LMRTRnUaBpBJ.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/23374/season/1/episode/10"},{"id":"623425","seasonNumber":1,"episodeNumber":11,"title":{"value":"Episodio 11","language":"it-IT"},"overview":{"value":"Miaka is the Priestess of Suzaku, and it turns out that Yui is the Priestess of Seiryu. So much has changed, but the two are still friends... right?","language":"en-US"},"airDateText":{"value":"1995-06-15","language":"it-IT"},"runtimeMinutes":25,"rating":8,"thumbnail":"https://image.tmdb.org/t/p/w300/lLLTZxJPRtxPtNHI1COJOGRcpeI.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/lLLTZxJPRtxPtNHI1COJOGRcpeI.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/23374/season/1/episode/11"},{"id":"623426","seasonNumber":1,"episodeNumber":12,"title":{"value":"Episodio 12","language":"it-IT"},"overview":{"value":"Though distraught over Yui's pain and rage, Miaka commits herself once again to assembling the Suzaku Seven... and to Tamahome.","language":"en-US"},"airDateText":{"value":"1995-06-22","language":"it-IT"},"runtimeMinutes":25,"rating":8,"thumbnail":"https://image.tmdb.org/t/p/w300/rc9NdPoFCndmunAIdkvTYOIup9X.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/rc9NdPoFCndmunAIdkvTYOIup9X.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/23374/season/1/episode/12"},{"id":"623427","seasonNumber":1,"episodeNumber":13,"title":{"value":"Episodio 13","language":"it-IT"},"overview":{"value":"Tamahome gives himself to the Kuto Empire in order to buy Miaka time to find the other Suzaku Seven. Miaka's search doesn't go smoothly, however.","language":"en-US"},"airDateText":{"value":"1995-06-29","language":"it-IT"},"runtimeMinutes":25,"rating":7,"thumbnail":"https://image.tmdb.org/t/p/w300/ansFBwr42bk6ZngNfrrTTWq0KA4.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/ansFBwr42bk6ZngNfrrTTWq0KA4.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/23374/season/1/episode/13"},{"id":"623428","seasonNumber":1,"episodeNumber":14,"title":{"value":"Episodio 14","language":"it-IT"},"overview":{"value":"Miaka searches for the fifth of the Celestial Warriors among bandits, but ends up being taken hostage by a strange man with a wolf-like appearance.","language":"en-US"},"airDateText":{"value":"1995-07-06","language":"it-IT"},"runtimeMinutes":25,"rating":7,"thumbnail":"https://image.tmdb.org/t/p/w300/bJjAUCLMxTBP4yNKc6vfiOJmo3m.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/bJjAUCLMxTBP4yNKc6vfiOJmo3m.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/23374/season/1/episode/14"},{"id":"623429","seasonNumber":1,"episodeNumber":15,"title":{"value":"Episodio 15","language":"it-IT"},"overview":{"value":"It seems that Tasuki, the fifth Celestial Warrior, is dead. Miaka pursues a rumor about someone with the ability to resurrect the dead, but falls gravely ill.","language":"en-US"},"airDateText":{"value":"1995-07-13","language":"it-IT"},"runtimeMinutes":25,"rating":9,"thumbnail":"https://image.tmdb.org/t/p/w300/fByukUyp8DVOgOqw549aOcTO2zW.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/fByukUyp8DVOgOqw549aOcTO2zW.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/23374/season/1/episode/15"},{"id":"623430","seasonNumber":1,"episodeNumber":16,"title":{"value":"Episodio 16","language":"it-IT"},"overview":{"value":"Miaka must die in order for the healer Shoka's powers of revival to work. Hotohori makes one last plea to a reclusive doctor, where he learns the truth about Shoka.","language":"en-US"},"airDateText":{"value":"1995-07-20","language":"it-IT"},"runtimeMinutes":25,"rating":5,"thumbnail":"https://image.tmdb.org/t/p/w300/6nLIGGhFBa7F5L96a6vYLzjPlcK.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/6nLIGGhFBa7F5L96a6vYLzjPlcK.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/23374/season/1/episode/16"},{"id":"623431","seasonNumber":1,"episodeNumber":17,"title":{"value":"Episodio 17","language":"it-IT"},"overview":{"value":"After days of fruitless searching, an attempt on Miaka's life reveals the seventh of the Suzaku Seven, the flute-playing Chiriko.","language":"en-US"},"airDateText":{"value":"1995-07-27","language":"it-IT"},"runtimeMinutes":25,"rating":7,"thumbnail":"https://image.tmdb.org/t/p/w300/ooEPCr7J8Mpn6MIajmP6kl7iIKx.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/ooEPCr7J8Mpn6MIajmP6kl7iIKx.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/23374/season/1/episode/17"},{"id":"623432","seasonNumber":1,"episodeNumber":18,"title":{"value":"Episodio 18","language":"it-IT"},"overview":{"value":"With the help of Chichiri's powers, Miaka and Tamahome make a promise to meet so they may be reunited. Yui refuses to let Tamahome go.","language":"en-US"},"airDateText":{"value":"1995-08-03","language":"it-IT"},"runtimeMinutes":25,"rating":5,"thumbnail":"https://image.tmdb.org/t/p/w300/hvXfTaYK0SG1Q4GMgC9XaHoRjfE.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/hvXfTaYK0SG1Q4GMgC9XaHoRjfE.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/23374/season/1/episode/18"},{"id":"623433","seasonNumber":1,"episodeNumber":19,"title":{"value":"Episodio 19","language":"it-IT"},"overview":{"value":"Miaka escapes from prison following Yui's ambush, and searches for Tamahome. Unfortunately, when she finds him, she'll almost wish she hadn't.","language":"en-US"},"airDateText":{"value":"1995-08-10","language":"it-IT"},"runtimeMinutes":25,"rating":8,"thumbnail":"https://image.tmdb.org/t/p/w300/nP2f1yvn1T0QC4KZcVw7ilE24o9.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/nP2f1yvn1T0QC4KZcVw7ilE24o9.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/23374/season/1/episode/19"},{"id":"623434","seasonNumber":1,"episodeNumber":20,"title":{"value":"Episodio 20","language":"it-IT"},"overview":{"value":"Tamahome is not the same Tamahome that Miaka knows and loves any more. With her heart torn apart, Miaka must say goodbye, and leave him with Yui and the Kuto Empire.","language":"en-US"},"airDateText":{"value":"1995-08-17","language":"it-IT"},"runtimeMinutes":25,"rating":8,"thumbnail":"https://image.tmdb.org/t/p/w300/xqJe2q7Svri0SvwvDhO3w483CNd.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/xqJe2q7Svri0SvwvDhO3w483CNd.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/23374/season/1/episode/20"},{"id":"623435","seasonNumber":1,"episodeNumber":21,"title":{"value":"Episodio 21","language":"it-IT"},"overview":{"value":"Hotohori attempts to comfort Miaka as she struggles with her broken heart, desperate to forget about her love. But Tamahome won't be forgotten so easily.","language":"en-US"},"airDateText":{"value":"1995-08-24","language":"it-IT"},"runtimeMinutes":25,"rating":6,"thumbnail":"https://image.tmdb.org/t/p/w300/pWwxbgN9qfcOOgECwMLX6NY3H4i.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/pWwxbgN9qfcOOgECwMLX6NY3H4i.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/23374/season/1/episode/21"},{"id":"623436","seasonNumber":1,"episodeNumber":22,"title":{"value":"Episodio 22","language":"it-IT"},"overview":{"value":"Tamahome and Hotohori clash, fighting to the death. But the love between Tamahome and Miaka creates a miracle, making possible the impossible.","language":"en-US"},"airDateText":{"value":"1995-08-31","language":"it-IT"},"runtimeMinutes":25,"rating":6,"thumbnail":"https://image.tmdb.org/t/p/w300/tqYeide6KW8wWoHPxruZuV1V6Vz.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/tqYeide6KW8wWoHPxruZuV1V6Vz.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/23374/season/1/episode/22"},{"id":"623437","seasonNumber":1,"episodeNumber":23,"title":{"value":"Episodio 23","language":"it-IT"},"overview":{"value":"With Tamahome finally back to normal, all of the Konan Empire begin the preparations to summon Suzaku. However, they remain completely ignorant of Nakago's trap.","language":"en-US"},"airDateText":{"value":"1995-09-07","language":"it-IT"},"runtimeMinutes":25,"rating":6,"thumbnail":"https://image.tmdb.org/t/p/w300/c0am1hDxTgZyli9uTjj6z3Wbjnp.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/c0am1hDxTgZyli9uTjj6z3Wbjnp.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/23374/season/1/episode/23"},{"id":"623438","seasonNumber":1,"episodeNumber":24,"title":{"value":"Episodio 24","language":"it-IT"},"overview":{"value":"The Celestial Warriors and the Priestess begin the ceremony to summon Suzaku. But then, Nakago's cunning plans to disrupt the ceremony are revealed.","language":"en-US"},"airDateText":{"value":"1995-09-14","language":"it-IT"},"runtimeMinutes":25,"rating":6,"thumbnail":"https://image.tmdb.org/t/p/w300/oD22kMzyMzDMS5x8bnfEBG7DUQU.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/oD22kMzyMzDMS5x8bnfEBG7DUQU.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/23374/season/1/episode/24"},{"id":"623439","seasonNumber":1,"episodeNumber":25,"title":{"value":"Episodio 25","language":"it-IT"},"overview":{"value":"Taiitsukun shows up to reveal that not all is lost, and there still remains a method to summon Suzaku. However, what she tells to Miaka in private will change everything for her.","language":"en-US"},"airDateText":{"value":"1995-09-21","language":"it-IT"},"runtimeMinutes":25,"rating":6,"thumbnail":"https://image.tmdb.org/t/p/w300/42McBnmbjogq2xyotpAF4f32fyF.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/42McBnmbjogq2xyotpAF4f32fyF.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/23374/season/1/episode/25"},{"id":"623440","seasonNumber":1,"episodeNumber":26,"title":{"value":"Episodio 26","language":"it-IT"},"overview":{"value":"Miaka and the Suzaku Seven prepare for their trip to Hokkan, the land of Genbu. Before they go, Tamahome visits home again, but finds only pain.","language":"en-US"},"airDateText":{"value":"1995-09-28","language":"it-IT"},"runtimeMinutes":25,"rating":6,"thumbnail":"https://image.tmdb.org/t/p/w300/zTi44EXARR9wXzKM4p945gMAySu.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/zTi44EXARR9wXzKM4p945gMAySu.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/23374/season/1/episode/26"},{"id":"623441","seasonNumber":1,"episodeNumber":27,"title":{"value":"Episodio 27","language":"it-IT"},"overview":{"value":"Suboshi, the twin of Amiboshi, wants revenge for the death of his brother. Horrified by the fate of Tamahome's family, Miaka resolves to fight against Seiryu.","language":"en-US"},"airDateText":{"value":"1995-10-05","language":"it-IT"},"runtimeMinutes":25,"rating":6,"thumbnail":"https://image.tmdb.org/t/p/w300/5puR2ZpYDsWZNLkdMKmVpFkBoXB.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/5puR2ZpYDsWZNLkdMKmVpFkBoXB.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/23374/season/1/episode/27"},{"id":"623442","seasonNumber":1,"episodeNumber":28,"title":{"value":"Episodio 28","language":"it-IT"},"overview":{"value":"As Miaka and the Suzaku Seven travel to Hokkan, the story pauses to reflect on the events that lead up to this point.","language":"en-US"},"airDateText":{"value":"1995-10-12","language":"it-IT"},"runtimeMinutes":25,"rating":3,"thumbnail":"https://image.tmdb.org/t/p/w300/mLCMaoBFkdFNCy0WPqTZeg9yn4b.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/mLCMaoBFkdFNCy0WPqTZeg9yn4b.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/23374/season/1/episode/28"},{"id":"623443","seasonNumber":1,"episodeNumber":29,"title":{"value":"Episodio 29","language":"it-IT"},"overview":{"value":"Back on Earth, Miaka's brother Keisuke researches the origins of the Universe of the Four Gods, and discovers something startling. He communicates with Miaka, who must make a choice.","language":"en-US"},"airDateText":{"value":"1995-10-19","language":"it-IT"},"runtimeMinutes":25,"rating":3,"thumbnail":"https://image.tmdb.org/t/p/w300/fWWZMmPcpCSqw07YwXqRWGOwN81.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/fWWZMmPcpCSqw07YwXqRWGOwN81.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/23374/season/1/episode/29"},{"id":"623444","seasonNumber":1,"episodeNumber":30,"title":{"value":"Episodio 30","language":"it-IT"},"overview":{"value":"A sudden attack on the ship leaves Miaka, Nuriko, and Tamahome trapped in a cave. When they rejoin the others, the Seiryu warrior Soi confronts them, but Miaka repels the attack. Finally landing in Hokkan, the group learns about the Shinzaho.","language":"en-US"},"airDateText":{"value":"1995-10-26","language":"it-IT"},"runtimeMinutes":25,"rating":5,"thumbnail":"https://image.tmdb.org/t/p/w300/bIKu4ItfOdZj0xwK12UgF5uaVlH.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/bIKu4ItfOdZj0xwK12UgF5uaVlH.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/23374/season/1/episode/30"},{"id":"623445","seasonNumber":1,"episodeNumber":31,"title":{"value":"Episodio 31","language":"it-IT"},"overview":{"value":"Miaka and the Warriors search for the Shinzaho in the city of Touran, and Tamahome may have the answer. Meanwhile, Miaka struggles with whether she should return home, or keep her love.","language":"en-US"},"airDateText":{"value":"1995-11-02","language":"it-IT"},"runtimeMinutes":25,"rating":8,"thumbnail":"https://image.tmdb.org/t/p/w300/lj68Jc8Qk7EwGE3weVomYe8dtjH.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/lj68Jc8Qk7EwGE3weVomYe8dtjH.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/23374/season/1/episode/31"},{"id":"623446","seasonNumber":1,"episodeNumber":32,"title":{"value":"Episodio 32","language":"it-IT"},"overview":{"value":"Nuriko fights off the bestial Ashitare, and at the same time, Tamahome confronts Yui. After, Nuriko consoles Tamahome on his doubt, while Nuriko affirms who he really is.","language":"en-US"},"airDateText":{"value":"1995-11-09","language":"it-IT"},"runtimeMinutes":25,"rating":6,"thumbnail":"https://image.tmdb.org/t/p/w300/vgzDUabwGbVaM9eXE0PHB2kyfhg.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/vgzDUabwGbVaM9eXE0PHB2kyfhg.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/23374/season/1/episode/32"},{"id":"623447","seasonNumber":1,"episodeNumber":33,"title":{"value":"Episodio 33","language":"it-IT"},"overview":{"value":"Nuriko opens the door to the Shinzaho, but not without a cost. A happy occasion is tainted by a grief too powerful to bear.","language":"en-US"},"airDateText":{"value":"1995-11-16","language":"it-IT"},"runtimeMinutes":25,"rating":1,"thumbnail":"https://image.tmdb.org/t/p/w300/6vPddkD2OdvUiJcpP0YKTgQJDEh.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/6vPddkD2OdvUiJcpP0YKTgQJDEh.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/23374/season/1/episode/33"},{"id":"623448","seasonNumber":1,"episodeNumber":34,"title":{"value":"Episodio 34","language":"it-IT"},"overview":{"value":"Within the cave of the Shinzaho, the Suzaku Warriors are confronted by a pair of two hundred year old ghosts of the Genbu Warriors. Miaka must prove herself worthy of the Shinzaho.","language":"en-US"},"airDateText":{"value":"1995-11-23","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/4rfiD2YXKXLRf9jsTDQxc5J2Pc9.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/4rfiD2YXKXLRf9jsTDQxc5J2Pc9.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/23374/season/1/episode/34"},{"id":"623449","seasonNumber":1,"episodeNumber":35,"title":{"value":"Episodio 35","language":"it-IT"},"overview":{"value":"The Shinzaho is stolen from Miaka by someone once thought dead. Miaka's guilt prompts her to take responsibility in a somewhat unusual manner.","language":"en-US"},"airDateText":{"value":"1995-11-30","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/f4PTA3Uszuyovr0Qw08GRlTvWhm.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/f4PTA3Uszuyovr0Qw08GRlTvWhm.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/23374/season/1/episode/35"},{"id":"623450","seasonNumber":1,"episodeNumber":36,"title":{"value":"Episodio 36","language":"it-IT"},"overview":{"value":"Acting on a bad feeling, Tamahome races to find Miaka. He instead finds Nakago, who gloats about what he has taken from the Priestess of Suzaku.","language":"en-US"},"airDateText":{"value":"1995-12-07","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/ym11j0sEXgkYRitKi5vED5EeBGp.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/ym11j0sEXgkYRitKi5vED5EeBGp.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/23374/season/1/episode/36"},{"id":"623451","seasonNumber":1,"episodeNumber":37,"title":{"value":"Episodio 37","language":"it-IT"},"overview":{"value":"Tamahome's kindness is too much for Miaka to bear after her encounter with Nakago. She runs away from him and her life, and then encounters a familiar face.","language":"en-US"},"airDateText":{"value":"1995-12-14","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/6wrcmEKmWOj9YQXyLv2AaClwwwr.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/6wrcmEKmWOj9YQXyLv2AaClwwwr.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/23374/season/1/episode/37"},{"id":"623452","seasonNumber":1,"episodeNumber":38,"title":{"value":"Episodio 38","language":"it-IT"},"overview":{"value":"Carrying pain in their hearts, Miaka is tempted to forget everything, while Tamahome is tempted to abandon hope for himself.","language":"en-US"},"airDateText":{"value":"1995-12-21","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/8U0eaFRnFeLTy2ZV8wEqaQkA1zX.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/8U0eaFRnFeLTy2ZV8wEqaQkA1zX.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/23374/season/1/episode/38"},{"id":"623453","seasonNumber":1,"episodeNumber":39,"title":{"value":"Episodio 39","language":"it-IT"},"overview":{"value":"Reunited again, Miaka and Tamahome have but a moment to embrace before the illusionist Tomo of the Seiryu Warriors attacks. Miaka is trapped in a dream, but it's far from a nightmare.","language":"en-US"},"airDateText":{"value":"1995-12-28","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/54s6qikStOkzAgzsevRhcttq0rZ.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/54s6qikStOkzAgzsevRhcttq0rZ.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/23374/season/1/episode/39"},{"id":"623454","seasonNumber":1,"episodeNumber":40,"title":{"value":"Episodio 40","language":"it-IT"},"overview":{"value":"Caught in Tomo's fantasy world, Miaka is shown a world of love, kindness, and happy things. Will Miaka surrender to this pleasant dream, or will she remember what she truly loves?","language":"en-US"},"airDateText":{"value":"1996-01-04","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/nYrQT7C2GYtyK8VpqaqdeJjjJvs.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/nYrQT7C2GYtyK8VpqaqdeJjjJvs.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/23374/season/1/episode/40"},{"id":"623455","seasonNumber":1,"episodeNumber":41,"title":{"value":"Episodio 41","language":"it-IT"},"overview":{"value":"After defeating Tomo, Miaka and the Suzaku Warriors recover in Sairo. But rather than relaxing, Tamahome begins to distance himself from Miaka, driving a new wedge between them.","language":"en-US"},"airDateText":{"value":"1996-01-11","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/aSzEreewyARQPP2CAT1Kq7xglzp.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/aSzEreewyARQPP2CAT1Kq7xglzp.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/23374/season/1/episode/41"},{"id":"623456","seasonNumber":1,"episodeNumber":42,"title":{"value":"Episodio 42","language":"it-IT"},"overview":{"value":"It seems the love Tamahome and Miaka have for one another is destined to end. However, while the two chase after one another, the Seiryu Warriors move to take the second Shinzaho.","language":"en-US"},"airDateText":{"value":"1996-01-18","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/a6DYPNUCMjIdeJ7D3qVe62r3yBa.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/a6DYPNUCMjIdeJ7D3qVe62r3yBa.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/23374/season/1/episode/42"},{"id":"623457","seasonNumber":1,"episodeNumber":43,"title":{"value":"Episodio 43","language":"it-IT"},"overview":{"value":"Tatara of the Byakko Seven reveals not only the second Shinzaho, but the truth about what becomes of love between Warrior and Priestess.","language":"en-US"},"airDateText":{"value":"1996-01-25","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/ccD4AHW4lvnHa9S99o9dSLGhNlq.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/ccD4AHW4lvnHa9S99o9dSLGhNlq.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/23374/season/1/episode/43"},{"id":"623458","seasonNumber":1,"episodeNumber":44,"title":{"value":"Episodio 44","language":"it-IT"},"overview":{"value":"Chiriko has been possessed by the evil Miboshi, and the Suzaku Seven must fight one of their own. Meanwhile, Yui prepares to summon Seiryu.","language":"en-US"},"airDateText":{"value":"1996-02-01","language":"it-IT"},"runtimeMinutes":25,"rating":1,"thumbnail":"https://image.tmdb.org/t/p/w300/4EJ6bGJrrO4tWVwt11oQECsejTq.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/4EJ6bGJrrO4tWVwt11oQECsejTq.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/23374/season/1/episode/44"},{"id":"623459","seasonNumber":1,"episodeNumber":45,"title":{"value":"Episodio 45","language":"it-IT"},"overview":{"value":"Yui summons Seiryu and then makes her first wish. In the aftermath, everything changes, both in love, and in war.","language":"en-US"},"airDateText":{"value":"1996-02-08","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/gPtQz9Ca2TIrPsLqSKw38ofT8yz.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/gPtQz9Ca2TIrPsLqSKw38ofT8yz.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/23374/season/1/episode/45"},{"id":"623460","seasonNumber":1,"episodeNumber":46,"title":{"value":"Episodio 46","language":"it-IT"},"overview":{"value":"Although Yui wanted to separate Miaka from Tamahome by returning to Earth, somehow Tamahome has come through as well. Meanwhile, the situation worsens back in Konan.","language":"en-US"},"airDateText":{"value":"1996-02-15","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/5ZmmCBMXGByeyRcvEXCbO8FOLA8.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/5ZmmCBMXGByeyRcvEXCbO8FOLA8.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/23374/season/1/episode/46"},{"id":"623461","seasonNumber":1,"episodeNumber":47,"title":{"value":"Episodio 47","language":"it-IT"},"overview":{"value":"The real world is no place for a character in a book, and Tamahome searches for the meaning of his existence. Meanwhile, in Konan, Mitsukake knows exactly what his purpose is.","language":"en-US"},"airDateText":{"value":"1996-02-22","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/5dFmq8RdnRwbwplXcoGqNVXzla8.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/5dFmq8RdnRwbwplXcoGqNVXzla8.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/23374/season/1/episode/47"},{"id":"623462","seasonNumber":1,"episodeNumber":48,"title":{"value":"Episodio 48","language":"it-IT"},"overview":{"value":"After being saved from Suboshi by Tamahome in the real world, Miaka is able to speak with Hotohori, one last time.","language":"en-US"},"airDateText":{"value":"1996-02-29","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/vltAhPRe2Hb4f1syQH1lmPG82QB.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/vltAhPRe2Hb4f1syQH1lmPG82QB.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/23374/season/1/episode/48"},{"id":"623463","seasonNumber":1,"episodeNumber":49,"title":{"value":"Episodio 49","language":"it-IT"},"overview":{"value":"Miaka is finally able to tell Yui about Nakago's treachery, just in time for Nakago to appear in their own world.","language":"en-US"},"airDateText":{"value":"1996-03-07","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/owrvXhycbalmgaK9cqVrFt4I7J6.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/owrvXhycbalmgaK9cqVrFt4I7J6.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/23374/season/1/episode/49"},{"id":"623464","seasonNumber":1,"episodeNumber":50,"title":{"value":"Episodio 50","language":"it-IT"},"overview":{"value":"Nakago stands before Tamahome and Miaka on Earth. Tamahome struggles valiantly, while Yui struggles with her own inner doubt.","language":"en-US"},"airDateText":{"value":"1996-03-14","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/MpDikeFkxQwSChNiO4ihP5g2GU.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/MpDikeFkxQwSChNiO4ihP5g2GU.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/23374/season/1/episode/50"},{"id":"623465","seasonNumber":1,"episodeNumber":51,"title":{"value":"Episodio 51","language":"it-IT"},"overview":{"value":"With the seal broken, Miaka makes use of Yui's sacrifice to summon the beast-god Suzaku, and uses its power against Nakago.","language":"en-US"},"airDateText":{"value":"1996-03-21","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/xv6qz46jq3aeCJewmbbdnzmaq3p.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/xv6qz46jq3aeCJewmbbdnzmaq3p.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/23374/season/1/episode/51"},{"id":"623466","seasonNumber":1,"episodeNumber":52,"title":{"value":"Episodio 52","language":"it-IT"},"overview":{"value":"The Suzaku Seven reunite with the Priestess. The final battle begins against Nakago. Will this story have a happy ending?","language":"en-US"},"airDateText":{"value":"1996-03-28","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/aXmBHvKHX5N70gyd7YLi3O72A75.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/aXmBHvKHX5N70gyd7YLi3O72A75.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/23374/season/1/episode/52