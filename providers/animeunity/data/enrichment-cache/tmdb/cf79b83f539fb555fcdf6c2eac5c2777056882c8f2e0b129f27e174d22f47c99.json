,"runtimeMinutes":23,"rating":7.9,"thumbnail":"https://image.tmdb.org/t/p/w300/kFOrOTXNY7jhLRpe9PzX7bdPtxA.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/kFOrOTXNY7jhLRpe9PzX7bdPtxA.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/220542/season/1/episode/20"},{"id":"4835228","seasonNumber":1,"episodeNumber":21,"title":{"value":"Piano per il riscatto","language":"it-IT"},"overview":{"value":"Tornata al lavoro nella corte interna, Maomao ascolta Guen parlare degli affari della sua famiglia. Nel frattempo, Lihaku sente una voce che lo spinge all'azione.","language":"it-IT"},"airDateText":{"value":"2024-03-03","language":"it-IT"},"runtimeMinutes":23,"rating":7.7,"thumbnail":"https://image.tmdb.org/t/p/w300/u1C8TsL5XhXNdZOJrat2q7coqvX.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/u1C8TsL5XhXNdZOJrat2q7coqvX.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/220542/season/1/episode/21"},{"id":"4835229","seasonNumber":1,"episodeNumber":22,"title":{"value":"Rose blu","language":"it-IT"},"overview":{"value":"Lakan sfida Jinshi a produrre rose blu da presentare all'imminente festa in giardino, costringendolo a rivolgersi ancora una volta a Maomao.","language":"it-IT"},"airDateText":{"value":"2024-03-10","language":"it-IT"},"runtimeMinutes":23,"rating":7.8,"thumbnail":"https://image.tmdb.org/t/p/w300/2g0c1GFAnj6MJkOpnRgcfh5emAP.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/2g0c1GFAnj6MJkOpnRgcfh5emAP.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/220542/season/1/episode/22"},{"id":"4835230","seasonNumber":1,"episodeNumber":23,"title":{"value":"Acetosella e balsamina","language":"it-IT"},"overview":{"value":"Non volendo più scappare da Lakan, Maomao decide di affrontarlo. Lo sfida sul suo stesso terreno, in una partita a scacchi.","language":"it-IT"},"airDateText":{"value":"2024-03-17","language":"it-IT"},"runtimeMinutes":23,"rating":8,"thumbnail