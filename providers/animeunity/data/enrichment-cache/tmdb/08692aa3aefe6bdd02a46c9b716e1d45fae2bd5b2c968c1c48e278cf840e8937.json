298/season/1/episode/16"},{"id":"908713","seasonNumber":1,"episodeNumber":17,"title":{"value":"Trappola nella buca","language":"it-IT"},"overview":{"value":"Killua si stanca di avere Imori che lo pedina, quindi decide di sfidarlo a combattere.","language":"it-IT"},"airDateText":{"value":"2012-01-29","language":"it-IT"},"runtimeMinutes":24,"rating":7,"thumbnail":"https://image.tmdb.org/t/p/w300/tNsFQC2NKUubt5tXo0RTM7NkA6W.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/tNsFQC2NKUubt5tXo0RTM7NkA6W.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/46298/season/1/episode/17"},{"id":"908712","seasonNumber":1,"episodeNumber":18,"title":{"value":"Un colloquio importante","language":"it-IT"},"overview":{"value":"Gon e i suoi amici sono stati intrappolati all'interno di una grotta da serpenti velenosi. Riusciranno a trovare il modo di uscire in tempo per la fine della prova?","language":"it-IT"},"airDateText":{"value":"2012-02-05","language":"it-IT"},"runtimeMinutes":24,"rating":7.1,"thumbnail":"https://image.tmdb.org/t/p/w300/vJZkqcrHpmZHxegZ78LzDfcOmuX.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/vJZkqcrHpmZHxegZ78LzDfcOmuX.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/46298/season/1/episode/18"},{"id":"908708","seasonNumber":1,"episodeNumber":19,"title":{"value":"Non posso vincere o perdere","language":"it-IT"},"overview":{"value":"Gon e i suoi amici sono passati alla fase finale dell'esame per cacciatori. Quale sarà la prossima prova? Riusciranno a superare la sfida preparata dal presidente Netero?","language":"it-IT"},"airDateText":{"value":"2012-02-12","language":"it-IT"},"runtimeMinutes":24,"rating":7.5,"thumbnail":"https://image.tmdb.org/t/p/w300/3dDeKMK7zSvwPmqfJx8QIysbxvP.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/3dDeKMK7zSvwPmqfJx8QIysbxvP.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/46298/season/1/episode/19"},{"id":"908707","seasonNumber":1,"episodeNumber":20,"title":{"value":"Eventi super sconvolgenti","language":"it-IT"},"overview":{"value":"Gon si sveglia e si ritrova a ricevere le congratulazioni da Satotz per essere stata la prima persona a superare l'esame da Hunter.","language":"it-IT"},"airDateText":{"value":"2012-02-19","language":"it-IT"},"runtimeMinutes":24,"rating":7.8,"thumbnail":"https://image.tmdb.org/t/p/w300/3VYMQ43P7EBd4r4bAzDXZyYkhcX.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/3VYMQ43P7EBd4r4bAzDXZyYkhcX.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/46298/season/1/episode/20"},{"id":"908730","seasonNumber":1,"episodeNumber":21,"title":{"value":"Problemi tra fratelli","language":"it-IT"},"overview":{"value":"Dopo aver vinto l'esame, tutti ormai sono pronti ad affrontare la loro strada. Gon, Kurapika e Leorio si alleano per aiutare Killua, tornato a casa sua.","language":"it-IT"},"airDateText":{"value":"2012-03-04","language":"it-IT"},"runtimeMinutes":24,"rating":7.5,"thumbnail":"https://image.tmdb.org/t/p/w300/1CsJO8Br1cUWYyw3khMXQxNsQFE.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/1CsJO8Br1cUWYyw3khMXQxNsQFE.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/46298/season/1/episode/21"},{"id":"908709","seasonNumber":1,"episodeNumber":22,"title":{"value":"Un mastino pericoloso","language":"it-IT"},"overview":{"value":"Dopo essere arrivati nella Repubblica di Padokea, Gon, Leorio e Kurapika salgono su un autobus turistico diretto verso il Monte Kukuroo, dove vive la famiglia Zoldyk.","language":"it-IT"},"airDateText":{"value":"2012-03-11","language":"it-IT"},"runtimeMinutes":24,"rating":7.4,"thumbnail":"https://image.tmdb.org/t/p/w300/rd8uxgVRtEhrQh4Qntv9qBHAuaI.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/rd8uxgVRtEhrQh4Qntv9qBHAuaI.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/46298/season/1/episode/22"},{"id":"908739","seasonNumber":1,"episodeNumber":23,"title":{"value":"Responsabilità del guardiano","language":"it-IT"},"overview":{"value":"Gon e i suoi amici hanno deciso di passare attraverso la Porta del Cimento per incontrare Killua. Zebro li porta negli alloggi della servitù dove incontrano Seaquant e riposano per la notte.","language":"it-IT"},"airDateText":{"value":"2012-03-18","language":"it-IT"},"runtimeMinutes":24,"rating":7.6,"thumbnail":"https://image.tmdb.org/t/p/w300/ubAClUC0YLOcXVTAZBe7Ifc7NcS.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/ubAClUC0YLOcXVTAZBe7Ifc7NcS.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/46298/season/1/episode/23"},{"id":"908740","seasonNumber":1,"episodeNumber":24,"title":{"value":"La famiglia Zoldyck","language":"it-IT"},"overview":{"value":"Assistiamo ad alcuni flashback della prima infanzia di Killua, principalmente tra lui e Canary. Quando i flashback finiscono, Kikyo, la madre di Killua, dice a Gon e gli altri che Killua non può vederli perché è in isolamento.","language":"it-IT"},"airDateText":{"value":"2012-03-25","language":"it-IT"},"runtimeMinutes":24,"rating":7.5,"thumbnail":"https://image.tmdb.org/t/p/w300/b9dLM01DTcBvNKkkzG7VKrBRwQ2.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/b9dLM01DTcBvNKkkzG7VKrBRwQ2.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/46298/season/1/episode/24"},{"id":"908742","seasonNumber":1,"episodeNumber":25,"title":{"value":"Senza vedere non lo incontrerai","language":"it-IT"},"overview":{"value":"Kikyo confida a Gotoh, il maggiordomo di famiglia, di quanto sia emotivamente sconvolta per la partenza di Killua. Con l'approvazione di suo padre, Killua si dirige verso l'alloggio del maggiordomo.","language":"it-IT"},"airDateText":{"value":"2012-04-01","language":"it-IT"},"runtimeMinutes":24,"rating":7,"thumbnail":"https://image.tmdb.org/t/p/w300/yk0Mv0GuGVjyPF9dvHOY5feL5bo.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/yk0Mv0GuGVjyPF9dvHOY5feL5bo.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/46298/season/1/episode/25"},{"id":"954976","seasonNumber":1,"episodeNumber":26,"title":{"value":"Da qui in avanti","language":"it-IT"},"overview":{"value":"Una lettera di Gon per zia Mito arriva sull'Isola Balena, il ragazzo racconta tutto ciò che gli accaduto nei giorni precedenti.","language":"it-IT"},"airDateText":{"value":"2012-04-15","language":"it-IT"},"runtimeMinutes":24,"rating":5.1,"thumbnail":"https://image.tmdb.org/t/p/w300/6ALbyCGQjoYTTTiPOeAANpkXyI.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/6ALbyCGQjoYTTTiPOeAANpkXyI.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/46298/season/1/episode/26"},{"id":"908719","seasonNumber":1,"episodeNumber":27,"title":{"value":"Arrivo all'arena","language":"it-IT"},"overview":{"value":"Gon e Killua sono diretti all'Arena Celeste, un luogo dove possono allenarsi e guadagnare denaro combattendo contro altri avversari.","language":"it-IT"},"airDateText":{"value":"2012-04-15","language":"it-IT"},"runtimeMinutes":24,"rating":7.5,"thumbnail":"https://image.tmdb.org/t/p/w300/kMEnNBYAVlPAUD6Sc7Q3jguENON.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/kMEnNBYAVlPAUD6Sc7Q3jguENON.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/46298/season/1/episode/27"},{"id":"954978","seasonNumber":1,"episodeNumber":28,"title":{"value":"Nen e Nen","language":"it-IT"},"overview":{"value":"Nella stanza di Wing, il giovane maestro mostra a Gon e Killua grazie a Zushi cosa sia il Nen. Spiegando loro i 4 precetti fondamentali del Nen: Ten, Ren, Zetsu e Hatsu.","language":"it-IT"},"airDateText":{"value":"2012-04-22","language":"it-IT"},"runtimeMinutes":24,"rating":7.5,"thumbnail":"https://image.tmdb.org/t/p/w300/i92F1OWGYAod5iMA7gIUf6RrdQe.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/i92F1OWGYAod5iMA7gIUf6RrdQe.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/46298/season/1/episode/28"},{"id":"908731","seasonNumber":1,"episodeNumber":29,"title":{"value":"Risveglio e potenziale","language":"it-IT"},"overview":{"value":"I nodi dell'aura di Gon e Killua finalmente si aprono grazie all'aiuto di Wing. Questi insegna loro come passare attraverso la barriera di Nen creata da Hisoka. Poche ore prima di mezzanotte, Gon e Killua tornano nel corridoio che Hisoka sta sorvegliando.","language":"it-IT"},"airDateText":{"value":"2012-04-29","language":"it-IT"},"runtimeMinutes":24,"rating":7.5,"thumbnail":"https://image.tmdb.org/t/p/w300/1epSCrmRHrKDDvxCHxqO0nyLsHN.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/1epSCrmRHrKDDvxCHxqO0nyLsHN.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/46298/season/1/episode/29"},{"id":"908737","seasonNumber":1,"episodeNumber":30,"title":{"value":"Scontri e conflitti","language":"it-IT"},"overview":{"value":"Gon continua la sua lotta con Gido e inizia a capire come funziona la tecnica delle trottole danzanti. Dopo aver compreso il principio alla base della tecnica, è in grado di eludere gli attacchi.","language":"it-IT"},"airDateText":{"value":"2012-05-06","language":"it-IT"},"runtimeMinutes":24,"rating":7.5,"thumbnail":"https://image.tmdb.org/t/p/w300/wITa0jIlz1OPaEwDQAbnYw4Ydw.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/wITa0jIlz1OPaEwDQAbnYw4Ydw.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/46298/season/1/episode/30"},{"id":"908738","seasonNumber":1,"episodeNumber":31,"title":{"value":"Destino e tenacia","language":"it-IT"},"overview":{"value":"Un mese dopo che Gon è stato gravemente ferito, la vendetta covata per oltre due anni da Kastro si sta per abbattere su Hisoka.","language":"it-IT"},"airDateText":{"value":"2012-05-13","language":"it-IT"},"runtimeMinutes":24,"rating":7.6,"thumbnail":"https://image.tmdb.org/t/p/w300/hOjKE9KOcZPax7k8IZFTaAOImDy.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/hOjKE9KOcZPax7k8IZFTaAOImDy.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/46298/season/1/episode/31"},{"id":"908735","seasonNumber":1,"episodeNumber":32,"title":{"value":"Una vittoria sorprendente","language":"it-IT"},"overview":{"value":"Kastro e Hisoka si affrontano nell'Arena Celeste. Kastro passa all'offensiva e sembra avere un vantaggio, Hisoka infatti sembra non essere in grado di schivare gli attacchi di Kastro che crea un suo doppio con il Nen.","language":"it-IT"},"airDateText":{"value":"2012-05-20","language":"it-IT"},"runtimeMinutes":24,"rating":7.9,"thumbnail":"https://image.tmdb.org/t/p/w300/5bGFbChoHIYCjCabjG7X01ALSVo.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/5bGFbChoHIYCjCabjG7X01ALSVo.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/46298/season/1/episode/32"},{"id":"908736","seasonNumber":1,"episodeNumber":33,"title":{"value":"Delle minacce infondate","language":"it-IT"},"overview":{"value":"Sadaso, Riehvelt e Gido rapiscono Zushi. Killua a questo punto accetta di combattere contro Sadaso ma a patto che questi lasci Zushi in pace. Sadaso però rompe il patto e a questo punto Killua passa alle vie di fatto.","language":"it-IT"},"airDateText":{"value":"2012-05-27","language":"it-IT"},"runtimeMinutes":24,"rating":7.6,"thumbnail":"https://image.tmdb.org/t/p/w300/l7MxcIjl3sMrH0FWj1wQSjroolS.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/l7MxcIjl3sMrH0FWj1wQSjroolS.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/46298/season/1/episode/33"},{"id":"908716","seasonNumber":1,"episodeNumber":34,"title":{"value":"Vendetta tramite la forza","language":"it-IT"},"overview":{"value":"Gon e Killua sconfiggono entrambi Riehvelt e Gido. A questo punto Hisoka, impressionato da Gon, appare sulla strada di Gon e lo invita finalmente ad essere il suo prossimo avversario sul ring.","language":"it-IT"},"airDateText":{"value":"2012-06-03","language":"it-IT"},"runtimeMinutes":24,"rating":7.5,"thumbnail":"https://image.tmdb.org/t/p/w300/6edJcYCU3f6f1Sxi6x3OX5Dq5kY.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/6edJcYCU3f6f1Sxi6x3OX5Dq5kY.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/46298/season/1/episode/34"},{"id":"908741","seasonNumber":1,"episodeNumber":35,"title":{"value":"La vera promozione","language":"it-IT"},"overview":{"value":"Il momento dello scontro tra Gon e Hisoka è finalmente giunto. Gon riesce a colpire con successo Hisoka con un pugno in faccia! Ma la sfida non è ancora finita.","language":"it-IT"},"airDateText":{"value":"2012-06-17","language":"it-IT"},"runtimeMinutes":24,"rating":8.1,"thumbnail":"https://image.tmdb.org/t/p/w300/7vgWpVQkWRZPjHBq5oXv3dcH0oI.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/7vgWpVQkWRZPjHBq5oXv3dcH0oI.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/46298/season/1/episode/35"},{"id":"908703","seasonNumber":1,"episodeNumber":36,"title":{"value":"Grande debito e piccoli calci","language":"it-IT"},"overview":{"value":"Dopo aver preso a pugni in faccia Hisoka, Gon gli restituisce la spilla dell'esame Hunter come promesso. Hisoka è entusiasta di vedere la crescita di Gon, i due si incontreranno di nuovo, è sicuro.","language":"it-IT"},"airDateText":{"value":"2012-06-24","language":"it-IT"},"runtimeMinutes":24,"rating":8,"thumbnail":"https://image.tmdb.org/t/p/w300/jAoQgkl8YJX07NyfRAHZ8z6DYbe.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/jAoQgkl8YJX07NyfRAHZ8z6DYbe.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/46298/season/1/episode/36"},{"id":"908702","seasonNumber":1,"episodeNumber":37,"title":{"value":"Ging e Gon","language":"it-IT"},"overview":{"value":"Gon apre la scatola che suo padre ha lasciato per lui, all’interno trova 3 oggetti e tra questi una cassetta che contiene la voce di Ging.","language":"it-IT"},"airDateText":{"value":"2012-07-01","language":"it-IT"},"runtimeMinutes":24,"rating":7.4,"thumbnail":"https://image.tmdb.org/t/p/w300/9whw6I0bgZRn0g5RPvwjxLgizHd.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/9whw6I0bgZRn0g5RPvwjxLgizHd.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/46298/season/1/episode/37"},{"id":"908734","seasonNumber":1,"episodeNumber":38,"title":{"value":"Risposta da papà","language":"it-IT"},"overview":{"value":"Gon ha ascoltato il messaggio di suo padre inciso nella cassetta. Gon e Killua prendono quindi alcune informazioni sulla memory card che era nella scatola.","language":"it-IT"},"airDateText":{"value":"2012-07-08","language":"it-IT"},"runtimeMinutes":24,"rating":7.2,"thumbnail":"https://image.tmdb.org/t/p/w300/j0pfjEG4dezWnTM72dLbKWDGbNk.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/j0pfjEG4dezWnTM72dLbKWDGbNk.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/46298/season/1/episode/38"},{"id":"908699","seasonNumber":1,"episodeNumber":39,"title":{"value":"Desideri e giuramenti","language":"it-IT"},"overview":{"value":"Kurapika dopo aver appreso il Nen, trova il suo primo lavoro come Hunter: dovrà fare da guardia del corpo ad un ricco uomo d’affari.","language":"it-IT"},"airDateText":{"value":"2012-07-15","language":"it-IT"},"runtimeMinutes":24,"rating":7.2,"thumbnail":"https://image.tmdb.org/t/p/w300/20b0e5UpBguxeFVOf2bwGwqEH49.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/20b0e5UpBguxeFVOf2bwGwqEH49.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/46298/season/1/episode/39"},{"id":"908732","seasonNumber":1,"episodeNumber":40,"title":{"value":"I guerrieri Nen si alleano?","language":"it-IT"},"overview":{"value":"Kurapika e gli altri in cerca di lavoro arrivano a casa di un collezionista di trofei e vengono attaccati da una forza sconosciuta.","language":"it-IT"},"airDateText":{"value":"2012-07-22","language":"it-IT"},"runtimeMinutes":24,"rating":7.1,"thumbnail":"https://image.tmdb.org/t/p/w300/iyIWGudUoF19d4tPrDlxcI5vVP1.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/iyIWGudUoF19d4tPrDlxcI5vVP1.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/46298/season/1/episode/40"},{"id":"908744","seasonNumber":1,"episodeNumber":41,"title":{"value":"Raduno di eroi","language":"it-IT"},"overview":{"value":"Kurapika deve sopravvivere all’interno della villa per ottenere il posto di lavoro. Gon e Killua invece viaggiano verso York Nuova per cercare di ottenere Greed Island.","language":"it-IT"},"airDateText":{"value":"2012-07-29","language":"it-IT"},"runtimeMinutes":24,"rating":7.2,"thumbnail":"https://image.tmdb.org/t/p/w300/5hnXRLR2G4HxNlFVjmaQicx1FYQ.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/5hnXRLR2G4HxNlFVjmaQicx1FYQ.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/46298/season/1/episode/41"},{"id":"908692","seasonNumber":1,"episodeNumber":42,"title":{"value":"Proteggere e attaccare","language":"it-IT"},"overview":{"value":"L'asta sta finalmente per iniziare. Gon, Killua e Leorio stanno lavorando duramente per accumulare abbastanza soldi da comprare Greed Island.","language":"it-IT"},"airDateText":{"value":"2012-08-05","language":"it-IT"},"runtimeMinutes":24,"rating":7.3,"thumbnail":"https://image.tmdb.org/t/p/w300/6BejwIjXKOawFKSDF6jpGRuCC39.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/6BejwIjXKOawFKSDF6jpGRuCC39.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/46298/season/1/episode/42"},{"id":"908695","seasonNumber":1,"episodeNumber":43,"title":{"value":"Una tragedia shockante","language":"it-IT"},"overview":{"value":"Senza alcun preavviso la Brigata Illusoria fa irruzione all’asta, facendo una strage… ma che fine faranno le copie di Greed Island?","language":"it-IT"},"airDateText":{"value":"2012-08-12","language":"it-IT"},"runtimeMinutes":24,"rating":7.6,"thumbnail":"https://image.tmdb.org/t/p/w300/iyhewpsvmdg1TZxKuV4PnJz5TM4.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/iyhewpsvmdg1TZxKuV4PnJz5TM4.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/46298/season/1/episode/43"},{"id":"908729","seasonNumber":1,"episodeNumber":44,"title":{"value":"Preludio al finimondo","language":"it-IT"},"overview":{"value":"L'arma segreta della mafia, le Bestie Occulte, sono state inviate per annientare la Brigata Illusoria dopo l’irruzione all’asta segreta.","language":"it-IT"},"airDateText":{"value":"2012-08-19","language":"it-IT"},"runtimeMinutes":24,"rating":8,"thumbnail":"https://image.tmdb.org/t/p/w300/n2DWd1Lt80aqIFeMtFzSgpjn18X.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/n2DWd1Lt80aqIFeMtFzSgpjn18X.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/46298/season/1/episode/44"},{"id":"908723","seasonNumber":1,"episodeNumber":45,"title":{"value":"Divieti e promesse","language":"it-IT"},"overview":{"value":"Kurapika, grazie alle sue capacità Nen, riesce a catturare Uvogin, un potente membro della Brigata Illusoria.","language":"it-IT"},"airDateText":{"value":"2012-09-02","language":"it-IT"},"runtimeMinutes":24,"rating":7.5,"thumbnail":"https://image.tmdb.org/t/p/w300/vg0QzmDJG2Uf5Uif4k2deo08ZYE.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/vg0QzmDJG2Uf5Uif4k2deo08ZYE.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/46298/season/1/episode/45"},{"id":"908728","seasonNumber":1,"episodeNumber":46,"title":{"value":"Inseguimento e attesa","language":"it-IT"},"overview":{"value":"Kurapika decide di far allontanare la Boss perché sia in salvo dal potenziale attacco della Brigata Illusoria. Rimane quindi da solo in attesa dei suoi membri.","language":"it-IT"},"airDateText":{"value":"2012-09-09","language":"it-IT"},"runtimeMinutes":24,"rating":7.2,"thumbnail":"https://image.tmdb.org/t/p/w300/jxK8tVxssyrKQuxG3YCqHMu8cWs.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/jxK8tVxssyrKQuxG3YCqHMu8cWs.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/46298/season/1/episode/46"},{"id":"908691","seasonNumber":1,"episodeNumber":47,"title":{"value":"Restrizione e giuramento","language":"it-IT"},"overview":{"value":"Inizia l'attesa battaglia tra Kurapika e Uvogin! Kurapika può davvero resistere alle abilità di Uvogin e qual è la vera forza delle catene di Kurapika?","language":"it-IT"},"airDateText":{"value":"2012-09-16","language":"it-IT"},"runtimeMinutes":24,"rating":7.8,"thumbnail":"https://image.tmdb.org/t/p/w300/2DSHHAuP0cI9A9LzCZf8hkY3HGl.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/2DSHHAuP0cI9A9LzCZf8hkY3HGl.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/46298/season/1/episode/47"},{"id":"908743","seasonNumber":1,"episodeNumber":48,"title":{"value":"Occhio da intenditore","language":"it-IT"},"overview":{"value":"Gon, Killua e Leorio stanno cercando di mettere le mani su abbastanza soldi per comprare Greed Island. Mentre attraversano il mercato, Gon si imbatte in un modo per identificare oggetti di valore.","language":"it-IT"},"airDateText":{"value":"2012-09-23","language":"it-IT"},"runtimeMinutes":24,"rating":6.9,"thumbnail":"https://image.tmdb.org/t/p/w300/q29X8OVumAX2mECNdSFaulpxvsb.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/q29X8OVumAX2mECNdSFaulpxvsb.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/46298/season/1/episode/48"},{"id":"908722","seasonNumber":1,"episodeNumber":49,"title":{"value":"Analisi durante l'inseguimento","language":"it-IT"},"overview":{"value":"Gon e i suoi amici sperano di vincere la ricompensa che è stata assegnata per rintracciare la Brigata Illusoria. Allo stesso tempo, Machi e Nobunaga sono stati inviati da Chrollo a cercare \"il bastardo con la catena\".","language":"it-IT"},"airDateText":{"value":"2012-09-30","language":"it-IT"},"runtimeMinutes":24,"rating":7.8,"thumbnail":"https://image.tmdb.org/t/p/w300/m06AjUYeKIoGAyb1SlSXEdaHMrT.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/m06AjUYeKIoGAyb1SlSXEdaHMrT.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/46298/season/1/episode/49"},{"id":"908724","seasonNumber":1,"episodeNumber":50,"title":{"value":"I compagni e la lama","language":"it-IT"},"overview":{"value":"Gon e Killua sono stati catturati dalla Brigata Illusoria. Vengono interrogati sul bastardo con la catena che la Brigata sta cercando, ma i due non sanno che in realtà si tratta di Kurapika.","language":"it-IT"},"airDateText":{"value":"2012-10-07","language":"it-IT"},"runtimeMinutes":24,"rating":7.8,"thumbnail":"https://image.tmdb.org/t/p/w300/jzF9mjDw9SrbDy3LJVEc26wkRUe.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/jzF9mjDw9SrbDy3LJVEc26wkRUe.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/46298/season/1/episode/50"},{"id":"908721","seasonNumber":1,"episodeNumber":51,"title":{"value":"Un campo di battaglia frenetico","language":"it-IT"},"overview":{"value":"L'asta è stata riprogrammata e la mafia si aspetta che la Brigata Illusoria attacchi di nuovo. I Dieci Anziani hanno assunto svariati assassini per affrontarla.","language":"it-IT"},"airDateText":{"value":"2012-10-14","language":"it-IT"},"runtimeMinutes":24,"rating":8,"thumbnail":"https://image.tmdb.org/t/p/w300/9CTiIfWUL8DAMAI2UigX0fjf5fM.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/9CTiIfWUL8DAMAI2UigX0fjf5fM.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/46298/season/1/episode/51"},{"id":"908720","seasonNumber":1,"episodeNumber":52,"title":{"value":"Assalto e impatto","language":"it-IT"},"overview":{"value":"Per vendicare Uvogin, la Brigata Illusoria si infiltra nell'asta per portare il caos in suo onore. Chrollo uccide uno per uno gli assassini assoldati dai Dieci Anziani.","language":"it-IT"},"airDateText":{"value":"2012-10-21","language":"it-IT"},"runtimeMinutes":24,"rating":8,"thumbnail":"https://image.tmdb.org/t/p/w300/hovXzhyd56Rjgq5ERi81xIkym1m.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/hovXzhyd56Rjgq5ERi81xIkym1m.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/46298/season/1/episode/52"},{"id":"908726","seasonNumber":1,"episodeNumber":53,"title":{"value":"Falsità della psiche","language":"it-IT"},"overview":{"value":"Il capo della Brigata Illusoria è morto. La notizia improvvisa sconvolge Kurapika, che si dirige incredulo al sito dell'asta, determinato a trovarne conferma.","language":"it-IT"},"airDateText":{"value":"2012-10-28","language":"it-IT"},"runtimeMinutes":24,"rating":7.3,"thumbnail":"https://image.tmdb.org/t/p/w300/5auF9f0bcgQauAU3Fj8oTOX05bp.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/5auF9f0bcgQauAU3Fj8oTOX05bp.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/46298/season/1/episode/53"},{"id":"908696","seasonNumber":1,"episodeNumber":54,"title":{"value":"Delle profezie incompiute?","language":"it-IT"},"overview":{"value":"Gon, Killua, Kurapika e Leorio finalmente si riuniscono. Kurapika racconta gli eventi accaduti e rivela la sua nuova abilità Nen.","language":"it-IT"},"airDateText":{"value":"2012-11-04","language":"it-IT"},"runtimeMinutes":24,"rating":7.5,"thumbnail":"https://image.tmdb.org/t/p/w300/8WZfM3jvb0ETVDjQbDRK5bfqTIW.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/8WZfM3jvb0ETVDjQbDRK5bfqTIW.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/46298/season/1/episode/54"},{"id":"908700","seasonNumber":1,"episodeNumber":55,"title":{"value":"Compagni e inganni","language":"it-IT"},"overview":{"value":"Proprio come predetto dal nuovo potere acquisito da Chrollo, Hisoka è sospettato di tradire la Brigata. Nel frattempo, Kurapika scopre che in realtà la Brigata è ancora viva.","language":"it-IT"},"airDateText":{"value":"2012-11-11","language":"it-IT"},"runtimeMinutes":24,"rating":7.7,"thumbnail":"https://image.tmdb.org/t/p/w300/bCZTNyi6RpMd52MrPR1JlyHFMwL.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/bCZTNyi6RpMd52MrPR1JlyHFMwL.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/46298/season/1/episode/55"},{"id":"908697","seasonNumber":1,"episodeNumber":56,"title":{"value":"Amato e odiato","language":"it-IT"},"overview":{"value":"Chrollo usa le informazioni che ha su Neon per identificare la posizione del misterioso utente di Nen della catena, ovvero Kurapika. Nel frattempo, Killua tiene d'occhio la base della Brigata Illusoria.","language":"it-IT"},"airDateText":{"value":"2012-11-18","language":"it-IT"},"runtimeMinutes":24,"rating":7.5,"thumbnail":"https://image.tmdb.org/t/p/w300/aSUAx7yRqzrdK1aamiHkwpml1dn.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/aSUAx7yRqzrdK1aamiHkwpml1dn.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/46298/season/1/episode/56"},{"id":"908727","seasonNumber":1,"episodeNumber":57,"title":{"value":"Iniziativa e regola","language":"it-IT"},"overview":{"value":"Gon e Killua sono prigionieri del ragno. Kurapika, Melody e Leorio escogitano un piano per catturare Chrollo e usarlo come leva per costringere i restanti Ragni a rilasciare Gon e Killua.","language":"it-IT"},"airDateText":{"value":"2012-12-02","language":"it-IT"},"runtimeMinutes":24,"rating":7.9,"thumbnail":"https://image.tmdb.org/t/p/w300/4n2FnhORFVr2WGSP48Dy23ZlhTY.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/4n2FnhORFVr2WGSP48Dy23ZlhTY.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/46298/season/1/episode/57"},{"id":"908714","seasonNumber":1,"episodeNumber":58,"title":{"value":"Segnale di ritirata","language":"it-IT"},"overview":{"value":"Kurapika negozia con Pakunoda per assicurarsi lo scambio di Gon e Killua. Pakunoda torna al nascondiglio della Brigata per annunciare i termini dello scambio ai restanti membri.","language":"it-IT"},"airDateText":{"value":"2012-12-09","language":"it-IT"},"runtimeMinutes":24,"rating":8,"thumbnail":"https://image.tmdb.org/t/p/w300/4bbh9hwLdXhFBuZZ9VFnDSAjbY5.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/4bbh9hwLdXhFBuZZ9VFnDSAjbY5.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/46298/season/1/episode/58"},{"id":"955009","seasonNumber":1,"episodeNumber":59,"title":{"value":"Asta e impazienza","language":"it-IT"},"overview":{"value":"Gon e Killua partecipano all'asta dove viene bandito Greed Island ma, visto che i due non hanno abbastanza fondi per acquistare il gioco, hanno in mente un nuovo piano.","language":"it-IT"},"airDateText":{"value":"2012-12-16","language":"it-IT"},"runtimeMinutes":24,"rating":6.8,"thumbnail":"https://image.tmdb.org/t/p/w300/t54Kzth37hxC267MmOVzTjoIu0s.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/t54Kzth37hxC267MmOVzTjoIu0s.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/46298/season/1/episode/59"},{"id":"955010","seasonNumber":1,"episodeNumber":60,"title":{"value":"Fine e inizio","language":"it-IT"},"overview":{"value":"Gon e Killua stanno cercando di farsi scegliere come giocatori di Greed Island. Tsezguerra, il giudice, li informa che prenderà la sua decisione dopo che gli avranno mostrato il loro Nen.","language":"it-IT"},"airDateText":{"value":"2012-12-23","language":"it-IT"},"runtimeMinutes":24,"rating":7,"thumbnail":"https://image.tmdb.org/t/p/w300/tfpBmwvXnxuzVT5uf7ZvTjCnPcm.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/tfpBmwvXnxuzVT5uf7ZvTjCnPcm.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/46298/season/1/episode/60"},{"id":"955011","seasonNumber":1,"episodeNumber":61,"title":{"value":"Invito e migliore amico","