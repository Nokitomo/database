{"schemaVersion":1,"source":"tmdb","kind":"episodes","input":{"mediaId":209707,"seasonNumber":2},"checkedAt":1793375703707,"status":"ok","value":{"seasonNumber":2,"name":{"value":"Stagione 2","language":"it-IT"},"year":2024,"episodeCount":12,"poster":"https://image.tmdb.org/t/p/original/hhK1g8IynFlmTRDdKGk1WKEY4Wl.jpg","posters":[],"backgrounds":[],"episodes":[{"id":"4550772","seasonNumber":2,"episodeNumber":1,"title":{"value":"Episodio 1","language":"it-IT"},"overview":{"value":"It's business as usual at Café Terrace Familia, and the girls are coming to terms with their own feelings for Hayato. But then, a sinister quintet appear with their own designs to crush the café... and something new about the past is revealed.","language":"en-US"},"airDateText":{"value":"2024-07-05","language":"it-IT"},"runtimeMinutes":24,"rating":7,"thumbnail":"https://image.tmdb.org/t/p/w300/kHb5JEycKXbhoyC7xgeCFtR1Q71.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/kHb5JEycKXbhoyC7xgeCFtR1Q71.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/209707/season/2/episode/1"},{"id":"5448068","seasonNumber":2,"episodeNumber":2,"title":{"value":"Episodio 2","language":"it-IT"},"overview":{"value":"Ouka realizes that all six of the current Familia staff are the grandkids of the six waitresses who once worked at Hayato's grandpa's coffee shop. Could it really be just a coincidence? Meanwhile, Fuwa opens a new café restaurant called Family...","language":"en-US"},"airDateText":{"value":"2024-07-12","language":"it-IT"},"runtimeMinutes":24,"rating":6.8,"thumbnail":"https://image.tmdb.org/t/p/w300/evZjbmqzpR72zrGnhqeACcDLp03.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/evZjbmqzpR72zrGnhqeACcDLp03.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/209707/season/2/episode/2"},{"id":"5448069","seasonNumber":2,"episodeNumber":3,"title":{"value":"Episodio 3","language":"it-IT"},"overview":{"value":"The Familia crew counters Fuwa's Family by wearing Halloween costumes designed by Ouka and releasing an attention-grabbing new menu item created by Shiragiku. Riho also makes up her mind to defend Familia using a weapon unique to her...","language":"en-US"},"airDateText":{"value":"2024-07-19","language":"it-IT"},"runtimeMinutes":24,"rating":6.7,"thumbnail":"https://image.tmdb.org/t/p/w300/ypLU3wIgEdrYkTYSFASpQsQyx2W.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/ypLU3wIgEdrYkTYSFASpQsQyx2W.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/209707/season/2/episode/3"},{"id":"5448071","seasonNumber":2,"episodeNumber":4,"title":{"value":"Episodio 4","language":"it-IT"},"overview":{"value":"Family's reputation plummets after Ririka's accidental livestream. Enraged, Fuwa shuts the restaurant down and forces the five waitresses out of their living quarters. When Riho learns of their plight, she asks Hayato to let them stay at Familia.","language":"en-US"},"airDateText":{"value":"2024-07-26","language":"it-IT"},"runtimeMinutes":24,"rating":7,"thumbnail":"https://image.tmdb.org/t/p/w300/lY8wyUFfz0VtGp7kGxRrnfU32rE.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/lY8wyUFfz0VtGp7kGxRrnfU32rE.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/209707/season/2/episode/4"},{"id":"5448072","seasonNumber":2,"episodeNumber":5,"title":{"value":"Episodio 5","language":"it-IT"},"overview":{"value":"Café Restaurant Family reopens as Chiyoda Diner, and the Familia crew are among the first to sample its Japanese-style cuisine. As they're leaving, Ririka gives Riho a ticket for two to a hot spring inn. Will Riho finally get some alone time with Hayato?","language":"en-US"},"airDateText":{"value":"2024-08-02","language":"it-IT"},"runtimeMinutes":24,"rating":7,"thumbnail":"https://image.tmdb.org/t/p/w300/sqlXkUZN5wqDKOS8OfbPRNqt5Dl.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/sqlXkUZN5wqDKOS8OfbPRNqt5Dl.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/209707/season/2/episode/5"},{"id":"5448075","seasonNumber":2,"episodeNumber":6,"title":{"value":"Episodio 6","language":"it-IT"},"overview":{"value":"Ami heads to the senior home, but her grandma still remains expressionless and pushes her away. Ami breaks down crying. Then Hayato remembers a dream he had last night involving his own grandparents...","language":"en-US"},"airDateText":{"value":"2024-08-09","language":"it-IT"},"runtimeMinutes":24,"rating":6.7,"thumbnail":"https://image.tmdb.org/t/p/w300/3zRA6rzOv1PHfmUombjdHpQhpgO.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/3zRA6rzOv1PHfmUombjdHpQhpgO.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/209707/season/2/episode/6"},{"id":"5448077","seasonNumber":2,"episodeNumber":7,"title":{"value":"Episodio 7","language":"it-IT"},"overview":{"value":"Ami decides to stay with her grandma, so the rest of the Familia crew stays a second night in an old inn that looks more like a haunted house. Hayato just wants to sleep, but the girls aren't going to make it easy for him...","language":"en-US"},"airDateText":{"value":"2024-08-16","language":"it-IT"},"runtimeMinutes":24,"rating":7.3,"thumbnail":"https://image.tmdb.org/t/p/w300/9d45gCTAoK3cKJcPwlPioDb3NLD.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/9d45gCTAoK3cKJcPwlPioDb3NLD.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/209707/season/2/episode/7"},{"id":"5448078","seasonNumber":2,"episodeNumber":8,"title":{"value":"Episodio 8","language":"it-IT"},"overview":{"value":"Hayato wants to get Shiragiku a birthday gift, even though he's two weeks late. Akane helps him choose one, and on their way home, he remembers that today is Akane's birthday. He offers to buy her a gift as an apology, but she only wants one thing...","language":"en-US"},"airDateText":{"value":"2024-08-23","language":"it-IT"},"runtimeMinutes":24,"rating":7,"thumbnail":"https://image.tmdb.org/t/p/w300/b7CYCuMstcSLGftcY9hRLSpLsCL.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/b7CYCuMstcSLGftcY9hRLSpLsCL.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/209707/season/2/episode/8"},{"id":"5448080","seasonNumber":2,"episodeNumber":9,"title":{"value":"Episodio 9","language":"it-IT"},"overview":{"value":"Riho gets an offer to appear in a drama. While she's away filming, a man dressed in all black and sunglasses enters Familia and waits alone for six hours. Suspicious, Ami tries to drive him away, but then Riho returns and takes a look at the stranger...","language":"en-US"},"airDateText":{"value":"2024-08-30","language":"it-IT"},"runtimeMinutes":24,"rating":6.7,"thumbnail":"https://image.tmdb.org/t/p/w300/eX52ZRWrsK22sizQrK7Riisni6S.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/eX52ZRWrsK22sizQrK7Riisni6S.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/209707/season/2/episode/9"},{"id":"5448081","seasonNumber":2,"episodeNumber":10,"title":{"value":"Episodio 10","language":"it-IT"},"overview":{"value":"The girls want to plan a Christmas party together, right as competition for Hayato's affection begins to really heat up.","language":"en-US"},"airDateText":{"value":"2024-09-06","language":"it-IT"},"runtimeMinutes":24,"rating":7.3,"thumbnail":"https://image.tmdb.org/t/p/w300/rdGDkGv4V2zVtNSc16xYprsyYVd.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/rdGDkGv4V2zVtNSc16xYprsyYVd.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/209707/season/2/episode/10"},{"id":"5448084","seasonNumber":2,"episodeNumber":11,"title":{"value":"Episodio 11","language":"it-IT"},"overview":{"value":"After seeing Akane boldly kiss Hayato in front of everyone, Riho is dead-set on getting her own kiss from him, but she wants the scenario to be just perfect. She drags him around town to find the ideal setting for a kiss, but nothing seems good enough...","language":"en-US"},"airDateText":{"value":"2024-09-13","language":"it-IT"},"runtimeMinutes":24,"rating":6.7,"thumbnail":"https://image.tmdb.org/t/p/w300/xCb3rurVLTg5QyP2iagHpdVEp4i.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/xCb3rurVLTg5QyP2iagHpdVEp4i.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/209707/season/2/episode/11"},{"id":"5448086","seasonNumber":2,"episodeNumber":12,"title":{"value":"Episodio 12","language":"it-IT"},"overview":{"value":"As the Familia crew enjoys their New Year's dinners from Chiyoda Diner, Hayato announces his decision to quit college and officially take over Familia. Ouka follows his announcement with one of her own.","language":"en-US"},"airDateText":{"value":"2024-09-20","language":"it-IT"},"runtimeMinutes":24,"rating":6.7,"thumbnail":"https://image.tmdb.org/t/p/w300/piONqaWYim7kMWMZHVlzpYLFbS.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/piONqaWYim7kMWMZHVlzpYLFbS.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/209707/season/2/episode/12"}],"sourceUrl":"https://www.themoviedb.org/tv/209707/season/2"},"fields":{},"episodes":{"1":{"checkedAt":1793375703707,"status":"ok"},"2":{"checkedAt":1793375703707,"status":"ok"},"3":{"checkedAt":1793375703707,"status":"ok"},"4":{"checkedAt":1793375703707,"status":"ok"},"5":{"checkedAt":1793375703707,"status":"ok"},"6":{"checkedAt":1793375703707,"status":"ok"},"7":{"checkedAt":1793375703707,"status":"ok"},"8":{"checkedAt":1793375703707,"status":"ok"},"9":{"checkedAt":1793375703707,"status":"ok"},"10":{"checkedAt":1793375703707,"status":"ok"},"11":{"checkedAt":1793375703707,"status":"ok"},"12":{"checkedAt":1793375703707,"status":"ok"}}}
