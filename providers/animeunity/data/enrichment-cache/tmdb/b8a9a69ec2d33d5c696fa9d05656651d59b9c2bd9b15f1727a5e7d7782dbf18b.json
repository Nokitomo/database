utNba4daQfAT.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/bN8TIEf7BxEFy0futNba4daQfAT.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/248947/season/1/episode/8"},{"id":"5528492","seasonNumber":1,"episodeNumber":9,"title":{"value":"White out","language":"it-IT"},"overview":{"value":"Natsu, Lucy Erza ed Happy riescono a sfuggire alla trappola tesa loro dalla Maga Bianca. Lluvia spiega loro che il resto della gilda è sotto il controllo mentale.","language":"it-IT"},"airDateText":{"value":"2024-09-01","language":"it-IT"},"runtimeMinutes":24,"rating":10,"thumbnail":"https://image.tmdb.org/t/p/w300/mClPI0qHcMItFZyw0L9R9nXjitX.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/mClPI0qHcMItFZyw0L9R9nXjitX.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/248947/season/1/episode/9"},{"id":"5528493","seasonNumber":1,"episodeNumber":10,"title":{"value":"Nuovi assassini","language":"it-IT"},"overview":{"value":"Anche i Dragon Eater di Diabolos vogliono distruggere le cinque sfere per soggiogare Aldron, creando nuove complessità e portando nuovi rivali a complicare la situazione per i protagonisti.","language":"it-IT"},"airDateText":{"value":"2024-09-08","language":"it-IT"},"runtimeMinutes":24,"rating":10,"thumbnail":"https://image.tmdb.org/t/p/w300/c3NwLjmMaBxMfOLOgpmMKSVkrp.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/c3NwLjmMaBxMfOLOgpmMKSVkrp.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/248947/season/1/episode/10"},{"id":"5567453","seasonNumber":1,"episodeNumber":11,"title":{"value":"Wraith, il drago fantasma","language":"it-IT"},"overview":{"value":"Natsu e compagni si ritrovano coinvolti in uno scontro con tre fronti: loro, Diabolos e i membri di Fairy Tail influenzati dal dogma del bianco. La battaglia fratricida tra membri della stessa gilda li mette in grande difficoltà.","language":"it-IT"},"airDateText":{"value":"2024-09-15","language":"it-IT"},"runtimeMinutes":24,"rating":9.3,"thumbnail":"https://image.tmdb.org/t/p/w300/7Tzoq7V5l9kBWnpptqD9idMTRiK.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/7Tzoq7V5l9kBWnpptqD9idMTRiK.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/248947/season/1/episode/11"},{"id":"5567457","seasonNumber":1,"episodeNumber":12,"title":{"value":"L'asso nella manica per il contrattacco","language":"it-IT"},"overview":{"value":"Wendy affronta Nebal, mentre Natsu continua il suo scontro con Wraith, che ha posseduto il corpo di Makarov. Lucy raggiunge Gray e Lluvia giusto in tempo per fermare Kana.","language":"it-IT"},"airDateText":{"value":"2024-09-22","language":"it-IT"},"runtimeMinutes":24,"rating":10,"thumbnail":"https://image.tmdb.org/t/p/w300/zxzuoxsLMYzuUXILWpD1InpMx0W.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/zxzuoxsLMYzuUXILWpD1InpMx0W.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/248947/season/1/episode/12"},{"id":"5597200","seasonNumber":1,"episodeNumber":13,"title":{"value":"Scontro cremisi","language":"it-IT"},"overview":{"value":"Lucy e compagni riflettono sul modo migliore di agire, visto che Mira-Jane e i due membri di Diabolos sono degli avversari estremamente pericolosi. Elsa e Luxus si scontrano senza riserve.","language":"it-IT"},"airDateText":{"value":"2024-09-29","language":"it-IT"},"runtimeMinutes":24,"rating":10,"thumbnail":"https://image.tmdb.org/t/p/w300/8nDeDnYnZcuMKB5W8EcyXd0rnKp.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/8nDeDnYnZcuMKB5W8EcyXd0rnKp.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/248947/season/1/episode/13"},{"id":"5597201","seasonNumber":1,"episodeNumber":14,"title":{"value":"Il feroce Drago Adesivo","language":"it-IT"},"overview":{"value":"Skullion decide di dare l'ordine di ritirata, con gran scorno di Kiria. Nebal si rifiuta di obbedire e decide di utilizzare la sua Dragon Force contro 