meMinutes":24,"rating":4.5,"thumbnail":"https://image.tmdb.org/t/p/w300/lHg8VgJzlKtOeDd56AHe54HqivH.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/lHg8VgJzlKtOeDd56AHe54HqivH.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/103254/season/1/episode/26"},{"id":"3375707","seasonNumber":1,"episodeNumber":27,"title":{"value":"La maledizione della squama d'argento","language":"it-IT"},"overview":{"value":"Jaken recalls that fateful day fourteen years ago, when Zero placed a curse on Rin that would make her slowly rot away to an excruciating death. The three girls search for Bokusen-Oh, who may have a lead on the whereabouts of Towa’s new weapon.","language":"en-US"},"airDateText":{"value":"2021-10-16","language":"it-IT"},"runtimeMinutes":24,"rating":5.5,"thumbnail":"https://image.tmdb.org/t/p/w300/xOfD48tQD6r66ndI8aRvuq0rzhb.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/xOfD48tQD6r66ndI8aRvuq0rzhb.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/103254/season/1/episode/27"},{"id":"3375708","seasonNumber":1,"episodeNumber":28,"title":{"value":"La barriera del monte Musubi","language":"it-IT"},"overview":{"value":"The three girls arrive at Mount Musubi but are trapped by a powerful barrier. Moroha manages to escape and runs into something unexpected.","language":"en-US"},"airDateText":{"value":"2021-10-23","language":"it-IT"},"runtimeMinutes":24,"rating":5.5,"thumbnail":"https://image.tmdb.org/t/p/w300/ojRDYgaoifyRUyUKLtZWTy9TOL8.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/ojRDYgaoifyRUyUKLtZWTy9TOL8.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/103254/season/1/episode/28"},{"id":"3375709","seasonNumber":1,"episodeNumber":29,"title":{"value":"La giovane di nome Rion","language":"it-IT"},"overview":{"value":"Rion used to travel the world with her father Kirinmaru, but one day, her soul was sealed deep within Mount Musubi. Longing for freedom and peace, Rion asks Setsuna to sever the thread of fate that connects her to her father.","language":"en-US"},"airDateText":{"value":"2021-10-30","language":"it-IT"},"runtimeMinutes":24,"rating":5,"thumbnail":"https://image.tmdb.org/t/p/w300/lNQ4sS3woeVCAtZhAa8bA7ZhRMc.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/lNQ4sS3woeVCAtZhAa8bA7ZhRMc.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/103254/season/1/episode/29"},{"id":"3375712","seasonNumber":1,"episodeNumber":30,"title":{"value":"Hisui, il cacciatore di demoni","language":"it-IT"},"overview":{"value":"Setsuna is kidnapped by Princess Aiya, daughter of the deputy shogun. Wanting to escape her studies, Princess Aiya begs Setsuna to be her body double for a day, but the princess’s new tutor turns out to be Hisui posing as his older sister Kin’u!","language":"en-US"},"airDateText":{"value":"2021-11-06","language":"it-IT"},"runtimeMinutes":24,"rating":4,"thumbnail":"https://image.tmdb.org/t/p/w300/cXweXg9bPLqrcy32bbvK6xAed5x.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/cXweXg9bPLqrcy32bbvK6xAed5x.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/103254/season/1/episode/30"},{"id":"3375713","seasonNumber":1,"episodeNumber":31,"title":{"value":"L'incarico da Takechiyo","language":"it-IT"},"overview":{"value":"Revealing that he was once the young lord of the Mamidaira Clan, Takechiyo hires Moroha as a bodyguard to help him with the familial strife at his home. During training, Kohaku teaches Towa an important lesson about learning to run away.","language":"en-US"},"airDateText":{"value":"2021-11-13","language":"it-IT"},"runtimeMinutes":24,"rating":4,"thumbnail":"https://image.tmdb.org/t/p/w300/xu9KgnGquloXzT6ZoKfU8t7BvNF.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/xu9KgnGquloXzT6ZoKfU8t7BvNF.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/103254/season/1/episode/31"},{"id":"3375714","seasonNumber":1,"episodeNumber":32,"title":{"value":"La piccola galassia di Nanahoshi","language":"it-IT"},"overview":{"value":"Zero sets a trap in the garden of Nanahoshi, a demon who feeds on sadness. Kirinmaru pays Towa, Riku, and Rion a visit. Kohaku, Hisui, and Setsuna assist the chief of the demon slayers in the north.","language":"en-US"},"airDateText":{"value":"2021-11-20","language":"it-IT"},"runtimeMinutes":24,"rating":4.5,"thumbnail":"https://image.tmdb.org/t/p/w300/kcLccD7KMZyPvLwwJRbMMhOVOlW.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/kcLccD7KMZyPvLwwJRbMMhOVOlW.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/103254/season/1/episode/32"},{"id":"3375715","seasonNumber":1,"episodeNumber":33,"title":{"value":"Mayonaka, il visitatore","language":"it-IT"},"overview":{"value":"Kohaku and the demon slayers struggle to put out the fires caused by the Flame Bulls. Mayonaka, who used to be a local deity, demands the people of Gokoku Village hand over the town’s divine object.","language":"en-US"},"airDateText":{"value":"2021-11-27","language":"it-IT"},"runtimeMinutes":24,"rating":5.5,"thumbnail":"https://image.tmdb.org/t/p/w300/44DvkCdxVsWdmaCWRFZn9cpnCSq.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/44DvkCdxVsWdmaCWRFZn9cpnCSq.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/103254/season/1/episode/33"},{"id":"3375716","seasonNumber":1,"episodeNumber":34,"title":{"value":"La battaglia della luna nuova (Parte prima)","language":"it-IT"},"overview":{"value":"Moroha learns about her parents’ battle against Shogen Mamiana, the sealing of the Full Moon Raccoon Dog, and Takechiyo’s exile from his clan. Setsuna is attacked by the snow demon Yukinyudo. Zero targets Towa on the new moon.","language":"en-US"},"airDateText":{"value":"2021-12-04","language":"it-IT"},"runtimeMinutes":24,"rating":4,"thumbnail":"https://image.tmdb.org/t/p/w300/6zxRoHB2HCuNFnFZjWkpx6H9ajk.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/6zxRoHB2HCuNFnFZjWkpx6H9ajk.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/103254/season/1/episode/34"},{"id":"3375717","seasonNumber":1,"episodeNumber":35,"title":{"value":"La battaglia della luna nuova (Parte seconda)","language":"it-IT"},"overview":{"value":"Moroha and Takechiyo strike back against Shogen Mamiana. Setsuna experiences her first New Moon. Towa is trapped by Nanahoshi’s eternity bugs.","language":"en-US"},"airDateText":{"value":"2021-12-11","language":"it-IT"},"runtimeMinutes":24,"rating":4.5,"thumbnail":"https://image.tmdb.org/t/p/w300/uHFLOsExXTttwCx6A5ey8D7ttap.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/uHFLOsExXTttwCx6A5ey8D7ttap.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/103254/season/1/episode/35"},{"id":"3375718","seasonNumber":1,"episodeNumber":36,"title":{"value":"Un posto (non) per Towa","language":"it-IT"},"overview":{"value":"Zero unearths Towa’s sadness about growing up in the modern world and corners her with her memories of loneliness and suffering. Sesshomaru appears before the demon slayers and commands Setsuna to pay the Tree of Ages a visit.","language":"en-US"},"airDateText":{"value":"2021-12-18","language":"it-IT"},"runtimeMinutes":24,"rating":5,"thumbnail":"https://image.tmdb.org/t/p/w300/nDdjy2kf8cnkYUFUQJhfHyiyc8m.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/nDdjy2kf8cnkYUFUQJhfHyiyc8m.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/103254/season/1/episode/36"},{"id":"3391197","seasonNumber":1,"episodeNumber":37,"title":{"value":"I sentimenti di Zero","language":"it-IT"},"overview":{"value":"Towa is consumed by rage and loneliness. Setsuna tries to stop her from killing Zero because the curse on their mother cannot be lifted unless Zero lets go of her regrets. Sesshomaru gives Moroha the Black Pearl.","language":"en-US"},"airDateText":{"value":"2021-12-25","language":"it-IT"},"runtimeMinutes":24,"rating":6,"thumbnail":"https://image.tmdb.org/t/p/w300/AjAoctfmb6UnYpLMf970x2FRNRv.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/AjAoctfmb6UnYpLMf970x2FRNRv.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/103254/season/1/episode/37"},{"id":"3391198","seasonNumber":1,"episodeNumber":38,"title":{"value":"Kirinmaru dell'alba","language":"it-IT"},"overview":{"value":"Kirinmaru takes the Black Pearl from Moroha and demands that she bring Akuru to him. Towa and Setsuna try to lend a hand, but Sesshomaru arrives at the scene to take on Kirinmaru instead. Meanwhile, Rion and Riku head to Mount Musubi.","language":"en-US"},"airDateText":{"value":"2022-01-08","language":"it-IT"},"runtimeMinutes":24,"rating":6.5,"thumbnail":"https://image.tmdb.org/t/p/w300/9ABdVhUQO9jpwFGwvhHghmmWWcb.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/9ABdVhUQO9jpwFGwvhHghmmWWcb.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/103254/season/1/episode/38"},{"id":"3436266","seasonNumber":1,"episodeNumber":39,"title":{"value":"Famiglia riunita","language":"it-IT"},"overview":{"value":"Inside the Black Pearl, Moroha is finally reunited with her parents, Inuyasha and Kagome. Inuyasha begins to see a way out of the Black Pearl. Meanwhile, Kirinmaru’s attack leaves Sesshomaru gravely injured.","language":"en-US"},"airDateText":{"value":"2022-01-15","language":"it-IT"},"runtimeMinutes":24,"rating":7,"thumbnail":"https://image.tmdb.org/t/p/w300/tEywqKfxB2dId0KbvXgSJ3E4Y9C.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/tEywqKfxB2dId0KbvXgSJ3E4Y9C.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/103254/season/1/episode/39"},{"id":"3448960","seasonNumber":1,"episodeNumber":40,"title":{"value":"La fuga delle tre principesse","language":"it-IT"},"overview":{"value":"Wanting to prove his strength, Kirinmaru faces off against Sesshomaru. Towa summons the Tenseiga. Shippo waits for Inuyasha and the others at Gozu and Mezu’s gate.","language":"en-US"},"airDateText":{"value":"2022-01-22","language":"it-IT"},"runtimeMinutes":24,"rating":8,"thumbnail":"https://image.tmdb.org/t/p/w300/rIVhQEMYA4Pk9uViWNjjsTLCQLI.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/rIVhQEMYA4Pk9uViWNjjsTLCQLI.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/103254/season/1/episode/40"},{"id":"3450034","seasonNumber":1,"episodeNumber":41,"title":{"value":"La girandola di Akuru","language":"it-IT"},"overview":{"value":"In the present day, Osamu Kirin sees the Grim Comet approaching. Meanwhile, in the feudal era, Towa’s life is in danger after she uses her Zanseiken. The Spirit of the Tree of Ages orders the half-demon princesses to go destroy the Grim Comet.","language":"en-US"},"airDateText":{"value":"2022-01-29","language":"it-IT"},"runtimeMinutes":24,"rating":7,"thumbnail":"https://image.tmdb.org/t/p/w300/tJ7NQkKsmzA2QEUa7hTRrTuJFuc.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/tJ7NQkKsmzA2QEUa7hTRrTuJFuc.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/103254/season/1/episode/41"},{"id":"3450035","seasonNumber":1,"episodeNumber":42,"title":{"value":"La girandola del tempo della degenerazione","language":"it-IT"},"overview":{"value":"To destroy the Grim Comet, Towa, Moroha, and Setsuna must travel to the present day using the Windmill of Time, but Meidomaru stands in their way. Kirinmaru takes Rion and tries to travel across time by force.","language":"en-US"},"airDateText":{"value":"2022-02-05","language":"it-IT"},"runtimeMinutes":24,"rating":7,"thumbnail":"https://image.tmdb.org/t/p/w300/5kcPyMc88ALyoUOggDfmwNRv9C3.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/5kcPyMc88ALyoUOggDfmwNRv9C3.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/103254/season/1/episode/42"},{"id":"3486498","seasonNumber":1,"episodeNumber":43,"title":{"value":"Imprevisti sul palco","language":"it-IT"},"overview":{"value":"Osamu Kirin has been quietly exterminating the demons that have been appearing in the present day. He asks Towa, Setsuna, and Moroha to slay demons at the concert that is happening.","language":"en-US"},"airDateText":{"value":"2022-02-12","language":"it-IT"},"runtimeMinutes":24,"rating":6,"thumbnail":"https://image.tmdb.org/t/p/w300/bGu8A8IyunVvZJIMgS9naALNDZj.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/bGu8A8IyunVvZJIMgS9naALNDZj.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/103254/season/1/episode/43"},{"id":"3500426","seasonNumber":1,"episodeNumber":44,"title":{"value":"La caduta della stella dello spirito demoniaco","language":"it-IT"},"overview":{"value":"Inuyasha and the others have their hands full with the evil spirits pouring out of the burning Windmill of Time. The three girls and Osamu Kirin try to stop the Grim Comet from falling to the earth.","language":"en-US"},"airDateText":{"value":"2022-02-26","language":"it-IT"},"runtimeMinutes":24,"rating":7,"thumbnail":"https://image.tmdb.org/t/p/w300/ykxKZ7HwGm2u6X16hhnQqZuIOM7.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/ykxKZ7HwGm2u6X16hhnQqZuIOM7.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/103254/season/1/episode/44"},{"id":"3508043","seasonNumber":1,"episodeNumber":45,"title":{"value":"La spedizione punitiva di Kirin Osamu contro gli spiriti","language":"it-IT"},"overview":{"value":"Osamu Kirin brings the Grim Comet to the feudal era. He convinces Rion that they are both hoping for the same world and promises to make it a reality. Meanwhile, Towa, Setsuna, and Moroha are stuck in the present day.","language":"en-US"},"airDateText":{"value":"2022-03-05","language":"it-IT"},"runtimeMinutes":24,"rating":7,"thumbnail":"https://image.tmdb.org/t/p/w300/jXnYBSqZRtdT6NfrRpHrcQbTvfO.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/jXnYBSqZRtdT6NfrRpHrcQbTvfO.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/103254/season/1/episode/45"},{"id":"3552069","seasonNumber":1,"episodeNumber":46,"title":{"value":"La farfalla dello spirito demoniaco della disperazione","language":"it-IT"},"overview":{"value":"Towa, Setsuna, and Moroha must save Rion, who has linked her fate with the Grim Butterfly, but Osamu Kirin stands in their way. Kirin declares that he and Rion should reign over the world in order to bring about true peace.","language":"en-US"},"airDateText":{"value":"2022-03-12","language":"it-IT"},"runtimeMinutes":24,"rating":7,"thumbnail":"https://image.tmdb.org/t/p/w300/qvFjN5n7LnJiPEiyhceEBPsEJGo.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/qvFjN5n7LnJiPEiyhceEBPsEJGo.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/103254/season/1/episode/46"},{"id":"3590149","seasonNumber":1,"episodeNumber":47,"title":{"value":"Padre e figlia","language":"it-IT"},"overview":{"value":"Setsuna directs Towa and Moroha as they continue to sever Rion’s threads of fate. Each time a thread is severed, more of Rion’s true feelings are revealed. As Kirinmaru fights Sesshomaru, he realizes the real reason he lost Rion.","language":"en-US"},"airDateText":{"value":"2022-03-19","language":"it-IT"},"runtimeMinutes":24,"rating":7,"thumbnail":"https://image.tmdb.org/t/p/w300/yCluUEzgoLzNqIfKX7V3WBQd4U6.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/yCluUEzgoLzNqIfKX7V3WBQd4U6.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/103254/season/1/episode/47"},{"id":"3590174","seasonNumber":1,"episodeNumber":48,"title":{"value":"Un futuro che si protrae all'infinito","language":"it-IT"},"overview":{"value":"The feudal era is saved from the Degenerate Age. Inuyasha helps repay Moroha’s remaining debt. Towa and Setsuna receive kimonos from their mother, Rin. Towa, Setsuna, and Moroha accept a demon-slaying request from a mysterious man.","language":"en-US"},"airDateText":{"value":"2022-03-26","language":"it-IT"},"runtimeMinutes":24,"rating":7,"thumbnail":"https://image.tmdb.org/t/p/w300/r0NCwBVvMe5HuY9WKl70jCYMfPf.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/r0NCwBVvMe5HuY9WKl70jCYMfPf.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/103254/season/1/episode/48"}],"sourceUrl":"https://www.themoviedb.org/tv/103254/season/1"},"failure":null,"fields":{},"episodes":{"1":{"checkedAt":1793467018748,"status":"ok","retryCount":0},"2":{"checkedAt":1793467018748,"status":"ok","retryCount":0},"3":{"checkedAt":1793467018748,"status":"ok","retryCount":0},"4":{"checkedAt":1793467018748,"status":"ok","retryCount":0},"5":{"checkedAt":1793467018748,"status":"ok","retryCount":0},"6":{"checkedAt":1793467018748,"status":"ok","retryCount":0},"7":{"checkedAt":1793467018748,"status":"ok","retryCount":0},"8":{"checkedAt":1793467018748,"status":"ok","retryCount":0},"9":{"checkedAt":1793467018748,"status":"ok","retryCount":0},"10":{"checkedAt":1793467018748,"status":"ok","retryCount":0},"11":{"checkedAt":1793467018748,"status":"ok","retryCount":0},"12":{"checkedAt":1793467018748,"status":"ok","retryCount":0},"13":{"checkedAt":1793467018748,"status":"ok","retryCount":0},"14":{"checkedAt":1793467018748,"status":"ok","retryCount":0},"15":{"checkedAt":1793467018748,"status":"ok","retryCount":0},"16":{"checkedAt":1793467018748,"status":"ok","retryCount":0},"17":{"checkedAt":1793467018748,"status":"ok","retryCount":0},"18":{"checkedAt":1793467018748,"status":"ok","retryCount":0},"19":{"checkedAt":1793467018748,"status":"ok","retryCount":0},"20":{"checkedAt":1793467018748,"status":"ok","retryCount":0},"21":{"checkedAt":1793467018748,"status":"ok","retryCount":0},"22":{"checkedAt":1793467018748,"status":"ok","retryCount":0},"23":{"checkedAt":1793467018748,"status":"ok","retryCount":0},"24":{"checkedAt":1793467018748,"status":"