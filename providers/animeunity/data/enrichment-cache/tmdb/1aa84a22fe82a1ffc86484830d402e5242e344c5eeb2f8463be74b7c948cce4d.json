"},{"id":"3358526","seasonNumber":2,"episodeNumber":12,"title":{"value":"Episodio 12","language":"it-IT"},"overview":{"value":"The assault on the Murakumo castle has begun, and the first task is to draw away the troops surrounding it. Rui and Shichigen attempt an assault, but the enemy has prepared for their techniques...","language":"en-US"},"airDateText":{"value":"2018-03-27","language":"it-IT"},"runtimeMinutes":24,"thumbnail":"https://image.tmdb.org/t/p/w300/vlbwHwECPHP3K8qQIFmYhyakRmG.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/vlbwHwECPHP3K8qQIFmYhyakRmG.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/9410/season/2/episode/12"},{"id":"3358527","seasonNumber":2,"episodeNumber":13,"title":{"value":"Episodio 13","language":"it-IT"},"overview":{"value":"The assault on Murakumo continues as Utsutsu's terrible past, and the origin of her techniques, is revealed.","language":"en-US"},"airDateText":{"value":"2018-04-03","language":"it-IT"},"runtimeMinutes":24,"thumbnail":"https://image.tmdb.org/t/p/w300/i0NCJjaTSUODSWsBQOxS4YxWoSN.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/i0NCJjaTSUODSWsBQOxS4YxWoSN.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/9410/season/2/episode/13"},{"id":"3358528","seasonNumber":2,"episodeNumber":14,"title":{"value":"Episodio 14","language":"it-IT"},"overview":{"value":"Hadaebou infiltrates Murakumo castle, where he attempts to kill the Lord of Suruga. Joujin tries to get Hachirou and Hibiki to join forces with him.","language":"en-US"},"airDateText":{"value":"2018-04-10","language":"it-IT"},"runtimeMinutes":24,"thumbnail":"https://image.tmdb.org/t/p/w300/xDSZLiKrwscCBNJcwyyZ0JkJxeo.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/xDSZLiKrwscCBNJcwyyZ0JkJxeo.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/9410/season/2/episode/14"},{"id":"3358529","seasonNumber":2,"episodeNumber":15,"title":{"value":"Episo