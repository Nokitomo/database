X7YmaDh2hwndwvfrgt.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/oiDs1BrM9X7YmaDh2hwndwvfrgt.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/53715/season/1/episode/13"},{"id":"924496","seasonNumber":1,"episodeNumber":14,"title":{"value":"Episodio 14","language":"it-IT"},"overview":{"value":"When was the last time anyone saw Mio reading a book under the tree in the courtyard? What kind of person was she? Riki's memories become vague and he becomes scared that he might forget her completely. Will he be able to find the real Mio before she completely disappears?","language":"en-US"},"airDateText":{"value":"2013-01-12","language":"it-IT"},"runtimeMinutes":24,"thumbnail":"https://image.tmdb.org/t/p/w300/nRFFL9zbrUCFpdT7HW0i8jRMF2g.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/nRFFL9zbrUCFpdT7HW0i8jRMF2g.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/53715/season/1/episode/14"},{"id":"924497","seasonNumber":1,"episodeNumber":15,"title":{"value":"Episodio 15","language":"it-IT"},"overview":{"value":"Rin has called Riki to her room under false pretenses. Now he is stuck for the night while his friends mount a rescue attempt.","language":"en-US"},"airDateText":{"value":"2013-01-19","language":"it-IT"},"runtimeMinutes":24,"thumbnail":"https://image.tmdb.org/t/p/w300/4RzWCBaQXWTEir5jV9HYgyNIPOB.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/4RzWCBaQXWTEir5jV9HYgyNIPOB.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/53715/season/1/episode/15"},{"id":"924498","seasonNumber":1,"episodeNumber":16,"title":{"value":"Episodio 16","language":"it-IT"},"overview":{"value":"Saigusa Haruka is considered the biggest rule violator at school and the school Disciplinary Committee has it out for her, in particular Futaki Kanata. When Haruka’s family history is posted over the school the Little Busters must search for her.","language":"en-US"},"airDateText":{