db.org/t/p/original/3kX7kpTGTwniHzOI5AX0xNvp8xy.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/67710/season/1/episode/8"},{"id":"1220955","seasonNumber":1,"episodeNumber":9,"title":{"value":"Episodio 9","language":"it-IT"},"overview":{"value":"Misono and Tetsu go to save Lawless and Licht while Mahiru wanders within Kuro's mind to find a way to save him. Misono realizes how little they know of Tsubaki's intentions and Mahiru realizes just how much resolve it takes to face Kuro head-on.","language":"en-US"},"airDateText":{"value":"2016-08-30","language":"it-IT"},"runtimeMinutes":24,"thumbnail":"https://image.tmdb.org/t/p/w300/sPlrh7ZrAQZ5DhFKXQfj3lbAPen.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/sPlrh7ZrAQZ5DhFKXQfj3lbAPen.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/67710/season/1/episode/9"},{"id":"1220956","seasonNumber":1,"episodeNumber":10,"title":{"value":"Episodio 10","language":"it-IT"},"overview":{"value":"Licht breaks through the wall to give Lawless a piece of his mind, face-to-face. Licht gets swallowed up by the darkness and the curtain rises on Lawless' past. What is it be unique? How can one become the one and only?","language":"en-US"},"airDateText":{"value":"2016-09-06","language":"it-IT"},"runtimeMinutes":24,"thumbnail":"https://image.tmdb.org/t/p/w300/sqMzbFSFHtWrkK58ntDu3TGZj9W.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/sqMzbFSFHtWrkK58ntDu3TGZj9W.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/67710/season/1/episode/10"},{"id":"1223654","seasonNumber":1,"episodeNumber":11,"title":{"value":"Episodio 11","language":"it-IT"},"overview":{"value":"Licht and Lawless fight against Higan while Hugh lets his guard down due to the prideful idea that subclass could never be a match against him. Misono panics. Mahiru and Kuro arrive on the scene to help, but perhaps a bit too late.","language":"en-US"},"airDateText":{"value":"2016-09-13","l