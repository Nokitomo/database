JQi.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/67553/season/1/episode/8"},{"id":"1216941","seasonNumber":1,"episodeNumber":9,"title":{"value":"Episodio 9","language":"it-IT"},"overview":{"value":"With the team roles shuffled again, Lecty begins to have serious doubts about the effect of this new training. Meanwhile, despite patrols guarding the entire town, the mysterious attacks against the students continue.","language":"en-US"},"airDateText":{"value":"2015-09-03","language":"it-IT"},"runtimeMinutes":24,"rating":8,"thumbnail":"https://image.tmdb.org/t/p/w300/9E2fgQz48uV2flHspP0o7WwCDnt.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/9E2fgQz48uV2flHspP0o7WwCDnt.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/67553/season/1/episode/9"},{"id":"1216942","seasonNumber":1,"episodeNumber":10,"title":{"value":"Episodio 10","language":"it-IT"},"overview":{"value":"Lecty and Rico, having passed Kanata's test, seems to be getting along well. However, Misora is still lost. Her frustrations grow as Lecty and Rico show off their skills in training. Before Misora is ready, the tournament begins.","language":"en-US"},"airDateText":{"value":"2015-09-10","language":"it-IT"},"runtimeMinutes":24,"rating":8,"thumbnail":"https://image.tmdb.org/t/p/w300/lRXnOnWQMjFWuQI4ziHW5eKdB8R.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/lRXnOnWQMjFWuQI4ziHW5eKdB8R.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/67553/season/1/episode/10"},{"id":"1216943","seasonNumber":1,"episodeNumber":11,"title":{"value":"Episodio 11","language":"it-IT"},"overview":{"value":"Against all odds, E601 scores victory after unexpected victory, defying the expectations of everyone watching - except, of course, Kanata, their instructor. Now they must face A227, the crowd favorite instructed by Yuri.","language":"en-US"},"airDateText":{"value":"2015-09-17","language":"it-IT"},"runtimeMinutes":24,"rating":8,"th