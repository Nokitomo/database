tps://image.tmdb.org/t/p/original/2MxPCNig9jeAN6mdPtbvYY9f7i.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/46195/season/0/episode/3"},{"id":"1583514","seasonNumber":0,"episodeNumber":4,"title":{"value":"Episodio 4","language":"it-IT"},"overview":{"value":"Meme is not himself these days, caused by Shinobu’s disappearance from the house. Koyomi, Mayoi, Suruga and Nadeko all search for Shinobu.","language":"en-US"},"airDateText":{"value":"2010-06-25","language":"it-IT"},"runtimeMinutes":25,"rating":7.8,"thumbnail":"https://image.tmdb.org/t/p/w300/yX56jlC8O5PEtvqjjzRiQooWtVz.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/yX56jlC8O5PEtvqjjzRiQooWtVz.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/46195/season/0/episode/4"},{"id":"1906459","seasonNumber":0,"episodeNumber":5,"title":{"value":"Episodio 5","language":"it-IT"},"overview":{"value":"A short recap before Nekomonogatari (Black) where Araragi explains what happened to him in Kizumonogatari, then briefly introduces the girls encountered in Bakemonogatari before focusing on Hanekawa.","language":"en-US"},"airDateText":{"value":"2012-12-31","language":"it-IT"},"runtimeMinutes":2,"rating":8,"thumbnail":"https://image.tmdb.org/t/p/w300/1SOc0MMa79D2FPKnrRtofJWklaS.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/1SOc0MMa79D2FPKnrRtofJWklaS.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/46195/season/0/episode/5"},{"id":"907785","seasonNumber":0,"episodeNumber":6,"title":{"value":"Episodio 6","language":"it-IT"},"overview":{"value":"Koyomi Araragi begins the day by being rudely awoken by his sister, Tsukihi. He decides to discuss love with her, asking how one can tell if they are in love or not. It turns out that recently, he can't stop thinking about his classmate, Hanekawa Tsubasa. Later, he runs into Hanekawa, who reveals a shocking fact which he may not tell anyone else about.","language":"en-US"},"airDateText":{"value":"2012-12-31","language":"it-IT"},"runtimeMinutes":26,"rating":7.3,"thumbnail":"https://image.tmdb.org/t/p/w300/4poHkQPLwpK2HzBzjxhw99DU2Zf.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/4poHkQPLwpK2HzBzjxhw99DU2Zf.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/46195/season/0/episode/6"},{"id":"907783","seasonNumber":0,"episodeNumber":7,"title":{"value":"Episodio 7","language":"it-IT"},"overview":{"value":"Later, Araragi meets up with Oshino Meme, who quizzes him about Hanekawa. He reveals everything except the secret he was sworn not to tell, including finding and burying a silver cat with no tail. From this, Oshino warns that Hanekawa may have been possessed by an Oddity, the Curse Cat. He instructs Araragi to find Hanekawa, whilst he looks for the shallow grave they dug for the silver cat. Araragi finds Hanekawa, but things then take a turn for the worse...","language":"en-US"},"airDateText":{"value":"2012-12-31","language":"it-IT"},"runtimeMinutes":24,"rating":7,"thumbnail":"https://image.tmdb.org/t/p/w300/kOZBe6m0m80QxZZMtN7czKEnRK7.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/kOZBe6m0m80QxZZMtN7czKEnRK7.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/46195/season/0/episode/7"},{"id":"907784","seasonNumber":0,"episodeNumber":8,"title":{"value":"Episodio 8","language":"it-IT"},"overview":{"value":"Araragi, initially ignoring Oshino's warning not to involve himself any further in this incident, visits Hanekawa's house and is shocked by what he finds. He returns home and convinces his sisters not to involve themselves in the Curse Cat incident either. A few days pass and Hanekawa is still nowhere to be found. Araragi returns to Oshino to find him severely injured from his numerous encounters with the Curse Cat. Later, Araragi manges to find and talk to the Curse Cat occupying Hanekawa. Calmer and less violent now, she tells him to leave her to her own devices in order to relieve her master's stress.","language":"en-US"},"airDateText":{"value":"2012-12-31","language":"it-IT"},"runtimeMinutes":27,"rating":5.8,"thumbnail":"https://image.tmdb.org/t/p/w300/x3KM2xxMtMZfmiEhTJT0kGBUpHj.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/x3KM2xxMtMZfmiEhTJT0kGBUpHj.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/46195/season/0/episode/8"},{"id":"907786","seasonNumber":0,"episodeNumber":9,"title":{"value":"Episodio 9","language":"it-IT"},"overview":{"value":"Araragi begs Shinobu for her help, which she eventually provides. He then formulates a plan to confront the Curse Cat and save Hanekawa.","language":"en-US"},"airDateText":{"value":"2012-12-31","language":"it-IT"},"runtimeMinutes":31,"rating":7.5,"thumbnail":"https://image.tmdb.org/t/p/w300/96ps8UIHarpkZgXQG5HGyaED8nW.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/96ps8UIHarpkZgXQG5HGyaED8nW.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/46195/season/0/episode/9"},{"id":"907787","seasonNumber":0,"episodeNumber":10,"title":{"value":"Episodio 10","language":"it-IT"},"overview":{"value":"A recap episode retalling the events of Nekomonogatari (Kuro), narrated by Koyomi. On the first day of Golden Week, Koyomi Araragi, together with Tsubasa Hanekawa, buries a tailless cat that was ran over by a car. A supposedly petty and commonplace event. However, the curtain rises on the “nine days of hell\" that follow.","language":"en-US"},"airDateText":{"value":"2013-08-11","language":"it-IT"},"runtimeMinutes":25,"rating":7,"thumbnail":"https://image.tmdb.org/t/p/w300/qUxlzvc4vZvgp1lMu15AS5UWqn.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/qUxlzvc4vZvgp1lMu15AS5UWqn.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/46195/season/0/episode/10"},{"id":"1134942","seasonNumber":0,"episodeNumber":11,"title":{"value":"Episodio 11","language":"it-IT"},"overview":{"value":"A recap episode retelling the events of Bakemonogatari from \"Hitagi Crab\" to Nadeko Snake\", narrated by Koyomi. One day, Koyomi Araragi caught the body of his classmate Hitagi Senjyogahara, who was falling down after slipping on the stairs, knowing that it was dangerous to do so. However, her body was surprisingly light, as if the concept of weight did not exist.","language":"en-US"},"airDateText":{"value":"2013-09-15","language":"it-IT"},"runtimeMinutes":25,"rating":7,"thumbnail":"https://image.tmdb.org/t/p/w300/2Qf6lt9mlH54eELo33jaXogDrf5.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/2Qf6lt9mlH54eELo33jaXogDrf5.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/46195/season/0/episode/11"},{"id":"907789","seasonNumber":0,"episodeNumber":12,"title":{"value":"Episodio 12","language":"it-IT"},"overview":{"value":"A recap episode retalling the events of Bakemonogatari's Tsubasa Cat and the entirety of Nisemonogatari, narrated by Koyomi. During the summer vacation after all the apparition-related incidents around the five girls have been resolved, Koyomi Araragi's two risky younger sisters – the self-proclaimed heroes of justice, Karen and Tsukihi – become involved in some trouble.","language":"en-US"},"airDateText":{"value":"2013-10-20","language":"it-IT"},"runtimeMinutes":25,"rating":6.5,"thumbnail":"https://image.tmdb.org/t/p/w300/rFTFYGCkhKTe27W28oeGjdiRO9U.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/rFTFYGCkhKTe27W28oeGjdiRO9U.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/46195/season/0/episode/12"},{"id":"1031146","seasonNumber":0,"episodeNumber":13,"title":{"value":"Episodio 13","language":"it-IT"},"overview":{"value":"After the graduation of Araragi and Senjougahara, Suruga alone to deal with her left hand that has been turned monsterous from her mother's monkey paw charm. After hearing rumors of a \"Devil\" that can solve one's problems no matter what, Suruga set out to find this person.","language":"en-US"},"airDateText":{"value":"2014-08-16","language":"it-IT"},"runtimeMinutes":25,"rating":7.4,"thumbnail":"https://image.tmdb.org/t/p/w300/qFotbSfk7VhtepLiX9EATCbnUsd.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/qFotbSfk7VhtepLiX9EATCbnUsd.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/46195/season/0/episode/13"},{"id":"1031147","seasonNumber":0,"episodeNumber":14,"title":{"value":"Episodio 14","language":"it-IT"},"overview":{"value":"After having her hand healed, Suruga has many questions for her former classmate Rouka. She was unable to contact her, however a meeting with Keiki Deshu, who seems to have survived the attack from the previous season, answers some questions of hers.","language":"en-US"},"airDateText":{"value":"2014-08-16","language":"it-IT"},"runtimeMinutes":25,"rating":4.8,"thumbnail":"https://image.tmdb.org/t/p/w300/gEdDa21eG1ljIYLhsSWwOBbBZMu.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/gEdDa21eG1ljIYLhsSWwOBbBZMu.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/46195/season/0/episode/14"},{"id":"1031148","seasonNumber":0,"episodeNumber":15,"title":{"value":"Episodio 15","language":"it-IT"},"overview":{"value":"Suruga realizes that the collector is in fact Rouka, and she has been collecting parts of the \"devil\" as she feeds off the misfortune of others. Her motives are questionable...","language":"en-US"},"airDateText":{"value":"2014-08-16","language":"it-IT"},"runtimeMinutes":25,"rating":7,"thumbnail":"https://image.tmdb.org/t/p/w300/x2pnq4FdVdnphN8bKL15O66Byxo.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/x2pnq4FdVdnphN8bKL15O66Byxo.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/46195/season/0/episode/15"},{"id":"1031149","seasonNumber":0,"episodeNumber":16,"title":{"value":"Episodio 16","language":"it-IT"},"overview":{"value":"Rouka challenges Suruga to a one-on-one basketball match as the two discuss the events that led up to their collection of their respective \"devil\" parts. Suruga is still coming to terms with the ability to use her left arm again.","language":"en-US"},"airDateText":{"value":"2014-08-16","language":"it-IT"},"runtimeMinutes":25,"rating":7.7,"thumbnail":"https://image.tmdb.org/t/p/w300/mkuZBRq8Lmhw5nBaGP5afFfNfU7.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/mkuZBRq8Lmhw5nBaGP5afFfNfU7.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/46195/season/0/episode/16"},{"id":"1031150","seasonNumber":0,"episodeNumber":17,"title":{"value":"Episodio 17","language":"it-IT"},"overview":{"value":"Upon finding the Demon's head, she meets Rouka once again. Instead of giving the head to Rouka, she refuses. She is unable to stand the sight of her because of the fact that she can see her as she is a ghost. Suruga then challenges Rouka to one-on-one basketball in a wager for the head if Suruga loses.","language":"en-US"},"airDateText":{"value":"2014-08-16","language":"it-IT"},"runtimeMinutes":27,"rating":5,"thumbnail":"https://image.tmdb.org/t/p/w300/6dUakrwPUsYdMEwsYZwpCGuJc8x.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/6dUakrwPUsYdMEwsYZwpCGuJc8x.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/46195/season/0/episode/17"},{"id":"1031151","seasonNumber":0,"episodeNumber":18,"title":{"value":"Episodio 18","language":"it-IT"},"overview":{"value":"Koyomi Araragi and Shinobu Oshino discuss the true nature of Shikigami doll Yotsugi Ononoki, and Koyomi is being rudely woken up by his sisters who tell him to cram for his upcoming college entrance exams.","language":"en-US"},"airDateText":{"value":"2014-12-31","language":"it-IT"},"runtimeMinutes":25,"rating":8.7,"thumbnail":"https://image.tmdb.org/t/p/w300/zLqPJ9QYHQubBHdvjWZNIVAnZxf.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/zLqPJ9QYHQubBHdvjWZNIVAnZxf.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/46195/season/0/episode/18"},{"id":"1031152","seasonNumber":0,"episodeNumber":19,"title":{"value":"Episodio 19","language":"it-IT"},"overview":{"value":"Koyomi Araragi sees that he has no reflection, and discusses this with Shinobu. She then suggests that Koyomi should see Yozuru Kagenui and Yotsugi Ononoki.","language":"en-US"},"airDateText":{"value":"2014-12-31","language":"it-IT"},"runtimeMinutes":25,"rating":9,"thumbnail":"https://image.tmdb.org/t/p/w300/xuR99uEjg3E52xm7WKg5llIAUeZ.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/xuR99uEjg3E52xm7WKg5llIAUeZ.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/46195/season/0/episode/19"},{"id":"1031153","seasonNumber":0,"episodeNumber":20,"title":{"value":"Episodio 20","language":"it-IT"},"overview":{"value":"When Yotsugi tells Koyomi that he is indeed becoming a vampire, Koyomi reasons that using his vampiric powers must have come with a price. Yozuru tells him that while there is no way to undo the progress of his transformation, there is a way he can stop it from progressing further: he must no longer use his powers as a vampire. However, this turns out to be quite a challenge when he learns his sisters and Suraga have been kidnapped.","language":"en-US"},"airDateText":{"value":"2014-12-31","language":"it-IT"},"runtimeMinutes":25,"rating":8.5,"thumbnail":"https://image.tmdb.org/t/p/w300/1pNCxkELo9cyfqzbbunzncW6YFS.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/1pNCxkELo9cyfqzbbunzncW6YFS.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/46195/season/0/episode/20"},{"id":"1031154","seasonNumber":0,"episodeNumber":21,"title":{"value":"Episodio 21","language":"it-IT"},"overview":{"value":"Koyomi and Yotsugi land at the base of the mountain, where they are surprisingly met by Ougi Oshino. She talks with Koyomi for a while about his current situation and his upcoming confrontation with Teori. Koyomi and Yotsugi begin their journey up the mountain.","language":"en-US"},"airDateText":{"value":"2014-12-31","language":"it-IT"},"runtimeMinutes":25,"rating":9,"thumbnail":"https://image.tmdb.org/t/p/w300/qziXYP7lxtEGoOf1moG9Qp0xuos.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/qziXYP7lxtEGoOf1moG9Qp0xuos.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/46195/season/0/episode/21"},{"id":"1155845","seasonNumber":0,"episodeNumber":22,"title":{"value":"Episodio 22","language":"it-IT"},"overview":{"value":"Before the events of Bakemonogatari, Koyomi and Tsubasa delve into the  mystery surrounding a stone that was enshrined into one of the school's  gardens.","language":"en-US"},"airDateText":{"value":"2016-01-09","language":"it-IT"},"runtimeMinutes":13,"rating":8,"thumbnail":"https://image.tmdb.org/t/p/w300/3gojHq7a2Ts45utdn3U6u1BxD8A.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/3gojHq7a2Ts45utdn3U6u1BxD8A.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/46195/season/0/episode/22"},{"id":"1158157","seasonNumber":0,"episodeNumber":23,"title":{"value":"Episodio 23","language":"it-IT"},"overview":{"value":"After Hitagi's condition is treated, she and Koyomi investigate the true  reason why some flowers were left behind on a street and the school's  rooftop.","language":"en-US"},"airDateText":{"value":"2016-01-16","language":"it-IT"},"runtimeMinutes":12,"rating":8,"thumbnail":"https://image.tmdb.org/t/p/w300/wMKM90Jmhle3UUAwT6yRnCeXOuB.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/wMKM90Jmhle3UUAwT6yRnCeXOuB.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/46195/season/0/episode/23"},{"id":"1163455","seasonNumber":0,"episodeNumber":24,"title":{"value":"Episodio 24","language":"it-IT"},"overview":{"value":"After Oshino leaves the city, Mayoi informs Koyomi about a sand box  whose shape resembles a devil and he decides to find ou