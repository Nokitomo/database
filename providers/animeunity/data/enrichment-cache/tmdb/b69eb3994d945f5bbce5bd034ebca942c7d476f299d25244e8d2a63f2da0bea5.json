":[{"type":"still","url":"https://image.tmdb.org/t/p/original/yc9ouuUy5tqKSyECAVFQuKnVWsX.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/45501/season/1/episode/8"},{"id":"976719","seasonNumber":1,"episodeNumber":9,"title":{"value":"Episodio 9","language":"it-IT"},"overview":{"value":"The school festival is on, and amidst Shinka's attempts to turn their club into something legitimate, Rikka battles strange feelings that she only experiences when Yuta is around. Shinka decides to help her understand these feelings, but Rikka's full blown case of chunibyo keeps getting in the way.","language":"en-US"},"airDateText":{"value":"2012-11-29","language":"it-IT"},"runtimeMinutes":23,"rating":9.2,"thumbnail":"https://image.tmdb.org/t/p/w300/xT2eCOBqzqmskcvvn6UFWpGWvSv.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/xT2eCOBqzqmskcvvn6UFWpGWvSv.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/45501/season/1/episode/9"},{"id":"976720","seasonNumber":1,"episodeNumber":10,"title":{"value":"Episodio 10","language":"it-IT"},"overview":{"value":"Rikka and Yuta each gets some advice from a friend. Rikka's sister reveals her intention of studying the culinary arts in France, and asks Yuta to help her with Rikka. Through their own special ways, Yuta and Rikka confess to each other.","language":"en-US"},"airDateText":{"value":"2012-12-06","language":"it-IT"},"runtimeMinutes":23,"rating":9.3,"thumbnail":"https://image.tmdb.org/t/p/w300/fV9XNMH1n7aGoN6gIlx0OQua07F.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/fV9XNMH1n7aGoN6gIlx0OQua07F.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/45501/season/1/episode/10"},{"id":"976721","seasonNumber":1,"episodeNumber":11,"title":{"value":"Episodio 11","language":"it-IT"},"overview":{"value":"Rikka begins to acclimate herself to living a normal life, successfully making friends in the process. Sanae, however, isn't too happy about it. Rikka heads off to visit her father's grave, with Yuta left at the station, waiting for her to return.","language":"en-US"},"airDateText":{"value":"2012-12-13","language":"it-IT"},"runtimeMinutes":23,"rating":9.5,"thumbnail":"https://image.tmdb.org/t/p/w300/14tuTf1nkzBuh9czXfs9tj8GjAd.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/14tuTf1nkzBuh9czXfs9tj8GjAd.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/45501/season/1/episode/11"},{"id":"976722","seasonNumber":1,"episodeNumber":12,"title":{"value":"Episodio 12","language":"it-IT"},"overview":{"value":"Yuta begins to worry when it becomes apparent that Rikka may not come back. Sanae ditches her Dekomori persona to follow Rikka, while Kumin \"inherits\" Wicked Lord Shingan's powers. Yuta can't bear being without Rikka and sets off to find her.","language":"en-US"},"airDateText":{"value":"2012-12-20","language":"it-IT"},"runtimeMinutes":23,"rating":9.5,"thumbnail":"https://image.tmdb.org/t/p/w300/uH0PNXR3wCzxFkPNo5fuvtrhxuJ.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/uH0PNXR3wCzxFkPNo5fuvtrhxuJ.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/45501/season/1/episode/12"}],"sourceUrl":"https://www.themoviedb.org/tv/45501/season/1"},"failure":null,"fields":{},"episodes":{"1":{"checkedAt":1793456735568,"status":"ok","retryCount":0},"2":{"checkedAt":1793456735568,"status":"ok","retryCount":0},"3":{"checkedAt":1793456735568,"status":"ok","retryCount":0},"4":{"checkedAt":1793456735568,"status":"ok","retryCount":0},"5":{"checkedAt":1793456735568,"status":"ok","retryCount":0},"6":{"checkedAt":1793456735568,"status":"ok","retryCount":0},"7":{"checkedAt":1793456735568,"status":"ok","retryCount":0},"8":{"checkedAt":1793456735568,"status":"ok","retryCount":0},"9":{"checkedAt":1793456735568,"status":"ok","retryCount":0},"10":{"checkedAt":1793456735568,"status":"ok","retryCount":0},"11":{"checkedAt":1793456735568,"status":"ok","retryCount":0},"12":{"c