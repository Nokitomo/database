{"schemaVersion":1,"source":"tmdb","kind":"episodes","input":{"mediaId":108891,"seasonNumber":1},"checkedAt":1793458375707,"status":"ok","retryCount":0,"value":{"seasonNumber":1,"name":{"value":"Stagione 1","language":"it-IT"},"year":2022,"episodeCount":13,"poster":"https://image.tmdb.org/t/p/original/yF25bmrwTs4NDuKTqXQ1HHg7N9V.jpg","posters":[],"backgrounds":[],"episodes":[{"id":"3458332","seasonNumber":1,"episodeNumber":1,"title":{"value":"Episodio 1","language":"it-IT"},"overview":{"value":"In Yokosuka, 1986, Ryo Hazuki, the only legitimate heir of the Hazuki Dojo, spends his days training under his strict father Iwao. One day, he returns and witnesses a mysterious man called Lan Di attacking the Dojo.","language":"en-US"},"airDateText":{"value":"2022-02-06","language":"it-IT"},"runtimeMinutes":24,"rating":5.7,"thumbnail":"https://image.tmdb.org/t/p/w300/sL3A0exzFQ7SQgzUm7eJbGTI32g.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/sL3A0exzFQ7SQgzUm7eJbGTI32g.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/108891/season/1/episode/1"},{"id":"3488970","seasonNumber":1,"episodeNumber":2,"title":{"value":"Episodio 2","language":"it-IT"},"overview":{"value":"Hazuki Family's maid Ine hands a letter to Ryo, who is restless from his Father's death. The letter was sent from a person named \"Yuanda Zhu\" to his father which contained characters he cannot read.","language":"en-US"},"airDateText":{"value":"2022-02-13","language":"it-IT"},"runtimeMinutes":24,"rating":8,"thumbnail":"https://image.tmdb.org/t/p/w300/An6aQ0wUdKKJyv95DR8OX34ICaB.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/An6aQ0wUdKKJyv95DR8OX34ICaB.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/108891/season/1/episode/2"},{"id":"3489752","seasonNumber":1,"episodeNumber":3,"title":{"value":"Episodio 3","language":"it-IT"},"overview":{"value":"Ryo finally finds a person who can read Yuanda Zhu's letter, which said \"Find Master Chen for help\". Ryo finds Master Chen and asks him about Lan Di, the man who murdered his Father.","language":"en-US"},"airDateText":{"value":"2022-02-20","language":"it-IT"},"runtimeMinutes":24,"rating":8.5,"thumbnail":"https://image.tmdb.org/t/p/w300/41fN0phyoizW36hsaB0yrWfe5pl.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/41fN0phyoizW36hsaB0yrWfe5pl.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/108891/season/1/episode/3"},{"id":"3489753","seasonNumber":1,"episodeNumber":4,"title":{"value":"Episodio 4","language":"it-IT"},"overview":{"value":"To chase Lan Di, Ryo decides to go to Hong Kong, but realizes he does not have enough money to go. With Goro's assistance Ryo gets a part-time job, which he soon learns is in Mad Angel's territory.","language":"en-US"},"airDateText":{"value":"2022-02-27","language":"it-IT"},"runtimeMinutes":24,"rating":8,"thumbnail":"https://image.tmdb.org/t/p/w300/p7BcGZZZKYHZodvR1f1lp1uJvM5.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/p7BcGZZZKYHZodvR1f1lp1uJvM5.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/108891/season/1/episode/4"},{"id":"3489754","seasonNumber":1,"episodeNumber":5,"title":{"value":"Episodio 5","language":"it-IT"},"overview":{"value":"Ryo is forced to fight Guizhang Chen from Chen Family, to save Nozomi who Mad Angels have taken as a hostage. In hopes that Goro finds Ryo's secret message, he fights Guizhand Chen, ending with Ryo and Guizhang both wounded and defeated.","language":"en-US"},"airDateText":{"value":"2022-03-06","language":"it-IT"},"runtimeMinutes":24,"rating":8,"thumbnail":"https://image.tmdb.org/t/p/w300/cVZEESbI1QrvugNclJYNLtd3iIJ.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/cVZEESbI1QrvugNclJYNLtd3iIJ.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/108891/season/1/episode/5"},{"id":"3489755","seasonNumber":1,"episodeNumber":6,"title":{"value":"Episodio 6","lan