nail":"https://image.tmdb.org/t/p/w300/2dqeWBncNOM8JTT64kE8iqCjnEK.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/2dqeWBncNOM8JTT64kE8iqCjnEK.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/75086/season/1/episode/10"},{"id":"1419222","seasonNumber":1,"episodeNumber":11,"title":{"value":"Episodio 11","language":"it-IT"},"overview":{"value":"ソフトボール部の助っ人を頼まれちゃった。部活の帰り、アイちゃんとお兄さんにバッタリ！　そこに突然ベールが現れて、アイちゃんをさらって行ってしまったの。助けるためには一人で四葉ターミナルに来いって…。待っててね、アイちゃん！","language":"ja-JP"},"airDateText":{"value":"2013-04-14","language":"it-IT"},"runtimeMinutes":24,"thumbnail":"https://image.tmdb.org/t/p/w300/5lfCoTsQ7VjdVqgjUS7LwHGrtgI.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/5lfCoTsQ7VjdVqgjUS7LwHGrtgI.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/75086/season/1/episode/11"},{"id":"1419223","seasonNumber":1,"episodeNumber":12,"title":{"value":"Episodio 12","language":"it-IT"},"overview":{"value":"あたしに弟子ができたの。名前は純くん。あたしのお手伝いをしてくれるんだ。でも純くん、最初は張り切ってたのに、だんだん元気がなくなってきたみたい。そんな時、あたしたちの前にイーラが現れて…。","language":"ja-JP"},"airDateText":{"value":"2013-04-21","language":"it-IT"},"runtimeMinutes":24,"thumbnail":"https://image.tmdb.org/t/p/w300/hoEu5n4Zha8WqoGuWUUNGtua81s.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/hoEu5n4Zha8WqoGuWUUNGtua81s.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/75086/season/1/episode/12"},{"id":"1419227","seasonNumber":1,"episodeNumber":13,"title":{"value":"Episodio 13","language":"it-IT"},"overview":{"value":"バラを愛する最高のレディを決める「ローズレディコンテスト」に出場することになったの。王女様を見つけ出す手がかりになるかも！　でも、コンテストがはじまると、ありすの幼なじみの五星麗奈っていう子があたしたちの邪魔をしてきて…。","language":"ja-JP"},"airDateText":{"value":"2013-04-28","language":"it-IT"},"runtimeMinutes":24,"thumbnail":"https://image.tmdb.org/t/p/w300/cI05IhtpyY1piUVvxYUc2kM3LZO.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/cI05IhtpyY1piUVvxYUc2kM3LZO.jpg","language":"xx"}],"sourceUrl":"https: