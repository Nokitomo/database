WTln2rUoXd6JHTeX.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/bspEW6TPVymWTln2rUoXd6JHTeX.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/75086/season/1/episode/20"},{"id":"1476594","seasonNumber":1,"episodeNumber":21,"title":{"value":"Episodio 21","language":"it-IT"},"overview":{"value":"王女様が連れ去られちゃった！　きっとキングジコチューのところだわ。早く後を追わないと！　でも、あたしたちにはトランプ王国に行く方法がないし…どうしたらいいの？　そんな時、ロイヤルクリスタルが光りだして、扉が現れたの。","language":"ja-JP"},"airDateText":{"value":"2013-06-23","language":"it-IT"},"runtimeMinutes":24,"thumbnail":"https://image.tmdb.org/t/p/w300/zkegdwopYpLQjbG6ZuG1BA7I7is.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/zkegdwopYpLQjbG6ZuG1BA7I7is.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/75086/season/1/episode/21"},{"id":"1476595","seasonNumber":1,"episodeNumber":22,"title":{"value":"Episodio 22","language":"it-IT"},"overview":{"value":"レジーナと一緒にみんなで海に行くことに。そこにイーラたちが現れたの。レジーナはあたしたちが絶対に守る！　でも、キングジコチューにジャネジーを注入されたレジーナが攻撃してきて…。そんな時、誰かがレジーナの攻撃を止めたの…！","language":"ja-JP"},"airDateText":{"value":"2013-06-30","language":"it-IT"},"runtimeMinutes":24,"thumbnail":"https://image.tmdb.org/t/p/w300/xP1Juny055xr9mSXG4qgkqV8zSr.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/xP1Juny055xr9mSXG4qgkqV8zSr.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/75086/season/1/episode/22"},{"id":"1476596","seasonNumber":1,"episodeNumber":23,"title":{"value":"Episodio 23","language":"it-IT"},"overview":{"value":"キュアエース!?　新しいプリキュアなの!?　レジーナの攻撃を打ち消すなんて強い！　でも、レジーナはジコチューたちに連れて行かれちゃった…。落ち込むあたしを見て、キュアエースがあたしのキュアラビーズを持って行ってしまったの。","language":"ja-JP"},"airDateText":{"value":"2013-07-07","language":"it-IT"},"runtimeMinutes":24,"thumbnail":"https://image.tmdb.org/t/p/w300/sqDFsYDIKLxlDIuRQusUbhq0oAH.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/sqDFsYDIKLxlDIuRQusUbhq0oAH.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/75086/season/1/episode/23"},{"id":"1476597","seasonNumber":1,"episodeNumber":24,"title":{"value":"Episodio 24","language":"it-IT"},"overview":{"value":"まこぴーがアイドルをやめるって言いだしたの！　絶対やめちゃダメだよ！　よ～し、まこぴーが歌を歌いたくなる作戦開始。でも、気持ちはなかなか変わらないみたい…。ついに引退宣言するっていうコンサート当日、ジコチューたちが現れて。","language":"ja-JP"},"airDateText":{"value":"2013-07-14","language":"it-IT"},"runtimeMinutes":24,"thumbnail":"https://image.tmdb.org/t/p/w300/2tFcht50Nr3eyu59NiPv7gFmhZl.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/2tFcht50Nr3eyu59NiPv7gFmhZl.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/75086/season/1/episode/24"},{"id":"1476598","seasonNumber":1,"episodeNumber":25,"title":{"value":"Episodio 25","language":"it-IT"},"overview":{"value":"大ニュース！　ありすの執事・セバスチャンが、人工コミューンを開発したんだって。誰でもプリキュアになれる凄い発明みたい。すご～い！　あれ？　もう一人、謎のヒロインが現れた。黒い貴婦人・キューティマダムって…誰？","language":"ja-JP"},"airDateText":{"value":"2013-07-21","language":"it-IT"},"runtimeMinutes":24,"thumbnail":"https://image.tmdb.org/t/p/w300/m9pqPQK2j02FxLtaUeLx7ujPJRf.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/m9pqPQK2j02FxLtaUeLx7ujPJRf.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/75086/season/1/episode/25"},{"id":"1476599","seasonNumber":1,"episodeNumber":26,"title":{"value":"Episodio 26","language":"it-IT"},"overview":{"value":"六花が将来のことで悩んでるみたい。子供の頃からの夢・お医者さんに本当になりたいのか、わからなくなっちゃったみたい。そんな時、六花が男の子を連れてきたの。海で倒れていたのを助けたんだって。って、その子って…！","language":"ja-JP"},"airDateText":{"value":"2013-07-28","language":"it-IT"},"runtimeMinutes":24,"thumbnail":"https://image.tmdb.org/t/p/w300/4SGnvN0W6rfSWE0DChQHIkfNNiH.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/4SGnvN0W6rfSWE0DChQHIkfNNiH.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/75086/season/1/episode/26"},{"id":"1476600","seasonNumber":1,"episodeNumber":27,"title":{"value":"Episodio 27","language":"it-IT"},"overview":{"value":"亜久里ちゃんに野点に誘われちゃった。でも、野点ってなんだろう？　外でお茶をたてるみたいだけど…。亜久里ちゃんの厳しい指導の中、野点がはじまった。そこにリーヴァたちと巨大なジコチューが現れて…。","language":"ja-JP"},"airDateText":{"value":"2013-08-04","language":"it-IT"},"runtimeMinutes":24,"thumbnail":"https://image.tmdb.org/t/p/w300/oahRzy8gAdkHbag0OsVSbpYNWRh.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/oahRzy8gAdkHbag0OsVSbpYNWRh.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/75086/season/1/episode/27"},{"id":"1476601","seasonNumber":1,"episodeNumber":28,"title":{"value":"Episodio 28","language":"it-IT"},"overview":{"value":"やった～、お祭りだ～！　でも、亜久里ちゃんが、強化トレーニング中は行っちゃダメって…。それでも、夜店にはスーパースペシャルなスイーツがあるって言ったら、みんなで行けることになったの。浴衣に花火！　楽しい想い出をいっぱい作ろう！","language":"ja-JP"},"airDateText":{"value":"2013-08-11","language":"it-IT"},"runtimeMinutes":24,"thumbnail":"https://image.tmdb.org/t/p/w300/65Z8EBECbUkFKemMa8F1PL3f3Yo.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/65Z8EBECbUkFKemMa8F1PL3f3Yo.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/75086/season/1/episode/28"},{"id":"1476602","seasonNumber":1,"episodeNumber":29,"title":{"value":"Episodio 29","language":"it-IT"},"overview":{"value":"不思議な女の子たちが現れたの。誰だろう？　ええ～っ!?　本当に本当にシャルルたちなの!?　人間に変身して、あたしたちのお手伝いをしてくれるんだって。でも、シャルルがお使いに行ってくれてる間に、学校にリーヴァたちが現れて…。","language":"ja-JP"},"airDateText":{"value":"2013-08-18","language":"it-IT"},"runtimeMinutes":24,"thumbnail":"https://image.tmdb.org/t/p/w300/eQcTtdl0ydDYz7BFTQiMd3XQ6Vu.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/eQcTtdl0ydDYz7BFTQiMd3XQ6Vu.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/75086/season/1/episode/29"},{"id":"1476603","seasonNumber":1,"episodeNumber":30,"title":{"value":"Episodio 30","language":"it-IT"},"overview":{"value":"一万年前のプリキュアが手にしていたという伝説の鏡があるんだって。その鏡を手に入れるべく、しゅっぱ～つ！　到着した島には妖精さんが…って、ええ～っ！　妖精さんがドラゴンに～！　仕方ない。鏡を手に入れるため、いざ勝負っ！","language":"ja-JP"},"airDateText":{"value":"2013-09-01","language":"it-IT"},"runtimeMinutes":24,"thumbnail":"https://image.tmdb.org/t/p/w300/5AhorgAR5gZvftMe8p0N8CWbfqo.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/5AhorgAR5gZvftMe8p0N8CWbfqo.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/75086/season/1/episode/30"},{"id":"1476604","seasonNumber":1,"episodeNumber":31,"title":{"value":"Episodio 31","language":"it-IT"},"overview":{"value":"大変！　街のみんなが急に眠ってしまったの。このままだとリーヴァとグーラの作戦で、みんながジコチューにされちゃいそう。伝説の鏡の力を引き出せばなんとかなるかもしれない。お願い、伝説の鏡さん！　あたしたちに力を貸して！","language":"ja-JP"},"airDateText":{"value":"2013-09-08","language":"it-IT"},"runtimeMinutes":24,"thumbnail":"https://image.tmdb.org/t/p/w300/pd5l4RnfHRzgSuUJEahlqWvAta2.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/pd5l4RnfHRzgSuUJEahlqWvAta2.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/75086/season/1/episode/31"},{"id":"1476605","seasonNumber":1,"episodeNumber":32,"title":{"value":"Episodio 32","language":"it-IT"},"overview":{"value":"いよいよ明日は文化祭！　みんな、楽しもうね～って思ってたのに…熱が出て倒れちゃったよ～。亜久里ちゃんがあたしの代わりをやるって張り切ってるけど…。学校のみんなをビシバシ鍛えるって、大丈夫かなあ。","language":"ja-JP"},"airDateText":{"value":"2013-09-15","language":"it-IT"},"runtimeMinutes":24,"thumbnail":"https://image.tmdb.org/t/p/w300/y9SHhAZSn3aQZZemrKdArgwcYi2.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/y9SHhAZSn3aQZZemrKdArgwcYi2.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/75086/season/1/episode/32"},{"id":"1476606","seasonNumber":1,"episodeNumber":33,"title":{"value":"Episodio 33","language":"it-IT"},"overview":{"value":"今日はありすの家でおとまり会なの。普段は聞けない秘密の話が聞けるかも。そこへ突然、ありすのパパが帰ってきたの。ありすパパといえば、思い出すな～、子供の頃のあの時のこと！","language":"ja-JP"},"airDateText":{"value":"2013-09-22","language":"it-IT"},"runtimeMinutes":24,"thumbnail":"https://image.tmdb.org/t/p/w300/7MlxZCPnhe4hKpgGWsZwzqFmQRz.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/7MlxZCPnhe4hKpgGWsZwzqFmQRz.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/75086/season/1/episode/33"},{"id":"1476607","seasonNumber":1,"episodeNumber":34,"title":{"value":"Episodio 34","language":"it-IT"},"overview":{"value":"アイちゃんが泣き止んでくれないよ～。お腹がすいてるのかなあ。それともオムツ？　どっちも違うみたい…。大変！　アイちゃんがご機嫌ななめだと、ジコチューがパワーアップしてるみたい。え～っ、どうなってるの!?","language":"ja-JP"},"airDateText":{"value":"2013-09-29","language":"it-IT"},"runtimeMinutes":24,"thumbnail":"https://image.tmdb.org/t/p/w300/n95TjsYUFglfgMH7flOA6LxldVB.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/n95TjsYUFglfgMH7flOA6LxldVB.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/75086/season/1/episode/34"},{"id":"1476608","seasonNumber":1,"episodeNumber":35,"title":{"value":"Episodio 35","language":"it-IT"},"overview":{"value":"アイちゃんに歯が生えたの！　いつの間に!?　虫歯にならないように、歯の磨き方を教えなきゃ。って、ええ～っ、アイちゃんより先にまこぴーが虫歯になっちゃった！　歯医者さんに連れて行ったら…まこぴーが逃げ出しちゃった！","language":"ja-JP"},"airDateText":{"value":"2013-10-06","language":"it-IT"},"runtimeMinutes":24,"thumbnail":"https://image.tmdb.org/t/p/w300/nQIhZOR41DHsmJcZYZp7KVfSXPo.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/nQIhZOR41DHsmJcZYZp7KVfSXPo.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/75086/season/1/episode/35"},{"id":"1476609","seasonNumber":1,"episodeNumber":36,"title":{"value":"Episodio 36","language":"it-IT"},"overview":{"value":"ラケルが、胸がドキドキするんだって。妖精も風邪をひいたりするのかな～。しかも、うちの学校の八島さんに会うと胸がキュンキュンして苦しいって…。あれ？　それって、もしかして…。ラケルが一番好きなのは六花じゃないの～!?","language":"ja-JP"},"airDateText":{"value":"2013-10-13","language":"it-IT"},"runtimeMinutes":24,"thumbnail":"https://image.tmdb.org/t/p/w300/A7WrZSSdZL7UVlaZLYFqW4AOcGN.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/A7WrZSSdZL7UVlaZLYFqW4AOcGN.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/75086/season/1/episode/36"},{"id":"1476610","seasonNumber":1,"episodeNumber":37,"title":{"value":"Episodio 37","language":"it-IT"},"overview":{"value":"アイちゃんがニンジンを食べてくれないよぉ～。って、あれ？　亜久里ちゃんのお皿にニンジンだけ残ってる。わざと取っておいたなんて言ってるけど…。よ～し、亜久里ちゃんのニンジン嫌いも直してみせるっ！","language":"ja-JP"},"airDateText":{"value":"2013-10-20","language":"it-IT"},"runtimeMinutes":24,"thumbnail":"https://image.tmdb.org/t/p/w300/xhABQNbBDHILtPOEi3i96n09AIy.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/xhABQNbBDHILtPOEi3i96n09AIy.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/75086/season/1/episode/37"},{"id":"1476612","seasonNumber":1,"episodeNumber":38,"title":{"value":"Episodio 38","language":"it-IT"},"overview":{"value":"アイちゃんのイヤイヤも大分収まってきたと思ってたのに、最近またご機嫌ななめになることが多いような…。大変！　ベールたちが夜中にアイちゃんを誘い出してるみたい。もしかして、アイちゃんがワガママなのはそのせい？","language":"ja-JP"},"airDateText":{"value":"2013-10-27","language":"it-IT"},"runtimeMinutes":24,"thumbnail":"https://image.tmdb.org/t/p/w300/o1nol3NUoEIymVSb6Cdnzn6lwZh.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/o1nol3NUoEIymVSb6Cdnzn6lwZh.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/75086/season/1/episode/38"},{"id":"1476613","seasonNumber":1,"episodeNumber":39,"title":{"value":"Episodio 39","language":"it-IT"},"overview":{"value":"ついにキングジコチューと決着をつける時がやって来た！　これでトランプ王国を取り戻すことができる！　そしてレジーナに会いに行ける！　でも、どうやって行けばいいんだろう…。","language":"ja-JP"},"airDateText":{"value":"2013-11-10","language":"it-IT"},"runtimeMinutes":24,"thumbnail":"https://image.tmdb.org/t/p/w300/u8oGhPhHZ6tipDDIBfHh3Djy0Vx.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/u8oGhPhHZ6tipDDIBfHh3Djy0Vx.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/75086/season/1/episode/39"},{"id":"1476614","seasonNumber":1,"episodeNumber":40,"title":{"value":"Episodio 40","language":"it-IT"},"overview":{"value":"まこぴーがなんだか悩んでるみたい。どうしちゃったのかなぁ。レジーナの心に届くような歌を作りたいって、新曲のことを考えてるんだって。まこぴーの歌なら絶対届くよ！　よ～し、みんなで新曲作りのお手伝いをしよう！","language":"ja-JP"},"airDateText":{"value":"2013-11-17","language":"it-IT"},"runtimeMinutes":24,"thumbnail":"https://image.tmdb.org/t/p/w300/n5vOIvDtKWFZJKjdAbfQAHvJ0WR.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/n5vOIvDtKWFZJKjdAbfQAHvJ0WR.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/75086/season/1/episode/40"},{"id":"1476615","seasonNumber":1,"episodeNumber":41,"title":{"value":"Episodio 41","language":"it-IT"},"overview":{"value":"ありすの小さい頃の夢はお花屋さんだったんだって。よ～し、あたしがその夢かなえるよ！　でも大変、町中の花が枯れてる！　もしかして、ジコチューの仕業!?　このままじゃ花がすべてなくなっちゃう。花たちを助けなきゃ！","language":"ja-JP"},"airDateText":{"value":"2013-11-24","language":"it-IT"},"runtimeMinutes":24,"thumbnail":"https://image.tmdb.org/t/p/w300/hZxRISZfn2xradBzEMzvUgdwqRh.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/hZxRISZfn2xradBzEMzvUgdwqRh.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/75086/season/1/episode/41"},{"id":"1476616","seasonNumber":1,"episodeNumber":42,"title":{"value":"Episodio 42","language":"it-IT"},"overview":{"value":"星占いで今日の運勢を占っちゃおう！　星座って、みんなの性格が出ているみたいで面白い。亜久里ちゃんの星座は？　って、亜久里ちゃん、自分の誕生日を知らないの!?　祝ってもらったこともないって…。よし、だったらみんなでお祝いだ～！","language":"ja-JP"},"airDateText":{"value":"2013-12-01","language":"it-IT"},"runtimeMinutes":24,"thumbnail":"https://image.tmdb.org/t/p/w300/leWJhopR1Xu0kvMajWI8yPzY8Kf.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/leWJhopR1Xu0kvMajWI8yPzY8Kf.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/75086/season/1/episode/42"},{"id":"1476617","seasonNumber":1,"episodeNumber":43,"title":{"value":"Episodio 43","language":"it-IT"},"overview":{"value":"大変！　亜久里ちゃんがキュアエースってこと、おばあちゃんにバレちゃったんだって！　亜久里ちゃん、家を出るしかないなんて言い出しちゃった。でも、おばあちゃんはあんまり驚いてないみたい…。","language":"ja-JP"},"airDateText":{"value":"2013-12-08","language":"it-IT"},"runtimeMinutes":24,"thumbnail":"https://image.tmdb.org/t/p/w300/7ftl0UMhKKXtvBikmQGS9K4zJhX.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/7ftl0UMhKKXtvBikmQGS9K4zJhX.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/75086/season/1/episode/43"},{"id":"1476618","seasonNumber":1,"episodeNumber":44,"title":{"value":"Episodio 44","language":"it-IT"},"overview":{"value":"日本一の生徒会長を決める「生徒会長スピーチコンテスト」に出場することになったの！　歴代の総理大臣も参加してたんだって。燃える～っ！　でも、その日はちょうどクリスマス…。みんなと遊ぶ約束だったのに～！","language":"ja-JP"},"airDateText":{"value":"2013-12-15","language":"it-IT"},"runtimeMinutes":24,"thumbnail":"https://image.tmdb.org/t/p/w300/pE0w89Uaxjjgi7vmVtCFySaNlJH.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/pE0w89Uaxjjgi7vmVtCFySaNlJH.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/75086/season/1/episode/44"},{"id":"1476619","seasonNumber":1,"episodeNumber":45,"title":{"value":"Episodio 45","language":"it-IT"},"overview":{"value":"お兄さんが帰ってきた！　今度は偽物じゃないよね？　最後の神器・エターナルゴールデンクラウンを見つけてきたんだって。すご～い！　この伝説の冠は、あたしたちに一体どんな真実を見せてくれるんだろう。","language":"ja-JP"},"airDateText":{"value":"2013-12-22","language":"it-IT"},"runtimeMinutes":24,"thumbnail":"https://image.tmdb.org/t/p/w300/2h3WquG9E96sfe52lLudUtHaNWy.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/2h3WquG9E96sfe52lLudUtHaNWy.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/75086/season/1/episode/45"},{"id":"1476620","seasonNumber":1,"episodeNumber":46,"title":{"value":"Episodio 46","language":"it-IT"},"overview":{"value":"キュアエースが、エターナルゴールデンクラウンの記憶から真実を知ったみたい。キングジコチューが生まれた理由、アン王女を襲った悲劇。レジーナとキュアエースが光と影!?　知りたいけど知りたくない…。","language":"ja-JP"},"airDateText":{"value":"2014-01-05","language":"it-IT"},"runtimeMinutes":24,"thumbnail":"https://image.tmdb.org/t/p/w300/3fCLlIanuYWBttg4XWLmtV0qgI2.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/3fCLlIanuYWBttg4XWLmtV0qgI2.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/75086/season/1/episode/46"},{"id":"1476621","seasonNumber":1,"episodeNumber":47,"title":{"value":"Episodio 47","language":"it-IT"},"overview":{"value":"ついにキングジコチューが復活してしまったの。でも大丈夫！　だって、レジーナとの約束があるんだから。一緒にレジーナのお父さんと話そうって…。レジーナ、あの時の約束、今果たすよ！","language":"ja-JP"},"airDateText":{"value":"2014-01-12","language":"it-IT"},"runtimeMinutes":24,"thumbnail":"https://image.tmdb.org/t/p/w300/vZLrChRFLiC4YBSO3KHZ5mAMUhX.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/vZLrChRFLiC4YBSO3KHZ5mAMUhX.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/75086/season/1/episode/47"},{"id":"1476623","seasonNumber":1,"episodeNumber":48,"title":{"value":"Episodio 48","language":"it-IT"},"overview":{"value":"間違いない、キングジコチューの中には国王さまの愛が残ってる！　その愛を高めることができれば、ひょっとしてキングジコチューを止められる!?　ううん、絶対出来る！　あたしは大貝中学生徒会長の相田マナなんだから！","language":"ja-JP"},"airDateText":{"value":"2014-01-19","language":"it-IT"},"runtimeMinutes":24,"thumbnail":"https://image.tmdb.org/t/p/w300/wZRL0Ivj6SUciljTk53eDNRDu2N.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/wZRL0Ivj6SUciljTk53eDNRDu2N.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/75086/season/1/episode/48"},{"id":"1476624","seasonNumber":1,"episodeNumber":49,"title":{"value":"Episodio 49","language":"it-IT"},"overview":{"value":"ベールがキングジコチューのジャネジーを飲み込んじゃった！　自分がキングになるつもり!?　でも、様子がおかしい…。あれは闇の存在そのもの。この世界が再び闇に閉ざされる!?　そんなこと絶対に許さない！","language":"ja-JP"},"airDateText":{"value":"2014-01-26","language":"it-IT"},"runtimeMinutes":24,"thumbnail":"https://image.tmdb.org/t/p/w300/irRixaWmYQ8KyLpmNCvbdSCw072.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/irRixaWmYQ8KyLpmNCvbdSCw072.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/75086/season/1/episode/49"}],"sourceUrl":"https://www.themoviedb.org/tv/75086/season/1"},"failure":null,"fields":{},"episodes":{"1":{"checkedAt":1793360160233,"status":"ok"},"2":{"checkedAt":1793360160233,"status":"ok"},"3":{"checkedAt":1793360160233,"status":"ok"},"4":{"checkedAt":1793360160233,"status":"ok"},"5":{"checkedAt":1793360160233,"status":"ok"},"6":{"checkedAt":1793360160233,"status":"ok"},"7":{"checkedAt":1793360160233,"status":"ok"},"8":{"checkedAt":1793360160233,"status":"ok"},"9":{"checkedAt":1793360160233,"status":"ok"},"10":{"checkedAt":1793360160233,"status":"ok"},"11":{"checkedAt":1793360160233,"statu