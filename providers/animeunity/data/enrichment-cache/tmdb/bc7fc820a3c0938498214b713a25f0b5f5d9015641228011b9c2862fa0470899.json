mdb.org/t/p/w300/4XMRhM2WJZlzjGKgcZPJelgziXE.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/4XMRhM2WJZlzjGKgcZPJelgziXE.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/21732/season/2/episode/6"},{"id":"599652","seasonNumber":2,"episodeNumber":7,"title":{"value":"Episodio 7","language":"it-IT"},"overview":{"value":"Sumeragi has regained consciousness, and thanks to her tactical plan the Ptolemaios 2 is able to escape the battlefield. However, Allelujah's Gundam has been shot down along with Soma Peries, and his comrades cannot locate him.","language":"en-US"},"airDateText":{"value":"2008-11-16","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/ijyRD93m3nnc7iRSVY2d1b4OGpy.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/ijyRD93m3nnc7iRSVY2d1b4OGpy.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/21732/season/2/episode/7"},{"id":"599653","seasonNumber":2,"episodeNumber":8,"title":{"value":"Episodio 8","language":"it-IT"},"overview":{"value":"Tieria is shocked at the sudden appearance of his lookalike Regene Regetta. He is further disturbed by Regene's revelations about the Innovators.","language":"en-US"},"airDateText":{"value":"2008-11-23","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/36wnJ70XPXznUOHfYBnf7MwBVOh.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/36wnJ70XPXznUOHfYBnf7MwBVOh.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/21732/season/2/episode/8"},{"id":"599654","seasonNumber":2,"episodeNumber":9,"title":{"value":"Episodio 9","language":"it-IT"},"overview":{"value":"Setsuna and Tieria are confronted by Ali al-Saachez and his new Arche Gundam. A furious Tieria tries to avenge Lockon, but is overwhelmed by the enemy's fighting strength.","language":"en-US"},"airDateText":{"value":"2008-11-30","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/1NBnBD44CpJVc2Xl1cIeXjI9X4y.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/1NBnBD44CpJVc2Xl1cIeXjI9X4y.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/21732/season/2/episode/9"},{"id":"599655","seasonNumber":2,"episodeNumber":10,"title":{"value":"Episodio 10","language":"it-IT"},"overview":{"value":"The Federation's plan to forcibly reorganize the Middle East is opposed by the kingdom of Suille, the strongest of the Middle Eastern nations.","language":"en-US"},"airDateText":{"value":"2008-12-07","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/wdPyxPRszcb9V9pP4l2HJDHmWBo.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/wdPyxPRszcb9V9pP4l2HJDHmWBo.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/21732/season/2/episode/10"},{"id":"599656","seasonNumber":2,"episodeNumber":11,"title":{"value":"Episodio 11","language":"it-IT"},"overview":{"value":"While Ian Vashti and his fellow Celestial Being mechanics prepare the O Raiser, a support machine for Setsuna's 00 Gundam, the A-LAWS deploy a devastating new weapon of their own.","language":"en-US"},"airDateText":{"value":"2008-12-14","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/y67cCvuOFW2T9Nmo58L7yn4ZGlV.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/y67cCvuOFW2T9Nmo58L7yn4ZGlV.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/21732/season/2/episode/11"},{"id":"599657","seasonNumber":2,"episodeNumber":12,"title":{"value":"Episodio 12","language":"it-IT"},"overview":{"value":"The Ptolemaios 2 attempts to make a hasty escape from the attacking A-LAWS. But the Gundam Meisters are hard-pressed by Kati Mannequin's tactics and the enemy's new mobile suits.","language":"en-US"},"airDateText":{"value":"2008-12-21","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/atOjmT1PfsvuvD5fksf5FaXyJLm.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/atOjmT1PfsvuvD5fksf5FaXyJLm.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/21732/season/2/episode/12"},{"id":"599658","seasonNumber":2,"episodeNumber":13,"title":{"value":"Episodio 13","language":"it-IT"},"overview":{"value":"The Katharon space fleet has begun an assault on the satellite weapon Memento Mori, and is now under attack by A-LAWS mobile suits.","language":"en-US"},"airDateText":{"value":"2008-12-28","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/s1l7evQxHCmPcWqCglg7q8Ivvlq.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/s1l7evQxHCmPcWqCglg7q8Ivvlq.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/21732/season/2/episode/13"},{"id":"599659","seasonNumber":2,"episodeNumber":14,"title":{"value":"Episodio 14","language":"it-IT"},"overview":{"value":"The Ptolemaios 2, damaged by the Innovators' attack, descends to Earth. Now separated from his comrades, Setsuna searches for the Ptolemaios 2. But instead, he finds Ali al-Saachez and his Arche Gundam waiting for him.","language":"en-US"},"airDateText":{"value":"2009-01-11","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/rheOHw9QMB5W8Q0WxTgjGfdIIhm.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/rheOHw9QMB5W8Q0WxTgjGfdIIhm.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/21732/season/2/episode/14"},{"id":"599660","seasonNumber":2,"episodeNumber":15,"title":{"value":"Episodio 15","language":"it-IT"},"overview":{"value":"The Ptolemaios 2 has received supplies from Katharon, and repairs are now in progress. But it cannot break through the Federation's siege without the fighting strength of the 00, and Setsuna has not yet returned to the ship.","language":"en-US"},"airDateText":{"value":"2009-01-18","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/meAc9IOh5hWTrPUUTd36i8GeNMF.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/meAc9IOh5hWTrPUUTd36i8GeNMF.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/21732/season/2/episode/15"},{"id":"599661","seasonNumber":2,"episodeNumber":16,"title":{"value":"Episodio 16","language":"it-IT"},"overview":{"value":"The A-LAWS have abruptly retreated after receiving word of a coup d'etat within the Federation. Hoping to reunite with his comrades, Setsuna sets the 00 on a course for Africa.","language":"en-US"},"airDateText":{"value":"2009-01-25","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/lFoZw4a143K8Fi9kR73xEHMhvJt.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/lFoZw4a143K8Fi9kR73xEHMhvJt.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/21732/season/2/episode/16"},{"id":"599662","seasonNumber":2,"episodeNumber":17,"title":{"value":"Episodio 17","language":"it-IT"},"overview":{"value":"A crisis is unfolding, but the Ptolemaios 2, which has not yet been fully repaired, is unable to break the deadlock. The wounded Setsuna returns to battle despite his injuries, asking Saji to help him save countless innocent lives.","language":"en-US"},"airDateText":{"value":"2009-02-01","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/z7owc1fE6NFrMnrcWeOPPGD3KKa.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/z7owc1fE6NFrMnrcWeOPPGD3KKa.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/21732/season/2/episode/17"},{"id":"599663","seasonNumber":2,"episodeNumber":18,"title":{"value":"Episodio 18","language":"it-IT"},"overview":{"value":"Four months have passed since the \"Break Pillar\" incident, the near-collapse of an orbital elevator. The A-LAWS leaders receive word that Celestial Being has resumed activity after months of silence.","language":"en-US"},"airDateTex