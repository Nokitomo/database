{"schemaVersion":1,"source":"tmdb","kind":"episodes","input":{"mediaId":21732,"seasonNumber":2},"checkedAt":1793434101214,"status":"ok","retryCount":0,"value":{"seasonNumber":2,"name":{"value":"Stagione 2","language":"it-IT"},"year":2008,"episodeCount":25,"poster":"https://image.tmdb.org/t/p/original/wxhCW3QbcmjyL9sJO9XJWatK17.jpg","posters":[],"backgrounds":[],"episodes":[{"id":"599646","seasonNumber":2,"episodeNumber":1,"title":{"value":"Episodio 1","language":"it-IT"},"overview":{"value":"The year is 2312 A.D, five years after the first appearance of Celestial Being, and four years after the organization was destroyed by the United Nations forces.","language":"en-US"},"airDateText":{"value":"2008-10-05","language":"it-IT"},"runtimeMinutes":25,"rating":7,"thumbnail":"https://image.tmdb.org/t/p/w300/dKrmlUQ3EXTweePRPoM7IsI3vxC.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/dKrmlUQ3EXTweePRPoM7IsI3vxC.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/21732/season/2/episode/1"},{"id":"599647","seasonNumber":2,"episodeNumber":2,"title":{"value":"Episodio 2","language":"it-IT"},"overview":{"value":"With the reappearance of Celestial Being, the A-LAWS begin gathering personnel who have experience fighting the Gundams.","language":"en-US"},"airDateText":{"value":"2008-10-12","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/fUyLEnvXoQT0qiWySmmUswlzyfu.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/fUyLEnvXoQT0qiWySmmUswlzyfu.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/21732/season/2/episode/2"},{"id":"599648","seasonNumber":2,"episodeNumber":3,"title":{"value":"Episodio 3","language":"it-IT"},"overview":{"value":"The A-LAWS prepare a new trap for the reborn Celestial Being at a detention center for anti-government elements.","language":"en-US"},"airDateText":{"value":"2008-10-19","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.