l","url":"https://image.tmdb.org/t/p/original/lCzxOTNww05BhdpGzyq0P4GylYb.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/213402/season/1/episode/5"},{"id":"4150231","seasonNumber":1,"episodeNumber":6,"title":{"value":"Episodio 6","language":"it-IT"},"overview":{"value":"The place Fel decides to bring Mukohda to get some battle experience ends up being a creepy dungeon. Even so, Mukohda gets ready for battle and increases his stats by eating a meal from his original world using the “Online Grocery”. However...","language":"en-US"},"airDateText":{"value":"2023-02-15","language":"it-IT"},"runtimeMinutes":24,"rating":8.1,"thumbnail":"https://image.tmdb.org/t/p/w300/sb88MaRO6hZtiRK8g9MX9uNG1AP.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/sb88MaRO6hZtiRK8g9MX9uNG1AP.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/213402/season/1/episode/6"},{"id":"4150233","seasonNumber":1,"episodeNumber":7,"title":{"value":"Episodio 7","language":"it-IT"},"overview":{"value":"Mukohda and his familiars dash through the forest, after strengthening their bonds in the dungeon. However, they soon find themselves in the territory of dangerous monsters and, just like Mukohda expected, surrounded by a pack of orthros...","language":"en-US"},"airDateText":{"value":"2023-02-22","language":"it-IT"},"runtimeMinutes":24,"rating":7.6,"thumbnail":"https://image.tmdb.org/t/p/w300/sNM4HhBZJgTWjrSCUfsJWY5DAPd.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/sNM4HhBZJgTWjrSCUfsJWY5DAPd.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/213402/season/1/episode/7"},{"id":"4150235","seasonNumber":1,"episodeNumber":8,"title":{"value":"Episodio 8","language":"it-IT"},"overview":{"value":"After Mukohda rescues a traveling caravan from a band of bandits, they set out together for the great city of Karelina. But when Mukohda visits the Adventurer’s Guild in the city, he gets notified that his membership was re