{"schemaVersion":1,"source":"tmdb","kind":"episodes","input":{"mediaId":3570,"seasonNumber":3},"checkedAt":1793362781124,"status":"ok","value":{"seasonNumber":3,"name":{"value":"Sailor Moon S","language":"it-IT"},"year":1994,"episodeCount":38,"poster":"https://image.tmdb.org/t/p/original/isevGUj0qHBDnXs0s0uGa6NNcv7.jpg","posters":[],"backgrounds":[],"episodes":[{"id":"992400","seasonNumber":3,"episodeNumber":1,"title":{"value":"L'inizio di una nuova battaglia","language":"it-IT"},"overview":{"value":"Dopo aver avuto visioni apocalittiche, Rei viene attaccata da un mostro estremamente potente che Sailor Moon non riesce a sconfiggere.","language":"it-IT"},"airDateText":{"value":"1994-03-19","language":"it-IT"},"runtimeMinutes":24,"rating":7,"thumbnail":"https://image.tmdb.org/t/p/w300/bAXHawvnG5bHKj8MIucXXo7plOD.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/bAXHawvnG5bHKj8MIucXXo7plOD.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/3570/season/3/episode/1"},{"id":"992401","seasonNumber":3,"episodeNumber":2,"title":{"value":"Un Nuovo Scettro","language":"it-IT"},"overview":{"value":"Una ragazzina viene attaccata da un Daimon, ma Usagi non è più in grado di trasformarsi in Sailor Moon; le Guerriere Sailor, in difficoltà, devono affidarsi ancora una volta alle nuove e misteriose Sailor.","language":"it-IT"},"airDateText":{"value":"1994-03-26","language":"it-IT"},"runtimeMinutes":24,"rating":6.5,"thumbnail":"https://image.tmdb.org/t/p/w300/wzuUpDRqaG7dgM9V9PcHUyfBNJ7.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/wzuUpDRqaG7dgM9V9PcHUyfBNJ7.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/3570/season/3/episode/2"},{"id":"992402","seasonNumber":3,"episodeNumber":3,"title":{"value":"Ragazzo o Ragazza","language":"it-IT"},"overview":{"value":"Usagi e Minako si prendono una cotta per Haruka Tenou, un ragazzo affascinante e sofisticato... o almeno così credono.","language":"it-IT"},"airDa