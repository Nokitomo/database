Url":"https://www.themoviedb.org/tv/45247/season/2/episode/17"},{"id":"898126","seasonNumber":2,"episodeNumber":18,"title":{"value":"Episodio 18","language":"it-IT"},"overview":{"value":"A new found passion has brought Misuzawa back into the fight, as Chihaya herself tries to fight through the pain of her injury.","language":"en-US"},"airDateText":{"value":"2013-05-11","language":"it-IT"},"runtimeMinutes":23,"thumbnail":"https://image.tmdb.org/t/p/w300/ufcB9nGKn3cuXjJZtpZXpP1MUy5.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/ufcB9nGKn3cuXjJZtpZXpP1MUy5.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/45247/season/2/episode/18"},{"id":"898127","seasonNumber":2,"episodeNumber":19,"title":{"value":"Episodio 19","language":"it-IT"},"overview":{"value":"Three wins for the victory. Taichi's declaration provides encouragement to the remaining players. The Mizusawa karuta club uses all of their experience and practice to fight to the end.","language":"en-US"},"airDateText":{"value":"2013-05-18","language":"it-IT"},"runtimeMinutes":23,"thumbnail":"https://image.tmdb.org/t/p/w300/c5JUGngf3LAloH9KpMBX2FKF42H.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/c5JUGngf3LAloH9KpMBX2FKF42H.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/45247/season/2/episode/19"},{"id":"898128","seasonNumber":2,"episodeNumber":20,"title":{"value":"Episodio 20","language":"it-IT"},"overview":{"value":"The Mizusawa karuta club has won the team championship, becoming the number one team in Japan. The players reflect upon the path they took to the championship. After Chihaya remembers the pain in her finger, she is taken to the hospital.","language":"en-US"},"airDateText":{"value":"2013-05-25","language":"it-IT"},"runtimeMinutes":23,"thumbnail":"https://image.tmdb.org/t/p/w300/d1YN2oGeZI9xGn1GZjWs89XISW5.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/d1YN2oGeZI9xGn1GZjWs89XISW5.jpg","langu