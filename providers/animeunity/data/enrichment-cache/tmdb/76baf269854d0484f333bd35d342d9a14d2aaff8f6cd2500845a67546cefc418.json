p/w300/yvCEcMfmXcL3k7NOGGIiVgTdh1O.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/yvCEcMfmXcL3k7NOGGIiVgTdh1O.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/60863/season/2/episode/5"},{"id":"1135556","seasonNumber":2,"episodeNumber":6,"title":{"value":"Tempo","language":"it-IT"},"overview":{"value":"Il litigio fra Hinata e Kageyama ha smosso le acque. Il mister Ukai porta Hinata da suo nonno per capire come agire e Kageyama cerca consiglio dal suo acerrimo rivale, Oikawa.","language":"it-IT"},"airDateText":{"value":"2015-11-08","language":"it-IT"},"runtimeMinutes":24,"rating":8.1,"thumbnail":"https://image.tmdb.org/t/p/w300/40aXYh5oAL1wJ2bJxSQJzhJAMHG.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/40aXYh5oAL1wJ2bJxSQJzhJAMHG.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/60863/season/2/episode/6"},{"id":"1148629","seasonNumber":2,"episodeNumber":7,"title":{"value":"Sorge la luna","language":"it-IT"},"overview":{"value":"Il ritiro estivo lungo ha inizio e per i ragazzi del Karasuno è arrivato il momento di allenarsi ancora più duramente. Tsukishima però non sembra della stessa idea dei suoi compagni.","language":"it-IT"},"airDateText":{"value":"2015-11-15","language":"it-IT"},"runtimeMinutes":24,"rating":7.8,"thumbnail":"https://image.tmdb.org/t/p/w300/gDcvcRAqreTuH7vgfC42VBGrx6y.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/gDcvcRAqreTuH7vgfC42VBGrx6y.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/60863/season/2/episode/7"},{"id":"1148630","seasonNumber":2,"episodeNumber":8,"title":{"value":"Eroe illusorio","language":"it-IT"},"overview":{"value":"Yamaguchi non riesce a mandar giù il comportamento di Tsukishima e cerca di convincerlo a dare il massimo. Ma convincerlo e dargli la spinta definitiva potrebbe essere qualcun altro.","language":"it-IT"},"airDateText":{"value":"2015-11-22","language":"it-IT"},"runtimeMinutes":24,"rating":6.9,"thumbnail":"https://image.tmdb.org/t/p/w300/wIR8o20mk8U5Lr3sKzBuDtjGO0C.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/wIR8o20mk8U5Lr3sKzBuDtjGO0C.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/60863/season/2/episode/8"},{"id":"1148631","seasonNumber":2,"episodeNumber":9,"title":{"value":"VS ombrello","language":"it-IT"},"overview":{"value":"Fra Hinata e Kageyama il rapporto è ancora teso e la nuova veloce non sembra funzionare. Un nuovo scontro fra i due li porta ad allenarsi di nuovo ognuno per conto proprio.","language":"it-IT"},"airDateText":{"value":"2015-11-29","language":"it-IT"},"runtimeMinutes":24,"rating":8,"thumbnail":"https://image.tmdb.org/t/p/w300/mAiqEX487M3iwhsACtTQuQ7ymOo.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/mAiqEX487M3iwhsACtTQuQ7ymOo.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/60863/season/2/episode/9"},{"id":"1148632","seasonNumber":2,"episodeNumber":10,"title":{"value":"Ingranaggi","language":"it-IT"},"overview":{"value":"Il ritiro è agli sgoccioli e il Karasuno gioca il suo ultimo set contro il Fukurodani. L'avversario più temibile di Tokyo sarà l'occasione per mettere a frutto i risultati del duro allenamento!","language":"it-IT"},"airDateText":{"value":"2015-12-06","language":"it-IT"},"runtimeMinutes":24,"rating":7.2,"thumbnail":"https://image.tmdb.org/t/p/w300/sobaESSCtYErAxWDswcDyPswCY6.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/sobaESSCtYErAxWDswcDyPswCY6.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/60863/season/2/episode/10"},{"id":"1148633","seasonNumber":2,"episodeNumber":11,"title":{"value":"In alto","language":"it-IT"},"overview":{"value":"La partita contro il Fukurodani è agli sgoccioli e una bella grigliata attende tutti i giocatori. È il momento di tirare le somme su tutto ciò a cui è servito questo lungo ritiro.","language":"it-IT"},"airDateText":{"value":"2015-12-13","language":"it-IT"},"runtimeMinutes":24,"rating":8.2,"thumbnail":"https://image.tmdb.org/t/p/w300/xxplyVnacmWXDYPwqt2s4tIXQzC.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/xxplyVnacmWXDYPwqt2s4tIXQzC.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/60863/season/2/episode/11"},{"id":"1148634","seasonNumber":2,"episodeNumber":12,"title":{"value":"L'inizio delle partite!","language":"it-IT"},"overview":{"value":"I preliminari per il Torneo interliceale primaverile hanno inizio e il primo avversario del Karasuno è liceo Ogiminami. I suoi giocatori sono ancora scossi dalla sconfitta contro lo Shiratorizawa.","language":"it-IT"},"airDateText":{"value":"2015-12-20","language":"it-IT"},"runtimeMinutes":24,"rating":8,"thumbnail":"https://image.tmdb.org/t/p/w300/Ru50zI6v8UgjgghtoiHkMmd6MZ.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/Ru50zI6v8UgjgghtoiHkMmd6MZ.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/60863/season/2/episode/12"},{"id":"1150068","seasonNumber":2,"episodeNumber":13,"title":{"value":"Semplice e pura forza","language":"it-IT"},"overview":{"value":"Dopo la vittoria contro il liceo Ogiminami, il Karasuno si trova ad affrontare il liceo Kakugawa, che fra le sue fila vanta un giocatore alto 2 metri e 10.","language":"it-IT"},"airDateText":{"value":"2015-12-27","language":"it-IT"},"runtimeMinutes":24,"rating":8.2,"thumbnail":"https://image.tmdb.org/t/p/w300/ptAUyVtnoaOZnc2AZDqlXOfvMKN.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/ptAUyVtnoaOZnc2AZDqlXOfvMKN.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/60863/season/2/episode/13"},{"id":"1156241","seasonNumber":2,"episodeNumber":14,"title":{"value":"Crescita","language":"it-IT"},"overview":{"value":"I ragazzi del Karasuno hanno superato il primo girone di eliminatorie, ma sono decisi a migliorare ancora di più. Ognuno vuole perfezionarsi e tutti tornano a Tokyo per una nuova trasferta.","language":"it-IT"},"airDateText":{"value":"2016-01-10","language":"it-IT"},"runtimeMinutes":24,"rating":8.4,"thumbnail":"https://image.tmdb.org/t/p/w300/rmOmKewUSfZVGYsMtHbvGvMlELs.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/rmOmKewUSfZVGYsMtHbvGvMlELs.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/60863/season/2/episode/14"},{"id":"1160001","seasonNumber":2,"episodeNumber":15,"title":{"value":"Parco giochi","language":"it-IT"},"overview":{"value":"Tornato in tempo per la partita contro il liceo Johzenji, il Karasuno si trova di fronte una squadra incredibilmente eccentrica e imprevedibile.","language":"it-IT"},"airDateText":{"value":"2016-01-17","language":"it-IT"},"runtimeMinutes":24,"rating":8.2,"thumbnail":"https://image.tmdb.org/t/p/w300/j59yQ47PCjNSiPRZGca6kaYeKIM.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/j59yQ47PCjNSiPRZGca6kaYeKIM.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/60863/season/2/episode/15"},{"id":"1160002","seasonNumber":2,"episodeNumber":16,"title":{"value":"I prossimi","language":"it-IT"},"overview":{"value":"Il liceo Johzenji si fa protagonista di una rimonta contro il Karasuno dopo i rimproveri della loro manager, ma non rinuncia a giocare in modo fin troppo spericolato.","language":"it-IT"},"airDateText":{"value":"2016-01-24","language":"it-IT"},"runtimeMinutes":24,"rating":8.5,"thumbnail":"https://image.tmdb.org/t/p/w300/8cEpkDQlpU2RX3tj7bErMCcgxXM.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/8cEpkDQlpU2RX3tj7bErMCcgxXM.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/60863/season/2/episode/16"},{"id":"1160003","seasonNumber":2,"episodeNumber":17,"title":{"value":"La battaglia dei codardi","language":"it-IT"},"overview":{"value":"Ennoshita sostituisce Daichi dopo un infortunio e, nonostante la paura, vuole riscattarsi per ciò che è successo al primo anno. Anche Yamaguchi è deciso a dare il tutto per tutto.","language":"it-IT"},"airDateText":{"value":"2016-01-31","language":"it-IT"},"runtimeMinutes":24,"rating":8.1,"thumbnail":"https://image.tmdb.org/t/p/w300/ulCDFwEzuNqFsfuhQYSMNXjKnaX.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/ulCDFwEzuNqFsfuhQYSMNXjKnaX.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/60863/season/2/episode/17"},{"id":"1160932","seasonNumber":2,"episodeNumber":18,"title":{"value":"Gli sconfitti","language":"it-IT"},"overview":{"value":"L'assenza di Daichi è pesante ed Ennoshita deve trovare il modo di condurre la squadra alla vittoria. E mentre il Karasuno è impegnato contro il Wakutani Sud, il Seijoh affronta il Dateko.","language":"it-IT"},"airDateText":{"value":"2016-02-07","language":"it-IT"},"runtimeMinutes":24,"rating":8.1,"thumbnail":"https://image.tmdb.org/t/p/w300/2FLRyKX0qLipLwghrK0W1a7V6ob.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/2FLRyKX0qLipLwghrK0W1a7V6ob.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/60863/season/2/episode/18"},{"id":"1160933","seasonNumber":2,"episodeNumber":19,"title":{"value":"Il Muro di ferro può essere ricostruito all'infinito","language":"it-IT"},"overview":{"value":"Il Seijoh affronta il Dateko per decidere chi sarà ad avanzare alle semifinali. Il nuovo palleggiatore di questi ultimi, Koganegawa, è però ancora inesperto.","language":"it-IT"},"airDateText":{"value":"2016-02-14","language":"it-IT"},"runtimeMinutes":24,"rating":6.9,"thumbnail":"https://image.tmdb.org/t/p/w300/boTsMwp1QAMNhkr7Q50m2DrkK3g.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/boTsMwp1QAMNhkr7Q50m2DrkK3g.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/60863/season/2/episode/19"},{"id":"1165695","seasonNumber":2,"episodeNumber":20,"title":{"value":"Spazzare via","language":"it-IT"},"overview":{"value":"Il Karasuno si ritrova ancora una volta faccia a faccia con la squadra di Oikawa. Nonostante i miglioramenti della squadra e soprattutto di Hinata e Kageyama, l'esperienza del Seijoh si fa sentire.","language":"it-IT"},"airDateText":{"value":"2016-02-21","language":"it-IT"},"runtimeMinutes":24,"rating":8.6,"thumbnail":"https://image.tmdb.org/t/p/w300/4jZY3sUwfVxgd3YrXjUaqWVKp8G.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/4jZY3sUwfVxgd3YrXjUaqWVKp8G.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/60863/season/2/episode/20"},{"id":"1165696","seasonNumber":2,"episodeNumber":21,"title":{"value":"Il distruttore","language":"it-IT"},"overview":{"value":"Nel secondo set, il Seijoh schiera in campo Kyotani, che sorprende i ragazzi del Karasuno. Ma la sua irruenza è un'arma a doppio taglio e Oikawa deve trovare un modo per sfruttarla a dovere.","language":"it-IT"},"airDateText":{"value":"2016-02-28","language":"it-IT"},"runtimeMinutes":24,"rating":8.9,"thumbnail":"https://image.tmdb.org/t/p/w300/sSaU2gFQwX4m6MJB9bgnytU3tos.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/sSaU2gFQwX4m6MJB9bgnytU3tos.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/60863/season/2/episode/21"},{"id":"1174078","seasonNumber":2,"episodeNumber":22,"title":{"value":"La battaglia dell'ex codardo","language":"it-IT"},"overview":{"value":"Un Yamaguchi con rinnovato spirito entra come pinch server per il Karasuno nella speranza di rimontare e strappare anche il secondo set al Seijoh.","language":"it-IT"},"airDateText":{"value":"2016-03-06","language":"it-IT"},"runtimeMinutes":24,"rating":9.1,"thumbnail":"https://image.tmdb.org/t/p/w300/4wjRzQrVGJwNcx6xMfJMhUs2RKc.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/4wjRzQrVGJwNcx6xMfJMhUs2RKc.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/60863/season/2/episode/22"},{"id":"1175462","seasonNumber":2,"episodeNumber":23,"title":{"value":"Squadra","language":"it-IT"},"overview":{"value":"La lotta per conquistare il terzo set si fa efferata. L'irruenza di Kyotani si fa esagerata e viene sostituito, ma i suoi compagni sono pronti a supportarlo perché si ambienti nella squadra.","language":"it-IT"},"airDateText":{"value":"2016-03-13","language":"it-IT"},"runtimeMinutes":24,"rating":7.9,"thumbnail":"https://image.tmdb.org/t/p/w300/qoOmoWnKJ2TdCBkT15SWnCUboYC.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/qoOmoWnKJ2TdCBkT15SWnCUboYC.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/60863/season/2/episode/23"},{"id":"1178501","seasonNumber":2,"episodeNumber":24,"title":{"value":"L'interruttore del limite assoluto","language":"it-IT"},"overview":{"value":"Il Karasuno è in vantaggio e la partita è agli sgoccioli, ma il Seijoh è più che determinato a conquistare il terzo set e aggiudicarsi la vittoria. Lo scontro finale è fra talento e istinto!","language":"it-IT"},"airDateText":{"value":"2016-03-20","language":"it-IT"},"runtimeMinutes":24,"rating":8.9,"thumbnail":"https://image.tmdb.org/t/p/w300/lDj3xPns0TjRyPB36zwNZA6X7rU.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/lDj3xPns0TjRyPB36zwNZA6X7rU.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/60863/season/2/episode/24"},{"id":"1178502","seasonNumber":2,"episodeNumber":25,"title":{"value":"Dichiarazione di guerra","language":"it-IT"},"overview":{"value":"Il Karasuno è riuscito a spuntarla contro il Seijoh. Sulla strada di Hinata e Kageyama per i nazionali ora c'è solo lo Shiratorizawa, che hanno già promesso di abbattere.","language":"it-IT"},"airDateText":{"value":"2016-03-27","language":"it-IT"},"runtimeMinutes":24,"rating":7.8,"thumbnail":"https://image.tmdb.org/t/p/w300/cNSNpPoIUd80QTi5naxUQn2KyrY.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/cNSNpPoIUd80QTi5naxUQn2KyrY.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/60863/season/2/episode/25"}],"sourceUrl":"https://www.themoviedb.org/tv