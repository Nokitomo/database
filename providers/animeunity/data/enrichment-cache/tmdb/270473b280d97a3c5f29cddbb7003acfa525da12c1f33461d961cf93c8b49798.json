/w300/kRniGP4r28M8jvJ8gBdE8tqf5TO.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/kRniGP4r28M8jvJ8gBdE8tqf5TO.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/20353/season/2/episode/21"},{"id":"582505","seasonNumber":2,"episodeNumber":22,"title":{"value":"Voltagabbana","language":"it-IT"},"overview":{"value":"Con il passaggio ormai aperto tra il Mondo dei Maghi e quello delle Streghe, Alexander viene incaricato di catturare Hanna.","language":"it-IT"},"airDateText":{"value":"2000-07-09","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/8s9QziUQIW9qu3qAqU2ooCJtPyv.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/8s9QziUQIW9qu3qAqU2ooCJtPyv.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/20353/season/2/episode/22"},{"id":"582506","seasonNumber":2,"episodeNumber":23,"title":{"value":"Il rapimento","language":"it-IT"},"overview":{"value":"Le apprendiste vengono sconfitte da Alexander, che porta via Hanna. La Regina concede loro il potere del Giro di Do per riportare indietro la bambina sana e salva.","language":"it-IT"},"airDateText":{"value":"2000-07-17","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/pHBVFdMBWsOmeHSJKjGNBiswQvN.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/pHBVFdMBWsOmeHSJKjGNBiswQvN.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/20353/season/2/episode/23"},{"id":"582507","seasonNumber":2,"episodeNumber":24,"title":{"value":"Il lottatore di sumo","language":"it-IT"},"overview":{"value":"Tetsuya e Kimura vogliono entrare nel torneo di sumo per vincere un nuovo videogioco. Anche Susumu Yanagida, bambino cicciottello che adora il pane fritto, si unisce a loro.","language":"it-IT"},"airDateText":{"value":"2000-07-24","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/28Bt7DEnNQrGgaHqnJcgVf9dCoH.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/28Bt7DEnNQrGgaHqnJcgVf9dCoH.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/20353/season/2/episode/24"},{"id":"582508","seasonNumber":2,"episodeNumber":25,"title":{"value":"Un ragazzo misterioso","language":"it-IT"},"overview":{"value":"Un giovane mago di nome Akatsuki viene inviato nel mondo umano per aiutare Alexander, che decide di usare Doremì per arrivare a Hanna.","language":"it-IT"},"airDateText":{"value":"2000-07-30","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/fiJJgbyhHJgl3RkSiJ1xnp6kHbc.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/fiJJgbyhHJgl3RkSiJ1xnp6kHbc.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/20353/season/2/episode/25"},{"id":"582509","seasonNumber":2,"episodeNumber":26,"title":{"value":"La dieta","language":"it-IT"},"overview":{"value":"Dal momento che il costume da bagno dello scorso anno non le sta più, Kanae Iida decide di iniziare la dieta e chiede a Doremì di aiutarla. Intanto Hanna deve sostenere la sua prova medica, che consiste nel misurare il suo appetito.","language":"it-IT"},"airDateText":{"value":"2000-08-06","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/mJLaXLkpbQCVWr4cUzsZ6aRyuAQ.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/mJLaXLkpbQCVWr4cUzsZ6aRyuAQ.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/20353/season/2/episode/26"},{"id":"582510","seasonNumber":2,"episodeNumber":27,"title":{"value":"Il compagno di pesca","language":"it-IT"},"overview":{"value":"Majo Ririka fa visita alle apprendiste e tutte insieme vanno ad Hokkaidō per trovare le calendule magiche che possano curare le eruzioni cutanee di Hanna. Arrivate, si imbattono nel padre di Doremì che pesca con una donna sconosciuta.","language":"it-IT"},"airDateText":{"value":"2000-08-13","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/d9J5y8EcbSUrD4QXxzR0x412vXs.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/d9J5y8EcbSUrD4QXxzR0x412vXs.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/20353/season/2/episode/27"},{"id":"582512","seasonNumber":2,"episodeNumber":28,"title":{"value":"Attenti al mago","language":"it-IT"},"overview":{"value":"Alexander si intrufola nella sede degli esami medici e tenta un'altra volta di rapire Hanna.","language":"it-IT"},"airDateText":{"value":"2000-08-20","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/onRpouKq5VgY6Qzm8i83Cnyo2iY.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/onRpouKq5VgY6Qzm8i83Cnyo2iY.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/20353/season/2/episode/28"},{"id":"582513","seasonNumber":2,"episodeNumber":29,"title":{"value":"Terrore al tempio","language":"it-IT"},"overview":{"value":"Come lo scorso anno, la classe di Doremì e le altre si reca al tempio di Nobuaki per mettere alla prova il loro coraggio.","language":"it-IT"},"airDateText":{"value":"2000-08-27","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/lrGHR8ORMIoN5thggfpDZBWmjJt.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/lrGHR8ORMIoN5thggfpDZBWmjJt.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/20353/season/2/episode/29"},{"id":"582514","seasonNumber":2,"episodeNumber":30,"title":{"value":"La maestra innamorata","language":"it-IT"},"overview":{"value":"Durante le vacanze estive, la signorina Seki ha trovato un fidanzato. Doremì e le altre raccolgono informazioni su che tipo di persona potrebbe essere.","language":"it-IT"},"airDateText":{"value":"2000-09-03","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/AgRweedmQYHR7aqaZwPKuBOG6Cu.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/AgRweedmQYHR7aqaZwPKuBOG6Cu.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/20353/season/2/episode/30"},{"id":"582516","seasonNumber":2,"episodeNumber":31,"title":{"value":"Arrivano i rinforzi","language":"it-IT"},"overview":{"value":"Fujio, Leon e Tooru, tre giovani maghi, raggiungono Akatsuki sulla Terra per aiutarlo nella missione di rapire la piccola Hanna. I quattro sono conosciuti come i FLAT 4. Nel frattempo le apprendiste portano Hanna alla sua settima visita pediatrica.","language":"it-IT"},"airDateText":{"value":"2000-09-10","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/t9DZyTr0viKkwJ09ze7EpKMOFqL.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/t9DZyTr0viKkwJ09ze7EpKMOFqL.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/20353/season/2/episode/31"},{"id":"582498","seasonNumber":2,"episodeNumber":32,"title":{"value":"La trasformazione delle fatine","language":"it-IT"},"overview":{"value":"Dodò e le altre fatine scoprono che possono entrare nel computer magico donato loro dalla Regina e assumere una forma più matura. Intanto i FLAT 4 riescono con successo nella missione di rapire la piccola Hanna, mettendo da parte Alexander.","language":"it-IT"},"airDateText":{"value":"2000-09-17","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/6i9zw1Zynk0iDYee8vEpiB0EoVw.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/6i9zw1Zynk0iDYee8vEpiB0EoVw.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/20353/season/2/episode/32"},{"id":"582518","seasonNumber":2,"episodeNumber":33,"title":{"value":"L'occhio implacabile","language":"it-IT"},"overview":{"value":"Le ragazze e i loro compagni di scuola partono in gita. Kaori si incarica di scattare foto, ma si fa prendere dalla mano e comincia a fare foto imbarazzanti a tutti, scatenando polemiche.","language":"it-IT"},"airDateText":{"value":"2000-10-01","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/8BW7LTnsQVK118qjk6ODwKlA6Di.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/8BW7LTnsQVK118qjk6ODwKlA6Di.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/20353/season/2/episode/33"},{"id":"582520","seasonNumber":2,"episodeNumber":34,"title":{"value":"La ricetta dell'amicizia","language":"it-IT"},"overview":{"value":"Lullaby e Sinfony litigano, perché quest'ultima fraintende l'importanza dei sentimenti della idol.","language":"it-IT"},"airDateText":{"value":"2000-10-08","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/vWWPVzDA5wDoXyaY5H4CJgdS4pY.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/vWWPVzDA5wDoXyaY5H4CJgdS4pY.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/20353/season/2/episode/34"},{"id":"582521","seasonNumber":2,"episodeNumber":35,"title":{"value":"Il saggio","language":"it-IT"},"overview":{"value":"I bambini della scuola materna si preparano per il festival dello sport. Durante le prove, Kimitaka non sembra voglia collaborare.","language":"it-IT"},"airDateText":{"value":"2000-10-15","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/twyp2vESqS1DAPKnkDBCtzYZfm.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/twyp2vESqS1DAPKnkDBCtzYZfm.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/20353/season/2/episode/35"},{"id":"582522","seasonNumber":2,"episodeNumber":36,"title":{"value":"La sfida","language":"it-IT"},"overview":{"value":"L'atletico Leon dei FLAT 4 sfida Sinfony in ogni genere di sport, tuttavia perdendo sempre. Hanna, intanto, cerca di catturare una libellula.","language":"it-IT"},"airDateText":{"value":"2000-10-22","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/8vqROu4ITj0COueqmEgl8aj9sNF.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/8vqROu4ITj0COueqmEgl8aj9sNF.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/20353/season/2/episode/36"},{"id":"582523","seasonNumber":2,"episodeNumber":37,"title":{"value":"L'esame di Bibì","language":"it-IT"},"overview":{"value":"La prossima visita medica di Hanna è lo stesso giorno dell'esame di quarto livello di Bibì. I poteri della piccola influenzano la prova.","language":"it-IT"},"airDateText":{"value":"2000-10-29","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/x0DBP6GD2CRIE87UKxiZAIK0phT.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/x0DBP6GD2CRIE87UKxiZAIK0phT.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/20353/season/2/episode/37"},{"id":"582526","seasonNumber":2,"episodeNumber":38,"title":{"value":"La prova di regia","language":"it-IT"},"overview":{"value":"Melody viene scelta come regista della recita scolastica, ma ha difficoltà a prendere decisioni e accontentare le richieste dei compagni.","language":"it-IT"},"airDateText":{"value":"2000-11-12","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/vshvBe49HvCI9zO7wNNVAjtkFz3.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/vshvBe49HvCI9zO7wNNVAjtkFz3.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/20353/season/2/episode/38"},{"id":"582528","seasonNumber":2,"episodeNumber":39,"title":{"value":"Un attore capriccioso","language":"it-IT"},"overview":{"value":"Dopo l'ultima visita pediatrica di Hanna, Doremì, Melody e Sinfony vanno a Kyoto per assistere alle riprese del film di Lullaby. Il bambino che interpreta il fratello di quest'ultima, Chikara, è geloso del fatto che la ragazza passi tutto il suo tempo libero con le amiche.","language":"it-IT"},"airDateText":{"value":"2000-11-19","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/rahX75nTQxJwVO8Lx17ABD076Xn.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/rahX75nTQxJwVO8Lx17ABD076Xn.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/20353/season/2/episode/39"},{"id":"582529","seasonNumber":2,"episodeNumber":40,"title":{"value":"Lezioni di piano","language":"it-IT"},"overview":{"value":"Bibì chiede a sua madre Haruka di insegnarle a suonare il pianoforte.","language":"it-IT"},"airDateText":{"value":"2000-11-26","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/lhjk8UVp9EMstU865InGrn3IAlE.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/lhjk8UVp9EMstU865InGrn3IAlE.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/20353/season/2/episode/40"},{"id":"582502","seasonNumber":2,"episodeNumber":41,"title":{"value":"Hanna diventa una star","language":"it-IT"},"overview":{"value":"Tooru prova a diventare una star come Lullaby, ma fallisce ogni volta. Intanto Alexander tenta di rapire Hanna un'altra volta.","language":"it-IT"},"airDateText":{"value":"2000-12-03","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/gszmCFm83eq9QHkNWXs6EAFdjlr.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/gszmCFm83eq9QHkNWXs6EAFdjlr.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/20353/season/2/episode/41"},{"id":"582532","seasonNumber":2,"episodeNumber":42,"title":{"value":"La strega che non voleva usare i suoi poteri","language":"it-IT"},"overview":{"value":"Viene rivelato che la dottoressa Maia ha una figlia adottiva, Majo Ran, la quale rifiuta di usare i suoi poteri.","language":"it-IT"},"airDateText":{"value":"2000-12-10","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/ax4rvbF2FhGT9k4sGLI3C8fnCE1.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/ax4rvbF2FhGT9k4sGLI3C8fnCE1.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/20353/season/2/episode/42"},{"id":"582533","seasonNumber":2,"episodeNumber":43,"title":{"value":"Una giornata a scuola","language":"it-IT"},"overview":{"value":"Visto che Raganella e Lala sono malate per occuparsene, le ragazze decidono di portare Hanna a scuola con loro.","language":"it-IT"},"airDateText":{"value":"2000-12-17","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/4wg7Phn9xw4Fkv3OEnMj0YTAkF0.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/4wg7Phn9xw4Fkv3OEnMj0YTAkF0.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/20353/season/2/episode/43"},{"id":"582535","seasonNumber":2,"episodeNumber":44,"title":{"value":"Buon Natale","language":"it-IT"},"overview":{"value":"Le ragazze trascorrono la vigilia di Natale con le loro famiglie, tra momenti di gioia e di tristezza.","language":"it-IT"},"airDateText":{"value":"2000-12-24","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/A92ErNRXJ2ltnwZnVu7EhgqOCjF.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/A92ErNRXJ2ltnwZnVu7EhgqOCjF.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/20353/season/2/episode/44"},{"id":"582537","seasonNumber":2,"episodeNumber":45,"title":{"value":"Viaggio nella storia","language":"it-IT"},"overview":{"value":"Le apprendiste entrano all'interno di un libro di storia, nel quale interpretano persone importanti del tempo.","language":"it-IT"},"airDateText":{"value":"2000-12-31","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/qKebMRGUuFOtq2U5W9jwHjBsMba.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/qKebMRGUuFOtq2U5W9jwHjBsMba.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/20353/season/2/episode/45"},{"id":"582538","seasonNumber":2,"episodeNumber":46,"title":{"value":"L'ultima visita","language":"it-IT"},"overview":{"value":"Durante l'ultima visita pediatrica di Hanna, i FLAT 4 rapiscono a malincuore le apprendiste.","language":"it-IT"},"airDateText":{"value":"2001-01-07","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/gN8FLM9EVC51wGkF54oV99223rZ.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/gN8FLM9EVC51wGkF54oV99223rZ.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/20353/season/2/episode/46"},{"id":"582539","seasonNumber":2,"episodeNumber":47,"title":{"value":"Un conflitto da scongiurare","language":"it-IT"},"overview":{"value":"Le apprendiste si scontrano per la piccola Hanna con Alexander e il conte Phillipe del Regno dei Maghi.","language":"it-IT"},"airDateText":{"value":"2001-01-14","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/811Hj2kv6qYcWae3Ld78b4wQPn1.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/811Hj2kv6qYcWae3Ld78b4wQPn1.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/20353/season/2/episode/47"},{"id":"582511","seasonNumber":2,"episodeNumber":48,"title":{"value":"Il pericolo incombe","language":"it-IT"},"overview":{"value":"L'ex Regina delle Streghe lancia una maledizione su Hanna, procurandole gravi problemi. Per farla guarire, le apprendiste devono cogliere il Fiore Rosso del Sommo Amore, altrimenti morirà.","language":"it-IT"},"airDateText":{"value":"2001-01-21","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/ue2AtdHo8Yd5SBCw1lURbH2MIUR.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/ue2AtdHo8Yd5SBCw1lURbH2MIUR.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/20353/season/2/episode/48"},{"id":"582671","seasonNumber":2,"episodeNumber":49,"title":{"value":"La missione","language":"it-IT"},"overview":{"value":"Le quattro apprendiste streghe si addentrano nella Foresta Pietrificata per recuperare il fiore in grado di curare Hanna, ma l'ex Regina delle Streghe usa ogni mezzo per fermarle. Trovato il fiore, la piccola è salva, ma Doremì e le altre cadono in un sonno lungo 1000 anni. L'ex Regina, colpita dall'amore tra le bambine e Hanna, però, decide di risvegliarle; tuttavia, avendo rotto i loro Cristalli Fatati cercando di salvare la piccola, Doremì e le sue amiche devono dire di nuovo addio al sogno di diventare streghe e si vedono costrette a separarsi da Hanna.","language":"it-IT"},"airDateText":{"value":"2001-01-28","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/uAoh5snSBRG1mRvQWaZywRJg4kl.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/uAoh5snSBRG1mRvQWaZywRJg4kl.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/20353/season/2/episode/49"}],"sourceUrl":"https://www.themoviedb.org/tv/20353/season/2"},"failure":null,"fields":{},"episodes":{"1":{"checkedAt":1793475916140,"status":"ok","retryCount":0},"2":{"checkedAt":1793475916140,"status":"ok","retryCount":0},"3":{"checkedAt":1793475916140,"status":"ok","retryCount":0},"4":{"checkedAt":1793475916140,"status":"ok","retryCount":0},"5":{"checkedAt":1793475916140,"status":"ok","retryCount":0},"6":{"checkedAt":1793475916140,"status":"ok","retryCount":0},"7":{"checkedAt":1793475916140,"status":"ok","retryCount":0},"8":{"checkedAt":1793475916140,"status":"ok","retryCount":0},"9":{"checkedAt":1793475916140,"status":"ok","retryCount":0},"10":{"checkedAt":1793475916140,"status":"ok","retryCount":0},"11":{"checkedAt":1793475916140,"status":"ok","retryCount":0},"12":{"checkedAt":1793475916140,"status":"ok","retryCount":0},"13":{"checkedAt":1793475916140,"status":"ok","retryCount":0},"14":{"checkedAt":1793475916140,"status":"ok","retryCount":0},"15":{"checkedAt":1793475916140,"status":"ok","retryCount":0},"16":{"checkedAt":1793475916140,"status":"ok","retryCount":0},"17":{"checkedAt":1793475916140,"status":"ok","retryCount":0},"18":{"checkedAt":1793475916140,"status":"ok","retryCount":0},"19":{"checkedAt":1793475916140,"status":"ok","re