":25,"thumbnail":"https://image.tmdb.org/t/p/w300/62L7sUi0oLY387Ml2UNJLS6izwc.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/62L7sUi0oLY387Ml2UNJLS6izwc.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/34678/season/1/episode/14"},{"id":"789922","seasonNumber":1,"episodeNumber":15,"title":{"value":"Episodio 15","language":"it-IT"},"overview":{"value":"The members of Team Basquash arrive at the Skybloom Kingdom, but before their departure to the moon, Dan is arrested for violating the local rules and after James and co. exaust all diplomatic measures to release him, they come with a plan to break him free by force.","language":"en-US"},"airDateText":{"value":"2009-07-10","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/tni5fNsth5Uxvpq7zEz9lv45qKH.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/tni5fNsth5Uxvpq7zEz9lv45qKH.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/34678/season/1/episode/15"},{"id":"789923","seasonNumber":1,"episodeNumber":16,"title":{"value":"Episodio 16","language":"it-IT"},"overview":{"value":"After reaching moon's orbit, Dan and friends's vessel is unexpectedly thrown back to Earth Dash's surface near a hostile underground settlement where Dan is captured and forced to fight in a bloody arena.","language":"en-US"},"airDateText":{"value":"2009-07-16","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/tObeoo4MiTMzZpEvV8CqKwIu8pj.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/tObeoo4MiTMzZpEvV8CqKwIu8pj.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/34678/season/1/episode/16"},{"id":"789924","seasonNumber":1,"episodeNumber":17,"title":{"value":"Episodio 17","language":"it-IT"},"overview":{"value":"Dan's friends learn that there is a bounty on his head and rush to warn him, while he meets Naviga, a lone giant from the moon who works in the underground mine.","language":"en-US"},"airDateText":{"value":"2009-07-23","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/hmnV0l6lNoaOFQRDMkk5BsT0YQS.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/hmnV0l6lNoaOFQRDMkk5BsT0YQS.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/34678/season/1/episode/17"},{"id":"789925","seasonNumber":1,"episodeNumber":18,"title":{"value":"Episodio 18","language":"it-IT"},"overview":{"value":"Dan and co. manage to reach the surface, but Iceman stays behind to confront the man who severed his left limbs. Reunited with Soichi and Haruka, and having Navi as a new companion, Team Basquash is later contacted by James who offers them a chance to win another ticket to the moon.","language":"en-US"},"airDateText":{"value":"2009-07-30","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/6PVepKuyPM8FdxtB4xM9a3JTbu2.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/6PVepKuyPM8FdxtB4xM9a3JTbu2.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/34678/season/1/episode/18"},{"id":"789926","seasonNumber":1,"episodeNumber":19,"title":{"value":"Episodio 19","language":"it-IT"},"overview":{"value":"Team Basquash returns to Turbine Town for the special match organized by James and their opponents happen to be some old acquaintances of Sela. Meanwhile Coco, who is already at the moon, reminisces about her brother's journey so far and figures out the truth about Slash.","language":"en-US"},"airDateText":{"value":"2009-08-06","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/5OzCwA4ce5bPts7HDvAW6AcketB.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/5OzCwA4ce5bPts7HDvAW6AcketB.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/34678/season/1/episode/19"},{"id":"789929","seasonNumber":1,"episodeNumber":20,"title":{"value":"Episodio 20","langua