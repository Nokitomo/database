db.org/tv/30980/season/2/episode/16"},{"id":"749503","seasonNumber":2,"episodeNumber":17,"title":{"value":"Episodio 17","language":"it-IT"},"overview":{"value":"Mikoto convinces Toma to sign up for a couples cell phone contract with her so she can get an adorable promotional item—but how far are the two willing to take the ruse before they get, well, maybe a little too close.","language":"en-US"},"airDateText":{"value":"2011-02-04","language":"it-IT"},"runtimeMinutes":25,"rating":5,"thumbnail":"https://image.tmdb.org/t/p/w300/xjvMmX1aIVZuW8nHnDWPfuXcPGx.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/xjvMmX1aIVZuW8nHnDWPfuXcPGx.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/30980/season/2/episode/17"},{"id":"749502","seasonNumber":2,"episodeNumber":18,"title":{"value":"Episodio 18","language":"it-IT"},"overview":{"value":"Laura is confronted with a confidential memo during her bath time, Toma buys Mikasa 10032 a piece of jewelry, and many old enemies come together in the search for Last Order.","language":"en-US"},"airDateText":{"value":"2011-02-11","language":"it-IT"},"runtimeMinutes":25,"rating":5,"thumbnail":"https://image.tmdb.org/t/p/w300/sdx0F5p05XzL1IE3cNGeWQRDFyp.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/sdx0F5p05XzL1IE3cNGeWQRDFyp.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/30980/season/2/episode/18"},{"id":"749504","seasonNumber":2,"episodeNumber":19,"title":{"value":"Episodio 19","language":"it-IT"},"overview":{"value":"Accelerator attempts to make amends for his past by doing a few good deeds, but ends up attacked by a group led by someone from his past. Meanwhile, Toma discovers strange goings-ons in the police force and overhears talk of an intruder in Academy City.","language":"en-US"},"airDateText":{"value":"2011-02-18","language":"it-IT"},"runtimeMinutes":25,"rating":4.5,"thumbnail":"https://image.tmdb.org/t/p/w300/u6CwqAyJIfL5PjXNp0zmE7rtIVs.jpg","sti