thumbnail":"https://image.tmdb.org/t/p/w300/mcLBDxFpCyp1xGHCdrUMnHTh4D2.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/mcLBDxFpCyp1xGHCdrUMnHTh4D2.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/30980/season/2/episode/8"},{"id":"749495","seasonNumber":2,"episodeNumber":9,"title":{"value":"Episodio 9","language":"it-IT"},"overview":{"value":"As Toma and his group try to track down Oriana, they discover that a “Shorthand”—a specialized spell that operates on its own once being cast—is shorting out their magic. But before they can deactivate it, an incident happens at the middle school.","language":"en-US"},"airDateText":{"value":"2010-12-03","language":"it-IT"},"runtimeMinutes":25,"rating":6,"thumbnail":"https://image.tmdb.org/t/p/w300/6xSgpZaZJUQV16oyN0ZUrs8p6My.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/6xSgpZaZJUQV16oyN0ZUrs8p6My.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/30980/season/2/episode/9"},{"id":"749494","seasonNumber":2,"episodeNumber":10,"title":{"value":"Episodio 10","language":"it-IT"},"overview":{"value":"With the Shorthand cancelled, Stiyl uses his magic to locate Oriana, causing a fight to erupt. In London, Laura learns that Oriana’s deal might not be for the Stab Sword, but for something else entirely.","language":"en-US"},"airDateText":{"value":"2010-12-10","language":"it-IT"},"runtimeMinutes":25,"rating":6,"thumbnail":"https://image.tmdb.org/t/p/w300/gmakXNFnRZkG5njXLWhyRDdj9OH.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/gmakXNFnRZkG5njXLWhyRDdj9OH.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/30980/season/2/episode/10"},{"id":"749496","seasonNumber":2,"episodeNumber":11,"title":{"value":"Episodio 11","language":"it-IT"},"overview":{"value":"Tsuchimikado’s location spell backfires and leads Oriana straight to him, resulting an epic showdown. But he’s not the only one exposed to Oriana’s magic: Himegami feels the force of the spell caster’s power, and may not survive.","language":"en-US"},"airDateText":{"value":"2010-12-17","language":"it-IT"},"runtimeMinutes":25,"rating":5,"thumbnail":"https://image.tmdb.org/t/p/w300/6tlgpEE7Gc7eGVqXweRNC5Hjm3w.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/6tlgpEE7Gc7eGVqXweRNC5Hjm3w.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/30980/season/2/episode/11"},{"id":"749497","seasonNumber":2,"episodeNumber":12,"title":{"value":"Episodio 12","language":"it-IT"},"overview":{"value":"Toma and Tsuchimikado investigate the history of a sacred artifact as they try to figure out what Oriana’s plan is. When they discover they have only until nightfall to stop her from enacting an evil plot, the battle for the future of Academy City begins!","language":"en-US"},"airDateText":{"value":"2010-12-24","language":"it-IT"},"runtimeMinutes":25,"rating":4.5,"thumbnail":"https://image.tmdb.org/t/p/w300/ud5XJdGYsbFIVqAmQkkozFMB0hW.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/ud5XJdGYsbFIVqAmQkkozFMB0hW.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/30980/season/2/episode/12"},{"id":"749499","seasonNumber":2,"episodeNumber":13,"title":{"value":"Episodio 13","language":"it-IT"},"overview":{"value":"As Toma and the others come close to beating Oriana, the motivations behind her actions are finally revealed. But taking out Oriana might not be enough to stop her plot from reaching a catastrophic completion!","language":"en-US"},"airDateText":{"value":"2011-01-07","language":"it-IT"},"runtimeMinutes":25,"rating":4.5,"thumbnail":"https://image.tmdb.org/t/p/w300/5SgEu9GnzDlu3Za66umGAo8Ol8I.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/5SgEu9GnzDlu3Za66umGAo8Ol8I.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/30980/season/2/episode/13"},{"id":"749498","seasonNumber":2,"episodeNumber":14,"title":{"value":"Episodio 14","l