uage":"it-IT"},"runtimeMinutes":24,"rating":10,"thumbnail":"https://image.tmdb.org/t/p/w300/bO9Qh9ytltsMO4thosIwqvRVpmA.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/bO9Qh9ytltsMO4thosIwqvRVpmA.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/60667/season/1/episode/19"},{"id":"1385973","seasonNumber":1,"episodeNumber":20,"title":{"value":"Episodio 20","language":"it-IT"},"overview":{"value":"Fellini faces Aila in the quarterfinals, much to Sei and Reiji's shock as they finally discover her real identity. Aila is pressured to win the championship due to the arrival of the Team Nemesis Chairman, who has promised the trophy to his grandson for his birthday.","language":"en-US"},"airDateText":{"value":"2014-02-24","language":"it-IT"},"runtimeMinutes":24,"rating":10,"thumbnail":"https://image.tmdb.org/t/p/w300/oX2kiGHc5zYIG54aXo9vJqqvGW5.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/oX2kiGHc5zYIG54aXo9vJqqvGW5.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/60667/season/1/episode/20"},{"id":"1385974","seasonNumber":1,"episodeNumber":21,"title":{"value":"Episodio 21","language":"it-IT"},"overview":{"value":"Following Aila's revelation as a Gunpla Fighter, an angry Reiji vows to defeat her in the tournament.","language":"en-US"},"airDateText":{"value":"2014-03-03","language":"it-IT"},"runtimeMinutes":24,"rating":10,"thumbnail":"https://image.tmdb.org/t/p/w300/l3IOtj75Y8PNWkaRiIuDnzpDNe2.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/l3IOtj75Y8PNWkaRiIuDnzpDNe2.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/60667/season/1/episode/21"},{"id":"1385975","seasonNumber":1,"episodeNumber":22,"title":{"value":"Episodio 22","language":"it-IT"},"overview":{"value":"Yuuki must prove himself worthy of the name \"Meijin Kawaguchi the 3rd\" when he battles Julian Ayers Mackenzie, a British Gunpla Fighter who was to have taken that title three years prior.","language":"en-US"},"airDateText":{"value":"2014-03-10","language":"it-IT"},"runtimeMinutes":24,"rating":10,"thumbnail":"https://image.tmdb.org/t/p/w300/vvWFuYBAImYTeXxQhtqg2CwuH1K.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/vvWFuYBAImYTeXxQhtqg2CwuH1K.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/60667/season/1/episode/22"},{"id":"1385976","seasonNumber":1,"episodeNumber":23,"title":{"value":"Episodio 23","language":"it-IT"},"overview":{"value":"A festival is held in Shizuoka one week before the final round of the tournament, where guests can participate in Free Battle rounds against the championship's competitors. Meanwhile, Nils and Caroline follow a truck that leads them to the source of Plavsky particles.","language":"en-US"},"airDateText":{"value":"2014-03-17","language":"it-IT"},"runtimeMinutes":24,"rating":10,"thumbnail":"https://image.tmdb.org/t/p/w300/kcyaoOnAWAEjvTYRnSHnVuL92X4.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/kcyaoOnAWAEjvTYRnSHnVuL92X4.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/60667/season/1/episode/23"},{"id":"1385977","seasonNumber":1,"episodeNumber":24,"title":{"value":"Episodio 24","language":"it-IT"},"overview":{"value":"In the final round of the tournament, Meijin Kawaguchi the 3rd unveils the true form of his Gundam Amazing Exia. However, he brings forth a disturbing aura in the arena reminiscent of his predecessor.","language":"en-US"},"airDateText":{"value":"2014-03-24","language":"it-IT"},"runtimeMinutes":24,"rating":10,"thumbnail":"https://image.tmdb.org/t/p/w300/zHZgM119GP5u5WtoQxd6NcWtASd.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/zHZgM119GP5u5WtoQxd6NcWtASd.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/60667/season/1/episode/24"},{"id":"1385978","seasonNumber":1,"episodeNumber":25,"title":{"value":"Episodio 25","language":"it-IT"},"overview":{"value":"Sei and Reiji's vict