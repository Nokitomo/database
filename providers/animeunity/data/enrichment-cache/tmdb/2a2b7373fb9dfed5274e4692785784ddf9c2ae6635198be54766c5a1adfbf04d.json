ge.tmdb.org/t/p/w300/rQoSWeqD54Xu6qrlC4DD8SfXy44.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/rQoSWeqD54Xu6qrlC4DD8SfXy44.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/68586/season/1/episode/24"},{"id":"1473493","seasonNumber":1,"episodeNumber":25,"title":{"value":"Muzan, il Generale demoniaco, attacca la scuola","language":"it-IT"},"overview":{"value":"Tired of his failures, Muxan decides to go face Devilman himself. All of Nakado Academy is held captive in an alternate dimension.","language":"en-US"},"airDateText":{"value":"1972-12-30","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/sPYxF4lk9GPAB3ChDumP9ki1Kgi.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/sPYxF4lk9GPAB3ChDumP9ki1Kgi.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/68586/season/1/episode/25"},{"id":"1473494","seasonNumber":1,"episodeNumber":26,"title":{"value":"Lala, il demone delle nevi","language":"it-IT"},"overview":{"value":"Akira is captured by Demons Dodo and Demon Lala during a ski trip. Dodo disguises himself as Akira and plans on killing all of his friends.","language":"en-US"},"airDateText":{"value":"1973-01-06","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/6FF9K9JMC86Ivcm10DZu7jTt6Jg.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/6FF9K9JMC86Ivcm10DZu7jTt6Jg.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/68586/season/1/episode/26"},{"id":"1473496","seasonNumber":1,"episodeNumber":27,"title":{"value":"Jewel, il demone dei desideri oltre ogni limite","language":"it-IT"},"overview":{"value":"Demon Lord Xenon places Demon Marshall Lacock in charge of operations. Meanwhile, Lala attempts to escape the insane asylum.","language":"en-US"},"airDateText":{"value":"1973-01-13","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/aWVgEWCuo1WgZKEgHrMiFGjTUVO.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/aWVgEWCuo1WgZKEgHrMiFGjTUVO.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/68586/season/1/episode/27"},{"id":"1473497","seasonNumber":1,"episodeNumber":28,"title":{"value":"Miniyon, il demone del medaglione diabolico","language":"it-IT"},"overview":{"value":"Lacock sends out her second servant, Miniyon to wreak havoc in the human world. He leaves his special pendant everywhere, which has the power to shrink anyone. Lala attempts to seduce Akira, much to his annoyance.","language":"en-US"},"airDateText":{"value":"1973-01-20","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/mD7nPG3VAOqqeMSqbgyq3XTJXv7.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/mD7nPG3VAOqqeMSqbgyq3XTJXv7.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/68586/season/1/episode/28"},{"id":"1473499","seasonNumber":1,"episodeNumber":29,"title":{"value":"Kenetos e il mistero delle collane","language":"it-IT"},"overview":{"value":"Demon Kenetos leaves behind his cursed necklaces all over Japan. Anyone who puts it on, has their head transported into his realm. Akira's teacher Alphonne falls victim to Kenetos' scheme.","language":"en-US"},"airDateText":{"value":"1973-01-27","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/bM9wBbIhN6PghhSEEigoQ46CiDW.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/bM9wBbIhN6PghhSEEigoQ46CiDW.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/68586/season/1/episode/29"},{"id":"1473501","seasonNumber":1,"episodeNumber":30,"title":{"value":"Faizel, il demone dell'ombra della follia","language":"it-IT"},"overview":{"value":"Demon Phizele has the ability to turn any human aggressive and violent. Miki, Lala, Tare, and Miyo have to fend off all the crazed humans while Devilman tries to find Phizele.","language":"en-US"},"airDateText":{"value":"1973-02-03","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/wB4qXxgbQrgnOeIlLf8V41EjysC.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/wB4qXxgbQrgnOeIlLf8V41EjysC.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/68586/season/1/episode/30"},{"id":"1473503","seasonNumber":1,"episodeNumber":31,"title":{"value":"Kilski, il demone del tornado rosso","language":"it-IT"},"overview":{"value":"Demon Kilskey is dispatched by Lacock to kill Lala. Kilskey later reworks his plan to use Lala to lure Devilman into a trap.","language":"en-US"},"airDateText":{"value":"1973-02-10","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/qyV81CfsOo5PLpuLL58eu9gWFZa.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/qyV81CfsOo5PLpuLL58eu9gWFZa.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/68586/season/1/episode/31"},{"id":"1473504","seasonNumber":1,"episodeNumber":32,"title":{"value":"Aurora, il demone della prigione brillante","language":"it-IT"},"overview":{"value":"Demon Marshall Lacock orders Lala's best friend, Aurora, to kill her.","language":"en-US"},"airDateText":{"value":"1973-02-17","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/gR8bBNLs1WJoHvxUDPPGGpn1f2k.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/gR8bBNLs1WJoHvxUDPPGGpn1f2k.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/68586/season/1/episode/32"},{"id":"1473505","seasonNumber":1,"episodeNumber":33,"title":{"value":"Weathers, il demone della rivolta del sole","language":"it-IT"},"overview":{"value":"Demon Weathers uses his powers of weather control to battle Devilman. Tare and Miyo attempt to save a dog named Hachi.","language":"en-US"},"airDateText":{"value":"1973-02-24","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/sU0eE4v74IrO9c6sjB6WMs3FsA4.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/sU0eE4v74IrO9c6sjB6WMs3FsA4.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/68586/season/1/episode/33"},{"id":"1473506","seasonNumber":1,"episodeNumber":34,"title":{"value":"Alron, il demone dall'abito spaventoso","language":"it-IT"},"overview":{"value":"Upset at the pain Devilman has caused the Demon Marshall, Alron dispatches to Japan to kill him. Meanwhile, Lala is frustrated with her own stupidity and tries to find a way to cure it. Akira mocks her, saying only death can fix that. Lala attempts to kill herself, ultimately throwing herself at battle with Alron.","language":"en-US"},"airDateText":{"value":"1973-03-03","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/ovMJ7i4rHJ6BWJUh1JXtPIWR3A9.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/ovMJ7i4rHJ6BWJUh1JXtPIWR3A9.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/68586/season/1/episode/34"},{"id":"1473507","seasonNumber":1,"episodeNumber":35,"title":{"value":"Il Maresciallo diabolico Reicock e la scuola congelata","language":"it-IT"},"overview":{"value":"Mourning the loss of Alron, Demon Marshall Lacock disobeys Xenon's orders and goes to confront Devilman. She uses her powers to slow down time in the city, leaving only Akira and Lala out of the trance. Together, they battle against Lacock.","language":"en-US"},"airDateText":{"value":"1973-03-10","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/xkhN6FGQJQVDpRpr7SZVBqZ4Ih2.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/xkhN6FGQJQVDpRpr7SZVBqZ4Ih2.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/68586/season/1/episode/35"},{"id":"1473508","seasonNumber":1,"episodeNumber":36,"title":{"value":"Magdora, il demone della lava volante","language":"it-IT"},"overview":{"value":"Lala is killed by Demon Magdler. Devilman fights him to get revenge.","language":"en-US"},"airDateText":{"value":"1973-03-17","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/xZ9SD6qtG4oWDSEdgULLRMxdaXN.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/xZ9SD6qtG4oWDSEdgULLRMxdaXN.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/68586/season/1/episode/36"},{"id":"1473509","seasonNumber":1,"episodeNumber":37,"title":{"value":"Wood-Do, il demone delle piante folli","language":"it-IT"},"overview":{"value":"Demon Wooddou controls trees to attack humanity. While battling against Wooddou, Akira transforms in front of Tare.","language":"en-US"},"airDateText":{"value":"1973-03-24","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/vbSc22uhy4cQzDfgEXBM4swfDzw.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/vbSc22uhy4cQzDfgEXBM4swfDzw.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/68586/season/1/episode/37"},{"id":"1473510","seasonNumber":1,"episodeNumber":38,"title":{"value":"Demone Dreamoon: la Luna è inferno","language":"it-IT"},"overview":{"value":"Demon Dremoon is using his powers to bring the Earth closer to the Moon. Devilman frantically searches for Dremoon before it's too late.","language":"en-US"},"airDateText":{"value":"1973-03-31","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/rp2txQdlQK4PlZCFHfUf3WRhfmc.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/rp2txQdlQK4PlZCFHfUf3WRhfmc.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/68586/season/1/episode/38"},{"id":"1473511","seasonNumber":1,"episodeNumber":39,"title":{"value":"God, il demone dei miracoli divini","language":"it-IT"},"overview":{"value":"A series of unexplained events have been occurring all over the world. Akira realizes the only person who has such power is Xenon's Captain of Guard: Demon God. God warns Akira 