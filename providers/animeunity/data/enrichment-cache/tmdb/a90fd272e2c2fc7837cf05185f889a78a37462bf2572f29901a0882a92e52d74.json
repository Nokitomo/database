wHp.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/23uuhqHuWjcuAZxOXYljitv2wHp.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/64710/season/2/episode/8"},{"id":"1148118","seasonNumber":2,"episodeNumber":9,"title":{"value":"Il suono di un filo che si spezza","language":"it-IT"},"overview":{"value":"Yato viene incaricato di svolgere un ultimo lavoro insieme a Nora: salvare un certo incantatore. Ma ogni minuto che passa, Hiyori si dimentica di Yato...","language":"it-IT"},"airDateText":{"value":"2015-11-28","language":"it-IT"},"runtimeMinutes":24,"rating":7.9,"thumbnail":"https://image.tmdb.org/t/p/w300/24SFLYEZ0s6ExCH3zIFDbSL9hUe.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/24SFLYEZ0s6ExCH3zIFDbSL9hUe.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/64710/season/2/episode/9"},{"id":"1148119","seasonNumber":2,"episodeNumber":10,"title":{"value":"Così sia fatto","language":"it-IT"},"overview":{"value":"I cieli vengono gettati nel caos quando gli dei scoprono che Ebisu ha dato nomi ai fantasmi. Nel frattempo, Yato ed Ebisu lottano per sfuggire a Izanami e lasciarsi alle spalle il mondo sotterraneo.","language":"it-IT"},"airDateText":{"value":"2015-12-05","language":"it-IT"},"runtimeMinutes":24,"rating":7.9,"thumbnail":"https://image.tmdb.org/t/p/w300/ldXWLzUIittOEX2Q9A7eQ6yBZEz.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/ldXWLzUIittOEX2Q9A7eQ6yBZEz.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/64710/season/2/episode/10"},{"id":"1148120","seasonNumber":2,"episodeNumber":11,"title":{"value":"Ritorno alla vita","language":"it-IT"},"overview":{"value":"Bishamon e Hiyori riescono a rintracciare Yato, ma non hanno modo di entrare nello Yomi. Nel frattempo, Izanami continua a inseguire Yato... e se venii catturato, rimarrebbe bloccato nello Yomi per sempre!","language":"it-IT"},"airDateText":{"value":"2015-12-12","language":"it-IT"},"runti