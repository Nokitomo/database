/w300/xVpQ5FCwk74Oq37WMnlpePZ9DNP.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/xVpQ5FCwk74Oq37WMnlpePZ9DNP.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/93830/season/1/episode/5"},{"id":"1948155","seasonNumber":1,"episodeNumber":6,"title":{"value":"Episodio 6","language":"it-IT"},"overview":{"value":"Ash reunites with Zeno and Echo on his way to the medical center to visit Matoi. He finds her well, but his relief is cut short when Gettemhult shows up out of nowhere.","language":"en-US"},"airDateText":{"value":"2019-11-11","language":"it-IT"},"runtimeMinutes":23,"thumbnail":"https://image.tmdb.org/t/p/w300/amAPPiIoSSHHVKoJwrcIIx1RnG3.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/amAPPiIoSSHHVKoJwrcIIx1RnG3.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/93830/season/1/episode/6"},{"id":"1948158","seasonNumber":1,"episodeNumber":7,"title":{"value":"Episodio 7","language":"it-IT"},"overview":{"value":"His revival successful, Dark Falz Elder assaults the Oracle fleet. Desperate to defend the fleet and the universe, ARKS takes a stand against his dreadful power.","language":"en-US"},"airDateText":{"value":"2019-11-18","language":"it-IT"},"runtimeMinutes":23,"thumbnail":"https://image.tmdb.org/t/p/w300/xcliHXdttAV91KCau5meGdgzPJF.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/xcliHXdttAV91KCau5meGdgzPJF.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/93830/season/1/episode/7"},{"id":"1948160","seasonNumber":1,"episodeNumber":8,"title":{"value":"Episodio 8","language":"it-IT"},"overview":{"value":"ARKS pays a great price in withstanding Elder's attack. As Theodor searches for Ulku, Echo fears for Zeno while pretending to remain strong. And distraught from losing Gettemhult, Melfonseana...","language":"en-US"},"airDateText":{"value":"2019-11-25","language":"it-IT"},"runtimeMinutes":23,"thumbnail":"https://image.tmdb.org/t/p/w300/vZQlRpC