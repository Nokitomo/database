,"thumbnail":"https://image.tmdb.org/t/p/w300/tvBp9MOHnsNuI5mrcDVXYEC7cM5.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/tvBp9MOHnsNuI5mrcDVXYEC7cM5.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/34109/season/3/episode/3"},{"id":"782053","seasonNumber":3,"episodeNumber":4,"title":{"value":"Il futuro combattente","language":"it-IT"},"overview":{"value":"When a mole named Mason Brown is located, Jake challenges him to a brawl! However, when Mason gets the upper hand Subterra master Julie must come to his rescue.","language":"en-US"},"airDateText":{"value":"2010-06-13","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/aEJAwNiYPwPdiyEnwtu6ZnJzD9J.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/aEJAwNiYPwPdiyEnwtu6ZnJzD9J.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/34109/season/3/episode/4"},{"id":"782057","seasonNumber":3,"episodeNumber":5,"title":{"value":"Scontro","language":"it-IT"},"overview":{"value":"Neathian moles begin kidnapping brawlers from Bakugan Interspace. Meanwhile, Sid and Zenet find it hard to recruit when Marucho puts out an anti-battle warning.","language":"en-US"},"airDateText":{"value":"2010-06-20","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/7RpdszF4lJO9IoxrOBJiIViibvi.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/7RpdszF4lJO9IoxrOBJiIViibvi.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/34109/season/3/episode/5"},{"id":"782054","seasonNumber":3,"episodeNumber":6,"title":{"value":"Allo scoperto","language":"it-IT"},"overview":{"value":"When an intruder alarm goes off in Bakugan Interspace, Dan, Jake, Marucho and Ren race to the scene to confront the invader.","language":"en-US"},"airDateText":{"value":"2010-06-27","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/gSfCyMNOSZVhXget9zWsF1e8bEt.jpg","stil