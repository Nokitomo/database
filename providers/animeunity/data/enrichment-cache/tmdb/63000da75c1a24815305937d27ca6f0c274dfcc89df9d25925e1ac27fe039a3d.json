iedb.org/tv/34109/season/3/episode/9"},{"id":"782048","seasonNumber":3,"episodeNumber":10,"title":{"value":"Fuga dall'oscurità","language":"it-IT"},"overview":{"value":"When Ren is under control of the whole Bakugan Interspace, Marucho comes up with a cunning plan to make things right. Can the Brawlers get there in time?","language":"en-US"},"airDateText":{"value":"2010-07-25","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/3gBw9MZPlWcN4Htx34kn7vg0AO4.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/3gBw9MZPlWcN4Htx34kn7vg0AO4.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/34109/season/3/episode/10"},{"id":"782043","seasonNumber":3,"episodeNumber":11,"title":{"value":"Il pacco segreto","language":"it-IT"},"overview":{"value":"As the Gundalians overwhelm Neathia with brainwashed brawlers, Linus Claude fails to deliver the Element to Fabia Sheen after losing both it and Neo to Jesse Glenn in battle.","language":"en-US"},"airDateText":{"value":"2010-08-01","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/1EGcnx7mKAvZyKXTIM0fDO7SMo8.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/1EGcnx7mKAvZyKXTIM0fDO7SMo8.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/34109/season/3/episode/11"},{"id":"782044","seasonNumber":3,"episodeNumber":12,"title":{"value":"L'elemento","language":"it-IT"},"overview":{"value":"While Dan’s group works to recover Neo, Sid Arkale seizes him in a bid for glory but ultimately loses him to Dan, allowing Drago to receive the Element and evolve into Lumino Dragonoid as Neo dies after completing his mission.","language":"en-US"},"airDateText":{"value":"2010-08-08","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/g3HInyLI9TkSb4h8AjSXeurWyKc.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/g3HInyLI9TkSb4h8AjSXeurWyKc.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/34109/season/3/episode/12"},{"id":"782045","seasonNumber":3,"episodeNumber":13,"title":{"value":"Gemelli malvagi","language":"it-IT"},"overview":{"value":"Given a brief pardon by Barodius after his earlier failure, Ren hatches a plot with Zenet to regain possession of the Element.","language":"en-US"},"airDateText":{"value":"2010-08-15","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/ujPb0TUs21W8WCcmiaVvrEwLssc.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/ujPb0TUs21W8WCcmiaVvrEwLssc.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/34109/season/3/episode/13"},{"id":"782037","seasonNumber":3,"episodeNumber":14,"title":{"value":"Il globo sacro","language":"it-IT"},"overview":{"value":"The Brawlers arrive at Neathia and meet Fabia's sister, Queen Serena; with her blessing, Fabia takes her new friends to see the Sacred Orb, a source of great power that is hidden deep inside a mountain.","language":"en-US"},"airDateText":{"value":"2010-08-22","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/lzBtmTWyfcl54MFSp2vB0713vy.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/lzBtmTWyfcl54MFSp2vB0713vy.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/34109/season/3/episode/14"},{"id":"782038","seasonNumber":3,"episodeNumber":15,"title":{"value":"L'esca","language":"it-IT"},"overview":{"value":"With only one remaining security shield protecting Neathia from the invading Gundalian forces, the Brawlers hatch a plan to reinstate a previously destroyed shield.","language":"en-US"},"airDateText":{"value":"2010-08-29","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/d3dGJdAl795Y1u4DsZuKu30ivYw.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/d3dGJdAl795Y1u4DsZuKu30ivYw.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/34109/season/3/episode/15"},{"id":"782039","seasonNumber":3,"episodeNumber":16,"title":{"value":"Lo scambio segreto","language":"it-IT"},"overview":{"value":"Dan, Fabia and Shun continue to make their way through the jungle to the shield generator building, when Stoica and Jesse suddenly ambush them.","language":"en-US"},"airDateText":{"value":"2010-09-05","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/3ixNhyNvUOTDmDg60rYsr1lzfiO.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/3ixNhyNvUOTDmDg60rYsr1lzfiO.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/34109/season/3/episode/16"},{"id":"782040","seasonNumber":3,"episodeNumber":17,"title":{"value":"Battaglia per il secondo scudo","language":"it-IT"},"overview":{"value":"Having made it to the Generator Building, Shun and Drago find themselves up against an army of Gundalian Guards, as they attempt to restart the Second Shield.","language":"en-US"},"airDateText":{"value":"2010-09-12","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/n51xH2d9hbVdGenInLUSQWmtqsP.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/n51xH2d9hbVdGenInLUSQWmtqsP.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/34109/season/3/episode/17"},{"id":"782041","seasonNumber":3,"episodeNumber":18,"title":{"value":"Chiamata alla ribalta","language":"it-IT"},"overview":{"value":"With the Second Shield back up and running, the Brawlers help the Neathians rebuild their strongholds; frustrated that they are losing momentum, Jake strikes out on his own in search of more Gundalians to fight.","language":"en-US"},"airDateText":{"value":"2010-09-19","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/pOEiVn27TGmn8bfUbjLvkeigXkP.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/pOEiVn27TGmn8bfUbjLvkeigXkP.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/34109/season/3/episode/18"},{"id":"782042","seasonNumber":3,"episodeNumber":19,"title":{"value":"Il segreto del globo sacro","language":"it-IT"},"overview":{"value":"When Mason flees from his Gundalian ship, Nurzak and Ren are quickly in pursuit as they attempt to apprehend him before the Emperor learns of his escape.","language":"en-US"},"airDateText":{"value":"2010-09-26","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/hMtvBBqqLNvGaWIRWqxcay3CUW1.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/hMtvBBqqLNvGaWIRWqxcay3CUW1.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/34109/season/3/episode/19"},{"id":"782049","seasonNumber":3,"episodeNumber":20,"title":{"value":"Compagni fino alla fine","language":"it-IT"},"overview":{"value":"Fearing for her life, Zenet morphs into a doppelgänger of Ren in order to accompany Gill on a mission to destroy the Second Shield.","language":"en-US"},"airDateText":{"value":"2010-10-03","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/wljmP9lmOovSDzsGFBCoMfvhkc5.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/wljmP9lmOovSDzsGFBCoMfvhkc5.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/34109/season/3/episode/20"},{"id":"782050","seasonNumber":3,"episodeNumber":21,"title":{"value":"Dividere per conquistare","language":"it-IT"},"overview":{"value":"On the eve of the revolt against Barodius, Nurzak sends a message to the Brawlers asking to meet and discuss a peace treaty. When the Brawlers show up for the meeting Nurzak is nowhere to be found.","language":"en-US"},"airDateText":{"value":"2010-10-02","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/o7Di3cuBAR6uz3sBm559tSc7yeu.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/o7Di3cuBAR6uz3sBm559tSc7yeu.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/34109/season/3/episode/21"},{"id":"782058","seasonNumber":3,"episodeNumber":22,"title":{"value":"Assalto mobile","language":"it-IT"},"overview":{"value":"While Kazarina works on a secret weapon designed to take down the restored Second Shield, the Gundalians dispatch their army of hypnotised Earth kids to distract the Brawlers in battle.","language":"en-US"},"airDateText":{"value":"2010-10-02","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/lOwhhd5SjOZUFYw1UGSJXdKmZ88.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/lOwhhd5SjOZUFYw1UGSJXdKmZ88.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/34109/season/3/episode/22"},{"id":"782059","seasonNumber":3,"episodeNumber":23,"title":{"value":"Il ritorno di Sid","language":"it-IT"},"overview":{"value":"As Ren prepares to launch an attack on the restored Second Shield, something strange is happening deep within the bowels of the Gundalian Palace.","language":"en-US"},"airDateText":{"value":"2010-10-02","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/yr7c6rcmmifof8nLa0R5qj7w1da.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/yr7c6rcmmifof8nLa0R5qj7w1da.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/34109/season/3/episode/23"},{"id":"782060","seasonNumber":3,"episodeNumber":24,"title":{"value":"Dharak Colossus","language":"it-IT"},"overview":{"value":"Once Kazarina finally completes the upgrades on Exokor, the Twelve Orders descend on Neathia to take down the restored Second Shield. Dan makes another plea to Ren to switch sides but is interrupted by Barodius who launches an all out assault with Colossus Dharak.","language":"en-US"},"airDateText":{"value":"2010-10-02","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/ypBeixYvWc09loOG7lf9hYkOc83.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/ypBeixYvWc09loOG7lf9hYkOc83.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/34109/season/3/episode/24"},{"id":"782061","seasonNumber":3,"episodeNumber":25,"title":{"value":"Il potere proibito","language":"it-IT"},"overview":{"value":"Ren's conflict of loyalty comes to a head when he decides to turn his back on Barodius. Furious at his betrayal, the Emperor challenges him to a battle and begins pummelling him.","language":"en-US"},"airDateText":{"value":"2010-10-09","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/qPlb5X3SPUhDYznY3QJkUu2cKaS.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/qPlb5X3SPUhDYznY3QJkUu2cKaS.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/34109/season/3/episode/25"},{"id":"782062","seasonNumber":3,"episodeNumber":26,"title":{"value":"Il perdono","language":"it-IT"},"overview":{"value":"When the Brawlers are transported back to the Royal Palace, Ren is nowhere to be found. They learn that the Third Shield has been outfitted with a Bio-Filter that prevents anyone with Gundalian DNA from passing through. When Dan asks Fabia to take the shield down and allow Ren to enter, she storms off in anger.","language":"en-US"},"airDateText":{"value":"2010-10-16","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/oKYra3ICJMRpfOP6077ZA980RWe.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/oKYra3ICJMRpfOP6077ZA980RWe.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/34109/season/3/episode/26"},{"id":"782063","seasonNumber":3,"episodeNumber":27,"title":{"value":"Nella tempesta","language":"it-IT"},"overview":{"value":"When a geomagnetic storm sweeps across Neathia, knocking out the security system's radar, the Brawlers are forced to patrol the perimeter of the Third Shield to watch for Gundalian attack ships.","language":"en-US"},"airDateText":{"value":"2010-10-23","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/pUFH6MGR7rTMxD2tIHLE3QS0Tpw.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/pUFH6MGR7rTMxD2tIHLE3QS0Tpw.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/34109/season/3/episode/27"},{"id":"782064","seasonNumber":3,"episodeNumber":28,"title":{"value":"Il ritorno di Jake","language":"it-IT"},"overview":{"value":"Distraught over the loss of Jake to the Gundalians, Dan tries to mount a rescue operation. As the other Brawlers attempt to talk him out of it, Jake appears. Claiming to have escaped Kazarina's clutches he is shaken up but seems okay. While Dan is overjoyed to see his friend, Shun remains suspicious.","language":"en-US"},"airDateText":{"value":"2010-10-30","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/mMHvR1G8kUYV5KEo3k56wa26ZzY.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/mMHvR1G8kUYV5KEo3k56wa26ZzY.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/34109/season/3/episode/28"},{"id":"782065","seasonNumber":3,"episodeNumber":29,"title":{"value":"Genesi","language":"it-IT"},"overview":{"value":"Desperate to rescue the still hypnotised Jake from the clutches of the enemy, Dan rallies the Brawlers to go after their pal. However their plans are foiled when Queen Serena stops them travelling to Gundalia.","language":"en-US"},"airDateText":{"value":"2010-11-06","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/aZVVko0UvF33nRmN82df4MOVFlP.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/aZVVko0UvF33nRmN82df4MOVFlP.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/34109/season/3/episode/29"},{"id":"782066","seasonNumber":3,"episodeNumber":30,"title":{"value":"Infiltrati","language":"it-IT"},"overview":{"value":"The Brawlers hitch a ride to Gundalia on Dragonoid Colossus. On arrival Ren announces that in addition to Jake, he would also like to rescue his former teammates who are being held captive in Kazarina's lab.","language":"en-US"},"airDateText":{"value":"2010-11-13","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/AkrprKeSBjLATCqqdM24zMQR0lz.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/AkrprKeSBjLATCqqdM24zMQR0lz.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/34109/season/3/episode/30"},{"id":"782067","seasonNumber":3,"episodeNumber":31,"title":{"value":"La vera evoluzione","language":"it-IT"},"overview":{"value":"After being separated from his teammates, Dan finds himself face to face with Barodius. They engage in a fearsome battle, and Drago quickly winds up losing. Perplexed as to why his new powers don't give him the winning edge, Dragonoid Colossus reveals to Drago that his true evolution has yet to happen.","language":"en-US"},"airDateText":{"value":"2010-11-20","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/jMC9kwSXD1DYr5YJ4ZrLbj7A34u.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/jMC9kwSXD1DYr5YJ4ZrLbj7A34u.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/34109/season/3/episode/31"},{"id":"782068","seasonNumber":3,"episodeNumber":32,"title":{"value":"La redenzione","language":"it-IT"},"overview":{"value":"After infiltrating Gundalian Castle, Nurzak and Fabia square off with Kazarina and Stoica; during the battle, a powerful attack causes the ground to collapse underneath them, sending Fabia and Nurzak spiraling down into the abyss.","language":"en-US"},"airDateText":{"value":"2010-11-27","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/774cQQmNxf72SotC4n3HlQh2wWk.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/774cQQmNxf72SotC4n3HlQh2wWk.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/34109/season/3/episode/32"},{"id":"782069","seasonNumber":3,"episodeNumber":33,"title":{"value":"I segreti del DNA","language":"it-IT"},"overview":{"value":"Marucho and Akwimos infiltrate a troop briefing and are surprised to discover that it is being led by Jake, who is telling the Gundalian forces the secret battle strategies of the Brawlers.","language":"en-US"},"airDateText":{"value":"2010-12-04","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/pawaWTJ9D9yrynqulvp2nkctwwx.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/pawaWTJ9D9yrynqulvp2nkctwwx.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/34109/season/3/episode/33"},{"id":"782070","seasonNumber":3,"episodeNumber":34,"title":{"value":"Colpo finale","language":"it-IT"},"overview":{"value":"The Brawlers regroup in a secret hideout left behind by Nurzak. When they learn of Dan's capture and Nurzak's apparent demise, they decide that they must strike immediately. As they make their way to Kazarina's lab, they run into one ambush after another and are forced to split up.","language":"en-US"},"airDateText":{"value":"2010-12-11","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/aU5z5vSX03Xs46Yjv8SGTwdaYO0.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/aU5z5vSX03Xs46Yjv8SGTwdaYO0.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/34109/season/3/episode/34"},{"id":"782071","seasonNumber":3,"episodeNumber":35,"title":{"value":"Fuga dal sogno","language":"it-IT"},"overview":{"value":"While under Kazarina's hypnotic spell, Dan and Jake are able to communicate on a subconscious level and manage to break her spell.","language":"en-US"},"airDateText":{"value":"2010-12-18","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/An57r218hhHBN44ioIsIXOQMnv1.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/An57r218hhHBN44ioIsIXOQMnv1.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/34109/season/3/episode/35"},{"id":"782072","seasonNumber":3,"episodeNumber":36,"title":{"value":"La resa dei conti Gundalian","language":"it-IT"},"overview":{"value":"Realising that Barodius has gone off to attack Neathia with the evolved Phantom Dharak, the Brawlers attempt to give chase. They are sidetracked when they are attacked by Kazarina and her teammates. After successfully dispatching Stoica, Airzel and Gill the Brawlers make a run for it, but Fabia stays behind to fight.","language":"en-US"},"airDateText":{"value":"2011-01-08","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/aNIwNBqINagAJByeE9Wwpy3t6Ii.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/aNIwNBqINagAJByeE9Wwpy3t6Ii.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/34109/season/3/episode/36"},{"id":"782073","seasonNumber":3,"episodeNumber":37,"title":{"value":"L'incantesimo spezzato","language":"it-IT"},"overview":{"value":"The battle between Fabia and Kazarina continues. When Nurzak and Mason show up Kazarina flees but is ambushed by Gill. When she is taken down during their fight, Kazarina's spell is broken and everyone under hypnosis returns to normal.harak begins.","language":"en-US"},"airDateText":{"value":"2011-01-15","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/cnXjNfzQGoBBYqhq66aZdU188oL.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/cnXjNfzQGoBBYqhq66aZdU188oL.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/34109/season/3/episode/37"},{"id":"782075","seasonNumber":3,"episodeNumber":38,"title":{"value":"Codice Eva","language":"it-IT"},"overview":{"value":"The final battle for possession of the Sacred Orb is underway. When Barodius splits off and makes a play for the Neathian Palace, Dan gives chase leaving the others behind to battle Dharak. Just as he catches up with the evil Emperor, Dan is hit by a giant blast of light.","language":"en-US"},"airDateText":{"value":"2011-01-22","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/47kffSXnm4gAihXWNM7DTXR1s6i.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/47kffSXnm4gAihXWNM7DTXR1s6i.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/34109/season/3/episode/38"},{"id":"782074","seasonNumber":3,"episodeNumber":39,"title":{"value":"Il destino svelato","language":"it-IT"},"overview":{"value":"Code Eve, transports Dan, Drago, Barodius and Dharak to a middle dimension so the final battle can be fought. The winner will not only be endowed with mighty powers, but will also be crowned the ruler of Bakugan.","language":"en-US"},"airDateText":{"value":"2011-01-29","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/5eB3VBnYTSkpt61F61DxaEcqkbt.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/5eB3VBnYTSkpt61F61DxaEcqkbt.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/34109/season/3/episode/39"}],"sourceUrl":"https://www.themoviedb.org/tv/34109/season/3"},"failure":null,"fields":{},"episodes":{"1":{"checkedAt":1793474964209,"status":"ok","retryCount":0},"2":{"checkedAt":1793474964209,"status":"ok","retryCount":0},"3":{"checkedAt":1793474964209,"status":"ok","retryCount":0},"4":{"checkedAt":1793474964209,"status":"ok","retryCount":0},"5":{"checkedAt":1793474964209,"status":"ok","retryCount":0},"6":{"checkedAt":1793474964209,"status":"ok","retryCount":0},"7":{"checkedAt":1793474964209,"status":"ok","retryCount":0},"8":{"checkedAt":1793474964209,"status":"ok","retryCount":0},"9":{"checkedAt":1793474964209,"status":"ok","retryCount":0},"10":{"checkedAt":1793474964209,"status":"ok","retryCount":0},"11":{"checkedAt":1793474964209,"status":"ok","retryCount":0},"12":{"checkedAt":1793474964209,"status":"ok","retryCount":0},"13":{"checkedAt":1793474964209,"status":"ok","