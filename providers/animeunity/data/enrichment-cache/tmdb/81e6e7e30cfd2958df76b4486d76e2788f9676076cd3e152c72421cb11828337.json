"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/f6vDD1YKbBwlTdSwZ8fMsuPeSnJ.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/f6vDD1YKbBwlTdSwZ8fMsuPeSnJ.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/278378/season/1/episode/35"},{"id":"6411146","seasonNumber":1,"episodeNumber":36,"title":{"value":"Episodio 36","language":"it-IT"},"overview":{"value":"After a discussion with everyone at the Idol Precure Research Club, Purirun suggests that they hold a concert, and Uta and the others agree. Tanaka books them a venue much larger than they expected!","language":"en-US"},"airDateText":{"value":"2025-10-12","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/nDbI3ykxyU50r6Ud80c294tARjC.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/nDbI3ykxyU50r6Ud80c294tARjC.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/278378/season/1/episode/36"},{"id":"6411147","seasonNumber":1,"episodeNumber":37,"title":{"value":"Episodio 37","language":"it-IT"},"overview":{"value":"Uta chases after Kaito who just passed by, but then she sees how sad he looks, murmuring the name “Kazuma.”","language":"en-US"},"airDateText":{"value":"2025-10-19","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/q4CArrZVB9d16ADUF1JZZXNYi3K.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/q4CArrZVB9d16ADUF1JZZXNYi3K.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/278378/season/1/episode/37"},{"id":"6411148","seasonNumber":1,"episodeNumber":38,"title":{"value":"Episodio 38","language":"it-IT"},"overview":{"value":"As Halloween approaches, Uta reveals that she is extremely frightened of ghosts. When they decide to enter the Hanamichi Town costume contest, Nana formulates a strategy to help Uta overcome her fears.","language":"en-US"},"airDateText":{"value":"2025-10-26","language":"it-IT"},"runtimeM