/90660/season/2/episode/21"},{"id":"5531370","seasonNumber":2,"episodeNumber":22,"title":{"value":"Wakatsuki","language":"it-IT"},"overview":{"value":"Le tanto attese semifinali hanno inizio. Yamashita riceve una visita inquietante dal presidente Nogi che esige di truccare lo scontro facendo vincere la Furumi Farmaceutici.","language":"it-IT"},"airDateText":{"value":"2024-08-15","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/a2AAzLPUO6VWcxOR1yDhpoQgdlw.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/a2AAzLPUO6VWcxOR1yDhpoQgdlw.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/90660/season/2/episode/22"},{"id":"5531372","seasonNumber":2,"episodeNumber":23,"title":{"value":"Dare il massimo","language":"it-IT"},"overview":{"value":"Mentre Yamashita scopre i suoi legami sorprendentemente profondi con l'Associazione Kengan e con il Gruppo Nogi, Ohma deve trovare un modo per battere Wakatsuki sul ring.","language":"it-IT"},"airDateText":{"value":"2024-08-15","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/w6jZckc3KtJDhFgLiuxRTqoVSNg.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/w6jZckc3KtJDhFgLiuxRTqoVSNg.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/90660/season/2/episode/23"},{"id":"5531374","seasonNumber":2,"episodeNumber":24,"title":{"value":"Forza suprema","language":"it-IT"},"overview":{"value":"Nella seconda semifinale così tanto attesa, i due titani delle arti marziali Kuroki e Kanoh si affrontano in uno scontro di forza suprema.","language":"it-IT"},"airDateText":{"value":"2024-08-15","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/pYiLbDarh9IN2qY27iq0NQp6i6Q.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/pYiLbDarh9IN2qY27iq0NQp6i6Q.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/90660/season/2/episode/24"},{"id":"553137