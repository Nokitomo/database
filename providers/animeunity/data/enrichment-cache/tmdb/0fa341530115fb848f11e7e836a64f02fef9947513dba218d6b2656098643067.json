/1/episode/45"},{"id":"4140630","seasonNumber":1,"episodeNumber":46,"title":{"value":"Episodio 46","language":"it-IT"},"overview":{"value":"Tanizaki, Miyazawa and Yosano head to the site where Yosano is scheduled to be handed off to the Port Mafia.","language":"en-US"},"airDateText":{"value":"2023-03-08","language":"it-IT"},"runtimeMinutes":24,"thumbnail":"https://image.tmdb.org/t/p/w300/8uhUxvbaenQuoMnyZ9uic52FQBm.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/8uhUxvbaenQuoMnyZ9uic52FQBm.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/65931/season/1/episode/46"},{"id":"4140631","seasonNumber":1,"episodeNumber":47,"title":{"value":"Episodio 47","language":"it-IT"},"overview":{"value":"Atsushi and Kyoka help Mushitaro escape. However, they get surrounded by the Bureau, led by Ango Sakaguchi.","language":"en-US"},"airDateText":{"value":"2023-03-15","language":"it-IT"},"runtimeMinutes":24,"rating":6,"thumbnail":"https://image.tmdb.org/t/p/w300/qes3Re6PBQtpOfhJNCtLP9uPn27.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/qes3Re6PBQtpOfhJNCtLP9uPn27.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/65931/season/1/episode/47"},{"id":"4140632","seasonNumber":1,"episodeNumber":48,"title":{"value":"Episodio 48","language":"it-IT"},"overview":{"value":"Suspecting that Lucy is cooperating with the terrorist organization known as the Armed Detective Agency,  Jouno and Tetchou pay a visit to the cafe at where she works, in hopes of tracking down Atsushi and Kyouka.","language":"en-US"},"airDateText":{"value":"2023-03-22","language":"it-IT"},"runtimeMinutes":24,"rating":8,"thumbnail":"https://image.tmdb.org/t/p/w300/b8TrlrIuwD24UaoCXGYZw4nME6l.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/b8TrlrIuwD24UaoCXGYZw4nME6l.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/65931/season/1/episode/48"},{"id":"4140633","seasonNumber":1,"episodeNumber":49,"title":{