{"schemaVersion":1,"source":"tmdb","kind":"episodes","input":{"mediaId":209707,"seasonNumber":1},"checkedAt":1793436070283,"status":"ok","retryCount":0,"value":{"seasonNumber":1,"name":{"value":"Stagione 1","language":"it-IT"},"year":2023,"episodeCount":12,"poster":"https://image.tmdb.org/t/p/original/oI7OrbdEcrTCz9BUOMT75lJRPmt.jpg","posters":[],"backgrounds":[],"episodes":[{"id":"3940111","seasonNumber":1,"episodeNumber":1,"title":{"value":"Episodio 1","language":"it-IT"},"overview":{"value":"Upon learning of his grandma's death, Hayato returns to the café she ran for the first time in years. He plans to shut it down, but finds five girls who formerly worked at Familia living there, and they're determined to save it from demolition...","language":"en-US"},"airDateText":{"value":"2023-04-08","language":"it-IT"},"runtimeMinutes":24,"rating":5.3,"thumbnail":"https://image.tmdb.org/t/p/w300/oFrRaGAq8R56QNy00dhacLlEZVp.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/oFrRaGAq8R56QNy00dhacLlEZVp.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/209707/season/1/episode/1"},{"id":"4350283","seasonNumber":1,"episodeNumber":2,"title":{"value":"Episodio 2","language":"it-IT"},"overview":{"value":"Hayato decides to reopen his late grandma's café. He begins cohabiting with the five girls who worked there part-time, but naturally, things get off to a rocky start in both the home and the business.","language":"en-US"},"airDateText":{"value":"2023-04-15","language":"it-IT"},"runtimeMinutes":24,"rating":5.1,"thumbnail":"https://image.tmdb.org/t/p/w300/d7t25qdND77VmzspH3QnEjjJFuh.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/d7t25qdND77VmzspH3QnEjjJFuh.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/209707/season/1/episode/2"},{"id":"4350284","seasonNumber":1,"episodeNumber":3,"title":{"value":"Episodio 3","language":"it-IT"},"overview":{"value":"As Familia is about to reopen, Riho tells Hayato that he needs to get along better with Ouka. He tries hard to make amends with her and repeatedly fails, but her reaction changes when he compliments the waitress uniforms she made...","language":"en-US"},"airDateText":{"value":"2023-04-22","language":"it-IT"},"runtimeMinutes":24,"rating":6.8,"thumbnail":"https://image.tmdb.org/t/p/w300/hWREG6v8T20IibwYgdhcEF7keN6.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/hWREG6v8T20IibwYgdhcEF7keN6.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/209707/season/1/episode/3"},{"id":"4350285","seasonNumber":1,"episodeNumber":4,"title":{"value":"Episodio 4","language":"it-IT"},"overview":{"value":"A week after Familia's reopening, business is slowing down, so Hayato decides to run a stall at the local Cherry Blossom Festival with new menu items for spring to attract new customers. Everything goes great until some guys try to hit on Ouka...","language":"en-US"},"airDateText":{"value":"2023-04-29","language":"it-IT"},"runtimeMinutes":24,"rating":6.8,"thumbnail":"https://image.tmdb.org/t/p/w300/d6cBNpp9uIZdZqFAiljObuWqvGe.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/d6cBNpp9uIZdZqFAiljObuWqvGe.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/209707/season/1/episode/4"},{"id":"4350286","seasonNumber":1,"episodeNumber":5,"title":{"value":"Episodio 5","language":"it-IT"},"overview":{"value":"Riho is working the café floor alone on busy days and planning promotions at night, leading Hayato to wonder if she's working too hard. Later, on the café's day off, Hayato happens to see Akane's band performing while he's buying supplies in town.","language":"en-US"},"airDateText":{"value":"2023-05-06","language":"it-IT"},"runtimeMinutes":24,"rating":4.9,"thumbnail":"https://image.tmdb.org/t/p/w300/kxVdB4xBY0uWLMvbEAMwP14N0Cw.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/kxVdB4xBY0uWLMvbEAMwP14N0Cw.jpg","language":"xx"}],"sourceUrl":