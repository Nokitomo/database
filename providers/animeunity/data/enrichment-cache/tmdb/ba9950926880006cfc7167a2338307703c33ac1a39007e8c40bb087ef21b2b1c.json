://image.tmdb.org/t/p/w300/sycA2lSQ3cq9mpCmgnMBKFaRbQN.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/sycA2lSQ3cq9mpCmgnMBKFaRbQN.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/209707/season/1/episode/8"},{"id":"4350290","seasonNumber":1,"episodeNumber":9,"title":{"value":"Episodio 9","language":"it-IT"},"overview":{"value":"Beach hut business is booming, and Hayato feels like the girls are finally communicating more openly with him. But then a TV crew shows up, and the director seems to know Riho, revealing a past she hadn't told any of the Familia gang about.","language":"en-US"},"airDateText":{"value":"2023-06-03","language":"it-IT"},"runtimeMinutes":24,"rating":7.6,"thumbnail":"https://image.tmdb.org/t/p/w300/uNef1BBahvrlRpfrLbiG4N2sNuk.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/uNef1BBahvrlRpfrLbiG4N2sNuk.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/209707/season/1/episode/9"},{"id":"4350291","seasonNumber":1,"episodeNumber":10,"title":{"value":"Episodio 10","language":"it-IT"},"overview":{"value":"Ami is being her usual goofy self when Ouka suddenly yells at her. It turns out \"Ouka\" was actually Ouka's twin sister, Kikka, and she proceeds to insult Familia and all six of its workers. It seems Ouka and Kikka have a complicated relationship...","language":"en-US"},"airDateText":{"value":"2023-06-10","language":"it-IT"},"runtimeMinutes":24,"rating":6.8,"thumbnail":"https://image.tmdb.org/t/p/w300/4jRg5xbqsr8inRfZzkHx2z2OlWi.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/4jRg5xbqsr8inRfZzkHx2z2OlWi.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/209707/season/1/episode/10"},{"id":"4350292","seasonNumber":1,"episodeNumber":11,"title":{"value":"Episodio 11","language":"it-IT"},"overview":{"value":"The Familia crew visits a bathhouse while their bathtub at home is broken. The wagashi shop owner happens to be there, and she a