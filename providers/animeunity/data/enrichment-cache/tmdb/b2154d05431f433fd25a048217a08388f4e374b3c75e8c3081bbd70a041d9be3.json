":"Akkai e Angry devono capire come prevalere sui formidabili fratelli Haitani.","language":"it-IT"},"airDateText":{"value":"2023-11-29","language":"it-IT"},"runtimeMinutes":24,"rating":7.8,"thumbnail":"https://image.tmdb.org/t/p/w300/hDBKQMg20ERIKQPqXJvzEGynzP3.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/hDBKQMg20ERIKQPqXJvzEGynzP3.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/105009/season/1/episode/46"},{"id":"4787134","seasonNumber":1,"episodeNumber":47,"title":{"value":"Cuore Impavido","language":"it-IT"},"overview":{"value":"Con uno scontro altalenante che sembra non finire mai, Kisaki interviene, ma Takemichi non demorde.","language":"it-IT"},"airDateText":{"value":"2023-12-06","language":"it-IT"},"runtimeMinutes":24,"rating":8.2,"thumbnail":"https://image.tmdb.org/t/p/w300/q4IVp5BSPpYx8u0IUnC2RrjwbtH.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/q4IVp5BSPpYx8u0IUnC2RrjwbtH.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/105009/season/1/episode/47"},{"id":"4787135","seasonNumber":1,"episodeNumber":48,"title":{"value":"Non Resta Nulla","language":"it-IT"},"overview":{"value":"Mikey e Draken si presentano al molo e inizia lo scontro tra Mikey e Izana.","language":"it-IT"},"airDateText":{"value":"2023-12-13","language":"it-IT"},"runtimeMinutes":24,"rating":7.5,"thumbnail":"https://image.tmdb.org/t/p/w300/rIVtmmExm6bkhTAAvvpmBturt2f.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/rIVtmmExm6bkhTAAvvpmBturt2f.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/105009/season/1/episode/48"},{"id":"4787137","seasonNumber":1,"episodeNumber":49,"title":{"value":"Paradiso Perduto","language":"it-IT"},"overview":{"value":"In preda alla disperazione, Izana adotta misure avventate e la situazione sfugge di mano.","language":"it-IT"},"airDateText":{"value":"2023-12-20","language":"it-IT"},"runtimeMinutes":24,"rating":7.8,"thumbnail":"https:/