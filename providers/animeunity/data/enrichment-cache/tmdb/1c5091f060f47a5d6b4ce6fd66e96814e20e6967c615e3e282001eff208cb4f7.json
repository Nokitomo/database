8j7m.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/691Ib12yQ9akWwBQuJdhLBq8j7m.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/68138/season/1/episode/3"},{"id":"1234720","seasonNumber":1,"episodeNumber":4,"title":{"value":"Episodio 4","language":"it-IT"},"overview":{"value":"秋深し。森に栗拾いにやって来た奇異太郎とすず。そんな中、奇異太郎は妙なハムスターたちを見つけて……？色っぽい謎のお姉さんも乱入し、今日も今日とて大混乱。妖怪だらけの奇異太郎の日々、これからどうなる！？","language":"ja-JP"},"airDateText":{"value":"2016-10-26","language":"it-IT"},"runtimeMinutes":4,"rating":8,"thumbnail":"https://image.tmdb.org/t/p/w300/qcFNRtM9sXB5gRN2hujzpQOXr8K.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/qcFNRtM9sXB5gRN2hujzpQOXr8K.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/68138/season/1/episode/4"},{"id":"1236645","seasonNumber":1,"episodeNumber":5,"title":{"value":"Episodio 5","language":"it-IT"},"overview":{"value":"もしも未来が見えたなら、過ちを回避できるなら……。特に悩めるわけでもない奇異太郎の前に、そんな夢を叶えてくれる謎の二人(？)組妖怪が現れる。このままでは不幸になると脅された奇異太郎、訝りながら従ってみるも……。奇妙で愉快な妖怪だらけの日々、ますます悪化の一途？","language":"ja-JP"},"airDateText":{"value":"2016-11-02","language":"it-IT"},"runtimeMinutes":4,"rating":8,"thumbnail":"https://image.tmdb.org/t/p/w300/jG5OqqrgCnoiHqmLqah47Rsm0au.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/jG5OqqrgCnoiHqmLqah47Rsm0au.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/68138/season/1/episode/5"},{"id":"1238586","seasonNumber":1,"episodeNumber":6,"title":{"value":"Episodio 6","language":"it-IT"},"overview":{"value":"芸術の秋。山の麓を歩いていた奇異太郎は、水墨画を描く女性と出会う。感心して眺めていると、彼女は唐突に口を開き……？すずの友達もやって来て、ますます離れは賑やかに。ぞくぞくするけど怖くない、妖怪だらけの日々！","language":"ja-JP"},"airDateText":{"value":"2016-11-09","language":"it-IT"},"runtimeMinutes":4,"rating":8,"thumbnail":"https://image.tmdb.org/t/p/w300/hoFSXRfaiyKbgJV6aHY1gs4ZGsK.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/hoFSXRfaiyKbgJV6aHY1gs4ZGsK.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/68138/season/1/episode/6"},{"id":"1240529","seasonNumber":1,"episodeNumber":7,"title":{"value":"Episodio 7","language":"it-IT"},"overview":{"value":"退けぬ戦いがある。負けられない相手がいる。ふらりと現れた謎の男に、奇異太郎は博打勝負を挑まれる。緊迫の駆け引き。交錯する思惑。勝利の女神はどちらに微笑むのか？ざわざわするけど怖くない、妖怪だらけの日々！","language":"ja-JP"},"airDateText":{"value":"2016-11-16","language":"it-IT"},"runtimeMinutes":4,"rating":8,"thumbnail":"https://image.tmdb.org/t/p/w300/95ukoTBGaW0HqnSuk5i6POXsAwn.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/95ukoTBGaW0HqnSuk5i6POXsAwn.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/68138/season/1/episode/7"},{"id":"1242983","seasonNumber":1,"episodeNumber":8,"title":{"value":"Episodio 8","language":"it-IT"},"overview":{"value":"物置を漁るすず。どうやら、ある不思議な道具を探しているらしい。そういったものなら母屋の蔵にありそうだと、奇異太郎は潜入を試みる。離れへ追いやられるきっかけとなった、いわくつきのあの蔵に。果たして探し物は見つかるのか？妖怪だらけの日々はまだまだ続く！","language":"ja-JP"},"airDateText":{"value":"2016-11-23","language":"it-IT"},"runtimeMinutes":4,"rating":8,"thumbnail":"https://image.tmdb.org/t/p/w300/45xJ6QSpfskqpcNb1D2y6faa0yI.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/45xJ6QSpfskqpcNb1D2y6faa0yI.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/68138/season/1/episode/8"},{"id":"1244495","seasonNumber":1,"episodeNumber":9,"title":{"value":"Episodio 9","language":"it-IT"},"overview":{"value":"ある日、山の麓で雪娘と遊んでいた奇異太郎とすず。そんな彼らを、つぶらな瞳で見つめる謎の影が……。可愛い外見に騙されるな！そいつはとんでもない力を秘めているぞ。笑顔ハジケる、奇妙で愉快な妖怪まみれの日々！","language":"ja-JP"},"airDateText":{"value":"2016-11-30","language":"it-IT"},"runtimeMinutes":4,"rating":8,"thumbnail":"https://image.tmdb.org/t/p/w300/oMOSRmfLAPQJwc2unouqM0EDskn.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/oMOSRmfLAPQJwc2unouqM0EDskn.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/68138/season/1/episode/9"},{"id":"1246011","seasonNumber":1,"episodeNumber":10,"title":{"value":"Episodio 10","language":"it-IT"},"overview":{"value":"すずが、暗い……。度重なる不幸にグッタリしてしまったすずを励まそうと、奇異太郎たちは一計を案じる。しかし、そこは奇異太郎たち。一筋縄ではいかなくて……？妖怪にクリスマスも誕生日もなくとも、贈り物をあげたい日ならあるんだ！","language":"ja-JP"},"airDateText":{"value":"2016-12-07","language":"it-IT"},"runtimeMinutes":4,"rating":8,"thumbnail":"https://image.tmdb.org/t/p/w300/hhatKWtnJ8pKWCTJEfa8OX3Ipga.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/hhatKWtnJ8pKWCTJEfa8OX3Ipga.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/68138/season/1/episode/10"},{"id":"1247631","seasonNumber":1,"episodeNumber":11,"title":{"value":"Episodio 11","language":"it-IT"},"overview":{"value":"不穏な気配がする。気付かぬうちに、何かをやってしまったような違和感。夜中に飛び起きた奇異太郎の前に、巨大な妖怪が現れる。応戦する奇異太郎のもとに、妖狐や雪女親子も現れて……？妖怪だらけの奇異太郎の日々、まさかの急展開！？","language":"ja-JP"},"airDateText":{"value":"2016-12-14","language":"it-IT"},"runtimeMinutes":4,"rating":8,"thumbnail":"https://image.tmdb.org/t/p/w300/phPhF8ZfIuP6iB08gJPDu5xydRB.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/phPhF8ZfIuP6iB08gJPDu5xydRB.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/68138/season/1/episode/11"},{"id":"1249485","seasonNumber":1,"episodeNumber":12,"title":{"value":"Episodio 12","language":"it-IT"},"overview":{"value":"それは夢か、現か。記憶を彩る鈴の音が聞こえてくる……。二人が出会った、あの日。すべてが始まった、あの日。忘れたくない大切な思い出。それはきっと、どの日々も同じで……。奇妙で愉快な妖怪だらけの日々、終幕にして始まりの一ページ！","language":"ja-JP"},"airDateText":{"value":"2016-12-21","language":"it-IT"},"runtimeMinutes":4,"rating":8.5,"thumbnail":"https://image.tmdb.org/t/p/w300/kJjHLMyn1aMxEWQAcgSTnnNpCkp.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/kJjHLMyn1aMxEWQAcgSTnnNpCkp.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/68138/season/1/episode/12"}],"sourceUrl":"https://www.themoviedb.org/tv/68138/season/1"},"failure":null,"fields":{},"episodes":{"1":{"checkedAt":1793442028740,"status":"ok","retryCount":0},"2":{"checkedAt":1793442028740,"status":"ok","retryCount":0},"3":{"checkedAt":1793442028740,"status":"ok","retryCount":0},"4":{"checkedAt":1793442028740,"s