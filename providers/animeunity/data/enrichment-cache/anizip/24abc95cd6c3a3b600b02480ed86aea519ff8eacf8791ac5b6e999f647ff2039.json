sonNumber":1,"externalMappings":[{"provider":"anidb","id":"351","scope":"R","episodeNumbers":[77]},{"provider":"anilist","id":"233","episodeNumbers":[77]},{"provider":"mal","id":"233","episodeNumbers":[77]},{"provider":"tmdb_show","id":"93483","scope":"s1","seasonNumber":1,"episodeNumbers":[77]},{"provider":"tvdb_show","id":"163791","scope":"s1","seasonNumber":1,"episodeNumbers":[77]}]},{"sourceEpisodeNumber":78,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"351","scope":"R","episodeNumbers":[78]},{"provider":"anilist","id":"233","episodeNumbers":[78]},{"provider":"mal","id":"233","episodeNumbers":[78]},{"provider":"tmdb_show","id":"93483","scope":"s1","seasonNumber":1,"episodeNumbers":[78]},{"provider":"tvdb_show","id":"163791","scope":"s1","seasonNumber":1,"episodeNumbers":[78]}]}]},"checkedAt":1793479005432,"status":"ok","retryCount":0,"value":[{"title":"Suddenly 4 People in the Family?!","synopsis":"Miyu Kōzuki's parents had moved to the United States to work for NASA. Miyu has been told she is to live with her parents' old friend. She arrives, and it turns out to be a Buddhist temple. She meets her parents' friend, the temple monk, Hoshou Saionji, and his teenaged son, Kanata. The monk soon leaves for India for religious training, leaving Miyu behind with Kanata. Shortly after, a UFO flies into the house, and inside were an alien baby called Ruu and a \"sitter-pet\" called Wanya. They all then decide to live in the temple together. Kanata peeps at Miyu while she's showering, just as Miyu has seen him changing."},{"title":"Ruu-kun Is Climbing the Chimney.","synopsis":"It was Miyu's first day at her new school. She finds out that Kanata has a fan club, and he is the class president. Miyu meets Christine Hanakomachi, a half-French girl who fancies Kanata. During class, Miyu spots Ruu flying outside. Kanata and Miyu chase after Ruu. Ruu ends up climbing a chimney, forcing Kanata and Miyu to climb it too."},{"title":"Chris Drops By","synopsis":"Chris and her friends came by Kanata's house to have a welcome party for Miyu. But their home turned out to be a disaster. They needed to take down floating items and hide Ruu and Wanya from their guests. Chris misunderstands Miyu and Kanata's relationship, after they discover Ruu."},{"title":"Momoka and the Necklace","synopsis":"Kanata and Miyu both go out with their friends. Before Miyu leaves, she notices that her necklace is missing. A crow has taken it. But 3 year-old Momoka chases the crow away and retrieves the necklace. While shopping for dinner, Wanya loses Ruu. Ruu finds Momoka with the necklace. They both are together, when finally Kanata and Miyu find Momoka and Ruu. Momoka starts referring to Ruu as her boyfriend."},{"title":"Miyu`s Awful Cuisine"},{"title":"Mama Comes over on Mother`s Day"},{"title":"Ruu-kun, Popular at School"},{"title":"Ruu-kun`s Acting Debut"},{"title":"A Date in the Park Between Cousins"},{"title":"Playing with Spaced-Out Santa"},{"title":"June, on Father`s Day... Papa Comes"},{"title":"The Mysterious Boy, Yaboshi Seiya"},{"title":"The Mysterious Planet Sharaku"},{"title":"Help! Transforming Wanya"},{"title":"Mikan Ran Away, Saionji!"},{"title":"Ocean and the Lovers` Tree"},{"title":"India`s Treasure Is Saionji?"},{"title":"Momoka`s Passport"},{"title":"The Mysterious Home Is Miyu`s Real House?"},{"title":"The Off-Season Home Visit"},{"title":"Principal, Monchiki Reunite"},{"title":"The Hike of Fear"},{"title":"Everyone, Gather at Saionji`s"},{"title":"The Blackout Halloween"},{"title":"Ruu-kun and the Department Store"},{"title":"Yaboshi Saiya`s Warning"},{"title":"A Correspondence with Ruu`s Parents"},{"title":"Sister Comes to Saiouji"},{"title":"Nanami and the Mysterious Tsukemonoishi"},{"title":"Wanya Wanya"},{"title":"The First Christmas with Saionji"},{"title":"Chris, Ski, Mansion"},{"title":"Kanata`s Childhood Friend"},{"title":"Kanata`s Promised Date"},{"title":"Bye Bye Wanya"},{"title":"The Heiomachi Onsen Excursion"},{"title":"Miyu`s Idol Debut"},{"title":"Ruu-kun Has Multiplied"},{"title":"All 100 Ruu-kuns, Gather!"},{"title":"Kanata`s Rival Appears?"},{"title":"Kanata and Nozomu`s Showdown"},{"title":"Where Is Okame-chan?"},{"title":"The Family Assembles at Saionji"},{"title":"Koinobori Aren`t Scary!"},{"title":"Cinderella Inside the Book"},{"title":"Chris and the White Whale."},{"title":"Miyu and Mini-Miyu Goes to School"},{"title":"Santa and Kanata`s Weird Pot"},{"title":"Mizuno-sensei`s Mysterious Trip"},{"title":"Stop It, Lazy Wanya"},{"title":"Mika-san`s Mysterious Promise"},{"title":"Saionji`s Ghost Stories and the Mysterious Koishi Stones"},{"title":"Miyu and Kanata Go to America"},{"title":"Everyone but Santa Goes to America"},{"title":"The Weird Object That Seiya Left Behind"},{"title":"Mecha Wanya Attacks!"},{"title":"Nozomu-kun Goes to the Dream World"},{"title":"My Pet Is Number One ?"},{"title":"Pepo Ruu Wanya"},{"title":"Mikan Works at Saionji"},{"title":"Miyu and Kanata`s First Kiss"},{"title":"Kabokichi Lecturing Saionji"},{"title":"Scary Mountain Villa, Is Someone in Here?"},{"title":"Pen-Friend Comes"},{"title":"How Boring the Invention Is!"},{"title":"Rival Friend, Rival in Love"},{"title":"Teru of Planet Sharaku Comes"},{"title":"Wannya vs. Shikada-san"},{"title":"Odd Guava`s Love"},{"title":"Momoka`s Christmas"},{"title":"It Is Auspicious with the Seven Deities of Good"},{"title":"Miyu and Matching Kimonos"},{"title":"Miyu and Kiddy Kanata"},{"title":"Goodbye, the Bad Team"},{"title":"Valentine`s Day in Heio-machi"},{"title":"Luu-kun Is the Leading Role by a School Festival"},{"title":"At the Night of the Full Moon"},{"title":"See You Again"}],"failure":null,"fields":{},"episodes":{}}
