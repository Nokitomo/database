":[12]},{"provider":"tmdb_show","id":"123876","scope":"s2","seasonNumber":2,"episodeNumbers":[12]},{"provider":"tvdb_show","id":"402412","scope":"s1","seasonNumber":1,"episodeNumbers":[24]},{"provider":"tvdb_show","id":"402412","scope":"s2","seasonNumber":2,"episodeNumbers":[12]}]}]},"checkedAt":1793436685609,"status":"ok","retryCount":0,"value":[{"title":"It`s Just the Arrival of Winter. / It`s Just a Delinquent. / It`s Just Studying at Nakanaka`s. / It`s Just a Final Exam.","synopsis":"On one cold morning, Komi wraps a scarf around her neck to keep warm, but as soon as she gets to school, Najimi plays a trick on her!","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/9033669/screencap/6250511a1c2b4.jpg"},{"title":"It`s Just a Typhoon. / It`s Just a Fantasy. / It`s Just a Cat Cafe. / It`s Just the \"I Love You Game\".","synopsis":"Komi gets all dressed and ready for school, but when she opens the front door, she's greeted by a typhoon. She decides to stay home and wait it out.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/9098742/screencap/625bf8215372b.jpg"},{"title":"It`s Just a Thought. / It`s Just a Fantasy, Part 2. / It`s Just an Invitation to Lunch. / It`s Just Roasted Sweet Potatoes.","synopsis":"Hoping to understand their classmate Komi more so they can be friends with her, Nakanaka and Yamai decide to talk to Tadano.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/9100108/screencap/62640fa199e9c.jpg"},{"title":"It`s Just... Christmas.","synopsis":"It's Christmas Eve, and Komi has nothing planned. But then Najimi informs her that they're going to have a Christmas party — at Komi's house.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/9100109/screencap/626a85f91b616.jpg"},{"title":"It`s Just a Snowman. / It`s Just a Snowball Fight. / It`s Just the End of the Year. / It`s Just New Year`s.","synopsis":"Komi wakes up to find that it snowed overnight. With Tadano and Najimi, she goes out into the fresh snow to start building a snowman.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/9124692/screencap/627d1af928a2a.jpg"},{"title":"It`s Just Everyone`s New Years. / It`s Just Ice Skating. / It`s Just a Cold.","synopsis":"On January 2, Najimi calls up all their friends and hears about all the different ways they welcomed in the new year.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/9150253/screencap/627d21e0dc4f5.jpg"},{"title":"It`s Just a Misunderstanding. / It`s Just a Hallucination. / It`s Just a Narcissist. / It`s Just a Group Decision for the School Field Trip.","synopsis":"Komi decides to write a letter to Najimi to clear up a misunderstanding, but she might be too nervous to give it to them.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/9160893/screencap/6286840dcb108.jpg"},{"title":"It`s Just the School Field Trip.","synopsis":"Komi's class departs for their school trip. Her classmates Kato and Sasaki are determined to make it as enjoyable as possible for Komi.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/9160894/screencap/629241db25f59.jpg"},{"title":"It`s Just the 2nd Day of the Field Trip.","synopsis":"On the second day of their school trip, Komi joins Ayami Sasaki and Mikuni Kato on a meticulously planned trip all over the Kansai area.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/9173060/screencap/629b58447e602.jpg"},{"title":"It`s Just Valentine`s Day.","synopsis":"Nene Onemine invites Komi over to her house to bake a chocolate cake. Soon enough, Nene's rowdy younger siblings join in.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/9173061/screencap/62a5cf6b7f44f.jpg"},{"title":"It`s Just Ripped Tights. / It`s Just an Oni and Her Club. / It`s Just a Pushover. / It`s Just a Fight.","synopsis":"During class one day, Ren Yamai notices that Komi's tights have a hole in them. Luckily, Ren has a spare pair to lend her.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/9173062/screencap/62ac7bb67789e.jpg"},{"title":"It`s Just White Day. / It Has Just Been One Year.","synopsis":"White Day is coming up, and Tadano wants to give something to Komi in return for the chocolate she gave him on Valentine's Day.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/9173063/screencap/62b49854b3a51.jpg"}],"failure":null,"fields":{},"episodes":{}}
