bers":[45]}]},{"sourceEpisodeNumber":46,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"778","scope":"R","episodeNumbers":[46]},{"provider":"anilist","id":"324","episodeNumbers":[46]},{"provider":"mal","id":"324","episodeNumbers":[46]},{"provider":"tmdb_show","id":"21738","scope":"s1","seasonNumber":1,"episodeNumbers":[46]},{"provider":"tvdb_show","id":"80789","scope":"s1","seasonNumber":1,"episodeNumbers":[46]}]},{"sourceEpisodeNumber":47,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"778","scope":"R","episodeNumbers":[47]},{"provider":"anilist","id":"324","episodeNumbers":[47]},{"provider":"mal","id":"324","episodeNumbers":[47]},{"provider":"tmdb_show","id":"21738","scope":"s1","seasonNumber":1,"episodeNumbers":[47]},{"provider":"tvdb_show","id":"80789","scope":"s1","seasonNumber":1,"episodeNumbers":[47]}]}]},"checkedAt":1793475575966,"status":"ok","retryCount":0,"value":[{"title":"The Green Phantom","synopsis":"Several construction labor units at the site of a planned road have been destroyed. Noa, Asuma, and Hiromi are sent to investigate. Some are quick to blame a local legend for the mayhem.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/80789/340783.jpg"},{"title":"Red Labor Landing","synopsis":"Noa and Asuma are sent to investigate a terrorist who is going to steal a military labor of the Soviet Armed Forces.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/80789/340784.jpg"},{"title":"Eve`s Trap","synopsis":"Kanuka's grandma from Hawaii visits Tokyo for Christmas. Then she suddenly disappears. The only clue to find her is \"The Christmas of 50 years ago\". When they try to find her, they are called off to duty.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/80789/340785.jpg"},{"title":"Eve`s Terror","synopsis":"Kanuka's grandma is still missing. Shinshi and some guy is sent to go find her. Kanuka uses Ota's labor to help Noa in the mission.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/80789/340786.jpg"},{"title":"Ota`s One Troubled Afternoon","synopsis":"Ota is having an arranged marriage. Noa and the others help Ota out on his dates.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/80789/340787.jpg"},{"title":"Gently, Your Highness!","synopsis":"A prince from a desert country joins Division 2 for a couple of days so he can establish a labor team in his homeland. A sniper is out to kill the prince, so Division 2 goes to stop him.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/80789/340788.jpg"},{"title":"You Win!","synopsis":"Goto takes Division 2 out for drinks as a team building excercise.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/80789/340789.jpg"},{"title":"The Whale That Sang a Song","synopsis":"An endangered humpback whale enters the Tokyo Bay. The city and Division 2 try to get the whale to leave the bay and go back to the ocean.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/80789/340790.jpg"},{"title":"The Unit Crosses the Sea","synopsis":"Noa's hometown is having a snow festival and Division 2 is helping out. They also try to help out a boy named Satoru who hates labors.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/80789/340791.jpg"},{"title":"Target, Chief Goto","synopsis":"Goto starts to act very strangely lately. Also, there are a lot of random attacks coming at Goto. Could these attacks have anything to do why Goto is acting strangely?","thumbnail":"https://artworks.thetvdb.com/banners/episodes/80789/340792.jpg"},{"title":"I Love Noa-senpai","synopsis":"A famous entertainer named Kana is joining Division 2 for one week. Everybody is trying to teach Kana how to pilot a labor. A crime gang tries to kidnap Kana so they can get one of Division 2's ingrams. However, they accidently steal Noa. Now, they have to save Noa without having to give the gang one of their ingrams.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/80789/340793.jpg"},{"title":"Shadow in Geo-Front","synopsis":"A terrorist planted a bomb in Geo-City. Division 2 is tasked with disarming it. Kanuka and Noa are put on the mission.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/80789/340794.jpg"},{"title":"Movement in the Dark","synopsis":"Noa and Asuma get into a fight concerning Asuma's personal life. When Division 2 get's assigned a special mission, Asuma is sent to Hajioji to pick up Unit 3.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/80789/340795.jpg"},{"title":"Phantom Again","synopsis":"Asuma heads to Hajioji to recover Unit 3. In the meantime, Noa and Ota are having trouble keeping the enemy at bay.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/80789/340796.jpg"},{"title":"Labor and Flower","synopsis":"Noa's and Kanuka's labor skills attract the attention of a wealthy individual.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/80789/340797.jpg"},{"title":"Kanuka`s Report","synopsis":"Kanuka is now leaving Division 2 and going back home to America. Asuma, Ota, and the others decide to throw her a farewell party. Noa is sent to spy on Kanuka. When the guys finish setting up the party, they come across Kanuka's reports on Division 2 and decide to read them.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/80789/340798.jpg"},{"title":"Farewell, Kanuka","synopsis":"Kanuka is heading back to America. However, there is a hijacker trying to hijack the plane Kanuka is riding on. How is Kanuka going to stop this, and without her gun?","thumbnail":"https://artworks.thetvdb.com/banners/episodes/80789/340799.jpg"},{"title":"Storm of Spring","synopsis":"Shinshi takes control of Kanuka's position in Division 2. However, he is really bad at it. Then, he is offered a new job. Will Shinshi stay with Division 2 or will he take the new job? And how is his wife going to react?","thumbnail":"https://artworks.thetvdb.com/banners/episodes/80789/340800.jpg"},{"title":"I`m Takeo Kumagami","synopsis":"Takeo Kumagami now joins Division 2. Noa is worried that Goto will reassign positions and that Takeo will take her place as the pilot for Unit 1.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/80789/340801.jpg"},{"title":"A Calling Voice in the Dark","synopsis":"SV2 is training in an old abandoned mansion. After a while, several members of the team encounter seemingly supernatural phenomena.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/80789/340802.jpg"},{"title":"Suspicious Duo","synopsis":"Noa and Asuma meet a strange duo at an arcade. Later, a strange and powerful labor is revealed.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/80789/340803.jpg"},{"title":"SV2 Wiped Out!","synopsis":"SV2 orders their lunch from Shanghai Restraunt, as usual. But they never get it. They intend to find out why and won't work until they get their food.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/80789/340804.jpg"},{"title":"Griffon Was Here!","synopsis":"Utsumi plans to unveil the Griffon to the public. Meanwhile, H.Q. wants to stand up additional labor divisions, planning to replace the Ingrams with a more economic model.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/80789/340805.jpg"},{"title":"Tragedy in Rain","synopsis":"Division 2 is on duty at the International Labor Show. Asuma takes Noa's movement disk to test out the new economy model. But then, the Griffon is unleashed. He beats up Asuma and Ota. Noa enters the fight after getting her disk back, but the Griffon retreats since it was raining.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/80789/340806.jpg"},{"title":"Reunion","synopsis":"The Griffon has crashed and Noa is relieved. However, the Griffon is being fixed up. Kanuka comes back to Tokyo and temporarily takes control of command of Unit 1.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/80789/340807.jpg"},{"title":"Hounds of Schaft","synopsis":"Noa and the gang that the Griffon didn't really crash, the crash was faked. SCHAFT must not let Utsumi get to Tokyo, but he gets there. Noa must prepare for the fight against the Griffon.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/80789/340808.jpg"},{"title":"The Battle of the Gate","synopsis":"Noa and Alphonse begin the fight with Bud and the Griffon. Noa is given a rifle to use but she can't use it because there are stupid people in the way. She tries using it like a sword but it didn't work out.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/80789/340809.jpg"},{"title":"Griffon Down!","synopsis":"Noa and Alphonse continue her fight with the Griffon. But the Griffon gets away in order for Utsumi to escape. Kanuka must go back to America.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/80789/340810.jpg"},{"title":"Noa`s Adventure","synopsis":"Division 2 goes to stay by the mountains for a week for training. While out buying dinner, Noa finds 20,000 yen and goes to find where the money came from all by herself.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/80789/340811.jpg"},{"title":"I`m Selling Peace of Mind","synopsis":"Division 2 must get the Patlabor Insurance to cover for the cars they destroyed.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/80789/340812.jpg"},{"title":"The Underground Mystery Tour","synopsis":"Something is out stealing stuff from Division 2. It appears to come from an old tunnel. Ota and Shinshi go to check it out. When Division 2 loses contact with them, Noa, Asuma, Hiromi, and Takeo go to find them.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/80789/340813.jpg"},{"title":"Economy Model Plans","synopsis":"Shinohara Industries has finished the new production model of a police labor. Noa, Ota, and Gomioka tests them. What will they think of them?","thumbnail":"https://artworks.thetvdb.com/banners/episodes/80789/340814.jpg"},{"title":"Orders of the Coast Guard","synopsis":"People claim to have seen some kind of monster on the beach. Division 2 investigates this.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/80789/340815.jpg"},{"title":"Save the Terrorist","synopsis":"Division 2 must save 2 very lousy terrorists that set off a bomb in the wrong place.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/80789/340816.jpg"},{"title":"The Men Who Returned","synopsis":"Three old terrorists team up to steal some money.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/80789/340817.jpg"},{"title":"The Working Girl","synopsis":"Momoko Sakurayama is interviewing Noa for \"The Working Girl\" show. Meanwhile, a sick man steals a labor in order to commit suicide.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/80789/340818.jpg"},{"title":"Long Live CLAT","synopsis":"Shige is being sent to New York. However, he gets hurt before he goes and has a dream that he is in New York working with CLAT.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/80789/340819.jpg"},{"title":"Vocational Options","synopsis":"Noa is offered to become a pilot for a Helldiver. While Noa tries to make her decision, she must stop a criminal without Alphonse.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/80789/340820.jpg"},{"title":"His Name Is Zero","synopsis":"SV2 gets a new patlabor model called the Zero. It is superior to the ingram. After messing up during a mission, Noa is worried that she will lose Alphonse.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/80789/340821.jpg"},{"title":"Condition Green","synopsis":"Noa goes back to her hometown and sees the grave of her dog Alphonse. Asuma goes to get her when a terrorist comes. Division 1 and 2 must find the terrorist without using weapons since it would cause a fire.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/80789/340822.jpg"}],"failure":null,"fields":{},"episodes":{}}
