":"R","episodeNumbers":[10]},{"provider":"anilist","id":"165810","episodeNumbers":[10]},{"provider":"mal","id":"55570","episodeNumbers":[10]},{"provider":"tmdb_show","id":"67249","scope":"s4","seasonNumber":4,"episodeNumbers":[10]},{"provider":"tvdb_show","id":"254899","scope":"s4","seasonNumber":4,"episodeNumbers":[10]}]},{"sourceEpisodeNumber":11,"seasonNumber":4,"externalMappings":[{"provider":"anidb","id":"18054","scope":"R","episodeNumbers":[11]},{"provider":"anilist","id":"165810","episodeNumbers":[11]},{"provider":"mal","id":"55570","episodeNumbers":[11]},{"provider":"tmdb_show","id":"67249","scope":"s4","seasonNumber":4,"episodeNumbers":[11]},{"provider":"tvdb_show","id":"254899","scope":"s4","seasonNumber":4,"episodeNumbers":[11]}]},{"sourceEpisodeNumber":12,"seasonNumber":4,"externalMappings":[{"provider":"anidb","id":"18054","scope":"R","episodeNumbers":[12]},{"provider":"anilist","id":"165810","episodeNumbers":[12]},{"provider":"mal","id":"55570","episodeNumbers":[12]},{"provider":"tmdb_show","id":"67249","scope":"s4","seasonNumber":4,"episodeNumbers":[12]},{"provider":"tvdb_show","id":"254899","scope":"s4","seasonNumber":4,"episodeNumbers":[12]}]},{"sourceEpisodeNumber":13,"seasonNumber":4,"externalMappings":[{"provider":"anidb","id":"18054","scope":"R","episodeNumbers":[13]},{"provider":"anilist","id":"165810","episodeNumbers":[13]},{"provider":"mal","id":"55570","episodeNumbers":[13]},{"provider":"tmdb_show","id":"67249","scope":"s4","seasonNumber":4,"episodeNumbers":[13]},{"provider":"tvdb_show","id":"254899","scope":"s4","seasonNumber":4,"episodeNumbers":[13]}]}]},"checkedAt":1793374397120,"status":"ok","value":[{"title":"The Mightiest Germany: The Night Before the Match!","synopsis":"The Japanese team is resolutely preparing for the match against Germany, aiming to advance to the finals afterward. Captain Byodoin trusts his players, who do not give up despite this challenge.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/10637221/screencap/66fbeb4298829.jpg"},{"title":"Bluebird","synopsis":"In the first match of the U-17 World Cup Semifinals it's Team Japan's Oni versus Team Germany's Q･P. Can Oni hold his ground against Team Germany's No. 2 player?","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/10718300/screencap/6702ea72060a5.jpg"},{"title":"For Whom Do You Grow Strong?","synopsis":"The first match of the World Cup Semifinals continues between Oni and Q･P. Oni shines with a mysterious light that resembles the Pinnacle of Perfection and becomes seemingly invincible.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/10718301/screencap/670fe58878e00.jpg"},{"title":"The Final Illusion","synopsis":"In the next match, Team Japan's Duke and Nio face off against Schneider and Belti, two of the three tennis pros on Team Germany.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/10718302/screencap/671160ae35656.jpg"},{"title":"Tezuka vs. Yukimura","synopsis":"Continuing the World Cup Semifinals is Team Germany’s Tezuka versus Team Japan’s Yukimura in #2 singles. Tezuka is now their opponent, so Team Japan goes all out to gain victory against their former teammate.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/10718303/screencap/672233597682b.jpg"},{"title":"Zero Senses Tennis","synopsis":"Yukimura prepares to counter Tezuka's Pinnacle of Perfection in order to prove to Akaya, his team, and himself that you don't have to give up on tennis even if you can't use the Pinnacle of Perfection.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/10718304/screencap/672ba25f7e31e.jpg"},{"title":"The Future Beyond the Fierce Match","synopsis":"Every time Yukimura takes away Tezuka's five senses, Tezuka regaains them using the Pinnacle of Perfection. Can Yukimura be able to turn the tables or will Tezuka hold on to his lead?","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/10718305/screencap/673fe3573fa35.jpg"},{"title":"Team Spain, Ryoga Echizen","synopsis":"In the other semifinals bracket, Team USA is competing with Team Spain for a spot at the finals. Ryoga Echizen, who is now playing for Team Spain, clashes with Ralph Reinhart of Team USA.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/10718306/screencap/673fe3655794f.jpg"},{"title":"Focus Burst vs. Pinnacle of Perfection","synopsis":"Kirihara is determined to beat Siegfried's Pinnacle of Perfection with his Focus Burst. The two battle it out as their doubles partners watch on.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/10718307/screencap/674762753a5df.jpg"},{"title":"The Outcome of the Tiebreak","synopsis":"The second set of the doubles match between Tanegashima-Kirihara and Bismarck-Siegfried gets drawn into a tiebreak. If Team Japan loses this set, they will be eliminated from the semifinals.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/10718308/screencap/674762fb32a88.jpg"},{"title":"Final Set","synopsis":"The doubles pairs Tanegashima-Kirihara and Bismarck-Siegfried ramp it up for this final set, showing teamwork that activates skills never seen before.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/10839030/screencap/676c131e0987a.jpg"},{"title":"Spiral Baptism","synopsis":"In the last match of the semifinals, Byodoin and Volk go head-to-head in a mighty battle to bring their teams through to the finals.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/10839031/screencap/676c136235d83.jpg"},{"title":"Life-or-Death Tennis","synopsis":"Byodoin puts his life on the line against Germany's Volk in an intense epilogue to the World Cup semifinals.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/10839032/screencap/676c13f421292.jpg"}],"fields":{},"episodes":{}}
