breve, il nostro eroe si ritroverà a dover far fronte all’assalto dei bizzarri componenti di un’organizzazione segreta,che paiono essere alla ricerca di un qualche potere che il ragazzo dovrebbe possedere.\r\nUnico baluardo in questa sua lotta contro il male – o per rimanere per lo meno tutto intero – sarà proprio il misterioso mecha Kemeko, pilotato da una bellissima fanciulla che ricorda terribilmente il suo primo e mai dimenticato amore.","date":"2008","episodes_count":12,"episodes_length":24,"author":" ","created_at":"2021-11-08 18:05:46","status":"Terminato","imageurl_cover":"","type":"TV","slug":"the-unknown-girlfriend","title_eng":"The Unknown Girlfriend","day":"Indeterminato","favorites":31,"score":"6.89","visite":23615,"studio":"Hal Film Maker","dub":0,"always_home":0,"members":188,"cover":null,"anilist_id":3464,"season":"Autunno","title_it":null,"mal_id":3464,"crunchy_id":null,"netflix_id":null,"prime_id":null,"disney_id":null,"pivot":{"anime_id":3294,"related_id":3293,"number":1}}]},"archive":null},"sourceEpisodes":[{"id":54776,"anime_id":3294,"user_id":2,"number":"1","created_at":"2021-11-08 18:15:26","link":"https://www.forbiddenlol.cloud/DDL/ANIME/KemekoDeluxe_Special_SUB_ITA.mp4","visite":6576,"hidden":0,"public":1,"scws_id":65192,"file_name":"KemekoDeluxe_Special_SUB_ITA.mp4","tg_post":0}],"artworkInventory":{"logo":[],"poster":[{"source":"provider","url":"https://img.animeunity.co/anime/78037.jpg"}],"background":[]},"artworkLibrary":{"schemaVersion":1,"tmdb":{},"tvdb":{}},"metadataTasks":{"78228fda5c498ff9c434cdfaff13237f22128e0be0c112820e6eacb35d6b1c7f":{"source":"anizip","kind":"artwork","input":{},"status":"missing","fields":["logo","poster","background"],"nextCheckAt":1795903604489},"e9c5ed7f2610fa4a81e9a1df83755828116760a52d49a027625e92e910978ad9":{"source":"cinemeta","kind":"artwork","input":{"imdbId":"","isMovie":false},"status":"missing","fields":["logo","poster","background"],"nextCheckAt":1795903225590},"a1f4669c27434af230776d23f52c17daafe