nity.co/anime/bx2685-ZP46utTR0mv8.jpg"}]},{"title":"Tsubasa: Shunraiki","link":"/anime/1729-tsubasa-shunraiki","image":"https://img.animeunity.co/anime/4938.jpg","type":"OVA","year":"2009","dubStatus":"subbed","dubStatusKey":"Subbed","variants":[{"status":"subbed","statusKey":"Subbed","title":"Tsubasa: Shunraiki","link":"/anime/1729-tsubasa-shunraiki","image":"https://img.animeunity.co/anime/4938.jpg"}]}],"linkList":[{"title":"Episodes 1-3","titleKey":"Episodes {{start}}-{{end}}","titleParams":{"start":1,"end":3},"availabilityStatus":"available","episodesLink":"1728|1|3"}]},"episodes":[{"title":"Episodio 1","episodeNumber":1,"sourceEpisodeNumber":1,"seasonNumber":0,"externalMappings":[{"provider":"anidb","id":"5301","scope":"R","episodeNumbers":[1]},{"provider":"anilist","id":"2685","episodeNumbers":[1]},{"provider":"mal","id":"2685","episodeNumbers":[1]},{"provider":"tmdb_show","id":"37565","scope":"s0","seasonNumber":0,"episodeNumbers":[1]},{"provider":"tvdb_show","id":"76023","scope":"s0","seasonNumber":0,"episodeNumbers":[2]}],"link":"32185","synopsis":"The group arrives in a desolated Tokyo. Running under cover from the acid rain, Syaoran and Mokona run into Kamui and his group. Sustaining bad injuries, Syaoran is rescued by Kurogane, who then fights Kamui until to a draw. Deciding that the travelers aren't thieves, Kamui allows the group shelter and receive treatment for Syaoran's wounds. Kurogane speaks to Fai about his past, and then later the group runs into Fūma and his group. The Syaoran being held captive by Fei Wong Reed awakens.","thumbnail":"https://image.tmdb.org/t/p/w300/mqIeOIDRCvFyfsraCaNXhuaGePS.jpg","metadataSources":{"tmdb":{"title":"Episodio 1","synopsis":"The group arrives in a desolated Tokyo. Running under cover from the acid rain, Syaoran and Mokona run into Kamui and his group. Sustaining bad injuries, Syaoran is rescued by Kurogane, who then fights Kamui until to a draw. Deciding that the travelers aren't thieves, Kamui allows the group shelter and receive treatment for Syaoran's wounds. Kurogane speaks to Fai about his past, and then later the group runs into Fūma and his group. The Syaoran being held captive by Fei Wong Reed awakens.","thumbnail":"https://image.tmdb.org/t/p/w300/mqIeOIDRCvFyfsraCaNXhuaGePS.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}},{"title":"Episodio 2","episodeNumber":2,"sourceEpisodeNumber":2,"seasonNumber":0,"externalMappings":[{"provider":"anidb","id":"5301","scope":"R","episodeNumbers":[2]},{"provider":"anilist","id":"2685","episodeNumbers":[2]},{"provider":"mal","id":"2685","episodeNumbers":[2]},{"provider":"tmdb_show","id":"37565","scope":"s0","seasonNumber":0,"episodeNumbers":[2]},{"provider":"tvdb_show","id":"76023","scope":"s0","seasonNumber":0,"episodeNumbers":[3]}],"link":"32186","synopsis":"It is revealed that the Syaoran that has been collecting the feathers so far is a clone and that the real Syaoran was the one trapped by Fei Wang Reed. The story continues as the awakened Syaoran travels towards his clone. The seal on the \"heart\" in the clone's right eye is broken, and Fai tries to restore it with his magic, but fails. Without the heart anymore the clone Syaoran's instincts (reasons why he was created) kick in, making him forget his own developing heart. Fai's left eye is eaten by the clone and battle breaks out between the real Syaoran and the clone. As the real Syaoran is about to strike the Clone, Sakura begs them to stop and because of this, the Clone stabs Syaoran, obtains the feather and gives it to Sakura. The Clone then leaves through a portal opened by his creator, Fei Wong Reed, ignoring Sakura's desperate pleas for him to stay. Later, Subaru, Kamui’s twin, wakes up from his coma.","thumbnail":"https://image.tmdb.org/t/p/w300/eFpDt4ioVPJQIXKXiGN9XTHxGjb.jpg","metadataSources":{"tmdb":{"title":"Episodio 2","synopsis":"It is revealed that the Syaoran that has been collecting the feathers so far is a clone and that the real Syaoran was the one trapped by Fei Wang Reed. The story continues as the awakened Syaoran travels towards his clone. The seal on the \"heart\" in the clone's right eye is broken, and Fai tries to restore it with his magic, but fails. Without the heart anymore the clone Syaoran's instincts (reasons why he was created) kick in, making him forget his own developing heart. Fai's left eye is eaten by the clone and battle breaks out between the real Syaoran and the clone. As the real Syaoran is about to strike the Clone, Sakura begs them to stop and because of this, the Clone stabs Syaoran, obtains the feather and gives it to Sakura. The Clone then leaves through a portal opened by his creator, Fei Wong Reed, ignoring Sakura's desperate pleas for him to stay. Later, Subaru, Kamui’s twin, wakes up from his coma.","thumbnail":"https://image.tmdb.org/t/p/w300/eFpDt4ioVPJQIXKXiGN9XTHxGjb.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}},{"title":"Episodio 3","episodeNumber":3,"sourceEpisodeNumber":3,"seasonNumber":0,"externalMappings":[{"provider":"anidb","id":"5301","scope":"R","episodeNumbers":[3]},{"provider":"anilist","id":"2685","episodeNumbers":[3]},{"provider":"mal","id":"2685","episodeNumbers":[3]},{"provider":"tmdb_show","id":"37565","scope":"s0","seasonNumber":0,"episodeNumbers":[3]},{"provider":"tvdb_show","id":"76023","scope":"s0","seasonNumber":0,"episodeNumbers":[4]}],"link":"32184","synopsis":"After the Clone left, the water has drained from the Municipal building and Fai is dying due to the loss of his eye that the clone ate. Subaru wishes to have the water restored, while Kurogane wishes to save Fai's life. Fai is fed with vampire blood and becomes a vampire, thus saving his life, and the water is restored. The price of the water, however, is that Sakura must seek out a treasure somewhere in Tokyo.","thumbnail":"https://image.tmdb.org/t/p/w300/1uCZuH2qfc4PpyD7SmGDgUxI2yX.jpg","metadataSources":{"tmdb":{"title":"Episodio 3","synopsis":"After the Clone left, the water has drained from the Municipal building and Fai is dying due to the loss of his eye that the clone ate. Subaru wishes to have the water restored, while Kurogane wishes to save Fai's life. Fai is fed with vampire blood and becomes a vampire, thus saving his life, and the water is restored. The price of the water, however, is that Sakura must seek out a treasure somewhere in Tokyo.","thumbnail":"https://image.tmdb.org/t/p/w300/1uCZuH2qfc4PpyD7SmGDgUxI2yX.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}}],"sourceIds":{"anilistId":2685,"malId":2685},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-30T07:57:40Z","sourceDescriptors":["anilist:2685","mal:2685"],"targets":[{"provider":"anidb","id":"3317","scope":"R"},{"provider":"anidb","id":"5301","scope":"R","ranges":{"1-3":"1-3"}},{"provider":"anidb","id":"6191","scope":"R"},{"provider":"anilist","id":"2685","ranges":{"1-3":"1-3"}},{"provider":"anilist","id":"4938"},{"provider":"anilist","id":"807"},{"provider":"imdb_movie","id":"tt0466551"},{"provider":"mal","id":"2685","ranges":{"1-3":"1-3"}},{"provider":"mal","id":"4938"},{"provider":"mal","id":"807"},{"provider":"tmdb_show","id":"37565","scope":"s0","ranges":{"1-3":"1-3"}},{"provider":"tvdb_show","id":"76023","scope":"s0","ranges":{"1-3":"2-4"}}]},"sourceMetadata":{"info":{"id":1728,"title":"Tsubasa RESERVoir CHRoNiCLE: Tokyo Revelations","title_eng":"Tsubasa: Tokyo Revelations","slug":"tsubasa-tokyo-revelations","plot":"La serie OAV riprende l'arco di Tokyo; i nostri protagonisti arrivano in un mondo in cui regnano morte e desolazione e in cui opposte fazioni si fanno guerra per il possesso delle risorse. Anche in questo mondo si nasconde una piuma di Sakura, ma le verità di cui verranno a conoscenza Shaoran e gli altri, saranno ben più shockanti.","type":"OVA","status":"Terminato","date":"2007","studio":"Production I.G","dub":0,"mal_id":2685,"anilist_id":2685,"imageurl":"https://img.animeunity.co/anime/bx2685-ZP46utTR0mv