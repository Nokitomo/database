ers":[7]},{"provider":"mal","id":"25859","episodeNumbers":[7]},{"provider":"tmdb_show","id":"76117","scope":"s1","seasonNumber":1,"episodeNumbers":[7]},{"provider":"tvdb_show","id":"289908","scope":"s1","seasonNumber":1,"episodeNumbers":[7]}],"link":"65196","synopsis":"When the gang sees a sleep-deprived Amami stumbling down the street, they worry her inability to ignore her spectral friends is putting her heath at risk. They decide to speak with her father Asahi, who digs up a special pair glasses capable of blocking Amami's sixth sense.","thumbnail":"https://image.tmdb.org/t/p/w300/v1vlIOstYzBdWnMJkxjcEwjSJaY.jpg","metadataSources":{"tmdb":{"title":"Episodio 7","synopsis":"When the gang sees a sleep-deprived Amami stumbling down the street, they worry her inability to ignore her spectral friends is putting her heath at risk. They decide to speak with her father Asahi, who digs up a special pair glasses capable of blocking Amami's sixth sense.","thumbnail":"https://image.tmdb.org/t/p/w300/v1vlIOstYzBdWnMJkxjcEwjSJaY.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}},{"title":"Episodio 8","episodeNumber":8,"sourceEpisodeNumber":8,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"10782","scope":"R","episodeNumbers":[8]},{"provider":"anilist","id":"20814","episodeNumbers":[8]},{"provider":"mal","id":"25859","episodeNumbers":[8]},{"provider":"tmdb_show","id":"76117","scope":"s1","seasonNumber":1,"episodeNumbers":[8]},{"provider":"tvdb_show","id":"289908","scope":"s1","seasonNumber":1,"episodeNumbers":[8]}],"link":"65197","synopsis":"Amami meets the ghost of a young girl who keeps repeating a mysterious nonsense word: \"Morya.\" No longer able to recall her life or how she died, the roll-call samurai and Amami worry she may simply fade away.","thumbnail":"https://image.tmdb.org/t/p/w300/pVeB1Q88PI2XTDncdNxHEuuSfpz.jpg","metadataSources":{"tmdb":{"title":"Episodio 8","synopsis":"Amami meets the ghost of a young girl who keeps repeating a mysterious nonsense word: \"Morya.\" No longer able to recall her life or how she died, the roll-call samurai and Amami worry she may simply fade away.","thumbnail":"https://image.tmdb.org/t/p/w300/pVeB1Q88PI2XTDncdNxHEuuSfpz.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}},{"title":"Episodio 9","episodeNumber":9,"sourceEpisodeNumber":9,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"10782","scope":"R","episodeNumbers":[9]},{"provider":"anilist","id":"20814","episodeNumbers":[9]},{"provider":"mal","id":"25859","episodeNumbers":[9]},{"provider":"tmdb_show","id":"76117","scope":"s1","seasonNumber":1,"episodeNumbers":[9]},{"provider":"tvdb_show","id":"289908","scope":"s1","seasonNumber":1,"episodeNumbers":[9]}],"link":"65198","synopsis":"Valentine's Day is getting closer and all the boys and girls are getting restless. And when the gang finds out Amami wants to try her hand at home-made chocolate, they can't help but wonder who it's for! Tune in for a sweet, emotional Valentine's Day episode. You'll never believe who Amami's heart really belongs to!","thumbnail":"https://image.tmdb.org/t/p/w300/9epbp2NvETEh2McUhDyLryflyoU.jpg","metadataSources":{"tmdb":{"title":"Episodio 9","synopsis":"Valentine's Day is getting closer and all the boys and girls are getting restless. And when the gang finds out Amami wants to try her hand at home-made chocolate, they can't help but wonder who it's for! Tune in for a sweet, emotional Valentine's Day episode. You'll never believe who Amami's heart really belongs to!","thumbnail":"https://image.tmdb.org/t/p/w300/9epbp2NvETEh2McUhDyLryflyoU.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}},{"title":"Episodio 10","episodeNumber":10,"sourceEpisodeNumber":10,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"10782","scope":"R","episodeNumbers":[10]},{"provider":"anilist","id":"20814","episodeNumbers":[10]},{"provider":"mal","id":"25859","episodeNumbers":[10]},{"provider":"tmdb_show","id":"76117","scope":"s1","seasonNumber":1,"episodeNumbers":[10]},{"provider":"tvdb_show","id":"289908","scope":"s1","seasonNumber":1,"episodeNumbers":[10]}],"link":"65199","synopsis":"A new school year begins, and Amami and her friends are pretty excited about having younger students around. Wanting to be a model student, Amami tries to help the new freshman class...and so do her spectral friends. The otherworldly assistance scares off the new kids and leaves Amami feeling crushed, so Inoue and the others take it upon themselves to make her more appealing.","thumbnail":"https://image.tmdb.org/t/p/w300/6WFTnTnbQMVmCa705oNBPiyPDSd.jpg","metadataSources":{"tmdb":{"title":"Episodio 10","synopsis":"A new school year begins, and Amami and her friends are pretty excited about having younger students around. Wanting to be a model student, Amami tries to help the new freshman class...and so do her spectral friends. The otherworldly assistance scares off the new kids and leaves Amami feeling crushed, so Inoue and the others take it upon themselves to make her more appealing.","thumbnail":"https://image.tmdb.org/t/p/w300/6WFTnTnbQMVmCa705oNBPiyPDSd.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}},{"title":"Episodio 11","episodeNumber":11,"sourceEpisodeNumber":11,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"10782","scope":"R","episodeNumbers":[11]},{"provider":"anilist","id":"20814","episodeNumbers":[11]},{"provider":"mal","id":"25859","episodeNumbers":[11]},{"provider":"tmdb_show","id":"76117","scope":"s1","seasonNumber":1,"episodeNumbers":[11]},{"provider":"tvdb_show","id":"289908","scope":"s1","seasonNumber":1,"episodeNumbers":[11]}],"link":"65200","synopsis":"Amami invites her friends over to her house for the Star Festival, and they're excited for the visit when they learn about her late mother's handmade decorations. According to Amami, they're packed with mysterious powers that are all but guaranteed to make wishes come true...","thumbnail":"https://image.tmdb.org/t/p