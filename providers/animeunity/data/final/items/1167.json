re_id":30}},{"id":24,"name":"Mystery","pivot":{"anime_id":1167,"genre_id":24}},{"id":47,"name":"Psychological","pivot":{"anime_id":1167,"genre_id":47}},{"id":49,"name":"Seinen","pivot":{"anime_id":1167,"genre_id":49}},{"id":50,"name":"Slice of Life","pivot":{"anime_id":1167,"genre_id":50}},{"id":42,"name":"Supernatural","pivot":{"anime_id":1167,"genre_id":42}}],"related":[{"id":1165,"user_id":2,"title":"Mushi-Shi","imageurl":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/bx457-Si9avlyStAXj.png","plot":"In natura esistono i mushi, strane creature simili ad insetti invisibili alla maggior parte degli uomini, entità legate alla vita e alla natura in modo più profondo rispetto all'uomo, in grado di alterare, anche profondamente, la vita di tutte le creature con cui vengono a contatto. Ginko è un mushishi, un uomo in grado di vedere i mushi, che viaggia per tutto il Giappone senza fissa dimora; suo compito è risolvere i più disparati problemi causati dai mushi agli esseri umani. Ogni episodio è una nuova storia, un nuovo mushi di cui esplorare storia, natura ed effetti, una nuova situazione di cui indagare personaggi, caratterizzazioni psicologiche, situazione sociale ed economica.","date":"2005","episodes_count":26,"episodes_length":25,"author":" ","created_at":"2019-07-16 00:44:33","status":"Terminato","imageurl_cover":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/n457-sWOJfqYC7s2I.jpg","type":"TV","slug":"mushishi","title_eng":"Mushishi","day":"Indeterminato","favorites":290,"score":"8.41","visite":130397,"studio":"Artland","dub":0,"always_home":0,"members":2515,"cover":null,"anilist_id":457,"season":"Autunno","title_it":null,"mal_id":457,"crunchy_id":null,"netflix_id":null,"prime_id":null,"disney_id":null,"pivot":{"anime_id":1167,"related_id":1165,"number":1}},{"id":1162,"user_id":2,"title":"Mushi-shi: Next Passage Part 1","imageurl":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/nx20595-dXPvrTNRKFUb.jpg","plot":"Vivono nel buio profondo dietro le palpebre. Alcuni mangiano il silenzio. Altri uccidono senza rendersene conto. Alcuni semplicemente rimangono inerti. I Mushi sono forme di vita primordiale che vivono accanto a noi senza che ce ne rendiamo conto. Potremmo definirli spiriti, entità, esseri non classificabili. L’unica cosa certa è che di loro si sa ben poco. Ginko è un Mushishi, un uomo che conosce bene i Mushi e potrebbe avere le competenze adatte per aiutare chi entra in contatto con queste creature soprannaturali…","date":"2014","episodes_count":10,"episodes_length":24,"author":" ","created_at":"2019-07-15 23:54:53","status":"Terminato","imageurl_cover":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/n20595-y2Snh07wJ00v.jpg","type":"TV","slug":"mushishi-zoku-shou","title_eng":"Mushishi Zoku Shou","day":"Indeterminato","favorites":71,"score":"8.51","visite":46047,"studio":"Artland","dub":0,"always_home":0,"members":584,"cover":null,"anilist_id":20595,"season":"Primavera","title_it":null,"mal_id":21939,"crunchy_id":null,"netflix_id":null,"prime_id":null,"disney_id":null,"pivot":{"anime_id":1167,"related_id":1162,"number":1}},{"id":1163,"user_id":2,"title":"Mushi-shi: Next Passage Part 2","imageurl":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/bx20751-O3XJ9u30y7Qj.png","plot":"Mushishi è costituito da episodi auto-conclusivi in cui di volta in volta il protagonista, il misterioso Ginko, entra in contatto con un diverso caso che coinvolge i Mushi, strane creature che racchiudono in sé la vita. Non proprio insetti o animali, ma comunque esseri viventi. Né buoni né cattivi. La convivenza di questi con l’uomo porta sovente a problematiche che soltanto un Mushishi (cacciatore di Mushi) è in grado di risolvere.\r\nPer via di questa struttura esistono molti personaggi differenti e solo pochi vengono ripresentati nel corso di storie successive. L’unico personaggio cardine è Ginko che porta sulle spalle il peso di una amnesia che nasconde la sua fanciullezza e che vaga per il Giappone in cerca di nuovi casi, senza essere in grado di fermarsi a lungo in un posto per via della sua natura di attirare i Mushi a sé.","date":"2014","episodes_count":10,"episodes_length":24,"author":" ","created_at":"2019-07-15 23:59:15","status":"Terminato","imageurl_cover":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/n20751-ipj6JyHGCuol.jpg","type":"TV","slug":"mushishi-zoku-shou-2","title_eng":"Mushishi Zoku Shou 2","day":"Sabato","favorites":53,"score":"8.75","visite":43912,"studio":"Artland","dub":0,"always_home":0,"members":399,"cover":null,"anilist_id":20751,"season":"Autunno","title_it":null,"mal_id":24701,"crunchy_id":null,"netflix_id":null,"prime_id":null,"disney_id":null,"pivot":{"anime_id":1167,"related_id":1163,"number":1}},{"id":2816,"user_id":2,"title":"Mushishi Path of Thorns","imageurl":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/nx20752-P5EpEJXWGroz.jpg","plot":"Episodio Special di Mushishi","date":"2014","episodes_count":1,"episodes_length":47,"author":" ","created_at":"2020-10-07 05:03:54","status":"Terminato","imageurl_cover":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/n20752-P4PCEkgiAWx4.jpg","type":"Special","slug":"mushishi-zoku-shou-odoro-no-michi","title_eng":"Mushishi Zoku Shou: Odoro no Michi","day":"Indeterminato","favorites":28,"score":"8.43","visite":17493,"studio":"Artland","dub":0,"always_home":0,"members":188,"cover":null,"anilist_id":20752,"season":"Estate","title_it":null,"mal_id":24687,"crunchy_id":null,"netflix_id":null,"prime_id":null,"disney_id":null,"pivot":{"anime_id":1167,"related_id":2816,"number":1}},{"id":1166,"user_id":2,"title":"Mushi-shi: The Shadow that Devours the Sun","imageurl":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/bx20526-PmuD69J3rkDF.png","plot":"I Mushi sono delle strane e piccole creature temute dall'uomo da tempo immemore. Esistono però delle persone come Ginko in grado di trovarle e risolvere i problemi da loro