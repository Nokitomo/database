{"id":2923,"path":"/anime/2923-ex-arm","linkSchemaVersion":2,"enrichmentSchemaVersion":2,"updatedAt":"2026-10-31T10:07:16.778Z","episodeSafetyVersion":1,"info":{"title":"Ex-Arm","synopsis":"Akira Natsume è uno studente molto timido che sembra avere una sorta di fobia dei dispositivi elettrici, ma nonostante ciò è molto bravo a diagnosticarli. Un giorno, si fa coraggio e salva una ragazza in difficoltà, ma sfortunatamente poco dopo viene investito da un camion risvegliandosi sedici anni dopo grazie all'aiuto di una poliziotta e il suo compagno android. Nell'arco di questo tempo però il suo corpo è stato sostituito con un Ex-Arm, ovvero un'intelligienza artificiale tecnologicamente avanzata e dotata di grandi potenzialità distruttive.","image":"https://image.tmdb.org/t/p/original/yqYcI8Es2egQIIcrujhrmT2P1Eu.jpg","poster":"https://image.tmdb.org/t/p/original/pWfebzmXm0sz02ibugop3YlA24f.jpg","logo":"https://image.tmdb.org/t/p/original/ebWo3LcEtNUE7wJJ4oJFYRp2uDL.png","background":"https://image.tmdb.org/t/p/original/yqYcI8Es2egQIIcrujhrmT2P1Eu.jpg","trailers":["https://www.youtube.com/watch?v=gTX3wT5ynec"],"imdbId":"tt12384506","type":"series","tags":["TV","Terminato","Inverno","2021"],"tagKeys":{"TV":"TV","Terminato":"Completed","Inverno":"Winter"},"genres":["Action","Sci-fi","Seinen"],"rating":"3.3","studio":"Visual Flight","episodesCount":12,"extra":{"ids":{"malId":38853,"anilistId":106503,"crunchyId":null,"disneyId":null,"netflixId":null,"primeId":null,"anilistIds":[106503],"malIds":[38853],"anidbIds":[14545],"imdbMovieIds":[],"imdbShowIds":[],"tmdbMovieIds":[],"tmdbShowIds":[92401],"tvdbMovieIds":[],"tvdbShowIds":[382958]},"stats":{"scoreRaw":"3.34","favorites":78,"members":711,"views":62181,"episodesCountRaw":12,"episodesLength":24},"flags":{"dub":0,"alwaysHome":1},"meta":{"day":"Domenica","season":"Inverno","status":"Terminato","type":"TV","createdAt":"2021-01-10 19:33:29","userId":78495},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"