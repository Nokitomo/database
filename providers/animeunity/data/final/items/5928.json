ries/388248/posters/5f5b0afc8af7e.jpg"},{"source":"anilist","url":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/large/bx108978-GtIXqzO8RaAz.png"}],"background":[{"source":"tmdb","url":"https://image.tmdb.org/t/p/original/aG4KxeCZtCoXc1HdjImLquQjPN7.jpg"},{"source":"anizip","url":"https://artworks.thetvdb.com/banners/series/388248/backgrounds/5f62864a83fa6.jpg"},{"source":"provider","url":"https://img.animeunity.co/anime/108978-6LMQD27N0525.jpg"},{"source":"anilist","url":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/108978-6LMQD27N0525.jpg"}]}},"related":[],"linkList":[{"title":"Episodes 1-10","titleKey":"Episodes {{start}}-{{end}}","titleParams":{"start":1,"end":10},"availabilityStatus":"available","episodesLink":"5928|1|10"}]},"episodes":[{"title":"Episodio 1","episodeNumber":1,"sourceEpisodeNumber":1,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"15644","scope":"R","episodeNumbers":[1]},{"provider":"anilist","id":"108978","episodeNumbers":[1]},{"provider":"mal","id":"38990","episodeNumbers":[1]},{"provider":"tmdb_show","id":"109329","scope":"s1","seasonNumber":1,"episodeNumbers":[1]},{"provider":"tvdb_show","id":"388248","scope":"s1","seasonNumber":1,"episodeNumbers":[1]}],"link":"88282","synopsis":"这是一本叫做《狂傲仙魔途》的小说，讲的是在一个修仙世界里大家都很狂很傲，所以动不动就要靠打架来证明谁更厉害的故事，那当然我们都知道在这种故事里，没人能比主角更强了。所以如果你比主角更强，那么你就会是个反派，会被主角干掉，这个道理大家都懂，只有大反派不懂。故事的开始在这洛川之河上，主角被放在木盆里随便漂一漂就会被好心人捡到，因为是在冬天的洛川里捡到的，所以好心人就给男主起名叫——洛冰河。但是好景不长，养母不幸染病离世，男主便去拜苍穹派清静峰峰主沈清秋为师，但是没想到沈清秋因为妒忌男主，将他推落悬崖没想到却因此获得了强大的力量。在男主的梦境里住着一名叫做梦魔的前辈，梦魔前辈教男主修炼，解开了男主身上的魔族封印，于是男主去往魔界与魔界大王打一打，魔界大王的女儿就成了后宫，来了人界，和人界的掌门打一打，人界掌门的女儿就成了后宫，在师门，和大反派师父打一打，就成了仙魔至尊，绝世美女倒贴。原来这都是主角在看的小说，他悲愤的写下了评价，却因为太着急吃包子噎住，本以为自己要凉了，却穿越了？！醒来一看自己居然变成了沈清秋，现在的洛冰河被沈清秋打了40大板关在了柴房，掌门托人把他放出来带到沈清秋房间里，本来想给他上药却得到了ＯＯＣ警告，看来这个办法行不通啊。沈清秋询问了洛冰河年龄，虚岁14的洛冰河已经经历了很多虐待，为黑化埋下了伏笔。沈清秋不断了解系统机能，触发剧情，没想到上来就到了刺激剧情，明矾抢了洛清河养母的唯一遗物，想帮助洛冰河的沈清秋还是被ＯＯＣ警告限制无法出手，怎么办才好呢？","thumbnail":"https://image.tmdb.org/t/p/w300/limExVlDpp3WI1zZptwkX5cIaJk.jpg","metadataSources":{"tmdb":{"title":"Episodio 1","synopsis":"这是一本叫做《狂傲仙魔途》的小说，讲的是在一个修仙世界里大家都很狂很傲，所以动不动就要靠打架来证明谁更厉害的故事，那当然我们都知道在这种故事里，没人能比主角更强了。所以如果你比主角更强，那么你就会是个反派，会被主角干掉，这个道理大家都懂，只有大反派不懂。故事的开始在这洛川之河上，主角被放在木盆里随便漂一漂就会被好心人捡到，因为是在冬天的洛川里捡到的，所以好心人就给男主起名叫——洛冰河。但是好景不长，养母不幸染病离世，男主便去拜苍穹派清静峰峰主沈清秋为师，但是没想到沈清秋因为妒忌男主，将他推落悬崖没想到却因此获得了强大的力量。在男主的梦境里住着一名叫做梦魔的前辈，梦魔前辈教男主修炼，解开了男主身上的魔族封印，于是男主去往魔界与魔界大王打一打，魔界大王的女儿就成了后宫，来了人界，和人界的掌门打一打，人界掌门的女儿就成了后宫，在师门，和大反派师父打一打，就成了仙魔至尊，绝世美女倒贴。原来这都是主角在看的小说，他悲愤的写下了评价，却因为太着急吃包子噎住，本以为自己要凉了，却穿越了？！醒来一看自己居然变成了沈清秋，现在的洛冰河被沈清秋打了40大板关在了柴房，掌门托人把他放出来带到沈清秋房间里，本来想给他上药却得到了ＯＯＣ警告，看来这个办法行不通啊。沈清秋询问了洛冰河年龄，虚岁14的洛冰河已经经历了很多虐待，为黑化埋下了伏笔。沈清秋不断了解系统机能，触发剧情，没想到上来就到了刺激剧情，明矾抢了洛清河养母的唯一遗物，想帮助洛冰河的沈清秋还是被ＯＯＣ警告限制无法出手，怎么办才好呢？","thumbnail":"https://image.tmdb.org/t/p/w300/limExVlDpp3WI1zZptwkX5cIaJk.jpg","titleLanguage":"it-IT","synopsisLanguage":"zh-CN"}}},{"title":"Episodio 2","episodeNumber":2,"sourceEpisodeNumber":2,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"15644","scope":"R","episodeNumbers":[2]},{"provider":"anilist","id":"108978","episodeNumbers":[2]},{"provider":"mal","id":"38990","episodeNumbers":[2]},{"provider":"tmdb_show","id":"109329","scope":"s1","seasonNumber":1,"episodeNumbers":[2]},{"provider":"tvdb_show","id":"388248","scope":"s1","seasonNumber":1,"episodeNumbers":[2]}],"link":"88283","synopsis":"正当千钧一发之际，还是师尊出手救了洛冰河，Ｂ格被扣的只剩下25，但随后师尊找到了假玉观音，涨了150B格，果然好人还是有好报的。半夜的集市上一名女子被神秘的烟雾袭击，可能是双湖镇的神秘连环剥皮杀人案件，众人在行车路上也欺负洛冰河，于是沈清秋便让洛冰河同乘马车。到了案件地点，沈清秋了解到已经死了九人了，听了一番介绍后，明矾便去探查细节情况，洛冰河则与宁婴婴一起前往街道，却不敌魔物，宁婴婴被剥皮怪带走。沈清秋开启了简单模式找寻魔物踪迹，却没想到兜兜转转还是回到了陈府。","thumbnail":"https://image.tmdb.org/t/p/w300/5PtUqm4NQ03pVb3ux1hILVym79t.jpg","metadataSources":{"tmdb":{"title":"Episodio 2","synopsis":"正当千钧一发之际，还是师尊出手救了洛冰河，Ｂ格被扣的只剩下25，但随后师尊找到了假玉观音，涨了150B格，果然好人还是有好报的。半夜的集市上一名女子被神秘的烟雾袭击，可能是双湖镇的神秘连环剥皮杀人案件，众人在行车路上也欺负洛冰河，于是沈清秋便让洛冰河同乘马车。到了案件地点，沈清秋了解到已经死了九人了，听了一番介绍后，明矾便去探查细节情况，洛冰河则与宁婴婴一起前往街道，却不敌魔物，宁婴婴被剥皮怪带走。沈清秋开启了简单模式找寻魔物踪迹，却没想到兜兜转转还是回到了陈府。","thumbnail":"https://image.tmdb.org/t/p/w300/5PtUqm4NQ03pVb3ux1hILVym79t.jpg","titleLanguage":"it-IT","synopsisLanguage":"zh-CN"}}},{"title":"Episodio 3","episodeNumber":3,"sourceEpisodeNumber":3,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"15644","scope":"R","episodeNumbers":[3]},{"provider":"anilist","id":"108978","episodeNumbers":[3]},{"provider":"mal","id":"38990","episodeNumbers":[3]},{"provider":"tmdb_show","id":"109329","scope":"s1","seasonNumber":1,"episodeNumbers":[3]},{"provider":"tvdb_show","id":"388248","scope":"s1","seasonNumber":1,"episodeNumbers":[3]}],"link":"88284","synopsis":"沈清秋和一行人被蝶儿抓了起来，蝶儿是专门剥人皮做为自己皮囊的魔界妖物，这次他看上的是宁婴婴的皮。三人都被捆在柱子上无法动弹，沈清秋与蝶儿周旋，脑子里却在想最优的解决办法，正当蝶儿要扒了他的皮时，沈清秋把战火引去洛冰河身上，因为有主角光环，当蝶儿想害洛冰河时，房梁塌了下来，洛冰河也顺利解开绳子。解开绳子的洛冰河趁蝶儿不注意，帮沈清秋解开了捆仙锁，沈清秋顺利制服了可恶的剥皮怪，事情才算告一段落。觉得自己不够强，沈清秋决定闭关三年提升实力，刚刚进入洞天的沈清秋遇到了？","thumbnail":"https://image.tmdb.org/t/p/w300/1r52ATolmCpDV8VlN61kkUlFiq8.jpg","metadataSources":{"tmdb":{"title":"Episodio 3","synopsis":"沈清秋和一行人被蝶儿抓了起来，蝶儿是专门剥人皮做为自己皮囊的魔界妖物，这次他看上的是宁婴婴的皮。三人都被捆在柱子上无法动弹，沈清秋与蝶儿周旋，脑子里却在想最优的解决办法，正当蝶儿要扒了他的皮时，沈清秋把战火引去洛冰河身上，因为有主角光环，当蝶儿想害洛冰河时，房梁塌了下来，洛冰河也顺利解开绳子。解开绳子的洛冰河趁蝶儿不注意，帮沈清秋解开了捆仙锁，沈清秋顺利制服了可恶的剥皮怪，事情才算告一段落。觉得自己不够强，沈清秋决定闭关三年提升实力，刚刚进入洞天的沈清秋遇到了？","thumbnail":"https://image.tmdb.org/t/p/w300/1r52ATolmCpDV8VlN61kkUlFiq8.jpg","titleLanguage":"it-IT","synopsisLanguage":"zh-CN"}}},{"title":"Episodio 4","episodeNumber":4,"sourceEpisodeNumber":4,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"15644","scope":"R","episodeNumbers":[4]},{"provider":"anilist","id":"108978","episodeNumbers":[4]},{"provider":"mal","id":"38990","episodeNumbers":[4]},{"provider":"tmdb_show","id":"109329","scope":"s1","seasonNumber":1,"episodeNumbers":[4]},{"provider":"tvdb_show","id":"388248","scope":"s1","seasonNumber":1,"episodeNumbers":[4]}],"link":"88285","synopsis":"闭关洞内沈清秋遇到了柳清歌，并救了他，闭关多日沈清秋功力大增。出关时，正好碰上掌门下山，魔族小人趁机攻上山，两方交手沙华玲登场，于是决定找三名代表进行三场比试。第一场比试由师尊上场比试，沈清秋不急不躁的进行战斗，逼得独臂长老焦急露出破绽被沈清秋打败，但是系统提示到如果洛冰河未参加比试，自己就会死亡","thumbnail":"https://image.tmdb.org/t/p/w300/jsLidFO0d9eSCTYmp42SGX3YUP8.jpg","metadataSources":{"tmdb":{"title":"Episodio 4","synopsis":"闭关洞内沈清秋遇到了柳清歌，并救了他，闭关多日沈清秋功力大增。出关时，正好碰上掌门下山，魔族小人趁机攻上山，两方交手沙华玲登场，于是决定找三名代表进行三场比试。第一场比试由师尊上场比试，沈清秋不急不躁的进行战斗，逼得独臂长老焦急露出破绽被沈清秋打败，但是系统提示到如果洛冰河未参加比试，自己就会死亡","thumbnail":"https://image.tmdb.org/t/p/w300/jsLidFO0d9eSCTYmp42SGX3YUP8.jpg","titleLanguage":"it-IT","synopsisLanguage":"zh-CN"}}},{"title":"Episodio 5","episodeNumber":5,"sourceEpisodeNumber":5,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"15644","scope":"R","episodeNumbers":[5]},{"provider":"anilist","id":"108978","episodeNumbers":[5]},{"provider":"mal","id":"38990","episodeNumbers":[5]},{"provider":"tmdb_show","id":"109329","scope":"s1","seasonNumber":1,"episodeNumbers":[5]},{"provider":"tvdb_show","id":"388248","scope":"s1","seasonNumber":1,"episodeNumbers":[5]}],"link":"88287","synopsis":"第二场比赛纱华铃打算亲自上场，同时她也提出，三场比赛不能全都由沈清秋出手，这时柳溟烟从人群后方飞过来，向沈清秋自请出战。柳溟烟可以说是《狂傲仙魔途》的第一女主，因其容貌过于迤逦，所以常年以面纱遮面，没有人不好奇面上下的真正面貌，沈清秋也不例外，但是他又不能说让柳溟烟摘下面纱让自己看看，那岂不是对自己的师侄耍流氓了。洛冰河对战天锤长老，沈清秋加油打气第二场比赛最后以柳溟烟落败而告终，头上正悬着一把铡刀的沈清秋怀着十分愧疚的心点名了洛冰河上场进行第三场比赛，对战魔族的天锤长老。洛冰河现在还是个按部就班修炼的孩子，面对相差几百年功力的天锤长老，刚一上场真的就只有挨打的份，再回头看看沈清秋，一点儿要叫停的意思都没有，洛冰河不由得想起了之前沈清秋虐待自己的时候，似乎是真的要把自己往死里整。然而就在天锤长老的锤子即将要砸到洛冰河的时候，沈清秋突然开口了，信心满满地给洛冰河加油打气，万万没想到的是，洛冰河竟然信了，果然这个时候的洛冰河就是好骗啊！洛冰河战胜天锤长老，沈清秋身中无可解有了沈清秋的加油鼓劲，洛冰河就跟喝了鸡血一样，重新振作了起来，就连功力也提升了一个档次，刚才还毫无还手之力的人立马就变得十分厉害了，而且洛冰河脑中那些不好的回忆也一点点地被沈清秋带给他的温情所替代。被打败的天锤长老恼羞成怒，想要杀了洛冰河，却被沈清秋挡了下来，天锤长老不退反进，用身上的毒刺刺中了沈清秋的手，沈清秋因此成功身中魔族奇毒“无可解”。","thumbnail":"https://image.tmdb.org/t/p/w300/jY0x8ogMXoS1iUxxUCKvweOiKMC.jpg","metadataSources":{"tmdb":{"title":"Episodio 5","synopsis":"第二场比赛纱华铃打算亲自上场，同时她也提出，三场比赛不能全都由沈清秋出手，这时柳溟烟从人群后方飞过来，向沈清秋自请出战。柳溟烟可以说是《狂傲仙魔途》的第一女主，因其容貌过于迤逦，所以常年以面纱遮面，没有人不好奇面上下的真正面貌，沈清秋也不例外，但是他又不能说让柳溟烟摘下面纱让自己看看，那岂不是对自己的师侄耍流氓了。洛冰河对战天锤长老，沈清秋加油打气第二场比赛最后以柳溟烟落败而告终，头上正悬着一把铡刀的沈清秋怀着十分愧疚的心点名了洛冰河上场进行第三场比赛，对战魔族的天锤长老。洛冰河现在还是个按部就班修炼的孩子，面对相差几百年功力的天锤长老，刚一上场真的就只有挨打的份，再回头看看沈清秋，一点儿要叫停的意思都没有，洛冰河不由得想起了之前沈清秋虐待自己的时候，似乎是真的要把自己往死里整。然而就在天锤长老的锤子即将要砸到洛冰河的时候，沈清秋突然开口了，信心满满地给洛冰河加油打气，万万没想到的是，洛冰河竟然信了，果然这个时候的洛冰河就是好骗啊！洛冰河战胜天锤长老，沈清秋身中无可解有了沈清秋的加油鼓劲，洛冰河就跟喝了鸡血一样，重新振作了起来，就连功力也提升了一个档次，刚才还毫无还手之力的人立马就变得十分厉害了，而且洛冰河脑中那些不好的回忆也一点点地被沈清秋带给他的温情所替代。被打败的天锤长老恼羞成怒，想要杀了洛冰河，却被沈清秋挡了下来，天锤长老不退反进，用身上的毒刺刺中了沈清秋的手，沈清秋因此成功身中魔族奇毒“无可解”。","thumbnail":"https://image.tmdb.org/t/p/w300/jY0x8ogMXoS1iUxxUCKvweOiKMC.jpg","titleLanguage":"it-IT","synopsisLanguage":"zh-CN"}}},{"title":"Episodio 6","episodeNumber":6,"sourceEpisodeNumber":6,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"15644","scope":"R","episodeNumbers":[6]},{"provider":"anilist","id":"108978","episodeNumbers":[6]},{"provider":"mal","id":"38990","episodeNumbers":[6]},{"provider":"tmdb_show","id":"109329","scope":"s1","seasonNumber":1,"episodeNumbers":[6]},{"provider":"tvdb_show","id":"388248","scope":"s1","seasonNumber":1,"episodeNumbers":[6]}],"link":"88286","synopsis":"为了救下洛冰河，沈清秋中了无可解，纱华铃想要试探沈清秋是否中毒，提出让沈清秋使用一记灵力暴击，沈清秋抱着试一试的心态推出一掌，结果直接把纱华铃给打飞了。原来是柳清歌及时出现，助了沈清秋一臂之力，才让他堪堪躲过一劫，柳清歌一出现，沈清秋的风头就被分去了大半，这要是搁以前的沈清秋，估计要气个半死。不过好在拉拢柳清歌这个计划有戏，沈清秋对此还是很喜闻乐见的。贴心冰妹给师尊做粥，清静舍成揽锅现场沈清秋醒来以后已经是在清静舍里了，正巧明帆进来看见了，东西往桌子上一扔就嚎了起来，哭了好一会才想起来去叫岳清源他们，出门的时候还狠狠推了洛冰河一把，对这个分走师尊宠爱的家伙打心眼里喜欢不起来。明帆走后，沈清秋把洛冰河叫进来，一顿忏悔过后，洛冰河端进来一碗白粥，不愧是男主，一碗白粥都能做的让人忍不住口水直流，要知道，厨艺可是洛冰河撩妹的一大利器啊！洛冰河走后没多久，岳清源几人就过来了，看着躺在床上的沈清秋顿时就控制不住自己了，直把锅往自己身上揽，原著这里只有岳清源一个人在感叹，动漫却改成了岳清源和木清芳争相背锅，简直就是为了搞笑而搞笑。明帆神助攻刷好感，沈清秋被拉入梦境之地岳清源和木清芳走后，柳清歌对沈清秋说出了自己的怀疑，但是他并没有证据，只能选择相信是沈清秋改了性子，沈清秋提出要柳清歌多提携提携洛冰河，可把进来倒茶的明帆气了个够呛。回头就跑到了厨房开始刁难洛冰河，想让他去砍柴却发现柴已经砍完了，想让他去挑水结果发现水也挑完了，但是这口恶气还是必须要出的，就打发洛冰河去把水缸里的水重新挑一遍。要是搁以前，洛冰河肯定认为是明帆在故意为难自己，但是沈清秋事件之后洛冰河就明白了，这是对自己的一种历练，是好事，要是明帆知道洛冰河内心是这么想的，恐怕直接就气死了。沈清秋半夜睡醒去喝水，回头却发现自己被拉入了梦境之地，这个时候的沈清秋终于意识到了不对劲，因为在《狂傲仙魔途》里这段剧情是洛冰河和宁婴婴一起进行的，怎么到了这儿突然就变成了他呢？他可不想再给主角挡刀了啊！因为这里是洛冰河的梦境，所以只有当洛冰河毁掉梦境的核心，他们才能从这个梦境之地出去，两人来到了洛冰河以前流浪的地方。因为是梦境之地，所以活人都是没有脸的，然而洛冰河却突然看到了一个有脸的人，沈清秋意识到他们应该是离梦境核心不远了，赶紧和洛冰河追了出去。","thumbnail":"https://image.tmdb.org/t/p/w300/ubMqsOeE0cD92tMXPKrWHmHIVS4.jpg","metadataSources":{"tmdb":{"title":"Episodio 6","synopsis":"为了救下洛冰河，沈清秋中了无可解，纱华铃想要试探沈清秋是否中毒，提出让沈清秋使用一记灵力暴击，沈清秋抱着试一试的心态推出一掌，结果直接把纱华铃给打飞了。原来是柳清歌及时出现，助了沈清秋一臂之力，才让他堪堪躲过一劫，柳清歌一出现，沈清秋的风头就被分去了大半，这要是搁以前的沈清秋，估计要气个半死。不过好在拉拢柳清歌这个计划有戏，沈清秋对此还是很喜闻乐见的。贴心冰妹给师尊做粥，清静舍成揽锅现场沈清秋醒来以后已经是在清静舍里了，正巧明帆进来看见了，东西往桌子上一扔就嚎了起来，哭了好一会才想起来去叫岳清源他们，出门的时候还狠狠推了洛冰河一把，对这个分走师尊宠爱的家伙打心眼里喜欢不起来。明帆走后，沈清秋把洛冰河叫进来，一顿忏悔过后，洛冰河端进来一碗白粥，不愧是男主，一碗白粥都能做的让人忍不住口水直流，要知道，厨艺可是洛冰河撩妹的一大利器啊！洛冰河走后没多久，岳清源几人就过来了，看着躺在床上的沈清秋顿时就控制不住自己了，直把锅往自己身上揽，原著这里只有岳清源一个人在感叹，动漫却改成了岳清源和木清芳争相背锅，简直就是为了搞笑而搞笑。明帆神助攻刷好感，沈清秋被拉入梦境之地岳清源和木清芳走后，柳清歌对沈清秋说出了自己的怀疑，但是他并没有证据，只能选择相信是沈清秋改了性子，沈清秋提出要柳清歌多提携提携洛冰河，可把进来倒茶的明帆气了个够呛。回头就跑到了厨房开始刁难洛冰河，想让他去砍柴却发现柴已经砍完了，想让他去挑水结果发现水也挑完了，但是这口恶气还是必须要出的，就打发洛冰河去把水缸里的水重新挑一遍。要是搁以前，洛冰河肯定认为是明帆在故意为难自己，但是沈清秋事件之后洛冰河就明白了，这是对自己的一种历练，是好事，要是明帆知道洛冰河内心是这么想的，恐怕直接就气死了。沈清秋半夜睡醒去喝水，回头却发现自己被拉入了梦境之地，这个时候的沈清秋终于意识到了不对劲，因为在《狂傲仙魔途》里这段剧情是洛冰河和宁婴婴一起进行的，怎么到了这儿突然就变成了他呢？他可不想再给主角挡刀了啊！因为这里是洛冰河的梦境，所以只有当洛冰河毁掉梦境的核心，他们才能从这个梦境之地出去，两人来到了洛冰河以前流浪的地方。因为是梦境之地，所以活人都是没有脸的，然而洛冰河却突然看到了一个有脸的人，沈清秋意识到他们应该是离梦境核心不远了，赶紧和洛冰河追了出去。","thumbnail":"https://image.tmdb.org/t/p/w300/ubMqsOeE0cD92tMXPKrWHmHIVS4.jpg","titleLanguage":"it-IT","synopsisLanguage":"zh-CN"}}},{"title":"Episodio 7","episodeNumber":7,"sourceEpisodeNumber":7,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"15644","scope":"R","episodeNumbers":[7]},{"provider":"anilist","id":"108978","episodeNumbers":[7]},{"provider":"mal","id":"38990","episodeNumbers":[7]},{"provider":"tmdb_show","id":"109329","scope":"s1","seasonNumber":1,"episodeNumbers":[7]},{"provider":"tvdb_show","id":"388248","scope":"s1","seasonNumber":1,"episodeNumbers":[7]}],"link":"88289","synopsis":"沈清秋和洛冰河在一片迷雾的街道中穿行，发现了几个有脸的人，二人连忙追上去，几个人正在殴打一个少年。洛冰河看在眼里十分不忍，想上前制止，沈清秋却阻止了他，表示这些都是梦魇利用他的记忆制造出来的幻影，贸然接触会有危险，被卷入更深的梦境。洛冰河发现被殴打的少年正是年少的自己，没有忍住出手攻击了那群混混。接着，沈清秋和洛冰河就被丢进了又一层的幻境。梦魇在不断利用洛冰河的记忆制造幻境，洛冰河甚至看到了自己病重的母亲，伸手拉住了母亲的手，洛冰河不断的看到自己当年被欺辱的各个场景，心中悲愤不已，发动攻击使整个梦境全部失控。沈清秋不希望洛冰河的神志被毁，抵挡了他最后一次的权利攻击，洛冰河和沈清秋终于从梦境里醒了过来。然而沈清秋想出门离开时突然昏迷，梦魔现身了。梦魔一直在挑拨洛冰河和沈清秋的关系，甚至还攻击了他进入他的心境一探究竟，在洛冰河一片荒芜的心境深处，还残留着一处枯木逢春的难得景象。正当梦魔查探时，洛冰河的心境上空出现了一只血红的巨眼，将梦魔驱赶了出来。梦魔认为洛冰河十分有潜力，希望洛冰河能够和他一起修习魔族功法。陷入昏迷的沈清秋也在另一个梦魇中醒来，他又回到了被洛冰河囚禁的那几年。","thumbnail":"https://image.tmdb.org/t/p/w300/xKUAtt5TPMYGVV5yxhTr9RGQQZC.jpg","metadataSources":{"tmdb":{"title":"Episodio 7","synopsis":"沈清秋和洛冰河在一片迷雾的街道中穿行，发现了几个有脸的人，二人连忙追上去，几个人正在殴打一个少年。洛冰河看在眼里十分不忍，想上前制止，沈清秋却阻止了他，表示这些都是梦魇利用他的记忆制造出来的幻影，贸然接触会有危险，被卷入更深的梦境。洛冰河发现被殴打的少年正是年少的自己，没有忍住出手攻击了那群混混。接着，沈清秋和洛冰河就被丢进了又一层的幻境。梦魇在不断利用洛冰河的记忆制造幻境，洛冰河甚至看到了自己病重的母亲，伸手拉住了母亲的手，洛冰河不断的看到自己当年被欺辱的各个场景，心中悲愤不已，发动攻击使整个梦境全部失控。沈清秋不希望洛冰河的神志被毁，抵挡了他最后一次的权利攻击，洛冰河和沈清秋终于从梦境里醒了过来。然而沈清秋想出门离开时突然昏迷，梦魔现身了。梦魔一直在挑拨洛冰河和沈清秋的关系，甚至还攻击了他进入他的心境一探究竟，在洛冰河一片荒芜的心境深处，还残留着一处枯木逢春的难得景象。正当梦魔查探时，洛冰河的心境上空出现了一只血红的巨眼，将梦魔驱赶了出来。梦魔认为洛冰河十分有潜力，希望洛冰河能够和他一起修习魔族功法。陷入昏迷的沈清秋也在另一个梦魇中醒来，他又回到了被洛冰河囚禁的那几年。","thumbnail":"https://image.tmdb.org/t/p/w300/xKUAtt5TPMYGVV5yxhTr9RGQQZC.jpg","titleLanguage":"it-IT","synopsisLanguage":"zh-CN"}}},{"title":"Episodio 8","episodeNumber":8,"sourceEpisodeNumber":8,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"15644","scope":"R","episodeNumbers":[8]},{"provider":"anilist","id":"108978","episodeNumbers":[8]},{"provider":"mal","id":"38990","episodeNumbers":[8]},{"provider":"tmdb_show","id":"109329","scope":"s1","seasonNumber":1,"episodeNumbers":[8]},{"provider":"tvdb_show","id":"388248","scope":"s1","seasonNumber":1,"episodeNumbers":[8]}],"link":"88288","synopsis":"沈清秋陷入幻境，又回到了他被洛冰河做成人彘时的梦境。惊醒后，系统奖励了他五百逼格值。洛冰河听到声音进屋看望沈清秋。沈清秋询问洛冰河和那个梦魔之后的事情。洛冰河隐瞒了一部分，只说梦魔灵力不支，二人被斥出了梦境。但看过小说有上帝视角的沈清秋却知道真相的，但他没有显露出来，只提醒洛冰河被模组侵袭不是闹着玩的，此事不能姑息，然后就细细检查起洛冰河的气息，但梦魔不愧是百年魔族，让人一点痕迹都觉察不出。洛冰河始终对梦魔的话耿耿于怀，问沈清秋是不是应当把所有的魔族都斩尽杀绝。然而沈清秋的一番话彻底改变了他的想法。沈清秋说尽管魔族害人更多，但也有人害魔族的事情发生，人分好歹，魔族也有善恶之分。沈清秋希望洛冰河能记住他今天说的话，世间没有任何东西是不容于天地的。却没有想到洛冰河却打定了修魔道的主意。洛冰河刚刚歇下，梦魔就来找他了。梦魔已经得知了洛冰河的决定，开始教他走上魔修之路。沈清秋收到了仙盟大会的请帖，沈清秋知道即将开始无间深渊的剧情，沈清秋从系统那得知如果洛冰河跳过无间深渊，那“主角爽度”会被严重影响，提醒他这是洛冰河无法改变的命运。洛冰河心意坚定，即便要遭受无尽的苦痛折磨也要做这世间的至高强者，沈清秋看着如此坚定的洛冰河，只好妥协跟随剧情的发展。沈清秋和洛冰河等人前往绝地谷参加仙盟大会。参加仙盟大会的众人需要在绝地谷中度过七日，在七日中猎得更多的魔物者为胜。","thumbnail":"https://image.tmdb.org/t/p/w300/rD8EHnGxv0B1NbuoT9hpF6UB5J1.jpg","metadataSources":{"tmdb":{"title":"Episodio 8","synopsis":"沈清秋陷入幻境，又回到了他被洛冰河做成人彘时的梦境。惊醒后，系统奖励了他五百逼格值。洛冰河听到声音进屋看望沈清秋。沈清秋询问洛冰河和那个梦魔之后的事情。洛冰河隐瞒了一部分，只说梦魔灵力不支，二人被斥出了梦境。但看过小说有上帝视角的沈清秋却知道真相的，但他没有显露出来，只提醒洛冰河被模组侵袭不是闹着玩的，此事不能姑息，然后就细细检查起洛冰河的气息，但梦魔不愧是百年魔族，让人一点痕迹都觉察不出。洛冰河始终对梦魔的话耿耿于怀，问沈清秋是不是应当把所有的魔族都斩尽杀绝。然而沈清秋的一番话彻底改变了他的想法。沈清秋说尽管魔族害人更多，但也有人害魔族的事情发生，人分好歹，魔族也有善恶之分。沈清秋希望洛冰河能记住他今天说的话，世间没有任何东西是不容于天地的。却没有想到洛冰河却打定了修魔道的主意。洛冰河刚刚歇下，梦魔就来找他了。梦魔已经得知了洛冰河的决定，开始教他走上魔修之路。沈清秋收到了仙盟大会的请帖，沈清秋知道即将开始无间深渊的剧情，沈清秋从系统那得知如果洛冰河跳过无间深渊，那“主角爽度”会被严重影响，提醒他这是洛冰河无法改变的命运。洛冰河心意坚定，即便要遭受无尽的苦痛折磨也要做这世间的至高强者，沈清秋看着如此坚定的洛冰河，只好妥协跟随剧情的发展。沈清秋和洛冰河等人前往绝地谷参加仙盟大会。参加仙盟大会的众人需要在绝地谷中度过七日，在七日中猎得更多的魔物者为胜。","thumbnail":"https://image.tmdb.org/t/p/w300/rD8EHnGxv0B1NbuoT9hpF6UB5J1.jpg","titleLanguage":"it-IT","synopsisLanguage":"zh-CN"}}},{"title":"Episodio 9","episodeNumber":9,"sourceEpisodeNumber":9,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"15644","scope":"R","episodeNumbers":[9]},{"provider":"anilist","id":"108978","episodeNumbers":[9]},{"provider":"mal","id":"38990","episodeNumbers":[9]},{"provider":"tmdb_show","id":"109329","scope":"s1","seasonNumber":1,"episodeNumbers":[9]},{"provider":"tvdb_show","id":"388248","scope":"s1","seasonNumber":1,"episodeNumbers":[9]}],"link":"88291","synopsis":"在外观看的众位门中长辈纷纷下注，众人大多赌公仪萧第一，唯独沈清秋赌洛冰河第一，押了五千灵石。洛冰河身后跟了一大群只有三脚猫功夫的弟子，生生被拖慢了脚步。婉容还想停下来休息，又不想失去洛冰河的保护，便上前劝洛冰河也停下来休息一会，洛冰河心太软只好答应他们停下来休息。从水镜中观察赛场情况的掌门看着洛冰河的脸，喃喃道“太像了。”却也不知道说的像谁。公仪萧和溟烟也各自带着同门弟子前进，溟烟的队伍中有一名弟子中了无可解，溟烟立即燃放烟花通知了师尊。而公仪萧此时也遇见了一个棘手难题。谷中不知道为什么，会有吸月壑蟒这种纯血魔物，还被公仪萧给遇上了。有毒针不停的从结界之外射进来，不断的攻击者溟烟和她的队伍，灵鹰也被袭击从天上掉了下来，洛冰河的拖油瓶队友们还在河边休息，却不知河底的危险已经悄然临近。洛冰河看到了溟烟燃放的信号弹，招呼大家赶快上岸。但为时已晚，不断有人被河中的怪物叼下河，婉容也命丧于此。洛冰河他们遇到的居然是七星烛龙。各派掌门都看到了谷中发生的事情，大家十分气愤，质问幻花宫谷中的魔兽是怎么回事，为什么突然多了这么多强力的魔兽。有掌门希望立刻打开结界让弟子们撤出来，但岳掌门拒绝开启结界。倘若闲杂打开结界，那谷中的魔物就会四处逃逸，危及到周边的百姓。沈清秋提议，既然谷中的魔物不能放出，弟子也不能不救，那不如他们全部进入结界援助那些弟子。","thumbnail":"https://image.tmdb.org/t/p/w300/23wqV6aAUwGSeWBojuxbixqDCEK.jpg","metadataSources":{"tmdb":{"title":"Episodio 9","synopsis":"在外观看的众位门中长辈纷纷下注，众人大多赌公仪萧第一，唯独沈清秋赌洛冰河第一，押了五千灵石。洛冰河身后跟了一大群只有三脚猫功夫的弟子，生生被拖慢了脚步。婉容还想停下来休息，又不想失去洛冰河的保护，便上前劝洛冰河也停下来休息一会，洛冰河心太软只好答应他们停下来休息。从水镜中观察赛场情况的掌门看着洛冰河的脸，喃喃道“太像了。”却也不知道说的像谁。公仪萧和溟烟也各自带着同门弟子前进，溟烟的队伍中有一名弟子中了无可解，溟烟立即燃放烟花通知了师尊。而公仪萧此时也遇见了一个棘手难题。谷中不知道为什么，会有吸月壑蟒这种纯血魔物，还被公仪萧给遇上了。有毒针不停的从结界之外射进来，不断的攻击者溟烟和她的队伍，灵鹰也被袭击从天上掉了下来，洛冰河的拖油瓶队友们还在河边休息，却不知河底的危险已经悄然临近。洛冰河看到了溟烟燃放的信号弹，招呼大家赶快上岸。但为时已晚，不断有人被河中的怪物叼下河，婉容也命丧于此。洛冰河他们遇到的居然是七星烛龙。各派掌门都看到了谷中发生的事情，大家十分气愤，质问幻花宫谷中的魔兽是怎么回事，为什么突然多了这么多强力的魔兽。有掌门希望立刻打开结界让弟子们撤出来，但岳掌门拒绝开启结界。倘若闲杂打开结界，那谷中的魔物就会四处逃逸，危及到周边的百姓。沈清秋提议，既然谷中的魔物不能放出，弟子也不能不救，那不如他们全部进入结界援助那些弟子。","thumbnail":"https://image.tmdb.org/t/p/w300/23wqV6aAUwGSeWBojuxbixqDCEK.jpg","titleLanguage":"it-IT","synopsisLanguage":"zh-CN"}}},{"title":"Episodio 10","episodeNumber":10,"sourceEpisodeNumber":10,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"15644","scope":"R","episodeNumbers":[10]},{"provider":"anilist","id":"108978","episodeNumbers":[10]},{"provider":"mal","id":"38990","episodeNumbers":[10]},{"provider":"tmdb_show","id":"109329","scope":"s1","seasonNumber":1,"episodeNumbers":[10]},{"provider":"tvdb_show","id":"388248","scope":"s1","seasonNumber":1,"episodeNumbers":[10]}],"link":"88290","synopsis":"众位师长打算进入谷中营救弟子，但都劝慰沈清秋不要冒险，但是他严词拒绝，势要亲手解救自己的弟子。长老们终于决定出发，然而第一次御剑飞行的沈清秋居然晕剑，半途下来吐了很久，和其他掌门分道扬镳。与此同时，溟烟等人也在抵抗着神秘人的攻击，吸月壑蟒对公仪萧紧追不舍，任何法术都对这个皮糙肉厚的巨蟒不起作用。公仪萧将魔兽引进拥挤的石阵中，希望靠碎石掩埋住吸月壑蟒，没想到反而激怒了吸月壑蟒。千钧一发之际，吸月巨蟒被天上划过的流星吸引了主意力，放弃了公仪萧。与此同时，溟烟等人也发现谷中的魔物全都朝着一个地方去了。死里逃生的洛冰河等人也在谷中生火歇息。洛冰河他们遭遇了奇怪生物的袭击，这种魔物只有一个头颅样子，会抱住人的脸直到对方窒息而死，眼看大家仓皇而逃，沈清秋终于赶到解决了所有魔物。沈清秋带着洛冰河施展苍穹派的剑法，二人默契十足，护着一众弟子向谷外撤离。","thumbnail":"https://image.tmdb.org/t/p/w300/hdLgmnPHc9UM4KcJ8hgioOGaKPC.jpg","metadataSources":{"tmdb":{"title":"Episodio 10","synopsis":"众位师长打算进入谷中营救弟子，但都劝慰沈清秋不要冒险，但是他严词拒绝，势要亲手解救自己的弟子。长老们终于决定出发，然而第一次御剑飞行的沈清秋居然晕剑，半途下来吐了很久，和其他掌门分道扬镳。与此同时，溟烟等人也在抵抗着神秘人的攻击，吸月壑蟒对公仪萧紧追不舍，任何法术都对这个皮糙肉厚的巨蟒不起作用。公仪萧将魔兽引进拥挤的石阵中，希望靠碎石掩埋住吸月壑蟒，没想到反而激怒了吸月壑蟒。千钧一发之际，吸月巨蟒被天上划过的流星吸引了主意力，放弃了公仪萧。与此同时，溟烟等人也发现谷中的魔物全都朝着一个地方去了。死里逃生的洛冰河等人也在谷中生火歇息。洛冰河他们遭遇了奇怪生物的袭击，这种魔物只有一个头颅样子，会抱住人的脸直到对方窒息而死，眼看大家仓皇而逃，沈清秋终于赶到解决了所有魔物。沈清秋带着洛冰河施展苍穹派的剑法，二人默契十足，护着一众弟子向谷外撤离。","thumbnail":"https://image.tmdb.o