{"id":592,"path":"/anime/592-bakumatsu-renai-bakumatsu-kareshi-gaiden","linkSchemaVersion":2,"enrichmentSchemaVersion":2,"updatedAt":"2026-10-31T13:55:50.767Z","episodeSafetyVersion":1,"info":{"title":"BAKUMATSU: Renai Bakumatsu Kareshi Gaiden","synopsis":"Periodo Bakumatsu (1853-1867), ultimi anni dell’epoca Edo, periodo che segna la fine della politica isolazionista del Giappone, nonché il passaggio dal sistema feudale dello shogunato al governo Meiji, con la fine dello shogunato Tokugawa. L’anime ha per protagoniste figure storiche realmente esistite in versione bishounen, e, a differenza del dating-sim da cui è tratta, abbondonerà il lato “romantico” per focalizzarsi sul genere fantascientifico d’azione ed avventura.","image":"https://image.tmdb.org/t/p/original/ce9FfcCekyEnXx3nuScrUu1Ug2X.jpg","poster":"https://image.tmdb.org/t/p/original/qtVtTnMe4neHuWtMuRITU2Bd0K1.jpg","background":"https://image.tmdb.org/t/p/original/ce9FfcCekyEnXx3nuScrUu1Ug2X.jpg","trailers":["https://www.youtube.com/watch?v=FFUJNaJY-f8"],"imdbId":"","type":"series","tags":["TV","Terminato","Autunno","2018"],"tagKeys":{"TV":"TV","Terminato":"Completed","Autunno":"Autumn"},"genres":["Action","Historical","Samurai","Sci-fi"],"rating":"6.8","studio":"Studio DEEN","episodesCount":12,"extra":{"ids":{"malId":37584,"anilistId":101373,"crunchyId":null,"disneyId":null,"netflixId":null,"primeId":null,"anilistIds":[101373],"malIds":[37584],"anidbIds":[13971],"imdbMovieIds":[],"imdbShowIds":[],"tmdbMovieIds":[],"tmdbShowIds":[82846],"tvdbMovieIds":[],"tvdbShowIds":[352679]},"stats":{"scoreRaw":"6.75","favorites":31,"members":245,"views":23023,"episodesCountRaw":12,"episodesLength":25},"flags":{"dub":0,"alwaysHome":0},"meta":{"day":"Giovedì","season":"Autunno","status":"Terminato","type":"TV","createdAt":"2019-05-03 16:33:25","userId":78495},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-30T07:57:40Z","sourceDescriptors":["anilist:101373","mal:37584"],"targets":[{"pr