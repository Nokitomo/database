co/anime/nx101373-qpJIXrKofqON.jpg","type":"TV","year":"2018","dubStatus":"subbed","dubStatusKey":"Subbed","variants":[{"status":"subbed","statusKey":"Subbed","title":"BAKUMATSU: Renai Bakumatsu Kareshi Gaiden","link":"/anime/592-bakumatsu-renai-bakumatsu-kareshi-gaiden","image":"https://img.animeunity.co/anime/nx101373-qpJIXrKofqON.jpg"}]},{"title":"Bakumatsu Crisis","link":"/anime/765-bakumatsu-crisis","image":"https://img.animeunity.co/anime/bx106568-h1OtYxFbceNt.jpg","type":"TV","year":"2019","dubStatus":"subbed","dubStatusKey":"Subbed","variants":[{"status":"subbed","statusKey":"Subbed","title":"Bakumatsu Crisis","link":"/anime/765-bakumatsu-crisis","image":"https://img.animeunity.co/anime/bx106568-h1OtYxFbceNt.jpg"}]}],"linkList":[{"title":"Episodes 1-12","titleKey":"Episodes {{start}}-{{end}}","titleParams":{"start":1,"end":12},"availabilityStatus":"available","episodesLink":"592|1|12"}]},"episodes":[{"title":"Episodio 1","episodeNumber":1,"sourceEpisodeNumber":1,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"13971","scope":"R","episodeNumbers":[1]},{"provider":"anilist","id":"101373","episodeNumbers":[1]},{"provider":"mal","id":"37584","episodeNumbers":[1]},{"provider":"tmdb_show","id":"82846","scope":"s1","seasonNumber":1,"episodeNumbers":[1]},{"provider":"tvdb_show","id":"352679","scope":"s1","seasonNumber":1,"episodeNumbers":[1]}],"link":"13569","synopsis":"時は幕末。日の本の未来を憂い、各々の信念に従い突き進む志士たちが魂を燃やす時代。長州の風雲児・高杉晋作は、相棒の桂小五郎とともに幕府海軍船に潜り込もうとしていた。目指すは「刻(とき)を操る力」があるという伝説の秘宝、“時辰儀(じしんぎ)”。他ならぬ幕府がその力を我が物にせんとしていると耳にした高杉は、『そんなやり方、つまんねぇ！』と時辰儀を破壊しようとするが――。","thumbnail":"https://image.tmdb.org/t/p/w300/tSRBgZXaUZh67hHgO6bPWOLtbLl.jpg","metadataSources":{"tmdb":{"title":"Episodio 1","synopsis":"時は幕末。日の本の未来を憂い、各々の信念に従い突き進む志士たちが魂を燃やす時代。長州の風雲児・高杉晋作は、相棒の桂小五郎とともに幕府海軍船に潜り込もうとしていた。目指すは「刻(とき)を操る力」があるという伝説の秘宝、“時辰儀(じしんぎ)”。他ならぬ幕府がその力を我が物にせんとしていると耳にした高杉は、『そんなやり方、つまんねぇ！』と時辰儀を破壊しようとするが――。","thumbnail":"https://image.tmdb.org/t/p/w300/tSRBgZXaUZh67hHgO6bPWOLtbLl.jpg","titleLanguage":"it-IT","synopsisLanguage":"ja-JP"}}},{"title":"Episodio 2","episodeNumber":2,"sourceEpisodeNumber":2,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"13971","scope":"R","episodeNumbers":[2]},{"provider":"anilist","id":"101373","episodeNumbers":[2]},{"provider":"mal","id":"37584","episodeNumbers":[2]},{"provider":"tmdb_show","id":"82846","scope":"s1","seasonNumber":1,"episodeNumbers":[2]},{"provider":"tvdb_show","id":"352679","scope":"s1","seasonNumber":1,"episodeNumbers":[2]}],"link":"13568","synopsis":"巨城スサノオ内にて高杉が対峙したのは、刻（とき）を超え連れてこられたスサノオ・十二将の一人、真田幸村だった。高杉は城深くの工場で、先進的に発達した文明技術の陰で、依然として虐げられる民の姿を見る。さらに無限斎の口から唐突に発せられる、高杉の師・吉田松陰の言葉。激昂した高杉は、無限斎に激闘を挑みかけるが――。一方城外では、それぞれの大切なものを守るために、動き出す志士たちの姿があった――。","thumbnail":"https://image.tmdb.org/t/p/w300/mKpnZLF4ZTHkkNNYGGUBHnvmy0z.jpg","metadataSources":{"tmdb":{"title":"Episodio 2","synopsis":"巨城スサノオ内にて高杉が対峙したのは、刻（とき）を超え連れてこられたスサノオ・十二将の一人、真田幸村だった。高杉は城深くの工場で、先進的に発達した文明技術の陰で、依然として虐げられる民の姿を見る。さらに無限斎の口から唐突に発せられる、高杉の師・吉田松陰の言葉。激昂した高杉は、無限斎に激闘を挑みかけるが――。一方城外では、それぞれの大切なものを守るために、動き出す志士たちの姿があった――。","thumbnail":"https://image.tmdb.org/t/p/w300/mKpnZLF4ZTHkkNNYGGUBHnvmy0z.jpg","titleLanguage":"it-IT","synopsisLanguage":"ja-JP"}}},{"title":"Episodio 3","episodeNumber":3,"sourceEpisodeNumber":3,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"13971","scope":"R","episodeNumbers":[3]},{"provider":"anilist","id":"101373","episodeNumbers":[3]},{"provider":"mal","id":"37584","episodeNumbers":[3]},{"provider":"tmdb_show","id":"82846","scope":"s1","seasonNumber":1,"episodeNumbers":[3]},{"provider":"tvdb_show","id":"352679","scope":"s1","seasonNumber":1,"episodeNumbers":[3]}],"link":"13571","synopsis":"巨城スサノオから脱出した高杉は桂、坂本、以蔵と合流する。坂本は、時辰儀と同じ「刻（とき）を渡る力」を持つ「晴明(せいめい)」という男を探しているという。晴明の力で刻を戻し、新時代を作ると息巻く坂本に対し、高杉は反発。意見の衝突からアジトを去る坂本に対し、高杉は長崎でのある記憶を思い出す。一方、京の町を詮索中だった坂本と以蔵の前に、渦中の人物・晴明が現れ――。","thumbnail":"https://image.tmdb.org/t/p/w300/u2hGjY0XoONpWK9XYofEEQzXItk.jpg","metadataSources":{"tmdb":{"title":"Episodio 3","synopsis":"巨城スサノオから脱出した高杉は桂、坂本、以蔵と合流する。坂本は、時辰儀と同じ「刻（とき）を渡る力」を持つ「晴明(せいめい)」という男を探しているという。晴明の力で刻を戻し、新時代を作ると息巻く坂本に対し、高杉は反発。意見の衝突からアジトを去る坂本に対し、高杉は長崎でのある記憶を思い出す。一方、京の町を詮索中だった坂本と以蔵の前に、渦中の人物・晴明が現れ――。","thumbnail":"https://image.tmdb.org/t/p/w300/u2hGjY0XoONpWK9XYofEEQzXItk.jpg","titleLanguage":"it-IT","synopsisLanguage":"ja-JP"}}},{"title":"Episodio 4","episodeNumber":4,"sourceEpisodeNumber":4,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"13971","scope":"R","episodeNumbers":[4]},{"provider":"anilist","id":"101373","episodeNumbers":[4]},{"provider":"mal","id":"37584","episodeNumbers":[4]},{"provider":"tmdb_show","id":"82846","scope":"s1","seasonNumber":1,"episodeNumbers":[4]},{"provider":"tvdb_show","id":"352679","scope":"s1","seasonNumber":1,"episodeNumbers":[4]}],"link":"13567","synopsis":"潜伏中の刀鍛冶屋にて、町民が圧政に苦しむ様を間近で見た桂は、改めて一日も早く無限斎の手から時辰儀を奪い返し、恐怖から町民を解放したいと心に誓う。そこで「いい考えがある」と高杉が提案したのは、新撰組に入隊するという作戦だった！見事入隊の剣術試験を突破し、近藤、土方、沖田らに認められ、晴れて新選組隊士となった桂は、偽りの新選組隊士生活を開始することになり――。","thumbnail":"https://image.tmdb.org/t/p/w300/8VT1dPFv0AbFONH5H9yJxm6R4pu.jpg","metadataSources":{"tmdb":{"title":"Episodio 4","synopsis":"潜伏中の刀鍛冶屋にて、町民が圧政に苦しむ様を間近で見た桂は、改めて一日も早く無限斎の手から時辰儀を奪い返し、恐怖から町民を解放したいと心に誓う。そこで「いい考えがある」と高杉が提案したのは、新撰組に入隊するという作戦だった！見事入隊の剣術試験を突破し、近藤、土方、沖田らに認められ、晴れて新選組隊士となった桂は、偽りの新選組隊士生活を開始することになり――。","thumbnail":"https://image.tmdb.org/t/p/w300/8VT1dPFv0AbFONH5H9yJxm6R4pu.jpg","titleLanguage":"it-IT","synopsisLanguage":"ja-JP"}}},{"title":"Episodio 5","episodeNumber":5,"sourceEpisodeNumber":5,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"13971","scope":"R","episodeNumbers":[5]},{"provider":"anilist","id":"101373","episodeNumbers":[5]},{"provider":"mal","id":"37584","episodeNumbers":[5]},{"provider":"tmdb_show","id":"82846","scope":"s1","seasonNumber":1,"episodeNumbers":[5]},{"provider":"tvdb_show","id":"352679","scope":"s1","seasonNumber":1,"episodeNumbers":[5]}],"link":"13572","synopsis":"スサノオ城内に侵入した坂本と以蔵は、新撰組隊士らと対峙する。以蔵の一撃を受け止めた桂は、咄嗟に近藤を逃がし、その場をやり過ごす。以蔵が去った後、桂は沖田に正体を暴かれ、二人の真剣勝負が始まる。一方、同じくスサノオ城内座敷牢にて、囚われている帝（みかど）と出会った高杉。その正体が誰とも知らず、一心に座敷牢から救い出そうと試みる高杉に、帝は無限斎のいる部屋への道順を教えることになり――。","thumbnail":"https://image.tmdb.org/t/p/w300/3o5RVZJsxP4SnlotZFVl8BdJcYV.jpg","metadataSources":{"tmdb":{"title":"Episodio 5","synopsis":"スサノオ城内に侵入した坂本と以蔵は、新撰組隊士らと対峙する。以蔵の一撃を受け止めた桂は、咄嗟に近藤を逃がし、その場をやり過ごす。以蔵が去った後、桂は沖田に正体を暴かれ、二人の真剣勝負が始まる。一方、同じくスサノオ城内座敷牢にて、囚われている帝（みかど）と出会った高杉。その正体が誰とも知らず、一心に座敷牢から救い出そうと試みる高杉に、帝は無限斎のいる部屋への道順を教えることになり――。","thumbnail":"https://image.tmdb.org/t/p/w300/3o5RVZJsxP4SnlotZFVl8BdJcYV.jpg","titleLanguage":"it-IT","synopsisLanguage":"ja-JP"}}},{"title":"Episodio 6","episodeNumber":6,"sourceEpisodeNumber":6,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"13971","scope":"R","episodeNumbers":[6]},{"provider":"anilist","id":"101373","episodeNumbers":[6]},{"provider":"mal","id":"37584","episodeNumbers":[6]},{"provider":"tmdb_show","id":"82846","scope":"s1","seasonNumber":1,"episodeNumbers":[6]},{"provider":"tvdb_show","id":"352679","scope":"s1","seasonNumber":1,"episodeNumbers":[6]}],"link":"13570","synopsis":"慶喜と烝は御庭番の霞と、潜伏先の鞍馬寺にて、束の間の平穏な日々を過ごしていた。ある日、囚われの帝を警護すべく“巨城スサノオ”に潜入していた雹から、伝令のフクロウ“ずんだ丸”により密書が届く。書かれていたのは、無限斎が時辰儀の力を現在使えない事と、一刻も早く“晴明”を見つけ出して安全な場所に匿う事。そんな慶喜らの前に、スサノオ十二将の一人、武蔵坊弁慶が立ちはだかり――。","thumbnail":"https://image.tmdb.org/t/p/w300/2OSh5KdyOgdbVFicxNcULOqKSlo.jpg","metadataSources":{"tmdb":{"title":"Episodio 6","synopsis":"慶喜と烝は御庭番の霞と、潜伏先の鞍馬寺にて、束の間の平穏な日々を過ごしていた。ある日、囚われの帝を警護すべく“巨城スサノオ”に潜入していた雹から、伝令のフクロウ“ずんだ丸”により密書が届く。書かれていたのは、無限斎が時辰儀の力を現在使えない事と、一刻も早く“晴明”を見つけ出して安全な場所に匿う事。そんな慶喜らの前に、スサノオ十二将の一人、武蔵坊弁慶が立ちはだかり――。","thumbnail":"https://image.tmdb.org/t/p/w300/2OSh5KdyOgdbVFicxNcULOqKSlo.jpg","titleLanguage":"it-IT","synopsisLanguage":"ja-JP"}}},{"title":"Episodio 7","episodeNumber":7,"sourceEpisodeNumber":7,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"13971","scope":"R","episodeNumbers":[7]},{"provider":"anilist","id":"101373","episodeNumbers":[7]},{"provider":"mal","id":"37584","episodeNumbers":[7]},{"provider":"tmdb_show","id":"82846","scope":"s1","seasonNumber":1,"episodeNumbers":[7]},{"provider":"tvdb_show","id":"352679","scope":"s1","seasonNumber":1,"episodeNumbers":[7]}],"link":"15528","synopsis":"高杉と桂は、武器弾薬をスサノオ城に運ぶ蒸気機関車を発見する。偵察のため一路、二人は大坂へ。しかし到着早々、新撰組一番隊組長・沖田に見つかってしまう。咄嗟に機関車に潜り込むも、そこには宿敵、新撰組副長・土方がいた！土方は高杉を容赦なく足蹴にし、列車から突き落としてしまう。幼い頃から行動をともにしてきた高杉と桂。そんな二人を引き裂く絶体絶命のピンチが、鉄の線路上で繰り広げられる――。","thumbnail":"https://image.tmdb.org/t/p/w300/aV5CyFmkDBwanKmPc13rsg3eX0u.jpg","metadataSources":{"tmdb":{"title":"Episodio 7","synopsis":"高杉と桂は、武器弾薬をスサノオ城に運ぶ蒸気機関車を発見する。偵察のため一路、二人は大坂へ。しかし到着早々、新撰組一番隊組長・沖田に見つかってしまう。咄嗟に機関車に潜り込むも、そこには宿敵、新撰組副長・土方がいた！土方は高杉を容赦なく足蹴にし、列車から突き落としてしまう。幼い頃から行動をともにしてきた高杉と桂。そんな二人を引き裂く絶体絶命のピンチが、鉄の線路上で繰り広げられる――。","thumbnail":"https://image.tmdb.org/t/p/w300/aV5CyFmkDBwanKmPc13rsg3eX0u.jpg","titleLanguage":"it-IT","synopsisLanguage":"ja-JP"}}},{"title":"Episodio 8","episodeNumber":8,"sourceEpisodeNumber":8,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"13971","scope":"R","episodeNumbers":[8]},{"provider":"anilist","id":"101373","episodeNumbers":[8]},{"provider":"mal","id":"37584","episodeNumbers":[8]},{"provider":"tmdb_show","id":"82846","scope":"s1","seasonNumber":1,"episodeNumbers":[8]},{"provider":"tvdb_show","id":"352679","scope":"s1","seasonNumber":1,"episodeNumbers":[8]}],"link":"15529","synopsis":"広大な池に囲まれた金色の舎利殿“金閣寺”。坂本は以蔵とそこに無限斎を呼び出し、とある大胆な取引を持ちかけていた！だがそんな坂本らを抹殺するため、秘密裏に迫る沖田・斎藤ほか新撰組の影。無限斎は、坂本がちらつかせる“時辰儀の力”を試すため、新撰組を使って以蔵を人質にし、そして無慈悲にも真っ逆さまに池へと沈めてしまう――。薄れゆく意識の中、以蔵は走馬灯のように坂本との過去を想起する。","thumbnail":"https://image.tmdb.org/t/p/w300/lJYm0wJXmECYseFGxNsi4HENULd.jpg","metadataSources":{"tmdb":{"title":"Episodio 8","synopsis":"広大な池に囲まれた金色の舎利殿“金閣寺”。坂本は以蔵とそこに無限斎を呼び出し、とある大胆な取引を持ちかけていた！だがそんな坂本らを抹殺するため、秘密裏に迫る沖田・斎藤ほか新撰組の影。無限斎は、坂本がちらつかせる“時辰儀の力”を試すため、新撰組を使って以蔵を人質にし、そして無慈悲にも真っ逆さまに池へと沈めてしまう――。薄れゆく意識の中、以蔵は走馬灯のように坂本との過去を想起する。","thumbnail":"https://image.tmdb.org/t/p/w300/lJYm0wJXmECYseFGxNsi4HENULd.jpg","titleLanguage":"it-IT","synopsisLanguage":"ja-JP"}}},{"title":"Episodio 9","episodeNumber":9,"sourceEpisodeNumber":9,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"13971","scope":"R","episodeNumbers":[9]},{"provider":"anilist","id":"101373","episodeNumbers":[9]},{"provider":"mal","id":"37584","episodeNumbers":[9]},{"provider":"tmdb_show","id":"82846","scope":"s1","seasonNumber":1,"episodeNumbers":[9]},{"provider":"tvdb_show","id":"352679","scope":"s1","seasonNumber":1,"episodeNumbers":[9]}],"link":"15631","synopsis":"慶喜たちは、「琵琶湖の西で、晴明が見つかった」という知らせを受け、救出のため目的地へ急ぐ。無限斎の配下になることを決めた近藤と袂を分かち、新撰組を去った山崎だったが、運命に導かれるように近藤と再会する。一方、対からくり人形装置を完成させた高杉と桂だったが、アジトに戻ったところ、土方ら新撰組に突入・捕縛されてしまう。飛行船の中で目を覚ました高杉の前には、無限斎の姿が――。","thumbnail":"https://image.tmdb.org/t/p/w300/hOotIaIfSGamIczeGDROw61Efzo.jpg","metadataSources":{"tmdb":{"title":"Episodio 9","synopsis":"慶喜たちは、「琵琶湖の西で、晴明が見つかった」という知らせを受け、救出のため目的地へ急ぐ。無限斎の配下になることを決めた近藤と袂を分かち、新撰組を去った山崎だったが、運命に導かれるように近藤と再会する。一方、対からくり人形装置を完成させた高杉と桂だったが、アジトに戻ったところ、土方ら新撰組に突入・捕縛されてしまう。飛行船の中で目を覚ました高杉の前には、無限斎の姿が――。","thumbnail":"https://image.tmdb.org/t/p/w300/hOotIaIfSGamIczeGDROw61Efzo.jpg","titleLanguage":"it-IT","synopsisLanguage":"ja-JP"}}},{"title":"Episodio 10","episodeNumber":10,"sourceEpisodeNumber":10,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"13971","scope":"R","episodeNumbers":[10]},{"provider":"anilist","id":"101373","episodeNumbers":[10]},{"provider":"mal","id":"37584","episodeNumbers":[10]},{"provider":"tmdb_show","id":"82846","scope":"s1","seasonNumber":1,"episodeNumbers":[10]},{"provider":"tvdb_show","id":"352679","scope":"s1","seasonNumber":1,"episodeNumbers":[10]}],"link":"15632","synopsis":"ついに晴明を発見した、近藤・沖田・斎藤。棺に入った晴明を連れ、飛行船に乗り込むも嵐に襲われ、不時着を余儀なくされる。たどり着いたのは、反逆者や罪人を収容するために無限斎が作った、琵琶湖に浮かぶ囚人だらけの島、獄門島だった。そこで“黒ヘビ”と名乗る謎の男に導かれ、危機を脱した近藤達。男の正体は、無限斎によって飛行船から落とされ先に入島していた、高杉晋作だった。島から脱出するため、手を組むこととなった四人の運命は！？","thumbnail":"https://image.tmdb.org/t/p/w300/3aTgb7KPdk5zySTGLoAMWTXBMFi.jpg","metadataSources":{"tmdb":{"title":"Episodio 10","synopsis":"ついに晴明を発見した、近藤・沖田・斎藤。棺に入った晴明を連れ、飛行船に乗り込むも嵐に襲われ、不時着を余儀なくされる。たどり着いたのは、反逆者や罪人を収容するために無限斎が作った、琵琶湖に浮かぶ囚人だらけの島、獄門島だった。そこで“黒ヘビ”と名乗る謎の男に導かれ、危機を脱した近藤達。男の正体は、無限斎によって飛行船から落とされ先に入島していた、高杉晋作だった。島から脱出するため、手を組むこととなった四人の運命は！？","thumbnail":"https://image.tmdb.org/t/p/w300/3aTgb7KPdk5zySTGLoAMWTXBMFi.jpg","titleLanguage":"it-IT","synopsisLanguage":"ja-JP"}}},{"title":"Episodio 11","episodeNumber":11,"sourceEpisodeNumber":11,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"13971","scope":"R","episodeNumbers":[11]},{"provider":"anilist","id":"101373","episodeNumbers":[11]},{"provider":"mal","id":"37584","episodeNumbers":[11]},{"provider":"tmdb_show","id":"82846","scope":"s1","seasonNumber":1,"episodeNumbers":[11]},{"provider":"tvdb_show","id":"352679","scope":"s1","seasonNumber":1,"episodeNumbers":[11]}],"link":"15946","synopsis":"獄門島での勝負の後、突如宙に浮かび光を放った晴明の身体。光の奔流に飲み込まれた高杉が目を覚ますと、そこは安政五年、萩の城下町だった。吉田松陰をはじめ懐かしの同門生・久坂玄端、伊藤俊輔らに再会する。一方、同じく光に飲み込まれた桂は、その中で晴明に出会う。そして高杉は再び刻を超え、安政六年、吉田松陰の処刑瞬間に飛ばされてしまう。今なら松陰先生を救える、だがそれでは無限斎と同じ――。葛藤に揺れ動く高杉の前に現れたのは。","thumbnail":"https://image.tmdb.org/t/p/w300/hiYtOrCNPsHcCjB6Rt4JOMz3Hut.jpg","metadataSources":{"tmdb":{"title":"Episodio 11","synopsis":"獄門島での勝負の後、突如宙に浮かび光を放った晴明の身体。光の奔流に飲み込まれた高杉が目を覚ますと、そこは安政五年、萩の城下町だった。吉田松陰をはじめ懐かしの同門生・久坂玄端、伊藤俊輔らに再会する。一方、同じく光に飲み込まれた桂は、その中で晴明に出会う。そして高杉は再び刻を超え、安政六年、吉田松陰の処刑瞬間に飛ばされてしまう。今なら松陰先生を救える、だがそれでは無限斎と同じ――。葛藤に揺れ動く高杉の前に現れたのは。","thumbnail":"https://image.tmdb.org/t/p/w300/hiYtOrCNPsHcCjB6Rt4JOMz3Hut.jpg","titleLanguage":"it-IT","synopsisLanguage":"ja-JP"}}},{"title":"Episodio 12","episodeNumber":12,"sourceEpisodeNumber":12,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"13971","scope":"R","episodeNumbers":[12]},{"provider":"anilist","id":"101373","episodeNumbers":[12]},{"provider":"mal","id":"37584","episodeNumbers":[12]},{"provider":"tmdb_show","id":"82846","scope":"s1","seasonNumber":1,"episodeNumbers":[12]},{"provider":"tvdb_show","id":"352679","scope":"s1","seasonNumber":1,"episodeNumbers":[12]}],"link":"15947","synopsis":"刻の奔流の中で無限斎の正体を目の当たりにした高杉と桂。目指すは決戦の地、巨城スサノオ。いつものごとく高杉を諌める桂と、坂本、慶喜らの姿があった。一方城内では、近藤たち新撰組も各々に動きを見せる。さらに時辰儀からはまるで『意思』を持つかのように、不気味な瘴気が黒く立ち上り始める。そんな中突如スサノオ城に轟音が鳴り響き渡り――。今、激動を生きる志士たちのイキザマを懸けた戦いが、ついに最終局面を迎える！","thumbnail":"https://image.tmdb.org/t/p/w300/aa6HriXYzVwMuUNZfCigc7oFv2k.jpg","metadataSources":{"tmdb":{"title":"Episodio 12","synopsis":"刻の奔流の中で無限斎の正体を目の当たりにした高杉と桂。目指すは決戦の地、巨城スサノオ。いつものごとく高杉を諌める桂と、坂本、慶喜らの姿があった。一方城内では、近藤たち新撰組も各々に動きを見せる。さらに時辰儀からはまるで『意思』を持つかのように、不気味な瘴気が黒く立ち上り始める。そんな中突如スサノオ城に轟音が鳴り響き渡り――。今、激動を生きる志士たちのイキザマを懸けた戦いが、ついに最終局面を迎える！","thumbnail":"https://image.tmdb.org/t/p/w300/aa6HriXYzVwMuUNZfCigc7oFv2k.jpg","titleLanguage":"it-IT","synopsisLanguage":"ja-JP"}}}],"sourceIds":{"anilistId":101373,"malId":37584},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-30T07:57:40Z","sourceDescriptors":["anilist:101373","mal:37584"],"targets":[{"provider":"anidb","id":"13971","scope":"R","ranges":{"1-12":"1-12"}},{"provider":"anilist","id":"101373","ranges":{"1-12":"1-12"}},{"provider":"mal","id":"37584","ranges":{"1-12":"1-12"}},{"provider":"tmdb_show","id":"82846","scope":"s1","ranges":{"1-12":"1-12"}},{"provider":"tvdb_show","id":"352679","scope":"s1","ranges":{"1-12":"1-12"}}]},"sourceMetadata":{"info":{"id":592,"title":"Bakumatsu","title_eng":"BAKUMATSU: Renai Bakumatsu Kareshi Gaiden","slug":"bakumatsu-renai-bakumatsu-kareshi-gaiden","plot":"Periodo Bakumatsu (1853-1867), ultimi anni dell’epoca Edo, periodo che segna la fine della politica isolazionista del Giappone, nonché il passaggio dal sistema feudale dello shogunato al governo Meiji, con la fine dello shogunato Tokugawa. L’anime ha per protagoniste figure storiche realmente esistite in versione bishounen, e, a differenza del dating-sim da cui è tratta, abbondonerà il lato “romantico” per focalizzarsi sul genere fantascientifico d’azione ed avventura.","type":"TV","status":"Terminato","date":"2018","studio":"Studio DEEN","dub":0,"mal_id":37584,"anilist_id":101373,"imageurl":"https://img.ani