{"id":3608,"path":"/anime/3608-alice-zoroku","linkSchemaVersion":2,"enrichmentSchemaVersion":2,"updatedAt":"2026-10-31T09:13:04.333Z","episodeSafetyVersion":1,"info":{"title":"Alice & Zoroku","synopsis":"Un gruppo di ragazze possiede un misterioso potere che permette loro di materializzare i propri pensieri. Vengono rinchiuse in segreto a subire esperimenti, finché una di loro non riesce a scappare. Si chiama Sana e ha il potere di ignorare le leggi della fisica. Quando questa ragazza ostinata ed energica incontra un anziano testardo di nome Zoroku, la vita di quest'ultimo non sarà  più la stessa!","image":"https://image.tmdb.org/t/p/original/sbbFPTCOHJmh09cWgWZisjJNoJi.jpg","poster":"https://image.tmdb.org/t/p/original/aIMFRaIom9DrmizyIGxtTGYYwbj.jpg","logo":"https://image.tmdb.org/t/p/original/vVb2lXEmN811OcvDE0W1OaWbzXb.png","background":"https://image.tmdb.org/t/p/original/sbbFPTCOHJmh09cWgWZisjJNoJi.jpg","trailers":["https://www.youtube.com/watch?v=LZC_AtsF2Y4"],"imdbId":"tt6735466","type":"series","tags":["TV","Terminato","Primavera","2017"],"tagKeys":{"TV":"TV","Terminato":"Completed","Primavera":"Spring"},"genres":["Action","Adventure","Fantasy","Mystery","Sci-fi","Seinen","Supernatural"],"rating":"7.2","studio":"J.C.Staff","episodesCount":12,"extra":{"ids":{"malId":34350,"anilistId":97821,"crunchyId":null,"disneyId":null,"netflixId":null,"primeId":null,"anilistIds":[97821],"malIds":[34350],"anidbIds":[12526],"imdbMovieIds":[],"imdbShowIds":[],"tmdbMovieIds":[],"tmdbShowIds":[70594],"tvdbMovieIds":[],"tvdbShowIds":[324709]},"stats":{"scoreRaw":"7.24","favorites":32,"members":366,"views":22773,"episodesCountRaw":12,"episodesLength":25},"flags":{"dub":0,"alwaysHome":0},"meta":{"day":"Domenica","season":"Primavera","status":"Terminato","type":"TV","createdAt":"2022-03-11 01:00:10","userId":78495},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-30T07:57:40Z","sourceDescriptors":["anilist:97821","mal:34350"],"imdbSource":"plexan