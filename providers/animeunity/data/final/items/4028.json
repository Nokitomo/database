/anime/6380-BJMpFfo3Y56B.jpg","cover":null,"score":"7.25","episodes_count":1,"genres":["Action","Comedy","Sci-fi","Seinen"],"related":[{"id":4026,"title":"Tetsuwan Birdy","title_eng":"Birdy the Mighty","type":"OVA","date":"1996","episodes_count":4},{"id":4025,"title":"Tetsuwan Birdy Decode","title_eng":"Birdy the Mighty: Decode","type":"TV","date":"2008","episodes_count":13},{"id":4027,"title":"Tetsuwan Birdy Decode:02","title_eng":"Birdy the Mighty: Decode 02","type":"TV","date":"2009","episodes_count":12},{"id":4028,"title":"Tetsuwan Birdy Decode: The Cipher","title_eng":"Birdy the Mighty: Decode OVA","type":"OVA","date":"2009","episodes_count":1}]},"embedded":{"id":4028,"user_id":78495,"title":"Tetsuwan Birdy Decode: The Cipher","imageurl":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/bx6380-jSQ4Kg2jfEQk.jpg","plot":"OVA di Tetsuwan Birdy Decode","date":"2009","episodes_count":1,"episodes_length":27,"author":" ","created_at":"2022-09-18 12:50:10","status":"Terminato","imageurl_cover":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/6380-BJMpFfo3Y56B.jpg","type":"OVA","slug":"birdy-the-mighty-decode-ova","title_eng":"Birdy the Mighty: Decode OVA","day":"Indeterminato","favorites":11,"score":"7.25","visite":7104,"studio":"A-1 Pictures","dub":0,"always_home":0,"members":37,"cover":null,"anilist_id":6380,"season":"Estate","title_it":null,"mal_id":6380,"crunchy_id":null,"netflix_id":null,"prime_id":null,"disney_id":null,"genres":[{"id":51,"name":"Action","pivot":{"anime_id":4028,"genre_id":51}},{"id":37,"name":"Comedy","pivot":{"anime_id":4028,"genre_id":37}},{"id":40,"name":"Sci-fi","pivot":{"anime_id":4028,"genre_id":40}},{"id":49,"name":"Seinen","pivot":{"anime_id":4028,"genre_id":49}}],"related":[{"id":4026,"user_id":78495,"title":"Tetsuwan Birdy","imageurl":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/b566-o7Btb4cx4Ku4.png","plot":"Tsutomu Senkawa è un ragazzo che sta studiando per gli esami di ammissione al liceo. La notte prima dell'esame esce a farsi un giro per prendere un po' di aria fresca quando si imbatte in uno strano tipo che sta scappando da qualcuno e gli chiede di aiutarlo a nascondersi. Purtroppo per lui, il tizio in questione non è una persona qualunque come potrebbe sembrare, ma è un criminale alieno in fuga da Birdy, un'agente della Federazione Spaziale con il compito di catturarlo. Ma la parte peggiore è che lo usa come diversivo scagliandolo contro alla sua inseguitrice che reagisce istintivamente e lo uccide fulminandolo. Fortunatamente per lui c'è un modo per porre rimedio a questo pasticcio e tenerlo in vita, anche se questa soluzione consiste nel fondere assieme il suo corpo con quello di Birdy. Così il povero Tsutomu si ritrova a dividere il corpo con una bella e impulsiva poliziotta spaziale, cercando in qualche modo di continuare la sua normale vita da studente e nascondendo allo stesso tempo questa situazione alla sua apatica famiglia e alla sua amica Natsumi. Tutto sommato però questi problemi sono abbastanza irrilevanti, considerando il fatto che Birdy deve continuare il suo lavoro, coinvolgendolo negli inseguimenti di criminali alieni e scontri con pericolosi robot assassini. Ma quello che è peggio è che a Tokyo si sta nascondendo Christella Revi, una criminale intergalattica che, assieme allo scienziato terrestre Hikawa, sta pianificando di utilizzare gli ignari abitanti della città come cavie per qualche strano esperimento genetico.","date":"1996","episodes_count":4,"episodes_length":33,"author":" ","created_at":"2022-09-18 12:46:26","status":"Terminato","imageurl_cover":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/n566-lE7xa0XONTiw.jpg","type":"OVA","slug":"birdy-the-mighty","title_eng":"Birdy the Mighty","day":"Indeterminato","favorites":28,"score":"7.21","visite":14581,"studio":"Madhouse","dub":0,"always_home":0,"members":182,"cover":null,"anilist_id":566,"season":"Estate","title_it":null,"mal_id":566,"crunchy_id":null,"netflix_id":null,"prime_id":null,"disney_id":null,"pivot":{"anime_id":4028,"related_id":4026,"number":1}},{"id":4025,"user_id":78495,"title":"Tetsuwan Birdy Decode","imageurl":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/bx3974-Gb9WK53nSsPz.png","plot":"Birdy Cephon Altera è un ispettore della Federazione Spaziale incaricata di inseguire e catturare i criminali interplanetari. Seguendo le tracce di un ricercato di nome Geega che le è sfuggito, Birdy arriva sul pianeta Terra dove l'alieno si sta nascondendo. Il modo più semplice per continuare le indagini senza dare nell'occhio è quello di mimetizzarsi con la popolazione, così decide di assumere l'identità di Arita Shion, finendo per trovare lavoro come idol. Sono armai passati diversi mesi da quando Birdy si è stabilita a Tokyo ma, nonostante sia diventata una idol piuttosto popolare, non è ancora riuscita ad individuare il suo bersaglio. Però, quando ormai sembra aver perso tutte le speranze, un informatore le rivela il luogo dove potrebbe nascondersi Geega. La ragazza non se lo fa ripetere due volete e decide di tendergli un'imboscata. Purtroppo, durante lo scontro con il criminale, finisce per uccidere accidentalmente un liceale di nome Tsutomu Senkawa. Fortunatamente c'è un modo per rimediare a questo grave errore e tenere in vita Tsutomu, ma questo richiede di ospitare la sua coscienza nel corpo di Birdy, almeno finché il corpo del ragazzo non sarà stato ricostruito. Tsutomu si trova così a dover dividere il corpo con questa bella poliziotta spaziale e, mentre lui cerca in qualche modo di continuare la sua normale vita da studente, Birdy deve continuare le indagini sui criminali alieni che si nascondono sulla Terra... ma le due cose non sempre vanno d'accordo.","date":"2008","episodes_count":13,"episodes_length":24,"author":" ","created_at":"2022-09-18 12:44:05","status":"Terminato","imageurl_cover":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/3974-oWzLMiXRWyS0.jpg","type":"TV","slug":"birdy-the-mighty-decode","title_eng":"Birdy the Mighty: Decode","day":"Indeterminato","favorites":22,"score":"6.95","visite":15988,"studio":"A-1 Pictures","dub":0,"always_home":0,"members":164,"cover":null,"anilist_id":3974,"season":"Estate","title_it":null,"mal_id":3974,"crunchy_id":null,"netflix_id":null,"prime_id":null,"disney_id":null,"pivot":{"anime_id":4028,"related_id":4025,"number":1}},{"id":4027,"user_id":78495,"title":"Tetsuwan Birdy Decode:02","imageurl":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/bx5074-2pMtem2bC5K9.png","plot":"Seconda stagione di Tetsuwan Birdy Decode","date":"2009","episodes_count":12,"episodes_length":23,"author":" ","created_at":"2022-09-18 12:47:50","status":"Terminato","imageurl_cover":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/5074-G7PGo4ZBZpL8.jpg","type":"TV","slug":"birdy-the-mighty-decode-02","title_eng":"Birdy the Mighty: Decode 02","day":"Indeterminato","favorites":7,"score":"7.54","visite":10554,"studio":"A-1 Pictures","dub":0,"always_home":0,"members":49,"cover":null,"anilist_id":5074,"season":"Inverno","title_it":null,"mal_id":5074,"crunchy_id":null,"netflix_id":null,"prime_id":null,"disney_id":null,"pivot":{"anime_id":4028,"related_id":4027,"number":1}},{"id":4028,"user_id":78495,"title":"Tetsuwan Birdy Decode: The Cipher","imageurl":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/bx6380-jSQ4Kg2jfEQk.jpg","plot":"OVA di Tetsuwan Birdy Decode","date":"2009","episodes_count":1,"episodes_length":27,"author":" ","created_at":"2022-09-18 12:50:10","status":"Terminato","imageurl_cover":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/6380-BJMpFfo3Y56B.jpg","type":"OVA","slug":"birdy-the-mighty-decode-ova","title_eng":"Birdy the Mighty: Decode OVA","day":"Indeterminato","favorites":11,"score":"7.25","visite":7104,"studio":"A-1 Pictures","dub":0,"always_home":0,"members":37,"cover":null,"anilist_id":6380,"season":"Estate","title_it":null,"mal_id":6380,"crunchy_id":null,"ne