4578","scope":"s1","seasonNumber":1,"episodeNumbers":[2]},{"provider":"tvdb_show","id":"160911","scope":"s1","seasonNumber":1,"episodeNumbers":[2]}],"link":"32112","synopsis":"While stealing the Angel Crown, Inspector Nakamori catches a glimpse of Kaito's face while in his disguise as Kaitou Kid. Determined to prove to her father Kaito isn't Kid, Aoko convinces Kaito to go on a date with her to Tropical Land at the same time Kid's next heist is to take place.","thumbnail":"https://image.tmdb.org/t/p/w300/p7iiTpriXkwMmay3zWj4wtQ9lER.jpg","metadataSources":{"tmdb":{"title":"Episodio 2","synopsis":"While stealing the Angel Crown, Inspector Nakamori catches a glimpse of Kaito's face while in his disguise as Kaitou Kid. Determined to prove to her father Kaito isn't Kid, Aoko convinces Kaito to go on a date with her to Tropical Land at the same time Kid's next heist is to take place.","thumbnail":"https://image.tmdb.org/t/p/w300/p7iiTpriXkwMmay3zWj4wtQ9lER.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}},{"title":"Episodio 3","episodeNumber":3,"sourceEpisodeNumber":3,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"7469","scope":"R","episodeNumbers":[3]},{"provider":"anilist","id":"8310","episodeNumbers":[3]},{"provider":"mal","id":"8310","episodeNumbers":[3]},{"provider":"tmdb_show","id":"44578","scope":"s1","seasonNumber":1,"episodeNumbers":[3]},{"provider":"tvdb_show","id":"160911","scope":"s1","seasonNumber":1,"episodeNumbers":[3]}],"link":"32109","synopsis":"Princess Anne of the Duchy of Sabrina visits Japan along with her trigger-happy bodyguard Inspector Delon. While in Japan, Anne longs to meet Kaitou Kid while Delon plans to put an end to Kid once and for all. Inspector Nakamori worries that Delon will succeed and he'll lose his job chasing Kid and dream of capturing him. Kid's next heist is Princess Anne's jewel, Beaucoup de Soleil à Paris, which Anne plans to wear at a party.","thumbnail":"https://image.tmdb.org/t/p/w300/o0BM4AUpjURUTeDa7ol0E2cU03s.jpg","metadataSources":{"tmdb":{"title":"Episodio 3","synopsis":"Princess Anne of the Duchy of Sabrina visits Japan along with her trigger-happy bodyguard Inspector Delon. While in Japan, Anne longs to meet Kaitou Kid while Delon plans to put an end to Kid once and for all. Inspector Nakamori worries that Delon will succeed and he'll lose his job chasing Kid and dream of capturing him. Kid's next heist is Princess Anne's jewel, Beaucoup de Soleil à Paris, which Anne plans to wear at a party.","thumbnail":"https://image.tmdb.org/t/p/w300/o0BM4AUpjURUTeDa7ol0E2cU03s.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}},{"title":"Episodio 4","episodeNumber":4,"sourceEpisodeNumber":4,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"7469","scope":"R","episodeNumbers":[4]},{"provider":"anilist","id":"8310","episodeNumbers":[4]},{"provider":"mal","id":"8310","episodeNumbers":[4]},{"provider":"tmdb_show","id":"44578","scope":"s1","seasonNumber":1,"episodeNumbers":[4]},{"provider":"tvdb_show","id":"160911","scope":"s1","seasonNumber":1,"episodeNumbers":[4]}],"link":"32115","synopsis":"Akako Koizumi, a witch attending Kaito's school, is furious to discover that there's only one man in the world who can resist her charms: Kaitou Kid. It's Valentine's Day so all the girls in school are giving chocolates to boys they care about. Kaito notices a bunch of boys surrounding Akako and decides to ask her for a chocolate. Akako tells Kaito she'll give him one...if he throws away all of the others he's received. Kaito declines leading Akako to realize that since he managed to escape her charm, he must be the Kaitou Kid. Akako decides that if she can't have Kaito fall in love with her, then no one shall have him and plots Kid's demise on top of the Tokyo Sky Tree after a heist.","thumbnail":"https://image.tmdb.org/t/p/w300/8qCjChyV2aVFiyCGM5iOCkBqcBG.jpg","metadataSources":{"tmdb":{"title":"Episodio 4","synopsis":"Akako Koizumi, a witch attending Kaito's school, is furious to discover that there's only one man in the world who can resist her charms: Kaitou Kid. It's Valentine's Day so all the girls in school are giving chocolates to boys they care about. Kaito notices a bunch of boys surrounding Akako and decides to ask her for a chocolate. Akako tells Kaito she'll give him one...if he throws away all of the others he's received. Kaito declines leading Akako to realize that since he managed to escape her charm, he must be the Kaitou Kid. Akako decides that if she can't have Kaito fall in love with her, then no one shall have him and plots Kid's demise on top of the Tokyo Sky Tree after a heist.","thumbnail":"https://image.tmdb.org/t/p/w300/8qCjChyV2aVFiyCGM5iOCkBqcBG.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}},{"title":"Episodio 5","episodeNumber":5,"sourceEpisodeNumber":5,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"7469","scope":"R","episodeNumbers":[5]},{"provider":"anilist","id":"8310","episodeNumbers":[5]},{"provider":"mal","id":"8310","episodeNumbers":[5]},{"provider":"tmdb_show","id":"44578","scope":"s1","seasonNumber":1,"episodeNumbers":[5]},{"provider":"tvdb_show","id":"160911","scope":"s1","seasonNumber":1,"episodeNumbers":[5]}],"link":"32119","synopsis":"Aoko is upset because her father, Inspector Nakamori, will miss her birthday because he needs to chase Kid as Kid attempts to steal India's largest sapphire, The Blue Birthday. Kaito cheers her up by promising he'll perform a magic show at her birthday party. Kid successfully steals the Blue Birthday only to be stopped in his escape by a man named Snake who reveals that he killed Toichi Kuroba, the original Kaitou Kid, eight years ago.","thumbnail":"https://image.tmdb.org/t/p/w300/ccPsCsL2TkHaEw0k6pQxKwm5JYU.jpg","metadataSources":{"tmdb":{"title":"Episodio 5","synopsis":"Aoko is upset because her father, Inspector Nakamori, will miss her birthday because he needs to chase Kid as Kid attempts to steal India's largest sapphir