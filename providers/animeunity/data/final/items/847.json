_id":30}},{"id":24,"name":"Mystery","pivot":{"anime_id":847,"genre_id":24}},{"id":34,"name":"Shounen","pivot":{"anime_id":847,"genre_id":34}},{"id":42,"name":"Supernatural","pivot":{"anime_id":847,"genre_id":42}}],"related":[{"id":844,"user_id":2,"title":"Kuroshitsuji","imageurl":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/nx4898-mW4gabZvwmLC.jpg","plot":"Nell'Inghilterra vittoriana, Ciel Phantomhive è un dodicenne appartenente ad una famiglia nobile; da generazioni, il compito dei Phantomhive è indagare, per conto della corona inglese (in questo caso, per la regina Vittoria), su problemi misteriosi ed insolubili, quasi sempre legati a forze sovrannaturali ed occulte, e per questo motivo la famiglia è chiamata \"il cane da guardia della regina\". Quando i suoi genitori restano uccisi in un misterioso incendio, Ciel invoca un demone con cui stringe un patto per riuscire a scoprire la ragione della loro misteriosa morte. Il demone si insedia nella magione Phantomhive in forma di maggiordomo, con il nome di Sebastian Michaelis, affiancato da altri quattro domestici: Mey Rin, una cameriera decisamente timida ed impacciata con un debole per Sebastian, Bald, un cuoco assolutamente incapace di preparare qualcosa di commestibile, Finnian, un giardiniere molto innocente ed infantile, ma dalla forza sovrumana, ed il vecchio maggiordomo Tanaka, quasi sempre intento a bere tè e raffigurato in super deformed; lungo il prosieguo della storia, verrà  svelato il loro passato. Come viene svelato nel manga, in realtà  i signori Phantomhive non morirono a causa dell'incendio. Il giorno del suo decimo compleanno, Ciel trovò il cane di famiglia (il cui nome era Sebastian) morto in una pozza di sangue, così come i genitori. Quando trovò Tanaka, l'anziano maggiordomo fu aggredito e colpito alla schiena con un coltello, mentre Ciel veniva rapito e venduto ad un'asta. Venne tenuto per un mese in una gabbia, picchiato e maltrattato, fino al giorno in cui fu pugnalato e offerto come sacrificio a Sebastian, il demone con cui poi Ciel strinse un patto. Il primo ordine del giovane Phantomhive fu quello di uccidere le persone che avevano abusato di lui. Diversamente, invece, accade nell'anime, dove ad uccidere i signori Phantomhive fu addirittura un \"angelo caduto\", con l'intento di purificare l'Inghilterra da ogni male. Tale angelo è identificato anche come Ash, il maggiordomo della regina Vittoria.","date":"2008","episodes_count":24,"episodes_length":24,"author":" ","created_at":"2019-06-21 00:15:34","status":"Terminato","imageurl_cover":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/4898-qqGPkf0qkMDh.jpg","type":"TV","slug":"black-butler","title_eng":"Black Butler","day":"Indeterminato","favorites":924,"score":"8.16","visite":682298,"studio":"A-1 Pictures","dub":0,"always_home":0,"members":6411,"cover":null,"anilist_id":4898,"season":"Autunno","title_it":null,"mal_id":4898,"crunchy_id":null,"netflix_id":null,"prime_id":null,"disney_id":null,"pivot":{"anime_id":847,"related_id":844,"number":1}},{"id":3151,"user_id":2,"title":"Kuroshitsuji: Sono Shitsuji, Kougyou","imageurl":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/bx6793-WJHPwa0ofanb.png","plot":"Special di Kuroshitsuji","date":"2009","episodes_count":1,"episodes_length":23,"author":" ","created_at":"2021-07-09 22:15:26","status":"Terminato","imageurl_cover":"","type":"Special","slug":"black-butler-special","title_eng":"Black Butler Special","day":"Indeterminato","favorites":101,"score":"7.95","visite":29743,"studio":"A-1 Pictures","dub":0,"always_home":0,"members":718,"cover":null,"anilist_id":6793,"season":"Autunno","title_it":null,"mal_id":6793,"crunchy_id":null,"netflix_id":null,"prime_id":null,"disney_id":null,"pivot":{"anime_id":847,"related_id":3151,"number":1}},{"id":845,"user_id":2,"title":"Kuroshitsuji II","imageurl":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/nx6707-eZvzqWlu51DD.png","plot":"Nell'Inghilterra vittoriana, Ciel Phantomhive è un dodicenne appartenente ad una famiglia nobile; da generazioni, il compito dei Phantomhive è indagare, per conto della corona inglese (in questo caso, per la regina Vittoria), su problemi misteriosi ed insolubili, quasi sempre legati a forze sovrannaturali ed occulte, e per questo motivo la famiglia è chiamata \"il cane da guardia della regina\". Quando i suoi genitori restano uccisi in un misterioso incendio, Ciel invoca un demone con cui stringe un patto per riuscire a scoprire la ragione della loro misteriosa morte. Il demone si insedia nella magione Phantomhive in forma di maggiordomo, con il nome di Sebastian Michaelis, affiancato da altri quattro domestici: Mey Rin, una cameriera decisamente timida ed impacciata con un debole per Sebastian, Bald, un cuoco assolutamente incapace di preparare qualcosa di commestibile, Finnian, un giardiniere molto innocente ed infantile, ma dalla forza sovrumana, ed il vecchio maggiordomo Tanaka, quasi sempre intento a bere tè e raffigurato in super deformed; lungo il prosieguo della storia, verrà  svelato il loro passato. Come viene svelato nel manga, in realtà  i signori Phantomhive non morirono a causa dell'incendio. Il giorno del suo decimo compleanno, Ciel trovò il cane di famiglia (il cui nome era Sebastian) morto in una pozza di sangue, così come i genitori. Quando trovò Tanaka, l'anziano maggiordomo fu aggredito e colpito alla schiena con un coltello, mentre Ciel veniva rapito e venduto ad un'asta. Venne tenuto per un mese in una gabbia, picchiato e maltrattato, fino al giorno in cui fu pugnalato e offerto come sacrificio a Sebastian, il demone con cui poi Ciel strinse un patto. Il primo ordine del giovane Phantomhive fu quello di uccidere le persone che avevano abusato di lui. Diversamente, invece, accade nell'anime, dove ad uccidere i signori Phantomhive fu addirittura un \"angelo caduto\", con l'intento di purificare l'Inghilterra da ogni male. Tale angelo è identificato anche come Ash, il maggiordomo della regina Vittoria.","date":"2010","episodes_count":12,"episodes_length":24,"author":" ","created_at":"2019-06-21 00:16:42","status":"Terminato","imageurl_cover":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/6707-44Od4mQqKm2f.jpg","type":"TV","slug":"black-butler-ii","title_eng":"Black Butler II","day":"Indeterminato","favorites":229,"score":"7.84","visite":191674,"studio":"A-1 Pictures","dub":0,"always_home":0,"members":1908,"cover":null,"anilist_id":6707,"season":"Estate","title_it":null,"mal_id":6707,"crunchy_id":null,"netflix_id":null,"prime_id":null,"disney_id":null,"pivot":{"anime_id":847,"related_id":845,"number":1}},{"id":846,"user_id":2,"title":"Kuroshitsuji: Book of Circus","imageurl":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/nx20606-58LzabjtVrwt.jpg","plot":"Un nuovo progetto animato per Kuroshitsuji, che adatterà  l'arco del Circo di Noè, adattando la storia del manga dal punto in cui la serie anime passata divergeva con questo. Questo arco segue immediatamente l'episodio 15 della prima stagione dell'anime.","date":"2014","episodes_count":10,"episodes_length":24,"author":" ","created_at":"2019-06-21 00:18:00","status":"Terminato","imageurl_cover":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/n20606-W6v0Gn5E5X0Z.jpg","type":"TV","slug":"black-butler-book-of-circus","title_eng":"Black Butler: Book of Circus","day":"Indeterminato","favorites":212,"score":"8.47","visite":145094,"studio":"A-1 Pictures","dub":0,"always_home":0,"members":1533,"cover":null,"anilist_id":20606,"season":"Estate","title_it":null,"mal_id":22145,"crunchy_id":null,"netflix_id":null,"prime_id":null,"disney_id":null,"pivot":{"anime_id":847,"related_id":846,"number":1}},{"id":847,"user_id":2,"title":"Kuroshitsuji: Book of Murder","imageurl":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/bx20670-3B1bxzAp0AUr.jpg","plot":"OVA di Black Butler","date":"2014","episodes_count":2,"episodes_length":58,"author":" ","created_at