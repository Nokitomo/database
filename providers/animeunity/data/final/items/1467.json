gth":24,"author":" ","created_at":"2019-09-03 17:54:43","status":"Terminato","imageurl_cover":"","type":"Special","slug":"aria-the-scarlet-ammo-special","title_eng":"Aria the Scarlet Ammo Special","day":"Indeterminato","favorites":22,"score":"7.14","visite":13112,"studio":"J.C. Staff","dub":0,"always_home":0,"members":224,"cover":null,"anilist_id":10604,"season":"Autunno","title_it":null,"mal_id":10604,"crunchy_id":null,"netflix_id":null,"prime_id":null,"disney_id":null,"genres":[{"id":51,"name":"Action","pivot":{"anime_id":1467,"genre_id":51}},{"id":37,"name":"Comedy","pivot":{"anime_id":1467,"genre_id":37}},{"id":24,"name":"Mystery","pivot":{"anime_id":1467,"genre_id":24}},{"id":17,"name":"Romance","pivot":{"anime_id":1467,"genre_id":17}}],"related":[{"id":134,"user_id":78495,"title":"Hidan no Aria","imageurl":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/bx8630-n8Ipf0NlVXjy.jpg","plot":"Protagonista di Hidan no Aria è Kinji Toyama, normalissimo studente di un liceo di Tokyo decisamente fuori dal comune, la Butei High School. Nota anche come Academy Island, questa scuola è stata creata al solo scopo di addestrare i suoi studenti all?uso delle armi, in modo che, al termine degli studi, questi possano fregiarsi dell?ambito titolo di ?Butei?. Creati allo scopo di fronteggiare la criminalità organizzata, i Butei sono dei detective armati fino ai denti e disposti ad accettare, dietro compenso, qualsiasi incarico ricada nei limiti imposti dalle ?Butei Laws?. Kinji, però, a dispetto delle sue capacità, non è in alcun modo intenzionato a diventare un Butei, e per tale ragione, allo scopo di preservare la sua tranquilla vita da normale adolescente, ha deciso di celare a tutti la sua potente abilità speciale, chiamata Histeria Mode in cui avviene un cambio di personalità e miglioramento delle sua abilità che è causato da situazioni che coinvolgono le ragazze. Il suo desiderio, tuttavia, sembra essere destinato a rimanere una pura utopia: gli eventi, infatti, inizieranno a prendere una brutta piega quando, andando a scuola, Kinji scoprirà di essere rimasto vittima di un attentato, da cui riuscirà a scampare miracolosamente solo grazie al rocambolesco intervento della bella e pericolosa Aria H. Kanzaki, la più forte studentessa di livello S della Butei High School.","date":"2011","episodes_count":12,"episodes_length":24,"author":" ","created_at":"2018-07-18 11:19:39","status":"Terminato","imageurl_cover":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/8630.jpg","type":"TV","slug":"aria-the-scarlet-ammo","title_eng":"Aria the Scarlet Ammo","day":"Indeterminato","favorites":158,"score":"7.23","visite":81710,"studio":"J.C. Staff","dub":0,"always_home":0,"members":1292,"cover":null,"anilist_id":8630,"season":"Primavera","title_it":null,"mal_id":8630,"crunchy_id":null,"netflix_id":null,"prime_id":null,"disney_id":null,"pivot":{"anime_id":1467,"related_id":134,"number":1}},{"id":1467,"user_id":78495,"title":"Hidan no Aria: Butei ga Kitarite Onsen Kenshuu","imageurl":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/10604.jpg","plot":"Episodio Special di Hidan no Aria","date":"2011","episodes_count":1,"episodes_length":24,"author":" ","created_at":"2019-09-03 17:54:43","status":"Terminato","imageurl_cover":"","type":"Special","slug":"aria-the-scarlet-ammo-special","title_eng":"Aria the Scarlet Ammo Special","day":"Indeterminato","favorites":22,"score":"7.14","visite":13112,"studio":"J.C. Staff","dub":0,"always_home":0,"members":224,"cover":null,"anilist_id":10604,"season":"Autunno","title_it":null,"mal_id":10604,"crunchy_id":null,"netflix_id":null,"prime_id":null,"disney_id":null,"pivot":{"anime_id":1467,"related_id":1467,"number":1}},{"id":135,"user_id":78495,"title":"Hidan no Aria AA","imageurl":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/bx20991-bYPGhJvthBWI.png","plot":"La Butei High School, nota anche come Academy Island, è stata creata al solo scopo di addestrare i suoi studenti all'uso delle armi, in modo che, al termine degli studi, questi possano fregiarsi dell'ambito titolo di 'Butei'. Creati allo scopo di fronteggiare la criminalità organizzata, i Butei sono dei detective armati fino ai denti e disposti ad accettare, dietro compenso, qualsiasi incarico ricada nei limiti imposti dalle 'Butei Laws'. Akari Mamiya è una primina di livello E che ammira Aria H. Kanzaki più grande di lei e di livello speciale S. Le ragazze frequentano la Tokyo Butei High School, Akari spera di essere affiancata ad Aria tramite il sistema &quot;Amica&quot;, che affianca un novellino ad un esperto, per addestrarlo al meglio.","date":"2015","episodes_count":12,"episodes_length":23,"author":" ","created_at":"2018-07-18 11:21:50","status":"Terminato","imageurl_cover":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/20991-KrhvvvCYXWPO.png","type":"TV","slug":"aria-the-scarlet-ammo-aa","title_eng":"Aria the Scarlet Ammo AA","day":"Martedì","favorites":28,"score":"6.80","visite":33216,"studio":"Doga Kobo","dub":0,"always_home":0,"members":358,"cover":null,"anilist_id":20991,"season":"Autunno","title_it":null,"mal_id":28883,"crunchy_id":null,"netflix_id":null,"prime_id":null,"disney_id":null,"pivot":{"anime_id":1467,"related_id":135,"number":1}}]},"archive":null},"sourceEpisodes":[{"id":28187,"anime_id":1467,"user_id":null,"number":"1","created_at":"2019-09-03 17:55:36","link":"https://www.animeunityserver102.cloud/DDL/Anime/HidanNoAria/HidanNoAria_Ep_13_SUB_ITA.mp4","visite":13112,"hidden":0,"public":1,"scws_id":77641,"file_name":"HidanNoAria_Ep_13_SUB_ITA.mp4","tg_post":0}],"artworkInventory":{"logo":[{"source":"tmdb","url":"https://image.tmdb.org/t/p/original/hp38o7myeYBnC0cYo2Y8VIdwBOI.png"},{"source":"cinemeta","url":"https://images.metahub.space/logo/medium/tt1936037/img"},{"source":"tvdb","url":"https://artworks.thetvdb.com/banners/v4/series/247949/clearlogo/611c3fd125e14.png"}],"poster":[{"source":"tmdb","url":"https://image.tmdb.org/t/p/original/l