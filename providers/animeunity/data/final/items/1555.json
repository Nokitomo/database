,"slug":"kannagi-special","title_eng":"Kannagi Special","day":"Indeterminato","favorites":18,"score":"6.74","visite":16953,"studio":"A-1 Pictures","dub":0,"always_home":0,"members":127,"cover":null,"anilist_id":5978,"season":"Primavera","title_it":null,"mal_id":5978,"crunchy_id":null,"netflix_id":null,"prime_id":null,"disney_id":null,"genres":[{"id":37,"name":"Comedy","pivot":{"anime_id":1555,"genre_id":37}},{"id":33,"name":"School","pivot":{"anime_id":1555,"genre_id":33}},{"id":34,"name":"Shounen","pivot":{"anime_id":1555,"genre_id":34}},{"id":42,"name":"Supernatural","pivot":{"anime_id":1555,"genre_id":42}}],"related":[{"id":1554,"user_id":2,"title":"Kannagi: Crazy Shrine Maidens","imageurl":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/nx3958-SztG03yWCG5G.jpg","plot":"A causa della riqualificazione di un giardino viene abbattuto un albero sacro. Una parte del tronco di quest'albero finisce tra le mani di Jin Mikuriya, studente del primo anno delle superiori iscritto al &quot;club di arte&quot;, che decide di intagliarlo per presentare il suo lavoro al festival scolastico. Crea così una statua dalle sembianze umane che però, la mattina stessa in cui Jin si appresta a portarla a scuola, prende vita e si trasforma in una bellissima ragazza. La ragazza dice di chiamarsi Nagi e di essere una Dea della natura venuta al mondo per proteggerlo dalle impurità che si stanno diffondendo. Essa mostra subito un carattere abbastanza dispotico nei confronti del ragazzo, che, incredulo, decide di provare a riportarle la fanciulla all'albero sacro per farla ricongiungere con esso. Purtroppo Nagi. vedendo l'albero tagliato, va su tutte le furie e costringe Jin a diventare il suo servitore e a seguirla nella sua missione di cacciatrice di impurità, stabilendosi così per sua volontà in casa del ragazzo. I due iniziano dunque una convivenza difficile, soprattutto per Jin che, oltre a sottostare ai capricci della ragazza, è costretto a tenere nascosta l'identità di lei ai compagni del &quot;club di arte&quot; e alla sua amica d'infanzia Tsugumi Aoba. La storia prosegue quindi tra magia, sentimenti ed umorismo, focalizzandosi pian piano sull'oscuro passato di Nagi.","date":"2008","episodes_count":13,"episodes_length":23,"author":" ","created_at":"2019-09-29 22:20:49","status":"Terminato","imageurl_cover":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/3958-kZJUl1sHD2Fi.jpg","type":"TV","slug":"kannagi","title_eng":"Kannagi","day":"Indeterminato","favorites":104,"score":"7.35","visite":48344,"studio":"A-1 Pictures","dub":0,"always_home":0,"members":749,"cover":null,"anilist_id":3958,"season":"Autunno","title_it":null,"mal_id":3958,"crunchy_id":null,"netflix_id":null,"prime_id":null,"disney_id":null,"pivot":{"anime_id":1555,"related_id":1554,"number":1}},{"id":1555,"user_id":2,"title":"Kannagi: Moshimo Kannagi ga Attara...","imageurl":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/nx5978-geNv4phgAi3n.jpg","plot":"Episodio Speciale includo Nel BD","date":"2009","episodes_count":1,"episodes_length":23,"author":" ","created_at":"2019-09-29 22:23:02","status":"Terminato","imageurl_cover":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/5978-9UctGvhgFoGl.jpg","type":"Special","slug":"kannagi-special","title_eng":"Kannagi Special","day":"Indeterminato","favorites":18,"score":"6.74","visite":16953,"studio":"A-1 Pictures","dub":0,"always_home":0,"members":127,"cover":null,"anilist_id":5978,"season":"Primavera","title_it":null,"mal_id":5978,"crunchy_id":null,"netflix_id":null,"prime_id":null,"disney_id":null,"pivot":{"anime_id":1555,"related_id":1555,"number":1}}]},"archive":null},"sourceEpisodes":[{"id":30164,"anime_id":1555,"user_id":null,"number":"1","created_at":"2019-09-29 22:29:01","link":"https://www.okaasan-online.org/DDL/ANIME/Kannagi/Kannagi_Ep_14_SUB_ITA.mp4","visite":16953,"hidden":0,"public":1,"scws_id":122625,"file_name":"Kannagi_Ep_14_SUB_ITA.mp4","tg_post":0}],"artworkInventory":{"logo":[{