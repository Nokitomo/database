are i Boomer, ma ora deve anche fare i conti con il suo nuovo partner.","date":"1999","episodes_count":12,"episodes_length":24,"author":" ","created_at":"2025-07-14 09:55:45","status":"Terminato","imageurl_cover":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/n1349-VcWeuV64w3Kf.jpg","type":"TV","slug":"ad-police-to-protect-and-serve","title_eng":"A.D. Police: To Protect and Serve","day":"Indeterminato","favorites":7,"score":"8.00","visite":3784,"studio":"AIC","dub":0,"always_home":0,"members":21,"cover":null,"anilist_id":1349,"season":"Primavera","title_it":null,"mal_id":1349,"crunchy_id":null,"netflix_id":null,"prime_id":null,"disney_id":null,"pivot":{"anime_id":6875,"related_id":6874,"number":2}}]},"archive":null},"sourceEpisodes":[{"id":99295,"anime_id":6875,"user_id":2,"number":"1","created_at":"2025-07-14 09:56:51","link":"A.D.Police.1990.E01.SUB.ITA.mp4","visite":8692,"hidden":0,"public":1,"scws_id":328186,"file_name":"A.D.Police.1990.E01.SUB.ITA.mp4","tg_post":0},{"id":99296,"anime_id":6875,"user_id":2,"number":"2","created_at":"2025-07-14 09:56:51","link":"A.D.Police.1990.E02.SUB.ITA.mp4","visite":575,"hidden":0,"public":1,"scws_id":328187,"file_name":"A.D.Police.1990.E02.SUB.ITA.mp4","tg_post":0},{"id":99297,"anime_id":6875,"user_id":2,"number":"3","created_at":"2025-07-14 09:56:52","link":"A.D.Police.1990.E03.SUB.ITA.mp4","visite":435,"hidden":0,"public":1,"scws_id":328188,"file_name":"A.D.Police.1990.E03.SUB.ITA.mp4","tg_post":0}],"artworkInventory":{"logo":[{"source":"tmdb","url":"https://image.tmdb.org/t/p/original/6PDXFed7DsEetoDEBcz6rChUIMh.png"},{"source":"cinemeta","url":"https://live.metahub.space/logo/medium/tt0088655/img"},{"source":"anizip","url":"https://artworks.thetvdb.com/banners/v4/series/393077/clearlogo/63c34744ea03c.png"}],"poster":[{"source":"tmdb","url":"https://image.tmdb.org/t/p/original/cLRZmZixUuaZPjdNxHt3xMBy7rC.jpg"},{"source":"anizip","url":"https://artworks.thetvdb.com/banners/series/393077/posters/5fdc0c45cbb61.jpg"