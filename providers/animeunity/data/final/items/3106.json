ver":null,"anilist_id":124,"season":"Inverno","title_it":null,"mal_id":124,"crunchy_id":null,"netflix_id":null,"prime_id":null,"disney_id":null,"genres":[{"id":21,"name":"Adventure","pivot":{"anime_id":3106,"genre_id":21}},{"id":22,"name":"Drama","pivot":{"anime_id":3106,"genre_id":22}},{"id":9,"name":"Fantasy","pivot":{"anime_id":3106,"genre_id":9}},{"id":53,"name":"Isekai","pivot":{"anime_id":3106,"genre_id":53}},{"id":17,"name":"Romance","pivot":{"anime_id":3106,"genre_id":17}},{"id":18,"name":"Shoujo","pivot":{"anime_id":3106,"genre_id":18}}],"related":[{"id":2181,"user_id":78495,"title":"Fushigi Yuugi","imageurl":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/bx123-nTVq4CHgK5Ly.jpg","plot":"Fushigi Yugi TV è il primo e più lungo adattamento anime del famoso omonimo manga shoujo di Yu Watse, prodotto dallo Studio Pierrot. Miaka Yuki ha 15 anni ed è all’ultimo anno delle scuole medie giapponesi, e come ogni studente deve affrontare gli esami di ammissione alle superiori; ma lei non si cura molto dello studio, preferisce fare sonnellini e mangiare ogni sorta di leccornie. Un giorno accompagna la sua diligente amica Yui in biblioteca, lì le due ragazze notano un antico libro cinese a terra e lo cominciano a leggere. Si tratta “dell’Universo dei Quattro Dei” un libro incantato, che può esaudire i desideri di chi lo legge, ma allo stesso tempo il lettore viene risucchiato nel suo mondo fantastico. In questo universo parallelo dell’antica Cina feudale Miaka si mette subito nei guai, ma viene prontamente più volte salvata da un affascinante ragazzo di nome Tamahome, il quale ha impresso un ideogramma infuocato sulla fronte. Nel frattempo Yui viene rispedita dal libro nel mondo reale, invece Miaka attira l’attenzione del bel imperatore Hotohori, il quale subito capisce che lei è la sacerdotessa del dio Suzaku, una fenice infuocata, l’unica che può salvare il regno di Konan. Per compiere tale impresa ella dovrà trovare i “Sette Guerrieri Celestiali” suoi protettori, il primo dei suoi paladini è proprio Tamahome…","date":"1995","episodes_count":52,"episodes_length":23,"author":" ","created_at":"2020-04-04 14:56:34","status":"Terminato","imageurl_cover":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/123-aB3o7LLZrWWV.png","type":"TV","slug":"mysterious-play","title_eng":"Mysterious Play","day":"Indeterminato","favorites":159,"score":"8.32","visite":158344,"studio":"Studio Pierrot","dub":0,"always_home":0,"members":720,"cover":null,"anilist_id":123,"season":"Primavera","title_it":null,"mal_id":123,"crunchy_id":null,"netflix_id":null,"prime_id":null,"disney_id":null,"pivot":{"anime_id":3106,"related_id":2181,"number":1}},{"id":3106,"user_id":78495,"title":"Fushigi Yuugi: Eikouden","imageurl":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/124.jpg","plot":"OVA di Fushigi Yuugi","date":"2001","episodes_count":4,"episodes_length":30,"author":" ","created_at":"2021-06-21 00:06:37","status":"Terminato","imageurl_cover":"","type":"OVA","slug":"mysterious-play-eikoden","title_eng":"Mysterious Play: Eikoden","day":"Indeterminato","favorites":33,"score":"7.70","visite":26401,"studio":"Studio Pierrot","dub":0,"always_home":0,"members":145,"cover":null,"anilist_id":124,"season":"Inverno","title_it":null,"mal_id":124,"crunchy_id":null,"netflix_id":null,"prime_id":null,"disney_id":null,"pivot":{"anime_id":3106,"related_id":3106,"number":1}}]},"archive":null},"sourceEpisodes":[{"id":52384,"anime_id":3106,"user_id":2,"number":"1","created_at":"2021-06-21 00:07:16","link":"https://www.okaasan-online.org/DDL/ANIME/FushigiYuugi/FushigiYuugiEikouden_Ep_01_SUB_ITA.mp4","visite":22388,"hidden":0,"public":1,"scws_id":142579,"file_name":"FushigiYuugiEikouden_Ep_01_SUB_ITA.mp4","tg_post":0},{"id":52385,"anime_id":3106,"user_id":2,"number":"2","created_at":"2021-06-21 00:07:19","link":"https://www.okaasan-online.org/DDL/ANIME/FushigiYuugi/FushigiYuugiEikouden_Ep_02_SUB_ITA.mp4","visite":1184,"hidden":0,"public":1,"scw