,"episodes_count":1,"episodes_length":24,"author":" ","created_at":"2019-05-30 10:44:00","status":"Terminato","imageurl_cover":"","type":"OVA","slug":"my-mental-choices-are-completely-interfering-with-my-school-romantic-comedy-ova","title_eng":"My Mental Choices Are Completely Interfering With My School Romantic Comedy OVA","day":"Indeterminato","favorites":34,"score":"7.05","visite":19756,"studio":"Diomedéa","dub":0,"always_home":0,"members":250,"cover":null,"anilist_id":20479,"season":"Primavera","title_it":"NouCome OVA","mal_id":20939,"crunchy_id":null,"netflix_id":null,"prime_id":null,"disney_id":null,"genres":[{"id":37,"name":"Comedy","pivot":{"anime_id":708,"genre_id":37}},{"id":15,"name":"Harem","pivot":{"anime_id":708,"genre_id":15}},{"id":17,"name":"Romance","pivot":{"anime_id":708,"genre_id":17}},{"id":33,"name":"School","pivot":{"anime_id":708,"genre_id":33}}],"related":[{"id":211,"user_id":2,"title":"Ore no Nounai Sentakushi ga, Gakuen Love Comedy wo Zenryoku de Jama Shiteiru","imageurl":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/bx19221-gYYDXIVzas7u.jpg","plot":"Kanade Amakusa è uno studente liceale che soffre di una maledizione chiamata &quot;Scelte assolute&quot; (絶対選択肢 Zettai sentakushi?): in qualsiasi momento della sua vita quotidiana può apparirgli improvvisamente di fronte una lista di due o tre opzioni tra cui ne dovrà scegliere per forza una nel giro di pochi secondi. Ovviamente ogni opzione ha subito effetto sulla realtà e la maggior parte di esse è strana o di natura perversa, ragion per cui la reputazione del ragazzo tra i suoi amici e compagni di scuola non è delle migliori e la sua vita è ben oltre la difficoltà media. Un giorno, però, una delle scelte prese da Kanade sulla via del ritorno a casa da scuola provoca la caduta dal cielo di una misteriosa e bellissima ragazza dai capelli biondi. Kanade scopre ben presto che questi è stata mandata da Dio per aiutarlo a portare a termine con successo una serie di missioni, preparate da Lui stesso, per liberarlo finalmente dalle &quot;Scelte assolute&quot;. Tuttavia, anche se ne dovesse fallire una sola, la maledizione non sparirà mai più.\r\n\r\nNel corso della storia le opzioni iniziano anche a mostrare dei cambiamenti: in alcuni casi ne appare una nuova all'improvviso, in altri spariscono tutte senza che una decisione sia stata presa, in altri ancora possono essere addirittura rifiutate tutte. Inoltre secondo Kanade ne esistono tre tipi in totale: quelle che costringono il soggetto a fare certe azioni, quelle che alterano le altre persone fisicamente o mentalmente senza che dopo mantengano integra la propria memoria e quelle che hanno esiti imprevedibili.","date":"2013","episodes_count":10,"episodes_length":24,"author":" ","created_at":"2018-07-18 15:58:41","status":"Terminato","imageurl_cover":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/19221-wz6fOohodkwR.jpg","type":"TV","slug":"my-mental-choices-are-completely-interfering-with-my-school-romantic-comedy","title_eng":"My Mental Choices Are Completely Interfering With My School Romantic Comedy","day":"Indeterminato","favorites":218,"score":"7.33","visite":95649,"studio":"diomedéa","dub":0,"always_home":0,"members":1475,"cover":null,"anilist_id":19221,"season":"Autunno","title_it":"NouCome","mal_id":19221,"crunchy_id":null,"netflix_id":null,"prime_id":null,"disney_id":null,"pivot":{"anime_id":708,"related_id":211,"number":1}},{"id":708,"user_id":2,"title":"Ore no Nounai Sentakushi ga, Gakuen Love Comedy wo Zenryoku de Jama Shiteiru OVA","imageurl":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/20479.jpg","plot":"OVA di NouCome","date":"2014","episodes_count":1,"episodes_length":24,"author":" ","created_at":"2019-05-30 10:44:00","status":"Terminato","imageurl_cover":"","type":"OVA","slug":"my-mental-choices-are-completely-interfering-with-my-school-romantic-comedy-ova","title_eng":"My Mental Choices Are Completely Interfering With My School Romantic Comedy