_id":15}},{"id":17,"name":"Romance","pivot":{"anime_id":3400,"genre_id":17}},{"id":34,"name":"Shounen","pivot":{"anime_id":3400,"genre_id":34}}],"related":[{"id":3399,"user_id":78495,"title":null,"imageurl":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/403.jpg","plot":"Taro è un ragazzino dallo sguardo a fessura, calmo, buono, saggio ma affetto da ginofobia, che rimasto orfano progetta di andare a vivere da suo nonno. Dopo una difficile arrampicata viene assalito dalla servitù del maniero che gli dà  un calorosissimo benvenuto. Presto grazie a Marielle scopre di essere divenuto il nuovo capo e proprietario degli ingenti beni della famiglia Hanaukyo. Suo nonno sembra si sia ritirato per godersi il tempo rimasto e tocca a lui ora mandre avanti tutto, con l'aiuto di centinaia di belle ragazze fedelissime e pronte a tutto (naturalmente).","date":"2001","episodes_count":12,"episodes_length":14,"author":" ","created_at":"2022-01-02 04:19:05","status":"Terminato","imageurl_cover":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/403-BnxtPEuTOQV0.jpg","type":"TV Short","slug":"hanaukyou-maid-tai","title_eng":"Hanaukyou Maid-tai","day":"Indeterminato","favorites":28,"score":"6.74","visite":22128,"studio":"Daume","dub":0,"always_home":0,"members":191,"cover":null,"anilist_id":403,"season":"Primavera","title_it":null,"mal_id":403,"crunchy_id":null,"netflix_id":null,"prime_id":null,"disney_id":null,"pivot":{"anime_id":3400,"related_id":3399,"number":1}},{"id":3400,"user_id":78495,"title":null,"imageurl":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/797.jpg","plot":"Episodi OVA di Hanaukyou Maid-tai","date":"2001","episodes_count":3,"episodes_length":14,"author":" ","created_at":"2022-01-02 04:22:53","status":"Terminato","imageurl_cover":"","type":"OVA","slug":"hanaukyou-maid-tai-ova","title_eng":"Hanaukyou Maid-tai OVA","day":"Indeterminato","favorites":4,"score":"6.67","visite":9192,"studio":"Daume","dub":0,"always_home":0,"members":