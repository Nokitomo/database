rs":[7]},{"provider":"tvdb_show","id":"449914","scope":"s1","seasonNumber":1,"episodeNumbers":[7]}],"link":"96791","synopsis":"Makina loses her body to her younger sister robot, Mimika. According to Makina, Mimika is an agent-type robot skilled at pretending to be fragile in order to manipulate others emotionally. To track down the now-missing Mimika, Eita proposes a strategy only a true mecha geek could devise.","thumbnail":"https://image.tmdb.org/t/p/w300/cFGaZATe0fUylDh4Idjtc6qzskc.jpg","metadataSources":{"tmdb":{"title":"E così, le sorelle si scambiano.","synopsis":"Makina loses her body to her younger sister robot, Mimika. According to Makina, Mimika is an agent-type robot skilled at pretending to be fragile in order to manipulate others emotionally. To track down the now-missing Mimika, Eita proposes a strategy only a true mecha geek could devise.","thumbnail":"https://image.tmdb.org/t/p/w300/cFGaZATe0fUylDh4Idjtc6qzskc.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}},{"title":"E così, Makina diventa una storia di fantasmi.","episodeNumber":8,"sourceEpisodeNumber":8,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"18621","scope":"R","episodeNumbers":[8]},{"provider":"anilist","id":"177509","episodeNumbers":[8]},{"provider":"mal","id":"58833","episodeNumbers":[8]},{"provider":"tmdb_show","id":"254174","scope":"s1","seasonNumber":1,"episodeNumbers":[8]},{"provider":"tvdb_show","id":"449914","scope":"s1","seasonNumber":1,"episodeNumbers":[8]}],"link":"97299","synopsis":"Shrunken down to a tiny size, Makina finds herself in a tense face-off with a now gigantic Mimika. However, she’s unable to make a move—Eita is being held hostage. Mimika threatens Eita, demanding that he perform maintenance on her. As Eita trembles in fear, Makina reveals a secret plan for a dramatic comeback.","thumbnail":"https://image.tmdb.org/t/p/w300/r9yfJACUdo3ciU05zbEmvt9UmtJ.jpg","metadataSources":{"tmdb":{"title":"E così, Makina diventa una storia di fantasmi.","s