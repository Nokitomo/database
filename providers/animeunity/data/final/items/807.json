a incontra per caso nei pressi del locale.","date":"2010","episodes_count":26,"episodes_length":24,"author":" ","created_at":"2019-06-15 00:03:46","status":"Terminato","imageurl_cover":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/7054-iTfiX8juTvRV.jpg","type":"TV","slug":"kaichou-wa-maid-sama","title_eng":"Kaichou wa Maid-sama!","day":"Indeterminato","favorites":1280,"score":"8.43","visite":1333117,"studio":"J.C. Staff","dub":0,"always_home":0,"members":6568,"cover":null,"anilist_id":7054,"season":"Primavera","title_it":null,"mal_id":7054,"crunchy_id":null,"netflix_id":null,"prime_id":null,"disney_id":null,"pivot":{"anime_id":807,"related_id":805,"number":1}},{"id":807,"user_id":2,"title":"Maid Sama!: It's an Extra!","imageurl":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/bx9366-R2IiAvs2YmZG.png","plot":"Episodio extra incluso nel Blu-ray e DVD del volume 10, intitolato &quot;Omake dayo (È un extra!)&quot;.","date":"2011","episodes_count":1,"episodes_length":13,"author":" ","created_at":"2019-06-15 11:59:11","status":"Terminato","imageurl_cover":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/n9366-fapRtNBBZoEx.jpg","type":"Special","slug":"kaichou-wa-maid-sama-omake-dayo","title_eng":"Kaichou wa Maid-sama!: Omake dayo!","day":"Indeterminato","favorites":224,"score":"8.08","visite":64006,"studio":"J.C. Staff","dub":0,"always_home":0,"members":1551,"cover":null,"anilist_id":9366,"season":"Primavera","title_it":null,"mal_id":9366,"crunchy_id":null,"netflix_id":null,"prime_id":null,"disney_id":null,"pivot":{"anime_id":807,"related_id":807,"number":1}}]},"archive":null},"sourceEpisodes":[{"id":18237,"anime_id":807,"user_id":null,"number":"1","created_at":"2019-06-15 12:00:52","link":"Maid-sama.-.La.doppia.vita.di.Misaki.S01E27.Un.extra.1080p.AMZN.WEB-DL.JPN.AAC2.0.H.264.mkv","visite":64006,"hidden":0,"public":1,"scws_id":411836,"file_name":"Maid-sama.-.La.doppia.vita.di.Misaki.S01E27.Un.extra.1080p.AMZN.WEB-DL.JPN.AAC2.0.H.264.m