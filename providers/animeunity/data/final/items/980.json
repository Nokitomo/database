ea macrophylla, ma non riesce d uccidersi. In seguito all'ennesimo litigio con il padre, Rea precipita incidentalmente da un burrone e muore; tuttavia come risultato di aver bevuto la pozione, la ragazza ritorna come zombie. Benché sia diventata una non morta, la ragazza decide di non mangiare carne umana, e, aiutata da Chihiro, tentare di sopravvivere consumando soltanto l'erba hydrangea.","date":"2012","episodes_count":12,"episodes_length":24,"author":" ","created_at":"2018-07-18 13:43:20","status":"Terminato","imageurl_cover":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/11499-etOfsgdjZY4L.jpg","type":"TV","slug":"sankarea-undying-love","title_eng":"Sankarea: Undying Love","day":"Indeterminato","favorites":374,"score":"7.55","visite":181556,"studio":"Studio DEEN","dub":0,"always_home":0,"members":2819,"cover":null,"anilist_id":11499,"season":"Primavera","title_it":null,"mal_id":11499,"crunchy_id":null,"netflix_id":null,"prime_id":null,"disney_id":null,"pivot":{"anime_id":980,"related_id":177,"number":1}}]},"archive":null},"sourceEpisodes":[{"id":20271,"anime_id":980,"user_id":null,"number":"1","created_at":"2019-07-03 16:54:40","link":"https://server10.streamingaw.online/DDL/ANIME/Sankarea/Sankarea_Ep_13_SUB_ITA.mp4","visite":35739,"hidden":0,"public":1,"scws_id":124556,"file_name":"Sankarea_Ep_13_SUB_ITA.mp4","tg_post":0},{"id":20272,"anime_id":980,"user_id":null,"number":"2","created_at":"2019-07-03 16:54:52","link":"https://server10.streamingaw.online/DDL/ANIME/Sankarea/Sankarea_Ep_14_SUB_ITA.mp4","visite":6251,"hidden":0,"public":1,"scws_id":124554,"file_name":"Sankarea_Ep_14_SUB_ITA.mp4","tg_post":0}],"artworkInventory":{"logo":[{"source":"tmdb","url":"https://image.tmdb.org/t/p/original/4ymZgtD2MzmnoXv29iely8dO3wa.png"},{"source":"tvdb","url":"https://artworks.thetvdb.com/banners/v4/series/257518/clearlogo/611c48ef493ad.png"},{"source":"anizip","url":"https://artworks.thetvdb.com/banners/v4/series/257518/clearlogo/611c48ec62433.png"}],"poster":[