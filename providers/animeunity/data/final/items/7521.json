{"id":7521,"path":"/anime/7521-monster-eater","linkSchemaVersion":2,"enrichmentSchemaVersion":2,"updatedAt":"2026-10-29T23:03:11.943Z","info":{"title":"Monster Eater","synopsis":"L'avventuriero Rude si guadagna da vivere raccogliendo erbe medicinali in sotterranei dall'aria irrespirabile, potendo contare sulla sua abilità capace di annullare gli stati alterati. Dopo tali viaggi rimane impregnato di quell'odore nauseante. Tale spiacevole effetto collaterale non gli permette di entrare nei gruppi di avventurieri. Un giorno viene adescato da alcune persone intente a usarlo come esca per salvarsi. Il giovane affronta con coraggio il pericolo, duella all'ultimo sangue con un possente mostro, rimanendo ferito. Vittorioso ma sofferente, decide di utilizzare la sua abilità di cuoco, scoprendo vantaggi sconosciuti.","image":"https://image.tmdb.org/t/p/original/uKGWyKucpzWHMPSUQXeIf03oxO5.jpg","poster":"https://image.tmdb.org/t/p/original/zAGPJpmAAKDG8f2rmn1EcYMgNKs.jpg","background":"https://image.tmdb.org/t/p/original/uKGWyKucpzWHMPSUQXeIf03oxO5.jpg","trailers":["https://www.youtube.com/watch?v=tXZbVN3xc7U"],"imdbId":"","type":"series","tags":["TV Short","Terminato","Primavera","2026"],"tagKeys":{"TV Short":"TV Short","Terminato":"Completed","Primavera":"Spring"},"genres":["Action","Adventure","Fantasy"],"rating":"6.3","studio":"Imagica Infos","episodesCount":12,"extra":{"ids":{"malId":63304,"anilistId":210234,"crunchyId":null,"disneyId":null,"netflixId":null,"primeId":null,"anilistIds":[210234],"malIds":[63304],"anidbIds":[19831],"imdbMovieIds":[],"imdbShowIds":[],"tmdbMovieIds":[],"tmdbShowIds":[310921],"tvdbMovieIds":[],"tvdbShowIds":[472764]},"stats":{"scoreRaw":"6.26","favorites":184,"members":1212,"views":169594,"episodesCountRaw":12,"episodesLength":13},"flags":{"dub":0,"alwaysHome":1},"meta":{"day":"Giovedì","season":"Primavera","status":"Terminato","type":"TV Short","createdAt":"2026-04-06 15:59:01","userId":2},"mappings":{"source":"anibridge-v3","schemaVersion":"3