cdn/media/anime/cover/medium/nx101085-2b1ZNhgx89q2.jpg","plot":"Continuo di Dies Irae (Episodi dal 12 al 17)","date":"2018","episodes_count":6,"episodes_length":28,"author":" ","created_at":"2019-04-10 13:04:23","status":"Terminato","imageurl_cover":"","type":"ONA","slug":"dies-irae-to-the-ring-reincarnation","title_eng":"Dies Irae: To the Ring Reincarnation","day":"Domenica","favorites":29,"score":"7.12","visite":26090,"studio":"A.C.G.T.","dub":0,"always_home":0,"members":229,"cover":null,"anilist_id":101085,"season":"Estate","title_it":null,"mal_id":36515,"crunchy_id":null,"netflix_id":null,"prime_id":null,"disney_id":null,"genres":[{"id":51,"name":"Action","pivot":{"anime_id":453,"genre_id":51}},{"id":35,"name":"Super Power","pivot":{"anime_id":453,"genre_id":35}}],"related":[{"id":125,"user_id":78495,"title":"Dies Irae","imageurl":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/nx21555-5dZCoocXoX9O.jpg","plot":"Il primo maggio del 1945, a Berlino, mentre l'Armata Rossa alza la bandiera sovietica sul Reichskanzlei, un gruppo di ufficiali nazisti conduce un rituale. Per loro il massacro in città non è altro che il sacrificio perfetto per riportare alla luce l'Ordine delle Tredici Lance, un gruppo di superuomini il cui arrivo comporterebbe la distruzione del mondo. Molti anni dopo, nessuno sa se questo gruppo di ufficiali sia riuscito nel suo intento e nemmeno se siano sopravvissuti. Pochi sapevano della loro esistenza e coloro che ne erano a conoscenza muoiono a poco a poco, con il passare delle decadi. Ora, a dicembre del presente, nella città di Suwahara, Ren Fujii passa i suoi giorni in ospedale. Sono passati due mesi da quando è avvenuto l'incidente che l'ha condotto lì: una lotta col suo amico Shirou Yusa, durante la quale hanno entrambi cercato di uccidere l'altro. Egli prova a ripensare a ciò che gli ha fatto, ma ogni notte fa sempre lo stesso sogno: una ghigliottina, degli assassini che danno la caccia alle persone e il cavaliere vestito di nero che insegue gli assassini. Desidera ardentemente di ritornare alla sua normale vita di tutti i giorni, eppure persino adesso sente risuonare le parole di Shirou: &quot;chiunque rimanga in questa città alla fine perderà la ragione.&quot;","date":"2017","episodes_count":12,"episodes_length":24,"author":" ","created_at":"2018-07-18 10:07:39","status":"Terminato","imageurl_cover":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/21555-ROGdBzMIhHk1.jpg","type":"TV","slug":"dies-irae","title_eng":"Dies irae","day":"Venerdì","favorites":164,"score":"6.89","visite":79070,"studio":"A.C.G.T.","dub":0,"always_home":0,"members":1140,"cover":null,"anilist_id":21555,"season":"Autunno","title_it":null,"mal_id":32271,"crunchy_id":null,"netflix_id":null,"prime_id":null,"disney_id":null,"pivot":{"anime_id":453,"related_id":125,"number":1}},{"id":453,"user_id":78495,"title":null,"imageurl":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/nx101085-2b1ZNhgx89q2.jpg","plot":"Continuo di Dies Irae (Episodi dal 12 al 17)","date":"2018","episodes_count":6,"episodes_length":28,"author":" ","created_at":"2019-04-10 13:04:23","status":"Terminato","imageurl_cover":"","type":"ONA","slug":"dies-irae-to-the-ring-reincarnation","title_eng":"Dies Irae: To the Ring Reincarnation","day":"Domenica","favorites":29,"score":"7.12","visite":26090,"studio":"A.C.G.T.","dub":0,"always_home":0,"members":229,"cover":null,"anilist_id":101085,"season":"Estate","title_it":null,"mal_id":36515,"crunchy_id":null,"netflix_id":null,"prime_id":null,"disney_id":null,"pivot":{"anime_id":453,"related_id":453,"number":1}}]},"archive":null},"sourceEpisodes":[{"id":11960,"anime_id":453,"user_id":null,"number":"1","created_at":"2019-04-10 13:13:44","link":"https://server20.streamingaw.online/DDL/ANIME/DiesIrae/DiesIrae_Ep_12_SUB_ITA.mp4","visite":17753,"hidden":0,"public":1,"scws_id":69804,"file_name":"DiesIrae_Ep_12_SUB_ITA.mp4","tg_post":0},{"id":11961,"anime_id":453,"user_id":null,"number":"2","