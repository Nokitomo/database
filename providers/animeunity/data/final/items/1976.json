1976,"genre_id":34}},{"id":42,"name":"Supernatural","pivot":{"anime_id":1976,"genre_id":42}}],"related":[{"id":1976,"user_id":2,"title":"Saikin, Imouto no Yousu ga Chotto Okashiinda ga. OVA","imageurl":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/20573-1TsK5me8oI9I.jpg","plot":"OVA di Imocho","date":"2014","episodes_count":1,"episodes_length":23,"author":" ","created_at":"2020-01-01 18:26:37","status":"Terminato","imageurl_cover":"","type":"OVA","slug":"recently-my-sister-is-unusual-ova","title_eng":"Recently, My Sister is Unusual OVA","day":"Indeterminato","favorites":55,"score":"7.00","visite":48820,"studio":"project No.9","dub":0,"always_home":0,"members":344,"cover":null,"anilist_id":20573,"season":"Primavera","title_it":"imocho OVA","mal_id":21679,"crunchy_id":null,"netflix_id":null,"prime_id":null,"disney_id":null,"pivot":{"anime_id":1976,"related_id":1976,"number":1}},{"id":1975,"user_id":2,"title":"Saikin, Imouto no Yousu ga Chotto Okashiinda ga.","imageurl":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/bx17777-JyiQrGXjw0s0.jpg","plot":"La commedia ecchi segue e vicende di Mitsuki Kanzaki, una ragazza che vive sotto lo stesso tetto col suo fratellastro Yuuya, dopo che la madre si è risposata. I novelli sposi si sono trasferiti oltre oceano per lavoro, Mitsuki si sente abbandonata e sfoga il suo risentimento, verso la genitrice, con ostilità nei confronti di Yuuya. Ma la vera storia comincia quando Mitsuki viene posseduta dallo spirito di Hiyori Kotobuki, una giovane ragazza, che non riesce a passare oltre. Il fantasma si impossessa del corpo della protagonista, con l’obiettivo di sedurre Yuuya, per poter varcare “Le porte del paradiso”. Per raggiungere tale scopo, Hiyori impone a Mitsuki una cintura denominata TST (Tei-Sou-Tai ossia una cintura di castità). La TST ha un lucchetto a forma di cuore, che si carica ogni volta che Mitsuki prova stimoli sessuali causati da Yuuya, sia che si tratti di un piacevole appuntamento, di un bacio o di atti sessuali più o meno spinti. Ogni volta che la cintura si carica, Hiyori guadagna un gradino del passaggio che la connette alle porte del cielo. Mitsuki, per liberasi di Hiyori e della cintura, dovrà inventarsi ogni sorta di avance e sedurre il suo fratellastro, senza mai però poter andare infondo...","date":"2014","episodes_count":12,"episodes_length":23,"author":" ","created_at":"2020-01-01 18:24:30","status":"Terminato","imageurl_cover":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/n17777-4yGqRd7toIfO.jpg","type":"TV","slug":"recently-my-sister-is-unusual","title_eng":"Recently, my sister is unusual.","day":"Indeterminato","favorites":187,"score":"6.88","visite":114489,"studio":"project No.9","dub":0,"always_home":0,"members":1199,"cover":null,"anilist_id":17777,"season":"Inverno","title_it":"imocho","mal_id":17777,"crunchy_id":null,"netflix_id":null,"prime_id":null,"disney_id":null,"pivot":{"anime_id":1976,"related_id":1975,"number":1}}]},"archive":null},"sourceEpisodes":[{"id":36074,"anime_id":1976,"user_id":null,"number":"1","created_at":"2020-01-01 18:30:12","link":"https://server1.streamingaw.online/DDL/ANIME/ImoCho/ImoCho_OAV_SUB_ITA.mp4","visite":48820,"hidden":0,"public":1,"scws_id":74420,"file_name":"ImoCho_OAV_SUB_ITA.mp4","tg_post":0}],"artworkInventory":{"logo":[{"source":"tmdb","url":"https://image.tmdb.org/t/p/original/afO6fgBM9v1VDuFQbrzzA5Gzp0r.png"},{"source":"tvdb","url":"https://artworks.thetvdb.com/banners/v4/series/275614/clearlogo/611f77d571b34.png"},{"source":"anizip","url":"https://artworks.thetvdb.com/banners/v4/series/275614/clearlogo/611f77d851c29.png"}],"poster":[{"source":"tmdb","url":"https://image.tmdb.org/t/p/original/ehNa9Aci4Yd4ASVp74EhAhwxo6K.jpg"},{"source":"anizip","url":"https://artworks.thetvdb.com/banners/posters/275614-1.jpg"},{"source":"provider","url":"https://img.animeunity.co/anime/20573-1TsK5me8oI9I.jpg"},{"source":"anilist","url":"https://s4.anilist.co/file/anilistcdn/media/anime/cove