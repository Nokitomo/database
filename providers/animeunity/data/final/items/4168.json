mbattere i suoi nemici, dai poteri rivoltanti e inumani, armato solo del suo corpo e della sua spada- la sua umana forza. Cosa si cela alla fine di questo viaggio? La risposta è avvolta nella &quot;notte&quot;. Spalanca gli occhi e scruta l'oscurità !","date":"2017","episodes_count":12,"episodes_length":24,"author":" ","created_at":"2019-04-30 14:37:58","status":"Terminato","imageurl_cover":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/97643-ggveKlc8ffbd.jpg","type":"TV","slug":"berserk-2017","title_eng":"Berserk (2017)","day":"Giovedì","favorites":252,"score":"7.88","visite":517744,"studio":"Millepensee","dub":0,"always_home":0,"members":1645,"cover":null,"anilist_id":97643,"season":"Primavera","title_it":null,"mal_id":34055,"crunchy_id":null,"netflix_id":null,"prime_id":null,"disney_id":null,"pivot":{"anime_id":4168,"related_id":552,"number":1}},{"id":4056,"user_id":2,"title":"Berserk: Ougon Jidai-hen - MEMORIAL EDITION","imageurl":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/bx155011-dCGHIBUyI2km.jpg","plot":"Riadattamento televisivo della trilogia di film che copre l'arco \"The Golden Age\" del manga originale.","date":"2022","episodes_count":13,"episodes_length":26,"author":" ","created_at":"2022-10-01 19:19:43","status":"Terminato","imageurl_cover":"","type":"TV","slug":"berserk-the-golden-age-arc-memorial-edition","title_eng":"Berserk: The Golden Age Arc - Memorial Edition","day":"Sabato","favorites":152,"score":"8.30","visite":238374,"studio":"Studio 4°C","dub":0,"always_home":1,"members":892,"cover":"https://img.animeworld.tv/copertine/hI0iu.jpg","anilist_id":155011,"season":"Autunno","title_it":null,"mal_id":52976,"crunchy_id":null,"netflix_id":null,"prime_id":null,"disney_id":null,"pivot":{"anime_id":4168,"related_id":4056,"number":1}}]},"archive":null},"sourceEpisodes":[{"id":66823,"anime_id":4168,"user_id":2,"number":"1","created_at":"2022-12-08 00:11:06","link":"https://www.forbiddenlol.cloud/DDL/ANIME/BerserkTheGoldenAge