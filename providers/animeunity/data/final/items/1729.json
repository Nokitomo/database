{"id":1729,"path":"/anime/1729-tsubasa-shunraiki","linkSchemaVersion":2,"enrichmentSchemaVersion":2,"updatedAt":"2026-10-31T21:56:35.786Z","episodeSafetyVersion":1,"info":{"title":"Tsubasa: Shunraiki","synopsis":"Questi OAV su Tsubasa Chronicles si collocano dopo quelli ambientati ad Acid Tokyo (Tsubasa Revelations). Dopo le vicende avvenute nel regno di Infinity, e dopo la saga di Celes, il regno d'origine di Fay, Shaoran e compagni si trovano ora nel mondo del Giappone di Kurogane. Qui il corpo di Sakura è tenuto in vita grazie a un magico albero, all'interno della residenza della principessa Tomoyo. Fanno la comparsa personaggi già noti, chi in visita di cortesia, chi con loschi obiettivi. L'intento è sempre quello di recuperare le magiche piume della memoria della principessa Sakura.","image":"https://image.tmdb.org/t/p/original/6yEPWAfQQmkZTht21z9OYZP9f8E.jpg","poster":"https://image.tmdb.org/t/p/original/tfaWVY4cLW1iSuZQcaIQhsjijBD.jpg","logo":"https://image.tmdb.org/t/p/original/hJJrDltSIDfZhQDF2GFKacGXPY.png","background":"https://image.tmdb.org/t/p/original/6yEPWAfQQmkZTht21z9OYZP9f8E.jpg","imdbId":"","type":"series","tags":["OVA","Terminato","Primavera","2009"],"tagKeys":{"OVA":"OVA","Terminato":"Completed","Primavera":"Spring"},"genres":["Action","Adventure","Drama","Fantasy","Mystery","Romance","Shounen","Supernatural"],"rating":"8.2","studio":"Production I.G","episodesCount":2,"extra":{"ids":{"malId":4938,"anilistId":4938,"crunchyId":null,"disneyId":null,"netflixId":null,"primeId":null,"anilistIds":[807,2685,4938],"malIds":[807,2685,4938],"anidbIds":[3317,5301,6191],"imdbMovieIds":["tt0466551"],"imdbShowIds":[],"tmdbMovieIds":[42180],"tmdbShowIds":[37565],"tvdbMovieIds":[],"tvdbShowIds":[76023]},"stats":{"scoreRaw":"8.23","favorites":48,"members":250,"views":40367,"episodesCountRaw":2,"episodesLength":29},"flags":{"dub":0,"alwaysHome":0},"meta":{"day":"Indeterminato","season":"Primavera","status":"Terminato","type":"OVA","createdAt":"2019-11-02 00:49:03