7785.jpg"},{"source":"provider","url":"https://img.animeunity.co/anime/101581-KIqMWVgmtTPR.jpg"},{"source":"anilist","url":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/101581-KIqMWVgmtTPR.jpg"}]}},"related":[{"title":"Yuragi-sou no Yuuna-san OVA","link":"/anime/1857-yuragi-sou-no-yuuna-san-ova","image":"https://img.animeunity.co/anime/nx101581-x0HeSfA0177A.jpg","type":"OVA","year":"2018","dubStatus":"subbed","dubStatusKey":"Subbed","variants":[{"status":"subbed","statusKey":"Subbed","title":"Yuragi-sou no Yuuna-san OVA","link":"/anime/1857-yuragi-sou-no-yuuna-san-ova","image":"https://img.animeunity.co/anime/nx101581-x0HeSfA0177A.jpg"}]},{"title":"Yuuna and the Haunted Hot Springs","link":"/anime/116-yuuna-and-the-haunted-hot-springs","image":"https://img.animeunity.co/anime/nx100483-fzseZYJnQTLI.jpg","type":"TV","year":"2018","dubStatus":"subbed","dubStatusKey":"Subbed","variants":[{"status":"subbed","statusKey":"Subbed","title":"Yuuna and the Haunted Hot Springs","link":"/anime/116-yuuna-and-the-haunted-hot-springs","image":"https://img.animeunity.co/anime/nx100483-fzseZYJnQTLI.jpg"}]}],"linkList":[{"title":"Episodes 1-4","titleKey":"Episodes {{start}}-{{end}}","titleParams":{"start":1,"end":4},"availabilityStatus":"available","episodesLink":"1857|1|4"}]},"episodes":[{"title":"Episodio 1","episodeNumber":1,"sourceEpisodeNumber":1,"seasonNumber":0,"externalMappings":[{"provider":"anidb","id":"13659","scope":"R","episodeNumbers":[1]},{"provider":"anilist","id":"101581","episodeNumbers":[1]},{"provider":"mal","id":"36950","episodeNumbers":[1]},{"provider":"tmdb_show","id":"80504","scope":"s0","seasonNumber":0,"episodeNumbers":[1]},{"provider":"tvdb_show","id":"344980","scope":"s0","seasonNumber":0,"episodeNumbers":[1]}],"link":"34271","synopsis":"Bundled with the 11th volume of the manga.\n\nKogarashi and Yuuna wake up and meet up with Chitose who asks Kogarashi to call the other residents of Yuragi Inn for breakfast. With the help of Yuuna he is able to call others for breakfast but is gravely injured. He then goes to his part-time job but when he returns no one is there in the Inn to welcome him. He sees Yaya's cat and follow him and finds that everyone has set up a welcome party for him. After some days Kogarashi is tasked with cleaning the hot-spring bath. While cleaning Shigaraki enters sleepwalking and turns Kogarashi into body-shampoo. He is not able to turn back to normal. Then all the residents of the Inn come to bath and Kogarashi is able to feel all of their bodies. Just when he had enough and wanted to turn back to normal, Shigaraki cancels her spell and he returns back to normal only to be beaten by Sagiri.","thumbnail":"https://image.tmdb.org/t/p/w300/uHf9dvRGcgc5po3urXj5pm19fBI.jpg","metadataSources":{"tmdb":{"title":"Episodio 1","synopsis":"Bundled with the 11th volume of the manga.\n\nKogarashi and Yuuna wake up and meet up with Chitose who asks Kogarashi to call the other residents of Yuragi Inn for breakfast. With the help of Yuuna he is able to call others for breakfast but is gravely injured. He then goes to his part-time job but when he returns no one is there in the Inn to welcome him. He sees Yaya's cat and follow him and finds that everyone has set up a welcome party for him. After some days Kogarashi is tasked with cleaning the hot-spring bath. While cleaning Shigaraki enters sleepwalking and turns Kogarashi into body-shampoo. He is not able to turn back to normal. Then all the residents of the Inn come to bath and Kogarashi is able to feel all of their bodies. Just when he had enough and wanted to turn back to normal, Shigaraki cancels her spell and he returns back to normal only to be beaten by Sagiri.","thumbnail":"https://image.tmdb.org/t/p/w300/uHf9dvRGcgc5po3urXj5pm19fBI.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}},{"title":"Episodio 2","episodeNumber":2,"sourceEpisodeNumber":2,"seasonNumber":0,"externalMappings":[{"provider":"anidb","id":"13659","scope":"R","episodeNumbers":[2]},{"provider":"anilist","id":"101581","episodeNumbers":[2]},{"provider":"mal","id":"36950","episodeNumbers":[2]},{"provider":"tmdb_show","id":"80504","scope":"s0","seasonNumber":0,"episodeNumbers":[2]},{"provider":"tvdb_show","id":"344980","scope":"s0","seasonNumber":0,"episodeNumbers":[2]}],"link":"34272","synopsis":"Bundled with the 12th volume of the manga.\n\nOboro asks for advice from all the residents of Yuuragi-Inn for ways to make Kogarashi fall in love with her but everything she tries goes in vain. While taking to Oboro during bath, Yuuna realises that she is in love with Kogarashi but denies it to Oboro. Koyuzu spents her summer at the Miyazaki's. Both Chisaki and her mother get fond of Koyuzu and ask her to stay with them forever but Koyuzu kindly rejects their offer because she thinks that if she starts living with them, she will come to accept that she is not a complete adult, which she doesn't want.","thumbnail":"https://image.tmdb.org/t/p/w300/kv2RJEwIlzW9qjpwfwrq3hc3OlZ.jpg","metadataSources":{"tmdb":{"title":"Episodio 2","synopsis":"Bundled with the 12th volume of the manga.\n\nOboro asks for advice from all the residents of Yuuragi-Inn for ways to make Kogarashi fall in love with her but everything she tries goes in vain. While taking to Oboro during bath, Yuuna realises that she is in love with Kogarashi but denies it to Oboro. Koyuzu spents her summer at the Miyazaki's. Both Chisaki and her mother get fond of Koyuzu and ask her to stay with them forever but Koyuzu kindly rejects their offer because she thinks that if she starts living with them, she will come to accept that she is not a complete adult, which she doesn't want.","thumbnail":"https://image.tmdb.org/t/p/w300/kv2RJEwIlzW9qjpwfwrq3hc3OlZ.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}},{"title":"Episodio 3","episodeNumber":3,"sourceEpisodeNumber":3,"seasonNumber":0,"externalMappings":[{"provider":"anidb","id":"13659","scope":"R","episodeNumbers":[3]},{"provider":"anilist","id":"101581","episodeNumbers":[3]},{"provider":"mal","id":"36950","episodeNumbers":[3]},{"provider":"tmdb_show","id":"80504","scope":"s0","seasonNumber":0,"episodeNumbers":[3]},{"provider":"tvdb_show","id":"344980","scope":"s0","seasonNumber":0,"episodeNumbers":[3]}],"link":"34270","synopsis":"Bundled with the 13th volume of the manga.\n\nKogarashi is working part-time at a festival. He finds that Yaya also came to the festival because it's a festival for cat gods. Yaya asks for Kogarashi's help to make fish for the cat gods. But a cat god Amazaki comes to have revenge from Yaya for his defeat. Yaya is able to defeat the cat god with a little help from Kogarashi. Yuuna, Oboro, Miyazaki and Koyuzu talk about love and their relationship with Kogarashi. They think that Kogarashi might be into idols so they practice to become idols but Kogarashi enters the room while they are practicing but leaves soon pretending to not have seen anything.","thumbnail":"https://image.tmdb.org/t/p/w300/5ChVtBm8I9NU0vboSrmwO2DYpiW.jpg","metadataSources":{"tmdb":{"title":"Episodio 3","synopsis":"Bundled with the 13th volume of the manga.\n\nKogarashi is working part-time at a festival. He finds that Yaya also came to the festival because it's a festival for cat gods. Yaya asks for Kogarashi's help to make fish for the cat gods. But a cat god Amazaki comes to have revenge from Yaya for his defeat. Yaya is able to defeat the cat god with a little help from Kogarashi. Yuuna, Oboro, Miyazaki and Koyuzu talk about love and their relationship with Kogarashi. They think that Kogarashi might be into idols so they practice to become idols but Kogarashi enters the room while they are practicing but leaves soon pretending to not have seen anything.","thumbnail":"https://image.tmdb.org/t/p/w300/5ChVtBm8I9NU0vboSrmwO2DYpiW.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}},{"title":"Episodio 4","episodeNumber":4,"sourceEpisodeNumber":4,"seasonNumber":0,"externalMappings":[{"provider":"anidb","id":"13659","scope":"R","episodeNumbers":[4]},{"provider":"anilist","id":"101581","episodeNumbers":[4]},{"provider":"mal","id":"36950","episodeNumbers":[4]},{"provider":"tmdb_show","id":"80504","scope":"s0","seasonNumber":0,"episodeNumbers":[4]},{"provider":"tvdb_show","id":"344980","scope":"s0","seasonNumber":0,"episodeNumbers":[4]}],"link":"49382","synopsis":"Bundled with the 24th volume of the manga.\n\nHibari and Sagiri were on a mission for squadron. Their target was a dangerous ghost, a spellcaster. There, Kogarashi was doing his part-time job. When he nearly defeated it, the ghost threw a powerful spell on him . Now, the spell can only remove by seeing twelve panties or he'll die.","thumbnail":"https://image.tmdb.org/t/p/w300/9IU98Tuxs5br7ZVRcUwgckTmPHB.jpg","metadataSources":{"tmdb":{"title":"Episodio 4","synopsis":"Bundled with the 24th volume of the manga.\n\nHibari and Sagiri were on a mission for squadron. Their target was a dangerous ghost, a spellcaster. There, Kogarashi was doing his part-time job. When he nearly defeated it, the ghost threw a powerful spell on him . Now, the spell can only remove by seeing twelve panties or he'll die.","thumbnail":"https://image.tmdb.org/t/p/w300/9IU98Tuxs5br7ZVRcUwgckTmPHB.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}}],"sourceIds":{"anilistId":101581,"malId":36950},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-30T07:57:40Z","sourceDescriptors":["anilist:101581","mal:36950"],"targets":[{"provider":"anidb","id":"13659","scope":"R","ranges":{"1-4":"1-4"}},{"provider":"anilist","id":"101581","ranges":{"1-4":"1-4"}},{"provider":"mal","id":"36950","ranges":{"1-4":"1-4"}},{"provider":"tmdb_show","id":"80504","scope":"s0","ranges":{"1-4":"1-4"}},{"provider":"tvdb_show","id":"344980","scope":"s0","ranges":{"1-4":"1-4"}}]},"sourceMetadata":{"info":{"id":1857,"title":null,"title_eng":"Yuragi-sou no Yuuna-san OVA","slug":"yuragi-sou-no-yuuna-san-ova","plot":"OVA di Yuragi