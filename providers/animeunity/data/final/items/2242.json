ilable","episodesLink":"2242|1|1"}]},"episodes":[{"title":"Una ragazza si innamora di una ragazza","episodeNumber":1,"sourceEpisodeNumber":1,"externalMappings":[{"provider":"anilist","id":"1654","episodeNumbers":[1]},{"provider":"mal","id":"1654","episodeNumbers":[1]},{"provider":"tvdb_show","id":"80984","scope":"s0","seasonNumber":0,"episodeNumbers":[1]}],"link":"39504","metadataSources":{"tmdb":{},"tvdb":{"title":"Una ragazza si innamora di una ragazza","synopsis":"Yasuna decided that she wanted to be single after all and broke up with Hazumu who then asked Tomari out. It has been four months since then and Tomari, uneasy with what Hazumu said, spent the entire time avoiding her. When winter finally arrives, Yasuna plans a Christmas event to try and pair Hazumu with Tomari. With the aid of Hazumu's friends, and even Hitoshi and Jan Pu, Tomari and Hazumu finally enter a romantic relationship.","titleLanguage":"ita","synopsisLanguage":"eng"}},"synopsis":"Yasuna decided that she wanted to be single after all and broke up with Hazumu who then asked Tomari out. It has been four months since then and Tomari, uneasy with what Hazumu said, spent the entire time avoiding her. When winter finally arrives, Yasuna plans a Christmas event to try and pair Hazumu with Tomari. With the aid of Hazumu's friends, and even Hitoshi and Jan Pu, Tomari and Hazumu finally enter a romantic relationship."}],"sourceIds":{"anilistId":1654,"malId":1654},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-30T07:57:40Z","sourceDescriptors":["anilist:1654","mal:1654"],"imdbSource":"plexanibridge-v2","targets":[{"provider":"anilist","id":"1654","ranges":{"1":"1"}},{"provider":"mal","id":"1654","ranges":{"1":"1"}},{"provider":"tvdb_show","id":"80984","scope":"s0","ranges":{"1":"1"}}]},"sourceMetadata":{"info":{"id":2242,"title":"Kashimashi: Girl Meets Girl - Shoujo wa Shoujo ni Koi wo Shita","title_eng":"Girl Meets Girl (OVA)","slug":"girl-meets-girl-ova","plot":"Epi