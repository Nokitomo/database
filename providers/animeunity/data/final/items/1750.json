n4UHIuHnW38ESzhcmNhYw.jpg"},{"source":"cinemeta","url":"https://live.metahub.space/background/medium/tt1143944/img"},{"source":"tvdb","url":"https://artworks.thetvdb.com/banners/fanart/original/80676-2.jpg"},{"source":"anizip","url":"https://artworks.thetvdb.com/banners/fanart/original/80676-1.jpg"},{"source":"provider","url":"https://img.animeunity.co/anime/2970-NPxhKLeu3HfT.jpg"},{"source":"anilist","url":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/2970-NPxhKLeu3HfT.jpg"}]}},"related":[],"linkList":[{"title":"Episodes 1-13","titleKey":"Episodes {{start}}-{{end}}","titleParams":{"start":1,"end":13},"availabilityStatus":"available","episodesLink":"1750|1|13"}]},"episodes":[{"title":"Episodio 1","episodeNumber":1,"sourceEpisodeNumber":1,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"5357","scope":"R","episodeNumbers":[1]},{"provider":"anilist","id":"2970","episodeNumbers":[1]},{"provider":"mal","id":"2970","episodeNumbers":[1]},{"provider":"tmdb_show","id":"96261","scope":"s1","seasonNumber":1,"episodeNumbers":[1]},{"provider":"tvdb_show","id":"80676","scope":"s1","seasonNumber":1,"episodeNumbers":[1]}],"link":"32509","synopsis":"Renji Hiiragi is dispatched by Anzelotte, his employer, to destroy a group of Emulators with the aid of fellow Night Wizard Akari Himuro. The two easily destroy the Emulators, although Renji complains that he cannot attend school due to his job. Elsewhere, Elis Shihō transfers into Kimei Private Academy, Renji's school, and joins the Astronomy Club headed by Kureha Akabane. Renji tries to return to school, but is shepherded away by Anzelotte for another mission. As he walks home in the evening, Anzelotte picks up him via helicopter for a third mission. A red moon then appears in the sky, and Elis walks entranced towards an old sakura tree at the school, and Kureha follows her. The Demon Lord Bell Zephyr sends an Emulator to kill the two, and Kureha reveals that she is a Night Wizard as well. Renji arrives as well, but the two are unable to stop the Emulator from attacking Elis, whose bracelet absorbs a jewel from the sakura tree and manifests as a group of shields. Renji dispatches the Emulator, and Renji and Kureha take Elis to Anzelotte.","thumbnail":"https://image.tmdb.org/t/p/w300/objfgvxZ09hGVlFWCqbRbxyx91Y.jpg","metadataSources":{"tmdb":{"title":"Episodio 1","synopsis":"Renji Hiiragi is dispatched by Anzelotte, his employer, to destroy a group of Emulators with the aid of fellow Night Wizard Akari Himuro. The two easily destroy the Emulators, although Renji complains that he cannot attend school due to his job. Elsewhere, Elis Shihō transfers into Kimei Private Academy, Renji's school, and joins the Astronomy Club headed by Kureha Akabane. Renji tries to return to school, but is shepherded away by Anzelotte for another mission. As he walks home in the evening, Anzelotte picks up him via helicopter for a third mission. A red moon then appears in the sky, and Elis walks entranced towards an old sakura tree at the school, and Kureha follows her. The Demon Lord Bell Zephyr sends an Emulator to kill the two, and Kureha reveals that she is a Night Wizard as well. Renji arrives as well, but the two are unable to stop the Emulator from attacking Elis, whose bracelet absorbs a jewel from the sakura tree and manifests as a group of shields. Renji dispatches the Emulator, and Renji and Kureha take Elis to Anzelotte.","thumbnail":"https://image.tmdb.org/t/p/w300/objfgvxZ09hGVlFWCqbRbxyx91Y.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}},{"title":"Episodio 2","episodeNumber":2,"sourceEpisodeNumber":2,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"5357","scope":"R","episodeNumbers":[2]},{"provider":"anilist","id":"2970","episodeNumbers":[2]},{"provider":"mal","id":"2970","episodeNumbers":[2]},{"provider":"tmdb_show","id":"96261","scope":"s1","seasonNumber":1,"episodeNumbers":[2]},{"provider":"tvdb_show","id":"80676","scope":"s1","seasonNumber":1,"episodeNumbers":[2]}],"link":"32507","synopsis":"“七徳の宝玉”の一つ“慈愛の玉”を手に入れたエリスにキマイラが襲いかかった。そこにアンゼロットからエリスの保護を命じられた柊が現れる。柊と共にキマイラを倒したエリスは、柊からアンゼロットの宮殿に連れて行かれ、自分がナイトウィザードの一人で、七つの宝玉を見い出す力を持っていることを聞かされて…。","thumbnail":"https://image.tmdb.org/t/p/w300/yXMEWCVP7wQ2gshCpqa8KmQAMYp.jpg","metadataSources":{"tmdb":{"title":"Episodio 2","synopsis":"“七徳の宝玉”の一つ“慈愛の玉”を手に入れたエリスにキマイラが襲いかかった。そこにアンゼロットからエリスの保護を命じられた柊が現れる。柊と共にキマイラを倒したエリスは、柊からアンゼロットの宮殿に連れて行かれ、自分がナイトウィザードの一人で、七つの宝玉を見い出す力を持っていることを聞かされて…。","thumbnail":"https://image.tmdb.org/t/p/w300/yXMEWCVP7wQ2gshCpqa8KmQAMYp.jpg","titleLanguage":"it-IT","synopsisLanguage":"ja-JP"}}},{"title":"Episodio 3","episodeNumber":3,"sourceEpisodeNumber":3,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"5357","scope":"R","episodeNumbers":[3]},{"provider":"anilist","id":"2970","episodeNumbers":[3]},{"provider":"mal","id":"2970","episodeNumbers":[3]},{"provider":"tmdb_show","id":"96261","scope":"s1","seasonNumber":1,"episodeNumbers":[3]},{"provider":"tvdb_show","id":"80676","scope":"s1","seasonNumber":1,"episodeNumbers":[3]}],"link":"32519","synopsis":"二つ目の宝玉を探しに伝説の大陸メガラニカへとやって来た柊たちをゴーレムが襲った。応戦する柊たちだったが、その固さに苦戦してしまう。そんな彼らの元に、ナイトウィザードの一人である緋室灯が駆けつけ、力を合わせてゴーレムを撃退する。そして、氷の神殿にたどり着いた一同は、奥の広間で宝玉を見つけるが…。","thumbnail":"https://image.tmdb.org/t/p/w300/h6O8GavB81GRUTYsfk2UBRYiC2H.jpg","metadataSources":{"tmdb":{"title":"Episodio 3","synopsis":"二つ目の宝玉を探しに伝説の大陸メガラニカへとやって来た柊たちをゴーレムが襲った。応戦する柊たちだったが、その固さに苦戦してしまう。そんな彼らの元に、ナイトウィザードの一人である緋室灯が駆けつけ、力を合わせてゴーレムを撃退する。そして、氷の神殿にたどり着いた一同は、奥の広間で宝玉を見つけるが…。","thumbnail":"https://image.tmdb.org/t/p/w300/h6O8GavB81GRUTYsfk2UBRYiC2H.jpg","titleLanguage":"it-IT","synopsisLanguage":"ja-JP"}}},{"title":"Episodio 4","episodeNumber":4,"sourceEpisodeNumber":4,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"5357","scope":"R","episodeNumbers":[4]},{"provider":"anilist","id":"2970","episodeNumbers":[4]},{"provider":"mal","id":"2970","episodeNumbers":[4]},{"provider":"tmdb_show","id":"96261","scope":"s1","seasonNumber":1,"episodeNumbers":[4]},{"provider":"tvdb_show","id":"80676","scope":"s1","seasonNumber":1,"episodeNumbers":[4]}],"link":"32515","synopsis":"アンゼロットから、三つ目の宝玉のある場所が月だと知らされたエリスたち。さっそく、宇宙航行用でスペースシャトルタイプの箒“シルバースター”に乗って、一同は月へと向かうことになる。だが、どこからともなく現れた大量の白ウサギによって船体が破壊され、エリスたちはバラバラに月面に放り出されてしまうが…。","thumbnail":"https://image.tmdb.org/t/p/w300/8trQRXJVvbr4rELMhoIH3bIHCWB.jpg","metadataSources":{"tmdb":{"title":"Episodio 4","synopsis":"アンゼロットから、三つ目の宝玉のある場所が月だと知らされたエリスたち。さっそく、宇宙航行用でスペースシャトルタイプの箒“シルバースター”に乗って、一同は月へと向かうことになる。だが、どこからともなく現れた大量の白ウサギによって船体が破壊され、エリスたちはバラバラに月面に放り出されてしまうが…。","thumbnail":"https://image.tmdb.org/t/p/w300/8trQRXJVvbr4rELMhoIH3bIHCWB.jpg","titleLanguage":"it-IT","synopsisLanguage":"ja-JP"}}},{"title":"Episodio 5","episodeNumber":5,"sourceEpisodeNumber":5,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"5357","scope":"R","episodeNumbers":[5]},{"provider":"anilist","id":"2970","episodeNumbers":[5]},{"provider":"mal","id":"2970","episodeNumbers":[5]},{"provider":"tmdb_show","id":"96261","scope":"s1","seasonNumber":1,"episodeNumbers":[5]},{"provider":"tvdb_show","id":"80676","scope":"s1","seasonNumber":1,"episodeNumbers":[5]}],"link":"32511","synopsis":"アンゼロットから知らされた次なる宝玉の場所は、“地図にない島”だった。そこには魔剣使いの安藤来栖が一人で住んでおり、結界で覆って宝玉を守っているのだという。島に訪れたエリスたちは、安藤に会って説得を開始する。だが、全く効く耳を持たない安藤の様子にしびれを切らした柊は、魔剣で彼に打ちかかるが…。","thumbnail":"https://image.tmdb.org/t/p/w300/yyHFeFoZIMiutS0tzkwRJP1reBZ.jpg","metadataSources":{"tmdb":{"title":"Episodio 5","synopsis":"アンゼロットから知らされた次なる宝玉の場所は、“地図にない島”だった。そこには魔剣使いの安藤来栖が一人で住んでおり、結界で覆って宝玉を守っているのだという。島に訪れたエリスたちは、安藤に会って説得を開始する。だが、全く効く耳を持たない安藤の様子にしびれを切らした柊は、魔剣で彼に打ちかかるが…。","thumbnail":"https://image.tmdb.org/t/p/w300/yyHFeFoZIMiutS0tzkwRJP1reBZ.jpg","titleLanguage":"it-IT","synopsisLanguage":"ja-JP"}}},{"title":"Episodio 6","episodeNumber":6,"sourceEpisodeNumber":6,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"5357","scope":"R","episodeNumbers":[6]},{"provider":"anilist","id":"2970","episodeNumbers":[6]},{"provider":"mal","id":"2970","episodeNumbers":[6]},{"provider":"tmdb_show","id":"96261","scope":"s1","seasonNumber":1,"episodeNumbers":[6]},{"provider":"tvdb_show","id":"80676","scope":"s1","seasonNumber":1,"episodeNumbers":[6]}],"link":"32514","synopsis":"宮殿に呼び出され、アンゼロットの話を聞いていたエリスたち。そんな時、エリスはアンゼロットから一つの箱を差し出される。だが、その中にあった五つ目の宝玉“節制の玉”に触れた途端、エリスは昏睡状態に陥ってしまう。柊たちは彼女を助けるため、偶然居合わせたナイトメアの助けを借りてエリスの夢の中に入るが…。","thumbnail":"https://image.tmdb.org/t/p/w300/qLJYUfxXDtOkmpPCXEas3OZikjg.jpg","metadataSources":{"tmdb":{"title":"Episodio 6","synopsis":"宮殿に呼び出され、アンゼロットの話を聞いていたエリスたち。そんな時、エリスはアンゼロットから一つの箱を差し出される。だが、その中にあった五つ目の宝玉“節制の玉”に触れた途端、エリスは昏睡状態に陥ってしまう。柊たちは彼女を助けるため、偶然居合わせたナイトメアの助けを借りてエリスの夢の中に入るが…。","thumbnail":"https://image.tmdb.org/t/p/w300/qLJYUfxXDtOkmpPCXEas3OZikjg.jpg","titleLanguage":"it-IT","synopsisLanguage":"ja-JP"}}},{"title":"Episodio 7","episodeNumber":7,"sourceEpisodeNumber":7,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"5357","scope":"R","episodeNumbers":[7]},{"provider":"anilist","id":"2970","episodeNumbers":[7]},{"provider":"mal","id":"2970","episodeNumbers":[7]},{"provider":"tmdb_show","id":"96261","scope":"s1","seasonNumber":1,"episodeNumbers":[7]},{"provider":"tvdb_show","id":"80676","scope":"s1","seasonNumber":1,"episodeNumbers":[7]}],"link":"32513","synopsis":"灯も柊同様にエリスと同居することになった。そんなある日、校外のスケート場でスケート教室が開かれた。初めてのスケートにワクワクするエリスと相変わらずクールな灯。一方、エリスに起こしてもらったにも関わらず、二度寝して集合時間に遅れてしまった柊は、何とか遅刻を取り消してもらおうと担任に食い下がるが…。","thumbnail":"https://image.tmdb.org/t/p/w300/qeU034COWAPmFXgzRn2uPeaZvlS.jpg","metadataSources":{"tmdb":{"title":"Episodio 7","synopsis":"灯も柊同様にエリスと同居することになった。そんなある日、校外のスケート場でスケート教室が開かれた。初めてのスケートにワクワクするエリスと相変わらずクールな灯。一方、エリスに起こしてもらったにも関わらず、二度寝して集合時間に遅れてしまった柊は、何とか遅刻を取り消してもらおうと担任に食い下がるが…。","thumbnail":"https://image.tmdb.org/t/p/w300/qeU034COWAPmFXgzRn2uPeaZvlS.jpg","titleLanguage":"it-IT","synopsisLanguage":"ja-JP"}}},{"title":"Episodio 8","episodeNumber":8,"sourceEpisodeNumber":8,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"5357","scope":"R","episodeNumbers":[8]},{"provider":"anilist","id":"2970","episodeNumbers":[8]},{"provider":"mal","id":"2970","episodeNumbers":[8]},{"provider":"tmdb_show","id":"96261","scope":"s1","seasonNumber":1,"episodeNumbers":[8]},{"provider":"tvdb_show","id":"80676","scope":"s1","seasonNumber":1,"episodeNumbers":[8]}],"link":"32508","synopsis":"宝玉の光に包まれ、消えてしまった柊とエリス。そうしてエリスが現れた先は、砂漠に立つ巨大な塔の広間に描かれた魔法陣の中で、目前には魔王の一人であるエイミーが立っていた。一方、その塔の麓近くに現れた柊。そこにアンゼロットから連絡が入り、柊は自分たちが紀元前三千年の古代バビロニアにいることを知り…。","thumbnail":"https://image.tmdb.org/t/p/w300/w54DNebRrmi2WdZgXfR0aHh3xNS.jpg","metadataSources":{"tmdb":{"title":"Episodio 8","synopsis":"宝玉の光に包まれ、消えてしまった柊とエリス。そうしてエリスが現れた先は、砂漠に立つ巨大な塔の広間に描かれた魔法陣の中で、目前には魔王の一人であるエイミーが立っていた。一方、その塔の麓近くに現れた柊。そこにアンゼロットから連絡が入り、柊は自分たちが紀元前三千年の古代バビロニアにいることを知り…。","thumbnail":"https://image.tmdb.org/t/p/w300/w54DNebRrmi2WdZgXfR0aHh3xNS.jpg","titleLanguage":"it-IT","synopsisLanguage":"ja-JP"}}},{"title":"Episodio 9","episodeNumber":9,"sourceEpisodeNumber":9,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"5357","scope":"R","episodeNumbers":[9]},{"provider":"anilist","id":"2970","episodeNumbers":[9]},{"provider":"mal","id":"2970","episodeNumbers":[9]},{"provider":"tmdb_show","id":"96261","scope":"s1","seasonNumber":1,"episodeNumbers":[9]},{"provider":"tvdb_show","id":"80676","scope":"s1","seasonNumber":1,"episodeNumbers":[9]}],"link":"32512","synopsis":"最後の宝玉である“希望の玉”が土星の輪にあると、アンゼロットはエリスたちに告げた。さらに、彼女は「最後の宝玉を手に入れたと同時に裏界への扉を開け攻め込む」と話す。そして、以前行動を共にしたまゆりやナイトメアと一緒に土星の輪へと向かおうとするエリスたち。だが、そこに魔王のベール＝ゼファーが現れて…。","thumbnail":"https://image.tmdb.org/t/p/w300/8nDsam48VYWFzvDuznFPO9W97K1.jpg","metadataSources":{"tmdb":{"title":"Episodio 9","synopsis":"最後の宝玉である“希望の玉”が土星の輪にあると、アンゼロットはエリスたちに告げた。さらに、彼女は「最後の宝玉を手に入れたと同時に裏界への扉を開け攻め込む」と話す。そして、以前行動を共にしたまゆりやナイトメアと一緒に土星の輪へと向かおうとするエリスたち。だが、そこに魔王のベール＝ゼファーが現れて…。","thumbnail":"https://image.tmdb.org/t/p/w300/8nDsam48VYWFzvDuznFPO9W97K1.jpg","titleLanguage":"it-IT","synopsisLanguage":"ja-JP"}}},{"title":"Episodio 10","episodeNumber":10,"sourceEpisodeNumber":10,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"5357","scope":"R","episodeNumbers":[10]},{"provider":"anilist","id":"2970","episodeNumbers":[10]},{"provider":"mal","id":"2970","episodeNumbers":[10]},{"provider":"tmdb_show","id":"96261","scope":"s1","seasonNumber":1,"episodeNumbers":[10]},{"provider":"tvdb_show","id":"80676","scope":"s1","seasonNumber":1,"episodeNumbers":[10]}],"link":"32517","synopsis":"裏界への門を開く魔法陣により、エリスの背中に現れた七つの翼。それぞれの翼から放たれた光は、敵味方を問わず攻撃し、土星の輪の一部や衛星すらも破壊してしまう。その翼と絶大な力は大魔王であるシャイマールのもので、エリスが彼の転生体であることを示していた。そんなエリスをアンゼロットは抹殺しようとして…。","thumbnail":"https://image.tmdb.org/t/p/w300/tls0u6kCljWCocTVx96CLiLxTTR.jpg","metadataSources":{"tmdb":{"title":"Episodio 10","synopsis":"裏界への門を開く魔法陣により、エリスの背中に現れた七つの翼。それぞれの翼から放たれた光は、敵味方を問わず攻撃し、土星の輪の一部や衛星すらも破壊してしまう。その翼と絶大な力は大魔王であるシャイマールのもので、エリスが彼の転生体であることを示していた。そんなエリスをアンゼロットは抹殺しようとして…。","thumbnail":"https://image.tmdb.org/t/p/w300/tls0u6kCljWCocTVx96CLiLxTTR.jpg","titleLanguage":"it-IT","synopsisLanguage":"ja-JP"}}},{"title":"Episodio 11","episodeNumber":11,"sourceEpisodeNumber":11,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"5357","scope":"R","episodeNumbers":[11]},{"provider":"anilist","id":"2970","episodeNumbers":[11]},{"provider":"mal","id":"2970","episodeNumbers":[11]},{"provider":"tmdb_show","id":"96261","scope":"s1","seasonNumber":1,"episodeNumbers":[11]},{"provider":"tvdb_show","id":"80676","scope":"s1","seasonNumber":1,"episodeNumbers":[11]}],"link":"32510","synopsis":"アンゼロットに抹殺されそうになったエリスを守ったのは、かつてエリスたちを助けたキリヒトだった。さらに、駆けつけた柊も含めて宮殿から逃げ出した三人は、エリスのアパートへと逃げ込む。そして、三人はこれまでエリスを守ってきた“おじさま”に会うため、彼女が暮らしていた孤児院に向かおうとするが…。","thumbnail":"https://image.tmdb.org/t/p/w300/b7PtEmQnjcndH6I9rsIDddBdhrS.jpg","metadataSources":{"tmdb":{"title":"Episodio 11","synopsis":"アンゼロットに抹殺されそうになったエリスを守ったのは、かつてエリスたちを助けたキリヒトだった。さらに、駆けつけた柊も含めて宮殿から逃げ出した三人は、エリスのアパートへと逃げ込む。そして、三人はこれまでエリスを守ってきた“おじさま”に会うため、彼女が暮らしていた孤児院に向かおうとするが…。","thumbnail":"https://image.tmdb.org/t/p/w300/b7PtEmQnjcndH6