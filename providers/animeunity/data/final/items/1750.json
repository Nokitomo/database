{"id":1750,"path":"/anime/1750-night-wizard","linkSchemaVersion":2,"enrichmentSchemaVersion":2,"updatedAt":"2026-10-31T15:45:49.563Z","episodeSafetyVersion":1,"info":{"title":"Night Wizard","synopsis":"I Night Wizards sono maghi la cui missione è combattere le forze oscure che vogliono dominare il mondo. Renji Hiiragi è un Night Wizard che viene costantemente reclutato per delle missioni, anche se il suo unico desiderio è quello di andare a scuola e diplomarsi; il suo ultimo incarico è quello di proteggere Elis Shiho, una nuova studentessa trasferitasi nella sua accademia. Però, dopo essere entrata in possesso di uno dei sette gioielli segreti, Elis scoprirà di avere anche lei il potere di diventare un Night Wizard.","image":"https://image.tmdb.org/t/p/original/YSiPRn4UHIuHnW38ESzhcmNhYw.jpg","poster":"https://image.tmdb.org/t/p/original/6C5UpMhcZP5y8iyKYmqvONTdvBx.jpg","logo":"https://live.metahub.space/logo/medium/tt1143944/img","background":"https://image.tmdb.org/t/p/original/YSiPRn4UHIuHnW38ESzhcmNhYw.jpg","imdbId":"tt1143944","type":"series","tags":["TV","Terminato","Autunno","2007"],"tagKeys":{"TV":"TV","Terminato":"Completed","Autunno":"Autumn"},"genres":["Adventure","Fantasy"],"rating":"6.7","studio":"Hal Film Maker","episodesCount":13,"extra":{"ids":{"malId":2970,"anilistId":2970,"crunchyId":null,"disneyId":null,"netflixId":null,"primeId":null,"anilistIds":[2970],"malIds":[2970],"anidbIds":[5357],"imdbMovieIds":[],"imdbShowIds":[],"tmdbMovieIds":[],"tmdbShowIds":[96261],"tvdbMovieIds":[],"tvdbShowIds":[80676]},"stats":{"scoreRaw":"6.69","favorites":19,"members":147,"views":19604,"episodesCountRaw":13,"episodesLength":25},"flags":{"dub":0,"alwaysHome":0},"meta":{"day":"Indeterminato","season":"Autunno","status":"Terminato","type":"TV","createdAt":"2019-11-04 23:12:47","userId":78495},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-30T07:57:40Z","sourceDescriptors":["anilist:2970","mal:2970"],"imdbSource":"plexanibridge-v2"