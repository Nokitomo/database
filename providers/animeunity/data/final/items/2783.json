aba sull'amicizia tra una ragazza e un uccellino. Il brano musicale pone sia Mizore che Nozomi sotto i riflettori, per via di una parte di assolo destinata a Yoroizuka, e spinge le due ragazze a riconsiderare la propria amicizia.","date":"2018","episodes_count":1,"episodes_length":90,"author":" ","created_at":"2022-07-29 00:08:23","status":"Terminato","imageurl_cover":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/100178-pneDY2KoVnbz.jpg","type":"Movie","slug":"liz-to-aoi-tori-ita","title_eng":"Liz to Aoi Tori (ITA)","day":"Venerdì","favorites":31,"score":"8.00","visite":11364,"studio":"Kyoto Animation","dub":1,"always_home":0,"members":159,"cover":null,"anilist_id":100178,"season":"Primavera","title_it":null,"mal_id":35677,"crunchy_id":null,"netflix_id":null,"prime_id":null,"disney_id":null,"pivot":{"anime_id":2783,"related_id":3901,"number":1}},{"id":2784,"user_id":2,"title":"Sound! Euphonium: Our Promise: A Brand New Day","imageurl":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/bx101992-VZSoKfiRXscs.jpg","plot":"Film riassuntivo, con qualche aggiunta di parti inedite, della serie TV Hibike! Euphonium 2.","date":"2019","episodes_count":1,"episodes_length":100,"author":" ","created_at":"2020-09-24 22:14:35","status":"Terminato","imageurl_cover":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/101992-ymVmRVjQC1hd.jpg","type":"Movie","slug":"hibike-euphonium-movie-3-chikai-no-finale","title_eng":"Hibike! Euphonium Movie 3: Chikai no Finale","day":"Venerdì","favorites":33,"score":"8.20","visite":12311,"studio":"Kyoto Animation","dub":0,"always_home":0,"members":233,"cover":null,"anilist_id":101992,"season":"Primavera","title_it":null,"mal_id":35678,"crunchy_id":null,"netflix_id":null,"prime_id":null,"disney_id":null,"pivot":{"anime_id":2783,"related_id":2784,"number":1}},{"id":4819,"user_id":2,"title":null,"imageurl":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/bx150429-5KvbB5BBt2Yz.jpg","plot":"Insieme al conco