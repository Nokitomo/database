{"id":3286,"path":"/anime/3286-arjuna","linkSchemaVersion":2,"enrichmentSchemaVersion":2,"updatedAt":"2026-10-31T14:59:43.384Z","episodeSafetyVersion":1,"info":{"title":"Arjuna","synopsis":"La storia è incentrata su una studentessa di nome Juna Ariyoshi coinvolta in un terribile incidente in cui ha perso la vita. Successivamente, il suo spirito si è tramutato in luce e ha avuto una visione rappresentante la Terra alcuni mesi nel futuro ormai sull'orlo della distruzione a causa di alcune creature demoniache chiamate Raajas. Per evitare questa catastrofe, uno spirito consegnerà ad Ariyoshi una pietra speciale in grado di risvegliare i poteri dormienti delle persone.","image":"https://image.tmdb.org/t/p/original/9rny2ycbmlQsKncW3msL61cwEpt.jpg","poster":"https://image.tmdb.org/t/p/original/vMXadoQfB7slUqvvf8pnv3P92z2.jpg","logo":"https://images.metahub.space/logo/medium/tt0296324/img","background":"https://image.tmdb.org/t/p/original/9rny2ycbmlQsKncW3msL61cwEpt.jpg","imdbId":"tt0296324","type":"series","tags":["TV","Terminato","Inverno","2001"],"tagKeys":{"TV":"TV","Terminato":"Completed","Inverno":"Winter"},"genres":["Adventure","Drama","Fantasy","Mahou Shoujo","Sci-fi"],"rating":"7.0","studio":"Satelight","episodesCount":13,"extra":{"ids":{"malId":812,"anilistId":812,"crunchyId":null,"disneyId":null,"netflixId":null,"primeId":null,"anilistIds":[812],"malIds":[812],"anidbIds":[107],"imdbMovieIds":[],"imdbShowIds":[],"tmdbMovieIds":[],"tmdbShowIds":[42698],"tvdbMovieIds":[],"tvdbShowIds":[80113]},"stats":{"scoreRaw":"7.00","favorites":20,"members":98,"views":12279,"episodesCountRaw":13,"episodesLength":26},"flags":{"dub":0,"alwaysHome":0},"meta":{"day":"Indeterminato","season":"Inverno","status":"Terminato","type":"TV","createdAt":"2021-11-01 19:04:56","userId":78495},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-30T07:57:40Z","sourceDescriptors":["anilist:812","mal:812"],"imdbSource":"plexanibridge-v2","targets":[{"provider":"anidb