e si tratta di sfide spietate in cui anche la morte dell'avversario è permessa e non vi sono limiti nell'utilizzo delle armi. Tra le partecipanti c'è anche Reina, una ragazza appartenente a una famiglia nobiliare, ma stanca della vita di corte che deciderà di lasciare la sua casa per dirigersi nel luogo del torneo. Lungo la strada sarà costretta ad affrontare tante sfide minori e ciò le servirà per capire che per poter partecipare a dei combattimenti di tale entità dovrà allenarsi molto più duramente.","date":"2009","episodes_count":12,"episodes_length":24,"author":" ","created_at":"2019-07-04 17:28:10","status":"Terminato","imageurl_cover":"","type":"TV","slug":"queens-blade-the-exiled-virgin","title_eng":"Queen's Blade: The Exiled Virgin","day":"Indeterminato","favorites":179,"score":"6.71","visite":107450,"studio":"Arms","dub":0,"always_home":0,"members":1101,"cover":null,"anilist_id":4719,"season":"Primavera","title_it":null,"mal_id":4719,"crunchy_id":null,"netflix_id":null,"prime_id":null,"disney_id":null,"pivot":{"anime_id":1023,"related_id":1014,"number":1}},{"id":1017,"user_id":78495,"title":"Queen's Blade: Rurou no Senshi Specials","imageurl":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/6704.jpg","plot":"Episodi Special di Queen's Blade: Rurou no Senshi","date":"2009","episodes_count":6,"episodes_length":3,"author":" ","created_at":"2019-07-04 17:39:48","status":"Terminato","imageurl_cover":"","type":"Special","slug":"queens-blade-the-exiled-virgin-specials","title_eng":"Queen's Blade: The Exiled Virgin Specials","day":"Indeterminato","favorites":15,"score":"6.12","visite":33814,"studio":"Arms","dub":0,"always_home":0,"members":110,"cover":null,"anilist_id":6704,"season":"Estate","title_it":null,"mal_id":6704,"crunchy_id":null,"netflix_id":null,"prime_id":null,"disney_id":null,"pivot":{"anime_id":1023,"related_id":1017,"number":2}},{"id":1015,"user_id":78495,"title":"Queen's Blade: Gyokuza wo Tsugu Mono","imageurl":"https://s4.anilist.co/