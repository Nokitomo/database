EpisodeNumber":3,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"10934","scope":"R","episodeNumbers":[3]},{"provider":"anilist","id":"21319","episodeNumbers":[3]},{"provider":"mal","id":"28391","episodeNumbers":[3]},{"provider":"tmdb_show","id":"65713","scope":"s1","seasonNumber":1,"episodeNumbers":[3]},{"provider":"tvdb_show","id":"299505","scope":"s1","seasonNumber":1,"episodeNumbers":[3]}],"link":"18761","synopsis":"To boost the new recruits' skills, Aoi calls the Takafuji Flying Circus Team to arrange a training camp during spring break. During the last day of the camp, Reiko arranges some practice matches. Asuka is up against Rika Ichinose, a first-year and Speeder at Takafuji and she manages to score a point with an Air Kick Turn, surprising everyone, but ultimately loses the match.","thumbnail":"https://image.tmdb.org/t/p/w300/iT4ufoAZg6xPN8NWuwH0GAmxAnH.jpg","metadataSources":{"tmdb":{"title":"Episodio 3","synopsis":"To boost the new recruits' skills, Aoi calls the Takafuji Flying Circus Team to arrange a training camp during spring break. During the last day of the camp, Reiko arranges some practice matches. Asuka is up against Rika Ichinose, a first-year and Speeder at Takafuji and she manages to score a point with an Air Kick Turn, surprising everyone, but ultimately loses the match.","thumbnail":"https://image.tmdb.org/t/p/w300/iT4ufoAZg6xPN8NWuwH0GAmxAnH.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}},{"title":"Episodio 4","episodeNumber":4,"sourceEpisodeNumber":4,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"10934","scope":"R","episodeNumbers":[4]},{"provider":"anilist","id":"21319","episodeNumbers":[4]},{"provider":"mal","id":"28391","episodeNumbers":[4]},{"provider":"tmdb_show","id":"65713","scope":"s1","seasonNumber":1,"episodeNumbers":[4]},{"provider":"tvdb_show","id":"299505","scope":"s1","seasonNumber":1,"episodeNumbers":[4]}],"link":"18765","synopsis":"Mashiro has been kept busy by make-up exams recently, causing her to often be late to FC training. Meanwhile, Misaki and Asuka are improving at a fast rate, leaving Mashiro lagging behind. After bumping into Rika by chance, Mashiro asks her to teach her the basics. Training starts the next day, and slowly Mashiro begins to pick up, and finds that she is more suited to be a Speeder like Rika than a Fighter like Misaki.","thumbnail":"https://image.tmdb.org/t/p/w300/rSpLfazbwpmWgXQUUpl3YxngKu6.jpg","metadataSources":{"tmdb":{"title":"Episodio 4","synopsis":"Mashiro has been kept busy by make-up exams recently, causing her to often be late to FC training. Meanwhile, Misaki and Asuka are improving at a fast rate, leaving Mashiro lagging behind. After bumping into Rika by chance, Mashiro asks her to teach her the basics. Training starts the next day, and slowly Mashiro begins to pick up, and finds that she is more suited to be a Speeder like Rika than a Fighter like Misaki.","thumbnail":"https://image.tmdb.org/t/p/w300/rSpLfazbwpmWgXQUUpl3YxngKu6.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}},{"title":"Episodio 5","episodeNumber":5,"sourceEpisodeNumber":5,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"10934","scope":"R","episodeNumbers":[5]},{"provider":"anilist","id":"21319","episodeNumbers":[5]},{"provider":"mal","id":"28391","episodeNumbers":[5]},{"provider":"tmdb_show","id":"65713","scope":"s1","seasonNumber":1,"episodeNumbers":[5]},{"provider":"tvdb_show","id":"299505","scope":"s1","seasonNumber":1,"episodeNumbers":[5]}],"link":"18764","synopsis":"The Summer Tournament has started, and Asuka is up against a girl named Arika Okoze from Shitou Suisan Academy. Misaki is up against Rika and Mashiro against Reiko. There, Asuka also spots the white-haired girl, Inui Saki from Kairyou Academy, who is playing against Shion. First up is Mashiro's match against Reiko.","thumbnail":"https://image.tmdb.org/t/p/w300/vpcmMQxQetJ1JYzcZK9CxHCRzeW.jpg","metadataSources":{"tmdb":{"title":"Episodio 5","synop