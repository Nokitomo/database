EIB3PMpTWm.jpg"},{"source":"tvdb","url":"https://artworks.thetvdb.com/banners/fanart/original/5d46ecb49de4e.jpg"},{"source":"anizip","url":"https://artworks.thetvdb.com/banners/fanart/original/86921-1.jpg"}]}},"related":[],"linkList":[{"title":"Episodes 1-6","titleKey":"Episodes {{start}}-{{end}}","titleParams":{"start":1,"end":6},"availabilityStatus":"available","episodesLink":"6966|1|6"}]},"episodes":[{"title":"Episodio 1","episodeNumber":1,"sourceEpisodeNumber":1,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"139","scope":"R","episodeNumbers":[1]},{"provider":"anilist","id":"1944","episodeNumbers":[1]},{"provider":"mal","id":"1944","episodeNumbers":[1]},{"provider":"tmdb_show","id":"39383","scope":"s1","seasonNumber":1,"episodeNumbers":[1]},{"provider":"tvdb_show","id":"86921","scope":"s1","seasonNumber":1,"episodeNumbers":[1]}],"link":"100369","synopsis":"遠い未来か、はたまた過去かどうかもわからない時代……。さる惑星の地軸が大きく歪む原因不明の大異変により文明社会は消滅し、惑星全土の約90％近くが砂漠化していた。そんな世界のある村で一つの問題が生じていた。村長の孫娘であるアウンが、亜楽器の公演をしに来た吟遊詩人に一目惚れをし、村の宝を持ち出して彼を追いかけて行ってしまったのだ。村長に彼女を連れ戻すように頼まれたフォトンは、なんとかアウンから村の宝を取り戻すことに成功するが連れ戻すことはできず、逆に彼女の亜法で『宝の谷』の谷底へと落とされてしまうハメに！そこでフォトンは奇妙で巨大な鉄の塊を発見する。それは700年もの昔、この地に墜落したキーネの宇宙船の残骸であった……。","thumbnail":"https://image.tmdb.org/t/p/w300/3DV5Pq6Uzyh1Uxoif3xbRtBAqIz.jpg","metadataSources":{"tmdb":{"title":"Episodio 1","synopsis":"遠い未来か、はたまた過去かどうかもわからない時代……。さる惑星の地軸が大きく歪む原因不明の大異変により文明社会は消滅し、惑星全土の約90％近くが砂漠化していた。そんな世界のある村で一つの問題が生じていた。村長の孫娘であるアウンが、亜楽器の公演をしに来た吟遊詩人に一目惚れをし、村の宝を持ち出して彼を追いかけて行ってしまったのだ。村長に彼女を連れ戻すように頼まれたフォトンは、なんとかアウンから村の宝を取り戻すことに成功するが連れ戻すことはできず、逆に彼女の亜法で『宝の谷』の谷底へと落とされてしまうハメに！そこでフォトンは奇妙で巨大な鉄の塊を発見する。それは700年もの昔、この地に墜落したキーネの宇宙船の残骸であった……。","thumbnail":"https://image.tmdb.org/t/p/w300/3DV5Pq6Uzyh1Uxoif3xbRtBAqIz.jpg","titleLanguage":"it-IT","synopsisLanguage":"ja-JP"}}},{"title":"Episodio 2","episodeNumber":2,"sourceEpisodeNumber":2,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"139","scope":"R","episodeNumbers":[2]},{"provider":"anilist","id":"1944","episodeNumbers":[2]},{"provider":"mal","id":"1944","episodeNumbers":[2]},{"provider":"tmdb_show","id":"39383","scope":"s1","seasonNumber":1,"episodeNumbers":[2]},{"provider":"tvdb_show","id":"86921","scope":"s1","seasonNumber":1,"episodeNumbers":[2]}],"link":"100370","synopsis":"額の紋様は夫婦の証ぃ！知らぬとは言え結婚してしまったフォトンとキーネ。一方、恋の我が道を突き進むアウンはというと……。あっと言う間に振られてしまい、天国から地獄へ真っ逆さま！ガックシ肩を落としているその前に現れたのが、キーネを捕まえるためにこの『砂の惑星』に降り立ったパパチャであった。偶然とは言うものの利害関係がバッチシ合ったアウンとパパチャは、フォトンとキーネを追いかけ始める。果たして、縺れた糸は縺れっぱなしか？フォトンとキーネの新婚初夜は一体どーなる？それは見てのお楽しみ！","thumbnail":"https://image.tmdb.org/t/p/w300/zFMKnnEzp1RuOs0ezAv5jEp5KP2.jpg","metadataSources":{"tmdb":{"title":"Episodio 2","synopsis":"額の紋様は夫婦の証ぃ！知らぬとは言え結婚してしまったフォトンとキーネ。一方、恋の我が道を突き進むアウンはというと……。あっと言う間に振られてしまい、天国から地獄へ真っ逆さま！ガックシ肩を落としているその前に現れたのが、キーネを捕まえるためにこの『砂の惑星』に降り立ったパパチャであった。偶然とは言うものの利害関係がバッチシ合ったアウンとパパチャは、フォトンとキーネを追いかけ始める。果たして、縺れた糸は縺れっぱなしか？フォトンとキーネの新婚初夜は一体どーなる？それは見てのお楽しみ！","thumbnail":"https://image.tmdb.org/t/p/w300/zFMKnnEzp1RuOs0ezAv5jEp5KP2.jpg","titleLanguage":"it-IT","synopsisLanguage":"ja-JP"}}},{"title":"Episodio 3","episodeNumber":3,"sourceEpisodeNumber":3,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"139","scope":"R","episodeNumbers":[3]},{"provider":"anilist","id":"1944","episodeNumbers":[3]},{"provider":"mal","id":"1944","episodeNumbers":[3]},{"provider":"tmdb_show","id":"39383","scope":"s1","seasonNumber":1,"episodeNumbers":[3]},{"provider":"tvdb_show","id":"86921","scope":"s1","seasonNumber":1,"episodeNumbers":[3]}],"link":"100371","synopsis":"『砂の惑星』までキーネを追ってきたパパチャを撃退し、キーネのお爺ちゃんの亜法記憶体を捜す旅（新婚旅行とも言う……）を続けるフォトンとキーネ。そこには行きがかり上なんとなくついて来たアウンもいた。お腹を空かせた旦那様（フォトン）に料理を作る新婚気分のキーネがどうも面白くないアウン。そこで、二人の意地とプライドをかけた世紀の料理対決の火蓋が切って落とされる！はたして空腹のフォトンは無事にゴハンを食べることが出来るのか？そして、パパチャを追いかけるために旅立ったラシャラ皇女の行く先に待つ運命や……いかに！？それは見てのおたのしみ～。","thumbnail":"https://image.tmdb.org/t/p/w300/i4sH7G1KCIkXCi4JBdD0xeBBsD9.jpg","metadataSources":{"tmdb":{"title":"Episodio 3","synopsis":"『砂の惑星』までキーネを追ってきたパパチャを撃退し、キーネのお爺ちゃんの亜法記憶体を捜す旅（新婚旅行とも言う……）を続けるフォトンとキーネ。そこには行きがかり上なんとなくついて来たアウンもいた。お腹を空かせた旦那様（フォトン）に料理を作る新婚気分のキーネがどうも面白くないアウン。そこで、二人の意地とプライドをかけた世紀の料理対決の火蓋が切って落とされる！はたして空腹のフォトンは無事にゴハンを食べることが出来るのか？そして、パパチャを追いかけるために旅立ったラシャラ皇女の行く先に待つ運命や……いかに！？それは見てのおたのしみ～。","thumbnail":"https://image.tmdb.org/t/p/w300/i4sH7G1KCIkXCi4JBdD0xeBBsD9.jpg","titleLanguage":"it-IT","synopsisLanguage":"ja-JP"}}},{"title":"Episodio 4","episodeNumber":4,"sourceEpisodeNumber":4,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"139","scope":"R","episodeNumbers":[4]},{"provider":"anilist","id":"1944","episodeNumbers":[4]},{"provider":"mal","id":"1944","episodeNumbers":[4]},{"provider":"tmdb_show","id":"39383","scope":"s1","seasonNumber":1,"episodeNumbers":[4]},{"provider":"tvdb_show","id":"86921","scope":"s1","seasonNumber":1,"episodeNumbers":[4]}],"link":"100372","synopsis":"キーネ略奪失敗の責任を押しつけられ、パパチャに見捨てられてしまったポチ1号。異郷の砂漠を一人彷徨ってる途中、突如としてサンドスネークに襲われる。その絶体絶命危機を救ったのは空腹でクラクラ状態なフォトンであった。ポチ1号を見捨てたパパチャ様御一行は、ある温泉宿で飲めや歌えの大暴れ！そこにポチ1号を交えたフォトンたちがやって来た。ここぞとばかりにキーネ捕獲の罠をはるパパチャ！一方、パパチャを追って『砂の惑星』に来たラシャラ皇女たちも合流し物語は怒濤の急展開をむかえる！！果たしてフォトンはパパチャの魔の手からキーネたちを守れるのか!?それは見てのお楽しみ～。","thumbnail":"https://image.tmdb.org/t/p/w300/vhMQKSemU1Rqkt63EdhMOx4pwuS.jpg","metadataSources":{"tmdb":{"title":"Episodio 4","synopsis":"キーネ略奪失敗の責任を押しつけられ、パパチャに見捨てられてしまったポチ1号。異郷の砂漠を一人彷徨ってる途中、突如としてサンドスネークに襲われる。その絶体絶命危機を救ったのは空腹でクラクラ状態なフォトンであった。ポチ1号を見捨てたパパチャ様御一行は、ある温泉宿で飲めや歌えの大暴れ！そこにポチ1号を交えたフォトンたちがやって来た。ここぞとばかりにキーネ捕獲の罠をはるパパチャ！一方、パパチャを追って『砂の惑星』に来たラシャラ皇女たちも合流し物語は怒濤の急展開をむかえる！！果たしてフォトンはパパチャの魔の手からキーネたちを守れるのか!?それは見てのお楽しみ～。","thumbnail":"https://image.tmdb.org/t/p/w300/vhMQKSemU1Rqkt63EdhMOx4pwuS.jpg","titleLanguage":"it-IT","synopsisLanguage":"ja-JP"}}},{"title":"Episodio 5","episodeNumber":5,"sourceEpisodeNumber":5,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"139","scope":"R","episodeNumbers":[5]},{"provider":"anilist","id":"1944","episodeNumbers":[5]},{"provider":"mal","id":"1944","episodeNumbers":[5]},{"provider":"tmdb_show","id":"39383","scope":"s1","seasonNumber":1,"episodeNumbers":[5]},{"provider":"tvdb_show","id":"86921","scope":"s1","seasonNumber":1,"episodeNumbers":[5]}],"link":"100373","synopsis":"いよいよ物語は終盤戦！謎が謎よぶ展開の中、あこがれのアウンの姉と感動の対面を果たし、幸せを体一杯にかみしめているフォトンくん。一方、ついに不穏な行動をとるブランがパパチャに接触！！怪しい探り合いが続くなか、パパチャはラシャラの一途な想いを利用してフォトンたち一行を罠にハメようと画策する。再会を祝す宴会で「鬼の汲み湯」の事を聞いたキーネは、そこが自分の探している亜法記憶体がある場所と結論つけ早速、探すために出かけるが……そして特異点＆銀が結界炉とは？……それは見てのお楽しみ～。","thumbnail":"https://image.tmdb.org/t/p/w300/Mdr2YLtNJwRQirJMOM3QHkjXPt.jpg","metadataSources":{"tmdb":{"title":"Episodio 5","synopsis":"いよいよ物語は終盤戦！謎が謎よぶ展開の中、あこがれのアウンの姉と感動の対面を果たし、幸せを体一杯にかみしめているフォトンくん。一方、ついに不穏な行動をとるブランがパパチャに接触！！怪しい探り合いが続くなか、パパチャはラシャラの一途な想いを利用してフォトンたち一行を罠にハメようと画策する。再会を祝す宴会で「鬼の汲み湯」の事を聞いたキーネは、そこが自分の探している亜法記憶体がある場所と結論つけ早速、探すために出かけるが……そして特異点＆銀が結界炉とは？……それは見てのお楽しみ～。","thumbnail":"https://image.tmdb.org/t/p/w300/Mdr2YLtNJwRQirJMOM3QHkjXPt.jpg","titleLanguage":"it-IT","synopsisLanguage":"ja-JP"}}},{"title":"Episodio 6","episodeNumber":6,"sourceEpisodeNumber":6,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"139","scope":"R","episodeNumbers":[6]},{"provider":"anilist","id":"1944","episodeNumbers":[6]},{"provider":"mal","id":"1944","episodeNumbers":[6]},{"provider":"tmdb_show","id":"39383","scope":"s1","seasonNumber":1,"episodeNumbers":[6]},{"provider":"tvdb_show","id":"86921","scope":"s1","seasonNumber":1,"episodeNumbers":[6]}],"link":"100374","synopsis":"パパチャの追っ手から逃れ『砂の星』にたどり着いたキーネが、この地で不思議な（亜法を中和させる）力を持つ少年フォトン・アースと出会うことからこの物語は始まる……ひょんな事からフォトンのお嫁さんとなってしまうキーネ。さらにフォトンの幼なじみアウンを巻き込んで、嬉し恥ずかしの新婚旅行（本当は亜法記憶体を探す旅）が始まった。そこに、キーネを追って来たパパチャとその一行が加わり物語はクライマックスへ！ついにパパチャの手中に落ちたキーネを助けるためフォトンは果敢に立ち向かうが、思わぬ反亜法攻撃に大苦戦を強いられる。はたしてフォトンは無事キーネを救出しハッピーエンドを迎えられるのか!?全ての謎と驚愕の事実を集約し、ついに迎えた最終話!!果たしてその結末は……？それは見てのお楽しみ～","thumbnail":"https://image.tmdb.org/t/p/w300/36yMXPvYPxYPrI1ucCUjBfvJW25.jpg","metadataSources":{"tmdb":{"title":"Episodio 6","synopsis":"パパチャの追っ手から逃れ『砂の星』にたどり着いたキーネが、この地で不思議な（亜法を中和させる）力を持つ少年フォトン・アースと出会うことからこの物語は始まる……ひょんな事からフォトンのお嫁さんとなってしまうキーネ。さらにフォトンの幼なじみアウンを巻き込んで、嬉し恥ずかしの新婚旅行（本当は亜法記憶体を探す旅）が始まった。そこに、キーネを追って来たパパチャとその一行が加わり