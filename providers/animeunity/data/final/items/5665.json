e/bx112323-C6nlP84x8jH8.png","type":"TV","year":"2022","dubStatus":"subbed","dubStatusKey":"Subbed","variants":[{"status":"subbed","statusKey":"Subbed","title":"Arifureta: From Commonplace to World's Strongest 2","link":"/anime/3463-arifureta-from-commonplace-to-worlds-strongest-2","image":"https://img.animeunity.co/anime/bx112323-C6nlP84x8jH8.png"}]},{"title":"Arifureta: Phantom Adventure and Miraculous Encounter","link":"/anime/4985-arifureta-phantom-adventure-and-miraculous-encounter","image":"https://img.animeunity.co/anime/bx146921-HyTSsd1ardxq.jpg","type":"OVA","year":"2022","dubStatus":"subbed","dubStatusKey":"Subbed","variants":[{"status":"subbed","statusKey":"Subbed","title":"Arifureta: Phantom Adventure and Miraculous Encounter","link":"/anime/4985-arifureta-phantom-adventure-and-miraculous-encounter","image":"https://img.animeunity.co/anime/bx146921-HyTSsd1ardxq.jpg"}]},{"title":"Arifureta: From Commonplace to World's Strongest 3","link":"/anime/5665-arifureta-from-commonplace-to-worlds-strongest-3","image":"https://img.animeunity.co/anime/bx154473-o55309dVGP3G.jpg","type":"TV","year":"2024","dubStatus":"subbed","dubStatusKey":"Subbed","variants":[{"status":"subbed","statusKey":"Subbed","title":"Arifureta: From Commonplace to World's Strongest 3","link":"/anime/5665-arifureta-from-commonplace-to-worlds-strongest-3","image":"https://img.animeunity.co/anime/bx154473-o55309dVGP3G.jpg"}]}],"linkList":[{"title":"Episodes 1-16","titleKey":"Episodes {{start}}-{{end}}","titleParams":{"start":1,"end":16},"availabilityStatus":"available","episodesLink":"5665|1|16"}]},"episodes":[{"title":"Conigli a raccolta","episodeNumber":1,"sourceEpisodeNumber":1,"seasonNumber":3,"externalMappings":[{"provider":"anidb","id":"17615","scope":"R","episodeNumbers":[1]},{"provider":"anilist","id":"154473","episodeNumbers":[1]},{"provider":"mal","id":"52995","episodeNumbers":[1]},{"provider":"tmdb_show","id":"86034","scope":"s3","seasonNumber":3,"episodeNumbers":[1]},{"provider":"tvdb_show","id":"357019","scope":"s3","seasonNumber":3,"episodeNumbers":[1]}],"link":"86034","synopsis":"Yue ripensa al passato a bordo dell'aeronave quando, in viaggio verso il successivo gran labirinto, il gruppo si imbatte nella tribù degli Haulia che sta affrontando le forze dell'Impero per liberare degli schiavi. Hajime scende per aiutarli e si fa spiegare la situazione attuale e perché si trovino lì.","thumbnail":"https://image.tmdb.org/t/p/w300/wPgcOctbPZPm5C72gkzhEi9DX33.jpg"},{"title":"Il grido della rivoluzione","episodeNumber":2,"sourceEpisodeNumber":2,"seasonNumber":3,"externalMappings":[{"provider":"anidb","id":"17615","scope":"R","episodeNumbers":[2]},{"provider":"anilist","id":"154473","episodeNumbers":[2]},{"provider":"mal","id":"52995","episodeNumbers":[2]},{"provider":"tmdb_show","id":"86034","scope":"s3","seasonNumber":3,"episodeNumbers":[2]},{"provider":"tvdb_show","id":"357019","scope":"s3","seasonNumber":3,"episodeNumbers":[2]}],"link":"86253","synopsis":"Hajime e compagnia arrivano alla capitale imperiale per salvare gli Haulia catturati. Una volta liberati, Cam rivela il suo piano di attaccare l'imperatore per rendere libera la tribù e i semiumani dalle mire dell'Impero, e Hajime decide di supportarlo per amore di Shea.","thumbnail":"https://image.tmdb.org/t/p/w300/k0odd8CI6QyvzQ8ZUsq7YgEua4L.jpg"},{"title":"L'ordalia della principessa","episodeNumber":3,"sourceEpisodeNumber":3,"seasonNumber":3,"externalMappings":[{"provider":"anidb","id":"17615","scope":"R","episodeNumbers":[3]},{"provider":"anilist","id":"154473","episodeNumbers":[3]},{"provider":"mal","id":"52995","episodeNumbers":[3]},{"provider":"tmdb_show","id":"86034","scope":"s3","seasonNumber":3,"episodeNumbers":[3]},{"provider":"tvdb_show","id":"357019","scope":"s3","seasonNumber":3,"episodeNumbers":[3]}],"link":"86373","synopsis":"Liliana è ricevimento con l'imperatore quando Hajime si presenta al castello con tutto il gruppo al seguito. Segue un'udienza con l'imperatore stesso che cerca di mettere alle strette Hajime, che però si rivela essere un osso troppo duro anche per lui.","thumbnail":"https://image.tmdb.org/t/p/w300/2gRUEy63Pn4U59p77G24aXmVebF.jpg"},{"title":"L'Impero VS I conigli supremi","episodeNumber":4,"sourceEpisodeNumber":4,"seasonNumber":3,"externalMappings":[{"provider":"anidb","id":"17615","scope":"R","episodeNumbers":[4]},{"provider":"anilist","id":"154473","episodeNumbers":[4]},{"provider":"mal","id":"52995","episodeNumbers":[4]},{"provider":"tmdb_show","id":"86034","scope":"s3","seasonNumber":3,"episodeNumbers":[4]},{"provider":"tvdb_show","id":"357019","scope":"s3","seasonNumber":3,"episodeNumbers":[4]}],"link":"86466","synopsis":"Nel mezzo del gala per l'annuncio del fidanzamento della principessa Liliana col principe imperiale, la tribù Haulia attacca il castello uccidendo soldati e mettendo in ginocchio l'imperatore, obbligandolo a giurare di garantire la libertà dei semiumani, pegno la morte sua e di tutti i suoi legami.","thumbnail":"https://image.tmdb.org/t/p/w300/pM1JJBlFz4W88RNzYNfwTRPNuRn.jpg"},{"title":"Il ritorno dell'eroe","episodeNumber":5,"sourceEpisodeNumber":5,"seasonNumber":3,"externalMappings":[{"provider":"anidb","id":"17615","scope":"R","episodeNumbers":[5]},{"provider":"anilist","id":"154473","episodeNumbers":[5]},{"provider":"mal","id":"52995","episodeNumbers":[5]},{"provider":"tmdb_show","id":"86034","scope":"s3","seasonNumber":3,"episodeNumbers":[5]},{"provider":"tvdb_show","id":"357019","scope":"s3","seasonNumber":3,"episodeNumbers":[5]}],"link":"86566","synopsis":"Hajime riporta i semiumani liberati a Feabergen, dove gli Haulia vengono accolti da eroi. Cam però dichiara la propria fedeltà ad Hajime, chiarendo che le loro azioni sono solo a beneficio dei leporidi. Shea poi racconta ad Hajime la storia della propria madre davanti alla sua tomba.","thumbnail":"https://image.tmdb.org/t/p/w300/zWk2vnsVxOzytuoJ7nFLNRS24kq.jpg"},{"title":"Il gran labirinto di Haltina","episodeNumber":6,"sourceEpisodeNumber":6,"seasonNumber":3,"externalMappings":[{"provider":"anidb","id":"17615","scope":"R","episodeNumbers":[6]},{"provider":"anilist","id":"154473","episodeNumbers":[6]},{"provider":"mal","id":"52995","episodeNumbers":[6]},{"provider":"tmdb_show","id":"86034","scope":"s3","seasonNumber":3,"episodeNumbers":[6]},{"provider":"tvdb_show","id":"357019","scope":"s3","seasonNumber":3,"episodeNumbers":[6]}],"link":"86646","synopsis":"Il gruppo guidato da Hajime entra nel gran labirinto di Haltina, dove fatti strani iniziano ad accadere, con 3 membri del gruppo trasformati in goblin. Dopo un secondo teletrasporto Hajime si risveglia nel mondo reale, dove Yue e Shea sono diventate sue compagne di classe assieme a Kaori, e Tio la loro insegnante.","thumbnail":"https://image.tmdb.org/t/p/w300/zveyCXUFnJKdwfhBDPYhppyiHNZ.jpg"},{"title":"La prova diabolica","episodeNumber":7,"sourceEpisodeNumber":7,"seasonNumber":3,"externalMappings":[{"provider":"anidb","id":"17615","scope":"R","episodeNumbers":[7]},{"provider":"anilist","id":"154473","episodeNumbers":[7]},{"provider":"mal","id":"52995","episodeNumbers":[7]},{"provider":"tmdb_show","id":"86034","scope":"s3","seasonNumber":3,"episodeNumbers":[7]},{"provider":"tvdb_show","id":"357019","scope":"s3","seasonNumber":3,"episodeNumbers":[7]}],"link":"86737","synopsis":"Le compagne di Hajime riescono a liberarsi una a una dal sogno, lasciando solo Kouki, Ryutaro e Suzu intrappolati, che ne escono con l'aiuto di Kaori. Proseguendo nel gran labirinto, il gruppo cade vittima prima di uno slime afrodisiaco e successivamente di uno stormo di blatte che generano orrore in tutti.","thumbnail":"https://image.tmdb.org/t/p/w300/zVy5IOos06AoNdrp2getJWuQGxH.jpg"},{"title":"Trattieni la speranza","episodeNumber":8,"sourceEpisodeNumber":8,"seasonNumber":3,"externalMappings":[{"provider":"anidb","id":"17615","scope":"R","episodeNumbers":[8]},{"provider":"anilist","id":"154473","episodeNumbers":[8]},{"provider":"mal","id":"52995","episodeNumbers":[8]},{"provider":"tmdb_show","id":"86034","scope":"s3","seasonNumber":3,"episodeNumbers":[8]},{"provider":"tvdb_show","id":"357019","scope":"s3","seasonNumber":3,"episodeNumbers":[8]}],"link":"86831","synopsis":"Hajime e compagni vengono colpiti da una magia che inverte le emozioni che provano gli uni per gli altri, ma i legami che li uniscono permettono loro di affrontare il nemico nonostante lo stato alterato e a conquistare il dungeon, al termine del quale ricevono la formidabile magia di concetto.","thumbnail":"https://image.tmdb.org/t/p/w300/ahfjB8XwBSgfGVHrGQriQ06ZkZ2.jpg"},{"title":"Cuore che muta","episodeNumber":9,"sourceEpisodeNumber":9,"seasonNumber":3,"externalMappings":[{"provider":"anidb","id":"17615","scope":"R","episodeNumbers":[9]},{"provider":"anilist","id":"154473","episodeNumbers":[9]},{"provider":"mal","id":"52995","episodeNumbers":[9]},{"provider":"tmdb_show","id":"86034","scope":"s3","seasonNumber":3,"episodeNumbers":[9]},{"provider":"tvdb_show","id":"357019","scope":"s3","seasonNumber":3,"episodeNumbers":[9]}],"link":"86962","synopsis":"Ricevuta la magia di concetto, il gruppo torna a Feabergen per riposare, e in quell'occasione Hajime decide finalmente di accettare i sentimenti di Shea, dicendole che anche lei ora è una persona speciale ai suoi occhi. Poi Suzu chiede ad Hajime di poterli accompagnare nel successivo gran labirinto per diventare più forte e poter rincontrare Eri.","thumbnail":"https://image.tmdb.org/t/p/w300/1scRjE0LLeOIuhpYoaKUhGpX6N1.jpg"},{"title":"L'ultimo gran labirinto","episodeNumber":10,"sourceEpisodeNumber":10,"seasonNumber":3,"externalMappings":[{"provider":"anidb","id":"17615","scope":"R","episodeNumbers":[10]},{"provider":"anilist","id":"154473","episodeNumbers":[10]},{"provider":"mal","id":"52995","episodeNumbers":[10]},{"provider":"tmdb_show","id":"86034","scope":"s3","seasonNumber":3,"episodeNumbers":[10]},{"provider":"tvdb_show","id":"357019","scope":"s3","seasonNumber":3,"episodeNumbers":[10]}],"link":"87193","synopsis":"L'aeronave Fenrir si avvicina al nevaio Schnee, che nasconde le omonime grotte gelide, ultimo gran labirinto che il gruppo di Hajime deve conquistare. L'incontro con dei coniglietti assassini demoralizza un po' il gruppo, che però procede incontrando un nemico già visto in precedenza, rendendolo l'occasione ideale per mettere alla prova Kouki, Suzu e Shizuku.","thumbnail":"https://image.tmdb.org/t/p/w300/u93zqOmYIpXlqhAB1SBFoDYiyzf.jpg"},{"title":"Scontro emotivo","episodeNumber":11,"sourceEpisodeNumber":11,"seasonNumber":3,"externalMappings":[{"provider":"anidb","id":"17615","scope":"R","episodeNumbers":[11]},{"provider":"anilist","id":"154473","episodeNumbers":[11]},{"provider":"mal","id":"52995","episodeNumbers":[11]},{"provider":"tmdb_show","id":"86034","scope":"s3","seasonNumber":3,"episodeNumbers":[11]},{"provider":"tvdb_show","id":"357019","scope":"s3","seasonNumber":3,"episodeNumbers":[11]}],"link":"87238","synopsis":"Durante la prova i membri del gruppo iniziano a sentire voci interiori che cercano di instillare in loro dubbi. Si trovano così a dover affrontare un mostro ognuno, nonostante le voci facciano deviare gli attacchi verso i compagni, istigando la loro gelosia o invidia.","thumbnail":"https://image.tmdb.org/t/p/w300/1nxMfMhm8hY7ntr3Yq1bJ83cJdA.jpg"},{"title":"Animo snudato","episodeNumber":12,"sourceEpisodeNumber":12,"seasonNumber":3,"externalMappings":[{"provider":"anidb","id":"17615","scope":"R","episodeNumbers":[12]},{"provider":"anilist","id":"154473","episodeNumbers":[12]},{"provider":"mal","id":"52995","episodeNumbers":[12]},{"provider":"tmdb_show","id":"86034","scope":"s3","seasonNumber":3,"episodeNumbers":[12]},{"provider":"tvdb_show","id":"357019","scope":"s3","seasonNumber":3,"episodeNumbers":[12]}],"link":"87954","synopsis":"La prova del labirinto vede Hajime affrontare una propria copia che incarna i sentimenti negativi che albergano in lui, ma per il protagonista questa non è altro che un'occasione per migliorarsi. Nel frattempo Shizuku si trova nella stessa situazione, ma senza risucire ad avere la meglio sull'altra sé stessa.","thumbnail":"https://image.tmdb.org/t/p/w300/nchGX8JXn1UNtn1JnjVovIceFad.jpg"},{"title":"Per fortuna rimane una depravata!","episodeNumber":13,"sourceEpisodeNumber":13,"seasonNumber":3,"externalMappings":[{"provider":"anidb","id":"17615","scope":"R","episodeNumbers":[13]},{"provider":"anilist","id":"154473","episodeNumbers":[13]},{"provider":"mal","id":"52995","episodeNumbers":[13]},{"provider":"tmdb_show","id":"86034","scope":"s3","seasonNumber":3,"episodeNumbers":[13]},{"provider":"tvdb_show","id":"357019","scope":"s3","seasonNumber":3,"episodeNumbers":[13]}],"link":"88281","synopsis":"Dopo essere stata salvata da Hajime, Shizuku riesce a sconfiggere la propria copia e decide di accettare e confessare il proprio amore per Hajime. Nel contempo Suzu e Ryutaro superano le rispettive prove e raggiungono Tio che sta sfruttando la sfida come occasione per mettere alla prova la propria fermezza.","thumbnail":"https://image.tmdb.org/t/p/w300/ykG7sydA3Z5lvqmw8QMwEf3qXrj.jpg"},{"title":"L'epico scontro tra vampira strapotente e coniglia sovrumana","episodeNumber":14,"sourceEpisodeNumber":14,"seasonNumber":3,"externalMappings":[{"provider":"anidb","id":"17615","scope":"R","episodeNumbers":[14]},{"provider":"anilist","id":"154473","episodeNumbers":[14]},{"provider":"mal","id":"52995","episodeNumbers":[14]},{"provider":"tmdb_show","id":"86034","scope":"s3","seasonNumber":3,"episodeNumbers":[14]},{"provider":"tvdb_show","id":"357019","scope":"s3","seasonNumber":3,"episodeNumbers":[14]}],"link":"90272","synopsis":"Yue e Shea superano facilmente la prova contro i propri alter ego, ma lo scontro risveglia un ricordo sopito in Yue che la spinge a mostrarsi debole davanti a Shea. Quest'ultima, irritata dalle parole di Yue, decide di attaccarla per farla tornare in sé. Vittima del loro scontro è Kaori, che viene interrotta mentre effettua la propria prova.","thumbnail":"https://image.tmdb.org/t/p/w300/4QVRzIVphgnhyLtaJ0tfRWOZMDm.jpg"},{"title":"Il fondamento dell'eroismo","episodeNumber":15,"sourceEpisodeNumber":15,"seasonNumber":3,"externalMappings":[{"provider":"anidb","id":"17615","scope":"R","episodeNumbers":[15]},{"provider":"anilist","id":"154473","episodeNumbers":[15]},{"provider":"mal","id":"52995","episodeNumbers":[15]},{"provider":"tmdb_show","id":"86034","scope":"s3","seasonNumber":3,"episodeNumbers":[15]},{"provider":"tvdb_show","id":"357019","scope":"s3","seasonNumber":3,"episodeNumbers":[15]}],"link":"90496","synopsis":"Kouki cade vittima delle proprie illusioni, cedendo alla tentazione del potere durante la prova, e si scaglia inutilmente contro Hajime che procede a stenderlo. Con l'arrivo del resto del gruppo che ha concluso le proprie prove, finalmente Hajime e compagnia arrivano alla conclusione del gran labirinto.","thumbnail":"https://image.tmdb.org/t/p/w300/qgPfDubw0ZioSDRcMdCwuOVgKao.jpg"},{"title":"La chiave per la porta del mondo","episodeNumber":16,"sourceEpisodeNumber":16,"seasonNumber":3,"externalMappings":[{"provider":"anidb","id":"17615","scope":"R","episodeNumbers":[16]},{"provider":"anilist","id":"154473","episodeNumbers":[16]},{"provider":"mal","id":"52995","episodeNumbers":[16]},{"provider":"tmdb_show","id":"86034","scope":"s3","seasonNumber":3,"episodeNumbers":[16]},{"provider":"tvdb_show","id":"357019","scope":"s3","seasonNumber":3,"episodeNumbers":[16]}],"link":"91033","synopsis":"Hajime e Yue si risvegliano nella dimora di Schnee e, per mezzo della magia di concetto acquisita, uniscono le forze per creare l'artefatto che permetterà loro di attraversare i confini dei mondi. Nel frattempo Kouki si risveglia rinsavito e Suzu si prepara al meglio per andare a incontrare Eri. Una volta ultimati i preparativi, il gruppo parte in direzione del Regno demoniaco.","thumbnail":"https://image.tmdb.org/t/p/w300/gRcAcDz4LQexGnjIau55ZFwYC8U.jpg"}],"sourceIds":{"anilistId":154473,"malId":52995},"mappings":{"source":"anibridge-