ista.","date":"1983","episodes_count":128,"episodes_length":24,"author":" ","created_at":"2022-05-04 22:29:21","status":"Terminato","imageurl_cover":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/2116-DccGEDGnsqcu.jpg","type":"TV","slug":"holly-e-benji-ita","title_eng":"Holly e Benji (ITA)","day":"Indeterminato","favorites":190,"score":"8.40","visite":715458,"studio":"Tsuchida Productions","dub":1,"always_home":0,"members":775,"cover":null,"anilist_id":2116,"season":"Autunno","title_it":null,"mal_id":2116,"crunchy_id":null,"netflix_id":null,"prime_id":null,"disney_id":null,"pivot":{"anime_id":6138,"related_id":3738,"number":1}},{"id":6137,"user_id":2,"title":"Captain Tsubasa: Europe Daikessen (ITA)","imageurl":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/2118.jpg","plot":"Primo film su Holly e Benji, è dedicato alla prima sfida internazionale della nazionale giovanile giapponese contro la rappresentativa europea capitata da Karl-Heinz Schneider.","date":"1985","episodes_count":1,"episodes_length":42,"author":" ","created_at":"2025-02-13 11:55:53","status":"Terminato","imageurl_cover":"","type":"Movie","slug":"holly-e-benji-la-grande-sfida-europea-ita","title_eng":"Holly e Benji - La Grande Sfida Europea (ITA)","day":"Indeterminato","favorites":8,"score":"7.95","visite":8028,"studio":"Tsuchida Productions","dub":1,"always_home":0,"members":74,"cover":null,"anilist_id":2118,"season":"Estate","title_it":null,"mal_id":2118,"crunchy_id":null,"netflix_id":null,"prime_id":null,"disney_id":null,"pivot":{"anime_id":6138,"related_id":6137,"number":1}},{"id":6131,"user_id":2,"title":"Captain Tsubasa: Ayaushi! Zen Nihon Jr. (ITA)","imageurl":"https://cdn.myanimelist.net/images/anime/1902/134544.jpg","plot":"Secondo film dedicato a Holly e Benji, è il sequel del primo film ed è incentrato sulla seconda sfida tra le nazionali giovanili di Giappone ed Europa.","date":"1985","episodes_count":1,"episodes_length":60,"author":" ","created_at":"2025-02-13 