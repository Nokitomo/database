tica quarta sezione del secondo anno, famosa per i suoi studenti a dir poco intrattabili. Onizuka, però, non si perde d’animo e, nonostante il suo aspetto e i suoi modi tutto tranne che convenzionali, non perderà mai di vista la sua missione di educatore e riuscirà a toccare il cuore di molti studenti per cui docenti ben più blasonati avevano perso le speranze, riportandoli in seno ad una società che li aveva abbandonati.","date":"1999","episodes_count":43,"episodes_length":25,"author":" ","created_at":"2019-10-02 17:23:28","status":"Terminato","imageurl_cover":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/245-sIPMF9vNDnaJ.jpg","type":"TV","slug":"great-teacher-onizuka-ita","title_eng":"Great Teacher Onizuka (ITA)","day":"Indeterminato","favorites":763,"score":"8.99","visite":1175662,"studio":"Studio Pierrot","dub":1,"always_home":0,"members":3658,"cover":null,"anilist_id":245,"season":"Estate","title_it":null,"mal_id":245,"crunchy_id":null,"netflix_id":null,"prime_id":null,"disney_id":null,"pivot":{"anime_id":2748,"related_id":1583,"number":1}}]},"archive":null},"sourceEpisodes":[{"id":47481,"anime_id":2748,"user_id":null,"number":"1","created_at":"2020-08-30 13:37:34","link":"https://www.animeunityserver102.cloud/DDL/Anime/GTO/ShonanJunaiGumi_Ep_01_SUB_ITA.mp4","visite":28067,"hidden":0,"public":1,"scws_id":78883,"file_name":"ShonanJunaiGumi_Ep_01_SUB_ITA.mp4","tg_post":0},{"id":47482,"anime_id":2748,"user_id":null,"number":"2","created_at":"2020-08-30 13:37:34","link":"https://www.animeunityserver102.cloud/DDL/Anime/GTO/ShonanJunaiGumi_Ep_02_SUB_ITA.mp4","visite":5909,"hidden":0,"public":1,"scws_id":78893,"file_name":"ShonanJunaiGumi_Ep_02_SUB_ITA.mp4","tg_post":0},{"id":47483,"anime_id":2748,"user_id":null,"number":"3","created_at":"2020-08-30 13:37:34","link":"https://www.animeunityserver102.cloud/DDL/Anime/GTO/ShonanJunaiGumi_Ep_03_SUB_ITA.mp4","visite":4496,"hidden":0,"public":1,"scws_id":78886,"file_name":"ShonanJunaiGumi_Ep_03_SUB_ITA.mp4","tg_p