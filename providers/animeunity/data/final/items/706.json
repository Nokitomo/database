Kk4Mb2xkm4ZeSx6nuKlf.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}},{"title":"Episodio 6","episodeNumber":6,"sourceEpisodeNumber":6,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"13424","scope":"R","episodeNumbers":[6]},{"provider":"anilist","id":"100010","episodeNumbers":[6]},{"provider":"mal","id":"36266","episodeNumbers":[6]},{"provider":"tmdb_show","id":"77702","scope":"s1","seasonNumber":1,"episodeNumbers":[6]},{"provider":"tvdb_show","id":"341998","scope":"s1","seasonNumber":1,"episodeNumbers":[6]}],"link":"15964","synopsis":"Aya and Tsuyuno are sent to the hospital unconscious after their deadly battle with Sarina.","thumbnail":"https://image.tmdb.org/t/p/w300/12dIcjW4g2MD1bKQ11vqK8tKeAa.jpg","metadataSources":{"tmdb":{"title":"Episodio 6","synopsis":"Aya and Tsuyuno are sent to the hospital unconscious after their deadly battle with Sarina.","thumbnail":"https://image.tmdb.org/t/p/w300/12dIcjW4g2MD1bKQ11vqK8tKeAa.jpg","titleLanguage":"it-IT","synopsisLanguage":"en-US"}}},{"title":"Episodio 7","episodeNumber":7,"sourceEpisodeNumber":7,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"13424","scope":"R","episodeNumbers":[7]},{"provider":"anilist","id":"100010","episodeNumbers":[7]},{"provider":"mal","id":"36266","episodeNumbers":[7]},{"provider":"tmdb_show","id":"77702","scope":"s1","seasonNumber":1,"episodeNumbers":[7]},{"provider":"tvdb_show","id":"341998","scope":"s1","seasonNumber":1,"episodeNumbers":[7]}],"link":"15971","synopsis":"Aya and the others learn that there are multiple Magical Girl Sites, each with its own administrator, and that the information Rina has on Tempest is fake. They decide to join forces with Kosame and the magical girls from a different site in order to discover the truth behind the sites and survive. But that requires teaming up with Nijimi who is still after Rina's life.","thumbnail":"https://image.tmdb.org/t/p/w300/vwqn08O8PAbNO6XQLUXjzxPtMOn.jpg","metadataSources":{"tmdb":{"title":"Epis