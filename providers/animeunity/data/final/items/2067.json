unque, presto scoprirà  la verità ... il suo \"Eromanga-sensei\" non è altri che la sua giovane sorella! A complicare ancora di più la situazione tra fratello e sorella entra in scena una bellissima ragazza scrittrice di manga shoujo, la quale diventerà  la loro rivale!","date":"2017","episodes_count":12,"episodes_length":24,"author":" ","created_at":"2019-04-19 23:13:01","status":"Terminato","imageurl_cover":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/21685-7qhjceISmSsv.jpg","type":"TV","slug":"eromanga-sensei","title_eng":"Eromanga Sensei","day":"Sabato","favorites":380,"score":"7.40","visite":180905,"studio":"A-1 Pictures","dub":0,"always_home":0,"members":3230,"cover":null,"anilist_id":21685,"season":"Primavera","title_it":null,"mal_id":32901,"crunchy_id":null,"netflix_id":null,"prime_id":null,"disney_id":null,"pivot":{"anime_id":2067,"related_id":488,"number":1}},{"id":2067,"user_id":78495,"title":"Eromanga-sensei OVA","imageurl":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/nx100523-1nTD5FTYA6D2.jpg","plot":"OVA di Eromanga-sensei","date":"2019","episodes_count":2,"episodes_length":24,"author":" ","created_at":"2020-02-07 03:02:32","status":"Terminato","imageurl_cover":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/n100523-OEo8nScGcltS.jpg","type":"OVA","slug":"eromanga-sensei-ova","title_eng":"Eromanga Sensei OVA","day":"Martedì","favorites":97,"score":"7.62","visite":39676,"studio":"A-1 Pictures","dub":0,"always_home":0,"members":785,"cover":null,"anilist_id":100523,"season":"Inverno","title_it":null,"mal_id":36792,"crunchy_id":null,"netflix_id":null,"prime_id":null,"disney_id":null,"pivot":{"anime_id":2067,"related_id":2067,"number":1}}]},"archive":null},"sourceEpisodes":[{"id":37173,"anime_id":2067,"user_id":null,"number":"1","created_at":"2020-02-07 03:04:05","link":"https://www.ochikoborefruittart.org/DDL/ANIME/Eromanga-sensei/Eromanga-sensei_OVA_01_SUB_ITA.mp4","visite":31542,"hidden":0,"public":1,"scws_id":773