abel":"Voto","value":"8.56 / 10","links":[]},{"label":"Durata","value":"24 min/ep","links":[]},{"label":"Episodi","value":"74","links":[]},{"label":"Stato","value":"Finito","links":[{"text":"Finito","link":{"base":"site","path":"/filter?status=1"}}]},{"label":"Visualizzazioni","value":"700.143","links":[]}],"jsonLd":[{"@context":{"url":"http://schema.org/"},"@type":"TVEpisode","@id":{"base":"site","path":"/play/monster.O0085/vKnXG"},"url":{"base":"site","path":"/play/monster.O0085/vKnXG/"},"name":"Monster Episodio 1","alternateName":"Monster Episodio 1","episodeNumber":"1","image":{"base":"img","path":"/locandine/18793l.jpg"},"potentialAction":{"@type":"SearchAction","target":{"base":"site","path":"/search?keyword={keyword}"},"query-input":"required name=keyword"},"partOfSeries":{"@type":"TVSeries","@id":{"base":"site","path":"/play/monster.O0085/"},"name":"Monster","alternateName":"Monster","description":"Trama di Monster SUB ITA: Düsseldorf, 1986. Il giovane e brillante neurochirurgo giapponese Kenzo Tenma salva un bambino, Johan Liebert, da morte certa. Contemporaneamente si consumano nel presidio ospedaliero nel quale lavora il medico alcuni delitti di cui verrà accusato lo stesso Tenma, soprattutto da parte dell&#x27;ispettore di polizia Lunge. Nove anni dopo Johan commetterà una serie di efferati omicidi. Venuto a sapere che l&#x27;assassino è proprio Johan, Tenma decide di lasciarsi alle spalle il lavoro e gli amici per catturarlo e ucciderlo, per rimediare all&#x27;errore fatto nove anni prima e scagionarsi. Ma durante l&#x27;inseguimento il giovane chirurgo scoprirà che molte nubi sono addensate sul misterioso passato di Johan, che emergerà pian piano con una tragica verità, e che ha coinvolto anche la sorella gemella di Johan, Nina: i due, da bambini, assistettero ad un omicidio di massa, e per amore verso lei Johan la convinse che era stato solo lui ad assistere a tale tragedia. Il giovane uccide nella sua ricerca dell&#x27;uomo che stava dietro gli esperimenti voluti dai governi comunisti della DDR e della Cecoslovacchia per creare assassini infallibili.","aggregateRating":{"@type":"AggregateRating","ratingCount":"1060","ratingValue":"8.56","bestRating":"10","worstRating":"0"}},"description":"Trama di Monster SUB ITA: Düsseldorf, 1986. Il giovane e brillante neurochirurgo giapponese Kenzo Tenma salva un bambino, Johan Liebert, da morte certa. Contemporaneamente si consumano nel presidio ospedaliero nel quale lavora il medico alcuni delitti di cui verrà accusato lo stesso Tenma, soprattutto da parte dell&#x27;ispettore di polizia Lunge. Nove anni dopo Johan commetterà una serie di efferati omicidi. Venuto a sapere che l&#x27;assassino è proprio Johan, Tenma decide di lasciarsi alle spalle il lavoro e gli amici per catturarlo e ucciderlo, per rimediare all&#x27;errore fatto nove anni prima e scagionarsi. Ma durante l&#x27;inseguimento il giovane chirurgo scoprirà che molte nubi sono addensate sul misterioso passato di Johan, che emergerà pian piano con una tragica verità, e che ha coinvolto anche la sorella gemella di Johan, Nina: i due, da bambini, assistettero ad un omicidio di massa, e per amore verso lei Johan la convinse che era stato solo lui ad assistere a tale tragedia. Il giovane uccide nella sua ricerca dell&#x27;uomo che stava dietro gli esperimenti voluti dai governi comunisti della DDR e della Cecoslovacchia per creare assassini infallibili.","aggregateRating":{"@type":"AggregateRating","ratingCount":"1060","ratingValue":"8.56","bestRating":"10","worstRating":"0"}}],"nextEpisode":null,"seo":[{"name":"description","value":"Trama di Monster SUB ITA: Düsseldorf, 1986. Il giovane e brillante neurochirurgo giapponese Kenzo Tenma salva un bambino, Johan Liebert, da morte certa. Contemporaneamente si consumano nel presidio ospedaliero nel quale lavora il medico alcuni delitti di cui verrà accusato lo stesso Tenma, soprattutto da parte dell'ispettore di polizia Lunge. Nove anni dopo Johan commetterà una serie di