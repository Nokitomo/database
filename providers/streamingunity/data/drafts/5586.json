,"duration":55,"scws_id":308588,"season_id":6509,"created_at":"2025-04-23T01:14:02.000000Z","updated_at":"2025-11-05T08:40:42.000000Z","quality":"HD","audio_orig":1,"dub_ita":1,"sub_ita":0,"uploaded_at":"2025-04-23 03:14:02","images":[{"id":159843,"filename":"296a1cb1-5ace-4fdd-9b07-87f719e8579e.webp","type":"cover","lang":null,"imageable_type":"episode","imageable_id":89160,"created_at":"2025-04-23T01:14:06.000000Z","updated_at":"2025-04-23T01:14:06.000000Z","original_url_field":null,"reference":{"base":"images","path":"/images/296a1cb1-5ace-4fdd-9b07-87f719e8579e.webp"}}],"translations":[{"id":254332,"translatable_type":"episode","translatable_id":89160,"locale":"it","key":"name","value":"Il raccolto"},{"id":254333,"translatable_type":"episode","translatable_id":89160,"locale":"it","key":"plot","value":"\"I sopravvissuti di Ferrix sono in grave pericolo, avevano disperatamente bisogno di Cassian. Mon Mothma si trova di fronte a un dilemma sconvolgente. Eedy viene invitata a cena. \"\"Niamos!\"\"\""}]},{"id":89488,"number":4,"name":"Mai stati su Ghorman?","plot":"Nascosti in un rifugio sicuro su Coruscant, Cassian e Bix affrontano i traumi del passato e le richieste di Luthen. Di stanza su Ghorman, Syril entra in contatto con la resistenza del posto. Wilmon porta un dono prezioso a Saw Gerrera.","duration":56,"scws_id":310454,"season_id":6509,"created_at":"2025-04-30T05:58:07.000000Z","updated_at":"2025-11-05T08:40:43.000000Z","quality":"HD","audio_orig":1,"dub_ita":1,"sub_ita":0,"uploaded_at":"2025-04-30 07:58:07","images":[{"id":160748,"filename":"33ed2dd5-52b2-4392-8287-b0ba0923be41.webp","type":"cover","lang":null,"imageable_type":"episode","imageable_id":89488,"created_at":"2025-04-30T05:58:07.000000Z","updated_at":"2025-04-30T05:58:07.000000Z","original_url_field":null,"reference":{"base":"images","path":"/images/33ed2dd5-52b2-4392-8287-b0ba0923be41.webp"}}],"translations":[{"id":254988,"translatable_type":"episode","translatable_id":89488,"locale":"it","key":"name","value":"Mai stati su Ghorman?"},{"id":254989,"translatable_type":"episode","translatable_id":89488,"locale":"it","key":"plot","value":"Nascosti in un rifugio sicuro su Coruscant, Cassian e Bix affrontano i traumi del passato e le richieste di Luthen. Di stanza su Ghorman, Syril entra in contatto con la resistenza del posto. Wilmon porta un dono prezioso a Saw Gerrera."}]},{"id":89489,"number":5,"name":"Ho Amici Dappertutto","plot":"Cassian viene inviato a valutare il Fronte Ghormano. Syril torna a Coruscant per una riunione dell'ISB. Luthen fa visita a Bix e capisce che c'è qualcosa che non va. Kleya scopre che una microspia  potrebbe essere presto scoperta. Wilmon ha un incontro inquietante a tu per tu con Saw Gerrera.","duration":56,"scws_id":310455,"season_id":6509,"created_at":"2025-04-30T05:58:32.000000Z","updated_at":"2025-11-05T08:40:43.000000Z","quality":"HD","audio_orig":1,"dub_ita":1,"sub_ita":0,"uploaded_at":"2025-04-30 07:58:32","images":[{"id":160820,"filename":"5c338ae7-8d95-4e54-afa7-61a589452a07.webp","type":"cover","lang":null,"imageable_type":"episode","imageable_id":89489,"created_at":"2025-04-30T10:50:49.000000Z","updated_at":"2025-04-30T10:50:49.000000Z","original_url_field":null,"reference":{"base":"images","path":"/images/5c338ae7-8d95-4e54-afa7-61a589452a07.webp"}}],"translations":[{"id":254990,"translatable_type":"episode","translatable_id":89489,"locale":"it","key":"name","value":"Ho Amici Dappertutto"},{"id":254991,"translatable_type":"episode","translatable_id":89489,"locale":"it","key":"plot","value":"Cassian viene inviato a valutare il Fronte Ghormano. Syril torna a Coruscant per una riunione dell'ISB. Luthen fa visita a Bix e capisce che c'è qualcosa che non va. Kleya scopre che una microspia  potrebbe essere presto scoperta. Wilmon ha un incontro inquietante a tu per tu con Saw Gerrera."}]},{"id":89490,"number":6,"name":"Che Serata Festosa","plot":"Cassian rinuncia alla missione su Ghorman. La visita di Luthen a Bix aumenta i