37.000000Z","quality":"HD","audio_orig":1,"dub_ita":0,"sub_ita":1,"uploaded_at":"2025-10-12 06:31:33","images":[],"translations":[{"id":441598,"translatable_type":"episode","translatable_id":150722,"locale":"it","key":"name","value":"Episodio 1"},{"id":441599,"translatable_type":"episode","translatable_id":150722,"locale":"it","key":"plot","value":"Con le loro biciclette lucide nuove, Rain e Hong-chul danno il via alla loro avventura in una giornata piovosa nell'isola di Jeju. I locali Lee Hyo-lee e Lee Sang-soon si uniscono a loro per cena."}]},{"id":150724,"number":2,"name":"Episodio 2","plot":"Gli amici scorrazzano lungo la costa di Jeju dai colori smeraldo e le strade lined di fiori. Il perdente di un voto su chi ha la bicicletta più figa affronta una punizione davvero pescata.","duration":56,"scws_id":424079,"season_id":12264,"created_at":"2025-10-12T04:39:01.000000Z","updated_at":"2025-11-05T08:42:37.000000Z","quality":"HD","audio_orig":1,"dub_ita":0,"sub_ita":1,"uploaded_at":"2025-10-12 06:39:01","images":[],"translations":[{"id":441602,"translatable_type":"episode","translatable_id":150724,"locale":"it","key":"name","value":"Episodio 2"},{"id":441603,"translatable_type":"episode","translatable_id":150724,"locale":"it","key":"plot","value":"Gli amici scorrazzano lungo la costa di Jeju dai colori smeraldo e le strade lined di fiori. Il perdente di un voto su chi ha la bicicletta più figa affronta una punizione davvero pescata."}]},{"id":150723,"number":3,"name":"Episodio 3","plot":"Un'esperienza pratica dei tesori naturali di Gochang vi attende, dalla scalata di rocce e dalla raccolta di vongole nelle zone di marea fino a un emozionante giro al tramonto sulla spiaggia.","duration":68,"scws_id":424080,"season_id":12264,"created_at":"2025-10-12T04:36:01.000000Z","updated_at":"2025-11-05T08:42:37.000000Z","quality":"HD","audio_orig":1,"dub_ita":0,"sub_ita":1,"uploaded_at":"2025-10-12 06:36:01","images":[],"translations":[{"id":441600,"translatable_type":"episode","translatable_id":150723,"locale":"it","key":"name","value":"Episodio 3"},{"id":441601,"translatable_type":"episode","translatable_id":150723,"locale":"it","key":"plot","value":"Un'esperienza pratica dei tesori naturali di Gochang vi attende, dalla scalata di rocce e dalla raccolta di vongole nelle zone di marea fino a un emozionante giro al tramonto sulla spiaggia."}]},{"id":150727,"number":4,"name":"Episodio 4","plot":"Sfrecciando attraverso Busan in Harley-Davidson, gli amici si riempiono la pancia con le specialità locali. Più tardi, fanno una scommessa su chi è il miglior nuotatore.","duration":56,"scws_id":424081,"season_id":12264,"created_at":"2025-10-12T04:45:03.000000Z","updated_at":"2025-11-05T08:42:37.000000Z","quality":"HD","audio_orig":1,"dub_ita":0,"sub_ita":1,"uploaded_at":"2025-10-12 06:45:03","images":[],"translations":[{"id":441608,"translatable_type":"episode","translatable_id":150727,"locale":"it","key":"name","value":"Episodio 4"},{"id":441609,"translatable_type":"episode","translatable_id":150727,"locale":"it","key":"plot","value":"Sfrecciando attraverso Busan in Harley-Davidson, gli amici si riempiono la pancia con le specialità locali. Più tardi, fanno una scommessa su chi è il miglior nuotatore."}]},{"id":150726,"number":5,"name":"Episodio 5","plot":"Il brutto tempo non può impedire a Rain e Hong-chul di godersi la giornata perfetta sulla spiaggia. Una volta che le nuvole si sono allontanate, gli amici si godono del divertimento e del sole su uno yacht.","duration":56,"scws_id":424082,"season_id":12264,"created_at":"2025-10-12T04:45:00.000000Z","updated_at":"2025-11-05T08:42:37.000000Z","quality":"HD","audio_orig":1,"dub_ita":0,"sub_ita":1,"uploaded_at":"2025-10-12 06:45:00","images":[],"translations":[{"id":441606,"translatable_type":"episode","translatable_id":150726,"locale":"it","key":"name","value":"Episodio 5"},{"id":441607,"translatable_type":"episode","translatable_id":150726,"locale":"it","key":"plot","value":"Il brutto tempo non può impedire a Rain e Hong-chul di godersi la giornata perfetta sulla spiaggia. Una volta che le nuvole si sono allontanate, gli amici si godono del divertimento e del sole su uno yacht."}]},{"id":150725,"number":6,"name":"Episodio 6","plot":"La coppia sfreccia attraverso le lussureggianti e tortuose montagne del Gangwon-do per un campeggio. Per imbarazzo di Rain, Hong-chul diventa il suo stilista per la giornata.","duration":58,"scws_id":424083,"season_id":12264,"created_at":"2025-10-12T04:40:31.000000Z","updated_at":"2025-11-05T08:42:37.000000Z","quality":"HD","audio_orig":1,"dub_ita":0,"sub_ita":1,"uploaded_at":"2025-10-12 06:40:31","images":[],"translations":[{"id":441604,"translatable_type":"episode","translatable_id":150725,"locale":"it","key":"name","value":"Episodio 6"},{"id":441605,"translatable_type":"episode","translatable_id":150725,"locale":"it","key":"plot","value":"La coppia sfreccia attraverso le lussureggianti e tortuose montagne del Gangwon-do per un campeggio. Per imbarazzo di Rain, Hong-chul diventa il suo stilista per la giornata."}]},{"id":150728,"number":7,"name":"Episodio 7","plot":"L'attore Lee Ha-nee salta su un Vespa accanto a Rain e Hong-chul per un picnic in un ruscello nascosto.  Tornati al campeggio, i tre si deliziano con una gustosa cena.","duration":66,"scws_id":424085,"season_id":12264,"created_at":"2025-10-12T04:51:01.000000Z","updated_at":"2025-11-05T08:42:37.000000Z","quality":"HD","audio_orig":1,"dub_ita":0,"sub_ita":1,"uploaded_at":"2025-10-12 06:51:01","images":[],"translations":[{"id":441610,"translatable_type":"episode","translatable_id":150728,"locale":"it","key":"name","value":"Episodio 7"},{"id":441611,"translatable_type":"episode","translatable_id":150728,"locale":"it","key":"plot","value":"L'attore Lee Ha-nee salta su un Vespa accanto a Rain e Hong-chul per un picnic in un ruscello nascosto.  Tornati al campeggio, i tre si deliziano con una gustosa cena."}]},{"id":150729,"number":8,"name":"Episodio 8","plot":"La storica