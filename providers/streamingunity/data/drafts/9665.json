{"record":{"id":9665,"provider":"streamingunity","locale":"it","path":"/it/titles/9665-allovest-niente-di-nuovo","sourceIds":{"tmdb_id":143,"imdb_id":"tt0020629","netflix_id":null,"prime_id":"0KPPUN9UU1OF6CC37QORZ8VJA8","scws_id":256808,"disney_id":null,"now_id":null,"apple_id":null,"paramount_id":null,"hbo_id":null},"info":{"id":9665,"name":"All'ovest niente di nuovo","slug":"allovest-niente-di-nuovo","plot":"Siamo nel 1916. In un piccolo villaggio tedesco, il professore di liceo Kantorek esalta gli ideali bellici e patriottici e convince i propri allievi ad arruolarsi (tranne un giovane chiamato Giuseppe Behn, persuaso poi dai suoi compagni), ma il loro entusiasmo scema immediatamente all'eseguire, durante l'addestramento, gli ordini del sottufficiale Himmelstoss, che con i suoi modi ed il carattere austero educherà i ragazzi alla vera realtà del fronte, ben diversa dalla retorica del professore.  I soldati vengono poi assegnati ad un'unità di veterani, che nei loro confronti si sentono superiori e sono meno accomodanti; questi, senza cibo da due giorni, ridacchiano con un po' di malizia quando i \"pulcini\" chiedono loro qualcosa da mangiare. Fortunatamente, hanno dalla loro parte un soldato particolarmente abile nel trovare cibarie, chiamato Stanislaw Katczinsky.","quality":"HD","type":"movie","original_name":"All Quiet on the Western Front","original_language":"en","status":"Released","runtime":133,"views":29204,"daily_views":8,"score":"8.5","tmdb_id":143,"imdb_id":"tt0020629","netflix_id":null,"prime_id":"0KPPUN9UU1OF6CC37QORZ8VJA8","scws_id":256808,"public":1,"release_date":"1930-04-29","last_air_date":"1930-04-29","sub_ita":0,"dub_ita":1,"created_at":"2024-08-20T12:43:02.000000Z","updated_at":"2026-11-07T05:00:00.000000Z","disney_id":null,"now_id":null,"apple_id":null,"paramount_id":null,"age":12,"audio_orig":1,"release_date_it":"1930-04-29","last_air_date_it":"1930-04-29","uploaded_at":"2024-08-20 14:43:02","views_it":29204,"daily_views_it":8,"hbo_id":null,