{"record":{"id":12046,"provider":"streamingunity","locale":"it","path":"/it/titles/12046-i-love-radio-rock","sourceIds":{"tmdb_id":18947,"imdb_id":"tt1131729","netflix_id":null,"prime_id":null,"scws_id":306742,"disney_id":null,"now_id":null,"apple_id":null,"paramount_id":null,"hbo_id":null},"info":{"id":12046,"name":"I Love Radio Rock","slug":"i-love-radio-rock","plot":"Nel 1966 - il periodo più straordinario per il pop britannico - la BBC trasmetteva solo 2 ore di rock and roll alla settimana. Ma una radio privata trasmetteva musica rock e pop, da una nave al largo della Gran Bretagna, 24 ore al giorno. E 25 milioni di persone - più di metà della popolazione britannica - ascoltava questi pirati ogni giorno. Dopo essere stato espulso da scuola, Carl (Tom Sturridge) viene spedito dalla sua ricca madre, frequentatrice dei salotti alla moda, presso il suo padrino Quentin (Bill Nighy), con la speranza che capisca ciò che vuole fare nella vita. Ma Quentin è il capo di Radio Rock, una radio libera pirata che trasmette da una nave nel bel mezzo del Mare del Nord, con a bordo un eclettico equipaggio di DJ di rock 'n' roll. Ma la radio pirata ha attirato l'attenzione del Ministro Dormandy (Kenneth Branagh) che da la caccia a questi fuorilegge.","quality":"HD","type":"movie","original_name":"The Boat That Rocked","original_language":"en","status":"Released","runtime":135,"views":15661,"daily_views":3,"score":"7.7","tmdb_id":18947,"imdb_id":"tt1131729","netflix_id":null,"prime_id":null,"scws_id":306742,"public":1,"release_date":"2009-04-01","last_air_date":"2009-04-01","sub_ita":0,"dub_ita":1,"created_at":"2025-04-16T13:59:01.000000Z","updated_at":"2026-10-31T05:00:00.000000Z","disney_id":null,"now_id":null,"apple_id":null,"paramount_id":null,"age":null,"audio_orig":1,"release_date_it":"2009-04-01","last_air_date_it":"2009-04-01","uploaded_at":"2025-04-16 15:59:01","views_it":15661,"daily_views_it":3,"hbo_id":null,"seasons_count":0,"coming_soon":false,"trailers":[{"id":7717,"n