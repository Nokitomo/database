,"release_date_it":null,"episodes_count":4,"translations":[{"id":16198,"translatable_type":"season","translatable_id":6079,"locale":"it","key":"name","value":"Stagione 1"}]}]},"seasons":{"1":{"id":6079,"number":1,"name":"Stagione 1","plot":"","release_date":null,"title_id":10102,"created_at":"2024-10-06T17:59:15.000000Z","updated_at":"2025-05-12T09:58:16.000000Z","release_date_it":null,"translations":[{"id":16198,"translatable_type":"season","translatable_id":6079,"locale":"it","key":"name","value":"Stagione 1"}],"episodes":[{"id":77884,"number":1,"name":"Il sogno di una bambola","plot":"A Eunsoo viene chiesto di scrivere il testo di una canzone da un famoso compositore. Chiede a Sunwoo di aiutarla con il lavoro trasferendosi a casa sua, perché non centra mai l'obiettivo con i suoi testi. Il giorno dopo, Sunwoo si presenta davanti a Eunsoo. Con le valigie! La loro convivenza durerà due settimane. Il primo giorno, bevono insieme. Il giorno seguente, riaprono gli occhi abbracciati.","duration":45,"scws_id":263994,"season_id":6079,"created_at":"2024-10-06T17:59:18.000000Z","updated_at":"2025-11-05T08:40:22.000000Z","quality":"HD","audio_orig":1,"dub_ita":1,"sub_ita":0,"uploaded_at":"2024-10-06 19:59:18","images":[{"id":135776,"filename":"311d5477-e0f7-4aba-a586-b1a8e27157fd.webp","type":"cover","lang":null,"imageable_type":"episode","imageable_id":77884,"created_at":"2024-10-06T17:59:18.000000Z","updated_at":"2024-10-06T17:59:18.000000Z","original_url_field":null,"reference":{"base":"images","path":"/images/311d5477-e0f7-4aba-a586-b1a8e27157fd.webp"}}],"translations":[{"id":232059,"translatable_type":"episode","translatable_id":77884,"locale":"it","key":"name","value":"Il sogno di una bambola"},{"id":232060,"translatable_type":"episode","translatable_id":77884,"locale":"it","key":"plot","value":"A Eunsoo viene chiesto di scrivere il testo di una canzone da un famoso compositore. Chiede a Sunwoo di aiutarla con il lavoro trasferendosi a casa sua, perché non centra mai l'obiettivo con i suoi testi. Il giorno dopo, Sunwoo si presenta davanti a Eunsoo. Con le valigie! La loro convivenza durerà due settimane. Il primo giorno, bevono insieme. Il giorno seguente, riaprono gli occhi abbracciati."}]},{"id":77886,"number":2,"name":"Ho Perso la Testa","plot":"Sunwoo ed Eunsoo provano imbarazzo dopo essersi toccati, ma si comportano come se non fosse successo nulla. Sunwoo incontra il compositore con Eunsoo, e il rapporto tra Wooil ed Eunsoo lo mette a disagio. Poi, un giorno, mentre Sunwoo sta facendo la doccia, Eunsoo apre il computer di Sunwoo dietro richiesta di Donghyun, e scopre che ha una cotta per lei.","duration":41,"scws_id":263995,"season_id":6079,"created_at":"2024-10-06T18:03:15.000000Z","updated_at":"2025-11-05T08:40:22.000000Z","quality":"HD","audio_orig":1,"dub_ita":1,"sub_ita":0,"uploaded_at":"2024-10-06 20:03:15","images":[{"id":135795,"filename":"24d4aaf3-8a82-4dca-8c55-d015d1f8a62b.webp","type":"cover","lang":null,"imageable_type":"episode","imageable_id":77886,"created_at":"2024-10-06T18:03:15.000000Z","updated_at":"2024-10-06T18:03:15.000000Z","original_url_field":null,"reference":{"base":"images","path":"/images/24d4aaf3-8a82-4dca-8c55-d015d1f8a62b.webp"}}],"translations":[{"id":232063,"translatable_type":"episode","translatable_id":77886,"locale":"it","key":"name","value":"Ho Perso la Testa"},{"id":232064,"translatable_type":"episode","translatable_id":77886,"locale":"it","key":"plot","value":"Sunwoo ed Eunsoo provano imbarazzo dopo essersi toccati, ma si comportano come se non fosse successo nulla. Sunwoo incontra il compositore con Eunsoo, e il rapporto tra Wooil ed Eunsoo lo mette a disagio. Poi, un giorno, mentre Sunwoo sta facendo la doccia, Eunsoo apre il computer di Sunwoo dietro richiesta di Donghyun, e scopre che ha una cotta per lei."}]},{"id":77885,"number":3,"name":"Amore","plot":"Eunsoo è confusa dopo aver scoperto i sentimenti di Sunwoo. Intanto, Wooil confessa a Eunsoo quello che prova per lei, e le chiede di poterla conoscere meglio. Sunwoo li trova in un’enoteca ed entra nel locale. Mentre Eunsoo non c’è, Wooil dice a Sunwoo di essersi dichiarato.","duration":48,"scws_id":263996,"season_id":6079,"created_at":"2024-10-06T18:03:09.000000Z","updated_at":"2025-11-05T08:40:22.000000Z","quality":"HD","audio_orig":1,"dub_ita":1,"sub_ita":0,"uploaded_at":"2024-10-06 20:03:09","images":[{"id":135794,"filename":"8170e201-40ad-401c-9849-71bd883e3e93.webp","type":"cover","lang":null,"imageable_type":"episode","imageable_id":77885,"created_at":"2024-10-06T18:03:10.000000Z","updated_at":"2024-10-06T18:03:10.000000Z","original_url_field":null,"reference":{"base":"images","path":"/images/8170e201-40ad-401c-9849-71bd883e3e93.webp"}}],"translations":[{"id":232061,"translatable_type":"episode","translatable_id":77885,"locale":"it","key":"name","value":"Amore"},{"id":232062,"translatable_type":"episode","translatable_id":77885,"locale":"it","key":"plot","value":"Eunsoo è confusa dopo aver scoperto i sentimenti di Sunwoo. Intanto, Wooil confessa a Eunsoo quello che prova per lei, e le chiede di poterla conoscere meglio. Sunwoo li trova in un’enoteca ed entra nel locale. Mentre Eunsoo non c’è, Wooil dice a Sunwoo di essersi dichiarato."}]},{"id":77888,"number":4,"name":"Un Peso sul Cuore","plot":"Dopo la partenza di Sunwoo, Eunsoo trascorre le giornate a scrivere canzoni. È contenta di lavorare per Taeyoon, con cui sperava di collaborare da tanto tempo. Tuttavia, si sente vuota perché non può condividere tutto questo con Sunwoo. Sunwoo torna in Corea all’improvviso. Eunsoo capisce che Sunwoo è una persona di cui non può fare a meno.","duration":56,"scws_id":263997,"season_id":6079,"created_at":"2024-10-06T18:07:03.000000Z","updated_at":"2025-11-05T08:40:22.000000Z","quality":"HD","audio_orig":1,"dub_ita":1,"sub_ita":0,"uploaded_at":"2024-10-06 20:07:03","images":[{"id":135814,"filename":"b77d1c61-7b73-4833-b55d-6d406b90f9a9.webp","type":"cover","lang":null,"imageable_type":"episode",