{"record":{"id":17149,"provider":"streamingunity","locale":"it","path":"/it/titles/17149-terremoto-nel-bronx","sourceIds":{"tmdb_id":33542,"imdb_id":"tt0113326","netflix_id":null,"prime_id":null,"scws_id":362361,"disney_id":null,"now_id":null,"apple_id":null,"paramount_id":null,"hbo_id":null},"info":{"id":17149,"name":"Terremoto nel Bronx","slug":"terremoto-nel-bronx","plot":"Il giovane Keung, poliziotto di Hong Kong giunto nel Bronx per le nozze dello zio Bill, per salvare la \"limousine\" appositamente noleggiata interrompe la gara di motocross, sui tetti delle automobili, allestita la vigilia del matrimonio da una gang che imperversa nel quartiere. Mentre lo zio si sposa e parte con la moglie di colore, dopo aver venduto il negozio alla cinesina Elaine, costei utilizza come aiutante Keung che, dopo aver sgominato una parte della gang con la quale aveva lottato in precedenza, viene stretto in un vicolo e bersagliato dai cocci di bottiglie. Keung si trascina sanguinante a casa di Danny, un ragazzo paraplegico la cui sorella, Nancy, che lo cura, è la \"donna\" di Tony, il capo della banda, il cui scherano Angelo assistendo ad un rocambolesco scontro ha prelevato da un automobile una valigia piena di diamanti, acquistati dal mafioso Tiger alla gang che li ha rubati.","quality":"HD","type":"movie","original_name":"紅番區","original_language":"cn","status":"Released","runtime":104,"views":13486,"daily_views":21,"score":"7.5","tmdb_id":33542,"imdb_id":"tt0113326","netflix_id":null,"prime_id":null,"scws_id":362361,"public":1,"release_date":"1995-01-21","last_air_date":"1995-01-21","sub_ita":0,"dub_ita":1,"created_at":"2025-09-23T08:06:53.000000Z","updated_at":"2026-11-14T05:00:01.000000Z","disney_id":null,"now_id":null,"apple_id":null,"paramount_id":null,"age":18,"audio_orig":1,"release_date_it":"1995-01-21","last_air_date_it":"1995-01-21","uploaded_at":"2025-09-23 10:06:53","views_it":13486,"daily_views_it":21,"hbo_id":null,"seasons_count":0,"coming_soon":false,"trailers":