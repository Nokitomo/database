{"record":{"id":58836,"provider":"streamingunity","locale":"it","path":"/it/titles/58836-il-principe-e-il-povero","sourceIds":{"tmdb_id":22815,"imdb_id":"tt0077381","netflix_id":null,"prime_id":null,"scws_id":795069,"disney_id":null,"now_id":null,"apple_id":null,"paramount_id":null,"hbo_id":null},"info":{"id":58836,"name":"Il principe e il povero","slug":"il-principe-e-il-povero","plot":"Per sfuggire alle guardie che lo inseguono il ladruncolo Tom Canty si infila nella cappa di un camino e di lì cade  nella stanza del principe di Galles, Edoardo, figlio di Enrico VIII. A corte si dà un ballo mascherato e, poichè gli somiglia come una goccia d'acqua, il principe propone al furfante uno scambio di vestiti. Per un tiro del destino accade che Edoardo, scambiato per un vero pezzente, venga scacciato dalla reggia, e che Tom, malgrado dica la verità sul proprio conto, prenda il suo posto. Da quel giorno, mentre Tom assaporerà i piaceri che danno la ricchezza e il potere, ma capirà anche come sia difficile governare, il povero Edoardo scoprirà l'esistenza di un mondo fatto di povertà e di ingiustizie. Dopo molte avventure, però, i due giovani riprenderanno i loro relativi ruoli: Edoardo sarà incoronato re, ma Tom resterà al suo fianco come consigliere.","quality":"HD","type":"movie","original_name":"The Prince and the Pauper","original_language":"en","status":"Released","runtime":113,"views":623,"daily_views":10,"score":"6.1","tmdb_id":22815,"imdb_id":"tt0077381","netflix_id":null,"prime_id":null,"scws_id":795069,"public":1,"release_date":"1977-06-03","last_air_date":"1977-06-03","sub_ita":0,"dub_ita":1,"created_at":"2026-05-23T15:51:37.000000Z","updated_at":"2026-10-31T05:00:00.000000Z","disney_id":null,"now_id":null,"apple_id":null,"paramount_id":null,"age":null,"audio_orig":1,"release_date_it":"1977-06-03","last_air_date_it":"1977-06-03","uploaded_at":"2026-10-18 10:00:36","views_it":623,"daily_views_it":10,"hbo_id":null,"seasons_count":0,"coming_soon":false,"trailers":[