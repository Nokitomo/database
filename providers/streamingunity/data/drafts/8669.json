ason_id":4892,"created_at":"2024-06-02T15:20:01.000000Z","updated_at":"2025-11-05T08:39:54.000000Z","quality":"HD","audio_orig":0,"dub_ita":1,"sub_ita":0,"uploaded_at":"2024-06-02 17:20:01","images":[{"id":111223,"filename":"141c7811-b5ee-444d-acf7-99fd47759de3.webp","type":"cover","lang":null,"imageable_type":"episode","imageable_id":63645,"created_at":"2024-06-02T15:20:02.000000Z","updated_at":"2024-06-02T15:20:02.000000Z","original_url_field":null,"reference":{"base":"images","path":"/images/141c7811-b5ee-444d-acf7-99fd47759de3.webp"}}],"translations":[{"id":202283,"translatable_type":"episode","translatable_id":63645,"locale":"it","key":"name","value":"Eccellenti Strateghi"},{"id":202284,"translatable_type":"episode","translatable_id":63645,"locale":"it","key":"plot","value":"I polpi sfidano ogni regola dell'intelligenza animale. Nascono orfani, sono autodidatti, capaci di risolvere problemi complessi, elaborare strategie e persino pianificare il futuro. Questi straordinari superpoteri sono il segreto del loro successo."}]},{"id":63646,"number":3,"name":"Esperti di Reti Sociali","plot":"Si pensava che i polpi fossero i solitari per eccellenza della natura, prediligendo la propria compagnia. La verità è che hanno vite sociali segrete. Dalle mamme in attesa che si riuniscono in profondità in centinaia, a un polpo capace di collaborare con un'altra specie. Questi alieni della natura sono più socievoli di quanto si possa immaginare.","duration":45,"scws_id":231313,"season_id":4892,"created_at":"2024-06-02T15:21:02.000000Z","updated_at":"2025-11-05T08:39:54.000000Z","quality":"HD","audio_orig":0,"dub_ita":1,"sub_ita":0,"uploaded_at":"2024-06-02 17:21:02","images":[{"id":111224,"filename":"d6e8224a-aba9-45c1-973c-444e58ebcf0d.webp","type":"cover","lang":null,"imageable_type":"episode","imageable_id":63646,"created_at":"2024-06-02T15:21:03.000000Z","updated_at":"2024-06-02T15:21:03.000000Z","original_url_field":null,"reference":{"base":"images","path":"/images/d6e8224a