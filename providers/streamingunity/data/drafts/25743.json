{"record":{"id":25743,"provider":"streamingunity","locale":"it","path":"/it/titles/25743-benvenuto-sulla-terra","sourceIds":{"tmdb_id":127700,"imdb_id":"tt13623992","netflix_id":null,"prime_id":null,"scws_id":null,"disney_id":null,"now_id":null,"apple_id":null,"paramount_id":null,"hbo_id":null},"info":{"id":25743,"name":"Benvenuto sulla Terra","slug":"benvenuto-sulla-terra","plot":"Potrebbe sembrare che gli esseri umani abbiano mappato ogni centimetro della superficie del nostro pianeta, ma guarda più da vicino e scoprirai che c'è ancora molto di più da scoprire - l'età dell'esplorazione è tutt'altro che finita! Benvenuto sulla Terra. Will Smith in una straordinaria avventura intorno al Mondo per esplorare le più grandi meraviglie della Terra e rivelare i suoi segreti più nascosti. Nel corso della serie, Will è guidato da esploratori d'élite in un viaggio impressionante, avvicinandosi ad alcuni degli spettacoli più emozionanti del pianeta - dai vulcani che ruggiscono in silenzio, ai deserti che vanno oltre la nostra percezione, agli sciami di animali. Combinando una cinematografia mozzafiato con la curiosità e l'entusiasmo senza limiti di Will, la serie blockbuster è un viaggio emozionante e multisensoriale attraverso i portali più sconvolgenti della Terra.","quality":"HD","type":"tv","original_name":"Welcome to Earth","original_language":"en","status":"Ended","runtime":null,"views":7047,"daily_views":4,"score":"7.7","tmdb_id":127700,"imdb_id":"tt13623992","netflix_id":null,"prime_id":null,"scws_id":null,"public":1,"release_date":"2021-12-08","last_air_date":"2021-12-08","sub_ita":1,"dub_ita":0,"created_at":"2025-10-12T06:53:27.000000Z","updated_at":"2026-10-31T05:00:00.000000Z","disney_id":null,"now_id":null,"apple_id":null,"paramount_id":null,"age":null,"audio_orig":1,"release_date_it":"2021-12-08","last_air_date_it":"2021-12-08","uploaded_at":null,"views_it":7047,"daily_views_it":4,"hbo_id":null,"seasons_count":1,"coming_soon":false,"trailers":[{"id":16943,"name"