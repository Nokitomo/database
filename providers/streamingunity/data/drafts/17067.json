29:53.000000Z","updated_at":"2025-09-23T04:29:53.000000Z","original_url_field":null,"reference":{"base":"images","path":"/images/a102795a-fd28-4748-a51b-351c3d4b72b5.webp"}}],"translations":[{"id":329690,"translatable_type":"episode","translatable_id":114449,"locale":"it","key":"name","value":"Episodio 1"}]},{"id":114450,"number":2,"name":"Episodio 2","plot":"Viktor and Mika try to get a sound system up and running, but it remains stubbornly silent – unlike the customer, an eccentric retired colonel with a hearing aid who would prefer to do their job himself. A heated exchange about masculinity and generational conflicts ensues, and a lie is exposed: did Viktor tell Mika’s mum that he has testicular cancer?","duration":22,"scws_id":363927,"season_id":8994,"created_at":"2025-09-23T04:29:55.000000Z","updated_at":"2025-11-05T08:41:29.000000Z","quality":"HD","audio_orig":1,"dub_ita":0,"sub_ita":1,"uploaded_at":"2025-09-23 06:29:55","images":[{"id":257074,"filename":"d69a5544-b2c0-427c-aa26-7dfdae81fd31.webp","type":"cover","lang":null,"imageable_type":"episode","imageable_id":114450,"created_at":"2025-09-23T04:29:55.000000Z","updated_at":"2025-09-23T04:29:55.000000Z","original_url_field":null,"reference":{"base":"images","path":"/images/d69a5544-b2c0-427c-aa26-7dfdae81fd31.webp"}}],"translations":[{"id":329691,"translatable_type":"episode","translatable_id":114450,"locale":"it","key":"name","value":"Episodio 2"}]},{"id":114451,"number":3,"name":"Episodio 3","plot":"Viktor and Mika are sucked into a marital spat between Nora and Paul, a couple who seem hopelessly overwhelmed by a combination of working from home and raising their young twins. This makes it all the more critical that the expensive espresso machine delivers the longed-for coffee! Yet somehow, between tarot cards and bizarre insults, father and son again get to know each other a little better.","duration":22,"scws_id":363928,"season_id":8994,"created_at":"2025-09-23T04:29:58.000000Z","updated_at":"2025-11-05T08:41:29.000000Z","quality":"HD","audio_orig":1,"dub_ita":0,"sub_ita":1,"uploaded_at":"2025-09-23 06:29:58","images":[{"id":257075,"filename":"38a3ad70-500f-4de6-aae8-04f838bf0932.webp","type":"cover","lang":null,"imageable_type":"episode","imageable_id":114451,"created_at":"2025-09-23T04:29:59.000000Z","updated_at":"2025-09-23T04:29:59.000000Z","original_url_field":null,"reference":{"base":"images","path":"/images/38a3ad70-500f-4de6-aae8-04f838bf0932.webp"}}],"translations":[{"id":329692,"translatable_type":"episode","translatable_id":114451,"locale":"it","key":"name","value":"Episodio 3"}]},{"id":114454,"number":4,"name":"Episodio 4","plot":"Viktor e Mika si ritrovano inaspettatamente coinvolti in un bizzarro furto e in un'emozionale montagna russa mentre consegnano una friggitrice a immersione in un pub di Berlino. Mentre sono confrontati con questa situazione minacciosa e con una giovane donna autore del reato, vengono rivelati fondamentali conflitti generazionali: i padri possono essere in generale accusati di tutto?","duration":22,"scws_id":363929,"season_id":8994,"created_at":"2025-09-23T04:32:32.000000Z","updated_at":"2025-11-05T08:41:29.000000Z","quality":"HD","audio_orig":1,"dub_ita":0,"sub_ita":1,"uploaded_at":"2025-09-23 06:32:32","images":[{"id":257088,"filename":"da24fe8e-a795-46d5-86ca-b4fe1f566d11.webp","type":"cover","lang":null,"imageable_type":"episode","imageable_id":114454,"created_at":"2025-09-23T04:32:34.000000Z","updated_at":"2025-09-23T04:32:34.000000Z","original_url_field":null,"reference":{"base":"images","path":"/images/da24fe8e-a795-46d5-86ca-b4fe1f566d11.webp"}}],"translations":[{"id":329702,"translatable_type":"episode","translatable_id":114454,"locale":"it","key":"name","value":"Episodio 4"},{"id":329703,"translatable_type":"episode","translatable_id":114454,"locale":"it","key":"plot","value":"Viktor e Mika si ritrovano inaspettatamente coinvolti in un bizzarro furto e in un'emozionale montagna russa mentre consegnano una friggitrice a immersione in un pub di Berlino. Mentre sono confrontati con questa situazione minacciosa e con una giovane donna autore del reato, vengono rivelati fondamentali conflitti generazionali: i padri possono essere in generale accusati di tutto?"}]},{"id":114452,"number":5,"name":"Episodio 5","plot":"Viktor and Mika are mired in AI chaos when they install a new controller. Between dealing with a talking fridge and an overzealous Smart Home system, Felix, a professional ‘wait-person,’ informs them that most jobs will soon no longer exist anyway! And so a heated discussion erupts about the value of human labor in this age of AI: will service technicians soon be superfluous?","duration":21,"scws_id":363930,"season_id":8994,"created_at":"2025-09-23T04:30:01.000000Z","updated_at":"2025-11-05T08:41:29.000000Z","quality":"HD","audio_orig":1,"dub_ita":0,"sub_ita":1,"uploaded_at":"2025-09-23 06:30:01","images":[{"id":257076,"filename":"b8b3638f-a03d-4b47-b396-1ad90749e369.webp","type":"cover","lang":null,"imageable_type":"episode","imageable_id":114452,"created_at":"2025-09-23T04:30:01.000000Z","updated_at":"2025-09-23T04:30:01.000000Z","original_url_field":null,"reference":{"base":"images","path":"/images/b8b3638f-a03d-4b47-b396-1ad90749e369.webp"}}],"translations":[{"id":329693,"translatable_type":"episode","translatable_id":114452,"locale":"it","key":"name","value":"Episodio 5"}]},{"id":114453,"number":6,"name":"Episodio 6","plot":"Viktor is quite excited: he is to meet Mika’s girlfriend, Ruby, for the first time! An artist, she’s quite the fiery character – and reminds Viktor of his ex-wife, which really irritates Mika: His mother is nothing like her! Between discussions about pathogenic beauty ideals and weird photo shoots, things actually get dangerous for a moment: Did Viktor forget to check the power cables?","duration":22,"scws_id":363931,"season_id":8994,"created_at":"2025-09-23T04:30:03.000000Z","updated_at":"2025-11-05T08:41:29.000000Z","quality":"HD","audio_orig":1,"dub_ita":0,"sub_ita":1,"uploaded_at":"2025-09-23 06:30:03","images":[{"id":257077,"filename":"6a586298-e6ba-4120-a18a-fa46a3ab6514.webp","type":"cover","lang":null,"imageable_type":"episode","imageable_id":114453,"created_at":"2025-09-23T04:30:04.000000Z","updated_at":"2025-09-23T04:30:04.000000Z","original_url_field":null,"reference":{"base":"images","path":"/images/6a586298-e6ba-4120-a18a-fa46a3ab6514.webp"}}],"translations":[{"id":329694,"translatable_type":"episode","translatable_id":114453,"locale":"it","key":"name","value":"Episodio 6"}]},{"id":114455,"number":7,"name":"Episodio 7","plot":"Viktor and Mika deliver a robotic lawnmower to an offbeat pastor who firmly believes that faith is a big help in these turbulent times. The topic of forgiveness also comes up sooner than Viktor would like: Mika finds out that Viktor lied about his testicular cancer story and is devastated. Will this break the newly formed bond between father and son?","duration":22,"scws_id":363932,"season_id":8994,"created_at":"2025-09-23T04:32:35.000000Z","updated_at":"2025-11-05T08:41:29.000000Z","quality":"HD","audio_orig":1,"dub_ita":0,"sub_ita":1,"uploaded_at":"2025-09-23 06:32:35","images":[{"id":257089,"filename":"fbe63ee5-58ca-4170-94dd-49c7654d4ada.webp","type":"cover","lang":null,"imageable_type":"episode","imageable_id":114455,"created_at":"2025-09-23T04:32:36.000000Z","updated_at":"2025-09-23T04:32:36.000000Z","original_url_field":null,"reference":{"base":"images","path":"/images/fbe63ee5-58ca-4170-94dd-49c7654d4ada.webp"}}],"translations":[{"id":329704,"translatable_type":"episode","translatable_id":114455,"locale":"it","key":"name","value":"Episodio 7"}]},{"id":114456,"number":8,"name":"Episodio 8","plot":"Viktor confesses that he lied about his health in order to be closer to Mika. Luckily Mika forgives him – in any case, they have to mount a projector on the ceiling of a remarkable tantra temple! When Mika gets a tempting job offer here, another question arises: Should Mika perhaps go all-in and properly join Viktor’s business?","duration":26,"scws_id":363933,"season_id":8994,"created_at":"2025-09-23T04:32:38.000000Z","updated_at":"2025-11-05T08:41:29.000000Z","quality":"HD","audio_orig":1,"dub_ita":0,"sub_ita":1,"uploaded_at":"2025-09-23 06:32:38","images":[{"id":257090,"filename":"890495da-2859-439b-b0c1-2cf37708d790.webp","type":"cover","lang":null,"imageable_type":"episode","imageable_id":114456,"created_at":"2025-09-23T04:32:38.000000Z","updated_at":"2025-09-23T04:32:38.000000Z","original_url_field":null,"reference":{"base":"images","path":"/images/890495da-2859-439b-b0c1-2cf37708d790.webp"}}],"translations":[{"id":329705,"translatable_type":"episode","translatable_id":114456,"locale":"it","key":"name","value":"Episodio 8"}]}],"path":"/it/titles/17067-viktor-consegna/season-1","images":[]}},"seasonCheckedAt":{"1":1794672855137},"startedAt":1794672855137,"finished":true}
