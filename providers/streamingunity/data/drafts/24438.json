s_count":16,"translations":[{"id":423260,"translatable_type":"season","translatable_id":11655,"locale":"it","key":"name","value":"Stagione 1"},{"id":423261,"translatable_type":"season","translatable_id":11655,"locale":"it","key":"release_date","value":"2022-06-01"}]}]},"seasons":{"1":{"id":11655,"number":1,"name":"Stagione 1","plot":"","release_date":"2022-06-01","title_id":24438,"created_at":"2025-10-08T06:12:24.000000Z","updated_at":"2025-11-05T08:37:22.000000Z","release_date_it":"2022-06-01","translations":[{"id":423260,"translatable_type":"season","translatable_id":11655,"locale":"it","key":"name","value":"Stagione 1"},{"id":423261,"translatable_type":"season","translatable_id":11655,"locale":"it","key":"release_date","value":"2022-06-01"}],"episodes":[{"id":144650,"number":1,"name":"Episodio 1","plot":"Inizia un nuovo anno per la Liyan Kindergarten, leader mondiale nel campo dell'educazione precoce. Genitori provenienti da contesti prestigiosi si riuniscono per una raccolta fondi alla Liyan. Kang Youn-kyum, rappresentante del Gruppo LY, partecipa con sua moglie per sua figlia. Tuttavia, lì incontra una giovane donna che scatena qualcosa nel suo cuore. Una scintilla che può mettere in pericolo tutto ciò che ha costruito fino ad ora.","duration":59,"scws_id":692445,"season_id":11655,"created_at":"2025-10-08T06:14:10.000000Z","updated_at":"2026-03-17T22:41:42.000000Z","quality":"HD","audio_orig":1,"dub_ita":0,"sub_ita":1,"uploaded_at":"2026-03-17 23:41:41","images":[{"id":332172,"filename":"b1101fa7-e349-443a-aa12-c6a00d778c53.webp","type":"cover","lang":null,"imageable_type":"episode","imageable_id":144650,"created_at":"2025-10-08T06:14:11.000000Z","updated_at":"2025-10-08T06:14:11.000000Z","original_url_field":null,"reference":{"base":"images","path":"/images/b1101fa7-e349-443a-aa12-c6a00d778c53.webp"}}],"translations":[{"id":423264,"translatable_type":"episode","translatable_id":144650,"locale":"it","key":"name","value":"Episodio 1"},{"id":423265,"translatable_type":"episode","translatable_id":144650,"locale":"it","key":"plot","value":"Inizia un nuovo anno per la Liyan Kindergarten, leader mondiale nel campo dell'educazione precoce. Genitori provenienti da contesti prestigiosi si riuniscono per una raccolta fondi alla Liyan. Kang Youn-kyum, rappresentante del Gruppo LY, partecipa con sua moglie per sua figlia. Tuttavia, lì incontra una giovane donna che scatena qualcosa nel suo cuore. Una scintilla che può mettere in pericolo tutto ciò che ha costruito fino ad ora."}]},{"id":144651,"number":2,"name":"Episodio 2","plot":"Eun-pyeong climbs higher in politics. Despite his success and popularity, he still remembers everything about Ra-el and her real mother even after all these years. Knowing in his gut that Ra-el is still alive, he continues the search. Meanwhile, Youn-kyum feels his heart burning when he thinks of Sun-bin. Although his emotion is about to burst, he has no intention of fighting it.","duration":66,"scws_id":692446,"season_id":11655,"created_at":"2025-10-08T06:14:13.000000Z","updated_at":"2026-03-17T22:41:14.000000Z","quality":"HD","audio_orig":1,"dub_ita":0,"sub_ita":1,"uploaded_at":"2026-03-17 23:41:13","images":[{"id":332173,"filename":"ced861bb-e105-4398-a398-cf49a9abbfd7.webp","type":"cover","lang":null,"imageable_type":"episode","imageable_id":144651,"created_at":"2025-10-08T06:14:13.000000Z","updated_at":"2025-10-08T06:14:13.000000Z","original_url_field":null,"reference":{"base":"images","path":"/images/ced861bb-e105-4398-a398-cf49a9abbfd7.webp"}}],"translations":[{"id":423266,"translatable_type":"episode","translatable_id":144651,"locale":"it","key":"name","value":"Episodio 2"}]},{"id":319017,"number":3,"name":"Episode 3","plot":"Rael resolves disputes, wins Sora, plans approach to Yun-kyum. Invited to elite society","duration":62,"scws_id":692447,"season_id":11655,"created_at":"2026-03-17T22:45:44.000000Z","updated_at":"2026-03-17T22:45:47.000000Z","quality":"HD","audio_orig":1,"dub_ita":0,"sub_ita":1,"uploaded_at":"2026-03-17 23:45:46","images":[{"id":670037,"filename":"baaf4127-7ca4-4fea-a06a-460a4a0618b5.webp","type":"cover","lang":null,"imageable_type":"episode","imageable_id":319017,"created_at":"2026-03-17T22:45:46.000000Z","updated_at":"2026-03-17T22:45:46.000000Z","original_url_field":null,"reference":{"base":"images","path":"/images/baaf4127-7ca4-4fea-a06a-460a4a0618b5.webp"}}],"translations":[{"id":880193,"translatable_type":"episode","translatable_id":319017,"locale":"it","key":"name","value":"Episode 3"},{"id":880194,"translatable_type":"episode","translatable_id":319017,"locale":"it","key":"plot","value":"Rael resolves disputes, wins Sora, plans approach to Yun-kyum. Invited to elite society"}]},{"id":144648,"number":4,"name":"Episodio 4","plot":"Sun-bin is on a clear path to gaining So-ra’s total trust. With the trust she gains, she must investigate the ledgers of LY Group that might be in Youn-kyum’s study. However, Eun-pyeong finds shocking information about Kang Youn-kyum. Something that Ra-el has no clue about and something that can ruin her plan of taking down LY Group.","duration":67,"scws_id":692448,"season_id":11655,"created_at":"2025-10-08T06:12:24.000000Z","updated_at":"2026-03-17T22:48:42.000000Z","quality":"HD","audio_orig":1,"dub_ita":0,"sub_ita":1,"uploaded_at":"2026-03-17 23:48:41","images":[{"id":332163,"filename":"41ec1ebb-0790-4a2c-9834-56187fd30260.webp","type":"cover","lang":null,"imageable_type":"episode","imageable_id":144648,"created_at":"2025-10-08T06:12:25.000000Z","updated_at":"2025-10-08T06:12:25.000000Z","original_url_field":null,"reference":{"base":"images","path":"/images/41ec1ebb-0790-4a2c-9834-56187fd30260.webp"}}],"translations":[{"id":423262,"translatable_type":"episode","translatable_id":144648,"locale":"it","key":"name","value":"Episodio 4"}]},{"id":144649,"number":5,"name":"Episodio 5","plot":"Youn-kyum does not fall for Ra-el easily. Just when things seem to be in a tight spot, Ra-el comes up with a plan by using So-ra’s birthday. Meanwhile, although Eun-pyeong is well-known for not taking any politician or conglomerate’s side, he is willing to do whatever he can to help Ra-el achieve her goal. Step by step, she becomes closer to punishing all those who destroyed her family.","duration":62,"scws_id":692449,"season_id":11655,"created_at":"2025-10-08T06:12:26.000000Z","updated_at":"2026-03-17T22:52:12.000000Z","quality":"HD","audio_orig":1,"dub_ita":0,"sub_ita":1,"uploaded_at":"2026-03-17 23:52:12","images":[{"id":332171,"filename":"450c9a91-b598-4999-86b6-cf84c8aa6dc1.webp","type":"cover","lang":null,"imageable_type":"episode","imageable_id":144649,"created_at":"2025-10-08T06:12:27.000000Z","updated_at":"2025-10-08T06:12:27.000000Z","original_url_field":null,"reference":{"base":"images","path":"/images/450c9a91-b598-4999-86b6-cf84c8aa6dc1.webp"}}],"translations":[{"id":423263,"translatable_type":"episode","translatable_id":144649,"locale":"it","key":"name","value":"Episodio 5"}]},{"id":144652,"number":6,"name":"Episodio 6","plot":"So-ra is enraged with Youn-kyum’s disappearance. Despite the presence of her daughter, she does not control her emotions. Meanwhile, Youn-kyum confesses his true feelings to Ra-el. With true love as his source of energy, he determines to break free from being LY’s puppet. Ra-el’s revenge begins to speed up. The day of vengeance is soon to come.","duration":68,"scws_id":692450,"season_id":11655,"created_at":"2025-10-08T06:14:15.000000Z","updated_at":"2026-03-17T22:54:42.000000Z","quality":"HD","audio_orig":1,"dub_ita":0,"sub_ita":1,"uploaded_at":"2026-03-17 23:54:41","images":[{"id":332174,"filename":"9ea525bf-d4c4-4e04-911d-cd3c988f07b5.webp","type":"cover","lang":null,"imageable_type":"episode","imageable_id":144652,"created_at":"2025-10-08T06:14:15.000000Z","updated_at":"2025-10-08T06:14:15.000000Z","original_url_field":null,"reference":{"base":"images","path":"/images/9ea525bf-d4c4-4e04-911d-cd3c988f07b5.webp"}}],"translations":[{"id":423267,"translatable_type":"episode","translatable_id":144652,"locale":"it","key":"name","value":"Episodio 6"}]},{"id":144653,"number":7,"name":"Episodio 7","plot":"Now that Ra-el knows about her mother Jin-sook's death, she seeks revenge by getting close to Youn-kyum. Ra-el sees his scars. She knows it isn't right, but she can't resist and slowly falls for Youn-kyum. Eun-pyeong teams up with Pan-ro to help Ra-el. Meanwhile, So-ra's compulsive behavior goes out of control when she suspects Youn-kyum is seeing another woman.","duration":67,"scws_id":692451,"season_id":11655,"created_at":"2025-10-08T06:14:17.000000Z","updated_at":"2026-03-17T22:58:14.000000Z","quality":"HD","audio_orig":1,"dub_ita":0,"sub_ita":1,"uploaded_at":"2026-03-17 23:58:14","images":[{"id":332175,"filename":"0f8fd55e-e2ce-440a-b3e0-dbbf94274550.webp","type":"cover","lang":null,"imageable_type":"episode","imageable_id":144653,"created_at":"2025-10-08T06:14:18.000000Z","updated_at":"2025-10-08T06:14:18.000000Z","original_url_field":null,"reference":{"base":"images","path":"/images/0f8fd55e-e2ce-440a-b3e0-dbbf94274550.webp"}}],"translations":[{"id":423268,"translatable_type":"episode","translatable_id":144653,"locale":"it","key":"name","value":"Episodio 7"}]},{"id":144654,"number":8,"name":"Episodio 8","plot":"So-ra uses the hit-and-run accident to her advantage and begins to search for Youn-kyum's mistress. Ra-el keeps her distance, hitting Youn-kyum and So-ra mentally. And as soon as she disappears, Youn-kyum yearns for her even more. Meanwhile, So-ra kidnaps Ra-el's bodyguard to find Youn-kyum's woman, and a fierce battle of nerves begins between So-ra and Ra-el. Later, Ra-el makes her return dressed lavishly.","duration":67,"scws_id":692452,"season_id":11655,"created_at":"2025-10-08T06:14:19.000000Z","updated_at":"2026-03-17T23:02:12.000000Z","quality":"HD","audio_orig":1,"dub_ita":0,"sub_ita":1,"uploaded_at":"2026-03-18 00:02:11","images":[{"id":332176,"filename":"bfa00016-0951-4084-85df-eccc2cc26455.webp","type":"cover","lang":null,"imageable_type":"episode","imageable_id":144654,"created_at":"2025-10-08T06:14:20.000000Z","updated_at":"2025-10-08T06:14:20.000000Z","original_url_field":null,"reference":{"base":"images","path":"/images/bfa00016-0951-4084-85df-eccc2cc26455.webp"}}],"translations":[{"id":423269,"translatable_type":"episode","translatable_id":144654,"locale":"it","key":"name","value":"Episodio 8"}]},{"id":144655,"number":9,"name":"Episodio 9","plot":"Youn-kyum and So-ra don't react as Ra-el expected. So-ra starts to ostracize Ra-el at the kindergarten now that she knows Ra-el is Youn-kyum's mistress. Ra-el starts to become anxious, seeing no difference in Youn-kyum and So-ra's relationship. Meanwhile, Eun-pyeong takes the president's chief secretary position and vows to help Ra-el get her revenge as his love for her grows deeper.","duration":63,"scws_id":692453,"season_id":11655,"created_at":"2025-10-08T06:14:21.000000Z","updated_at":"2026-03-17T23:03:42.000000Z","quality":"HD","audio_orig":1,"dub_ita":0,"sub_ita":1,"uploaded_at":"2026-03-18 00:03:42","images":[{"id":332177,"filename":"2d097316-48b2-494f-aac0-7551baa10b38.webp","type":"cover","lang":null,"imageable_type":"episode","imageable_id":144655,"created_at":"2025-10-08T06:14:22.000000Z","updated_at":"2025-10-08T06:14:22.000000Z","original_url_field":null,"reference":{"base":"images","path":"/images/2d097316-48b2-494f-aac0-7551baa10b38.webp"}}],"translations":[{"id":423270,"translatable_type":"episode","translatable_id":144655,"locale":"it","key":"name","value":"Episodio 9"}]},{"id":144658,"number":10,"name":"Episodio 10","plot":"Ra-el falls deeper into the darkness after Moon-hee's betrayal and Youn-kyum's indifference. To get Youn-kyum to move, Ra-el deals with him coldly, grabbing and letting go of his heart. Later, at LY Shopping Mall's formal gathering, So-ra falls into Ra-el's plot.","duration":60,"scws_id":692454,"season_id":11655,"created_at":"2025-10-08T06:16:12.000000Z","updated_at":"2026-03-17T23:04:42.000000Z","quality":"HD","audio_orig":1,"dub_ita":0,"sub_ita":1,"uploaded_at":"2026-03-18 00:04:41","images":[{"id":332179,"filename":"45ce7785-7803-4992-9850-2bb6dd7b5e01.webp","type":"cover","lang":null,"imageable_type":"episode","imageable_id":144658,"created_at":"2025-10-08T06:16:12.000000Z","updated_at":"2025-10-08T06:16:12.000000Z","original_url_field":null,"reference":{"base":"images","path":"/images/45ce7785-7803-4992-9850-2bb6dd7b5e01.webp"}}],"translations":[{"id":423274,"translatable_type":"episode","translatable_id":144658,"locale":"it","key":"name","value":"Episodio 10"}]},{"id":144659,"number":11,"name":"Episodio 11","plot":"Youn-kyum goes to the house of roses after he tells So-ra he wants a divorce. His love deepens while enjoying his time there. He tells Ra-el he loves her. She tries to turn a blind eye to his endearment, but she can't help herself and falls deeper into love. Meanwhile, Eun-pyeong warns Ra-el that it could get dangerous if she stays with Youn-kyum.","duration":60,"scws_id":692455,"season_id":11655,"created_at":"2025-10-08T06:16:14.000000Z","updated_at":"2026-03-17T23:09:12.000000Z","quality":"HD","audio_orig":1,"dub_ita":0,"sub_ita":1,"uploaded_at":"2026-03-18 00:09:11","images":[{"id":332180,"filename":"e74c2f30-bb80-44bf-8962-00ce94d886cc.webp","type":"cover","lang":null,"imageable_type":"episode","imageable_id":144659,"created_at":"2025-10-08T06:16:14.000000Z","updated_at":"2025-10-08T06:16:14.000000Z","original_url_field":null,"reference":{"base":"images","path":"/images/e74c2f30-bb80-44bf-8962-00ce94d886cc.webp"}}],"translations":[{"id":423275,"translatable_type":"episode","translatable_id":144659,"locale":"it","key":"name","value":"Episodio 11"}]},{"id":144656,"number":12,"name":"Episodio 12","plot":"Ra-el sees Youn-kyum's sincerity and gets torn by her love for him and her revenge. Meanwhile, news about Youn-kyum's private life begins to circulate that enrages So-ra. So-ra orders one of her men to capture Ra-el at all costs. Eun-pyeong saves her but sustains a critical injury. And because of it, Ra-el determines to face So-ra head-on and take what's hers.","duration":61,"scws_id":692456,"season_id":11655,"created_at":"2025-10-08T06:14:23.000000Z","updated_at":"2026-03-17T23:10:42.000000Z","quality":"HD","audio_orig":1,"dub_ita":0,"sub_ita":1,"uploaded_at":"2026-03-18 00:10:42","images":[{"id":332178,"filename":"8d0ebfcd-8879-4fc0-8b63-eca2cb049844.webp","type":"cover","lang":null,"imageable_type":"episode","imageable_id":144656,"created_at":"2025-10-08T06:14:24.000000Z","updated_at":"2025-10-08T06:14:24.000000Z","original_url_field":null,"reference":{"base":"images","path":"/images/8d0ebfcd-8879-4fc0-8b63-eca2cb049844.webp"}}],"translations":[{"id":423271,"translatable_type":"episode","translatable_id":144656,"locale":"it","key":"name","value":"Episodio 12"}]},{"id":144660,"number":13,"name":"Episodio 13","plot":"So-ra gives Youn-kyum clues about Ra-el's identity. Ra-el and Youn-kyum's relationship becomes compromised with So-ra's drop of doubt. Realizing there isn't much time left, Ra-el thinks only of her revenge. Youn-kyum senses Ra-el's secret, but it doesn't cloud his love for her. And Ra-el has a hard time taming her heart for his unconditional love.","duration":62,"scws_id":692457,"season_id":11655,"created_at":"2025-10-08T06:16:16.000000Z","updated_at":"2026-03-17T23:14:42.000000Z","quality":"HD","audio_orig":1,"dub_ita":0,"sub_ita":1,"uploaded_at":"2026-03-18 00:14:41","images":[{"id":332181,"filename":"eaf4cd04-d1c7-45f0-9eba-91bf64e9730b.webp","type":"cover","lang":null,"imageable_type":"episode","imageable_id":144660,"created_at":"2025-10-08T06:16:17.000000Z","updated_at":"2025-10-08T06:16:17.000000Z","original_url_field":null,"reference":{"base":"images","path":"/images/eaf4cd04-d1c7-45f0-9eba-91bf64e9730b.webp"}}],"translations":[{"id":423276,"translatable_type":"episode","translatable_id":144660,"locale":"it","key":"name","value":"Episodio 13"}]},{"id":144661,"number":14,"name":"Episodio 14","plot":"Youn-kyum is utterly shocked when he learns about Ra-el's secrets. Ra-el and Eun-pyeong believe Pan-ro has Moon-hee. Eun-pyeong storms Pan-ro's residence with the police to search for Moon-hee, but they come up empty-handed. Ra-el learns more about her mother's death and becomes further enraged. Ra-el takes the lead in Moon-hee's place to finish her revenge, and Eun-pyeong helps her in any way he can.","duration":60,"scws_id":692458,"season_id":11655,"created_at":"2025-10-08T06:16:18.000000Z","updated_at":"2026-03-17T23:17:14.000000Z","quality":"HD","audio_orig":1,"dub_ita":0,"sub_ita":1,"uploaded_at":"2026-03-18 00:17:14","images":[{"id":332182,"filename":"91268531-84ff-4053-8853-bc0ffdfcb45c.webp","type":"cover","lang":null,"imageable_type":"episode","imageable_id":144661,"created_at":"2025-10-08T06:16:19.000000Z","updated_at":"2025-10-08T06:16:19.000000Z","original_url_field":null,"reference":{"base":"images","path":"/images/91268531-84ff-4053-8853-bc0ffdfcb45c.webp"}}],"translations":[{"id":423277,"translatable_type":"episode","translatable_id":144661,"locale":"it","key":"name","value":"Episodio 14"}]},{"id":144662,"number":15,"name":"Episodio 15","plot":"The trial proceeds as scheduled, and Youn-kyum himself shows up in the courtroom. At the same time, with the evidence left behind by Moon-hee, Ra-el turns So-ra and Pan-ro against each other. Cornered and pressured, So-ra finds herself turning into the weakest version of herself. Meanwhile, Youn-kyum asks for forgiveness, even if it means sacrificing his own life.","duration":60,"scws_id":692459,"season_id":11655,"created_at":"2025-10-08T06:16:20.000000Z","updated_at":"2026-03-17T23:21:14.000000Z","quality":"HD","audio_orig":1,"dub_ita":0,"sub_ita":1,"uploaded_at":"2026-03-18 00:21:13","images":[{"id":332183,"filename":"54c177dd-5fca-433e-b562-ebe060cee5a5.webp","type":"cover","lang":null,"imageable_type":"episode","imageable_id":144662,"created_at":"2025-10-08T06:16:21.000000Z","updated_at":"2025-10-08T06:16:21.000000Z","original_url_field":null,"reference":{"base":"images","path":"/images/54c177dd-5fca-433e-b562-ebe060cee5a5.webp"}}],"translations":[{"id":423278,"translatable_type":"episode","translatable_id":144662,"locale":"it","key":"name","value":"Episodio 15"}]},{"id":144676,"number":16,"name":"Episodio 16","plot":"Jung-chul heads to the villa where Ra-el and Youn-kyum are. He is determined to hurt Ra-el as much as she had hurt him. Youn-kyum ends up killing Jung-chul, and he decides to turn himself in. Ra-el receives the gift Youn-kyum left him, and she decides to leave for Buenos Aires upon seeing it. Sometime later, Eun-pyeong decides to go and see Ra-el in Buenos Aires.","duration":65,"scws_id":692460,"season_id":11655,"created_at":"2025-10-08T06:20:16.000000Z","updated_at":"2026-03-17T23:27:12.000000Z","quality":"HD","audio_orig":1,"dub_ita":0,"sub_ita":1,"uploaded_at":"2026-03-18 00:27:11","images":[{"id":332222,"filename":"c1bd9205-5356-4d2c-b723-50c4d2ded195.webp","type":"cover","lang":null,"imageable_type":"episode","imageable_id":144676,"created_at":"2025-10-08T06:20:17.000000Z","updated_at":"2025-10-08T06:20:17.000000Z","original_url_field":null,"reference":{"base":"images","path":"/images/c1bd9205-5356-4d2c-b723-50c4d2ded195.webp"}}],"translations":[{"id":423326,"translatable_type":"episode","translatable_id":144676,"locale":"it","key":"name","value":"Episodio 16"}]}],"path":"/it/titles/24438-eve/season-1","images":[]}},"seasonCheckedAt":{"1":1794673153848},"startedAt":1794673153848,"finished":true}
