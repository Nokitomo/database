a6-2d635a315d07.webp","type":"cover","lang":null,"imageable_type":"episode","imageable_id":132381,"created_at":"2025-09-30T19:04:31.000000Z","updated_at":"2025-09-30T19:04:31.000000Z","original_url_field":null,"reference":{"base":"images","path":"/images/a78d5ece-2002-4e73-baa6-2d635a315d07.webp"}}],"translations":[{"id":381627,"translatable_type":"episode","translatable_id":132381,"locale":"it","key":"name","value":"Episodio 1"},{"id":381628,"translatable_type":"episode","translatable_id":132381,"locale":"it","key":"plot","value":"Nell'aperitivo esplosivo, Teen Mania emerge come il radicale movimento evangelicale giovanile dell'America millennial. Il carismatico fondatore Ron Luce affascina con \"Acquire the Fire\" - revival di stadio pirotecnici dove gli adolescenti promettono la loro vita alla rivoluzione spirituale. Sotto l'adorazione da concerto rock e le missioni cristiane alimentate dall'adrenalina, Luce sta assemblando il suo esercito di veri credenti."}]},{"id":132383,"number":2,"name":"Episodio 2","plot":"L'Accademia d'Onore di Teen Mania sottopone i suoi giovani e ansiosi nuovi adepti a brutali tattiche di addestramento e lunghe ore trascorse in un enorme call center come telemarketing adolescenti per Gesù, affrontando quote schiaccianti mentre endurevano rigide regole di purezza.  Simulazioni terrificanti del \"Fine dei Tempi\" complete di esecuzioni simulate creano traumi dissimulati da trasformazione spirituale, forgiando giovani martiri pronti a morire per la loro fede.","duration":50,"scws_id":388215,"season_id":10410,"created_at":"2025-09-30T19:04:33.000000Z","updated_at":"2025-11-05T08:42:02.000000Z","quality":"HD","audio_orig":1,"dub_ita":0,"sub_ita":1,"uploaded_at":"2025-09-30 21:04:33","images":[{"id":299134,"filename":"e0dea8b9-47c7-4211-957a-7225beffcb71.webp","type":"cover","lang":null,"imageable_type":"episode","imageable_id":132383,"created_at":"2025-09-30T19:04:34.000000Z","updated_at":"2025-09-30T19:04:34.000000Z","original_url_field":null,"reference":{"base":"images","path":"/images/e0dea8b9-47c7-4211-957a-7225beffcb71.webp"}}],"translations":[{"id":381631,"translatable_type":"episode","translatable_id":132383,"locale":"it","key":"name","value":"Episodio 2"},{"id":381632,"translatable_type":"episode","translatable_id":132383,"locale":"it","key":"plot","value":"L'Accademia d'Onore di Teen Mania sottopone i suoi giovani e ansiosi nuovi adepti a brutali tattiche di addestramento e lunghe ore trascorse in un enorme call center come telemarketing adolescenti per Gesù, affrontando quote schiaccianti mentre endurevano rigide regole di purezza.  Simulazioni terrificanti del \"Fine dei Tempi\" complete di esecuzioni simulate creano traumi dissimulati da trasformazione spirituale, forgiando giovani martiri pronti a morire per la loro fede."}]},{"id":132386,"number":3,"name":"Episodio 3","plot":"Teen Mania raggiunge nuovi estremi con BattleCry, una campagna di guerra culturale iper-militante.   Un piede piper evangelicale, Luce, conduce i ragazzi in proteste politicamente volatili.  Nel frattempo, gli stagisti crollano in condizioni estenuanti e gli alunni iniziano a parlare, portando al tragico destino di Teen Mani.  Ma l'esercito che Ron ha addestrato continua a combattere, con conseguenze devastanti che continuano a svolgersi oggi.","duration":53,"scws_id":388216,"season_id":10410,"created_at":"2025-09-30T19:04:35.000000Z","updated_at":"2025-11-05T08:42:02.000000Z","quality":"HD","audio_orig":1,"dub_ita":0,"sub_ita":1,"uploaded_at":"2025-09-30 21:04:35","images":[{"id":299136,"filename":"c964f62c-77c0-481a-b086-974218a30e88.webp","type":"cover","lang":null,"imageable_type":"episode","imageable_id":132386,"created_at":"2025-09-30T19:04:36.000000Z","updated_at":"2025-09-30T19:04:36.000000Z","original_url_field":null,"reference":{"base":"images","path":"/images/c964f62c-77c0-481a-b086-974218a30e88.webp"}}],"translations":[{"id":381634,"translatable_type":"episode","translatable_id":132386,"locale":"it","key":