54-4769-8358-a289894cafbf.webp","type":"cover","lang":null,"imageable_type":"episode","imageable_id":132875,"created_at":"2025-09-30T23:33:13.000000Z","updated_at":"2025-09-30T23:33:13.000000Z","original_url_field":null,"reference":{"base":"images","path":"/images/9060b73e-5754-4769-8358-a289894cafbf.webp"}}],"translations":[{"id":383747,"translatable_type":"episode","translatable_id":132875,"locale":"it","key":"name","value":"Episodio 2"},{"id":383748,"translatable_type":"episode","translatable_id":132875,"locale":"it","key":"plot","value":"Roy scommette sulla sua nuova stella. Binod si abitua alla sua nuova vita. Sumitra si rifiuta di lasciar andare Jamshed. Jay arriva a Bombay ed è costretto a dedicarsi a una vita criminale. Niloufer si trasferisce a Bombay ma si trova in una situazione pericolosa."}]},{"id":132855,"number":3,"name":"Episodio 3","plot":"Jay va in cerca di lavoro e ritrova un vecchio amico. Niloufer si crea delle nuove opportunità. Nanik Jotwani e Roy intraprendono un'impresa rivoluzionaria. La scommessa di distribuzione di Roy su Sunghursh fallisce. La nuova celebrità di Binod è minacciata da una svolta sorprendente.","duration":52,"scws_id":391088,"season_id":10459,"created_at":"2025-09-30T23:27:00.000000Z","updated_at":"2025-11-05T08:42:03.000000Z","quality":"HD","audio_orig":1,"dub_ita":0,"sub_ita":1,"uploaded_at":"2025-10-01 01:27:00","images":[{"id":300455,"filename":"016c5709-9280-4c02-bd8f-6fb42e7eea53.webp","type":"cover","lang":null,"imageable_type":"episode","imageable_id":132855,"created_at":"2025-09-30T23:27:00.000000Z","updated_at":"2025-09-30T23:27:00.000000Z","original_url_field":null,"reference":{"base":"images","path":"/images/016c5709-9280-4c02-bd8f-6fb42e7eea53.webp"}}],"translations":[{"id":383695,"translatable_type":"episode","translatable_id":132855,"locale":"it","key":"name","value":"Episodio 3"},{"id":383696,"translatable_type":"episode","translatable_id":132855,"locale":"it","key":"plot","value":"Jay va in cerca di lavoro e ritrova un vecchio amico. Niloufer si crea delle nuove opportunità. Nanik Jotwani e Roy intraprendono un'impresa rivoluzionaria. La scommessa di distribuzione di Roy su Sunghursh fallisce. La nuova celebrità di Binod è minacciata da una svolta sorprendente."}]},{"id":132857,"number":4,"name":"Episodio 4","plot":"Binod viene ricattato. Niloufer e Jay riaccendono la loro amicizia. Jotwani presenta Roy ad alcuni nuovi e potenti amici. Roy protegge Binod dalla catastrofe, a costo della carriera di Jay.","duration":54,"scws_id":391089,"season_id":10459,"created_at":"2025-09-30T23:29:16.000000Z","updated_at":"2025-11-05T08:42:03.000000Z","quality":"HD","audio_orig":1,"dub_ita":0,"sub_ita":1,"uploaded_at":"2025-10-01 01:29:16","images":[{"id":300467,"filename":"01b29072-b713-4c8f-ae6f-2b1c30a67375.webp","type":"cover","lang":null,"imageable_type":"episode","imageable_id":132857,"created_at":"2025-09-30T23:29:17.000000Z","updated_at":"2025-09-30T23:29:17.000000Z","original_url_field":null,"reference":{"base":"images","path":"/images/01b29072-b713-4c8f-ae6f-2b1c30a67375.webp"}}],"translations":[{"id":383707,"translatable_type":"episode","translatable_id":132857,"locale":"it","key":"name","value":"Episodio 4"},{"id":383708,"translatable_type":"episode","translatable_id":132857,"locale":"it","key":"plot","value":"Binod viene ricattato. Niloufer e Jay riaccendono la loro amicizia. Jotwani presenta Roy ad alcuni nuovi e potenti amici. Roy protegge Binod dalla catastrofe, a costo della carriera di Jay."}]},{"id":132858,"number":5,"name":"Episodio 5","plot":"Una rissa di propaganda internazionale inizia alla Roy Talkies. Jay è determinato ad avviare i propri studios, ma per farlo deve fare un enorme sacrificio personale. Binod si ritira da un impegno e nel farlo si fa un nemico.","duration":55,"scws_id":391090,"season_id":10459,"created_at":"2025-09-30T23:29:18.000000Z","updated_at":"2025-11-05T08:42:03.000000Z","quality":"HD","audio_orig":1,"dub_ita":0,"sub_ita":1,"uploaded_at