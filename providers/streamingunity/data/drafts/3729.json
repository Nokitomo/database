{"record":{"id":3729,"provider":"streamingunity","locale":"it","path":"/it/titles/3729-lora-legale","sourceIds":{"tmdb_id":435921,"imdb_id":"tt6137734","netflix_id":81002874,"prime_id":null,"scws_id":237111,"disney_id":null,"now_id":null,"apple_id":null,"paramount_id":null,"hbo_id":null},"info":{"id":3729,"name":"L'ora legale","slug":"lora-legale","plot":"Salvo e Valentino sono cognati e vivono a Pietrammare, paesino della Sicilia dove gestiscono insieme un chiosco sulla piazza principale. Il marito della sorella di Valentino, a sua volta sorella della moglie di Salvo, è Pierpaolo Natoli, un professore di liceo dagli elevati valori morali e la condotta integerrima. Pierpaolo si candida a sindaco di Pietrammare contrapponendosi a Gaetano Patanè, il primo cittadino in carica, un concentrato di corruzione e malaffare: vuole proporre un cambiamento radicale che metta fine al degrado etico ed estetico che Patanè ha incoraggiato nel paese. A sorpresa, i compaesani votano Natoli sindaco, ma una volta eletto questi esigerà il rispetto assoluto delle regole: e si sa, in Italia chi invoca la legalità lo fa sempre riferendosi agli altri, mai a se stesso.","quality":"HD","type":"movie","original_name":"L'ora legale","original_language":"it","status":"Released","runtime":92,"views":166232,"daily_views":61,"score":"7.2","tmdb_id":435921,"imdb_id":"tt6137734","netflix_id":81002874,"prime_id":null,"scws_id":237111,"public":1,"release_date":"2017-01-19","last_air_date":"2017-01-19","sub_ita":0,"dub_ita":1,"created_at":"2021-08-09T18:59:37.000000Z","updated_at":"2026-10-30T05:00:00.000000Z","disney_id":null,"now_id":null,"apple_id":null,"paramount_id":null,"age":null,"audio_orig":0,"release_date_it":"2017-01-19","last_air_date_it":"2017-01-19","uploaded_at":"2021-08-09 20:59:37","views_it":166232,"daily_views_it":61,"hbo_id":null,"seasons_count":0,"coming_soon":false,"trailers":[{"id":3150,"name":"L'Ora Legale - Trailer ufficiale","is_hd":1,"youtube_id":"VV1zCcAgc7o","title_id":3729,