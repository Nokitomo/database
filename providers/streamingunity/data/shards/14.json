 deciso a cambiare vita, a riparare alle ingiustizie e a \"industriarsi\" a favore dei più deboli. Perfezionata l'armatura con la tecnologia avanzata diventa Iron Man, un (super)eroe \"umano, troppo umano\".","quality":"HD","type":"movie","original_name":"Iron Man","original_language":"en","status":"Released","runtime":126,"views":1041375,"daily_views":493,"score":"8.2","tmdb_id":1726,"imdb_id":"tt0371746","netflix_id":null,"prime_id":null,"scws_id":253542,"public":1,"release_date":"2008-04-30","last_air_date":"2008-04-30","sub_ita":0,"dub_ita":1,"created_at":"2020-04-08T18:15:14.000000Z","updated_at":"2026-10-30T05:00:00.000000Z","disney_id":"6aM2a8mZATiu","now_id":null,"apple_id":null,"paramount_id":null,"age":7,"audio_orig":1,"release_date_it":"2008-04-30","last_air_date_it":"2008-04-30","uploaded_at":"2020-04-08 20:15:14","views_it":1041375,"daily_views_it":493,"hbo_id":null,"seasons_count":0,"coming_soon":false,"trailers":[{"id":201,"name":"Iron Man Trailer Italiano HD","is_hd":1,"youtube_id":"hJc2YALCHdc","title_id":314,"created_at":"2023-05-18T11:54:00.000000Z","updated_at":"2024-03-04T21:49:22.000000Z"}],"genres":[{"id":4,"name":"Azione","type":"movie","hidden":0,"created_at":"2023-05-18T11:48:49.000000Z","updated_at":"2025-05-12T09:22:06.000000Z","pivot":{"title_id":314,"genre_id":4},"translations":[{"id":10,"translatable_type":"App\\Models\\Titles\\Genre","translatable_id":4,"locale":"it","key":"name","value":"Azione"}]},{"id":10,"name":"Fantascienza","type":"movie","hidden":0,"created_at":"2023-05-18T11:48:57.000000Z","updated_at":"2025-05-12T09:22:06.000000Z","pivot":{"title_id":314,"genre_id":10},"translations":[{"id":16,"translatable_type":"App\\Models\\Titles\\Genre","translatable_id":10,"locale":"it","key":"name","value":"Fantascienza"}]},{"id":11,"name":"Avventura","type":"movie","hidden":0,"created_at":"2023-05-18T11:48:57.000000Z","updated_at":"2025-05-12T09:22:06.000000Z","pivot":{"title_id":314,"genre_id":11},"translations":[{"id":17,"translatab