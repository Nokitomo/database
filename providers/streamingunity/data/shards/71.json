divertente e allo stesso tempo crudele della Napoli contemporanea, città dalle mille contraddizioni e dalle tante difficoltà, capace però di non perdere mai la speranza per un futuro migliore."},{"id":55927,"translatable_type":"title","translatable_id":3971,"locale":"it","key":"release_date","value":"2021-09-23"},{"id":55926,"translatable_type":"title","translatable_id":3971,"locale":"it","key":"slug","value":"benvenuti-in-casa-esposito"},{"id":55929,"translatable_type":"title","translatable_id":3971,"locale":"it","key":"views","value":"118950"}],"keywords":[{"id":81,"name":"italy","created_at":"2023-05-18T11:48:56.000000Z","updated_at":"2023-05-18T11:48:56.000000Z","pivot":{"title_id":3971,"keyword_id":81}},{"id":1674,"name":"naples","created_at":"2023-05-18T11:57:01.000000Z","updated_at":"2023-05-18T11:57:01.000000Z","pivot":{"title_id":3971,"keyword_id":1674}}]},"images":[{"id":38378,"filename":"3a45b89a-b1f6-4916-a893-5967df361929.webp","type":"poster","lang":"it","imageable_type":"title","imageable_id":3971,"created_at":"2023-05-18T12:58:06.000000Z","updated_at":"2025-05-12T09:24:31.000000Z","original_url_field":null,"reference":{"base":"images","path":"/images/3a45b89a-b1f6-4916-a893-5967df361929.webp"}},{"id":38380,"filename":"5b991938-c648-44e1-b6bb-fd17b787c9be.webp","type":"cover","lang":"it","imageable_type":"title","imageable_id":3971,"created_at":"2023-05-18T12:58:06.000000Z","updated_at":"2025-05-12T09:24:31.000000Z","original_url_field":null,"reference":{"base":"images","path":"/images/5b991938-c648-44e1-b6bb-fd17b787c9be.webp"}},{"id":38379,"filename":"ab0505c9-0e33-4b46-be23-0d332a64299d.webp","type":"background","lang":null,"imageable_type":"title","imageable_id":3971,"created_at":"2023-05-18T12:58:06.000000Z","updated_at":"2023-05-18T16:46:50.000000Z","original_url_field":null,"reference":{"base":"images","path":"/images/ab0505c9-0e33-4b46-be23-0d332a64299d.webp"}},{"id":38381,"filename":"90b34c34-dba5-4bf1-a7fe-828c7b56a94f.webp","type":"cover_mo