/59e2441e-f7c2-48d8-88de-83db7294f2aa.webp"}}],"seasonIndex":[{"id":4488,"number":1,"name":null,"plot":"","release_date":null,"title_id":8147,"created_at":"2024-04-01T06:59:05.000000Z","updated_at":"2025-05-12T09:53:35.000000Z","release_date_it":null,"episodes_count":4,"translations":[]}],"active":true,"seasons":[{"id":4488,"number":1,"name":null,"plot":"","release_date":null,"title_id":8147,"created_at":"2024-04-01T06:59:05.000000Z","updated_at":"2025-05-12T09:53:35.000000Z","release_date_it":null,"translations":[],"episodes":[{"id":58477,"number":1,"name":"A qualcuno piace il caldo","plot":"Notte d'agosto, una barca approda su una spiaggia a Palermo. Sulla sabbia, il cadavere di una donna: il viso è sfigurato e tra le mani, ha una coda di cavallo. Terio Mangiaracina e i pescatori sono gli unici testimoni e forse, autori del delitto. Ferragosto è vicino e come sostiene una delle trasmissioni televisive più in voga, si può scegliere un colpevole qualsiasi e riparlarne a settembre.","duration":56,"scws_id":217926,"season_id":4488,"created_at":"2024-04-01T06:59:08.000000Z","updated_at":"2025-11-05T08:39:45.000000Z","quality":"HD","audio_orig":0,"dub_ita":1,"sub_ita":0,"uploaded_at":"2024-04-01 08:59:08","images":[{"id":102666,"filename":"d2dd5a52-1d88-4621-a47d-90a91eb7262b.webp","type":"cover","lang":null,"imageable_type":"episode","imageable_id":58477,"created_at":"2024-04-01T06:59:08.000000Z","updated_at":"2024-04-01T06:59:08.000000Z","original_url_field":null,"reference":{"base":"images","path":"/images/d2dd5a52-1d88-4621-a47d-90a91eb7262b.webp"}}],"translations":[{"id":187664,"translatable_type":"episode","translatable_id":58477,"locale":"it","key":"name","value":"A qualcuno piace il caldo"},{"id":187665,"translatable_type":"episode","translatable_id":58477,"locale":"it","key":"plot","value":"Notte d'agosto, una barca approda su una spiaggia a Palermo. Sulla sabbia, il cadavere di una donna: il viso è sfigurato e tra le mani, ha una coda di cavallo. Terio Mangiaracina e i pescatori sono gli unici testimoni e forse, autori del delitto. Ferragosto è vicino e come sostiene una delle trasmissioni televisive più in voga, si può scegliere un colpevole qualsiasi e riparlarne a settembre."}]},{"id":58476,"number":2,"name":"Indagini di quartiere","plot":"Fan della trasmissione TV è Fana, la prosperosa sorella di Terio, poliziotta mancata che non si perde un giallo nazionale, la quale suggerisce di anticipare le indagini ufficiali e cercare la verità autonomamente. Nasce così la Mangiaracina Investigazioni, agenzia abusiva secondo il disinvolto stile cittadino. Come sede, viene scelta l'antica cucina di maioliche regno della madre Assunta.","duration":54,"scws_id":217927,"season_id":4488,"created_at":"2024-04-01T06:59:06.000000Z","updated_at":"2025-11-05T08:39:45.000000Z","quality":"HD","audio_orig":0,"dub_ita":1,"sub_ita":0,"uploaded_at":"2024-04-01 08:59:06","images":[{"id":102665,"filename":"a06cf02f-0bf7-456b-93e6-d2471b904817.webp","type":"cover","lang":null,"imageable_type":"episode","imageable_id":58476,"created_at":"2024-04-01T06:59:06.000000Z","updated_at":"2024-04-01T06:59:06.000000Z","original_url_field":null,"reference":{"base":"images","path":"/images/a06cf02f-0bf7-456b-93e6-d2471b904817.webp"}}],"translations":[{"id":187657,"translatable_type":"episode","translatable_id":58476,"locale":"it","key":"name","value":"Indagini di quartiere"},{"id":187658,"translatable_type":"episode","translatable_id":58476,"locale":"it","key":"plot","value":"Fan della trasmissione TV è Fana, la prosperosa sorella di Terio, poliziotta mancata che non si perde un giallo nazionale, la quale suggerisce di anticipare le indagini ufficiali e cercare la verità autonomamente. Nasce così la Mangiaracina Investigazioni, agenzia abusiva secondo il disinvolto stile cittadino. Come sede, viene scelta l'antica cucina di maioliche regno della madre Assunta."}]},{"id":58482,"number":3,"name":"Amore e sorprese","plot":"La vittima era portiera di un'antica palazzina e anche una nota fattucchiera. Terio e Fana, fingendosi aspiranti portieri, si trasferiscono a lavorare lì. Ma al complicato delitto se ne aggiunge un altro, mentre Terio si perde in un amore che, a detta della sorella, gli toglie ogni lucidità. Per fortuna, il cugino carabiniere Nofrio, emigrato di ritorno a casa, lo aiuta.","duration":54,"scws_id":217928,"season_id":4488,"created_at":"2024-04-01T07:00:04.000000Z","updated_at":"2025-11-05T08:39:45.000000Z","quality":"HD","audio_orig":0,"dub_ita":1,"sub_ita":0,"uploaded_at":"2024-04-01 09:00:04","images":[{"id":102674,"filename":"b846e0ed-5a6d-4144-a0d9-70de134d377d.webp","type":"cover","lang":null,"imageable_type":"episode","imageable_id":58482,"created_at":"2024-04-01T07:00:04.000000Z","updated_at":"2024-04-01T07:00:04.000000Z","original_url_field":null,"reference":{"base":"images","path":"/images/b846e0ed-5a6d-4144-a0d9-70de134d377d.webp"}}],"translations":[{"id":187674,"translatable_type":"episode","translatable_id":58482,"locale":"it","key":"name","value":"Amore e sorprese"},{"id":187675,"translatable_type":"episode","translatable_id":58482,"locale":"it","key":"plot","value":"La vittima era portiera di un'antica palazzina e anche una nota fattucchiera. Terio e Fana, fingendosi aspiranti portieri, si trasferiscono a lavorare lì. Ma al complicato delitto se ne aggiunge un altro, mentre Terio si perde in un amore che, a detta della sorella, gli toglie ogni lucidità. Per fortuna, il cugino carabiniere Nofrio, emigrato di ritorno a casa, lo aiuta."}]},{"id":58481,"number":4,"name":"Dono di famiglia","plot":"Fra malocchi, tradimenti e vertigini amorose, tutto si complica. Terio riceve una brutta sorpresa, mentre gli indizi e le sensazioni sgangherate s'incastrano nella sua mente, anche grazie alla mamma Assunta, fino a fare arrivare l'improvvisato investigatore alla verità. Che non sarà dolce come sperava ma, per la sorella Fana, sarà l'inizio di una nuova carriera.","duration":46,"scws_id":217929,"season_id":4488,"created_at":"2024-04-01T07:00:02.000000Z","updated_at":"2025-11-05T08:39:45.000000Z","quality":"HD","audio_orig":0,"dub_ita":1,"sub_ita":0,"uploaded_at":"2024-04-01 09:00:02","images":[{"id":102673,"filename":"5c2a125e-8554-45d9-85e4-e2bde88a8675.webp","type":"cover","lang":null,"imageable_type":"episode","imageable_id":58481,"created_at":"2024-04-01T07:00:02.000000Z","updated_at":"2024-04-01T07:00:02.000000Z","original_url_field":null,"reference":{"base":"images","path":"/images/5c2a125e-8554-45d9-85e4-e2bde88a8675.webp"}}],"translations":[{"id":187672,"translatable_type":"episode","translatable_id":58481,"locale":"it","key":"name","value":"Dono di famiglia"},{"id":187673,"translatable_type":"episode","translatable_id":58481,"locale":"it","key":"plot","value":"Fra malocchi, tradimenti e vertigini amorose, tutto si complica. Terio riceve una brutta sorpresa, mentre gli indizi e le sensazioni sgangherate s'incastrano nella sua mente, anche grazie alla mamma Assunta, fino a fare arrivare l'improvvisato investigatore alla verità. Che non sarà dolce come sperava ma, per la sorella Fana, sarà l'inizio di una nuova carriera."}]}],"path":"/it/titles/8147-mangiaracina-investigazioni/season-1","images":[]}]}
