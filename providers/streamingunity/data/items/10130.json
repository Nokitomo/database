[{"id":6111,"number":1,"name":null,"plot":"","release_date":null,"title_id":10130,"created_at":"2024-10-09T20:03:05.000000Z","updated_at":"2025-05-12T09:58:22.000000Z","release_date_it":null,"translations":[],"episodes":[{"id":78324,"number":1,"name":"Divisa in Due","plot":"2030: in una Milano grigia e iper-controllata, Diana e Luca vengono mandati in missione a Lugano per spiare lo scambio di una potente arma. Non lontano, Edo Zani, erede di Manticore Italia, deve rispondere ad un’inaspettata proposta della capofamiglia di Manticore Francia Cecile. Nei flashback, Diana indaga sulla misteriosa morte dei propri genitori, quando incontra Gabriele, un agente Citadel.","duration":51,"scws_id":264719,"season_id":6111,"created_at":"2024-10-09T20:06:00.000000Z","updated_at":"2025-11-05T08:40:22.000000Z","quality":"HD","audio_orig":1,"dub_ita":1,"sub_ita":0,"uploaded_at":"2024-10-09 22:06:00","images":[{"id":136391,"filename":"9defbae8-de33-46bf-b774-12b8d04d4de6.webp","type":"cover","lang":null,"imageable_type":"episode","imageable_id":78324,"created_at":"2024-10-09T20:06:01.000000Z","updated_at":"2024-10-09T20:06:01.000000Z","original_url_field":null,"reference":{"base":"images","path":"/images/9defbae8-de33-46bf-b774-12b8d04d4de6.webp"}}],"translations":[{"id":232937,"translatable_type":"episode","translatable_id":78324,"locale":"it","key":"name","value":"Divisa in Due"},{"id":232938,"translatable_type":"episode","translatable_id":78324,"locale":"it","key":"plot","value":"2030: in una Milano grigia e iper-controllata, Diana e Luca vengono mandati in missione a Lugano per spiare lo scambio di una potente arma. Non lontano, Edo Zani, erede di Manticore Italia, deve rispondere ad un’inaspettata proposta della capofamiglia di Manticore Francia Cecile. Nei flashback, Diana indaga sulla misteriosa morte dei propri genitori, quando incontra Gabriele, un agente Citadel."}]},{"id":78325,"number":2,"name":"Guerra","plot":"Diana ed Edo stringono un patto segreto e muovono la prima mossa del loro piano, ma sottovalutano la dura reazione di Cecile. Con Manticore Italia sotto attacco, Ettore Zani deve intervenire per evitare lo scoppio di una guerra. Nei flashback, Diana completa il proprio addestramento con Gabriele e diventa un’agente Citadel.","duration":47,"scws_id":264720,"season_id":6111,"created_at":"2024-10-09T20:07:31.000000Z","updated_at":"2025-11-05T08:40:22.000000Z","quality":"HD","audio_orig":1,"dub_ita":1,"sub_ita":0,"uploaded_at":"2024-10-09 22:07:31","images":[{"id":136392,"filename":"0c9fa082-775f-4ca8-ac78-edeabde8f4dd.webp","type":"cover","lang":null,"imageable_type":"episode","imageable_id":78325,"created_at":"2024-10-09T20:07:31.000000Z","updated_at":"2024-10-09T20:07:31.000000Z","original_url_field":null,"reference":{"base":"images","path":"/images/0c9fa082-775f-4ca8-ac78-edeabde8f4dd.webp"}}],"translations":[{"id":232939,"translatable_type":"episode","translatable_id":78325,"locale":"it","key":"name","value":"Guerra"},{"id":232940,"translatable_type":"episode","translatable_id":78325,"locale":"it","key":"plot","value":"Diana ed Edo stringono un patto segreto e muovono la prima mossa del loro piano, ma sottovalutano la dura reazione di Cecile. Con Manticore Italia sotto attacco, Ettore Zani deve intervenire per evitare lo scoppio di una guerra. Nei flashback, Diana completa il proprio addestramento con Gabriele e diventa un’agente Citadel."}]},{"id":78327,"number":3,"name":"Insieme","plot":"Ettore assegna ad Edo e Diana una delicata missione in Sicilia, che rischia di compromettere la loro alleanza. Eppure, sotto il sole del Mediterraneo, i due scoprono di essere legati da molto di più che dai propri obiettivi. Otto anni prima, Diana si infiltra tra le fila di Manticore e porta a termine la sua prima missione.","duration":49,"scws_id":264721,"season_id":6111,"created_at":"2024-10-09T20:08:00.000000Z","updated_at":"2025-11-05T08:40:22.000000Z","quality":"HD","audio_orig":1,"dub_ita":1,"sub_ita":0,"uploaded_at":"2024-10-09 22:08:00","images":[{"id":136394,"filename":"5f151e35-5e58-4e0e-a5c6-980baef0e091.webp","type":"cover","lang":null,"imageable_type":"episode","imageable_id":78327,"created_at":"2024-10-09T20:08:01.000000Z","updated_at":"2024-10-09T20:08:01.000000Z","original_url_field":null,"reference":{"base":"images","path":"/images/5f151e35-5e58-4e0e-a5c6-980baef0e091.webp"}}],"translations":[{"id":232943,"translatable_type":"episode","translatable_id":78327,"locale":"it","key":"name","value":"Insieme"},{"id":232944,"translatable_type":"episode","translatable_id":78327,"locale":"it","key":"plot","value":"Ettore assegna ad Edo e Diana una delicata missione in Sicilia, che rischia di compromettere la loro alleanza. Eppure, sotto il sole del Mediterraneo, i due scoprono di essere legati da molto di più che dai propri obiettivi. Otto anni prima, Diana si infiltra tra le fila di Manticore e porta a termine la sua prima missione."}]},{"id":78326,"number":4,"name":"Gli Zani","plot":"Diana viene catturata e tenta il tutto per tutto per salvarsi la vita. Mentre Ettore deve prendere una decisione difficile allo scopo di riportare Manticore Italia al potere, riaffiorano i ricordi del giorno in cui il suo rapporto con Edo si è spezzato per sempre.","duration":36,"scws_id":264722,"season_id":6111,"created_at":"2024-10-09T20:07:32.000000Z","updated_at":"2025-11-05T08:40:22.000000Z","quality":"HD","audio_orig":1,"dub_ita":1,"sub_ita":0,"uploaded_at":"2024-10-09 22:07:32","images":[{"id":136393,"filename":"9afeaa8e-0f84-4d6b-8936-eeaf38808a1a.webp","type":"cover","lang":null,"imageable_type":"episode","imageable_id":78326,"created_at":"2024-10-09T20:07:32.000000Z","updated_at":"2024-10-09T20:07:32.000000Z","original_url_field":null,"reference":{"base":"images","path":"/images/9afeaa8e-0f84-4d6b-8936-eeaf38808a1a.webp"}}],"translations":[{"id":232941,"translatable_type":"episode","translatable_id":78326,"locale":"it","key":"name","value":"Gli Zani"},{"id":232942,"translatable_type":"episode","translatable_id":78326,"locale":"it","key":"plot","value":"Diana viene catturata e tenta il tutto per tutto per salvarsi la vita. Mentre Ettore deve prendere una decisione difficile allo scopo di riportare Manticore Italia al potere, riaffiorano i ricordi del giorno in cui il suo rapporto con Edo si è spezzato per sempre."}]},{"id":78328,"number":5,"name":"Assalto","plot":"A Parigi, Edo guida un gruppo di agenti all’assalto del quartier generale di Manticore Francia. Ad un passo dal mettere le mani sull’arma, Diana deve decidere da che parte stare. Come ha dovuto fare anche otto anni prima, la notte in cui Citadel venne distrutta.","duration":46,"scws_id":264723,"season_id":6111,"created_at":"2024-10-09T20:10:00.000000Z","updated_at":"2025-11-05T08:40:22.000000Z","quality":"HD","audio_orig":1,"dub_ita":1,"sub_ita":0,"uploaded_at":"2024-10-09 22:10:00","images":[{"id":136395,"filename":"3cf7b230-e154-492d-acd4-ce8e0b180198.webp","type":"cover","lang":null,"imageable_type":"episode","imageable_id":78328,"created_at":"2024-10-09T20:10:01.000000Z","updated_at":"2024-10-09T20:10:01.000000Z","original_url_field":null,"reference":{"base":"images","path":"/images/3cf7b230-e154-492d-acd4-ce8e0b180198.webp"}}],"translations":[{"id":232945,"translatable_type":"episode","translatable_id":78328,"locale":"it","key":"name","value":"Assalto"},{"id":232946,"translatable_type":"episode","translatable_id":78328,"locale":"it","key":"plot","value":"A Parigi, Edo guida un gruppo di agenti all’assalto del quartier generale di Manticore Francia. Ad un passo dal mettere le mani sull’arma, Diana deve decidere da che parte stare. Come ha dovuto fare anche otto anni prima, la notte in cui Citadel venne distrutta."}]},{"id":78329,"number":6,"name":"Giove","plot":"Mentre Diana riflette sulla sua scelta, Edo lavora ad una nuova e potente arma. Ettore prova a riavvicinarsi al figlio, giocandosi un’ultima, inaspettata carta. Nel passato, gli Zani piangono la morte di Enrico, mentre Diana capisce di essere l’ultima agente Citadel rimasta in vita.","duration":42,"scws_id":264724,"season_id":6111,"created_at":"2024-10-09T20:10:02.000000Z","updated_at":"2025-11-05T08:40:22.000000Z","quality":"HD","audio_orig":1,"dub_ita":1,"sub_ita":0,"uploaded_at":"2024-10-09 22:10:02","images":[{"id":136396,"filename":"caa46073-ba82-4ffb-bb70-cae4a7c8d268.webp","type":"cover","lang":null,"imageable_type":"episode","imageable_id":78329,"created_at":"2024-10-09T20:10:02.000000Z","updated_at":"2024-10-09T20:10:02.000000Z","original_url_field":null,"reference":{"base":"images","path":"/images/caa46073-ba82-4ffb-bb70-cae4a7c8d268.webp"}}],"translations":[{"id":232947,"translatable_type":"episode","translatable_id":78329,"locale":"it","key":"name","value":"Giove"},{"id":232948,"translatable_type":"episode","translatable_id":78329,"locale":"it","key":"plot","value":"Mentre Diana riflette sulla sua scelta, Edo lavora ad una nuova e potente arma. Ettore prova a riavvicinarsi al figlio, giocandosi un’ultima, inaspettata carta. Nel passato, gli Zani piangono la morte di Enrico, mentre Diana capisce di essere l’ultima agente Citadel rimasta in vita."}]}],"path":"/it/titles/10130-citadel-diana/season-1","images":[]}]}
