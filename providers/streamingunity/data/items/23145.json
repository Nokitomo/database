ble_type":"season","translatable_id":11120,"locale":"it","key":"name","value":"Stagione 2"},{"id":405267,"translatable_type":"season","translatable_id":11120,"locale":"it","key":"release_date","value":"2025-08-27"}]}],"active":true,"seasons":[{"id":11119,"number":1,"name":"Stagione 1","plot":"","release_date":"2022-10-05","title_id":23145,"created_at":"2025-10-03T10:32:55.000000Z","updated_at":"2025-11-05T08:37:21.000000Z","release_date_it":"2022-10-05","translations":[{"id":405240,"translatable_type":"season","translatable_id":11119,"locale":"it","key":"name","value":"Stagione 1"},{"id":405241,"translatable_type":"season","translatable_id":11119,"locale":"it","key":"release_date","value":"2022-10-05"}],"episodes":[{"id":139801,"number":1,"name":"Episodio 1","plot":"In mare aperto al largo della costa nord-occidentale remota dell'Australia, un luogo di acque profonde brulicante di fauna marina ha catturato l'immaginazione dei cacciatori di relitti. Ossessionati dal potenziale di trovare un sito di relitto storico, la loro attenzione si rivolge alla storia dei marinai persi in mare e delle famiglie che hanno lasciato indietro. È un'avventura piena di sorprese che cambierà per sempre le loro vite.","duration":52,"scws_id":400677,"season_id":11119,"created_at":"2025-10-03T10:38:50.000000Z","updated_at":"2025-11-05T08:42:16.000000Z","quality":"HD","audio_orig":1,"dub_ita":0,"sub_ita":1,"uploaded_at":"2025-10-03 12:38:50","images":[{"id":319058,"filename":"748dccc8-1567-4b87-9c24-262ddaee82ab.webp","type":"cover","lang":null,"imageable_type":"episode","imageable_id":139801,"created_at":"2025-10-03T10:38:51.000000Z","updated_at":"2025-10-03T10:38:51.000000Z","original_url_field":null,"reference":{"base":"images","path":"/images/748dccc8-1567-4b87-9c24-262ddaee82ab.webp"}}],"translations":[{"id":405283,"translatable_type":"episode","translatable_id":139801,"locale":"it","key":"name","value":"Episodio 1"},{"id":405284,"translatable_type":"episode","translatable_id":139801,"locale":"it","key":"plot","value":"In mare aperto al largo della costa nord-occidentale remota dell'Australia, un luogo di acque profonde brulicante di fauna marina ha catturato l'immaginazione dei cacciatori di relitti. Ossessionati dal potenziale di trovare un sito di relitto storico, la loro attenzione si rivolge alla storia dei marinai persi in mare e delle famiglie che hanno lasciato indietro. È un'avventura piena di sorprese che cambierà per sempre le loro vite."}]},{"id":139802,"number":2,"name":"Episodio 2","plot":"I cacciatori di relitti cercano un lussuoso transatlantico di linea chiamato Koombana, che si infilò dritto sulla traiettoria di un ciclone mortale al largo della remota costa nord-occidentale dell'Australia e non fu mai più visto. Oltre 150 persone furono perse in mare e le comunità furono lasciate devastate. La squadra è determinata ad aiutare a risolvere questo enigmatico mistero oceanico.","duration":49,"scws_id":400678,"season_id":11119,"created_at":"2025-10-03T10:38:54.000000Z","updated_at":"2025-11-05T08:42:16.000000Z","quality":"HD","audio_orig":1,"dub_ita":0,"sub_ita":1,"uploaded_at":"2025-10-03 12:38:54","images":[{"id":319059,"filename":"16e29a5a-c076-4c1b-8b26-9622889e3f97.webp","type":"cover","lang":null,"imageable_type":"episode","imageable_id":139802,"created_at":"2025-10-03T10:38:55.000000Z","updated_at":"2025-10-03T10:38:55.000000Z","original_url_field":null,"reference":{"base":"images","path":"/images/16e29a5a-c076-4c1b-8b26-9622889e3f97.webp"}}],"translations":[{"id":405285,"translatable_type":"episode","translatable_id":139802,"locale":"it","key":"name","value":"Episodio 2"},{"id":405286,"translatable_type":"episode","translatable_id":139802,"locale":"it","key":"plot","value":"I cacciatori di relitti cercano un lussuoso transatlantico di linea chiamato Koombana, che si infilò dritto sulla traiettoria di un ciclone mortale al largo della remota costa nord-occidentale dell'Australia e non fu mai più visto. Oltre 150 persone furono perse in mare e le comunità furono lasciate devastate. La squadra è determinata ad aiutare a risolvere questo enigmatico mistero oceanico."}]},{"id":139803,"number":3,"name":"Episodio 3","plot":"A surprise attack during World War II in the remote north-west Australian town of Broome destroyed and sank fifteen flying boats, of which five have never been found. The Shipwreck Hunters search this challenging location with some of the biggest tidal variations in the world— as well as sharks, crocodiles and near zero visibility underwater pushing them to their limits.","duration":46,"scws_id":400679,"season_id":11119,"created_at":"2025-10-03T10:38:56.000000Z","updated_at":"2025-11-05T08:42:16.000000Z","quality":"HD","audio_orig":1,"dub_ita":0,"sub_ita":1,"uploaded_at":"2025-10-03 12:38:56","images":[{"id":319060,"filename":"3f3d1e21-885f-4424-8f05-1723b728af2d.webp","type":"cover","lang":null,"imageable_type":"episode","imageable_id":139803,"created_at":"2025-10-03T10:38:57.000000Z","updated_at":"2025-10-03T10:38:57.000000Z","original_url_field":null,"reference":{"base":"images","path":"/images/3f3d1e21-885f-4424-8f05-1723b728af2d.webp"}}],"translations":[{"id":405287,"translatable_type":"episode","translatable_id":139803,"locale":"it","key":"name","value":"Episodio 3"}]},{"id":139793,"number":4,"name":"Episodio 4","plot":"The Shipwreck Hunters investigate an epic tale from the age of pirates. Their destination is a wild open-ocean location 130 kilometers off the mainland of Australia’s treacherous north-west coast. The team search an imposing site for clues and explore uninhabited islands nearby to try to put an epic shipwreck story, finally, to rest.","duration":51,"scws_id":400680,"season_id":11119,"created_at":"2025-10-03T10:35:46.000000Z","updated_at":"2025-11-05T08:42:16.000000Z","quality":"HD","audio_orig":1,"dub_ita":0,"sub_ita":1,"uploaded_at":"2025-10-03 12:35:46","images":[{"id":319045,"filename":"b0380678-95fe-4d39-a299-4c90388d8b02.webp","type":"cover","lan