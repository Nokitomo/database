[{"schemaVersion":1,"provider":"animesaturn","id":"12ifn","code":"12ifn","path":"/anime/hack-roots-12ifn","token":null,"episodePath":null,"sourceIds":{"mal":873,"anilist":873},"info":{"title":".hack//Roots","originalTitle":".hack//Roots","synopsis":"Nell'anno 2015 la centrale dati della CC corporation fu completamente distrutta in un incendio, evento che sancì la fine celebre gioco online \"The World\". mettendo insieme i dati recuperati e quelli per un nuovo progetto la CC riesce a ricostruire in qualche modo il gioco: ecco quindi nel 2016 debuttare \"The World R:2\". Haseo è un nuovo giocatore, ha voluto provare \"the World\" invogliato da un amico che aveva parlato bene della precedente versione, ma non sembra trovarsi troppo a suo agio col gioco. Ben presto però viene catturato dal carisma di Ovan che lo porta ad unirsi con lui alla Brigata del Crepuscolo. Come a suo tempo .hack//Sign, Roots non è un prequel per l'imminente nuovo gioco Bandai basato su \"The World\" (.Hack//G.U.). Di nuovo lo studio Be Train alla realizzazione e Koichi Mashimo alla regia... ma con un assenza piuttosto importante che è quella di Yuki Kajura, creatrice della colonna sonora che era uno dei maggiori punti di forza del primo capitolo.","type":"TV","status":"completed","statusLabel":"Finito","audio":"Giapponese","dubbed":false,"season":"Primavera 2006","year":2006,"releaseDateLabel":"06 Aprile 2006","studios":["Bee Train"],"genres":["Avventura","Drammatico","Fantasy","Gioco","Sci-Fi"],"declaredEpisodeCount":26,"availableEpisodeCount":26,"durationLabel":"24 min","rating":null,"ratingCount":null,"views":93500,"poster":{"base":"images","path":"/static/images/locandine/c91d805a1a00415f.png"}},"images":[{"kind":"poster","url":{"base":"images","path":"/static/images/locandine/c91d805a1a00415f.png"}},{"kind":"background","url":{"base":"images","path":"/static/images/background/2532.jpg"}},{"kind":"share","url":{"base":"images","path":"/static/images/background/2532.jpg"}}],"episodes":[{"id":