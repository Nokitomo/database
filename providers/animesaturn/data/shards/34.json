[{"schemaVersion":1,"provider":"animesaturn","id":"eqB8j","code":"eqB8j","path":"/anime/aguu-tensai-ningyou-eqB8j","token":null,"episodePath":null,"sourceIds":{"mal":37769,"anilist":101631},"info":{"title":"Aguu: Tensai Ningyou","originalTitle":"Aguu: Genius Dolls","synopsis":"Ci sono persone intorno a noi che non devono sforzarsi troppo chiamate \"geni\". Questi geni hanno tutti però qualcosa in comune: posseggono un certo \"qualcosa\", un segreto che non possono rivelare alle persone normali. Quel segreto è \"Aguu\". La protagonista della storia si chiama Ai, una ragazza normale e una ballerina. Anche la sua amica Machi è una ballerina, ma lei è un genio. Il talento di Machi fa sentire spesso giù di morale Ai, ma un giorno quest'ultima riesce a scoprire il segreto dell'amica: l'esistenza degli Aguu, entità grandi quanto un palmo di una mano in grado di fornire un talento da genio a chi le possiede. Per salvare Machi, ormai diventata una \"Sarta\" che crea Aguu, Ai diventa una \"Salvatrice\". I salvatori sono un gruppo di persone che hanno combattuto i sarti per generazioni.","type":"TV","status":"completed","statusLabel":"Finito","audio":"Giapponese","dubbed":false,"season":"Estate 2018","year":2018,"releaseDateLabel":"10 Luglio 2018","studios":["Studio Deen"],"genres":["Azione","Drammatico","Soprannaturale"],"declaredEpisodeCount":12,"availableEpisodeCount":12,"durationLabel":"23 min","rating":null,"ratingCount":null,"views":52758,"poster":{"base":"images","path":"/static/images/locandine/74a7291be78c4c0e.jpg"}},"images":[{"kind":"poster","url":{"base":"images","path":"/static/images/locandine/74a7291be78c4c0e.jpg"}},{"kind":"background","url":{"base":"images","path":"/static/images/background/3487.jpg"}},{"kind":"share","url":{"base":"images","path":"/static/images/background/3487.jpg"}}],"episodes":[{"id":"eqB8j:ep-1","number":"1","label":"1","path":"/episode/aguu-tensai-ningyou-eqB8j/ep-1","title":null,"synopsis":null,"thumbnail":null},{"id":"eqB8j:ep-2","numb