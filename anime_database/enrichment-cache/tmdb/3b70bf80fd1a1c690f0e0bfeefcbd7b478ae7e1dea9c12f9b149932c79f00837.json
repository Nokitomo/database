ww.themoviedb.org/tv/45790/season/2/episode/29"},{"id":"1183968","seasonNumber":2,"episodeNumber":30,"title":{"value":"Mariah \"Bast\": Parte 1","language":"it-IT"},"overview":{"value":"Joseph riceve una scossa toccando una strana roccia con una presa elettrica quando Jotaro e il team arrivano alla città di Luxor.","language":"it-IT"},"airDateText":{"value":"2015-02-14","language":"it-IT"},"runtimeMinutes":24,"rating":7.3,"thumbnail":"https://image.tmdb.org/t/p/w300/mKGaC0WiexoA4Jd2nUFFhFOqgHf.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/mKGaC0WiexoA4Jd2nUFFhFOqgHf.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/45790/season/2/episode/30"},{"id":"1183969","seasonNumber":2,"episodeNumber":31,"title":{"value":"Mariah \"Bast\": Parte 2","language":"it-IT"},"overview":{"value":"Joseph e Avdol vengono uniti insieme dallo Stand nemico. Quando finalmente riescono a separarsi, i loro piedi rimangono incollati sui binari di un treno.","language":"it-IT"},"airDateText":{"value":"2015-02-21","language":"it-IT"},"runtimeMinutes":24,"rating":7.6,"thumbnail":"https://image.tmdb.org/t/p/w300/uMUJQK3VKOCYa43uDJijIl5Gm9c.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/uMUJQK3VKOCYa43uDJijIl5Gm9c.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/45790/season/2/episode/31"},{"id":"1183970","seasonNumber":2,"episodeNumber":32,"title":{"value":"Alessi \"Set\": Parte 1","language":"it-IT"},"overview":{"value":"Polnareff nota improvvisamente che le sue scarpe sono di alcune taglie più grandi dopo aver dato invano la caccia a un uomo che lo stava seguendo.","language":"it-IT"},"airDateText":{"value":"2015-02-28","language":"it-IT"},"runtimeMinutes":24,"rating":6.8,"thumbnail":"https://image.tmdb.org/t/p/w300/38depNzJoAwTiPrTMcnKkiTYzmT.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/38depNzJoAwTiPrTMcnKkiTYzmT.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/45790/season/2/episode/32"},{"id":"1183971","seasonNumber":2,"episodeNumber":33,"title":{"value":"Alessi \"Set\": Parte 2","language":"it-IT"},"overview":{"value":"Polnareff deve lottare contro Alessi, un giovane portatore di un piccolo Stand. Quando la situazione si fa critica, l'uomo ricorre all'impensabile.","language":"it-IT"},"airDateText":{"value":"2015-03-07","language":"it-IT"},"runtimeMinutes":24,"rating":7.1,"thumbnail":"https://image.tmdb.org/t/p/w300/sYfWY9lmN1BDI2StfbAcCEaGNfX.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/sYfWY9lmN1BDI2StfbAcCEaGNfX.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/45790/season/2/episode/33"},{"id":"1183972","seasonNumber":2,"episodeNumber":34,"title":{"value":"D'Arby il giocatore d'azzardo: Parte 1","language":"it-IT"},"overview":{"value":"Jotaro e la sua banda arrivano al Cairo, dove incontrano un uomo in un bar che sostiene di sapere dove si trovi la casa di DIO, ma parlerà solo sotto pagamento.","language":"it-IT"},"airDateText":{"value":"2015-03-14","language":"it-IT"},"runtimeMinutes":24,"rating":7.9,"thumbnail":"https://image.tmdb.org/t/p/w300/3dfumkrWvl7i2ZU1yf1I02lY7SZ.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/3dfumkrWvl7i2ZU1yf1I02lY7SZ.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/45790/season/2/episode/34"},{"id":"1183973","seasonNumber":2,"episodeNumber":35,"title":{"value":"D'Arby il giocatore d'azzardo: Parte 2","language":"it-IT"},"overview":{"value":"Jotaro dimostra le sue abilità con lo Stand per inviare un messaggio di avvertimento a chi bara prima di una partita di poker contro D'Arby, un altro portatore di Stand.","language":"it-IT"},"airDateText":{"value":"2015-03-21","language":"it-IT"},"runtimeMinutes":24,"rating":8.2,"thumbnail":"https://image.tmdb.org/t/p/w300/AaUk3ahTeQpXd2mPXCM8wsERvpU.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/AaUk3ahTeQpXd2mPXCM8wsERvpU.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/45790/season/2/episode/35"},{"id":"1183974","seasonNumber":2,"episodeNumber":36,"title":{"value":"Hol Horse e Mondatta: Parte 1","language":"it-IT"},"overview":{"value":"Hol Horse arriva all'aeroporto del Cairo con l'ordine di uccidere Jotaro e il suo gruppo. Dentro la valigia si trova il suo nuovo riluttante partner.","language":"it-IT"},"airDateText":{"value":"2015-03-28","language":"it-IT"},"runtimeMinutes":24,"rating":6.9,"thumbnail":"https://image.tmdb.org/t/p/w300/f6Lnvajx0feVeG3AR4QlNIWFWR6.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/f6Lnvajx0feVeG3AR4QlNIWFWR6.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/45790/season/2/episode/36"},{"id":"1183975","seasonNumber":2,"episodeNumber":37,"title":{"value":"Hol Horse e Mondatta: Parte 2","language":"it-IT"},"overview":{"value":"Hol Horse agisce secondo la profezia del libro, ma inizia ad avere dubbi quando Jotaro e il resto del gruppo si presentano sul luogo.","language":"it-IT"},"airDateText":{"value":"2015-04-04","language":"it-IT"},"runtimeMinutes":24,"rating":6.5,"thumbnail":"https://image.tmdb.org/t/p/w300/kLW6AulYuSXQqJ7HdXWoSM0KRlL.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/kLW6AulYuSXQqJ7HdXWoSM0KRlL.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/45790/season/2/episode/37"},{"id":"1183976","seasonNumber":2,"episodeNumber":38,"title":{"value":"Il Guardiano degli Inferi, Pet Shop: Parte 1","language":"it-IT"},"overview":{"value":"Avdol ricerca informazioni sulla dimora di DIO al Cairo. Nel frattempo, Iggy si trova davanti due grandi cani minacciosi mentre passeggia per la città.","language":"it-IT"},"airDateText":{"value":"2015-04-11","language":"it-IT"},"runtimeMinutes":24,"rating":7.3,"thumbnail":"https://image.tmdb.org/t/p/w300/eEprs6tiQa24m3G1kPCujYXCOpG.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/eEprs6tiQa24m3G1kPCujYXCOpG.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/45790/season/2/episode/38"},{"id":"1183977","seasonNumber":2,"episodeNumber":39,"title":{"value":"Il Guardiano degli Inferi, Pet Shop: Parte 2","language":"it-IT"},"overview":{"value":"Iggy si rifugia nel fiume dopo essere stato seriamente ferito in una battaglia contro Pet Shop, il portatore dello Stand falco, ma quest'ultimo non molla.","language":"it-IT"},"airDateText":{"value":"2015-04-18","language":"it-IT"},"runtimeMinutes":24,"rating":8.1,"thumbnail":"https://image.tmdb.org/t/p/w300/olpY2DpVZ1oCX3slcbdkcYUSkvt.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/olpY2DpVZ1oCX3slcbdkcYUSkvt.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/45790/season/2/episode/39"},{"id":"1183978","seasonNumber":2,"episodeNumber":40,"title":{"value":"D'Arby il giocatore: Parte 1","language":"it-IT"},"overview":{"value":"Jotaro e il gruppo arrivano a casa di DIO e sono accolti da un maggiordomo di nome D'Arby, che sostiene di essere il fratello minore del giocatore d'azzardo.","language":"it-IT"},"airDateText":{"value":"2015-04-25","language":"it-IT"},"runtimeMinutes":24,"rating":7.3,"thumbnail":"https://image.tmdb.org/t/p/w300/9wsSFOy8dTFwCFIfdmceUderqIh.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/9wsSFOy8dTFwCFIfdmceUderqIh.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/45790/season/2/episode/40"},{"id":"1183979","seasonNumber":2,"episodeNumber":41,"title":{"value":"D'Arby il giocatore: Parte 2","language":"it-IT"},"overview":{"value":"Kakyoin perde l'anima in una corsa automobilistica contro D'Arby. Jotaro insulta Joseph quando decide di sfidare il maggiordomo a un gioco in cui quest'ultimo eccelle.","language":"it-IT"},"airDateText":{"value":"2015-05-02","language":"it-IT"},"runtimeMinutes":24,"rating":7.5,"thumbnail":"https://image.tmdb.org/t/p/w300/xBCQMVNvdMjIFCF8wFNRgGPUKtu.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/xBCQMVNvdMjIFCF8wFNRgGPUKtu.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/45790/season/2/episode/41"},{"id":"1183980","seasonNumber":2,"episodeNumber":42,"title":{"value":"Il Miasma del Vuoto, Cool Ice: Parte 1","language":"it-IT"},"overview":{"value":"Mentre D'Arby pensa che le dichiarazioni dei lanci di Jotaro siano strane, rimane fiducioso a causa del suo Stand. Altrove, Avdol e gli altri entrano nel palazzo.","language":"it-IT"},"airDateText":{"value":"2015-05-09","language":"it-IT"},"runtimeMinutes":24,"rating":8.1,"thumbnail":"https://image.tmdb.org/t/p/w300/tWmCXre18IIcYeVkVR4h2WNRLjj.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/tWmCXre18IIcYeVkVR4h2WNRLjj.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/45790/season/2/episode/42"},{"id":"1183981","seasonNumber":2,"episodeNumber":43,"title":{"value":"Il Miasma del Vuoto, Cool Ice: Parte 2","language":"it-IT"},"overview":{"value":"Polnareff e Iggy cercano di procedere velocemente ad annientare DIO, ma il terribile vampiro Vanilla Ice li sorprende alle spalle per distruggerli entrambi.","language":"it-IT"},"airDateText":{"value":"2015-05-16","language":"it-IT"},"runtimeMinutes":24,"rating":8.2,"thumbnail":"https://image.tmdb.org/t/p/w300/qOJSGnaTECGVtb5n6JdPMYW96Jz.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/qOJSGnaTECGVtb5n6JdPMYW96Jz.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/45790/season/2/episode/43"},{"id":"1183982","seasonNumber":2,"episodeNumber":44,"title":{"value":"Il Miasma del Vuoto, Cool Ice: Parte 3","language":"it-IT"},"overview":{"value":"Iggy, ferito mortalmente, raccoglie le ultime forze per salvare Polnareff. All'ultimo istante, Polnareff pugnala Vanilla Ice in testa.","language":"it-IT"},"airDateText":{"value":"2015-05-23","language":"it-IT"},"runtimeMinutes":24,"rating":8.1,"thumbnail":"https://image.tmdb.org/t/p/w300/tprc4D4pUUg1UaqlvPtFas65BkG.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/tprc4D4pUUg1UaqlvPtFas65BkG.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/45790/season/2/episode/44"},{"id":"1183983","seasonNumber":2,"episodeNumber":45,"title":{"value":"Il Mondo di Dio: Parte 1","language":"it-IT"},"overview":{"value":"Finalmente Polnareff affronta DIO, ma non riesce ad avvicinarsi per qualche strano motivo e scatena il Silver Chariot per rivelare lo Stand dell'avversario.","language":"it-IT"},"airDateText":{"value":"2015-05-30","language":"it-IT"},"runtimeMinutes":24,"rating":7.5,"thumbnail":"https://image.tmdb.org/t/p/w300/xfuKQlbOCGlKutTYMgpXvBMCAYP.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/xfuKQlbOCGlKutTYMgpXvBMCAYP.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/45790/season/2/episode/45"},{"id":"1183984","seasonNumber":2,"episodeNumber":46,"title":{"value":"Il Mondo di Dio: Parte 2","language":"it-IT"},"overview":{"value":"Kakyoin erige alcune barriere per smascherare l'identità dello Stand di DIO. Hierophant Green viene rivolto con un fuoco concentrato verso DIO, che cade in trappola.","language":"it-IT"},"airDateText":{"value":"2015-06-06","language":"it-IT"},"runtimeMinutes":24,"rating":8.2,"thumbnail":"https://image.tmdb.org/t/p/w300/qVbacHWGilpaxhNthKy3LhVpQoD.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/qVbacHWGilpaxhNthKy3LhVpQoD.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/45790/season/2/episode/46"},{"id":"1183985","seasonNumber":2,"episodeNumber":47,"title":{"value":"Il Mondo di Dio: Parte 3","language":"it-IT"},"overview":{"value":"DIO usa l'abilità del suo Stand per fermare il tempo. Prima di sferrare il colpo di grazia, nota che le dita di Jotaro si muovono nonostante siano immobilizzate.","language":"it-IT"},"airDateText":{"value":"2015-06-13","language":"it-IT"},"runtimeMinutes":24,"rating":8.1,"thumbnail":"https://image.tmdb.org/t/p/w300/2ldoWtudAIZSaXXE7ljMMfQMqvr.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/2ldoWtudAIZSaXXE7ljMMfQMqvr.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/45790/season/2/episode/47"},{"id":"1183986","seasonNumber":2,"episodeNumber":48,"title":{"value":"È stato un lungo viaggio, addio, amici miei","language":"it-IT"},"overview":{"value":"DIO si trova davanti al corpo senza vita di Joseph. Un furioso Jotaro affronta DIO, completamente guarito, per una battaglia finale in un mondo in cui il tempo è fermo.","language":"it-IT"},"airDateText":{"value":"2015-06-20","language":"it-IT"},"runtimeMinutes":24,"rating":8.3,"thumbnail":"https://image.tmdb.org/t/p/w300/lyvqtdd0vrOoagRgKSDW5DEvJnz.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/lyvqtdd0vrOoagRgKSDW5DEvJnz.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/45790/season/2/episode/48"}],"sourceUrl":"https://www.themoviedb.org/tv/45790/season/2"},"fields":{},"episodes":{"1":{"checkedAt":1793317482883,"status":"ok"},"2":{"checkedAt":1793317482883,"status":"ok"},"3":{"checkedAt":1793317482883,"status":"ok"},"4":{"checkedAt":1793317482883,"status":"ok"},"5":{"checkedAt":1793317482883,"status":"ok"},"6":{"checkedAt":1793317482883,"status":"ok"},"7":{"checkedAt":1793317482883,"status":"ok"},"8":{"checkedAt":1793317482883,"status":"ok"},"9":{"checkedAt":1793317482883,"status":"ok"},"10":{"checkedAt":1793317482883,"status":"ok"},"11":{"checkedAt":1793317482883,"status":"ok"},"12":{"checkedAt":1793317482883,"status":"ok"},"13":{"checkedAt":1793317482883,"status":"ok"},"14":{"checkedAt":1793317482883,"status":"ok"},"15":{"checkedAt":1793317482883,"status":"ok"},"16":{"checkedAt":1793317482883,"status":"ok"},"17":{"checkedAt":1793317482883,"status":"ok"},"18":{"checkedAt":1793317482883,"status":"ok"},"19":{"checkedAt":1793317482883,"status":"ok"},"20":{"checkedAt":1793317482883,"status":"ok"},"21":{"checkedAt":1793317482883,"status":"ok"},"22