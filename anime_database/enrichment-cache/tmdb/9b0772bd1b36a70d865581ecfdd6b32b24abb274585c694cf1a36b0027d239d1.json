dX2bghreyfb4kd.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/216272/season/1/episode/5"},{"id":"5258110","seasonNumber":1,"episodeNumber":6,"title":{"value":"Com'è nato l'abisso","language":"it-IT"},"overview":{"value":"Tinasha riesce finalmente a spezzare la maledizione, adempiendo così al suo contratto con Oscar. Nel bel mezzo dei festeggiamenti per il compleanno del re, la strega si presenta a Oscar con una rivelazione scioccante.","language":"it-IT"},"airDateText":{"value":"2024-05-14","language":"it-IT"},"runtimeMinutes":24,"rating":7.6,"thumbnail":"https://image.tmdb.org/t/p/w300/aKTewR6bs4mUSwHlILT64SOxlPM.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/aKTewR6bs4mUSwHlILT64SOxlPM.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/216272/season/1/episode/6"},{"id":"5258111","seasonNumber":1,"episodeNumber":7,"title":{"value":"La fine del sogno","language":"it-IT"},"overview":{"value":"Tinasha abbandona Farsas per schierarsi con il regno di Cuscull al fianco di Lanak. Tuttavia, c'è qualcosa nelle sue azioni che non torna, un dettaglio che non sfugge all'occhio vigile del capo dei maghi di Cuscull.","language":"it-IT"},"airDateText":{"value":"2024-05-21","language":"it-IT"},"runtimeMinutes":24,"rating":6.9,"thumbnail":"https://image.tmdb.org/t/p/w300/fRaFMvZOZ9YCcCd6BZ2baAE24ut.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/fRaFMvZOZ9YCcCd6BZ2baAE24ut.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/216272/season/1/episode/7"},{"id":"5258112","seasonNumber":1,"episodeNumber":8,"title":{"value":"Rampicanti verdi","language":"it-IT"},"overview":{"value":"Durante una visita a una fortezza al confine di Farsas, Oscar si imbatte in una banda di nomadi dediti al saccheggio. Il loro capo sfida Oscar a duello su un terreno sacro che nasconde un oscuro segreto.","language":"it-IT"},"airDateText":{"value":"2024-05-28","language":"it-IT"},"runtimeMinutes":24,"rating":6.5,"thumbnail":"https://image.tmdb.org/t/p/w300/hgRSIewmkZfrr3qXLh4YCDYT4jr.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/hgRSIewmkZfrr3qXLh4YCDYT4jr.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/216272/season/1/episode/8"},{"id":"5258113","seasonNumber":1,"episodeNumber":9,"title":{"value":"Ciò che non si comprende","language":"it-IT"},"overview":{"value":"Il regno di Farsas si gode un meritato periodo di pace mentre si avvicina la fine dell'anno. Sotto questa apparente tranquillità, tuttavia, si sta tramando un complotto che ha come obiettivo proprio il castello di Farsas.","language":"it-IT"},"airDateText":{"value":"2024-06-04","language":"it-IT"},"runtimeMinutes":24,"rating":5.8,"thumbnail":"https://image.tmdb.org/t/p/w300/7jjodA6biA9AkTPBlwtyUbTP6XK.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/7jjodA6biA9AkTPBlwtyUbTP6XK.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/216272/season/1/episode/9"},{"id":"5258114","seasonNumber":1,"episodeNumber":10,"title":{"value":"I bambini vuoti","language":"it-IT"},"overview":{"value":"Tinasha scopre che la sua torre ha ricevuto degli ospiti inaspettati. Nel frattempo, Oscar si prepara con riluttanza a partecipare a un evento pubblico nella nazione confinante di Gandona.","language":"it-IT"},"airDateText":{"value":"2024-06-11","language":"it-IT"},"runtimeMinutes":24,"rating":5.6,"thumbnail":"https://image.tmdb.org/t/p/w300/2xi4GSgD9Gh0zEuyA3MwLCcbypN.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/2xi4GSgD9Gh0zEuyA3MwLCcbypN.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/216272/season/1/episode/10"},{"id":"5258116","seasonNumber":1,"episodeNumber":11,"title":{"value":"Castello di sabbia","language":"it-IT"},"overview":{"value":"Oscar e Tinasha si avventurano a Yarda per ritrovare la principessa scomparsa e porre fine al crescente conflitto civile orchestrato dalla \"Strega che non può ess