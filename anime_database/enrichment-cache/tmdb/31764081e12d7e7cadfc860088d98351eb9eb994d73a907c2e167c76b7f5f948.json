{"schemaVersion":1,"source":"tmdb","kind":"episodes","input":{"mediaId":233523,"seasonNumber":1},"checkedAt":1793375535552,"status":"ok","value":{"seasonNumber":1,"name":{"value":"Stagione 1","language":"it-IT"},"year":2024,"episodeCount":12,"poster":"https://image.tmdb.org/t/p/original/rSa7okte1krxHCzNvUplUPY2yH1.jpg","posters":[],"backgrounds":[],"episodes":[{"id":"5415870","seasonNumber":1,"episodeNumber":1,"title":{"value":"Episodio 1","language":"it-IT"},"overview":{"value":"Dahlia Rossetti lives in a world of magic. While she's still very young, her father shows her a beautiful magic device which inspires her to become a magic artificer just like him. One day, she tries to build a device on her own, but...","language":"en-US"},"airDateText":{"value":"2024-07-06","language":"it-IT"},"runtimeMinutes":24,"rating":7.2,"thumbnail":"https://image.tmdb.org/t/p/w300/fNJllFFpyCMzXq8fnGqlJW54TxU.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/fNJllFFpyCMzXq8fnGqlJW54TxU.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/233523/season/1/episode/1"},{"id":"5457118","seasonNumber":1,"episodeNumber":2,"title":{"value":"Episodio 2","language":"it-IT"},"overview":{"value":"Dahlia is inspired to develop a raincoat when she sees her father's coat soaked with rain. She persists through rounds of trial and error with the assistance of her fellow apprentice, Tobias. Her finished work leads to unexpected outcomes.","language":"en-US"},"airDateText":{"value":"2024-07-13","language":"it-IT"},"runtimeMinutes":24,"rating":7.7,"thumbnail":"https://image.tmdb.org/t/p/w300/in3rIDO3QWCe6qtEJgZb4CWv9pw.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/in3rIDO3QWCe6qtEJgZb4CWv9pw.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/233523/season/1/episode/2"},{"id":"5457119","seasonNumber":1,"episodeNumber":3,"title":{"value":"Episodio 3","language":"it-IT"},"overview":{"value":"A year has passed since tragedy struck Dahlia's life. Now she's been hit by a confession from Tobias that changes everything. As Dahlia sorts through her memories, she decides that this time she'll live her life as she pleases.","language":"en-US"},"airDateText":{"value":"2024-07-20","language":"it-IT"},"runtimeMinutes":24,"rating":8,"thumbnail":"https://image.tmdb.org/t/p/w300/ajgeYieJwSp8hEQVntGQN0qPUd5.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/ajgeYieJwSp8hEQVntGQN0qPUd5.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/233523/season/1/episode/3"},{"id":"5457120","seasonNumber":1,"episodeNumber":4,"title":{"value":"Episodio 4","language":"it-IT"},"overview":{"value":"While out in the forest, Dahlia helps a gravely wounded knight named Wolf. He tries to repay her kindness, but she declines. Meanwhile, the Trade Guild discovers an irregularity in a contract with Tobias, and Dahlia is at the center of the issue.","language":"en-US"},"airDateText":{"value":"2024-07-27","language":"it-IT"},"runtimeMinutes":24,"rating":7.7,"thumbnail":"https://image.tmdb.org/t/p/w300/h79Lhy401uiDYfoK3XeCq1Nm8b3.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/h79Lhy401uiDYfoK3XeCq1Nm8b3.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/233523/season/1/episode/4"},{"id":"5457121","seasonNumber":1,"episodeNumber":5,"title":{"value":"Episodio 5","language":"it-IT"},"overview":{"value":"After having her eyesight healed, Dahlia stops by a café. As she waits for a server, she notices a flurry of activity. She looks up to find Wolf walking straight toward her! Later, she visits a magic device shop and learns something surprising.","language":"en-US"},"airDateText":{"value":"2024-08-03","language":"it-IT"},"runtimeMinutes":24,"rating":7,"thumbnail":"https://image.tmdb.org/t/p/w300/6uLeJvHkuzvh1cMxLJbypI9Q4lL.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/6uLeJvHkuzvh1cMxLJbypI9Q4lL.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/233523/season/1/episode/5"},{"id":"5457122","seasonNumber":1,"episodeNumber":6,"title":{"value":"Episodio 6","language":"it-IT"},"overview":{"value":"After their trip to the magic device shop, Dahlia invites Wolf over for dinner. They get along so well as friends that Wolf confides in Dahlia, telling her his long held worries. Wanting to help, she comes up with an idea involving fairy crystal.","language":"en-US"},"airDateText":{"value":"2024-08-10","language":"it-IT"},"runtimeMinutes":24,"rating":6.5,"thumbnail":"https://image.tmdb.org/t/p/w300/c9T57LZ092xhWtX4TNpiAx0eEZT.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/c9T57LZ092xhWtX4TNpiAx0eEZT.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/233523/season/1/episode/6"},{"id":"5457123","seasonNumber":1,"episodeNumber":7,"title":{"value":"Episodio 7","language":"it-IT"},"overview":{"value":"Dahlia and Wolf are excited by the idea of making a magic sword, but then Wolf has to deploy on a campaign. He completes his duties quickly and returns earlier than expected. Soon, they have their first prototype, but its seems a little... ominous.","language":"en-US"},"airDateText":{"value":"2024-08-17","language":"it-IT"},"runtimeMinutes":24,"rating":7,"thumbnail":"https://image.tmdb.org/t/p/w300/8TZ2av7Wd78ZXRqO3xuLGQr8w1A.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/8TZ2av7Wd78ZXRqO3xuLGQr8w1A.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/233523/season/1/episode/7"},{"id":"5457124","seasonNumber":1,"episodeNumber":8,"title":{"value":"Episodio 8","language":"it-IT"},"overview":{"value":"Thanks to Wolf's help, Dahlia is seeing rather unexpected success with a rather unexpected product. And a massive order has her scrambling to figure out how to make it all happen with her fledgling company.","language":"en-US"},"airDateText":{"value":"2024-08-24","language":"it-IT"},"runtimeMinutes":24,"rating":6.5,"thumbnail":"https://image.tmdb.org/t/p/w300/vnp4l3YxC5W9R7x9a2hNHulOGhp.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/vnp4l3YxC5W9R7x9a2hNHulOGhp.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/233523/season/1/episode/8"},{"id":"5457125","seasonNumber":1,"episodeNumber":9,"title":{"value":"Episodio 9","language":"it-IT"},"overview":{"value":"Wolf goes to inform his family of his recent foray into business. He's met by Guido, his older brother, who he's hardly spoken to since a fateful day years ago. Meanwhile, Dahlia asks a local artisan to help her improve one of her inventions.","language":"en-US"},"airDateText":{"value":"2024-08-31","language":"it-IT"},"runtimeMinutes":24,"rating":7,"thumbnail":"https://image.tmdb.org/t/p/w300/eekc6yNhcm8Q2UacDs11q3HavEH.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/eekc6yNhcm8Q2UacDs11q3HavEH.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/233523/season/1/episode/9"},{"id":"5457126","seasonNumber":1,"episodeNumber":10,"title":{"value":"Episodio 10","language":"it-IT"},"overview":{"value":"Wolf is intrigued by a bracelet Dahlia has imbued with wind magic. As they spend time eating and chatting, Dahlia is inspired to make a new magic device based on Wolf's stories. The next day, when she visits the Trade Guild, a letter arrives for her.","language":"en-US"},"airDateText":{"value":"2024-09-07","language":"it-IT"},"runtimeMinutes":24,"rating":6.5,"thumbnail":"https://image.tmdb.org/t/p/w300/5EozTP44mhkE5gfJfcVdYxY1lR4.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/5EozTP44mhkE5gfJfcVdYxY1lR4.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/233523/season/1/episode/10"},{"id":"5457127","seasonNumber":1,"episodeNumber":11,"title":{"value":"Episodio 11","language":"it-IT"},"overview":{"value":"An invitation to the palace has Dahlia nervous, but meeting Wolf's captain puts her at ease... until talk of foot fungus grows overly heated. Later, Wolf and Dahlia drink together and play a game of revealing secrets they can't share anywhere else.","language":"en-US"},"airDateText":{"value":"2024-09-14","language":"it-IT"},"runtimeMinutes":24,"rating":6.5,"thumbnail":"https://image.tmdb.org/t/p/w300/6vMEr4jqB4ZoVcFXhrHcYrgS7eW.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/6vMEr4jqB4ZoVcFXhrHcYrgS7eW.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/233523/season/1/episode/11"},{"id":"5457128","seasonNumber":1,"episodeNumber":12,"title":{"value":"Episodio 12","language":"it-IT"},"overview":{"value":"Dahlia and Wolf work on creating a magic sword for the first time in a while. An experiment with a mirror snake's scale goes awry, leaving them with questions about the future. Later, they go to the cemetery together and each visit their parents' graves.","language":"en-US"},"airDateText":{"value":"2024-09-21","language":"it-IT"},"runtimeMinutes":24,"rating":6.5,"thumbnail":"https://image.tmdb.org/t/p/w300/ailE2u234lDXdFQu2W6ViJxFWGf.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/ailE2u234lDXdFQu2W6ViJxFWGf.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/233523/season/1/episode/12"}],"sourceUrl":"https://www.themoviedb.org/tv/233523/season/1"},"fields":{},"episodes":{"1":{"checkedAt":1793375535552,"status":"ok"},"2":{"checkedAt":1793375535552,"status":"ok"},"3":{"checkedAt":1793375535552,"status":"ok"},"4":{"checkedAt":1793375535552,"status":"ok"},"5":{"checkedAt":1793375535552,"status":"ok"},"6":{"checkedAt":1793375535552,"status":"ok"},"7":{"checkedAt":1793375535552,"status":"ok"},"8":{"checkedAt":1793375535552,"status":"ok"},"9":{"checkedAt":1793375535552,"status":"ok"},"10":{"checkedAt":1793375535552,"status":"ok"},"11":{"checkedAt":1793375535552,"status":"ok"},"12":{"checkedAt":1793375535552,"status":"ok"}}}
