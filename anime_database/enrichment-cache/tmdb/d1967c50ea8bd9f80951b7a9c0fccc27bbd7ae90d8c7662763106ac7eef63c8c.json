iNQCELnVYH.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/156688/season/1/episode/14"},{"id":"5076153","seasonNumber":1,"episodeNumber":15,"title":{"value":"Episodio 15","language":"it-IT"},"overview":{"value":"While following secret tunnels toward the palace, Touko and Koushi suddenly find themselves in the middle of the dark forest. They still have a letter to deliver, but the divine clans won't make the journey easy.","language":"en-US"},"airDateText":{"value":"2024-02-11","language":"it-IT"},"runtimeMinutes":24,"rating":7,"thumbnail":"https://image.tmdb.org/t/p/w300/nS3Zu6nTkiAcTf8G0NsVNgekrmC.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/nS3Zu6nTkiAcTf8G0NsVNgekrmC.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/156688/season/1/episode/15"},{"id":"5076156","seasonNumber":1,"episodeNumber":16,"title":{"value":"Episodio 16","language":"it-IT"},"overview":{"value":"Koushi finally reunites with Hinako. They set out for the palace, but their path brings them face to face with the last of the capital's treefolk. Meanwhile, Touko and Akira encounter a familiar face of their own.","language":"en-US"},"airDateText":{"value":"2024-02-18","language":"it-IT"},"runtimeMinutes":24,"rating":7.5,"thumbnail":"https://image.tmdb.org/t/p/w300/jufr2Ah7RsT3vCFsTHJiFi56fTL.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/jufr2Ah7RsT3vCFsTHJiFi56fTL.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/156688/season/1/episode/16"},{"id":"5076157","seasonNumber":1,"episodeNumber":17,"title":{"value":"Episodio 17","language":"it-IT"},"overview":{"value":"Takimi confronts Koushi on the palace steps. The medically minded god insists that only his medicine can save Hinako, but Koushi refuses to let his sister suffer any more experiments. As tensions mount, Kira appears—seeming not quite herself.","language":"en-US"},"airDateText":{"value":"2024-02-25","language":"it-IT"},"runtimeMinutes":