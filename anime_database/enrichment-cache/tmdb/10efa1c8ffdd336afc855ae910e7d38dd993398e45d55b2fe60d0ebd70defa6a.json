/hCnv7EZPj4c8CGsmUQrNUfc4BzS.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/hCnv7EZPj4c8CGsmUQrNUfc4BzS.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/23022/season/1/episode/8"},{"id":"618720","seasonNumber":1,"episodeNumber":9,"title":{"value":"Il castello di cristalli","language":"it-IT"},"overview":{"value":"While exploring a forest that has become a desert, Astro Boy discovers that Atlas is involved.","language":"en-US"},"airDateText":{"value":"1980-11-26","language":"it-IT"},"runtimeMinutes":24,"thumbnail":"https://image.tmdb.org/t/p/w300/mZDQ47bVYlphbgE5kZONYnZMlig.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/mZDQ47bVYlphbgE5kZONYnZMlig.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/23022/season/1/episode/9"},{"id":"618723","seasonNumber":1,"episodeNumber":10,"title":{"value":"La corsa intorno all'equatore","language":"it-IT"},"overview":{"value":"Astro aids a championship racer who hopes to win a global race.","language":"en-US"},"airDateText":{"value":"1980-12-03","language":"it-IT"},"runtimeMinutes":24,"thumbnail":"https://image.tmdb.org/t/p/w300/cZvSmlgJI1bDgIbj15ZQKPVTIlJ.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/cZvSmlgJI1bDgIbj15ZQKPVTIlJ.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/23022/season/1/episode/10"},{"id":"618725","seasonNumber":1,"episodeNumber":11,"title":{"value":"Il robot presidente","language":"it-IT"},"overview":{"value":"Astro and his teacher, Daddy Walrus, are invited to the inauguration of the first robot president and are caught up in a plan to stop the ceremony.","language":"en-US"},"airDateText":{"value":"1980-12-10","language":"it-IT"},"runtimeMinutes":24,"thumbnail":"https://image.tmdb.org/t/p/w300/1H1Zoo4CU6FbDl1CdDCbWjHNr6y.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/1H1Zoo4CU6FbDl1CdDCbWjHNr6y.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.