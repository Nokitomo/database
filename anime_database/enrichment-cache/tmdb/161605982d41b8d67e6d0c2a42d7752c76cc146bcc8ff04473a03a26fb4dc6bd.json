ype":"still","url":"https://image.tmdb.org/t/p/original/sW9Odg4or7BUbMwRrQLOzd1FErN.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/3570/season/5/episode/26"},{"id":"992567","seasonNumber":5,"episodeNumber":27,"title":{"value":"La festa della scuola","language":"it-IT"},"overview":{"value":"Usagi and her classmates are all busy preparing for the upcoming Juban School Festival. Meanwhile, Sailor Lead Crow finds a note left behind by her deceased friend Sailor Aluminum Siren that contains information on Sailor Moon's true identity.","language":"en-US"},"airDateText":{"value":"1996-11-30","language":"it-IT"},"runtimeMinutes":24,"rating":7,"thumbnail":"https://image.tmdb.org/t/p/w300/ktjcRgx9Qjpq1xkO0FMXRgrRckx.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/ktjcRgx9Qjpq1xkO0FMXRgrRckx.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/3570/season/5/episode/27"},{"id":"992568","seasonNumber":5,"episodeNumber":28,"title":{"value":"La principessa","language":"it-IT"},"overview":{"value":"Princess Kakyu, the missing princess whom the Star Lights have long been searching for, finally appears before the Sailor Guardians. Princess Kakyu explains that she has come to Earth in search of the Light of Hope.","language":"en-US"},"airDateText":{"value":"1996-12-07","language":"it-IT"},"runtimeMinutes":24,"rating":7.2,"thumbnail":"https://image.tmdb.org/t/p/w300/wzJX577KLaF6DU8p31D9RD2DhhW.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/wzJX577KLaF6DU8p31D9RD2DhhW.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/3570/season/5/episode/28"},{"id":"992569","seasonNumber":5,"episodeNumber":29,"title":{"value":"I Three Lights si sciolgono","language":"it-IT"},"overview":{"value":"Usagi finally confesses to Rei that she has been unable to get in touch with Mamoru for the past several months. Meanwhile, the Three Lights publicly announce their intention to disband their group.","language":"en-US"},"airDateText":{"value":"1996-12-14","language":"it-IT"},"runtimeMinutes":24,"rating":7.2,"thumbnail":"https://image.tmdb.org/t/p/w300/mrepuwnt4t56P3ZYmcx1UA4Q6OU.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/mrepuwnt4t56P3ZYmcx1UA4Q6OU.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/3570/season/5/episode/29"},{"id":"992570","seasonNumber":5,"episodeNumber":30,"title":{"value":"I semi di stella","language":"it-IT"},"overview":{"value":"Princess Kakyu perishes after being defeated by Galaxia. Devastated, the Sailor Star Lights go after Galaxia to avenge their fallen princess. Meanwhile, Sailor Moon and the rest of the Guardians also prepare for their battle to protect the galaxy.","language":"en-US"},"airDateText":{"value":"1997-01-11","language":"it-IT"},"runtimeMinutes":24,"rating":7.2,"thumbnail":"https://image.tmdb.org/t/p/w300/99AQwb7r2pgtFigRkGR9d9DHsfg.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/99AQwb7r2pgtFigRkGR9d9DHsfg.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/3570/season/5/episode/30"},{"id":"992602","seasonNumber":5,"episodeNumber":31,"title":{"value":"Quando la luna non splende","language":"it-IT"},"overview":{"value":"Sailor Mars, Mercury, Jupiter, and Venus lose their star seeds after shielding Sailor Moon and the Star Lights from Galaxia's attack. The four Outer Guardians entrust Sailor Moon to the Star Lights while they try to stop Galaxia.","language":"en-US"},"airDateText":{"value":"1997-01-18","language":"it-IT"},"runtimeMinutes":24,"rating":7.2,"thumbnail":"https://image.tmdb.org/t/p/w300/grQc1Z6RqGQVTP43CR94tzm1aAS.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/grQc1Z6RqGQVTP43CR94tzm1aAS.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/3570/season/5/episode/31"},{"id":"992601","seasonNumber":5,"episodeNumber":32,"title":{"value":"La guerriera leggendaria","language":"it-IT"},"overview":{"value":"Uranus and Neptune have turned against the Sailor Guardians by swearing allegiance to Galaxia. Despite Sailor Moon's desperate plea, the two continue their attack, forcing Sailor Moon and the Star Lights to retreat.","language":"en-US"},"airDateText":{"value":"1997-01-25","language":"it-IT"},"runtimeMinutes":24,"rating":7.2,"thumbnail":"https://image.tmdb.org/t/p/w300/i3KlGzjuJCjVhDHIcU17bRaWoVP.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/i3KlGzjuJCjVhDHIcU17bRaWoVP.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/3570/season/5/episode/32"},{"id":"992603","seasonNumber":5,"episodeNumber":33,"title":{"value":"Il raggio di speranza","language":"it-IT"},"overview":{"value":"Galaxia is revealed to be the Legendary Sailor Guardian who sealed away Chaos long ago. However, she has since become corrupt and has gone to conquer the galaxy herself.","language":"en-US"},"airDateText":{"value":"1997-02-01","language":"it-IT"},"runtimeMinutes":24,"rating":7.2,"thumbnail":"https://image.tmdb.org/t/p/w300/6nuUfPyCd4v5Bqt31p4aIVO1n6.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/6nuUfPyCd4v5Bqt31p4aIVO1n6.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/3570/season/5/episode/33"},{"id":"992604","seasonNumber":5,"episodeNumber":34,"title":{"value":"Sailor Moon e il trionfo delle stelle","language":"it-IT"},"overview":{"value":"As Galaxia closes in to take Sailor Moon's star seed, the Light of Hope finally reveals itself. Turning into a sword, the Light of Hope begs Usagi to use its power to stop Galaxia, who is now fully consumed by Chaos.","language":"en-US"},"airDateText":{"value":"1997-02-08","language":"it-IT"},"runtimeMinutes":24,"rating":7.2,"thumbnail":"https://image.tmdb.org/t/p/w300/19uoQtfAXus2rO2a2HyTfdRGAIu.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/19uoQtfAXus2rO2a2HyTfdRGAIu.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/3570/sea