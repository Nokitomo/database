db.org/t/p/original/40X3P3yJ3niKgvkIo4uaCWeYfkC.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/3570/season/2/episode/30"},{"id":"992376","seasonNumber":2,"episodeNumber":31,"title":{"value":"L'amore rinasce","language":"it-IT"},"overview":{"value":"While Esmeraude targets the latest craze, promise rings, Usagi has a dream that may explain why Mamoru has been acting coldly towards her.","language":"en-US"},"airDateText":{"value":"1993-12-10","language":"it-IT"},"runtimeMinutes":24,"rating":6.5,"thumbnail":"https://image.tmdb.org/t/p/w300/pCNhWNJVWXXlN3DTWjqOG4ofTJL.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/pCNhWNJVWXXlN3DTWjqOG4ofTJL.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/3570/season/2/episode/31"},{"id":"992389","seasonNumber":2,"episodeNumber":32,"title":{"value":"L'influenza","language":"it-IT"},"overview":{"value":"Esmeraude releases a virulent strain of influenza into Tokyo, and only Minako and Chibi-Usa seem unaffected.","language":"en-US"},"airDateText":{"value":"1993-12-17","language":"it-IT"},"runtimeMinutes":24,"rating":6.8,"thumbnail":"https://image.tmdb.org/t/p/w300/6ZNW8w3y2f5uKJp8ADWMhadwKQM.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/6ZNW8w3y2f5uKJp8ADWMhadwKQM.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/3570/season/2/episode/32"},{"id":"992378","seasonNumber":2,"episodeNumber":33,"title":{"value":"Le avventure di Artemis","language":"it-IT"},"overview":{"value":"After Luna wounds his pride one too many times, Artemis sets out on a mission to prove his worth, and stumbles upon Esmeraude's latest plot.","language":"en-US"},"airDateText":{"value":"1993-12-24","language":"it-IT"},"runtimeMinutes":24,"rating":6.5,"thumbnail":"https://image.tmdb.org/t/p/w300/3qTUjiJo8GNhxXR7WfzklqNMObN.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/3qTUjiJo8GNhxXR7WfzklqNMObN.jpg","language":"xx"}],"sourceUrl":"https://