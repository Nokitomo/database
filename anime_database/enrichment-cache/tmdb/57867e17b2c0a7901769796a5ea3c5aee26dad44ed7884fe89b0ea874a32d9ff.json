Oju54g2Ju5RhmbRskzxKVw.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/32377/season/0/episode/29"},{"id":"2031350","seasonNumber":0,"episodeNumber":30,"title":{"value":"Episodio 30","language":"it-IT"},"overview":{"value":"Chirico and Shako find themselves deep beneath the surface and in the company of a mysterious girl who warns them about the Doyo.","language":"en-US"},"airDateText":{"value":"2010-09-24","language":"it-IT"},"runtimeMinutes":30,"thumbnail":"https://image.tmdb.org/t/p/w300/dB4X3gxc594sWKQUtTBpIW5AQOa.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/dB4X3gxc594sWKQUtTBpIW5AQOa.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/32377/season/0/episode/30"},{"id":"2031351","seasonNumber":0,"episodeNumber":31,"title":{"value":"Episodio 31","language":"it-IT"},"overview":{"value":"Forces converge above the planet. Chirico soldiers on, determined to rescue the child entrusted to him, and once again faces an important choice.","language":"en-US"},"airDateText":{"value":"2010-10-27","language":"it-IT"},"runtimeMinutes":30,"thumbnail":"https://image.tmdb.org/t/p/w300/vfoAAKpcmD2RknccjGPc7jwCtVC.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/vfoAAKpcmD2RknccjGPc7jwCtVC.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/32377/season/0/episode/31"},{"id":"4550959","seasonNumber":0,"episodeNumber":32,"title":{"value":"Episodio 32","language":"it-IT"},"overview":{"value":"整備工場をしながら、裏では「ザ・ダーク」の名で負け役専門のバトリングファイターをしていたアービン・レスター。彼とのバトリングで手加減をされた事に憤るペイガンはアービンに固執する。一方、アービンの資質を見抜いたイシュルーナは強引な手口でアービンを手に入れようとするが、ペイガンとのバトリングの再戦は最悪の暴走を招いてしまう。","language":"ja-JP"},"airDateText":{"value":"2010-12-04","language":"it-IT"},"runtimeMinutes":50,"thumbnail":"https://image.tmdb.org/t/p/w300/8jS2hDa3Gi6pRMxrEcrEc4HO9ms.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/8jS2hDa3Gi6pRMxrEcrEc4HO9ms.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/32377/season/0/episode/32"},{"id":"765788","seasonNumber":0,"episodeNumber":33,"title":{"value":"Episodio 33","language":"it-IT"},"overview":{"value":"Chirico meets up with Gotho and friends at an oasis town for the first time in over 30 years.","language":"en-US"},"airDateText":{"value":"2011-01-08","language":"it-IT"},"runtimeMinutes":50,"thumbnail":"https://image.tmdb.org/t/p/w300/7V06a9e9hdddW6vqyIbqRpl3PEr.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/7V06a9e9hdddW6vqyIbqRpl3PEr.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/32377/season/0/episode/33"},{"id":"7111185","seasonNumber":0,"episodeNumber":34,"title":{"value":"Episodio 34","language":"it-IT"},"overview":{"value":"遥かに深い崖の底にある世界。\"ボトムズ\"。そこに、崖の上にあるという世界\"トプ\"へと想いを馳せる青年アキ・テスノ。持ち前のAt（アルトロ）操縦技術からタンブラー（軽業師）と呼ばれている。その彼に突然トプから、ディアハルトという男によってボトムズの地に誘拐された少女を助けて欲しい、との依頼が舞い込んでくる。相棒のエイビィと\"島\"と呼ばれる廃墟へ向かい、ディアハルトのAtと対峙する。そして無事に少女の救出に成功！と思いきや、事態は予想外の方向へ…!?","language":"ja-JP"},"airDateText":{"value":"2011-04-07","language":"it-IT"},"runtimeMinutes":39,"stills":[],"sourceUrl":"https://www.themoviedb.org/tv/32377/season/0/episode/34"},{"id":"7111189","seasonNumber":0,"episodeNumber":35,"title":{"value":"Episodio 35","language":"it-IT"},"overview":{"value":"「装甲騎兵ボトムズ」全52話のストーリーから、キリコ、フィアナ、イプシロンという3人のPS（パーフェクト・ソルジャー）の軌跡をたどった総集編。生まれながらのPSであるキリコと、軍のPS計画により誕生したフィアナとイプシロンは、数奇な運命に導かれてめぐりあう。その先にキリコを待つ「神」の存在とは？","language":"ja-JP"},"airDateText":{"value":"1985-06-21","language":"it-IT"},"runtimeMinutes":55,"stills":[],"sourceUrl":"https://www.themoviedb.org/tv/32377/season/0/episode/35"},{"id":"7111212","seasonNumber":0,"episodeNumber":36,"title":{"value":"Episodio 36","language":"it-IT"},"overview":{"value":"TVシリーズ予告編集やロッチナの回顧録、主題歌・挿入歌のロングバージョンなどを収録した、ボトムズファンのためのOVA。「来週もキリコと地獄に付き合ってもらう」にはじまる予告編の数々は、今でも聴きごたえ十分。その他、再アフレコによるステレオ音声など、ボトムズファン納得の充実ぶりだ。","language":"ja-JP"},"airDateText":{"value":"1985-07-20","language":"it-IT"},"runtimeMinutes":57,"stills":[],"sourceUrl":"https://www.themoviedb.org/tv/32377/season/0/episode/36"}],"sourceUrl":"https://www.themoviedb.org/tv/32377/season/0"},"fields":{},"episodes":{"1":{"checkedAt":1793321616100,"status":"ok"},"2":{"checkedAt":1793323299580,"status":"ok"},"6":{"checkedAt":1793321635837,"status":"ok"},"7":{"checkedAt":1793321633379,"status":"ok"}}}
