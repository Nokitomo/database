":"it-IT"},"runtimeMinutes":23,"rating":7.7,"thumbnail":"https://image.tmdb.org/t/p/w300/hf6uOCqHs1CAKn3u8CwfCDSUDlB.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/hf6uOCqHs1CAKn3u8CwfCDSUDlB.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/156013/season/1/episode/8"},{"id":"4159425","seasonNumber":1,"episodeNumber":9,"title":{"value":"Episodio 9","language":"it-IT"},"overview":{"value":"Just before the start of the war between Atland and Valghia, Kaina and his friends race to get proof of a great tree that can save everyone, including their enemies.","language":"en-US"},"airDateText":{"value":"2023-03-09","language":"it-IT"},"runtimeMinutes":23,"rating":8.3,"thumbnail":"https://image.tmdb.org/t/p/w300/4Egy5PDdXvVytnGgrh4TR1r1iiy.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/4Egy5PDdXvVytnGgrh4TR1r1iiy.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/156013/season/1/episode/9"},{"id":"4159427","seasonNumber":1,"episodeNumber":10,"title":{"value":"Episodio 10","language":"it-IT"},"overview":{"value":"Valghia have a fearsome weapon, a relic from the Age of the Sage, which they have activated. How will Atland be able to fight back, now cornered?","language":"en-US"},"airDateText":{"value":"2023-03-16","language":"it-IT"},"runtimeMinutes":23,"rating":7,"thumbnail":"https://image.tmdb.org/t/p/w300/fe0LrpT6yIplbXW1aJeUYRGMh7e.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/fe0LrpT6yIplbXW1aJeUYRGMh7e.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/156013/season/1/episode/10"},{"id":"4159428","seasonNumber":1,"episodeNumber":11,"title":{"value":"Episodio 11","language":"it-IT"},"overview":{"value":"Drunk on power, the Admiral continues to operate the Builder and is determined to kill the King. Ririha tries to save her father, which results in making herself the Admiral's target. Will Kaina make it in time to save Ririha?","language":"en-US"},