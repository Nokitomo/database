fiSr9z3nlD.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/1r1w2YPTg5EsD4PtzfiSr9z3nlD.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/306721/season/1/episode/19"},{"id":"7141879","seasonNumber":1,"episodeNumber":20,"title":{"value":"Episodio 20","language":"it-IT"},"overview":{"value":"A desperate letter arrives at the CUREtto Detective Agency: \"The island could disappear!\" Leading Anna and Mikuru to take a boat to the isolated island. To solve the case, they must unravel the secret behind an old island song.","language":"en-US"},"airDateText":{"value":"2026-06-14","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/lLWJujofC67fHYMDMeaN3EvDDlY.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/lLWJujofC67fHYMDMeaN3EvDDlY.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/306721/season/1/episode/20"},{"id":"7141883","seasonNumber":1,"episodeNumber":21,"title":{"value":"Episodio 21","language":"it-IT"},"overview":{"value":"Eriza Kurusu appears before Anna and Mikuru and tells them, \"I want to join the CUREtto Detective Agency!\"","language":"en-US"},"airDateText":{"value":"2026-06-21","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/1tplJ50zM2jbmJeE7rgZdpMzSBG.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/1tplJ50zM2jbmJeE7rgZdpMzSBG.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/306721/season/1/episode/21"},{"id":"7141884","seasonNumber":1,"episodeNumber":22,"title":{"value":"Episodio 22","language":"it-IT"},"overview":{"value":"Shiruku Ieiri invites Anna and Mikuru to her show, and when they come to her dressing room, she shows them a calling card that was left by the Phantom Thieves’ Guild. As they search the theater before the performance, Anna spots Luluka.","language":"en-US"},"airDateText":{"value":"2026-06-28","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/bhJejdrUUHPZaEMSnL2DqEuWNSH.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/bhJejdrUUHPZaEMSnL2DqEuWNSH.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/306721/season/1/episode/22"},{"id":"7141887","seasonNumber":1,"episodeNumber":23,"title":{"value":"Episodio 23","language":"it-IT"},"overview":{"value":"Prompted by a prediction in the Tome of Mirages, Luluka goes to Patisserie ChuChu to steal a Makoto Jewel embedded in a photograph. When Kurea brings her some ice cream, Luluka hands her a calling card…","language":"en-US"},"airDateText":{"value":"2026-07-05","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/uqoirFs1mKNnyeL4pWcX311Hz17.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/uqoirFs1mKNnyeL4pWcX311Hz17.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/306721/season/1/episode/23"},{"id":"7141891","seasonNumber":1,"episodeNumber":24,"title":{"value":"Episodio 24","language":"it-IT"},"overview":{"value":"Together with Rei, Anna and Mikuru investigate some mysterious incidents happening at Makoto Mirai Academy. As they check the science room, music room, and art room, Rei notices a pattern.","language":"en-US"},"airDateText":{"value":"2026-07-12","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/pSwUbHqYjEtvoKBwPhL23rxZEj4.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/pSwUbHqYjEtvoKBwPhL23rxZEj4.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/306721/season/1/episode/24"},{"id":"7141894","seasonNumber":1,"episodeNumber":25,"title":{"value":"Episodio 25","language":"it-IT"},"overview":{"value":"The perfume Jett-senpai has been making is finally ready. Then, a new calling card arrives from the Phantom Thieves’ Guild. Cure Eclair’s identity will finally be revealed!","language":"en-US"},"airDateText":{"value":"2026-07-19","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/bgu2VtbSGAl4Pawkzv5f5ElPtuw.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/bgu2VtbSGAl4Pawkzv5f5ElPtuw.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/306721/season/1/episode/25"},{"id":"7141896","seasonNumber":1,"episodeNumber":26,"title":{"value":"Episodio 26","language":"it-IT"},"overview":{"value":"Kurea’s memory has been restored by the Top of Lily fragrance. Shushutan also reveals herself in front of everyone. Meanwhile, Usonoir, who has misused the power of the Makoto Jewel, loses control and goes on a rampage.","language":"en-US"},"airDateText":{"value":"2026-07-26","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/keawBP30AwbSFt12KqoP5YmPdRv.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/keawBP30AwbSFt12KqoP5YmPdRv.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/306721/season/1/episode/26"},{"id":"7557479","seasonNumber":1,"episodeNumber":27,"title":{"value":"Episodio 27","language":"it-IT"},"overview":{"value":"With her memory restored, Kurea confesses to Anna and Mikuru that she was never a detective. As they reel from this news, the owner of a restaurant enters with a request for them to search for her missing cook.","language":"en-US"},"airDateText":{"value":"2026-08-02","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/89qNj8Rxoq1r9cEozEA8LdqC3eP.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/89qNj8Rxoq1r9cEozEA8LdqC3eP.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/306721/season/1/episode/27"},{"id":"7557484","seasonNumber":1,"episodeNumber":28,"title":{"value":"Episodio 28","language":"it-IT"},"overview":{"value":"Paul, an exchange student from London, receives a calling card from the Phantom Thieves’ Guild and runs to the CUREtto Detective Agency for help. The calling card looks very flashy, and the listed time is down to the second, making it different from previous cards.","language":"en-US"},"airDateText":{"value":"2026-08-09","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/akTOSpFWumO5CRoaHhyrJJCgbaO.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/akTOSpFWumO5CRoaHhyrJJCgbaO.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/306721/season/1/episode/28"},{"id":"7557488","seasonNumber":1,"episodeNumber":29,"title":{"value":"Episodio 29","language":"it-IT"},"overview":{"value":"Decchi Agein and Goemon replay Kurea's world of memories. There, Anna and the gang witness Kurea and Luluka's first meeting at the London CUREtto Detective Agency three years earlier.","language":"en-US"},"airDateText":{"value":"2026-08-16","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/70YNSG2tKjMMorw1qU02FHvXqxQ.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/70YNSG2tKjMMorw1qU02FHvXqxQ.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/306721/season/1/episode/29"},{"id":"7557492","seasonNumber":1,"episodeNumber":30,"title":{"value":"Episodio 30","language":"it-IT"},"overview":{"value":"During the summer holidays, Anna and the others go to Makoto Mirai Academy to help student council president Rei care for the flower beds. While working, they realize that the zinnias that were blooming just minutes earlier have all been cut.","language":"en-US"},"airDateText":{"value":"2026-08-23","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/iCTrkdD41SNvMed3dersimPXKWK.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/iCTrkdD41SNvMed3dersimPXKWK.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/306721/season/1/episode/30"},{"id":"7557496","seasonNumber":1,"episodeNumber":31,"title":{"value":"Episodio 31","language":"it-IT"},"overview":{"value":"Cure Answer and the others have their transformations dissolved by the sheer power of Eclipse Shadow. As Cure Eclair’s secrets and Luluka’s true intentions are revealed, Anna and Mikuru transform into Precures again and extend their hands to Kurea.","language":"en-US"},"airDateText":{"value":"2026-08-30","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/lNWLTDtyi55fUmGAMx6WKdy4FZm.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/lNWLTDtyi55fUmGAMx6WKdy4FZm.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/306721/season/1/episode/31"},{"id":"7557498","seasonNumber":1,"episodeNumber":32,"title":{"value":"Episodio 32","language":"it-IT"},"overview":{"value":"With nowhere to go, Luluka spends her days at Pâtisserie ChuChu. While she’s there, a customer’s lost item containing a Makoto Jewel is stolen. Anna and the others deduce that the culprit must be among three customers on the terrace and prepare to question them, but Luluka intervenes.","language":"en-US"},"airDateText":{"value":"2026-09-06","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/wEkmOYNxaobkLV52AuVaoiV3B1I.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/wEkmOYNxaobkLV52AuVaoiV3B1I.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/306721/season/1/episode/32"},{"id":"7557500","seasonNumber":1,"episodeNumber":33,"title":{"value":"Episodio 33","language":"it-IT"},"overview":{"value":"Just as Luluka is settling into the CUREtto Detective Agency, Goemon barges in. Unable to accept her departure from the Phantom Thieves’ Guild, he generates a trick maze to test her skills. Countless doors appear, all leading to other worlds, and who appears from behind those doors...?","language":"en-US"},"airDateText":{"value":"2026-09-13","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/ajoOn8MxZmx3agjWClQ6ZHbbWC1.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/ajoOn8MxZmx3agjWClQ6ZHbbWC1.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/306721/season/1/episode/33"},{"id":"7557503","seasonNumber":1,"episodeNumber":34,"title":{"value":"Episodio 34","language":"it-IT"},"overview":{"value":"Anna and the others recover a wooden box that was stolen by the Phantom Thieves’ Guild and take it to the police for help with finding the owner. Shiruku Ieiri is there as Police Chief for a day, and helps put out a call for the owner, but three people arrive, all claiming to own the item.","language":"en-US"},"airDateText":{"value":"2026-09-20","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/jSzUIh6M61udaB0pqeebfEKejOh.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/jSzUIh6M61udaB0pqeebfEKejOh.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/306721/season/1/episode/34"},{"id":"7557505","seasonNumber":1,"episodeNumber":35,"title":{"value":"Episodio 35","language":"it-IT"},"overview":{"value":"Kurea and Luluka begin attending high school at Minato Mirai Academy. Their new classmates try striking up a conversation with Luluka but she’s unable to respond well. Just then, she notices a love letter on the floor of the classroom.","language":"en-US"},"airDateText":{"value":"2026-09-27","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/zbETJxbZ1GBvMtLaBaK9ViY0rm9.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/zbETJxbZ1GBvMtLaBaK9ViY0rm9.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/306721/season/1/episode/35"},{"id":"7557508","seasonNumber":1,"episodeNumber":36,"title":{"value":"Episodio 36","language":"it-IT"},"overview":{"value":"Anna and the others enter a bookstore in the shopping arcade in pursuit of a Makoto Jewel. As they work to deduce the whereabouts of the shopkeeper's stolen gold medal, a conversation with a high school girl named Haruna Makifusa, who happened to stop by, provides them with a valuable hint.","language":"en-US"},"airDateText":{"value":"2026-10-04","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/wBfpop1uyKZV8KvuzgKXrxGDkyu.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/wBfpop1uyKZV8KvuzgKXrxGDkyu.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/306721/season/1/episode/36"},{"id":"7557509","seasonNumber":1,"episodeNumber":37,"title":{"value":"Episodio 37","language":"it-IT"},"overview":{"value":"Usonoir and Nijee steal Makopyon, a mascot suit for the shopping arcade with a Makoto Jewel inside, and run away from Anna and the others. Then, they disguise themselves as customers and duck into Patisserie ChuChu to wait until the heat is off.","language":"en-US"},"airDateText":{"value":"2026-10-11","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/xydpZEr6Z0DxyujWsl8FpEyFbVI.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/xydpZEr6Z0DxyujWsl8FpEyFbVI.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/306721/season/1/episode/37"},{"id":"7557510","seasonNumber":1,"episodeNumber":38,"title":{"value":"Episodio 38","language":"it-IT"},"overview":{"value":"Anna, Mikuru, and Luluka head out for the day, leaving Kurea at the quiet CUREtto Detective Agency to ruminate about why she has the power of the Forgotten Race. Then, a client comes in with a calling card she got from the Phantom Thieves' Guild.","language":"en-US"},"airDateText":{"value":"2026-10-18","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/aep5ONJsMIuQ66K2q4QUuKWNBHg.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/aep5ONJsMIuQ66K2q4QUuKWNBHg.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/306721/season/1/episode/38"},{"id":"7557512","seasonNumber":1,"episodeNumber":39,"title":{"value":"Episodio 39","language":"it-IT"},"overview":{"value":"あんなの提案で、商店街初のハロウィンイベントが開催されることになり、みんなで飾り付けや案内で大忙し。街は仮装してお菓子をもらう人々の笑顔であふれていました。商店街に繰り出したあんなたちは、母親とはぐれた幼い女の子・ひなのと出会います。母親はすぐに見つかりましたが、赤ちゃんのお世話で大変な様子を見て、みんなでひなのと商店街をまわりながら家まで送り届けることになりました。\n\nひなのは『おジャ魔女どれみ』が大好きで、母親が作ってくれたほうきに乗り、どれみのように空を飛ぶことにあこがれていました。ところが、魔女の姿に変装していたアゲセーヌにほうきの交換を持ちかけられ、マコトジュエルが宿る大切なほうきをうばわれてしまいます。ひなのをジェット先輩にまかせて追いかけるあんなたちでしたが、アゲセーヌは別の姿に変装して人混みにまぎれてしまったため、こちらも姿を変えて近づこうと考えます。\n\n「ハロウィンといえば魔女、ひなのを助けるのにふさわしい魔女といえば……」と妖精たちにせまられたあんなたちは、プリキットでおジャ魔女姿にお着換えし、アゲセーヌを見つけだします。アゲセーヌはマントを広げて空へと逃走しますが、あんなたちも空飛ぶほうきを使って追いかけることに。さらに魔法の杖・クルールポロンを使って魔法を放とうとしますが、魔法玉がないため発動しません。それでも、ほうきを乗りこなしたるるかとくれあが先回りし、アゲセーヌを追い詰めました。\n\nアゲセーヌがひなののほうきをハンニンダーに変えると、あんなたちも変身して立ち向かいます。ほうきをふり回すハンニンダーに苦戦するプリキュアでしたが、落ち葉で掃除好きな相手の気をそらし、浄化に成功します。\n\n変身が解け、あんなたちがおジャ魔女姿にもどると、目の前にごほうびとして4つの魔法玉があらわれます。一度だけ使える魔法をひなののために使おうと、取りもどしたほうきに魔法をかけるあんなたち。夕方になり、ほうきで飛んできたあんなたちに迎えられたひなのは、自分もほうきにまたがり、あこがれのおジャ魔女たちと大空を飛ぶのでした。","language":"ja-JP"},"airDateText":{"value":"2026-10-25","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/jCGx43QbL194uarFhqLLpoPYMlN.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/jCGx43QbL194uarFhqLLpoPYMlN.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/306721/season/1/episode/39"},{"id":"7960486","seasonNumber":1,"episodeNumber":40,"title":{"value":"Episodio 40","language":"it-IT"},"airDateText":{"value":"2026-11-08","language":"it-IT"},"stills":[],"sourceUrl":"https://www.themoviedb.org/tv/306721/season/1/episode/40"},{"id":"8012181","seasonNumber":1,"episodeNumber":41,"title":{"value":"Episodio 41","language":"it-IT"},"airDateText":{"value":"2026-11-15","language":"it-IT"},"stills":[],"sourceUrl":"https://www.themoviedb.org/tv/306721/season/1/episode/41"},{"id":"8012184","seasonNumber":1,"episodeNumber":42,"title":{"value":"Episodio 42","language":"it-IT"},"airDateText":{"value":"2026-11-22","language":"it-IT"},"stills":[],"sourceUrl":"https://www.themo