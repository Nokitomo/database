US"},"airDateText":{"value":"1995-02-19","language":"it-IT"},"runtimeMinutes":23,"rating":8,"thumbnail":"https://image.tmdb.org/t/p/w300/sohcaOMKrRkrpUj6bdpY2G5ALNr.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/sohcaOMKrRkrpUj6bdpY2G5ALNr.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/35832/season/1/episode/6"},{"id":"814815","seasonNumber":1,"episodeNumber":7,"title":{"value":"La casa dell'angelo","language":"it-IT"},"overview":{"value":"In Milan, Romeo and Alfredo are sold as chimney sweeps to different bosses, having to separate, but not before swearing eternal friendship. Romeo is taken by Rossi, his buyer, to his house, where he will start a new life.","language":"en-US"},"airDateText":{"value":"1995-02-26","language":"it-IT"},"runtimeMinutes":23,"rating":9,"thumbnail":"https://image.tmdb.org/t/p/w300/e2gxBEQfK9f55CM29hzP5rZxgc.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/e2gxBEQfK9f55CM29hzP5rZxgc.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/35832/season/1/episode/7"},{"id":"814816","seasonNumber":1,"episodeNumber":8,"title":{"value":"Il regalo dell'angelo","language":"it-IT"},"overview":{"value":"Cleaning chimneys is harder than Romeo could imagine. And worst of all is that when he comes home tired from work he doesn't get a piece of bread. However, an angel who lives in the house cares for him.","language":"en-US"},"airDateText":{"value":"1995-03-05","language":"it-IT"},"runtimeMinutes":23,"rating":8.5,"thumbnail":"https://image.tmdb.org/t/p/w300/bcVdtgrVLbcBjdeNZ3kp17fOIn8.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/bcVdtgrVLbcBjdeNZ3kp17fOIn8.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/35832/season/1/episode/8"},{"id":"814817","seasonNumber":1,"episodeNumber":9,"title":{"value":"Lettera d'amore al chiaro di luna","language":"it-IT"},"overview":{"value":"Romeo goes to clean Professor Casella's fireplace who, to thank him, gives him an illustrated book.","language":"en-US"},"airDateText":{"value":"1995-03-12","language":"it-IT"},"runtimeMinutes":23,"rating":8,"thumbnail":"https://image.tmdb.org/t/p/w300/7aLMqWr8PxCIWx8dqs2EEQSozlN.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/7aLMqWr8PxCIWx8dqs2EEQSozlN.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/35832/season/1/episode/9"},{"id":"814818","seasonNumber":1,"episodeNumber":10,"title":{"value":"Il quaderno","language":"it-IT"},"overview":{"value":"Romeo manages to get the key which keeps his door locked, so he can go out to meet Angeletta, becoming friends.","language":"en-US"},"airDateText":{"value":"1995-03-19","language":"it-IT"},"runtimeMinutes":23,"rating":8,"thumbnail":"https://image.tmdb.org/t/p/w300/bzrPCXFtdAblFcwRjUoKQzGfD7U.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/bzrPCXFtdAblFcwRjUoKQzGfD7U.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/35832/season/1/episode/10"},{"id":"814819","seasonNumber":1,"episodeNumber":11,"title":{"value":"Una nuova amicizia","language":"it-IT"},"overview":{"value":"Romeo watches from the rooftop of a house that one of the Wolf Pack members is ambushed by another gang of boys, but then the rest of the pack appears and a fight breaks out.","language":"en-US"},"airDateText":{"value":"1995-04-23","language":"it-IT"},"runtimeMinutes":23,"rating":9,"thumbnail":"https://image.tmdb.org/t/p/w300/elUgKYmMVOYo2Y3iHVSAxQynkNc.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/elUgKYmMVOYo2Y3iHVSAxQynkNc.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/35832/season/1/episode/11"},{"id":"814820","seasonNumber":1,"episodeNumber":12,"title":{"value":"Fuga nella nebbia","language":"it-IT"},"overview":{"value":"Romeo finds Anselmo lying on the street and covered in bruises. Anselmo tells Romeo that he confronted Tachioni because he hates outsiders and wants to kick Romeo out of town.","language":"en-US"},"airDateText":{"value":"1995-04-30","language":"it-IT"},"runtimeMinutes":23,"rating":9,"thumbnail":"https://image.tmdb.org/t/p/w300/lGBcR8VkaW1JjXyzWTkSlVXI7oF.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/lGBcR8VkaW1JjXyzWTkSlVXI7oF.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/35832/season/1/episode/12"},{"id":"814821","seasonNumber":1,"episodeNumber":13,"title":{"value":"Un incontro inaspettato","language":"it-IT"},"overview":{"value":"Romeo fights the Wolf Pack, who think he has denounced them to the police, but is saved at the last minute by a masked boy.","language":"en-US"},"airDateText":{"value":"1995-05-07","language":"it-IT"},"runtimeMinutes":23,"rating":7,"thumbnail":"https://image.tmdb.org/t/p/w300/u6GQ8xD0z0tUvdhS2Ge49iVDEU2.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/u6GQ8xD0z0tUvdhS2Ge49iVDEU2.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/35832/season/1/episode/13"},{"id":"814822","seasonNumber":1,"episodeNumber":14,"title":{"value":"La conquista della libertà","language":"it-IT"},"overview":{"value":"The carriage Romeo has sneaked into contains explosives that the robbers intend to use to blow up the police station and free their imprisoned friend.","language":"en-US"},"airDateText":{"value":"1995-05-14","language":"it-IT"},"runtimeMinutes":23,"rating":9,"thumbnail":"https://image.tmdb.org/t/p/w300/dmo7O5zGRRXSx1rpMl9Cs2Wqscx.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/dmo7O5zGRRXSx1rpMl9Cs2Wqscx.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/35832/season/1/episode/14"},{"id":"814823","seasonNumber":1,"episodeNumber":15,"title":{"value":"I Fratelli del Camino","language":"it-IT"},"overview":{"value":"After proving his innocence, Romeo's conditions at Rossis' house get better. Marcello gives him a day off and Romeo decides to search for Alfredo in the streets of Milan.","language":"en-US"},"airDateText":{"value":"1995-05-21","language":"it-IT"},"runtimeMinutes":23,"rating":7,"thumbnail":"https://image.tmdb.org/t/p/w300/lBob30CUdk2qkIeCHamRFOVJcT8.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/lBob30CUdk2qkIeCHamRFOVJcT8.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/35832/season/1/episode/15"},{"id":"814824","seasonNumber":1,"episodeNumber":16,"title":{"value":"L'esempio di Alfredo","language":"it-IT"},"overview":{"value":"After a long time, Romeo and Alfredo finally reunited and joined other young chimney sweeps to form the Black Brothers fraternity with Alfredo in command to confront the Wolf Pack.","language":"en-US"},"airDateText":{"value":"1995-05-28","language":"it-IT"},"runtimeMinutes":23,"rating":8,"thumbnail":"https://image.tmdb.org/t/p/w300/qk5FhJvmjI53GewcUYpap3kjIo1.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/qk5FhJvmjI53GewcUYpap3kjIo1.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/35832/season/1/episode/16"},{"id":"814825","seasonNumber":1,"episodeNumber":17,"title":{"value":"L'imboscata alla chiesa di San Babila","language":"it-IT"},"overview":{"value":"Since the Wolf Pack has no intention of stopping picking on the chimney sweeps, the Black Brothers, fed up with running away, decide to stand up to them.","language":"en-US"},"airDateText":{"value":"1995-06-04","language":"it-IT"},"runtimeMinutes":23,"rating":7,"thumbnail":"https://image.tmdb.org/t/p/w300/8a4mWguuo5Jzq67QuAjVaTxkdrH.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/8a4mWguuo5Jzq67QuAjVaTxkdrH.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/35832/season/1/episode/17"},{"id":"814826","seasonNumber":1,"episodeNumber":18,"title":{"value":"La grande sfida","language":"it-IT"},"overview":{"value":"As retaliation for losing the fight at San Babila church, Michaelo was kidnapped by the Wolf Pack.","language":"en-US"},"airD