language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/32377/season/1/episode/28"},{"id":"765758","seasonNumber":1,"episodeNumber":29,"title":{"value":"Episodio 29","language":"it-IT"},"overview":{"value":"Chirico and Fyana may have escaped Kummen, but they now find themselves in an undisclosed and seemingly abandoned location. For what purpose are they there?","language":"en-US"},"airDateText":{"value":"1983-10-14","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/uHg4Xoqxl8A6UURv3iMZIYqE0mq.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/uHg4Xoqxl8A6UURv3iMZIYqE0mq.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/32377/season/1/episode/29"},{"id":"765759","seasonNumber":1,"episodeNumber":30,"title":{"value":"Episodio 30","language":"it-IT"},"overview":{"value":"Chirico and Fyana attempt to thwart their attackers, but they are too numerous. Does the enemy have good reasons for its actions?","language":"en-US"},"airDateText":{"value":"1983-10-21","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/qUHLEvMO3BQ9zoLxUmiWRUddbeC.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/qUHLEvMO3BQ9zoLxUmiWRUddbeC.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/32377/season/1/episode/30"},{"id":"765760","seasonNumber":1,"episodeNumber":31,"title":{"value":"Episodio 31","language":"it-IT"},"overview":{"value":"The captain is done playing and vows to capture Chirico and Fyana. A distraction is all it takes for Chirico's AT to suffer critical damage.","language":"en-US"},"airDateText":{"value":"1983-10-28","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/sBvXxkBo03t5RyZMuITzr7MbFKa.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/sBvXxkBo03t5RyZMuITzr7MbFKa.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/32377/season/1/episode/31"},{"id":"765761","seasonNumber":1,"episodeNumber":32,"title":{"value":"Episodio 32","language":"it-IT"},"overview":{"value":"Chirico's condition deteriorates, and Fyana must take drastic measures if she wishes to save him.","language":"en-US"},"airDateText":{"value":"1983-11-04","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/qsGWgcjzLg9xzlvpCHIRGyy5tpM.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/qsGWgcjzLg9xzlvpCHIRGyy5tpM.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/32377/season/1/episode/32"},{"id":"765762","seasonNumber":1,"episodeNumber":33,"title":{"value":"Episodio 33","language":"it-IT"},"overview":{"value":"Chirico and Fyana fight at a disadvantage against Ypsilon. How will they turn the tide when Ypsilon's hatred for Chirico drives him to a single-minded purpose?","language":"en-US"},"airDateText":{"value":"1983-11-11","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/h3A8xkCVbsmeXFi11Mevjk2J2vG.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/h3A8xkCVbsmeXFi11Mevjk2J2vG.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/32377/season/1/episode/33"},{"id":"765763","seasonNumber":1,"episodeNumber":34,"title":{"value":"Episodio 34","language":"it-IT"},"overview":{"value":"A brawl with a scavenger gang leads to a reunion with an old friend. Meanwhile, a captain must decide whether to continue a mission or pursue Chirico.","language":"en-US"},"airDateText":{"value":"1983-11-18","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/wxVJC62JiZSzyRXT9dczHyDX3H1.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/wxVJC62JiZSzyRXT9dczHyDX3H1.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/32377/season/1/episode/34"},{"id":"765764","seasonNumber":1,"episodeNumber":35,"title":{"value":"Episodio 35","language":"it-IT"},"overview":{"value":"The ATs stare each other down in grim anticipation of the coming battle. When the Balarant suddenly attack, everyone must scramble for their lives.","language":"en-US"},"airDateText":{"value":"1983-11-25","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/nr0pA3mpn7mEIVXXGtoN3w3QZ2N.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/nr0pA3mpn7mEIVXXGtoN3w3QZ2N.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/32377/season/1/episode/35"},{"id":"765765","seasonNumber":1,"episodeNumber":36,"title":{"value":"Episodio 36","language":"it-IT"},"overview":{"value":"The trio is alone in the desert and low on oxygen. Zophie has not forgotten, nor has she forgiven. But to survive, she may need Chirico's assistance regardless.","language":"en-US"},"airDateText":{"value":"1983-12-02","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/cKpQXbD6LJD6hw6mcbcJlph0Vlq.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/cKpQXbD6LJD6hw6mcbcJlph0Vlq.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/32377/season/1/episode/36"},{"id":"765766","seasonNumber":1,"episodeNumber":37,"title":{"value":"Episodio 37","language":"it-IT"},"overview":{"value":"Repairs on the AT continue, but the Balarant forces are quickly approaching. Chirico wants his friends to save themselves, but they have other plans.","language":"en-US"},"airDateText":{"value":"1983-12-09","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/3fdfShC9aULdukFIhgp7iMl2J7T.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/3fdfShC9aULdukFIhgp7iMl2J7T.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/32377/season/1/episode/37"},{"id":"765767","seasonNumber":1,"episodeNumber":38,"title":{"value":"Episodio 38","language":"it-IT"},"overview":{"value":"Ypsilon and Chirico are destined to fight over and over. But when they are both trapped by debris, can Ypsilon set aside his hatred in the interest of mutual survival?","language":"en-US"},"airDateText":{"value":"1983-12-16","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/fGXCzjXzFi360VFybbVyaYIY6n8.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/fGXCzjXzFi360VFybbVyaYIY6n8.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/32377/season/1/episode/38"},{"id":"765768","seasonNumber":1,"episodeNumber":39,"title":{"value":"Episodio 39","language":"it-IT"},"overview":{"value":"With the immediate danger behind them, Chirico and Ypsilon prepare for their sworn rematch. Will they finally be able to settle things once and for all?","language":"en-US"},"airDateText":{"value":"1983-12-23","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/bonYkUqbzdYVOCPBtRbtYyjiAwe.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/bonYkUqbzdYVOCPBtRbtYyjiAwe.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/32377/season/1/episode/39"},{"id":"765769","seasonNumber":1,"episodeNumber":40,"title":{"value":"Episodio 40","language":"it-IT"},"overview":{"value":"Time is a flat circle. Chirico remembers how he escaped from Kummen alongside Fyana, only to end up on a mysterious warship.","language":"en-US"},"airDateText":{"value":"1983-12-30","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/kIDl23NjpBOMKjswLtspToFsu87.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/kIDl23NjpBOMKjswLtspToFsu87.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/32377/season/1/episode/40"},{"id":"765770","seasonNumber":1,"episodeNumber":41,"title":{"value":"Episodio 41","language":"it-IT"},"overview":{"value":"With his ship crashed, Chirico has no choice but to venture into the hostile deserts of Quent if he wishes to continue his mission.","language":"en-US"},"airDateText":{"value":"1984-01-06","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/9jpM5ZSSOkZJXeZ2wyfn3NMLzov.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/9jpM5ZSSOkZJXeZ2wyfn3NMLzov.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/32377/season/1/episode/41"},{"id":"765771","seasonNumber":1,"episodeNumber":42,"title":{"value":"Episodio 42","language":"it-IT"},"overview":{"value":"The Society no longer underestimates Chirico and considers him a legitimate threat. Meanwhile, Chirico and Shako must brave the desert on their travels.","language":"en-US"},"airDateText":{"value":"1984-01-13","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/af0YLua34XzgppmpfJjM5jwSdez.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/af0YLua34XzgppmpfJjM5jwSdez.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/32377/season/1/episode/42"},{"id":"765772","seasonNumber":1,"episodeNumber":43,"title":{"value":"Episodio 43","language":"it-IT"},"overview":{"value":"The twins decide to make planetfall. Meanwhile, Chirico requests entrance to the Quentman village.","language":"en-US"},"airDateText":{"value":"1984-01-20","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/pSvMPYLsltiTRh5k89ZGn7F8MIu.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/pSvMPYLsltiTRh5k89ZGn7F8MIu.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/32377/season/1/episode/43"},{"id":"765773","seasonNumber":1,"episodeNumber":44,"title":{"value":"Episodio 44","language":"it-IT"},"overview":{"value":"There can be no more room for doubt in the Society's mind: Quent contains a trove of advanced technology. What will be their next move after this discovery?","language":"en-US"},"airDateText":{"value":"1984-01-27","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/qST8PIrvPUbckIfBShbissXWRW9.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/qST8PIrvPUbckIfBShbissXWRW9.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/32377/season/1/episode/44"},{"id":"765774","seasonNumber":1,"episodeNumber":45,"title":{"value":"Episodio 45","language":"it-IT"},"overview":{"value":"The events on Quent captures the attention of another party, which deploys its forces in response. Chirico and Shako explore the ruins beneath the planet's surface.","language":"en-US"},"airDateText":{"value":"1984-02-03","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/glmxQLJlYUHVB8lrr7lZbMoRbyQ.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/glmxQLJlYUHVB8lrr7lZbMoRbyQ.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/32377/season/1/episode/45"},{"id":"765775","seasonNumber":1,"episodeNumber":46,"title":{"value":"Episodio 46","language":"it-IT"},"overview":{"value":"As Gilgamesh and Balarant forces prepare for battle, the Society wonders how they can use this to their advantage. Unless something changes, Quent will turn into a warzone.","language":"en-US"},"airDateText":{"value":"1984-02-10","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/parZ6GNThBw1U751VJ5qkEjYzn2.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/parZ6GNThBw1U751VJ5qkEjYzn2.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/32377/season/1/episode/46"},{"id":"765776","seasonNumber":1,"episodeNumber":47,"title":{"value":"Episodio 47","language":"it-IT"},"overview":{"value":"The battle rages over the planet. To the victor goes Quent's secrets. Chirico's friends escape in a stolen Gilgamesh ship but are quickly intercepted by the Balarant.","language":"en-US"},"airDateText":{"value":"1984-02-17","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/csZZ3Jb8qFeCA3dHRXgFTE3LlUB.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/csZZ3Jb8qFeCA3dHRXgFTE3LlUB.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/32377/season/1/episode/47"},{"id":"765777","seasonNumber":1,"episodeNumber":48,"title":{"value":"Episodio 48","language":"it-IT"},"overview":{"value":"Onboard a ship not under their control, its passengers can only wait as it ventures closer to an object that is clearly no moon. What awaits all of them inside?","language":"en-US"},"airDateText":{"value":"1984-02-24","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/j7qoyxWkLkrOyIIXhLNEnPDqVa8.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/j7qoyxWkLkrOyIIXhLNEnPDqVa8.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/32377/season/1/episode/48"},{"id":"765778","seasonNumber":1,"episodeNumber":49,"title":{"value":"Episodio 49","language":"it-IT"},"overview":{"value":"A 3,000-year-old truth unites the warring Gilgamesh and Balarant into a single, vengeful army. Meanwhile, what are the implications for Wiseman's plans with Chirico?","language":"en-US"},"airDateText":{"value":"1984-03-02","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/mEU5mvi1v8ekwYCP9VoLgH9Laju.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/mEU5mvi1v8ekwYCP9VoLgH9Laju.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/32377/season/1/episode/49"},{"id":"765779","seasonNumber":1,"episodeNumber":50,"title":{"value":"Episodio 50","language":"it-IT"},"overview":{"value":"A failed mutiny solidifies Chirico's control. The joint Gilgamesh/Balarant fleet devises ways to fight Wiseman. As forces converge, a question burns: How can one stop a god?","language":"en-US"},"airDateText":{"value":"1984-03-09","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/6gsdJToXwrhApZ3r3jLuDLluQBG.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/6gsdJToXwrhApZ3r3jLuDLluQBG.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/32377/season/1/episode/50"},{"id":"765780","seasonNumber":1,"episodeNumber":51,"title":{"value":"Episodio 51","language":"it-IT"},"overview":{"value":"History is filled with men who sacrificed everything in pursuit of power. Fyana refuses to let her love be one of them. Is Chirico truly willing to make everyone his enemy?","language":"en-US"},"airDateText":{"value":"1984-03-16","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/3kALcFn1cgHvDuMffnT3tYGhH8L.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/3kALcFn1cgHvDuMffnT3tYGhH8L.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/32377/season/1/episode/51"},{"id":"765781","seasonNumber":1,"episodeNumber":52,"title":{"value":"Episodio 52","language":"it-IT"},"overview":{"value":"The road was long and hard-fought but in the end, a choice will be made. That choice will determine the fate of the entire galaxy.","language":"en-US"},"airDateText":{"value":"1984-03-23","language":"it-IT"},"runtimeMinutes":25,"thumbnail":"https://image.tmdb.org/t/p/w300/njwnvHMqTPQhYD6Ufh0NC5ngbvF.jpg","stills":[{"type":"still","url":"https://image.tmdb.org/t/p/original/njwnvHMqTPQhYD6Ufh0NC5ngbvF.jpg","language":"xx"}],"sourceUrl":"https://www.themoviedb.org/tv/32377/season/1/episode/52"}],"sourceUrl":"https://www.themoviedb.org/tv/32377/season/1"},"fields":{},"episodes":{"1":{"checkedAt":1793362298182,"status":"ok"},"2":{"checkedAt":1793362298182,"status":"ok"},"3":{"checkedAt":1793362298182,"status":"ok"},"4":{"checkedAt":1793362298182,"status":"ok"},"5":{"checkedAt":1793362298182,"status":"ok"},"6":{"checkedAt":1793362298182,"status":"ok"},"7":{"checkedAt":1793362298182,"status":"ok"},"8":{"checkedAt":1793362298182,"status":"ok"},"9":{"checkedAt":1793362298182,"status":"ok"},"10":{"checkedAt":1793362298182,"status":"ok"},"11":{"checkedAt":1793362298182,"stat