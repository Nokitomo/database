26","episodeNumbers":[10]},{"provider":"mal","id":"1226","episodeNumbers":[10]},{"provider":"tmdb_show","id":"34813","scope":"s1","seasonNumber":1,"episodeNumbers":[10]},{"provider":"tvdb_show","id":"82443","scope":"s1","seasonNumber":1,"episodeNumbers":[10]}]},{"sourceEpisodeNumber":11,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"223","scope":"R","episodeNumbers":[11]},{"provider":"anilist","id":"1226","episodeNumbers":[11]},{"provider":"mal","id":"1226","episodeNumbers":[11]},{"provider":"tmdb_show","id":"34813","scope":"s1","seasonNumber":1,"episodeNumbers":[11]},{"provider":"tvdb_show","id":"82443","scope":"s1","seasonNumber":1,"episodeNumbers":[11]}]},{"sourceEpisodeNumber":12,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"223","scope":"R","episodeNumbers":[12]},{"provider":"anilist","id":"1226","episodeNumbers":[12]},{"provider":"mal","id":"1226","episodeNumbers":[12]},{"provider":"tmdb_show","id":"34813","scope":"s1","seasonNumber":1,"episodeNumbers":[12]},{"provider":"tvdb_show","id":"82443","scope":"s1","seasonNumber":1,"episodeNumbers":[12]}]},{"sourceEpisodeNumber":13,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"223","scope":"R","episodeNumbers":[13]},{"provider":"anilist","id":"1226","episodeNumbers":[13]},{"provider":"mal","id":"1226","episodeNumbers":[13]},{"provider":"tmdb_show","id":"34813","scope":"s1","seasonNumber":1,"episodeNumbers":[13]},{"provider":"tvdb_show","id":"82443","scope":"s1","seasonNumber":1,"episodeNumbers":[13]}]}]},"checkedAt":1793375040313,"status":"ok","value":[{"title":"Guardian Angel","synopsis":"The episode starts out with the Angel Links rescuing a cargo ship from a bunch of petty pirates using small grappler ships. After causing the pirates to flee, Mei-Fon uses the Links Cannon to turn them into space dust. Back on their base planet, Orashion IV, the officers of the Angel Links are welcomed at a party.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/82443/374399.jpg"},{"title":"A Wasted Fairy Tale","synopsis":"As many wealthy people court the favor of Mei-Fon and her crew, we get to meet the first obvious villain of the series, Gordon Hoi.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/82443/374400.jpg"},{"title":"The Proud Dragon","synopsis":"While Mei-Fon tries to bury her anger at Gordon Hoi's annoying words, the viewpoint changes to that of a ship that is being hijacked.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/82443/374401.jpg"},{"title":"Lief-Living Ether Flier","synopsis":"Back at the party, the crew receives a ransom message from the hijackers stating their demands. They are holding Leon Lahn and a young girl. (Leon was supposed to be at the party.)","thumbnail":"https://artworks.thetvdb.com/banners/episodes/82443/374402.jpg"},{"title":"The Rain Upon the Stars","synopsis":"Kosei is a major playboy (he keeps running into former girlfriends, including one who looks a lot like Iris, the waitress from Outlaw Star) and that he's quite a hottie when he's not being Meifon's lapdog and personal tea-server.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/82443/374403.jpg"},{"title":"Crossroads","synopsis":"Head back in time a bit to see how the Angel Links got started, including the death of Meifon's grandfather and his decree that she should take over the company and start up a free security agency, as well as how all the crew came together.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/82443/374404.jpg"},{"title":"The Angel and the Fallen Angel","synopsis":"Back to the present, following Meifon on a date with Leon Lau, the mysterious (and handsome) philanthropist who's taken an interest in her.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/82443/374405.jpg"},{"title":"My Ship","synopsis":"Meifon drags Kosei into a den of beggar-pirates who've stolen a shipment right out from under her nose, and although she seems to be a bit of a fluff head sometimes.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/82443/374406.jpg"},{"title":"A Pheasant Chooses Its Tree","synopsis":"Valeria's turn for a bit of attention, revealing some of her past when an ex-boyfriend in the Einhorn military shows up to try and win her back, while collecting information on Angel Links in the meantime.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/82443/374407.jpg"},{"title":"The Ones Who Were Left","synopsis":"Meifon meets an old friend of her grandfather's, and the truth about Grandpa, Leon Lau, and Meifon finally comes out.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/82443/374408.jpg"},{"title":"At the Binary Interval","synopsis":"A deal primarily with Meifon’s breakdown, but more information is given regarding the relationship between Chenho (Meifon's grandfather) and Goryu/Leon, and their connection to Meifon.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/82443/374409.jpg"},{"title":"All My Soul","synopsis":"Final confrontation between Goryu/Leon and Meifon, and there is even a small piece of the Meifon puzzle left to be revealed.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/82443/374410.jpg"},{"title":"Fragment of An Angel","thumbnail":"https://artworks.thetvdb.com/banners/episodes/82443/374411.jpg"}],"fields":{},"episodes":{}}
