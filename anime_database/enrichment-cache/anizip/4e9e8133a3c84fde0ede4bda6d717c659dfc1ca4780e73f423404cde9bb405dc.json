ovider":"anidb","id":"1392","scope":"R","episodeNumbers":[48]},{"provider":"anilist","id":"2041","episodeNumbers":[48]},{"provider":"mal","id":"2041","episodeNumbers":[48]},{"provider":"tmdb_show","id":"71961","scope":"s1","seasonNumber":1,"episodeNumbers":[48]},{"provider":"tvdb_show","id":"276844","scope":"s1","seasonNumber":1,"episodeNumbers":[48]}]},{"sourceEpisodeNumber":49,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"1392","scope":"R","episodeNumbers":[49]},{"provider":"anilist","id":"2041","episodeNumbers":[49]},{"provider":"mal","id":"2041","episodeNumbers":[49]},{"provider":"tmdb_show","id":"71961","scope":"s1","seasonNumber":1,"episodeNumbers":[49]},{"provider":"tvdb_show","id":"276844","scope":"s1","seasonNumber":1,"episodeNumbers":[49]}]},{"sourceEpisodeNumber":50,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"1392","scope":"R","episodeNumbers":[50]},{"provider":"anilist","id":"2041","episodeNumbers":[50]},{"provider":"mal","id":"2041","episodeNumbers":[50]},{"provider":"tmdb_show","id":"71961","scope":"s1","seasonNumber":1,"episodeNumbers":[50]},{"provider":"tvdb_show","id":"276844","scope":"s1","seasonNumber":1,"episodeNumbers":[50]}]},{"sourceEpisodeNumber":51,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"1392","scope":"R","episodeNumbers":[51]},{"provider":"anilist","id":"2041","episodeNumbers":[51]},{"provider":"mal","id":"2041","episodeNumbers":[51]},{"provider":"tmdb_show","id":"71961","scope":"s1","seasonNumber":1,"episodeNumbers":[51]},{"provider":"tvdb_show","id":"276844","scope":"s1","seasonNumber":1,"episodeNumbers":[51]}]}]},"checkedAt":1793366542905,"status":"ok","value":[{"title":"The Birth of Super-girl Burin!","synopsis":"Karin Kokubu rescues a yellow piglet on her way to school. The piglet turns out to be the prince of an alien planet, though, and turns her into the super-pig Buurin- but she'd rather be any other kind of hero.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/4757157/screencap/63855c7eb2d0e.jpg"},{"title":"The Shooting of Love and Youth","synopsis":"Karin's school is having an important soccer match with a rival school, one known for their unfair tricks. Koichi, the star player of her school's team, is going to be the victim of these tricks unless Buurin does something about it.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/4757158/screencap/63855c9415f5a.jpg"},{"title":"Smashing Tears and Friendship","synopsis":"Karin and her best friend Masami have a falling-out during tennis practice. Having a hard time making up, Karin decides to use Buurin to repair their relationship.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/4757160/screencap/63855ca7a78ae.jpg"},{"title":"Gambling Youth on the Ring","synopsis":"A local park is hosting a female pro-wrestling tournament. Among the wrestlers is an amateur, Buutan, who dresses up like Buurin to fight.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/4757161/screencap/63855cbd0dcb6.jpg"},{"title":"The Tied Friendship with Tug-A-War","synopsis":"Karin's school's athletic meet is hosting a very special event: a tug-of-war match where all of the first-year students compete with Buurin. Koichi is having trouble organizing the event, though.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/4757162/screencap/63855cd2960cc.jpg"},{"title":"A Buurin Clay-figure Discovered!","synopsis":"On a history field trip, Karin finds an ancient clay figure that looks a lot like Buurin. It leads her to some ruins that give some insight into Buurin's history.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/4757163/screencap/63855ce5db546.jpg"},{"title":"The Injured Heroine","synopsis":"A real bank robber interrupts a live show starring Cutey Chao, Karin's favorite heroine. Buurin must stop him quickly.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/4757164/screencap/63855cf67d75c.jpg"},{"title":"The Grand Diet Plan!","synopsis":"Karin has been eating a lot lately, but after a comment from Koichi she decides to go on a diet. She goes too far, though, and gets weaker and weaker- this soon starts affecting Buurin's performance as well.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/4757165/screencap/63855d06bfed9.jpg"},{"title":"Car Warriors","synopsis":"The race circuit that Keiko Kuroha's family owns is hosting a solar car race. Karin and some of her friends enter a Buurin-shaped car in the race, driven by Ms. Tateshi. When the weather takes a turn for the worse, the situation becomes tense.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/4757166/screencap/63855d1644ea2.jpg"},{"title":"The Fire of a Journalist`s Soul","synopsis":"Shinichiro Kokobu, editor-in-chief of the Akebono Times (and Karin's father), is on the hunt for a big scoop. He has a new target that he's doing some investigative journalism on- Buurin!","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/4757168/screencap/63855d255e989.jpg"},{"title":"Who Will be the Best Couple?","synopsis":"The school's cultural festival includes a 'best couple' contest. Lured in by the promise of a romantic meal for the winning couple, Karin tries to win with Koichi.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/4757169/screencap/63855d47e5487.jpg"},{"synopsis":"Kashiwagi has been really into the supernatural lately, and things are dialed up a notch when a series of coincidences leads him to believe that he has supernatural powers of his own.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/4757170/screencap/63855d596a0d8.jpg"},{"synopsis":"As Karin prepares for a big test, she finds out that Ton has a test as well. If Buurin doesn't collect 50 pearls by the deadline, Ton won't be able to become king of Buuringo.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/4757171/screencap/63855d69ed907.jpg"},{"synopsis":"Koichi's making a movie, and he and the others have a perfect pick for the lead actress: Buurin!","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/4757172/screencap/63855d798ecce.jpg"},{"synopsis":"Kaoru, disheartened by littering citizens who won't change their ways, decides to take the task of picking up garbage into her own hands. Buurin ends up helping her.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/4757173/screencap/63855d8bcbd56.jpg"},{"synopsis":"Karin is looking forward to giving Koichi a gift at a Christmas party. He says he can't come, though. Karin is suspicious- he says the reason is that he has a date with Buurin!","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/4757174/screencap/63855d9f55245.jpg"},{"synopsis":"Karin comes across an opportunity to see if her future is with Koichi.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/4757175/screencap/63855daf4def8.jpg"},{"synopsis":"There's a big New Years' party at Karin's place! All seems well, but Ton is shut in Karin's room, missing his home planet.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/4757176/screencap/63855dbf528a6.jpg"},{"synopsis":"Karin and Koichi get to go (with the rest of their class) to a ski camp. Mr. Arashiyama seems nervous and soon enough Karin finds out he wants to profess his love to Ms. Tateshi.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/4757177/screencap/63855dd0c14e6.jpg"},{"synopsis":"There's a cool plant in the school (and it's named after Keiko). Trouble arises when the plant grows out of control and Buurin must defeat it.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/4757178/screencap/63855de35472e.jpg"},{"synopsis":"Karin faces complicated feelings towards Koichi and wonders who he likes.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/4757179/screencap/63855df78ebb6.jpg"},{"synopsis":"Ton is in love, and not with someone back on his home planet, either.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/4757180/screencap/63855e0d86d60.jpg"},{"synopsis":"It's valentines' day, and. Buurin is helping a local sweets shop to deliver chocolates around town. As orders pile up, she worries she won't even have time to give chocolate to Koichi before the day is over.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/4757181/screencap/63855e1fe474a.jpg"},{"synopsis":"Karin's father waits for a natural phenomenon to occur.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/4757182/screencap/63855e33762bf.jpg"},{"synopsis":"Karin has to choose a doll for Girl's day. She's conflicted about which to choose, though.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/4757183/screencap/63855e45598f3.jpg"},{"synopsis":"Buurin and tennis intersect.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/4757184/screencap/63855e56d9d22.jpg"},{"synopsis":"Buurin needs to recharge, but has to rescue a puppy and stays transformed for a bit too long, then faces the consequences.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/4757185/screencap/63855e65ea7e0.jpg"},{"synopsis":"Karin's younger brother has a girlfriend, Hitomi. All is fine until Karin finds out Hitomi has a familiar older brother, one who stood against Koichi's soccer team a while back...","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/4757186/screencap/63855e78ed0fd.jpg"},{"synopsis":"Keiko funds a class trip to Hawaii.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/4757187/screencap/63855e8b18838.jpg"},{"synopsis":"A rumor concerning Buurin is spreading in Hawaii.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/4757188/screencap/63855e9f1e7fc.jpg"},{"synopsis":"Nobody seems to want to run for student council president this year... until Keiko Kuroha steps up to the challenge and throws the entire school into election spirit.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/4757189/screencap/63855eb28a3cc.jpg"},{"synopsis":"Jimmy Matsumoto has a turbulent history with the annual cherry trees.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/4757190/screencap/63855ec3c9c45.jpg"},{"synopsis":"The cold is going through town again, and this time Karin (and by extension, Buurin) gets it. It begins to interfere with Buurin's superheroine activities.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/4757191/screencap/63855ed4eb1a7.jpg"},{"synopsis":"Koichi's soccer team faces a big game, but there's some conflict between the players. Mr. Arashiyama says that carp streamers could bring them back together, though.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/4757192/screencap/63855ee53870b.jpg"},{"synopsis":"Two ninjas working for Takuma's family kidnap Karin and take her to Kyoto, where her friends shortly follow. Takuma believes that Karin is in love with him.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/4757193/screencap/63855ef378b02.jpg"},{"synopsis":"Karin gets to help out with rice planting, but it seems tough.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/4757194/screencap/63855f043757d.jpg"},{"synopsis":"Koichi has written a love letter to Buurin. Karin, determined to make Koichi fall in love with her as herself instead, tries to prevent Buurin and Koichi from ever meeting again.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/4757195/screencap/63855f1260bc8.jpg"},{"synopsis":"Jimmy sees Buuringo in the sky and, while trying to investigate, falls into another dimension, creating a series of strange circumstances.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/4757196/screencap/63855f28bb17f.jpg"},{"synopsis":"Everywhere Buurin appears, one strange mark can be found. Karin and Ton head to Kyoto in order to investigate the connection between the mark and the Mushanokoji family.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/4757197/screencap/6385616dddecd.jpg"},{"synopsis":"Kashiwagi's grandmother had the chance to become Buurin as well a long time ago.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/4757198/screencap/63856181772eb.jpg"},{"synopsis":"Jimmy's investigations reach their end and he has a theory: Karin and Buurin are the same person! Karin must convince him that he's wrong, somehow.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/4757199/screencap/638561930338f.jpg"},{"synopsis":"Just as Jimmy is about to confirm his theory, another Buurin appears! This new Buurin is fast, strong, and smart- no one seems to know who she is, and to prove herself as the one real Buurin, the original and the impostor have a showdown.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/4757200/screencap/638561a96a3c0.jpg"},{"synopsis":"Karin and friends spend a night in the gym basement. Mr. Arashiyama and Karin both have something to hide, so they fake supernatural happenings.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/4757201/screencap/638561bb5f8bc.jpg"},{"synopsis":"Keiko Kuroha has found a strange compact. As it turns out, it's the very same compact that Karin uses to transform into Buurin!","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/4757202/screencap/638561cb0de1c.jpg"},{"synopsis":"Karin finally gets the chance to (temporarily) transform into Cutey Chao! In a strange twist of fate, though, Buurin is needed, and so she has to transform back.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/4757203/screencap/638561d92bf8d.jpg"},{"synopsis":"Ton and Karin might have to break up their friendship as Karin moves in on her goal of 108 pearls.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/4757204/screencap/638561e8646f0.jpg"},{"synopsis":"Keiko is having a dinner party at her massive, luxurious mansion. It turns out, though, that her parents only come home once a year.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/4757205/screencap/638561f840d93.jpg"},{"synopsis":"An entrance in a basement leads to another world.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/4757206/screencap/63856208e92b9.jpg"},{"synopsis":"Monsters from Keiko's mansion have broken into the outside world, and they're attacking the school. Karin can't find time to transform into Buurin and fears she'll have to do it in front of the others, locking her into Buurin form forever.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/4757207/screencap/63856218139c1.jpg"},{"synopsis":"Karin decides to reveal she's Buurin and transform to save the city, but doing this will mean she can never transform back into Karin.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/4757208/screencap/63856227a378c.jpg"},{"synopsis":"Apparently there need to be 7 Buurins to use the 7 talismans... but there's just one. Karin needs the strength of all of her friends to save the world.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/4757209/screencap/6385623e6661c.jpg"}],"fields":{},"episodes":{}}
