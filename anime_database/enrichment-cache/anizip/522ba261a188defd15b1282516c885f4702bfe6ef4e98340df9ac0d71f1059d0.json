3","scope":"R","episodeNumbers":[10]},{"provider":"anilist","id":"178550","episodeNumbers":[10]},{"provider":"mal","id":"59142","episodeNumbers":[10]},{"provider":"tmdb_show","id":"216272","scope":"s2","seasonNumber":2,"episodeNumbers":[10]},{"provider":"tvdb_show","id":"428352","scope":"s2","seasonNumber":2,"episodeNumbers":[10]}]},{"sourceEpisodeNumber":11,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"18713","scope":"R","episodeNumbers":[11]},{"provider":"anilist","id":"178550","episodeNumbers":[11]},{"provider":"mal","id":"59142","episodeNumbers":[11]},{"provider":"tmdb_show","id":"216272","scope":"s2","seasonNumber":2,"episodeNumbers":[11]},{"provider":"tvdb_show","id":"428352","scope":"s2","seasonNumber":2,"episodeNumbers":[11]}]},{"sourceEpisodeNumber":12,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"18713","scope":"R","episodeNumbers":[12]},{"provider":"anilist","id":"178550","episodeNumbers":[12]},{"provider":"mal","id":"59142","episodeNumbers":[12]},{"provider":"tmdb_show","id":"216272","scope":"s2","seasonNumber":2,"episodeNumbers":[12]},{"provider":"tvdb_show","id":"428352","scope":"s2","seasonNumber":2,"episodeNumbers":[12]}]}]},"checkedAt":1793371357423,"status":"ok","value":[{"title":"From a Blank Page Anew","synopsis":"Prince Oscar, heir to the throne of Farsas, was cursed in his childhood - a curse that prevents him from producing an heir. He travels to Tuldarr, a nation of mages, to seek help from their king.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/10561922/screencap/677996a4063d6.jpg"},{"title":"Emerging from a Glass Cocoon","synopsis":"A band of thieves kidnaps Tinasha while Oscar is away. Now, he must negotiate for her safe return, but they demand that Oscar relinquish a Farsas royal treasure: his trusty sword, Akashia.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/10856657/screencap/677e21a8be5fd.jpg"},{"title":"Unanswered Prayer","synopsis":"Tinasha and Prince Legis of Tuldarr are met with assassination attempts. A mysterious woman visits Farsas Castle and offers to bear Oscar's child.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/10856658/screencap/678dbba98eb6a.jpg"},{"title":"Unseen Visage","synopsis":"Oscar agrees to let Princess Nephelli of Yarda take refuge from strife in her homeland. However, they find an assassin has followed her into Farsas.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/10856659/screencap/6790ed59493cb.jpg"},{"title":"Returning the Promise","synopsis":"Tinasha takes the throne once more as Tuldarr's queen. Oscar makes up his mind after Tinasha shocks all present at the coronation ceremony.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/10856660/screencap/679a61f7cf426.jpg"},{"title":"Bloodless Scars","synopsis":"Tinasha visits a school in Tuldarr when disaster strikes. The nation of Cezar launches an invasion on Farsas.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/10856661/screencap/67a3a5aedc6a9.jpg"},{"title":"Joyful Sorrow","synopsis":"Oscar receives an unexpected guest, whose voice he recognizes. The secret of the witch's curse comes to light.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/10856662/screencap/67aca9fa294e0.jpg"},{"title":"Half of Eternity","synopsis":"Tinasha helps Travis deal with a pesky demon. Oscar finds a baby in the palace that is supposedly his child.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/10856663/screencap/67b8df9cb4523.jpg"},{"title":"Pride of the Past","synopsis":"Tinasha travels to Magdalsia to diagnose a magical malady, but comes across an enigmatic intruder instead.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/10856664/screencap/67c22c0bd4cd4.jpg"},{"title":"Once Upon a Time with You","synopsis":"Valt, the newly-appointed chief mage of Farsas, investigates a series of mysterious deaths and suicides.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/10856665/screencap/67cd84f1954b4.jpg"},{"title":"At Memory`s End","synopsis":"Magdalsia's aggression forces Tuldarr into war, but Oscar learns the shocking truth behind the instigator.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/10856666/screencap/67d974bfc6355.jpg"},{"title":"Death of the Nameless Story","synopsis":"With Tuldarr in grave danger, Tinasha must decide whether to do as Valt demands and destroy Eleterria.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/10856667/screencap/67dd5d561ba03.jpg"}],"fields":{},"episodes":{}}
