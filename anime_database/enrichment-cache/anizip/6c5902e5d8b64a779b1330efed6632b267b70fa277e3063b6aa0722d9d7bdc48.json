ers":[10]},{"provider":"anilist","id":"117756","episodeNumbers":[10]},{"provider":"mal","id":"41750","episodeNumbers":[10]},{"provider":"tmdb_show","id":"1095","scope":"s4","seasonNumber":4,"episodeNumbers":[10]},{"provider":"tvdb_show","id":"73749","scope":"s4","seasonNumber":4,"episodeNumbers":[10]}]},{"sourceEpisodeNumber":11,"seasonNumber":4,"externalMappings":[{"provider":"anidb","id":"15512","scope":"R","episodeNumbers":[11]},{"provider":"anilist","id":"117756","episodeNumbers":[11]},{"provider":"mal","id":"41750","episodeNumbers":[11]},{"provider":"tmdb_show","id":"1095","scope":"s4","seasonNumber":4,"episodeNumbers":[11]},{"provider":"tvdb_show","id":"73749","scope":"s4","seasonNumber":4,"episodeNumbers":[11]}]},{"sourceEpisodeNumber":12,"seasonNumber":4,"externalMappings":[{"provider":"anidb","id":"15512","scope":"R","episodeNumbers":[12]},{"provider":"anilist","id":"117756","episodeNumbers":[12]},{"provider":"mal","id":"41750","episodeNumbers":[12]},{"provider":"tmdb_show","id":"1095","scope":"s4","seasonNumber":4,"episodeNumbers":[12]},{"provider":"tvdb_show","id":"73749","scope":"s4","seasonNumber":4,"episodeNumbers":[12]}]}]},"checkedAt":1793326984172,"status":"ok","value":[{"title":"Domino Effect: Silly Kukushkin","synopsis":"Members of Section 9 seek out a man named Philip Kukushkin, a Russian national who seems to know a lot about the creation of posthumans.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/9081637/screencap/629f5dd9a3eed.jpg"},{"title":"Close Call: I`ve Awoken","synopsis":"US special operations forces join the Section 9 team in their fight against a relentless posthuman named Suzuka Mizukane.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/9159200/screencap/629f5e1907a40.jpg"},{"title":"Factor: 1A84","synopsis":"While extracting information from Kukushkin, the Section 9 team uncovers some shocking information about an AI program developed by the US government.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/9159201/screencap/629f5e54c50ae.jpg"},{"title":"Memories: Born in Heaven","synopsis":"Worried Purin might be a spy for the Americans, the Major sends out a crew of Tachikoma to look into her hidden past.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/9159202/screencap/629f5e92d869e.jpg"},{"title":"Room 101: Man`s Search for Meaning","synopsis":"Togusa finally realizes that he's been trapped in his own memories — and suddenly finds himself in a devastated Tokyo in the year 2045.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/9159203/screencap/629f5ed239fdb.jpg"},{"title":"N-Power: How to Build an Independent Nation","synopsis":"After hearing from Togusa, Batou and the others head to Tokyo. Back in Fukuoka, the Major learns that a posthuman has hijacked a nuclear submarine.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/9159204/screencap/629f5f0c50d54.jpg"},{"title":"Truth Point of Contact: Bridge of Promise","synopsis":"Resurrected as a full-body prosthetic cyborg, Purin tries to hitchhike her way to Tokyo. US special operations forces face Mizukane's wrath.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/9159205/screencap/629f5f48b1283.jpg"},{"title":"Demi Deus: Those Who Evolve Toward Divinity","synopsis":"Batou and the group get an update on the posthuman situation from Standard. The Major and Purin join the rest of the crew in Tokyo.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/9159206/screencap/629f5f8011192.jpg"},{"title":"Last Resort: A Long Slumber","synopsis":"To take back control of the hijacked nuclear submarine, the Section 9 team targets Mizukane and Takashi Shimamura.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/9159207/screencap/629f5fb8c0dc7.jpg"},{"title":"Operation Standoff: The Battle Begins","synopsis":"Shimamura wakes up and makes a desperate move, putting Kusanagi and her crew in an impossible position.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/9159208/screencap/629f5ff28cd85.jpg"},{"title":"Doomsday: The Moon over the Ruined Castle","synopsis":"Kusanagi and her team do everything they can to stop the US from implementing their draconian plan to end the nuclear standoff with \"N.\"","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/9159209/screencap/629f602b17f9b.jpg"},{"title":"Double Think: Event Boundary","synopsis":"The Section 9 crew start living their regular lives as if nothing ever happened — and the only one who finds it strange is Kusanagi.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/9159210/screencap/629f6066cd074.jpg"}],"fields":{},"episodes":{}}
