ilistcdn/media/anime/cover/medium/bx112640-odUuRLTwodH5.jpg","plot":"Dopo gli eventi di Mask of Deception, l’Impero di Yamato è controllato dal pugno di ferro di uno spietato usurpatore che cerca di sottomettere tutti. Sta ad una coppia, di ben noti personaggi nella saga, contrapporsi allarmata imperiale. Il destino del mondo resta sospeso poiché gli stati e i generali devono prendere una posizione in questa pericolosa guerra civile. Segreti verranno rivelati, amicizie verranno messe alla prova e dure battaglie saranno combattute. Riusciranno pace e ordine ad essere ripristinati? Oppure la ricerca della vittoria a tutti i costi segnerà l’inizio della fine?","date":"2022","episodes_count":28,"episodes_length":24,"author":" ","created_at":"2022-07-02 19:20:31","status":"Terminato","imageurl_cover":"","type":"TV","slug":"utawarerumono-mask-of-truth","title_eng":"Utawarerumono Mask of Truth","day":"Sabato","favorites":28,"score":"7.44","visite":61028,"studio":"White Fox","dub":0,"always_home":1,"members":196,"cover":"https://img.animeworld.tv/copertine/XAVfG.jpg","anilist_id":112640,"season":"Estate","title_it":null,"mal_id":40590,"crunchy_id":null,"netflix_id":null,"prime_id":null,"disney_id":null,"pivot":{"anime_id":2747,"related_id":3854,"number":1}}]},"htmlError":null,"episodes":[{"id":47476,"anime_id":2747,"user_id":null,"number":"1","created_at":"2020-08-29 18:19:30","link":"https://server16.streamingaw.online/DDL/ANIME/Utawarerumono/Utawarerumono_OVA_01_SUB_ITA.mp4","visite":10299,"hidden":0,"public":1,"scws_id":107711,"file_name":"Utawarerumono_OVA_01_SUB_ITA.mp4","tg_post":0},{"id":47477,"anime_id":2747,"user_id":null,"number":"2","created_at":"2020-08-29 18:19:30","link":"https://server16.streamingaw.online/DDL/ANIME/Utawarerumono/Utawarerumono_OVA_02_SUB_ITA.mp4","visite":743,"hidden":0,"public":1,"scws_id":107716,"file_name":"Utawarerumono_OVA_02_SUB_ITA.mp4","tg_post":0},{"id":47478,"anime_id":2747,"user_id":null,"number":"3","created_at":"2020-08-29 18:19: