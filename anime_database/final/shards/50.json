 diventare nemici, i due dovranno affrontare dolore, paura e tradimento per trovare un nuovo inizio.","image":"https://image.tmdb.org/t/p/original/5uuTwHfgGrP8QRZOjegZxCZxr3X.jpg","poster":"https://image.tmdb.org/t/p/original/5DVeBaDAdLCHlLg1nn4sjhUwgcg.jpg","logo":"https://image.tmdb.org/t/p/original/eGQcSNTYGyTPXyd46EBa7gLJwPV.png","background":"https://image.tmdb.org/t/p/original/5uuTwHfgGrP8QRZOjegZxCZxr3X.jpg","trailers":["https://www.youtube.com/watch?v=tv1EZbG8pLI"],"imdbId":"","type":"movie","tags":["Movie","Terminato","Estate","2026"],"tagKeys":{"Movie":"Movie","Terminato":"Completed","Estate":"Summer"},"genres":["Action","Adventure"],"rating":"7.2","studio":"POLYGON PICTURES","episodesCount":1,"extra":{"ids":{"malId":63736,"anilistId":208754,"crunchyId":null,"disneyId":null,"netflixId":null,"primeId":null,"anilistIds":[208754],"malIds":[63736],"anidbIds":[20025],"imdbMovieIds":[],"imdbShowIds":[],"tmdbMovieIds":[1654313],"tmdbShowIds":[],"tvdbMovieIds":[],"tvdbShowIds":[]},"stats":{"scoreRaw":"7.19","favorites":63,"members":387,"views":20817,"episodesCountRaw":1,"episodesLength":110},"flags":{"dub":0,"alwaysHome":1},"meta":{"day":"Giovedì","season":"Estate","status":"Terminato","type":"Movie","createdAt":"2026-08-20 18:10:43","userId":2},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-29T07:54:59Z","sourceDescriptors":["anilist:208754","mal:63736"],"targets":[{"provider":"anidb","id":"20025","scope":"R","ranges":{"1":"1"}},{"provider":"anilist","id":"208754","ranges":{"1":"1"}},{"provider":"mal","id":"63736","ranges":{"1":"1"}},{"provider":"tmdb_movie","id":"1654313","ranges":{"1":"1"}}]},"artworkSources":{"logo":"tmdb","poster":"tmdb","background":"tmdb"},"artworkCandidates":{"logo":[{"source":"tmdb","url":"https://image.tmdb.org/t/p/original/eGQcSNTYGyTPXyd46EBa7gLJwPV.png"}],"poster":[{"source":"tmdb","url":"https://image.tmdb.org/t/p/original/5DVeBaDAdLCHlLg1nn4sjhUwgcg.jpg"},{"source":"provider","url":"https://img.an