li ingredienti necessari alla magia, sperando che le visite si prolunghino. Con sua grande sorpresa, però, Harij comincia a tornare ogni giorno non solo per la pozione, ma anche per prendersi cura di lei, portandole cibo e aiutandola nella vita quotidiana.","image":"https://image.tmdb.org/t/p/original/2mRFYYyMPI62nhZRGWmmN4eTC6I.jpg","poster":"https://image.tmdb.org/t/p/original/96ywNgKOgciVt33MFTaRLBg8Xnd.jpg","logo":"https://image.tmdb.org/t/p/original/5D9kwwmONWYhWiAAL0jMZ83Skgz.png","background":"https://image.tmdb.org/t/p/original/2mRFYYyMPI62nhZRGWmmN4eTC6I.jpg","trailers":["https://www.youtube.com/watch?v=hGRtocAh3iw"],"imdbId":"","type":"series","tags":["TV","In Corso","Autunno","2026"],"tagKeys":{"TV":"TV","In Corso":"Ongoing","Autunno":"Autumn"},"genres":["Fantasy","Romance"],"rating":"8.0","studio":"diomedéa","episodesCount":4,"extra":{"ids":{"malId":63409,"anilistId":207191,"crunchyId":"GT00378072","disneyId":null,"netflixId":null,"primeId":null,"anilistIds":[207191],"malIds":[63409],"anidbIds":[19876],"imdbMovieIds":[],"imdbShowIds":[],"tmdbMovieIds":[],"tmdbShowIds":[313068],"tvdbMovieIds":[],"tvdbShowIds":[473460]},"stats":{"scoreRaw":"7.96","favorites":250,"members":1579,"views":64142,"episodesCountRaw":4,"episodesLength":23},"flags":{"dub":0,"alwaysHome":1},"meta":{"day":"Lunedì","season":"Autunno","status":"In Corso","type":"TV","createdAt":"2026-09-23 00:17:31","userId":2},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-29T07:54:59Z","sourceDescriptors":["anilist:207191","mal:63409"],"targets":[{"provider":"anidb","id":"19876","scope":"R","ranges":{"1-12":"1-12"}},{"provider":"anilist","id":"207191","ranges":{"1-12":"1-12"}},{"provider":"mal","id":"63409","ranges":{"1-12":"1-12"}},{"provider":"tmdb_show","id":"313068","scope":"s1","ranges":{"1-12":"1-12"}},{"provider":"tvdb_show","id":"473460","scope":"s1","ranges":{"1-12":"1-12"}}]},"artworkSources":{"logo":"tmdb","poster":"tmdb","background":"tmdb"},"artworkCan