:[16]},{"provider":"tvdb_show","id":"474027","scope":"s1","seasonNumber":1,"episodeNumbers":[16]}],"link":"110758","synopsis":"A woman from Kail's past arrives with a son and a secret that shocks the royal court—and Yuri.","thumbnail":"https://image.tmdb.org/t/p/w300/6VNzf2rdYGcP2ryFvIVBzUQ4Zpw.jpg"},{"title":"Episodio 17","episodeNumber":17,"sourceEpisodeNumber":17,"seasonNumber":1,"externalMappings":[{"provider":"anilist","id":"207809","episodeNumbers":[17]},{"provider":"mal","id":"63489","episodeNumbers":[17]},{"provider":"tmdb_show","id":"314054","scope":"s1","seasonNumber":1,"episodeNumbers":[17]},{"provider":"tvdb_show","id":"474027","scope":"s1","seasonNumber":1,"episodeNumbers":[17]}],"link":"110879","synopsis":"ギュゼルの子を利用した策略の裏に、ナキア皇太后の企みがあると睨むカイルたち。そんな中、ウルスラは皇太后の宮で不審な動きを目撃し、密かにその証拠を持ち出す。調べを進める中で、ナキアの周囲で不穏な陰謀が動いていることが判明。ユーリたちは計画を阻止しようと奔走するが、事態は思わぬ方向へ動き出し･･･。","thumbnail":"https://image.tmdb.org/t/p/w300/lcZE3JPvhWNX5IlzbYYZ2MSIfSP.jpg"}]},{"id":7788,"path":"/anime/7788-hello-i-am-a-witch-and-my-crush-wants-me-to-make-a-love-potion","info":{"title":"Hello, I am a Witch and my Crush Wants me to Make a Love Potion!","synopsis":"Rose è una giovane strega che vive da sola in una piccola capanna vicino a un lago, dedicandosi alla preparazione di pozioni e rimedi magici. Dopo la morte della nonna, è diventata piuttosto riservata e trascorre le sue giornate immersa nel suo mondo fatato, lontana dalla civiltà. Un giorno fa visita alla sua bottega Harij, un affascinante cavaliere reale per cui Rose nutre un profondo interesse romantico da molti anni… ma non immagina ciò che sta per accadere. Invece di chiederle qualcosa di banale, Harij le fa una richiesta sorprendente: \"Vorrei una pozione d’amore\". Questo semplice desiderio spezza il cuore di Rose, perché scopre che l’uomo che le piace vorrebbe una pozione per qualcun altro… o almeno così sembra. In realtà, Rose aveva già preparato in passato una pozione segreta pensando proprio a lui, ma non aveva mai avuto il coraggio di usarla. Determinata a passare più tempo con Harij, Rose decide di ingannarlo facendogli raccogliere gli ingredienti necessari alla magia, sperando che le visite si prolunghino. Con sua grande sorpresa, però, Harij comincia a tornare ogni giorno non solo per la pozione, ma anche per prendersi cura di lei, portandole cibo e aiutandola nella vita quotidiana.","image":"https://image.tmdb.org/t/p/original/2mRFYYyMPI62nhZRGWmmN4eTC6I.jpg","poster":"https://image.tmdb.org/t/p/original/96ywNgKOgciVt33MFTaRLBg8Xnd.jpg","logo":"https://image.tmdb.org/t/p/original/5D9kwwmONWYhWiAAL0jMZ83Skgz.png","background":"https://image.tmdb.org/t/p/original/2mRFYYyMPI62nhZRGWmmN4eTC6I.jpg","trailers":["https://www.youtube.com/watch?v=hGRtocAh3iw"],"imdbId":"","type":"series","tags":["TV","In Corso","Autunno","2026"],"tagKeys":{"TV":"TV","In Corso":"Ongoing","Autunno":"Autumn"},"genres":["Fantasy","Romance"],"rating":"8.0","studio":"diomedéa","episodesCount":4,"extra":{"ids":{"malId":63409,"anilistId":207191,"crunchyId":"GT00378072","disneyId":null,"netflixId":null,"primeId":null,"anilistIds":[207191],"malIds":[63409],"anidbIds":[19876],"imdbMovieIds":[],"imdbShowIds":[],"tmdbMovieIds":[],"tmdbShowIds":[313068],"tvdbMovieIds":[],"tvdbShowIds":[473460]},"stats":{"scoreRaw":"7.96","favorites":250,"members":1579,"views":64142,"episodesCountRaw":4,"episodesLength":23},"flags":{"dub":0,"alwaysHome":1},"meta":{"day":"Lunedì","season":"Autunno","status":"In Corso","type":"TV","createdAt":"2026-09-23 00:17:31","userId":2},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-28T07:48:11Z","sourceDescriptors":["anilist:207191","mal:63409"],"targets":[{"provider":"anidb","id":"19876","scope":"R","ranges":{"1-12":"1-12"}},{"provider":"anilist","id":"207191","ranges":{"1-12":"1-12"}},{"provider":"mal","id":"63409","ranges":{"1-12":"1-12"}},{"provider":"tmdb_show","id":"313068","scope":"s1","ranges":{"1-12":"1-12"}},{"provider":"tvdb_show","id":"473460","scope":"s1