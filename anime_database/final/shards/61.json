{"schemaVersion":1,"records":[{"id":7661,"path":"/anime/7661-the-dukes-son-claims-he-wont-love-me-yet-showers-me-with-adoration","info":{"title":"The Duke’s Son Claims He Won’t Love Me Yet Showers Me with Adoration","synopsis":"Elsa, figlia di un nobile decaduto, riceve una proposta di matrimonio da Julius, un aristocratico. Elsa è dubbiosa e non si spiega come mai un uomo di alto rango voglia sposare proprio lei. Dopo il matrimonio Julius, che fino a quel momento si era dimostrato sempre affabile e gentile, ha un improvviso cambiamento!","image":"https://images.metahub.space/background/medium/tt41277587/img","poster":"https://artworks.thetvdb.com/banners/v4/series/474490/posters/6a44c15ecef10.jpg","logo":"https://images.metahub.space/logo/medium/tt41277587/img","background":"https://images.metahub.space/background/medium/tt41277587/img","trailers":["https://www.youtube.com/watch?v=MNzf8UswtzI"],"imdbId":"tt41277587","type":"series","tags":["TV","Terminato","Estate","2026"],"tagKeys":{"TV":"TV","Terminato":"Completed","Estate":"Summer"},"genres":["Fantasy","Romance"],"rating":"7.4","studio":"Zero-G","episodesCount":12,"extra":{"ids":{"malId":63537,"anilistId":208225,"crunchyId":"GT00378118","disneyId":null,"netflixId":null,"primeId":null,"anilistIds":[208225],"malIds":[63537],"anidbIds":[19909],"imdbMovieIds":[],"imdbShowIds":[],"tmdbMovieIds":[],"tmdbShowIds":[315054],"tvdbMovieIds":[],"tvdbShowIds":[474490]},"stats":{"scoreRaw":"7.41","favorites":217,"members":1132,"views":140818,"episodesCountRaw":12,"episodesLength":23},"flags":{"dub":0,"alwaysHome":1},"meta":{"day":"Sabato","season":"Estate","status":"Terminato","type":"TV","createdAt":"2026-07-04 13:03:17","userId":2},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-28T07:48:11Z","sourceDescriptors":["anilist:208225","mal:63537"],"targets":[{"provider":"anidb","id":"19909","scope":"R","ranges":{"1-12":"1-12"}},{"provider":"anilist","id":"208225","ranges":{"1-12":"1-12"}},{"pro