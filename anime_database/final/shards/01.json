ers/v4/series/461544/backgrounds/6a53b85e3ce17.jpg"},{"source":"anizip","url":"https://artworks.thetvdb.com/banners/v4/series/461544/backgrounds/67d89ae1d8144.jpg"},{"source":"provider","url":"https://img.animeunity.co/anime/188139-PU5JsGJiiUnR.jpg"},{"source":"anilist","url":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/188139-pS4GAV0Am2Wi.jpg"}]}},"related":[{"title":"Though I Am an Inept Villainess","link":"/anime/7637-though-i-am-an-inept-villainess","image":"https://img.animeunity.co/anime/bx188139-5QWn8R7yvjY4.png","type":"TV","year":"2026","dubStatus":"both","dubStatusKey":"Subbed and dubbed","variants":[{"status":"subbed","statusKey":"Subbed","title":"Though I Am an Inept Villainess","link":"/anime/7637-though-i-am-an-inept-villainess","image":"https://img.animeunity.co/anime/bx188139-5QWn8R7yvjY4.png"},{"status":"dubbed","statusKey":"Dubbed","title":"Though I Am an Inept Villainess","link":"/anime/7701-though-i-am-an-inept-villainess-ita","image":"https://img.animeunity.co/anime/bx188139-1qIJfWxym8FX.jpg"}]}],"linkList":[{"title":"Episodes 1-11","titleKey":"Episodes {{start}}-{{end}}","titleParams":{"start":1,"end":11},"availabilityStatus":"available","episodesLink":"7701|1|11"}]},"episodes":[{"title":"Una pessima cattiva","episodeNumber":1,"sourceEpisodeNumber":1,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"19226","scope":"R","episodeNumbers":[1]},{"provider":"anilist","id":"188139","episodeNumbers":[1]},{"provider":"mal","id":"61240","episodeNumbers":[1]},{"provider":"tmdb_show","id":"286345","scope":"s1","seasonNumber":1,"episodeNumbers":[1]},{"provider":"tvdb_show","id":"461544","scope":"s1","seasonNumber":1,"episodeNumbers":[1]}],"link":"109574","synopsis":"Cinque nobili casate risiedono nei Quartieri delle dame, una sezione della corte interna del Regno di Ei. Reirin, la dama della casata dei Kou, è la favorita del principe ereditario Gyoumei, grazie alla bellezza e alle qualità eccezionali. All'opposto, Keigetsu, dama della casata degli Shu, ha fama di essere malvagia ed è odiata da tutti a corte. Alla Festa del doppio sette, Keigetsu usa la magia proibita per scambiare il suo corpo con quello di Reirin. Quando \"Reirin\" si sveglia, Keigetsu è condannata a morte. Nonostante il pericolo imminente, la ragazza, da sempre cagionevole, è felice di trovarsi in un corpo così sano...","thumbnail":"https://image.tmdb.org/t/p/w300/wyMVCJ4pBiZRI67KU704UFEBueJ.jpg"},{"title":"Dovrò vivere qui?","episodeNumber":2,"sourceEpisodeNumber":2,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"19226","scope":"R","episodeNumbers":[2]},{"provider":"anilist","id":"188139","episodeNumbers":[2]},{"provider":"mal","id":"61240","episodeNumbers":[2]},{"provider":"tmdb_show","id":"286345","scope":"s1","seasonNumber":1,"episodeNumbers":[2]},{"provider":"tvdb_show","id":"461544","scope":"s1","seasonNumber":1,"episodeNumbers":[2]}],"link":"109677","synopsis":"A seguito del trambusto nella corte interna, la consorte imperiale Shu ordina a Reirin di cambiare residenza, mandandola sostanzialmente in esilio. Poiché la nuova sistemazione è praticamente un magazzino abbandonato, Leelee l'ancella personale di Keigetsu, sfoga tutta la frustrazione accumulata fino a quel momento. Dopo aver gridato contro Reirin, Leelee le dice che non è disposta a prendersi cura di lei e se ne va. Reirin rimane sola, piena di gioia per la sua nuova libertà...","thumbnail":"https://image.tmdb.org/t/p/w300/dn5Is4fn0PgAYBM0MPIeyAITqRe.jpg"},{"title":"Testa alta, schiena dritta","episodeNumber":3,"sourceEpisodeNumber":3,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"19226","scope":"R","episodeNumbers":[3]},{"provider":"anilist","id":"188139","episodeNumbers":[3]},{"provider":"mal","id":"61240","episodeNumbers":[3]},{"provider":"tmdb_show","id":"286345","scope":"s1","seasonNumber":1,"episodeNumbers":[3]},{"provider":"tvdb_show","id":"461544","scope":"s1","seasonNumber":1,"episodeNumbers":[3]}],"link":"109828","synopsis":"Sono passati quattro giorni dallo scambio di corpi. Reirin, bandita in un capanno all'interno del Palazzo Shu, si dedica al giardinaggio grazie al corpo in buona salute di Keigetsu. Godendo di una nuova libertà in cui non è costretta ad affidarsi agli altri, Reirin prova finalmente un senso di soddisfazione. Nel frattempo, Leelee viene spinta da Gayou, un'ancella di alto rango della casata Kin, a tormentare Reirin...","thumbnail":"https://image.tmdb.org/t/p/w300/bRRruDi2yI6nc8SPeLlYiKeBZhj.jpg"},{"title":"La mia cometa miracolosa","episodeNumber":4,"sourceEpisodeNumber":4,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"19226","scope":"R","episodeNumbers":[4]},{"provider":"anilist","id":"188139","episodeNumbers":[4]},{"provider":"mal","id":"61240","episodeNumbers":[4]},{"provider":"tmdb_show","id":"286345","scope":"s1","seasonNumber":1,"episodeNumbers":[4]},{"provider":"tvdb_show","id":"461544","scope":"s1","seasonNumber":1,"episodeNumbers":[4]}],"link":"109970","synopsis":"Keigetsu, suffering from a severe fever, controls a flame to seek help from Reirin. Reirin feels heartbroken seeing Keigetsu managing to calm herself down. Reirin suggests the cancellation of the swap, but the request is rejected. For the upcoming Ghost Festival ritual, Reirin presents Leelee with a garment she had sewn just for Leelee. Meanwhile, Leelee feels that something is off from a certain phrase Reirin unintentionally uttered.","thumbnail":"https://image.tmdb.org/t/p/w300/t0RjE9WgMGvn82JlvDUzVtekO1n.jpg"},{"title":"Chi è quella ragazza?","episodeNumber":5,"sourceEpisodeNumber":5,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"19226","scope":"R","episodeNumbers":[5]},{"provider":"anilist","id":"188139","episodeNumbers":[5]},{"provider":"mal","id":"61240","episodeNumbers":[5]},{"provider":"tmdb_show","id":"286345","scope":"s1","seasonNumber":1,"episodeNumbers":[5]},{"provider":"tvdb_show","id":"461544","scope":"s1","seasonNumber":1,"episodeNumbers":[5]}],"link":"110083","synopsis":"To settle the score with Gayou who enticed Leelee into harassment, Reirin takes Leelee in tow and heads to the Ghost Festival ritual. Not flinching that a seat was not prepared for her, Reirin wearing a handmade garment with beautiful embroidery stands dignified in the hall. In due time, the offerings of dances by the Maidens begin. Seika of the Kin clan who is hosting the ritual dances brilliantly...","thumbnail":"https://image.tmdb.org/t/p/w300/3TEdlRQDo6HJRw1yKDA8TIziOGr.jpg"},{"title":"Non vi lascerò morire","episodeNumber":6,"sourceEpisodeNumber":6,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"19226","scope":"R","episodeNumbers":[6]},{"provider":"anilist","id":"188139","episodeNumbers":[6]},{"provider":"mal","id":"61240","episodeNumbers":[6]},{"provider":"tmdb_show","id":"286345","scope":"s1","seasonNumber":1,"episodeNumbers":[6]},{"provider":"tvdb_show","id":"461544","scope":"s1","seasonNumber":1,"episodeNumbers":[6]}],"link":"110233","synopsis":"Reirin finds it suspicious that Seika said there is no one named Gayou in the Kin clan. Just when she was about to ask for details, the Kou clan court lady Tousetsu comes in with a notice that \"Reirin's\" life is in danger! Reirin wishes to save \"Reirin's\" life, but Gyoumei refuses the offer, saying he doesn't trust her. However, the empress Kou Kenshuu tells Reirin that nursing will be allowed if she can show her sincerity by drawing the Bow of Warding all night long.","thumbnail":"https://image.tmdb.org/t/p/w300/wu7LLb2weATQtKbcCMdWhnpUqiS.jpg"},{"title":"Sapete perché voglio regalarvi un'anima?","episodeNumber":7,"sourceEpisodeNumber":7,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"19226","scope":"R","episodeNumbers":[7]},{"provider":"anilist","id":"188139","episodeNumbers":[7]},{"provider":"mal","id":"61240","episodeNumbers":[7]},{"provider":"tmdb_show","id":"286345","scope":"s1","seasonNumber":1,"episodeNumbers":[7]},{"provider":"tvdb_show","id":"461544","scope":"s1","seasonNumber":1,"episodeNumbers":[7]}],"link":"110338","synopsis":"After drawing the Bow of Warding continuously, Reirin falls unconscious. Reirin awakens to see Tousetsu, who has caught onto the swapping of the Maidens. Around the same time, Keigetsu realizes that a curse was placed on a gift given to her. Meanwhile, at the Maiden Court, a tea party is being held in celebration of \"Reirin's\" recovery. There, Kenshuu reminisces about her days as a Maiden that she spent together with Shu Gabi, the Noble Consort.","thumbnail":"https://image.tmdb.org/t/p/w300/amy2hGD2e7oRZSnW4LoUvTq88i3.jpg"},{"title":"Comportati da cattiva!","episodeNumber":8,"sourceEpisodeNumber":8,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"19226","scope":"R","episodeNumbers":[8]},{"provider":"anilist","id":"188139","episodeNumbers":[8]},{"provider":"mal","id":"61240","episodeNumbers":[8]},{"provider":"tmdb_show","id":"286345","scope":"s1","seasonNumber":1,"episodeNumbers":[8]},{"provider":"tvdb_show","id":"461544","scope":"s1","seasonNumber":1,"episodeNumbers":[8]}],"link":"110430","synopsis":"Keigetsu realizes that the cause of her illness is a curse created by venomcraft, and has an idea who placed such a curse... Visitation gifts from Seika makes Reirin hypothesize that someone is scheming to make it seem as though the harassment was done by the Kin clan. Worried about Keigetsu, Reirin speaks to a flame. Keigetsu appears in the flame as if to answer that call. But then, Keigetsu asks Reirin for help...","thumbnail":"https://image.tmdb.org/t/p/w300/tcTnCHnPkseV7VJSOHrtzH5myFc.jpg"},{"title":"Vi salverò a tutti i costi","episodeNumber":9,"sourceEpisodeNumber":9,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"19226","scope":"R","episodeNumbers":[9]},{"provider":"anilist","id":"188139","episodeNumbers":[9]},{"provider":"mal","id":"61240","episodeNumbers":[9]},{"provider":"tmdb_show","id":"286345","scope":"s1","seasonNumber":1,"episodeNumbers":[9]},{"provider":"tvdb_show","id":"461544","scope":"s1","seasonNumber":1,"episodeNumbers":[9]}],"link":"110525","synopsis":"Reirin realizes that Kenshuu's agony is that of a curse, which gives her an understanding of Gabi's true objective. Reirin asks Gyoumei if she can borrow the Bow of Warding once more, but he will not heed her request. Unable to give up, Reirin heads over alone to see Keigetsu and have the swap cancelled. Right as she passes by Gyoumei, a certain image catches his eye...","thumbnail":"https://image.tmdb.org/t/p/w300/hVDWV3ZHwR8GVRSP4Kwr4oie7Wv.jpg"},{"title":"Condivideremo la maledizione","episodeNumber":10,"sourceEpisodeNumber":10,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"19226","scope":"R","episodeNumbers":[10]},{"provider":"anilist","id":"188139","episodeNumbers":[10]},{"provider":"mal","id":"61240","episodeNumbers":[10]},{"provider":"tmdb_show","id":"286345","scope":"s1","seasonNumber":1,"episodeNumbers":[10]},{"provider":"tvdb_show","id":"461544","scope":"s1","seasonNumber":1,"episodeNumbers":[10]}],"link":"110688","synopsis":"Gyoumei realizes the swap between Reirin and Keigetsu and heads over to the Kou Palace in pursuit of Reirin. Tousetsu is inquired about the circumstances by Gyoumei but cannot divulge the truth because of her promise with Reirin. Gyoumei gets the hint from Tousetsu's behavior and shows his resolve by voluntarily removing his crown. Meanwhile, Reirin heads back to the Shu Palace with Keigetsu in tow to deal with the curse...","thumbnail":"https://image.tmdb.org/t/p/w300/rbLxx4bizOF57HWGEAFizZHITWm.jpg"},{"title":"Una cattiva coi fiocchi","episodeNumber":11,"sourceEpisodeNumber":11,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"19226","scope":"R","episodeNumbers":[11]},{"provider":"anilist","id":"188139","episodeNumbers":[11]},{"provider":"mal","id":"61240","episodeNumbers":[11]},{"provider":"tmdb_show","id":"286345","scope":"s1","seasonNumber":1,"episodeNumbers":[11]},{"provider":"tvdb_show","id":"461544","scope":"s1","seasonNumber":1,"episodeNumbers":[11]}],"link":"110859","synopsis":"With the plans to murder Kenshuu using a curse out in the open, Gabi is cornered. She tries to slash Reirin, but is pinned down on the spot. With everything settled, Reirin and Keigetsu decide to cancel the swap. As they are enveloped in flames, the two Maidens tell each other how they feel...","thumbnail":"https://image.tmdb.org/t/p/w300/6bLSYTdPbTS79f9AKwshS0Osby1.jpg"}]},{"id":7801,"path":"/anime/7801-fx-fighter-kurumi-chan","info":{"title":"FX Fighter Kurumi-chan","synopsis":"Kurumi Fukuga è una studentessa universitaria di 20 anni segnata da un evento traumatico del suo passato. Anni prima, sua madre si era avvicinata al mondo del trading Forex (FX) nella speranza di guadagnare facilmente, ma una grave crisi finanziaria e decisioni sbagliate la portarono ad accumulare un debito enorme. Schiacciata dalla vergogna e dalla disperazione, la donna si tolse la vita, lasciando Kurumi con un profondo senso di colpa e rimpianto. Decisa a dare un significato a quella tragedia, Kurumi sceglie di affrontare lo stesso mondo che ha distrutto la sua famiglia: il mercato FX. Il suo obiettivo è chiaro e ossessivo, recuperare i 20 milioni di yen perduti dalla madre. Tra grafici, operazioni rischiose e continui sbalzi emotivi, Kurumi scopre quanto il trading possa essere crudele e psicologicamente logorante.","image":"https://image.tmdb.org/t/p/original/nqvn22IXcOvHHmNShCX4iqmQE7R.jpg","poster":"https://image.tmdb.org/t/p/original/fHEkrlHF9MXtbumo23C4mrAlDgs.jpg","logo":"https://image.tmdb.org/t/p/original/8Obg1bImnamzDmhSaUATI4eKN80.png","background":"https://image.tmdb.org/t/p/original/nqvn22IXcOvHHmNShCX4iqmQE7R.jpg","trailers":["https://www.youtube.com/watch?v=7rxIZ3z0S4s"],"imdbId":"","type":"series","tags":["TV","In Corso","Autunno","2026"],"tagKeys":{"TV":"TV","In Corso":"Ongoing","Autunno":"Autumn"},"genres":["Drama","Psychological","Seinen","Slice of Life"],"rating":"