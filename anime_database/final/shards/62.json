:[{"title":"Episodio 15","episodeNumber":1,"sourceEpisodeNumber":1,"seasonNumber":0,"externalMappings":[{"provider":"anilist","id":"20582","episodeNumbers":[1]},{"provider":"mal","id":"21797","episodeNumbers":[1]},{"provider":"tmdb_show","id":"45501","scope":"s0","seasonNumber":0,"episodeNumbers":[15]},{"provider":"tvdb_show","id":"261862","scope":"s0","seasonNumber":0,"episodeNumbers":[11]}],"link":"110068","synopsis":"Shinka's attempts at getting Kumin out of a kotatsu are met with some unexpected resistance.","thumbnail":"https://image.tmdb.org/t/p/w300/lOYRizTMsXNRRI11SSzZm9uWqyQ.jpg"},{"title":"Episodio 16","episodeNumber":2,"sourceEpisodeNumber":2,"seasonNumber":0,"externalMappings":[{"provider":"anilist","id":"20582","episodeNumbers":[2]},{"provider":"mal","id":"21797","episodeNumbers":[2]},{"provider":"tmdb_show","id":"45501","scope":"s0","seasonNumber":0,"episodeNumbers":[16]},{"provider":"tvdb_show","id":"261862","scope":"s0","seasonNumber":0,"episodeNumbers":[12]}],"link":"110069","synopsis":"In the clubroom, Yūta Togashi deals with Rikka Takanashi, who puts on a second eyepatch on her left eye after she gets infected with a stye, making her spatially blind. The other girls listen from the outside when Yūta tries to apply eye drops into Rikka's infected left eye.","thumbnail":"https://image.tmdb.org/t/p/w300/papPos8jBf0QH1XsVjhr7e6K8TR.jpg"},{"title":"Episodio 17","episodeNumber":3,"sourceEpisodeNumber":3,"seasonNumber":0,"externalMappings":[{"provider":"anilist","id":"20582","episodeNumbers":[3]},{"provider":"mal","id":"21797","episodeNumbers":[3]},{"provider":"tmdb_show","id":"45501","scope":"s0","seasonNumber":0,"episodeNumbers":[17]},{"provider":"tvdb_show","id":"261862","scope":"s0","seasonNumber":0,"episodeNumbers":[13]}],"link":"110070","synopsis":"One day in junior high school, Tomo was roped into helping Rikka develop her apparent abilities. Rikka used Zener cards to test clairvoyance and determined the gender of who entered the classroom to test foresight, both with negative results.","thumbnail":"https://image.tmdb.org/t/p/w300/wE90oMcdMHWOf6Zo9E8cCI88vyx.jpg"},{"title":"Episodio 18","episodeNumber":4,"sourceEpisodeNumber":4,"seasonNumber":0,"externalMappings":[{"provider":"anilist","id":"20582","episodeNumbers":[4]},{"provider":"mal","id":"21797","episodeNumbers":[4]},{"provider":"tmdb_show","id":"45501","scope":"s0","seasonNumber":0,"episodeNumbers":[18]},{"provider":"tvdb_show","id":"261862","scope":"s0","seasonNumber":0,"episodeNumbers":[14]}],"link":"110071","synopsis":"In the clubroom, Yūta, Kumin, and Makoto Isshiki witness Shinka and Sanae Dekomori playing a game of Old Maid. After ten minutes, the game reaches a climax, in which the last card is torn in half due to Sanae refusing to hand it over to Shinka, thus they both lose and continue to bicker on their way home on a rainy day.","thumbnail":"https://image.tmdb.org/t/p/w300/aMZD8u7hvobCc4z5blW6Rvc2rCX.jpg"},{"title":"Episodio 19","episodeNumber":5,"sourceEpisodeNumber":5,"seasonNumber":0,"externalMappings":[{"provider":"anilist","id":"20582","episodeNumbers":[5]},{"provider":"mal","id":"21797","episodeNumbers":[5]},{"provider":"tmdb_show","id":"45501","scope":"s0","seasonNumber":0,"episodeNumbers":[19]},{"provider":"tvdb_show","id":"261862","scope":"s0","seasonNumber":0,"episodeNumbers":[15]}],"link":"110072","synopsis":"Kuzuha Togashi deals with Yūta during his chūnibyō persona during a camping trip. While going to fetch water at a nearby stream, Yūta protects Kuzuha from chestnuts on the ground. The rest of the family later enjoys a meal of curry, but Kuzuha notices that Yūta is sitting by the campfire with a block of meat.","thumbnail":"https://image.tmdb.org/t/p/w300/wLhYHEZNc3qqAqtQpH6vZZKY2EH.jpg"},{"title":"Episodio 20","episodeNumber":6,"sourceEpisodeNumber":6,"seasonNumber":0,"externalMappings":[{"provider":"anilist","id":"20582","episodeNumbers":[6]},{"provider":"mal","id":"21797","episodeNumbers":[6]},{"provider":"tmdb_show","id":"45501","scope":"s0","seasonNumber":0,"episodeNumbers":[20]},{"provider":"tvdb_show","id":"261862","scope":"s0","seasonNumber":0,"episodeNumbers":[16]}],"link":"110073","synopsis":"In the past, Shinka and Satone Shichimiya spent a day with their two friends attempting to summon an archangel via summoning circle. The paper vessel ended up flying up in the sky due to the wind. In the present, Satone tells this story to Kumin in the clubroom, which embarrasses Shinka.","thumbnail":"https://image.tmdb.org/t/p/w300/xkY0MOg6M9cEHARgIu5Q209OJUI.jpg"}]},{"id":7862,"path":"/anime/7862-puella-magi-madoka-magica-the-movie-rebellion","info":{"title":"Puella Magi Madoka Magica the Movie: Rebellion","synopsis":"Il terzo e ultimo dei tre lungometraggi dedicati a Madoka Magica. Madoka, Sayaka, Kyoko, Mami e Homura sono delle maghe che lottano quotidianamente, fianco a fianco, contro degli esseri malvagi chiamati \"Nightmare\" che infestano la città di Mitakihara. Tuttavia nella mente di Homura riaffiorano ricordi che le fanno dubitare dell'esistenza stessa del mondo che le circonda: che tutto questo sia opera di una strega?","image":"https://image.tmdb.org/t/p/original/vIXEQ5uE2TEkWKTLytcfPejmEqd.jpg","poster":"https://image.tmdb.org/t/p/original/6FucJWVwSnOXUAXWkdDAB3F5ewP.jpg","logo":"https://image.tmdb.org/t/p/original/1Y0IP6vTPNHTm6SnMZpADaxts5e.png","background":"https://image.tmdb.org/t/p/original/vIXEQ5uE2TEkWKTLytcfPejmEqd.jpg","trailers":["https://www.youtube.com/watch?v=Xk2A3zKYIrI"],"imdbId":"tt2457282","type":"movie","tags":["Movie","Terminato","Autunno","2013"],"tagKeys":{"Movie":"Movie","Terminato":"Completed","Autunno":"Autumn"},"genres":["Drama","Fantasy","Mahou Shoujo","Mystery","Psychological","Thriller"],"rating":"8.9","studio":"Shaft","episodesCount":1,"extra":{"ids":{"malId":11981,"anilistId":11981,"crunchyId":null,"disneyId":null,"netflixId":null,"primeId":null,"anilistIds":[11977,11979,11981,133007],"malIds":[11977,11981,48820],"anidbIds":[8778,16278],"imdbMovi