ca, scompare improvvisamente, lasciando dietro di sé solo un disperato messaggio di aiuto. Spinto dalla volontà di salvarla e di scoprire la verità, Ageha decide di usare la scheda. In questo modo viene trasportato in Psyren, un mondo ostile e pericoloso in cui la sopravvivenza è tutt'altro che garantita. Qui incontra altri partecipanti come lui e scopre di poter risvegliare poteri psichici, indispensabili per affrontare le minacce che lo circondano. Tra combattimenti, prove sempre più dure e misteri irrisolti, Ageha dovrà lottare per restare vivo e trovare un modo per riportare a casa Sakurako.","image":"https://image.tmdb.org/t/p/original/avOHprINAK61GJg40CfIiWMnDX8.jpg","poster":"https://image.tmdb.org/t/p/original/3imj2VLU77bLOyJ4aPnEUlpJZDX.jpg","logo":"https://image.tmdb.org/t/p/original/4p8RNcI2CpZ4xHRWD8EFxViHcMd.png","background":"https://image.tmdb.org/t/p/original/avOHprINAK61GJg40CfIiWMnDX8.jpg","trailers":["https://www.youtube.com/watch?v=fmUpSXFbSK0"],"imdbId":"","type":"series","tags":["TV","In Corso","Autunno","2026"],"tagKeys":{"TV":"TV","In Corso":"Ongoing","Autunno":"Autumn"},"genres":["Action","Adventure","Sci-fi"],"rating":"7.5","studio":"Satelight","episodesCount":4,"extra":{"ids":{"malId":63098,"anilistId":204011,"crunchyId":"GT00371866","disneyId":null,"netflixId":null,"primeId":null,"anilistIds":[204011],"malIds":[63098],"anidbIds":[19765],"imdbMovieIds":[],"imdbShowIds":[],"tmdbMovieIds":[],"tmdbShowIds":[297903],"tvdbMovieIds":[],"tvdbShowIds":[471609]},"stats":{"scoreRaw":"7.48","favorites":151,"members":937,"views":57570,"episodesCountRaw":4,"episodesLength":23},"flags":{"dub":0,"alwaysHome":1},"meta":{"day":"Lunedì","season":"Autunno","status":"In Corso","type":"TV","createdAt":"2026-09-23 00:17:47","userId":2},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-29T07:54:59Z","sourceDescriptors":["anilist:204011","mal:63098"],"targets":[{"provider":"anidb","id":"19765","scope":"R","ranges":{"1-2":"1-2"}},{