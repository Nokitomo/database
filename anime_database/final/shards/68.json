{"schemaVersion":1,"records":[{"id":7768,"path":"/anime/7768-seeing-double","info":{"title":"Seeing Double","synopsis":"Seo-woo si ricongiunge con Ra-on, la ragazza di cui era innamorato ai tempi della scuola. A causa della sua timidezza, decide di chiedere al fratello gemello Jae-woo di corteggiarla al posto suo. Tuttavia, quello che inizialmente non prova alcun interesse per lei finisce inaspettatamente per innamorarsi di Ra-on. Ha così inizio un intenso triangolo amoroso nato da una dolce cotta non corrisposta, in cui i due fratelli si ritrovano a contendersi il cuore della stessa ragazza.","image":"https://img.animeunity.co/anime/159427.jpg","poster":"https://img.animeunity.co/anime/159427.jpg","background":"https://img.animeunity.co/anime/159427.jpg","imdbId":"","type":"series","tags":["OVA","Terminato","Primavera","2026"],"tagKeys":{"OVA":"OVA","Terminato":"Completed","Primavera":"Spring"},"genres":["Boys Love","School"],"rating":"7.1","studio":"Laftel","episodesCount":4,"extra":{"ids":{"crunchyId":null,"disneyId":null,"netflixId":null,"primeId":null,"anilistIds":[],"malIds":[],"anidbIds":[],"imdbMovieIds":[],"imdbShowIds":[],"tmdbMovieIds":[],"tmdbShowIds":[],"tvdbMovieIds":[],"tvdbShowIds":[]},"stats":{"scoreRaw":"7.07","favorites":21,"members":125,"views":19417,"episodesCountRaw":4,"episodesLength":1},"flags":{"dub":0,"alwaysHome":1},"meta":{"day":"Indeterminato","season":"Primavera","status":"Terminato","type":"OVA","createdAt":"2026-09-19 12:36:54","userId":2},"artworkSources":{"logo":"provider","poster":"provider"},"artworkCandidates":{"logo":[],"poster":[{"source":"provider","url":"https://img.animeunity.co/anime/159427.jpg"}],"background":[]}},"related":[],"linkList":[{"title":"Episodes 1-4","titleKey":"Episodes {{start}}-{{end}}","titleParams":{"start":1,"end":4},"availabilityStatus":"available","episodesLink":"7768|1|4"}]},"episodes":[{"title":"Episode 1","titleKey":"Episode {{number}}","titleParams":{"number":"1"},"episodeNumber":1,"sourceEpisodeNum