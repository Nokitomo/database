:"s1","seasonNumber":1,"episodeNumbers":[9]},{"provider":"tvdb_show","id":"467414","scope":"s1","seasonNumber":1,"episodeNumbers":[9]}],"link":"108531","synopsis":"Juzo races to Noren's side. Meanwhile, Tenma and Eiji clash in an outrageous soccer-vs.-explosive-golf battle. Tenma prepares to end the fight with a move he developed in practice. But at the end of the life-or-death struggle against Kazuma and Eiji, the unconscious Noren awakens, and the first thing she sees is...","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/11704245/screencap/6a22c4783d622.jpg"},{"title":"Death or Kiss","episodeNumber":10,"sourceEpisodeNumber":10,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"19546","scope":"R","episodeNumbers":[10]},{"provider":"anilist","id":"198113","episodeNumbers":[10]},{"provider":"mal","id":"62391","episodeNumbers":[10]},{"provider":"tmdb_show","id":"300131","scope":"s1","seasonNumber":1,"episodeNumbers":[10]},{"provider":"tvdb_show","id":"467414","scope":"s1","seasonNumber":1,"episodeNumbers":[10]}],"link":"108699","synopsis":"After Kazuma’s hypnosis makes Noren fall deeply for Juzo, she launches an all-out attack on his heart. But when Juzo gently turns her down, she tries to jump from the roof! Desperate to undo the spell, Juzo takes Noren to meet Kazuma at an amusement park, only to end up alone with her on a Ferris wheel, where things take a dangerously romantic turn?!","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/11704246/screencap/6a2c01561259a.jpg"},{"title":"The First Hitman Summit","episodeNumber":11,"sourceEpisodeNumber":11,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"19546","scope":"R","episodeNumbers":[11]},{"provider":"anilist","id":"198113","episodeNumbers":[11]},{"provider":"mal","id":"62391","episodeNumbers":[11]},{"provider":"tmdb_show","id":"300131","scope":"s1","seasonNumber":1,"episodeNumbers":[11]},{"provider":"tvdb_show","id":"467414","scope":"s1","seasonNumber":1,"episodeNumbers":[11]}],"link":"109021","synopsis":"Juzo has been enjoying a peaceful school life, but that ends when Kazuma and Eiji transfer in, bringing the total number of assassins infiltrating his middle school to four. Meanwhile, the Home Ec Club holds a serious ramen-making contest. Paired with Noren, Juzo heads out to research ramen shops and saves a girl from being hit by a truck. But just who is she?","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/11704247/screencap/6a352618a7e0b.jpg"},{"title":"Life Paths","episodeNumber":12,"sourceEpisodeNumber":12,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"19546","scope":"R","episodeNumbers":[12]},{"provider":"anilist","id":"198113","episodeNumbers":[12]},{"provider":"mal","id":"62391","episodeNumbers":[12]},{"provider":"tmdb_show","id":"300131","scope":"s1","seasonNumber":1,"episodeNumbers":[12]},{"provider":"tvdb_show","id":"467414","scope":"s1","seasonNumber":1,"episodeNumbers":[12]}],"link":"109186","synopsis":"Unicorn Mai Otohime is a marine-sports prodigy with expert-level ocean knowledge. She has come for a Mitsuoka Duel too, but her target is Juzo. This leads to Noren challenging Mai herself. As the duel nears, Juzo and the others face parent-teacher conferences and questions about their futures, leading Juzo to reflect on his school life, the friends he’s made, and the possibilities ahead.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/11704248/screencap/6a3ec3b394342.jpg"}]},{"id":7666,"path":"/anime/7666-magical-girl-lyrical-nanoha-exceeds-gun-blaze-vengeance","info":{"title":"Magical Girl Lyrical Nanoha EXCEEDS Gun Blaze Vengeance","synopsis":"Trent’anni fa, l’improvvisa comparsa di misteriose forme di vita aliene rischiò di distruggere il mondo. Da allora, l’umanità e queste “Specie Invasive” continuano a scontrarsi per il territorio, rendendo il pianeta un luogo pericoloso e precario. Per affrontare la minaccia, le Nazioni Unite creano EXCEEDS, un’organizzazione incaricata di studiare e combattere queste creature. Nell’isola orientale di Mizuho, Shiina Kuze, giovane cacciatrice di specie invasive, vive con la sorella minore Setsuna; tutto sembra tranquillo, finché un incidente imprevisto la trascina in un conflitto ben più grande di lei...","image":"https://live.metahub.space/background/medium/tt39311004/img","poster":"https://artworks.thetvdb.com/banners/v4/season/28047/posters/64f78a9ada39c.jpg","logo":"https://live.metahub.space/logo/medium/tt39311004/img","background":"https://live.metahub.space/background/medium/tt39311004/img","trailers":["https://www.youtube.com/watch?v=4IcEbMCW-FU"],"imdbId":"tt39311004","type":"series","tags":["TV","Terminato","Estate","2026"],"tagKeys":{"TV":"TV","Terminato":"Completed","Estate":"Summer"},"genres":["Action","Comedy","Drama","Fantasy","Mahou Shoujo"],"rating":"7.6","studio":"Seven Arcs","episodesCount":12,"extra":{"ids":{"malId":60637,"anilistId":185875,"crunchyId":"GT00378090","disneyId":null,"netflixId":null,"primeId":null,"anilistIds":[185875],"malIds":[60637],"anidbIds":[19080],"imdbMovieIds":[],"imdbShowIds":[],"tmdbMovieIds":[],"tmdbShowIds":[287075],"tvdbMovieIds":[],"tvdbShowIds":[458309]},"stats":{"scoreRaw":"7.58","favorites":52,"members":323,"views":53133,"episodesCountRaw":12,"episodesLength":23},"flags":{"dub":0,"alwaysHome":1},"meta":{"day":"Sabato","season":"Estate","status":"Terminato","type":"TV","createdAt":"2026-07-04 17:37:11","userId":2},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-28T07:48:11Z","sourceDescriptors":["anilist:185875","mal:60637"],"imdbSource":"plexanibridge-v2","targets":[{"provider":"anidb","id":"19080","scope":"R","ranges":{"1-12":"1-12"}},{"provider":"anilist","id":"185875","ranges":{"1-12":"1-12"}},{"provider":"mal","id":"60637","ranges":{"1-12":"1-12"}},{"provider":"tmdb_show","id":"287075","scope":"s1","ranges":{"1-12":"1-12"}},{"provider":"tvdb_show","id":"458309","scope":"s1","ranges":{"1-12":"1-12"}}]},