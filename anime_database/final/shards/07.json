rs/v4/episode/9360940/screencap/6362eff2ccfbd.jpg"},{"title":"Transmission 1: Winter Break","episodeNumber":7,"sourceEpisodeNumber":7,"seasonNumber":3,"externalMappings":[{"provider":"anidb","id":"16915","scope":"R","episodeNumbers":[7]},{"provider":"anilist","id":"140439","episodeNumbers":[7]},{"provider":"mal","id":"50172","episodeNumbers":[7]},{"provider":"tmdb_show","id":"67075","scope":"s3","seasonNumber":3,"episodeNumbers":[7]},{"provider":"tvdb_show","id":"307375","scope":"s3","seasonNumber":3,"episodeNumbers":[7]}],"link":"108649","synopsis":"Kurata Tome has always dreamed about communicating with the universe through telepathy, and now, her high school graduation was drawing nearer. When they are about to start winter break, she tells the Telepathy Club that she is going to disband them.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/9360941/screencap/636c447f593f3.jpg"},{"title":"Transmission 2: Encountering the Unknown","episodeNumber":8,"sourceEpisodeNumber":8,"seasonNumber":3,"externalMappings":[{"provider":"anidb","id":"16915","scope":"R","episodeNumbers":[8]},{"provider":"anilist","id":"140439","episodeNumbers":[8]},{"provider":"mal","id":"50172","episodeNumbers":[8]},{"provider":"tmdb_show","id":"67075","scope":"s3","seasonNumber":3,"episodeNumbers":[8]},{"provider":"tvdb_show","id":"307375","scope":"s3","seasonNumber":3,"episodeNumbers":[8]}],"link":"108651","synopsis":"The group somehow finally makes it to the summit of Mt. Mudboat. Takenaka had been up all night reading all the texts about UFOs and the Telepathy Club comes together to send a telepathic message into space, but there is no UFO in sight.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/9360942/screencap/6375074f16116.jpg"},{"title":"Mob 1: Moving","episodeNumber":9,"sourceEpisodeNumber":9,"seasonNumber":3,"externalMappings":[{"provider":"anidb","id":"16915","scope":"R","episodeNumbers":[9]},{"provider":"anilist","id":"140439","episodeNumbers":[9]},{"provid