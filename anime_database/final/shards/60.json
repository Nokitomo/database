how","id":"236994","scope":"s1","seasonNumber":1,"episodeNumbers":[2]},{"provider":"tvdb_show","id":"440820","scope":"s1","seasonNumber":1,"episodeNumbers":[2]}],"link":"110190","synopsis":"La cospirazione di Gomah ha fatto rimpicciolire Goku e i suoi amici, che si preparano per un viaggio nel mondo demoniaco. Goku ritrova con emozione il suo bastone Nyoi, ed è proprio allora che appare il misterioso giovane Majin Glorio!","thumbnail":"https://image.tmdb.org/t/p/w300/giQ1sfpyPvnxcfJCXiHidPVYAyb.jpg"},{"title":"Daima","episodeNumber":3,"sourceEpisodeNumber":3,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"18238","scope":"R","episodeNumbers":[3]},{"provider":"mal","id":"56894","episodeNumbers":[3]},{"provider":"tmdb_show","id":"236994","scope":"s1","seasonNumber":1,"episodeNumbers":[3]},{"provider":"tvdb_show","id":"440820","scope":"s1","seasonNumber":1,"episodeNumbers":[3]}],"link":"110281","synopsis":"Goku, Kaiohshin e Glorio partono alla volta del Regno Demoniaco, viaggiando con il loro aereo attraverso lo spazio e dimensioni misteriose. Giungono infine all’entrata del Regno Demoniaco, il “Terzo Mondo Demoniaco”.","thumbnail":"https://image.tmdb.org/t/p/w300/j4E7fEAPaVlM9u4P90I2Q3BtogF.jpg"},{"title":"Una coppia frizzante","episodeNumber":4,"sourceEpisodeNumber":4,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"18238","scope":"R","episodeNumbers":[4]},{"provider":"mal","id":"56894","episodeNumbers":[4]},{"provider":"tmdb_show","id":"236994","scope":"s1","seasonNumber":1,"episodeNumbers":[4]},{"provider":"tvdb_show","id":"440820","scope":"s1","seasonNumber":1,"episodeNumbers":[4]}],"link":"110282","synopsis":"Costretti a farsi strada a piedi attraverso il Terzo Mondo dei Demoni, Goku e i suoi compagni si fermano in un drive-in solitario lungo il percorso. Lì incontrano alcuni strani souvenir e una donna Majin piuttosto loquace e stravagante insieme a suo marito!","thumbnail":"https://image.tmdb.org/t/p/w300/cig3XdGMpGWUQkajoGSQU9Fry1W.jpg"},{"title":"Panzy","episodeNumber":5,"sourceEpisodeNumber":5,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"18238","scope":"R","episodeNumbers":[5]},{"provider":"mal","id":"56894","episodeNumbers":[5]},{"provider":"tmdb_show","id":"236994","scope":"s1","seasonNumber":1,"episodeNumbers":[5]},{"provider":"tvdb_show","id":"440820","scope":"s1","seasonNumber":1,"episodeNumbers":[5]}],"link":"110398","synopsis":"Il Majin mascherato che è apparso davanti a Goku e ai suoi compagni è in realtà una bambina di nome Panzy! Mentre Glorio la ignora freddamente, Panzy insiste per fare da guida. Il gruppo arriva davanti a un castello sospetto!","thumbnail":"https://image.tmdb.org/t/p/w300/oxkBT8aiQWEEQhLHUIqYCpcU7dP.jpg"},{"title":"Fulmini","episodeNumber":6,"sourceEpisodeNumber":6,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"18238","scope":"R","episodeNumbers":[6]},{"provider":"mal","id":"56894","episodeNumbers":[6]},{"provider":"tmdb_show","id":"236994","scope":"s1","seasonNumber":1,"episodeNumbers":[6]},{"provider":"tvdb_show","id":"440820","scope":"s1","seasonNumber":1,"episodeNumbers":[6]}],"link":"110399","synopsis":"Dopo un incontro con la polizia militare a guardia del Regno Demoniaco, i quattro trovano riparo in una grotta, dove però li attendono altri guai! Per risolvere la situazione, l'enigmatico Glorio scatena i suoi fulmini magici contro Goku.","thumbnail":"https://image.tmdb.org/t/p/w300/sqrlnH3tLl3JMUJHlCAUUQ8lVt5.jpg"},{"title":"Il collare","episodeNumber":7,"sourceEpisodeNumber":7,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"18238","scope":"R","episodeNumbers":[7]},{"provider":"mal","id":"56894","episodeNumbers":[7]},{"provider":"tmdb_show","id":"236994","scope":"s1","seasonNumber":1,"episodeNumbers":[7]},{"provider":"tvdb_show","id":"440820","scope":"s1","seasonNumber":1,"episodeNumbers":[7]}],"link":"110582","synopsis":"Goku e i suoi compagni continuano il loro viaggio ma vengono individuati dalla polizia militare, probabilmente per via del collare magico al collo di Panzy. Riuscirà il nuovo legame d’amicizia a salvare Panzy dal pericolo?","thumbnail":"https://image.tmdb.org/t/p/w300/pRXR1zSSIbiDKpBNulx7lZCtT3t.jpg"},{"title":"Il Tamagami","episodeNumber":8,"sourceEpisodeNumber":8,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"18238","scope":"R","episodeNumbers":[8]},{"provider":"mal","id":"56894","episodeNumbers":[8]},{"provider":"tmdb_show","id":"236994","scope":"s1","seasonNumber":1,"episodeNumbers":[8]},{"provider":"tvdb_show","id":"440820","scope":"s1","seasonNumber":1,"episodeNumbers":[8]}],"link":"110583","synopsis":"Ha inizio lo scontro con uno dei guardiani imbattuti delle Sfere del Drago, un Tamagami! Panzy e tutti gli altri assistono col fiato sospeso al combattimento tra Goku e quest’ultimo. La battaglia infuria, ma come andrà a finire?","thumbnail":"https://image.tmdb.org/t/p/w300/3KbtT3bWqcQieS71dLBtpxeZLL2.jpg"},{"title":"Ladri","episodeNumber":9,"sourceEpisodeNumber":9,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"18238","scope":"R","episodeNumbers":[9]},{"provider":"mal","id":"56894","episodeNumbers":[9]},{"provider":"tmdb_show","id":"236994","scope":"s1","seasonNumber":1,"episodeNumbers":[9]},{"provider":"tvdb_show","id":"440820","scope":"s1","seasonNumber":1,"episodeNumbers":[9]}],"link":"110584","synopsis":"Tutto il Regno Demoniaco parla dell’impresa di Goku che, per evitare guai, indossa un travestimento in un hotel. Tuttavia, lo stratagemma fallisce e Goku non può abbassare la guardia nemmeno per un attimo, poiché dei ladri lo riconoscono!","thumbnail":"https://image.tmdb.org/t/p/w300/2d3UZpI07m03dL68tlKzjFTyiwb.jpg"},{"title":"L'oceano","episodeNumber":10,"sourceEpisodeNumber":10,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"18238","scope":"R","episodeNumbers":[10]},{"provider":"mal","id":"56894","episodeNumbers":[10]},{"provider":"tmdb_show","id":"236994","scope":"s1","seasonNumber":1,"episodeN