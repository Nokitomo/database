padre come al solito fa ogni scelta, mentre Inako è sempre più vicina ad arrendersi al suo destino, ma ecco che Kihachi la convince a fuggire via da casa. L’unico modo per impedire il matrimonio è trovare un libro chiamato “Il Catalogo dell’Elettricità”, scritto da Kihachi ma preso da suo fratello Seiroku. Inako e Kihachi viaggiano insieme per ritrovarlo tra le prefetture di Kyoto e Shiga.","image":"https://image.tmdb.org/t/p/original/uI8e54LXFazUjOQ8n4K2FapSIdo.jpg","poster":"https://image.tmdb.org/t/p/original/yDTcX4l5D3OFeYGsQVI5Jqxx1D7.jpg","logo":"https://image.tmdb.org/t/p/original/KHWtztbgwrmFfw9nChveLfIIIH.png","background":"https://image.tmdb.org/t/p/original/uI8e54LXFazUjOQ8n4K2FapSIdo.jpg","trailers":["https://www.youtube.com/watch?v=-W2vs2etG9o"],"imdbId":"","type":"series","tags":["TV","Terminato","Estate","2026"],"tagKeys":{"TV":"TV","Terminato":"Completed","Estate":"Summer"},"genres":["Adventure","Drama","Historical","Romance"],"rating":"8.3","studio":"Kyoto Animation","episodesCount":13,"extra":{"ids":{"malId":62856,"anilistId":103303,"crunchyId":null,"disneyId":null,"netflixId":"81698957","primeId":null,"anilistIds":[103303],"malIds":[62856],"anidbIds":[14236],"imdbMovieIds":[],"imdbShowIds":[],"tmdbMovieIds":[],"tmdbShowIds":[153217],"tvdbMovieIds":[],"tvdbShowIds":[407704]},"stats":{"scoreRaw":"8.31","favorites":158,"members":707,"views":102248,"episodesCountRaw":13,"episodesLength":25},"flags":{"dub":1,"alwaysHome":1},"meta":{"day":"Domenica","season":"Estate","status":"Terminato","type":"TV","createdAt":"2026-07-06 01:33:11","userId":2},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-28T07:48:11Z","sourceDescriptors":["anilist:103303","mal:62856"],"targets":[{"provider":"anidb","id":"14236","scope":"R","ranges":{"1-13":"1-13"}},{"provider":"anilist","id":"103303","ranges":{"1-13":"1-13"}},{"provider":"mal","id":"62856","ranges":{"1-13":"1-13"}},{"provider":"tmdb_show","id":"153217","scope":"s1","ranges":{"1-13"