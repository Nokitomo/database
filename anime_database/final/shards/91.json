iston, una giovane nobildonna dalla salute fragile e dal fisico debole. Sebbene il suo nuovo corpo sia lontano dall'ideale di un combattente, Nia conserva intatta l'anima, l'esperienza e l'istinto di un guerriero senza pari. In un mondo dominato dalla magia, dalla nobiltà e da rigide convenzioni sociali, deve imparare a sopravvivere, allenarsi e crescere nonostante i limiti imposti dalla sua condizione. Mentre affronta duelli, addestramenti e intrighi, Nia percorre un cammino segnato dal desiderio di tornare sul campo di battaglia e di misurarsi finalmente con nemici degni, decisa a non lasciarsi imprigionare da una vita tranquilla che non le appartiene.","image":"https://image.tmdb.org/t/p/original/psU3bYbxQhbzED0fMTzSMygko83.jpg","poster":"https://image.tmdb.org/t/p/original/qcD7qC8i69yIwHmxv2FO185kd8k.jpg","logo":"https://image.tmdb.org/t/p/original/xBPrED5KYxU2WgNmpXcfmO4GuPt.png","background":"https://image.tmdb.org/t/p/original/psU3bYbxQhbzED0fMTzSMygko83.jpg","trailers":["https://www.youtube.com/watch?v=gxG4vntLtbk"],"imdbId":"","type":"series","tags":["TV","In Corso","Autunno","2026"],"tagKeys":{"TV":"TV","In Corso":"Ongoing","Autunno":"Autumn"},"genres":["Action","Fantasy"],"rating":"8.2","studio":"KONAMI animation","episodesCount":4,"extra":{"ids":{"malId":63382,"anilistId":206949,"crunchyId":null,"disneyId":null,"netflixId":null,"primeId":"0NXFBK3FSFBPZW6IOPSRN7U1BP","anilistIds":[206949],"malIds":[63382],"anidbIds":[19865],"imdbMovieIds":[],"imdbShowIds":[],"tmdbMovieIds":[],"tmdbShowIds":[312850],"tvdbMovieIds":[],"tvdbShowIds":[473266]},"stats":{"scoreRaw":"8.17","favorites":162,"members":1042,"views":38265,"episodesCountRaw":4,"episodesLength":24},"flags":{"dub":0,"alwaysHome":1},"meta":{"day":"Martedì","season":"Autunno","status":"In Corso","type":"TV","createdAt":"2026-09-23 00:18:17","userId":2},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-29T07:54:59Z","sourceDescriptors":["anilist:206949","mal:63382"],"target