e convenzioni sociali, deve imparare a sopravvivere, allenarsi e crescere nonostante i limiti imposti dalla sua condizione. Mentre affronta duelli, addestramenti e intrighi, Nia percorre un cammino segnato dal desiderio di tornare sul campo di battaglia e di misurarsi finalmente con nemici degni, decisa a non lasciarsi imprigionare da una vita tranquilla che non le appartiene.","image":"https://artworks.thetvdb.com/banners/v4/series/473266/backgrounds/6ac62a39060f5.jpg","poster":"https://artworks.thetvdb.com/banners/v4/series/473266/posters/6aae9e3e9d676.jpg","background":"https://artworks.thetvdb.com/banners/v4/series/473266/backgrounds/6ac62a39060f5.jpg","trailers":["https://www.youtube.com/watch?v=gxG4vntLtbk"],"imdbId":"","type":"series","tags":["TV","In Corso","Autunno","2026"],"tagKeys":{"TV":"TV","In Corso":"Ongoing","Autunno":"Autumn"},"genres":["Action","Fantasy"],"rating":"8.2","studio":"KONAMI animation","episodesCount":4,"extra":{"ids":{"malId":63382,"anilistId":206949,"crunchyId":null,"disneyId":null,"netflixId":null,"primeId":"0NXFBK3FSFBPZW6IOPSRN7U1BP","anilistIds":[206949],"malIds":[63382],"anidbIds":[19865],"imdbMovieIds":[],"imdbShowIds":[],"tmdbMovieIds":[],"tmdbShowIds":[312850],"tvdbMovieIds":[],"tvdbShowIds":[473266]},"stats":{"scoreRaw":"8.17","favorites":162,"members":1042,"views":38265,"episodesCountRaw":4,"episodesLength":24},"flags":{"dub":0,"alwaysHome":1},"meta":{"day":"Martedì","season":"Autunno","status":"In Corso","type":"TV","createdAt":"2026-09-23 00:18:17","userId":2},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-28T07:48:11Z","sourceDescriptors":["anilist:206949","mal:63382"],"targets":[{"provider":"anidb","id":"19865","scope":"R","ranges":{"1-25":"1-25"}},{"provider":"anilist","id":"206949","ranges":{"1-25":"1-25"}},{"provider":"mal","id":"63382","ranges":{"1-25":"1-25"}},{"provider":"tmdb_show","id":"312850","scope":"s1","ranges":{"1-25":"1-25"}},{"provider":"tvdb_show","id":"473266","scope"