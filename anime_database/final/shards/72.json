{"schemaVersion":1,"records":[{"id":7172,"path":"/anime/7172-tatsuki-fujimoto-17-26-ita","info":{"title":"Tatsuki Fujimoto 17-26 (ITA)","synopsis":"Un'antologia animata che raccoglie otto cortometraggi, ciascuno tratto da un racconto breve scritto dal celebre autore di Chainsaw Man tra i 17 e i 26 anni. Le storie toccano generi molto diversi, dal dramma alla commedia surreale, dal romantico al fantastico, e mostrano già in giovane età la creatività esplosiva di Fujimoto. Ogni episodio presenta protagonisti e situazioni differenti: un ragazzo che si trova a fronteggiare un proiettile capace di cambiargli la vita, amori strani e impossibili, creature marine malinconiche, improvvise trasformazioni, sorelle unite da rapporti complessi e misteriose profezie.","image":"https://live.metahub.space/background/medium/tt38491451/img","poster":"https://img.animeunity.co/anime/bx198188-h3w6uICVNhqh.png","logo":"https://live.metahub.space/logo/medium/tt38491451/img","background":"https://live.metahub.space/background/medium/tt38491451/img","trailers":["https://www.youtube.com/watch?v=xDsN2cmAlhQ"],"imdbId":"tt38491451","type":"movie","tags":["Movie","Terminato","Autunno","2025"],"tagKeys":{"Movie":"Movie","Terminato":"Completed","Autunno":"Autumn"},"genres":["Action","Comedy","Drama","Romance","School","Shounen","Supernatural"],"rating":"8.2","studio":"Studio Kafka","episodesCount":8,"extra":{"ids":{"malId":62405,"anilistId":198188,"crunchyId":null,"disneyId":null,"netflixId":null,"primeId":null,"anilistIds":[198188],"malIds":[62405],"anidbIds":[19557],"imdbMovieIds":[],"imdbShowIds":[],"tmdbMovieIds":[299778],"tmdbShowIds":[299778],"tvdbMovieIds":[467641],"tvdbShowIds":[467641]},"stats":{"scoreRaw":"8.22","favorites":167,"members":795,"views":78708,"episodesCountRaw":8,"episodesLength":19},"flags":{"dub":1,"alwaysHome":1},"meta":{"day":"Indeterminato","season":"Autunno","status":"Terminato","type":"Movie","createdAt":"2025-11-07 15:18:21","userId":2},"mappings":{"source":"anibri