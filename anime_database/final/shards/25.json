db.com/banners/v4/episode/10624334/screencap/6abbbbe58f540.jpg"},{"title":"Restare indietro nel tempo","episodeNumber":2,"sourceEpisodeNumber":2,"seasonNumber":4,"externalMappings":[{"provider":"anidb","id":"18693","scope":"R","episodeNumbers":[2]},{"provider":"mal","id":"59088","episodeNumbers":[2]},{"provider":"tmdb_show","id":"105009","scope":"s4","seasonNumber":4,"episodeNumbers":[2]},{"provider":"tvdb_show","id":"393478","scope":"s4","seasonNumber":4,"episodeNumbers":[2]}],"link":"110478","synopsis":"Following Tokyo Manji Gang's disbandment, Takemichi is about to return to his original timeline, but a forgotten Valentine's gift for Hina leads to an unexpected proposal. After burying a time capsule with his comrades and promising to meet again in 12 years, Takemichi makes a Time Leap. He arrives in a world where all his friends are living happily, but Mikey is nowhere to be found.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/10651424/screencap/6ac8492e2df56.jpg"},{"title":"Sorridi","episodeNumber":3,"sourceEpisodeNumber":3,"seasonNumber":4,"externalMappings":[{"provider":"anidb","id":"18693","scope":"R","episodeNumbers":[3]},{"provider":"mal","id":"59088","episodeNumbers":[3]},{"provider":"tmdb_show","id":"105009","scope":"s4","seasonNumber":4,"episodeNumbers":[3]},{"provider":"tvdb_show","id":"393478","scope":"s4","seasonNumber":4,"episodeNumbers":[3]}],"link":"110638","synopsis":"Twelve years later, the criminal underworld is ruled by Bonten, an organization far more vicious than the old Tokyo Manji Gang. Takemichi is stunned to learn that Bonten is led by someone from his former life. He wants to go back in time, but the power he once relied on is now out of reach. With no way back, Takemichi meets his friends to open the time capsule they buried 12 years ago.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/12025049/screencap/6acf42fe1e96b.jpg"},{"title":"Dammi una mano","episodeNumber":4,"sourceEpisodeNumber":4,"seasonNumber":4,"externalMappings":[{"provider":"anidb","id":"18693","scope":"R","episodeNumbers":[4]},{"provider":"mal","id":"59088","episodeNumbers":[4]},{"provider":"tmdb_show","id":"105009","scope":"s4","seasonNumber":4,"episodeNumbers":[4]},{"provider":"tvdb_show","id":"393478","scope":"s4","seasonNumber":4,"episodeNumbers":[4]}],"link":"110797","synopsis":"Takemichi plays the videotape Mikey slipped into the time capsule, which includes a message meant just for him. Mikey from twelve years ago reveals a darkness inside him that Shinichiro, Emma, and Baji had kept at bay. Having lost everyone who could stop him, Mikey has cut ties with Tokyo Manji Gang, distancing himself from his friends. After learning of Mikey's anguish, Takemichi ignores the danger and tries to make contact.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/12025050/screencap/6ad756624519c.jpg"}]}]}
