]},{"provider":"tvdb_show","id":"431162","scope":"s3","seasonNumber":3,"episodeNumbers":[4]}],"link":"110791","synopsis":"Trying to track down the missing final book, Maomao visits Suirei, who is now living with Ah-Duo.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/12009013/screencap/6ad9d6b91d5b3.jpg"}]},{"id":7870,"path":"/anime/7870-suikoden-the-anime","info":{"title":"Suikoden: The Anime","synopsis":"Il protagonista e il suo amico Jowy fanno parte della Brigata Giovanile degli Unicorni, un gruppo di giovani soldati coinvolto in un lungo conflitto di confine tra il Regno di Highland e le Città-Stato di Jowstown. Solo pochi mesi prima, le due fazioni avevano finalmente siglato un accordo di pace, ponendo fine agli scontri e accogliendo con sollievo la fine della guerra. Tuttavia, dietro questa fragile tregua, le tensioni non sono mai realmente svanite. Nell'ombra, le fiamme di un nuovo conflitto continuano a covare, minacciando di trasformare la pace appena conquistata in una guerra ancora più devastante.","image":"https://artworks.thetvdb.com/banners/v4/series/482279/posters/6aad48c5e1430.jpg","poster":"https://artworks.thetvdb.com/banners/v4/series/482279/posters/6aad48c5e1430.jpg","background":"https://artworks.thetvdb.com/banners/v4/series/482279/posters/6aad48c5e1430.jpg","trailers":["https://www.youtube.com/watch?v=m4T9VcBD0vo"],"imdbId":"","type":"series","tags":["TV","In Corso","Autunno","2026"],"tagKeys":{"TV":"TV","In Corso":"Ongoing","Autunno":"Autumn"},"genres":["Action","Adventure","Fantasy"],"rating":"8.2","studio":"Konami animation","episodesCount":4,"extra":{"ids":{"anilistId":187316,"crunchyId":null,"disneyId":null,"netflixId":null,"primeId":"0GWBAPSCCPCBQ1MAYNY9WPXPT6","anilistIds":[187316],"malIds":[61140],"anidbIds":[19194],"imdbMovieIds":[],"imdbShowIds":[],"tmdbMovieIds":[],"tmdbShowIds":[285710],"tvdbMovieIds":[],"tvdbShowIds":[460979,482279]},"stats":{"scoreRaw":"8.21","favorites":46,"members":270,"views":17141,"episodesCoun