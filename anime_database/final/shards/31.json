ttps://s4.anilist.co/file/anilistcdn/media/anime/banner/182616-kmIqMEUsLYrO.jpg"}]}},"related":[{"title":"The Elusive Samurai","link":"/anime/5432-the-elusive-samurai","image":"https://img.animeunity.co/anime/bx162896-hSMTVceb50GY.jpg","type":"TV","year":"2024","dubStatus":"subbed","dubStatusKey":"Subbed","variants":[{"status":"subbed","statusKey":"Subbed","title":"The Elusive Samurai","link":"/anime/5432-the-elusive-samurai","image":"https://img.animeunity.co/anime/bx162896-hSMTVceb50GY.jpg"}]},{"title":"The Elusive Samurai 2","link":"/anime/7631-the-elusive-samurai-2","image":"https://img.animeunity.co/anime/bx182616-ZOCgArw9cgqI.jpg","type":"TV","year":"2026","dubStatus":"subbed","dubStatusKey":"Subbed","variants":[{"status":"subbed","statusKey":"Subbed","title":"The Elusive Samurai 2","link":"/anime/7631-the-elusive-samurai-2","image":"https://img.animeunity.co/anime/bx182616-ZOCgArw9cgqI.jpg"}]}],"linkList":[{"title":"Episodes 1-12","titleKey":"Episodes {{start}}-{{end}}","titleParams":{"start":1,"end":12},"availabilityStatus":"available","episodesLink":"7631|1|12"}]},"episodes":[{"title":"Longing for Sea Bream!","episodeNumber":1,"sourceEpisodeNumber":1,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"18903","scope":"R","episodeNumbers":[1]},{"provider":"anilist","id":"182616","episodeNumbers":[1]},{"provider":"mal","id":"60059","episodeNumbers":[1]},{"provider":"tmdb_show","id":"222623","scope":"s2","seasonNumber":2,"episodeNumbers":[1]},{"provider":"tvdb_show","id":"432455","scope":"s2","seasonNumber":2,"episodeNumbers":[1]}],"link":"108686","synopsis":"I membri dello shogunato tessono le loro trame e il gruppo di Tokiyuki prepara il suo piatto preferito.","thumbnail":"https://image.tmdb.org/t/p/w300/zkIkqDDc738DmfT741hNKPlIJ2T.jpg"},{"title":"Episodio 2","episodeNumber":2,"sourceEpisodeNumber":2,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"18903","scope":"R","episodeNumbers":[2]},{"provider":"anilist","id":"182616","episodeNumbers":[2]},{"provider":"mal","id":"60059","episodeNumbers":[2]},{"provider":"tmdb_show","id":"222623","scope":"s2","seasonNumber":2,"episodeNumbers":[2]},{"provider":"tvdb_show","id":"432455","scope":"s2","seasonNumber":2,"episodeNumbers":[2]}],"link":"109006","synopsis":"The Ashikaga forces keep a vigilant watch across the country, searching for remnants of the Hojo clan scattered throughout Japan. Sadamune, the governor of Shinano, has grown suspicious of “Chojumaru,” a young warrior who has repeatedly distinguished himself in battle—first during the dog-shooting competition, and later on the battlefield.","thumbnail":"https://image.tmdb.org/t/p/w300/zPBDbcy3eBwPguyy0hWlU0Yxv5X.jpg"},{"title":"Episodio 3","episodeNumber":3,"sourceEpisodeNumber":3,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"18903","scope":"R","episodeNumbers":[3]},{"provider":"anilist","id":"182616","episodeNumbers":[3]},{"provider":"mal","id":"60059","episodeNumbers":[3]},{"provider":"tmdb_show","id":"222623","scope":"s2","seasonNumber":2,"episodeNumbers":[3]},{"provider":"tvdb_show","id":"432455","scope":"s2","seasonNumber":2,"episodeNumbers":[3]}],"link":"109173","synopsis":"Provincial official Kiyohara returns to Shinano after fleeing back to Kyo following the previous battle. Having grown even more ruthless, Kiyohara launches a large-scale invasion against pro-Hojo factions in northern Shinano. To oppose the combined forces of Kiyohara and Sadamune, the three great generals of the Suwa faith—Nezu, Mochizuki, and Unno, retainers directly serving Yorishige.","thumbnail":"https://image.tmdb.org/t/p/w300/uqbzSPqBxUT0yDKXI2NaqFMeu7x.jpg"},{"title":"Episodio 4","episodeNumber":4,"sourceEpisodeNumber":4,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"18903","scope":"R","episodeNumbers":[4]},{"provider":"anilist","id":"182616","episodeNumbers":[4]},{"provider":"mal","id":"60059","episodeNumbers":[4]},{"provider":"tmdb_show","id":"222623","scope":"s2","seasonNumber":2,"episodeNumbers":[4]},{"provider":"tvdb_show","id":"432455","scope":"s2","seasonNumber":2,"episodeNumbers":[4]}],"link":"109360","synopsis":"Tokiyuki and his companions race across the battlefield, sparing even the slightest moments of rest in order to relay information to their allies. However, when they arrive at the northern front where Mochizuki and Tokoiwa are fighting, what they witness is a fortress engulfed in flames, falliing into ruin... Ayako collapses in grief as she thinks of her father, Shigenobu Mochizuki.","thumbnail":"https://image.tmdb.org/t/p/w300/kFOSkyzTSrq4Gxr2ovio3BsNS4E.jpg"},{"title":"Episodio 5","episodeNumber":5,"sourceEpisodeNumber":5,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"18903","scope":"R","episodeNumbers":[5]},{"provider":"anilist","id":"182616","episodeNumbers":[5]},{"provider":"mal","id":"60059","episodeNumbers":[5]},{"provider":"tmdb_show","id":"222623","scope":"s2","seasonNumber":2,"episodeNumbers":[5]},{"provider":"tvdb_show","id":"432455","scope":"s2","seasonNumber":2,"episodeNumbers":[5]}],"link":"109504","synopsis":"The central battlefield descends into total chaos. Just as victory seems within reach for the Hoshina–Shinomiya forces, a new obstacle suddenly appears before them: Kiyohara’s newly devised battle mikoshi. Originally intended as a palanquin for issuing commands from the rear, it is now reinforced with heavy armor.","thumbnail":"https://image.tmdb.org/t/p/w300/6O5uCSow8osBNBb6Kj4fd7gib4o.jpg"},{"title":"Episodio 6","episodeNumber":6,"sourceEpisodeNumber":6,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"18903","scope":"R","episodeNumbers":[6]},{"provider":"anilist","id":"182616","episodeNumbers":[6]},{"provider":"mal","id":"60059","episodeNumbers":[6]},{"provider":"tmdb_show","id":"222623","scope":"s2","seasonNumber":2,"episodeNumbers":[6]},{"provider":"tvdb_show","id":"432455","scope":"s2","seasonNumber":2,"episodeNumbers":[6]}],"link":"109641","synopsis":"The battle ends in defeat for the Suwa Sect. Although they manage to keep casualties to a minimum, the losses they suffer are significant. As they look toward the next great conflict, everyone in the Suwa Sect comes to share an even stronger resolve. The battle becomes another valuable lesson for Tokiyuki as well—one that helps him grow even further.","thumbnail":"https://image.tmdb.org/t/p/w300/AoOSvb63DJkNBk4tRU0XNsnjdjN.jpg"},{"title":"Episodio 7","episodeNumber":7,"sourceEpisodeNumber":7,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"18903","scope":"R","episodeNumbers":[7]},{"provider":"anilist","id":"182616","episodeNumbers":[7]},{"provider":"mal","id":"60059","episodeNumbers":[7]},{"provider":"tmdb_show","id":"222623","scope":"s2","seasonNumber":2,"episodeNumbers":[7]},{"provider":"tvdb_show","id":"432455","scope":"s2","seasonNumber":2,"episodeNumbers":[7]}],"link":"109792","synopsis":"Tokiyuki’s uncle, Yasuie Hojo, is still alive! Once a key figure at the heart of the Kamakura Shogunate, Yasuie survives the fall of Kamakura. Afterward, he travels throughout the Tohoku region, continuing to fight alongside the remaining Hojo loyalists. But after suffering defeat after defeat, he eventually finds his way to Suwa.","thumbnail":"https://image.tmdb.org/t/p/w300/aKq8cxE3EgR5nwmWffKzCxHRNpg.jpg"},{"title":"Episodio 8","episodeNumber":8,"sourceEpisodeNumber":8,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"18903","scope":"R","episodeNumbers":[8]},{"provider":"anilist","id":"182616","episodeNumbers":[8]},{"provider":"mal","id":"60059","episodeNumbers":[8]},{"provider":"tmdb_show","id":"222623","scope":"s2","seasonNumber":2,"episodeNumbers":[8]},{"provider":"tvdb_show","id":"432455","scope":"s2","seasonNumber":2,"episodeNumbers":[8]}],"link":"109928","synopsis":"At the suggestion of Yorishige and Yasuie, Tokiyuki sets out for the capital, Kyo, together with the Elusive Warriors. Major Counselor Kinmune Saionji, an ally of Yasuie, awaits their arrival in Kyo. While Yasuie and Kinmune conduct a secret discussion, Tokiyuki and his companions venture out into the city.","thumbnail":"https://image.tmdb.org/t/p/w300/cnudixNIlcnD230aJrTXeDDspK0.jpg"},{"title":"Episodio 9","episodeNumber":9,"sourceEpisodeNumber":9,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"18903","scope":"R","episodeNumbers":[9]},{"provider":"anilist","id":"182616","episodeNumbers":[9]},{"provider":"mal","id":"60059","episodeNumbers":[9]},{"provider":"tmdb_show","id":"222623","scope":"s2","seasonNumber":2,"episodeNumbers":[9]},{"provider":"tvdb_show","id":"432455","scope":"s2","seasonNumber":2,"episodeNumbers":[9]}],"link":"110037","synopsis":"Having grown closer over a game of dice, Mima invites Tokiyuki and his companions on a tour of Kyo. Even though they know she is the daughter of their enemy, the Elusive Warriors accept her kindness and spend a brief, youthful moment enjoying themselves as ordinary boys and girls. However, upon returning to the Saionji's residence, Tokiyuki and the others are informed of a plan for an uprising.","thumbnail":"https://image.tmdb.org/t/p/w300/xRcKG1ifQN02KxfD4sIId9gKMRI.jpg"},{"title":"Episodio 10","episodeNumber":10,"sourceEpisodeNumber":10,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"18903","scope":"R","episodeNumbers":[10]},{"provider":"anilist","id":"182616","episodeNumbers":[10]},{"provider":"mal","id":"60059","episodeNumbers":[10]},{"provider":"tmdb_show","id":"222623","scope":"s2","seasonNumber":2,"episodeNumbers":[10]},{"provider":"tvdb_show","id":"432455","scope":"s2","seasonNumber":2,"episodeNumbers":[10]}],"link":"110187","synopsis":"Through his dialogue with the warrior Masashige Kusunoki, known as a “god of war,” Tokiyuki is moved by Kusunoki's unwavering convictions and develops an even deeper sense of confidence in the possibilities of “fleeing.” Just as he is smiling over this fortunate encounter, everything suddenly changes when he hears news of his sworn enemy Takauji’s movements.","thumbnail":"https://image.tmdb.org/t/p/w300/3f4vF5ASY6PDJJOwfbNdrFYs7cn.jpg"},{"title":"Episodio 11","episodeNumber":11,"sourceEpisodeNumber":11,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"18903","scope":"R","episodeNumbers":[11]},{"provider":"anilist","id":"182616","episodeNumbers":[11]},{"provider":"mal","id":"60059","episodeNumbers":[11]},{"provider":"tmdb_show","id":"222623","scope":"s2","seasonNumber":2,"episodeNumbers":[11]},{"provider":"tvdb_show","id":"432455","scope":"s2","seasonNumber":2,"episodeNumbers":[11]}],"link":"110302","synopsis":"Although the attempt to assassinate Takauji ends in failure, Tokiyuki has grown significantly as a warrior through his experiences in Kyo. Upon his return to Suwa, Yorishige tells him that the time has finally come. The attempted assassinations of both the Emperor and Takauji plunged Kyo into chaos, where warriors from the Kanto area were summoned and the city's defenses were reinforced.","thumbnail":"https://image.tmdb.org/t/p/w300/kJVcoU30nlYtH07tODbObii3mw6.jpg"},{"title":"Episodio 12","episodeNumber":12,"sourceEpisodeNumber":12,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"18903","scope":"R","episodeNumbers":[12]},{"provider":"anilist","id":"182616","episodeNumbers":[12]},{"provider":"mal","id":"60059","episodeNumbers":[12]},{"provider":"tmdb_show","id":"222623","scope":"s2","seasonNumber":2,"episodeNumbers":[12]},{"provider":"tvdb_show","id":"432455","scope":"s2","seasonNumber":2,"episodeNumbers":[12]}],"link":"110383","synopsis":"With preparations for war complete, the Suwa forces are finally about to ignite the great conflict. Tokiyuki is appointed commander-in-chief, taking command of the “Kamakura Party,” a unit formed from surviving retainers of the Hojo clan—while keeping his true identity hidden. Can he prove himself worthy as a leader to those who feel uneasy about serving under a child?","thumbnail":"https://image.tmdb.org/t/p/w300/A9pNtcCz4haWbeXvzcsudQPdjsl.jpg"}]},{"id":7731,"path":"/anime/7731-my-hero-academia-i-am-a-hero-too-ita","info":{"title":"My Hero Academia: I am a hero too (ITA)","synopsis":"Eri, ormai studentessa delle superiori, torna a visitare la U.A. High School, il luogo che ha segnato profondamente la sua infanzia. Durante la visita, i ricordi del passato si intrecciano con le nuove sfide del presente, mentre ritrova volti familiari e scopre quanto siano cambiati gli eroi che un tempo l'hanno salvata. Adattamento dell'omonimo one-shot pubblicato nel fanbook del 2025 Boku no Hero Academia: Ultra Age.","image":"https://artworks.thetvdb.com/banners/fanart/original/305074-12.jpg","poster":"https://artworks.thetvdb.com/banners/v4/season/649857/posters/63596d202b5e1.jpg","logo":"https://artworks.thetvdb.com/banners/v4/series/305074/clearlogo/611bb82a72c21.png","background":"https://artworks.thetvdb.com/banners/fanart/original/305074-12.jpg","imdbId":"","type":"series","tags":["Special","Terminato","Estate","2026"],"tagKeys":{"Special":"Special","Terminato":"Completed","Estate":"Summer"},"genres":["Action","Comedy","School","Shounen","Super Power"],"rating":"8.5","studio":"Bones","episodesCount":1,"extra":{"ids":{"anilistId":211711,"crunchyId":null,"disneyId":null,"netflixId":null,"primeId":null,"anilistIds":[87486,100723,105893,108553,122349,126659,126661,130183,142411,149073,168013,169402,194403,204356,211711],"malIds":[33929,35262,35459,36896,38699,39565,42603,43683,44200,50532,51781,56196,56685,60645,63130,64107],"anidbIds":[12233,12344,13633,14776,15672,15873,17356,17931,18150,18199,18921,20241],"imdbMovieIds":["tt11107074","tt13544716","tt32176689","tt7745068"],"imdbShowIds":[],"tmdbMovieIds":[505262,592350,768744,1159311],"tmdbShowIds":[65930],"tvdbMovieIds":[848,131342,157348,348893],"tvdbShowIds":[305074]},"stats":{"scoreRaw":"8.50","favorites":91,"members":384,"views":21778,"episodesCountRaw":1,"episodesLength":6},"flags":{"dub":1,"alwaysHome":1},"meta":{"day":"Indeterminato","season":"Estate","s