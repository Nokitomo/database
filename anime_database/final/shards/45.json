"available","episodesLink":"7845|1|4"}]},"episodes":[{"title":"Episode 1","episodeNumber":1,"sourceEpisodeNumber":1,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"20040","scope":"R","episodeNumbers":[1]},{"provider":"anilist","id":"211877","episodeNumbers":[1]},{"provider":"mal","id":"64131","episodeNumbers":[1]},{"provider":"tmdb_show","id":"336654","scope":"s1","seasonNumber":1,"episodeNumbers":[1]},{"provider":"tvdb_show","id":"477658","scope":"s1","seasonNumber":1,"episodeNumbers":[1]}],"link":"110443","synopsis":"Takeru's new girlfriend, Kaori, suggests they go on a karaoke date. Takeru is stumped by this unexpected request, especially since he's terrible at singing. While at a loss for words, Kaori's friend Tomoko, who just happened to be there, says she wants to join them, and the three of them end up going together.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/11781564/screencap/6ac18b3062663.jpg"},{"title":"Episode 2","episodeNumber":2,"sourceEpisodeNumber":2,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"20040","scope":"R","episodeNumbers":[2]},{"provider":"anilist","id":"211877","episodeNumbers":[2]},{"provider":"mal","id":"64131","episodeNumbers":[2]},{"provider":"tmdb_show","id":"336654","scope":"s1","seasonNumber":1,"episodeNumbers":[2]},{"provider":"tvdb_show","id":"477658","scope":"s1","seasonNumber":1,"episodeNumbers":[2]}],"link":"110548","synopsis":"After karaoke, Takeru and Kaori hold hands as they walk home, going with the flow. Kaori is thrilled that it's their first time, but Takeru is distracted, recalling his earlier interaction with Tomoko. Ignoring Takeru's distracted state, Kaori asks for a kiss and, carried away by the moment, leans in toward him.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/12018463/screencap/6acaf4c0107cb.jpg"},{"title":"Episode 3","episodeNumber":3,"sourceEpisodeNumber":3,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"20040","scope":"R","episodeNumbers":[3]},{"provider":"anilist","id":"211877","episodeNumbers":[3]},{"provider":"mal","id":"64131","episodeNumbers":[3]},{"provider":"tmdb_show","id":"336654","scope":"s1","seasonNumber":1,"episodeNumbers":[3]},{"provider":"tvdb_show","id":"477658","scope":"s1","seasonNumber":1,"episodeNumbers":[3]}],"link":"110749","synopsis":"As a sign of reconciliation, Kaori goes to Takeru's apartment. Takeru warmly encourages her while she smiles and does her best at cooking, something she's not good at. Then, Kaori, unable to hold back her emotions, throws her arms around him. Thinking that she put him off again, Kaori tries to leave, but Takeru pulls her back and kisses her.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/12018464/screencap/6ad4d765bd80e.jpg"},{"title":"Episode 4","episodeNumber":4,"sourceEpisodeNumber":4,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"20040","scope":"R","episodeNumbers":[4]},{"provider":"anilist","id":"211877","episodeNumbers":[4]},{"provider":"mal","id":"64131","episodeNumbers":[4]},{"provider":"tmdb_show","id":"336654","scope":"s1","seasonNumber":1,"episodeNumbers":[4]},{"provider":"tvdb_show","id":"477658","scope":"s1","seasonNumber":1,"episodeNumbers":[4]}],"link":"110876","synopsis":"Takeru jolts awake as the flashbacks of his encounter with Tomoko, which seemed to erase his promise to Kaori, flood his mind. When he sits up, his gaze falls on Tomoko, with whom he spent the night, as she prepares breakfast with practiced ease.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/12018465/screencap/6add61c2a2d8f.jpg"}]}]}
