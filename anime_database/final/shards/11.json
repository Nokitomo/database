ca una classe unica e mai vista: Il Discendente di Pagma. Anche se il suo livello viene resettato a 1, Grid ottiene un potere straordinario: la capacità di forgiare e soprattutto equipaggiare qualsiasi arma o armatura del gioco, ignorando ogni restrizione di livello o classe. Mentre gli altri giocatori puntano su magie e abilità di combattimento, Grid deciderà di scalare le classifiche mondiali e diventare il giocatore più forte di tutti sfruttando un'unica, devastante strategia: il potere assoluto degli oggetti.","image":"https://artworks.thetvdb.com/banners/v4/series/478752/backgrounds/6a1fd38649085.jpg","poster":"https://artworks.thetvdb.com/banners/v4/series/478752/posters/6ab5535617156.jpg","logo":"https://artworks.thetvdb.com/banners/v4/series/478752/clearlogo/6abcd20c65d7a.png","background":"https://artworks.thetvdb.com/banners/v4/series/478752/backgrounds/6a1fd38649085.jpg","trailers":["https://www.youtube.com/watch?v=e1Km0FqUZl0"],"imdbId":"","type":"series","tags":["ONA","In Corso","Autunno","2026"],"tagKeys":{"ONA":"ONA","In Corso":"Ongoing","Autunno":"Autumn"},"genres":["Action","Adventure","Comedy","Fantasy"],"rating":"8.4","studio":"J.C.STAFF","episodesCount":5,"extra":{"ids":{"malId":64340,"anilistId":212888,"crunchyId":"GT00384004","disneyId":null,"netflixId":null,"primeId":null,"anilistIds":[212888],"malIds":[64340],"anidbIds":[20077],"imdbMovieIds":[],"imdbShowIds":[],"tmdbMovieIds":[],"tmdbShowIds":[324502],"tvdbMovieIds":[],"tvdbShowIds":[478752]},"stats":{"scoreRaw":"8.37","favorites":258,"members":1091,"views":80286,"episodesCountRaw":5,"episodesLength":23},"flags":{"dub":1,"alwaysHome":1},"meta":{"day":"Domenica","season":"Autunno","status":"In Corso","type":"ONA","createdAt":"2026-09-27 15:30:35","userId":2},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-28T07:48:11Z","sourceDescriptors":["anilist:212888","mal:64340"],"targets":[{"provider":"anidb","id":"20077","scope":"R","ranges":{"1-12":"1-12"}},{"provid