i.","image":"https://image.tmdb.org/t/p/original/lGQcgSV9pplIduzSwXctUKAkt9L.jpg","poster":"https://image.tmdb.org/t/p/original/94GLmulA9qVGsuo9kLpVKi01E2Z.jpg","logo":"https://image.tmdb.org/t/p/original/ki2DwqPbI2LcWeOQrq7dtaDIHFB.png","background":"https://image.tmdb.org/t/p/original/lGQcgSV9pplIduzSwXctUKAkt9L.jpg","trailers":["https://www.youtube.com/watch?v=e1Km0FqUZl0"],"imdbId":"","type":"series","tags":["ONA","In Corso","Autunno","2026"],"tagKeys":{"ONA":"ONA","In Corso":"Ongoing","Autunno":"Autumn"},"genres":["Action","Adventure","Comedy","Fantasy"],"rating":"8.4","studio":"J.C.STAFF","episodesCount":5,"extra":{"ids":{"malId":64340,"anilistId":212888,"crunchyId":"GT00384004","disneyId":null,"netflixId":null,"primeId":null,"anilistIds":[212888],"malIds":[64340],"anidbIds":[20077],"imdbMovieIds":[],"imdbShowIds":[],"tmdbMovieIds":[],"tmdbShowIds":[324502],"tvdbMovieIds":[],"tvdbShowIds":[478752]},"stats":{"scoreRaw":"8.37","favorites":258,"members":1091,"views":80286,"episodesCountRaw":5,"episodesLength":23},"flags":{"dub":1,"alwaysHome":1},"meta":{"day":"Domenica","season":"Autunno","status":"In Corso","type":"ONA","createdAt":"2026-09-27 15:30:35","userId":2},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-28T07:48:11Z","sourceDescriptors":["anilist:212888","mal:64340"],"targets":[{"provider":"anidb","id":"20077","scope":"R","ranges":{"1-12":"1-12"}},{"provider":"anilist","id":"212888","ranges":{"1-12":"1-12"}},{"provider":"mal","id":"64340","ranges":{"1-12":"1-12"}},{"provider":"tmdb_show","id":"324502","scope":"s1","ranges":{"1-12":"1-12"}},{"provider":"tvdb_show","id":"478752","scope":"s1","ranges":{"1-12":"1-12"}}]},"artworkSources":{"logo":"tmdb","poster":"tmdb","background":"tmdb"},"artworkCandidates":{"logo":[{"source":"tmdb","url":"https://image.tmdb.org/t/p/original/ki2DwqPbI2LcWeOQrq7dtaDIHFB.png"},{"source":"anizip","url":"https://artworks.thetvdb.com/banners/v4/series/478752/clearlogo/6abcd20c65d7a.png"}],"pos