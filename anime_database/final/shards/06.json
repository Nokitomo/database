{"schemaVersion":1,"records":[{"id":7306,"path":"/anime/7306-tree-in-the-sun","info":{"title":"Tree in the Sun","synopsis":"Siamo nel Giappone di fine '800. Due uomini si contendono l'amore della figlia di un rispettato sacerdote: Ryoan Tezuka, un medico affiliato alla medicina occidentale e Manjiro Ibuya, un samurai che non lascia andare gli antichi valori. Le storie dei due si intrecciano più volte sullo sfondo degli sferzanti venti del cambiamento che hanno soffiato sul Giappone in quegli anni: dall'arrivo della nuova medicina che divide i dottori orientali, alle complicanze della classe dei samurai, sino alle relazioni delicate con gli Stati Uniti d'America.","image":"https://img.animeunity.co/anime/n2694-Ui6A4TXJI4ow.jpg","poster":"https://artworks.thetvdb.com/banners/posters/5bf32c1089839.jpg","background":"https://img.animeunity.co/anime/n2694-Ui6A4TXJI4ow.jpg","imdbId":"","type":"series","tags":["TV","Terminato","Primavera","2000"],"tagKeys":{"TV":"TV","Terminato":"Completed","Primavera":"Spring"},"genres":["Action","Drama","Historical","Samurai","Seinen"],"rating":"9.3","studio":"MADHOUSE","episodesCount":25,"extra":{"ids":{"malId":2694,"anilistId":2694,"crunchyId":null,"disneyId":null,"netflixId":null,"primeId":null,"anilistIds":[2694],"malIds":[2694],"anidbIds":[1508],"imdbMovieIds":[],"imdbShowIds":[],"tmdbMovieIds":[],"tmdbShowIds":[34123],"tvdbMovieIds":[],"tvdbShowIds":[352685]},"stats":{"scoreRaw":"9.33","favorites":6,"members":21,"views":2683,"episodesCountRaw":25,"episodesLength":23},"flags":{"dub":0,"alwaysHome":0},"meta":{"day":"Indeterminato","season":"Primavera","status":"Terminato","type":"TV","createdAt":"2026-01-12 16:35:04","userId":2},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-28T07:48:11Z","sourceDescriptors":["anilist:2694","mal:2694"],"targets":[{"provider":"anidb","id":"1508","scope":"R","ranges":{"1-25":"1-25"}},{"provider":"anilist","id":"2694","ranges":{"1-25":"1-25"}},{"provider":"mal","id":"