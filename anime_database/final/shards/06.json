 darà la caccia ai Tarshiani. I due ragazzi dunque si separano, Noboru andando da solo al liceo che sognavano di frequentare insieme, Mikako alla guida di un robot umanoide da combattimento preposto alla distruzione dei Tarshiani e alla difesa delle navi madre. Unico collegamento tra i due amanti, un cellulare in grado di inviare e ricevere email. Tuttavia, più Mikako si allontana dalla Terra più le email impiegano a giungere a destinazione... un mese, due mesi, sei mesi, un anno... finché, dopo l'ultimo balzo, una email impiegherà ben 8 anni e 7 mesi a giungere al cellulare dell'amato.","image":"https://img.animeunity.co/anime/256-Taw6t9ouZ2rL.jpg","poster":"https://img.animeunity.co/anime/bx256-CMHbugPOGxF6.png","background":"https://img.animeunity.co/anime/256-Taw6t9ouZ2rL.jpg","trailers":["https://www.youtube.com/watch?v=kwBcyUGXI2s"],"imdbId":"tt0370754","type":"series","tags":["OVA","Terminato","Inverno","2002"],"tagKeys":{"OVA":"OVA","Terminato":"Completed","Inverno":"Winter"},"genres":["Drama","Mecha","Romance","Sci-fi","Space"],"rating":"5.9","studio":"CoMix Wave","episodesCount":1,"extra":{"ids":{"malId":256,"anilistId":256,"crunchyId":null,"disneyId":null,"netflixId":null,"primeId":null,"anilistIds":[256],"malIds":[256],"anidbIds":[104],"imdbMovieIds":["tt0370754"],"imdbShowIds":[],"tmdbMovieIds":[37910],"tmdbShowIds":[37910],"tvdbMovieIds":[9702],"tvdbShowIds":[]},"stats":{"scoreRaw":"5.91","favorites":5,"members":47,"views":1984,"episodesCountRaw":1,"episodesLength":25},"flags":{"dub":0,"alwaysHome":0},"meta":{"day":"Indeterminato","season":"Inverno","status":"Terminato","type":"OVA","createdAt":"2026-03-03 01:37:06","userId":2},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-28T07:48:11Z","sourceDescriptors":["anilist:256","mal:256"],"imdbSource":"plexanibridge-v2","targets":[{"provider":"anidb","id":"104","scope":"R","ranges":{"1":"1"}},{"provider":"anilist","id":"256","ranges":{"1":"1"}},{"provider":"imdb_movie","id