s","info":{"title":"Santa Company: Midsummer Merry Christmas","synopsis":"Santa Company è una compagnia segreta che si occupa di proteggere i sorrisi e la consegna dei regali dei bambini nel mondo. Per poter diventare a tutti gli effetti gli aiutanti di Babbo Natale, i candidati dovranno allenarsi sulle isole dell'Emisfero Australe in vista del Natale. Questa volta, la nuova inaspettata minaccia che dovranno affrontare gli aiutanti sarà l'inquinamento degli oceani!","image":"https://img.animeunity.co/anime/bx129123-ntClioaA2UZ5.png","poster":"https://img.animeunity.co/anime/bx129123-ntClioaA2UZ5.png","background":"https://img.animeunity.co/anime/bx129123-ntClioaA2UZ5.png","trailers":["https://www.youtube.com/watch?v=gfxiojCiTMY"],"imdbId":"","type":"movie","tags":["Movie","Terminato","Inverno","2021"],"tagKeys":{"Movie":"Movie","Terminato":"Completed","Inverno":"Winter"},"genres":["Fantasy"],"rating":"6.4","studio":"ORENDA","episodesCount":1,"extra":{"ids":{"malId":46491,"anilistId":129123,"crunchyId":null,"disneyId":null,"netflixId":null,"primeId":null,"anilistIds":[129123],"malIds":[46491],"anidbIds":[16005],"imdbMovieIds":[],"imdbShowIds":[],"tmdbMovieIds":[],"tmdbShowIds":[],"tvdbMovieIds":[],"tvdbShowIds":[]},"stats":{"scoreRaw":"6.40","favorites":5,"members":33,"views":6664,"episodesCountRaw":1,"episodesLength":27},"flags":{"dub":0,"alwaysHome":1},"meta":{"day":"Indeterminato","season":"Inverno","status":"Terminato","type":"Movie","createdAt":"2026-03-27 14:15:54","userId":2},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-28T07:48:11Z","sourceDescriptors":["anilist:129123","mal:46491"],"targets":[{"provider":"anidb","id":"16005","scope":"R","ranges":{"1":"1"}},{"provider":"anilist","id":"129123","ranges":{"1":"1"}},{"provider":"mal","id":"46491","ranges":{"1":"1"}}]},"artworkSources":{"logo":"provider","poster":"provider"},"artworkCandidates":{"logo":[],"poster":[{"source":"provider","url":"https://img.animeunity.co/anime/bx