t":1,"end":4},"availabilityStatus":"available","episodesLink":"7830|1|4"}]},"episodes":[{"title":"I sette cavalieri","episodeNumber":1,"sourceEpisodeNumber":1,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"20074","scope":"R","episodeNumbers":[1]},{"provider":"mal","id":"64326","episodeNumbers":[1]},{"provider":"tmdb_show","id":"324326","scope":"s1","seasonNumber":1,"episodeNumbers":[1]},{"provider":"tvdb_show","id":"478668","scope":"s1","seasonNumber":1,"episodeNumbers":[1]}],"link":"110414","synopsis":"At the heart of a continent of eight kingdoms lies the Marronnier Kingdom. Its general, Baribara, has seven sons, each with a unique gift and serving as a knight commander. Bound by a single noble cause of heroically rescuing a princess someday, the brothers set out as goodwill ambassadors to the seven neighboring kingdoms. What encounters, trials, and destinies await them in these unknown lands?","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/11820419/screencap/6aba38a903fc8.jpg"},{"title":"Primavera sul lago","episodeNumber":2,"sourceEpisodeNumber":2,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"20074","scope":"R","episodeNumbers":[2]},{"provider":"mal","id":"64326","episodeNumbers":[2]},{"provider":"tmdb_show","id":"324326","scope":"s1","seasonNumber":1,"episodeNumbers":[2]},{"provider":"tvdb_show","id":"478668","scope":"s1","seasonNumber":1,"episodeNumbers":[2]}],"link":"110494","synopsis":"Chilly finds himself drawn to Bruno, unaware that it is Princess Brunhild disguised as a man. But after learning of a string of mysterious incidents surrounding her, he begins to suspect someone is working against her. He decides to uncover the truth when something strange occurs within him. Meanwhile, Insomniac is selected as the first goodwill ambassador, and his future fiancée is to be chosen.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/12016287/screencap/6ac4c3ad0faad.jpg"},{"title":"Avventatezza","episodeNumber":3,"sourceEpisodeNumber":3,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"20074","scope":"R","episodeNumbers":[3]},{"provider":"mal","id":"64326","episodeNumbers":[3]},{"provider":"tmdb_show","id":"324326","scope":"s1","seasonNumber":1,"episodeNumbers":[3]},{"provider":"tvdb_show","id":"478668","scope":"s1","seasonNumber":1,"episodeNumbers":[3]}],"link":"110661","synopsis":"Insomniac accepts his engagement to Ellie, the castellan's daughter, but conflicting motives begin to emerge behind the arrangement. During a sword tournament at the castle, Swordsman and Ellie advance to the semifinals, where they face off in a fierce duel. Later, Ellie learns she has been chosen to accompany Insomniac as a knight commander aide on his journey to the Country of Long Nights.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/12017046/screencap/6acdf587aabf6.jpg"},{"title":"Eleonora","episodeNumber":4,"sourceEpisodeNumber":4,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"20074","scope":"R","episodeNumbers":[4]},{"provider":"mal","id":"64326","episodeNumbers":[4]},{"provider":"tmdb_show","id":"324326","scope":"s1","seasonNumber":1,"episodeNumbers":[4]},{"provider":"tvdb_show","id":"478668","scope":"s1","seasonNumber":1,"episodeNumbers":[4]}],"link":"110808","synopsis":"As they journey to the Country of Long Nights, Ellie begins to notice subtle changes in Insomniac, whom she has known since childhood, that leave her uneasy. They arrive in a land where blue flowers bloom, and preparations are underway for the annual Walpurga Eve festival. But beneath its peaceful surface, Insomniac senses an ominous presence, and the country's hidden secrets slowly come to light.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/12017047/screencap/6ad73a9c36102.jpg"}]}]}
