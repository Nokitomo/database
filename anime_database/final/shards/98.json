il":"https://artworks.thetvdb.com/banners/v4/episode/11651324/screencap/6ac3e4b0d31b1.jpg"},{"title":"The Players","episodeNumber":2,"sourceEpisodeNumber":2,"externalMappings":[{"provider":"anidb","id":"17839","scope":"R","episodeNumbers":[2]},{"provider":"anilist","id":"160803","episodeNumbers":[2]},{"provider":"mal","id":"54344","episodeNumbers":[2]},{"provider":"tvdb_show","id":"457780","scope":"s1","seasonNumber":1,"episodeNumbers":[2]}],"link":"110559","synopsis":"Sixteen magical girls have been assembled in a vast virtual world. The electronic fairy Fal announces a team competition with a 10-billion-yen grand prize, where players must collect “Candy.” With Pechka panicking over her complete lack of combat ability, Clantail takes the lead in redistributing the Candy. But could this become the seed of quiet mistrust among the group?","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/12020951/screencap/6acd1976c153a.jpg"},{"title":"Episode 3","titleKey":"Episode {{number}}","titleParams":{"number":"3"},"episodeNumber":3,"sourceEpisodeNumber":3,"link":"110761"},{"title":"Episode 4","titleKey":"Episode {{number}}","titleParams":{"number":"4"},"episodeNumber":4,"sourceEpisodeNumber":4,"link":"110881"}]}]}
