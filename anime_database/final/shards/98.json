vranno collaborare per sconfiggere nemici, risolvere enigmi e ottenere Magical Candy. Ad attenderle alla fine ci sono ben dieci miliardi di yen, ma il premio spetterà soltanto a chi infliggerà il colpo di grazia. Con una ricompensa così allettante, è solo questione di tempo prima che le ragazze inizino a combattersi tra loro. E quando i loro punti vita raggiungeranno lo zero, il game over sarà solo l'inizio dei loro problemi...","image":"https://artworks.thetvdb.com/banners/v4/series/457780/backgrounds/675d40c48c615.jpg","poster":"https://artworks.thetvdb.com/banners/v4/series/457780/posters/69a59b1b760cd.jpg","background":"https://artworks.thetvdb.com/banners/v4/series/457780/backgrounds/675d40c48c615.jpg","trailers":["https://www.youtube.com/watch?v=34ubb-j0kbI"],"imdbId":"","type":"series","tags":["TV","In Corso","Autunno","2026"],"tagKeys":{"TV":"TV","In Corso":"Ongoing","Autunno":"Autumn"},"genres":["Action","Fantasy","Gore","Mahou Shoujo","Survival","Thriller"],"rating":"7.2","studio":"SynergySP","episodesCount":4,"extra":{"ids":{"malId":54344,"anilistId":160803,"crunchyId":null,"disneyId":null,"netflixId":null,"primeId":"0P2GFG54WE8IILCGHBSY056PI5","anilistIds":[160803],"malIds":[54344],"anidbIds":[17839],"imdbMovieIds":[],"imdbShowIds":[],"tmdbMovieIds":[],"tmdbShowIds":[],"tvdbMovieIds":[],"tvdbShowIds":[457780]},"stats":{"scoreRaw":"7.17","favorites":21,"members":162,"views":15633,"episodesCountRaw":4,"episodesLength":24},"flags":{"dub":0,"alwaysHome":1},"meta":{"day":"Martedì","season":"Autunno","status":"In Corso","type":"TV","createdAt":"2026-09-23 00:21:31","userId":2},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-29T07:54:59Z","sourceDescriptors":["anilist:160803","mal:54344"],"targets":[{"provider":"anidb","id":"17839","scope":"R","ranges":{"1-2":"1-2"}},{"provider":"anilist","id":"160803","ranges":{"1-2":"1-2"}},{"provider":"mal","id":"54344","ranges":{"1-2":"1-2"}},{"provider":"tvdb_show","id":"457780","scope":"