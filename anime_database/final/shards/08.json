ettere cade vittima delle sue enormi voglie. I suoi soldi vanno quasi tutti nell’acquisto di nuove sigarette, e quando non può permettersele comincia a recuperare mozziconi per strada o a riutilizzarli pur di soddisfare il bisogno di nicotina. Costantemente in ritardo con l’affitto e incapace di mantenere un lavoro, Yaniko si trova spesso in situazioni assurde e grottesche. La sua sorella, i suoi amici e i vicini di casa cercano di aiutarla mentre lei combina guai dopo guai, affrontando piccoli drammi quotidiani con ironia e disordine.","image":"https://image.tmdb.org/t/p/original/zAMw1Nu5XzGW50eNjBkIxF3kfrx.jpg","poster":"https://image.tmdb.org/t/p/original/kqeKlSd7o9BCbTraZsDnksRSfxm.jpg","logo":"https://image.tmdb.org/t/p/original/n3hxMt2XTdZxdSc2oohe7dHJGnC.svg","background":"https://image.tmdb.org/t/p/original/zAMw1Nu5XzGW50eNjBkIxF3kfrx.jpg","trailers":["https://www.youtube.com/watch?v=KYGgyQtSAdI"],"imdbId":"","type":"series","tags":["TV","Terminato","Estate","2026"],"tagKeys":{"TV":"TV","Terminato":"Completed","Estate":"Summer"},"genres":["Comedy","Seinen","Slice of Life"],"rating":"7.6","studio":"Bibury Animation Studios","episodesCount":12,"extra":{"ids":{"malId":63403,"anilistId":207141,"crunchyId":null,"disneyId":null,"netflixId":"82760630","primeId":null,"anilistIds":[207141],"malIds":[63403],"anidbIds":[19873],"imdbMovieIds":[],"imdbShowIds":[],"tmdbMovieIds":[],"tmdbShowIds":[312949],"tvdbMovieIds":[],"tvdbShowIds":[473423]},"stats":{"scoreRaw":"7.60","favorites":223,"members":977,"views":117659,"episodesCountRaw":12,"episodesLength":24},"flags":{"dub":1,"alwaysHome":1},"meta":{"day":"Giovedì","season":"Estate","status":"Terminato","type":"TV","createdAt":"2026-07-17 11:37:11","userId":2},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-29T07:54:59Z","sourceDescriptors":["anilist:207141","mal:63403"],"targets":[{"provider":"anidb","id":"19873","scope":"R","ranges":{"1-":"1-"}},{"provider":"anilist","id":"207141","rang