":3,"seasonNumber":6,"externalMappings":[{"provider":"tmdb_show","id":"45790","scope":"s6","seasonNumber":6,"episodeNumbers":[3,4]},{"provider":"tvdb_show","id":"262954","scope":"s6","seasonNumber":6,"episodeNumbers":[3,4]}],"link":"110474","synopsis":"Al campo, Johnny intravede uno scorcio del passato di Gyro. La famiglia Boomboom entra in azione con un potere ultraterreno, ma i due riescono a fuggire... o almeno così credono.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/11872174/screencap/6abf9c29a9cc9.jpg"},{"title":"Devil's Palm","episodeNumber":4,"sourceEpisodeNumber":4,"seasonNumber":6,"externalMappings":[{"provider":"tmdb_show","id":"45790","scope":"s6","seasonNumber":6,"episodeNumbers":[4,5]},{"provider":"tvdb_show","id":"262954","scope":"s6","seasonNumber":6,"episodeNumbers":[4,5]}],"link":"110635","synopsis":"Intrappolati dai Boomboom, Johnny, Gyro e Mountain Tim rischiano di essere distrutti da una forza magnetica. Poi scoprono l'esistenza degli \"Stand\" e il corpo di Johnny reagisce.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/11872175/screencap/6ac8d46678833.jpg"},{"title":"Il Dinamitardo Da Un Paese Lontano Lontano","episodeNumber":5,"sourceEpisodeNumber":5,"seasonNumber":6,"externalMappings":[{"provider":"tmdb_show","id":"45790","scope":"s6","seasonNumber":6,"episodeNumbers":[5,6]},{"provider":"tvdb_show","id":"262954","scope":"s6","seasonNumber":6,"episodeNumbers":[5,6]}],"link":"110789","synopsis":"A un posto di blocco, il duo si trova davanti a un uomo di nome Oye che conosce il passato di Gyro e può trasformare in bomba qualsiasi cosa tocchi, lasciandoli senza scampo.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/11872176/screencap/6ad1f7d29c650.jpg"}]}]}
