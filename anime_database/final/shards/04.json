isi da vicende di politica e sangue, si stanno risvegliando, mentre in Giappone quelli che da sempre considerava i suoi più cari amici si stanno dividendo in due opposte fazioni. Chi è il guerriero Yawal, e per quale motivo brama la morte del guerriero Vilka? Chi erano, nel passato? E chi sono, in questo presente incapace di offrire certezze?","image":"https://image.tmdb.org/t/p/original/pRpE8ut5S29hRSfCvZxPyR0glY6.jpg","poster":"https://image.tmdb.org/t/p/original/glC8LGEd5BkbzrbfGTUwqSWRZKv.jpg","logo":"https://live.metahub.space/logo/medium/tt0264281/img","background":"https://image.tmdb.org/t/p/original/pRpE8ut5S29hRSfCvZxPyR0glY6.jpg","imdbId":"tt0264281","type":"series","tags":["TV","Terminato","Primavera","1998"],"tagKeys":{"TV":"TV","Terminato":"Completed","Primavera":"Spring"},"genres":["Action","Adventure","Drama","Fantasy","Reincarnation"],"rating":"6.0","studio":"Genco","episodesCount":12,"extra":{"ids":{"malId":1775,"anilistId":1775,"crunchyId":null,"disneyId":null,"netflixId":null,"primeId":null,"anilistIds":[1775],"malIds":[1775],"anidbIds":[101],"imdbMovieIds":[],"imdbShowIds":[],"tmdbMovieIds":[],"tmdbShowIds":[34170],"tvdbMovieIds":[],"tvdbShowIds":[74539]},"stats":{"scoreRaw":"6.00","favorites":13,"members":47,"views":5265,"episodesCountRaw":12,"episodesLength":24},"flags":{"dub":1,"alwaysHome":0},"meta":{"day":"Indeterminato","season":"Primavera","status":"Terminato","type":"TV","createdAt":"2026-06-18 18:24:17","userId":2},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-28T07:48:11Z","sourceDescriptors":["anilist:1775","mal:1775"],"imdbSource":"plexanibridge-v2","targets":[{"provider":"anidb","id":"101","scope":"R","ranges":{"1-12":"1-12"}},{"provider":"anilist","id":"1775","ranges":{"1-12":"1-12"}},{"provider":"mal","id":"1775","ranges":{"1-12":"1-12"}},{"provider":"tmdb_show","id":"34170","scope":"s1","ranges":{"1-12":"1-12"}},{"provider":"tvdb_show","id":"74539","scope":"s1","ranges":{"1-12":"1-12"}}]},"artw