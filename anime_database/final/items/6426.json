":"https://artworks.thetvdb.com/banners/v4/series/447925/backgrounds/65fc635321816.jpg"},{"source":"provider","url":"https://img.animeunity.co/anime/176246-Cnm6EqDLxEN3.jpg"}]},"artworkFallbacks":{"logo":[{"source":"tmdb","url":"https://image.tmdb.org/t/p/original/47XcyUpRpnGEcMEjHSPmGBhB5r.svg"},{"source":"cinemeta","url":"https://live.metahub.space/logo/medium/tt35436997/img"}],"poster":[{"source":"tmdb","url":"https://image.tmdb.org/t/p/original/5Ms894x1urTEc1I43yUpyaXdBpp.jpg"},{"source":"tvdb","url":"https://artworks.thetvdb.com/banners/v4/series/447925/posters/678901bdc9a12.jpg"},{"source":"provider","url":"https://img.animeunity.co/anime/bx176246-ndH8bKh7cmzf.jpg"},{"source":"cinemeta","url":"https://live.metahub.space/poster/small/tt35436997/img"},{"source":"anizip","url":"https://artworks.thetvdb.com/banners/v4/series/447925/posters/65fc6334dd2e5.jpg"},{"source":"anilist","url":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/large/bx176246-ndH8bKh7cmzf.jpg"}],"background":[{"source":"tmdb","url":"https://image.tmdb.org/t/p/original/3dWu3cm7L8yYm9qpnpQOpCjMGDl.jpg"},{"source":"cinemeta","url":"https://live.metahub.space/background/medium/tt35436997/img"},{"source":"tvdb","url":"https://artworks.thetvdb.com/banners/v4/series/447925/backgrounds/67faae1c22d73.jpg"},{"source":"anizip","url":"https://artworks.thetvdb.com/banners/v4/series/447925/backgrounds/65fc635321816.jpg"},{"source":"provider","url":"https://img.animeunity.co/anime/176246-Cnm6EqDLxEN3.jpg"},{"source":"anilist","url":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/176246-Cnm6EqDLxEN3.jpg"}]}},"related":[],"linkList":[{"title":"Episodes 1-12","titleKey":"Episodes {{start}}-{{end}}","titleParams":{"start":1,"end":12},"availabilityStatus":"available","episodesLink":"6426|1|12"}]},"episodes":[{"title":"Episodio 1","episodeNumber":1,"sourceEpisodeNumber":1,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"18546","scope":"R","episodeNumbers":[1]},{"provider":"anilist","id":"176246","episodeNumbers":[1]},{"provider":"mal","id":"58492","episodeNumbers":[1]},{"provider":"tmdb_show","id":"249854","scope":"s1","seasonNumber":1,"episodeNumbers":[1]},{"provider":"tvdb_show","id":"447925","scope":"s1","seasonNumber":1,"episodeNumbers":[1]}],"link":"94930","synopsis":"Satsuki Amamiya, a member of the Photography Club, finds herself in a slump as her beloved club president graduates from high school. Her best friend, An Kiriyama, cheers her up, reigniting Satsuki's motivation to give the club her best again. But the 360-degree camera Satsuki bought at an online auction hasn't arrived yet! Satsuki and An pay the seller a visit.","thumbnail":"https://image.tmdb.org/t/p/w300/niBTnKGW0c318X5mVYThG14derT.jpg"},{"title":"Episodio 2","episodeNumber":2,"sourceEpisodeNumber":2,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"18546","scope":"R","episodeNumbers":[2]},{"provider":"anilist","id":"176246","episodeNumbers":[2]},{"provider":"mal","id":"58492","episodeNumbers":[2]},{"provider":"tmdb_show","id":"249854","scope":"s1","seasonNumber":1,"episodeNumbers":[2]},{"provider":"tvdb_show","id":"447925","scope":"s1","seasonNumber":1,"episodeNumbers":[2]}],"link":"95644","synopsis":"Satsuki and An use a makeshift drone to try some photography when they receive notice that the photography club will be dissolved due to the lack of members. Troubled by this news, they invite fellow classmate Sakurako Shikishima from the Cinema Club, which has also received a dissolution notice. Meanwhile, Haruno is stuck on her manga draft when her high school friend, Kako Komada, pays her a visit. The two hit the road for a tour.","thumbnail":"https://image.tmdb.org/t/p/w300/pfjEsWOhXyTOZQ4hkyj4UEToK06.jpg"},{"title":"Episodio 3","episodeNumber":3,"sourceEpisodeNumber":3,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"18546","scope":"R","episodeNumbers":[3]},{"provider":"anilist","id":"176246","episodeNumbers":[3]},{"provider":"mal","id":"58492","episodeNumbers":[3]},{"provider":"tmdb_show","id":"249854","scope":"s1","seasonNumber":1,"episodeNumbers":[3]},{"provider":"tvdb_show","id":"447925","scope":"s1","seasonNumber":1,"episodeNumbers":[3]}],"link":"95779","synopsis":"Haruno gets word of a manga that will be adapted into an anime. As she lives in the real-life location of that manga's story, she scouts out locations and decides to make it a focus for her manga creations. Haruno tries to carry out her plan to visit these manga pilgrimage sites on an ambitious schedule, but the other members of the Cinephoto Club can't seem to hide their unease. And so begins the hellish schedule of this location scouting tour....","thumbnail":"https://image.tmdb.org/t/p/w300/9g5F6LxAlkZzrcWtKCO4jPDYtzO.jpg"},{"title":"Episodio 4","episodeNumber":4,"sourceEpisodeNumber":4,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"18546","scope":"R","episodeNumbers":[4]},{"provider":"anilist","id":"176246","episodeNumbers":[4]},{"provider":"mal","id":"58492","episodeNumbers":[4]},{"provider":"tmdb_show","id":"249854","scope":"s1","seasonNumber":1,"episodeNumbers":[4]},{"provider":"tvdb_show","id":"447925","scope":"s1","seasonNumber":1,"episodeNumbers":[4]}],"link":"95946","synopsis":"Haruno invites Satsuki and the rest to join an event where they take pictures and eat while walking. The three girls happily accept, thinking it's the perfect event for the Cinephoto Club, but they find out they'll be going around shops that serve generous portions of food to the point they'll be full! They're disappointed in the food brought to them, but this is just the beginning of their fight.","thumbnail":"https://image.tmdb.org/t/p/w300/eV8ySQ9jPz2KdlhSmen99Gy0SP9.jpg"},{"title":"Episodio 5","episodeNumber":5,"sourceEpisodeNumber":5,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"18546","scope":"R","episodeNumbers":[5]},{"provider":"anilist","id":"176246","episodeNumbers":[5]},{"provider":"mal","id":"58492","episodeNumbers":[5]},{"provider":"tmdb_show","id":"249854","scope":"s1","seasonNumber":1,"episodeNumbers":[5]},{"provider":"tvdb_show","id":"447925","scope":"s1","seasonNumber":1,"episodeNumbers":[5]}],"link":"96486","synopsis":"The dry-cured ham that Haruno was looking forward to enjoying ended up being used as one of the recipe's ingredients! With a little convincing from Kako, the group heads out to buy some famous Yatsugatake ham instead. While on the road, they drop by abandoned places and ski areas here and there, enjoying some Kiyosato curry and visiting a variety of stores that sell ham.","thumbnail":"https://image.tmdb.org/t/p/w300/dh4jOgWU5JHgg7Fdy0W9KaCKTTz.jpg"},{"title":"Episodio 6","episodeNumber":6,"sourceEpisodeNumber":6,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"18546","scope":"R","episodeNumbers":[6]},{"provider":"anilist","id":"176246","episodeNumbers":[6]},{"provider":"mal","id":"58492","episodeNumbers":[6]},{"provider":"tmdb_show","id":"249854","scope":"s1","seasonNumber":1,"episodeNumbers":[6]},{"provider":"tvdb_show","id":"447925","scope":"s1","seasonNumber":1,"episodeNumbers":[6]}],"link":"96777","synopsis":"As a story idea for Haruno's manga, the girls participate in a \"maruishi\" hunting event in the prefecture.","thumbnail":"https://image.tmdb.org/t/p/w300/t7qFsNe5ygOj4oMNe4gHY9ZMEih.jpg"},{"title":"Episodio 7","episodeNumber":7,"sourceEpisodeNumber":7,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"18546","scope":"R","episodeNumbers":[7]},{"provider":"anilist","id":"176246","episodeNumbers":[7]},{"provider":"mal","id":"58492","episodeNumbers":[7]},{"provider":"tmdb_show","id":"249854","scope":"s1","seasonNumber":1,"episodeNumbers":[7]},{"provider":"tvdb_show","id":"447925","scope":"s1","seasonNumber":1,"episodeNumbers":[7]}],"link":"97283","synopsis":"One of Haruno's manga artist friends, Isuzu, gets her work selected to be adapted into an anime! Worried about the money involved and how busy she'll be, she confides in Kurokuma and Haruno about how uneasy she feels about everything. The girls worry for Isuzu and, as a change of pace, participate in the Minobu Donburi Walk together.","thumbnail":"https://image.tmdb.org/t/p/w300/iI0uuvnouhLRkz7jc1m6vDmYWXB.jpg"},{"title":"Episodio 8","episodeNumber":8,"sourceEpisodeNumber":8,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"18546","scope":"R","episodeNumbers":[8]},{"provider":"anilist","id":"176246","episodeNumbers":[8]},{"provider":"mal","id":"58492","episodeNumbers":[8]},{"provider":"tmdb_show","id":"249854","scope":"s1","seasonNumber":1,"episodeNumbers":[8]},{"provider":"tvdb_show","id":"447925","scope":"s1","seasonNumber":1,"episodeNumbers":[8]}],"link":"97357","synopsis":"Haruno and the Cinephoto Club head to Nagano for a two-night-three-day trip for a scoop. While everyone raises their hand to suggest places they want to go to, An says she wants to film some skateboarding downhill with an action camera. To do this, though, they'll need someone to ride the skateboard with her....","thumbnail":"https://image.tmdb.org/t/p/w300/d0ickzJtJXRMhaqlqM6OwhA57VV.jpg"},{"title":"Episodio 9","episodeNumber":9,"sourceEpisodeNumber":9,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"18546","scope":"R","episodeNumbers":[9]},{"provider":"anilist","id":"176246","episodeNumbers":[9]},{"provider":"mal","id":"58492","episodeNumbers":[9]},{"provider":"tmdb_show","id":"249854","scope":"s1","seasonNumber":1,"episodeNumbers":[9]},{"provider":"tvdb_show","id":"447925","scope":"s1","seasonNumber":1,"episodeNumbers":[9]}],"link":"97720","synopsis":"The girls meet up and head over to Kurobe Dam, where they watch a documentary about the dam's construction.","thumbnail":"https://image.tmdb.org/t/p/w300/bVQQnJ0blYrga8omf8XjaPLr2ju.jpg"},{"title":"Episodio 10","episodeNumber":10,"sourceEpisodeNumber":10,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"18546","scope":"R","episodeNumbers":[10]},{"provider":"anilist","id":"176246","episodeNumbers":[10]},{"provider":"mal","id":"58492","episodeNumbers":[10]},{"provider":"tmdb_show","id":"249854","scope":"s1","seasonNumber":1,"episodeNumbers":[10]},{"provider":"tvdb_show","id":"447925","scope":"s1","seasonNumber":1,"episodeNumbers":[10]}],"link":"97845","synopsis":"It's the last day, and the group has gone all over Nagano to get this scoop. The group arrives at Togakushi, Nagano, where they try making fresh soba. They break into two teams: adults and children, and have a competition to make some soba! And finally, the group makes their last stop at a Ninja Trick Mansion, but what exactly awaits them there?","thumbnail":"https://image.tmdb.org/t/p/w300/yEIaTgKkxXOhoOOmpP6XA65S8J6.jpg"},{"title":"Episodio 11","episodeNumber":11,"sourceEpisodeNumber":11,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"18546","scope":"R","episodeNumbers":[11]},{"provider":"anilist","id":"176246","episodeNumbers":[11]},{"provider":"mal","id":"58492","episodeNumbers":[11]},{"provider":"tmdb_show","id":"249854","scope":"s1","seasonNumber":1,"episodeNumbers":[11]},{"provider":"tvdb_show","id":"447925","scope":"s1","seasonNumber":1,"episodeNumbers":[11]}],"link":"98220","synopsis":"There are only two days left of summer vacation. As Cinephoto Club reflects upon this past summer, they realize they haven't eaten shaved ice yet! To make this the best summer vacation without any regrets, the group takes one last trip to enjoy all the shaved ice spots listed on the Yamanashi Shaved Iced Map.","thumbnail":"https://image.tmdb.org/t/p/w300/z2WPZ6a4J004Vo4VfSDPNs1Cl3v.jpg"},{"title":"Episodio 12","episodeNumber":12,"sourceEpisodeNumber":12,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"18546","scope":"R","episodeNumbers":[12]},{"provider":"anilist","id":"176246","episodeNumbers":[12]},{"provider":"mal","id":"58492","episodeNumbers":[12]},{"provider":"tmdb_show","id":"249854","scope":"s1","seasonNumber":1,"episodeNumbers":[12]},{"pr