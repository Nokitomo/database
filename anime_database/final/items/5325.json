2745","scope":"R","episodeNumbers":[1]},{"provider":"anilist","id":"342","episodeNumbers":[1]},{"provider":"mal","id":"342","episodeNumbers":[1]},{"provider":"tmdb_show","id":"34790","scope":"s1","seasonNumber":1,"episodeNumbers":[1]},{"provider":"tvdb_show","id":"78884","scope":"s1","seasonNumber":1,"episodeNumbers":[1]}],"link":"80871","synopsis":"The 73rd graduating class of the Defense University is returning to planet Kibi in the combat spaceship Amaterasu, only to find that their home planet has been subdued. Left behind on the ship, the cadets make a deal with the Galaxy Network in order to fight the oppressor.","thumbnail":"https://image.tmdb.org/t/p/w300/uhnbZUNEvRxeoFxVyQ15o7FMFFf.jpg"},{"title":"Trafalgar Crisis","episodeNumber":2,"sourceEpisodeNumber":2,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"2745","scope":"R","episodeNumbers":[2]},{"provider":"anilist","id":"342","episodeNumbers":[2]},{"provider":"mal","id":"342","episodeNumbers":[2]},{"provider":"tmdb_show","id":"34790","scope":"s1","seasonNumber":1,"episodeNumbers":[2]},{"provider":"tvdb_show","id":"78884","scope":"s1","seasonNumber":1,"episodeNumbers":[2]}],"link":"80872","synopsis":"Former Kibi Prime Minister Tatsuma Mamiya boards the Amaterasu to establish the ship as a government-in-exile. However, the Amaterasu is forced to warp to neutral planet Phoenicia by enemy ships and Kibi fighters. Not long after they flee, the Kingdom warship Trafalgar challenges them to a fight.","thumbnail":"https://image.tmdb.org/t/p/w300/whFZT8Vj38JEsAOaLfW8tpXF161.jpg"},{"title":"Call From Home","episodeNumber":3,"sourceEpisodeNumber":3,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"2745","scope":"R","episodeNumbers":[3]},{"provider":"anilist","id":"342","episodeNumbers":[3]},{"provider":"mal","id":"342","episodeNumbers":[3]},{"provider":"tmdb_show","id":"34790","scope":"s1","seasonNumber":1,"episodeNumbers":[3]},{"provider":"tvdb_show","id":"78884","scope":"s1","seasonNumber":1,"episodeNumbers":[3]}],"link":"80873","synopsis":"The Kingdom leadership decides to change tactics in dealing with the Amaterasu, which they deem a renegade and pirate vessel. Amid discontent and disunity in the ship's crew, Sanri's wealthy father makes an appeal for them to turn themselves in.","thumbnail":"https://image.tmdb.org/t/p/w300/AcAAiSQxWZ0KYB1SMIl2nWhzrgR.jpg"},{"title":"Final Answer","episodeNumber":4,"sourceEpisodeNumber":4,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"2745","scope":"R","episodeNumbers":[4]},{"provider":"anilist","id":"342","episodeNumbers":[4]},{"provider":"mal","id":"342","episodeNumbers":[4]},{"provider":"tmdb_show","id":"34790","scope":"s1","seasonNumber":1,"episodeNumbers":[4]},{"provider":"tvdb_show","id":"78884","scope":"s1","seasonNumber":1,"episodeNumbers":[4]}],"link":"80874","synopsis":"The Kingdom sends the stealth vessel Aboukir to the Amaterasu with a simple message: \"Surrender, or die.\" The Operators find themselves frantically searching the stars for the elusive vessel.","thumbnail":"https://image.tmdb.org/t/p/w300/5YgqAFxHltS2ZLMGLCfULO6kBFD.jpg"},{"title":"Great Escape (Part 1)","episodeNumber":5,"sourceEpisodeNumber":5,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"2745","scope":"R","episodeNumbers":[5]},{"provider":"anilist","id":"342","episodeNumbers":[5]},{"provider":"mal","id":"342","episodeNumbers":[5]},{"provider":"tmdb_show","id":"34790","scope":"s1","seasonNumber":1,"episodeNumbers":[5]},{"provider":"tvdb_show","id":"78884","scope":"s1","seasonNumber":1,"episodeNumbers":[5]}],"link":"80875","synopsis":"Short on supplies, the Amaterasu manages to make a deal with the Planetary Nation of Shu for replenishment. The government invites the main bridge crew to a welcome ceremony, but they are stranded when the Kingdom declares war on Shu.","thumbnail":"https://image.tmdb.org/t/p/w300/oBxrL2aEFcPARMyvpAUJur55yxR.jpg"},{"title":"Great Escape (Part 2)","episodeNumber":6,"sourceEpisodeNumber":6,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"2745","scope":"R","episodeNumbers":[6]},{"provider":"anilist","id":"342","episodeNumbers":[6]},{"provider":"mal","id":"342","episodeNumbers":[6]},{"provider":"tmdb_show","id":"34790","scope":"s1","seasonNumber":1,"episodeNumbers":[6]},{"provider":"tvdb_show","id":"78884","scope":"s1","seasonNumber":1,"episodeNumbers":[6]}],"link":"80876","synopsis":"As battles rage between factions on planet Shu, the stranded bridge crew must risk a dangerous retrieval mission. Shu Defense Minister Wong offers to fight the incoming Kingdom blockade with the Shenlong and to provide an escape route for the Amaterasu if the Shenlong should fall. Another Amaterasu crew member dies in the line of duty.","thumbnail":"https://image.tmdb.org/t/p/w300/cYtxhcKCtqxBBLe3R3rIiMBCtNx.jpg"},{"title":"Stardust Memory (Part 1)","episodeNumber":7,"sourceEpisodeNumber":7,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"2745","scope":"R","episodeNumbers":[7]},{"provider":"anilist","id":"342","episodeNumbers":[7]},{"provider":"mal","id":"342","episodeNumbers":[7]},{"provider":"tmdb_show","id":"34790","scope":"s1","seasonNumber":1,"episodeNumbers":[7]},{"provider":"tvdb_show","id":"78884","scope":"s1","seasonNumber":1,"episodeNumbers":[7]}],"link":"80878","synopsis":"After careful analysis and repeated combat trials with Cisca, Sinon formulates a strategy for the upcoming battle with four Kingdom warships. The catch, however, is that timing is critical in the strategy","thumbnail":"https://image.tmdb.org/t/p/w300/pqPsARTdI2j53L7bTXVtE5wh8wE.jpg"},{"title":"Stardust Memory (Part 2)","episodeNumber":8,"sourceEpisodeNumber":8,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"2745","scope":"R","episodeNumbers":[8]},{"provider":"anilist","id":"342","episodeNumbers":[8]},{"provider":"mal","id":"342","episodeNumbers":[8]},{"provider":"tmdb_show","id":"34790","scope":"s1","seasonNumber":1,"episodeNumbers":[8]},{"provider":"tvdb_show","id":"78884","scope":"s1","seasonNumber":1,"episodeNumbers":[8]}],"link":"80877","synopsis":"The Shenlong sacrifices herself to allow the Amaterasu to escape. Although the Amaterasu is able to sink one ship, the trapped vessel warps away, taking a drone laser ship with it.","thumbnail":"https://image.tmdb.org/t/p/w300/rhx5dpVIRV8UspFYzW1E8iS5GFp.jpg"},{"title":"Turning Point","episodeNumber":9,"sourceEpisodeNumber":9,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"2745","scope":"R","episodeNumbers":[9]},{"provider":"anilist","id":"342","episodeNumbers":[9]},{"provider":"mal","id":"342","episodeNumbers":[9]},{"provider":"tmdb_show","id":"34790","scope":"s1","seasonNumber":1,"episodeNumbers":[9]},{"provider":"tvdb_show","id":"78884","scope":"s1","seasonNumber":1,"episodeNumbers":[9]}],"link":"80880","synopsis":"The Supreme Chairman of the Kingdom dies and Isabelle, his right hand, is the likely candidate to succeed him. The Amaterasu has warped into neutral space so they go to the spaceport of Parnia for resupply. Kouki takes his chances and asks Sinon out, catching her off guard. Mamiya Tatsuma travels to Earth to speak at an U.N. conference and to request the Earth Federation's assistance.","thumbnail":"https://image.tmdb.org/t/p/w300/eEPhxhMaAyH4Y1yJtU3Wa1kiwUJ.jpg"},{"title":"Sudden Death","episodeNumber":10,"sourceEpisodeNumber":10,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"2745","scope":"R","episodeNumbers":[10]},{"provider":"anilist","id":"342","episodeNumbers":[10]},{"provider":"mal","id":"342","episodeNumbers":[10]},{"provider":"tmdb_show","id":"34790","scope":"s1","seasonNumber":1,"episodeNumbers":[10]},{"provider":"tvdb_show","id":"78884","scope":"s1","seasonNumber":1,"episodeNumbers":[10]}],"link":"80879","synopsis":"After the ressuply, AGI invites the crew of the Amaterasu to a party. The non-bridge staff elect to remain on board. Isabelle eliminates her political rivals during the Supreme's Chairman funeral. During the party, Kingdom commandos invade the docking bay of the Amaterasu, and Kouki is killed in the firefight. Its safety threatened, AGI cancels the support contract out of fear.","thumbnail":"https://image.tmdb.org/t/p/w300/Aby73ANy4BSJZ9VUkQJUXJrChx9.jpg"},{"title":"Return Match","episodeNumber":11,"sourceEpisodeNumber":11,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"2745","scope":"R","episodeNumbers":[11]},{"provider":"anilist","id":"342","episodeNumbers":[11]},{"provider":"mal","id":"342","episodeNumbers":[11]},{"provider":"tmdb_show","id":"34790","scope":"s1","seasonNumber":1,"episodeNumbers":[11]},{"provider":"tvdb_show","id":"78884","scope":"s1","seasonNumber":1,"episodeNumbers":[11]}],"link":"80882","synopsis":"Cisca informs the crew that they are free to resign, but only supply officer Sei does so. With 5 battleships approaching, Sinon comes up with an idea that will improve the turning speed of the Amaterasu, in order to target hostiles faster. Dita persuades Peter to broadcast the battle live, but with censored ship displays. The main systems of the Amaterasu are exhausted, but all enemy ships are destroyed with the exception of the Conquistador.","thumbnail":"https://image.tmdb.org/t/p/w300/odp0w0nkMtmcTTjCvqLYgHrdOOH.jpg"},{"title":"War Cry","episodeNumber":12,"sourceEpisodeNumber":12,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"2745","scope":"R","episodeNumbers":[12]},{"provider":"anilist","id":"342","episodeNumbers":[12]},{"provider":"mal","id":"342","episodeNumbers":[12]},{"provider":"tmdb_show","id":"34790","scope":"s1","seasonNumber":1,"episodeNumbers":[12]},{"provider":"tvdb_show","id":"78884","scope":"s1","seasonNumber":1,"episodeNumbers":[12]}],"link":"80881","synopsis":"Blind and crippled, the Amaterasu struggle to regain their footing. The Conquistador is likewise blind from the last shot from the Amaterasu's plasma cannon. The Amaterasu decides to rush the Conquistador while she is still shooting blindly. Before the Conquistador can fire the finishing blow, she is ordered to hand the Amaterasu to the Earth Federation.","thumbnail":"https://image.tmdb.org/t/p/w300/ikEKyg7ystRhFqjLcy3bofQY65E.jpg"},{"title":"Moment of Truth","episodeNumber":13,"sourceEpisodeNumber":13,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"2745","scope":"R","episodeNumbers":[13]},{"provider":"anilist","id":"342","episodeNumbers":[13]},{"provider":"mal","id":"342","episodeNumbers":[13]},{"provider":"tmdb_show","id":"34790","scope":"s1","seasonNumber":1,"episodeNumbers":[13]},{"provider":"tvdb_show","id":"78884","scope":"s1","seasonNumber":1,"episodeNumbers":[13]}],"link":"80883","synopsis":"Using the Amaterasu incident as a rationale, the Earth Federation stages a massive coup d'état, and demands the surrender of the Amaterasu. In the face of inevitable defeat, Sinon formulates a political strategy of her own.The Amaterasu's crew escaped via shuttle while Dita broadcasts the earth Alliance's attack on the guard ship. Shimei Yuuki, the only commissioned officer decided to be left behind.","thumbnail":"https://image.tmdb.org/t/p/w300/eLHVahoPkAHWr6uWWEWdjtghklF.jpg"}],"sourceIds":{"anilistId":342,"malId":342},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-28T07:48:11Z","sourceDescriptors":["anilist:342","mal:342"],"imdbSource":"plexanibridge-v2","targets":[{"provider":"anidb","id":"2745","scope":"R","ranges":{"1-13":"1-13"}},{"provider":"anilist","id":"342","ranges":{"1-13":"1-13"}},{"provider":"mal","id":"342","ranges":{"1-13":"1-13"}},{"provider":"tmdb_show","id":"34790","scope":"s1","ranges":{"1-13":"1-13"}},{"provider":"tvdb_show","id":"78884","scope":"s1","ranges":{"1-13":"1-13"}}]},"sourceMetadata":{"info":{"id":5325,"title":null,"title_eng":"Starship Operators","slug":"starship-operators","plot":"In una galassia in cui la civiltà umana si è espansa nell'universo, l'Impero (di cui si conosce gran poco e di cui si conosceran