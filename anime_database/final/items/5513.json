":"104080","episodeNumbers":[2]},{"provider":"mal","id":"38217","episodeNumbers":[2]},{"provider":"tmdb_show","id":"89576","scope":"s1","seasonNumber":1,"episodeNumbers":[2]},{"provider":"tvdb_show","id":"352327","scope":"s1","seasonNumber":1,"episodeNumbers":[2]}],"link":"83838","synopsis":"大树买来了用来隐藏阿淼猫耳的帽子。得到心仪帽子的阿淼开心得不得了，闹腾了一番后便迷迷糊糊睡着了。看着阿淼的睡颜，大树回想起了当初与阿淼相遇时的事。沉浸在回忆中没多久，恐怖的编辑长打来了电话……。","thumbnail":"https://image.tmdb.org/t/p/w300/9ePzJqnXVzo1pf30OcPIgZzQ4aB.jpg"},{"title":"Episodio 3","episodeNumber":3,"sourceEpisodeNumber":3,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"14306","scope":"R","episodeNumbers":[3]},{"provider":"anilist","id":"104080","episodeNumbers":[3]},{"provider":"mal","id":"38217","episodeNumbers":[3]},{"provider":"tmdb_show","id":"89576","scope":"s1","seasonNumber":1,"episodeNumbers":[3]},{"provider":"tvdb_show","id":"352327","scope":"s1","seasonNumber":1,"episodeNumbers":[3]}],"link":"83839","synopsis":"大树和阿淼去市场购买火锅食材。在市场里也自由奔放的阿淼，让大树忙得团团转。磕磕绊绊的购物总算结束踏上归途时，拎着沉重行李的阿淼却说要走捷径……。","thumbnail":"https://image.tmdb.org/t/p/w300/9ePzJqnXVzo1pf30OcPIgZzQ4aB.jpg"},{"title":"Episodio 4","episodeNumber":4,"sourceEpisodeNumber":4,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"14306","scope":"R","episodeNumbers":[4]},{"provider":"anilist","id":"104080","episodeNumbers":[4]},{"provider":"mal","id":"38217","episodeNumbers":[4]},{"provider":"tmdb_show","id":"89576","scope":"s1","seasonNumber":1,"episodeNumbers":[4]},{"provider":"tvdb_show","id":"352327","scope":"s1","seasonNumber":1,"episodeNumbers":[4]}],"link":"83840","synopsis":"为了学习做菜，大树与福利院的奶奶通了电话。因为自己的成长经历，大树回想起幼年时感受到的孤独。然而，他向阿淼告白，自从与阿淼相遇后，自己感受到了与他人的接触，以及阿淼对他来说是多么重要的存在……。","thumbnail":"https://image.tmdb.org/t/p/w300/6dHFSR9jGXcIyiQHnX2znqpiwT6.jpg"},{"title":"Episodio 5","episodeNumber":5,"sourceEpisodeNumber":5,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"14306","scope":"R","episodeNumbers":[5]},{"provider":"anilist","id":"104080","episodeNumbers":[5]},{"provider":"mal","id":"38217","episodeNumbers":[5]},{"provider":"tmdb_show","id":"89576","scope":"s1","seasonNumber":1,"episodeNumbers":[5]},{"provider":"tvdb_show","id":"352327","scope":"s1","seasonNumber":1,"episodeNumbers":[5]}],"link":"83842","synopsis":"阿淼的哥哥冬冬来到了家里。自称“耳朵族”的冬冬向大树告知了猫耳朵的秘密以及阿淼的身世。看到阿淼在冬冬面前彻底安下心来，大树的心情变得复杂。难道阿淼就要这样不在了吗！？","thumbnail":"https://image.tmdb.org/t/p/w300/fZCwcEgmPqyiV7g51SkTAmV4Ato.jpg"},{"title":"Episodio 6","episodeNumber":6,"sourceEpisodeNumber":6,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"14306","scope":"R","episodeNumbers":[6]},{"provider":"anilist","id":"104080","episodeNumbers":[6]},{"provider":"mal","id":"38217","episodeNumbers":[6]},{"provider":"tmdb_show","id":"89576","scope":"s1","seasonNumber":1,"episodeNumbers":[6]},{"provider":"tvdb_show","id":"352327","scope":"s1","seasonNumber":1,"episodeNumbers":[6]}],"link":"83841","synopsis":"冬冬说要带阿淼回去。大树说服自己，和家人冬冬一起生活对阿淼来说才是更好的选择。看到大树这副模样，阿淼做出了大树意想不到的决定……。","thumbnail":"https://image.tmdb.org/t/p/w300/xjO9Q8fI6DNQ0rBAMfhKdKu3zGv.jpg"},{"title":"Episodio 7","episodeNumber":7,"sourceEpisodeNumber":7,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"14306","scope":"R","episodeNumbers":[7]},{"provider":"anilist","id":"104080","episodeNumbers":[7]},{"provider":"mal","id":"38217","episodeNumbers":[7]},{"provider":"tmdb_show","id":"89576","scope":"s1","seasonNumber":1,"episodeNumbers":[7]},{"provider":"tvdb_show","id":"352327","scope":"s1","seasonNumber":1,"episodeNumbers":[7]}],"link":"83844","synopsis":"看到剪了头发的大树，阿淼哭着说“尾巴不见了”。原来至今为止，阿淼一直把大树的后脑勺头发当成了“尾巴”……。/持续繁重工作、陷入失眠的大树，被金主编命令休假两周。担心大树的金主赶到了他的家中……。","thumbnail":"https://image.tmdb.org/t/p/w300/fvQVBFcmiVcDPYCUiGCv1tPPc2v.jpg"},{"title":"Episodio 8","episodeNumber":8,"sourceEpisodeNumber":8,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"14306","scope":"R","episodeNumbers":[8]},{"provider":"anilist","id":"104080","episodeNumbers":[8]},{"provider":"mal","id":"38217","episodeNumbers":[8]},{"provider":"tmdb_show","id":"89576","scope":"s1","seasonNumber":1,"episodeNumbers":[8]},{"provider":"tvdb_show","id":"352327","scope":"s1","seasonNumber":1,"episodeNumbers":[8]}],"link":"83843","synopsis":"金主前来探望大树的家。在那里看到的，是大树抱着一个长着猫耳的少年睡在一起的冲击性场景……。“我也想和这么可爱的少年一起生活”，金主嫉妒得浑身发抖。金主作为漫画家的研修，送给大树一次日本旅行，但大树却给出了意外的答复……。","thumbnail":"https://image.tmdb.org/t/p/w300/xFAN3T2jfRZTwteuXOatQyGrNXF.jpg"},{"title":"Episodio 9","episodeNumber":9,"sourceEpisodeNumber":9,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"14306","scope":"R","episodeNumbers":[9]},{"provider":"anilist","id":"104080","episodeNumbers":[9]},{"provider":"mal","id":"38217","episodeNumbers":[9]},{"provider":"tmdb_show","id":"89576","scope":"s1","seasonNumber":1,"episodeNumbers":[9]},{"provider":"tvdb_show","id":"352327","scope":"s1","seasonNumber":1,"episodeNumbers":[9]}],"link":"83846","synopsis":"到达日本的阿淼和大树。两人正准备出门观光，但金主的命令让大树必须参加国际漫画交流会。依依不舍的大树只好将阿淼托付给一太丸（耳朵族的忍者）……。然而，两人逐渐无法忍受见不到面的寂寞……。","thumbnail":"https://image.tmdb.org/t/p/w300/gtervd9GWQv8Q2dlyM3ovNa4V9T.jpg"},{"title":"Episodio 10","episodeNumber":10,"sourceEpisodeNumber":10,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"14306","scope":"R","episodeNumbers":[10]},{"provider":"anilist","id":"104080","episodeNumbers":[10]},{"provider":"mal","id":"38217","episodeNumbers":[10]},{"provider":"tmdb_show","id":"89576","scope":"s1","seasonNumber":1,"episodeNumbers":[10]},{"provider":"tvdb_show","id":"352327","scope":"s1","seasonNumber":1,"episodeNumbers":[10]}],"link":"83845","synopsis":"作为花样滑冰奖牌得主而闻名的阿强，其实是阿淼认识的耳朵族。他声称是因采访来到日本。阿强看到阿淼和大树的样子，向大树直击核心地问道：“你喜欢阿淼吧？”动摇的大树对阿强的回答是……。","thumbnail":"https://image.tmdb.org/t/p/w300/3FYujfc653dVoCmxXsNJGnXvQeJ.jpg"},{"title":"Episodio 11","episodeNumber":11,"sourceEpisodeNumber":11,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"14306","scope":"R","episodeNumbers":[11]},{"provider":"anilist","id":"104080","episodeNumbers":[11]},{"provider":"mal","id":"38217","episodeNumbers":[11]},{"provider":"tmdb_show","id":"89576","scope":"s1","seasonNumber":1,"episodeNumbers":[11]},{"provider":"tvdb_show","id":"352327","scope":"s1","seasonNumber":1,"episodeNumbers":[11]}],"link":"83848","synopsis":"享受日本观光的大树和阿淼。两人一起泡温泉，但阿淼却泡晕了。担心的大树照顾着他，但醒来的阿淼却说自己口渴了……。","thumbnail":"https://image.tmdb.org/t/p/w300/nqmZnWD8nnamPa4s11tkygXfpAO.jpg"},{"title":"Episodio 12","episodeNumber":12,"sourceEpisodeNumber":12,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"14306","scope":"R","episodeNumbers":[12]},{"provider":"anilist","id":"104080","episodeNumbers":[12]},{"provider":"mal","id":"38217","episodeNumbers":[12]},{"provider":"tmdb_show","id":"89576","scope":"s1","seasonNumber":1,"episodeNumbers":[12]},{"provider":"tvdb_show","id":"352327","scope":"s1","seasonNumber":1,"episodeNumbers":[12]}],"link":"83847","synopsis":"阿淼和大树决定去看烟火大会。两人换上浴衣，尽情享受着日本旅行的最后一天。看着夜空中绽放的烟花，大树一边品味着幸福，一边也感到了“无法回到独自一人”的恐惧……。","thumbnail":"https://image.tmdb.org/t/p/w300/c5dwWXEe0bfVhRkLIetrOS7zB6.jpg"}],"sourceIds":{"anilistId":104080,"malId":38217},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-29T07:54:59Z","sourceDescriptors":["anilist:104080","mal:38217"],"targets":[{"provider":"anidb","id":"14306","scope":"R","ranges":{"1-12":"1-12"}},{"provider":"anilist","id":"104080","ranges":{"1-12":"1-12"}},{"provider":"mal","id":"38217","ranges":{"1-12":"1-12"}},{"provider":"tmdb_show","id":"89576","scope":"s1","ranges":{"1-12":"1-12"}},{"provider":"tvdb_show","id":"352327","scope":"s1","ranges":{"1-12":"1-12"}}]},"sourceMetadata":{"info":{"id":5513,"title":"Wei, Kanjian Erduo La!","title_eng":"Look, I Can See Your Ears!","slug":"look-i-can-see-your-ears","plot":"Daisu è cresciuto in orfanotrofio, ora fa il mangaka di professione, ma le sue opere non hanno un gran successo commerciale. L'artista conduce una vita solitaria e piuttosto piatta, finché la sua noia quotidiana non viene interrotta dall'incontro con un ragazzo dalle orecchie da gatto di nome