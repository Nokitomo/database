[2]},{"provider":"tmdb_show","id":"67063","scope":"s6","seasonNumber":6,"episodeNumbers":[2]},{"provider":"tvdb_show","id":"313488","scope":"s6","seasonNumber":6,"episodeNumbers":[2]}],"link":"103413","synopsis":"赶路途中众人复盘甲申之乱疑点：三十六贼当年为何结义、八奇技究竟是如何悟得、无根生作为领头人到底藏着什么秘密。王震球不断试探张楚岚，怀疑他体内藏着神明灵的力量，金凤婆婆回忆无根生过往，埋下宝儿姐与无根生存在渊源的伏笔。","thumbnail":"https://image.tmdb.org/t/p/w300/chl0htDy9GqrF9QlmZWcra9JAwU.jpg"},{"title":"Episodio 3","episodeNumber":3,"sourceEpisodeNumber":3,"seasonNumber":6,"externalMappings":[{"provider":"anidb","id":"19808","scope":"R","episodeNumbers":[3]},{"provider":"anilist","id":"198749","episodeNumbers":[3]},{"provider":"mal","id":"62246","episodeNumbers":[3]},{"provider":"tmdb_show","id":"67063","scope":"s6","seasonNumber":6,"episodeNumbers":[3]},{"provider":"tvdb_show","id":"313488","scope":"s6","seasonNumber":6,"episodeNumbers":[3]}],"link":"103878","synopsis":"外号 “西南毒瘤” 的王震球坦白心思：他加入队伍并非单纯帮忙，而是极度好奇张楚岚、冯宝宝身上的秘密，一路跟着只为看热闹、挖掘真相。同时另一队外国异人小队也盯上二十四节谷，双方注定争夺无根生遗留之物。","thumbnail":"https://image.tmdb.org/t/p/w300/wBuGHVPvp71WyzVmFfRoHw6tUO7.jpg"},{"title":"Episodio 4","episodeNumber":4,"sourceEpisodeNumber":4,"seasonNumber":6,"externalMappings":[{"provider":"anidb","id":"19808","scope":"R","episodeNumbers":[4]},{"provider":"anilist","id":"198749","episodeNumbers":[4]},{"provider":"mal","id":"62246","episodeNumbers":[4]},{"provider":"tmdb_show","id":"67063","scope":"s6","seasonNumber":6,"episodeNumbers":[4]},{"provider":"tvdb_show","id":"313488","scope":"s6","seasonNumber":6,"episodeNumbers":[4]}],"link":"103882","synopsis":"小队进入山谷密室，发现无根生留下的自画像与大量手记。画像、文字线索都指向惊人猜想：冯宝宝和无根生（本名冯曜）有极深的血缘关联，金凤婆婆见到画像情绪崩溃，尘封数十年的回忆开始松动。","thumbnail":"https://image.tmdb.org/t/p/w300/hpUEjbfQcRbvhPV1oF4Bo2YojA1.jpg"},{"title":"Episodio 5","episodeNumber":5,"sourceEpisodeNumber":5,"seasonNumber":6,"externalMappings":[{"provider":"anidb","id":"19808","scope":"R","episodeNumbers":[5]},{"provider":"anilist","id":"198749","episodeNumbers":[5]},{"provider":"mal","id":"62246","episodeNumbers":[5]},{"provider":"tmdb_show","id":"67063","scope":"s6","seasonNumber":6,"episodeNumbers":[5]},{"provider":"tvdb_show","id":"313488","scope":"s6","seasonNumber":6,"episodeNumbers":[5]}],"link":"104012","synopsis":"Zhang Chulan and Feng Baobao are thrust into a perilous mission to hunt down a secret org’s rogue agent.","thumbnail":"https://image.tmdb.org/t/p/w300/tNc1uQk5nVyIEilLimfSGClvsH9.jpg"},{"title":"Episodio 6","episodeNumber":6,"sourceEpisodeNumber":6,"seasonNumber":6,"externalMappings":[{"provider":"anidb","id":"19808","scope":"R","episodeNumbers":[6]},{"provider":"anilist","id":"198749","episodeNumbers":[6]},{"provider":"mal","id":"62246","episodeNumbers":[6]},{"provider":"tmdb_show","id":"67063","scope":"s6","seasonNumber":6,"episodeNumbers":[6]},{"provider":"tvdb_show","id":"313488","scope":"s6","seasonNumber":6,"episodeNumbers":[6]}],"link":"104216","synopsis":"众人解开山谷第一层谜题，所谓无根生宝藏并非金银珠宝，整座二十四节谷是天然修仙大阵，能自动引导人体先天一炁运转，也是无根生绝技 “神明灵” 的具象化载体，可化解世间一切术法。","thumbnail":"https://image.tmdb.org/t/p/w300/6KCBLhHjgwyUXnRDMFcWA6fNGVc.jpg"},{"title":"Episodio 7","episodeNumber":7,"sourceEpisodeNumber":7,"seasonNumber":6,"externalMappings":[{"provider":"anidb","id":"19808","scope":"R","episodeNumbers":[7]},{"provider":"anilist","id":"198749","episodeNumbers":[7]},{"provider":"mal","id":"62246","episodeNumbers":[7]},{"provider":"tmdb_show","id":"67063","scope":"s6","seasonNumber":6,"episodeNumbers":[7]},{"provider":"tvdb_show","id":"313488","scope":"s6","seasonNumber":6,"episodeNumbers":[7]}],"link":"104305","synopsis":"山谷核心刻着 “何为人” 三字，众人陷入沉思。各路角色各抒己见，最终冯宝宝站在阵眼，一手指天、一手指地，以最简单直白的姿态诠释 “顶天立地方为人”，瞬间破解大阵核心谜题。","thumbnail":"https://image.tmdb.org/t/p/w300/6uQaMnnTLkItMuMbdYcr3XYsYN2.jpg"},{"title":"Episodio 8","episodeNumber":8,"sourceEpisodeNumber":8,"seasonNumber":6,"externalMappings":[{"provider":"anidb","id":"19808","scope":"R","episodeNumbers":[8]},{"provider":"anilist","id":"198749","episodeNumbers":[8]},{"provider":"mal","id":"62246","episodeNumbers":[8]},{"provider":"tmdb_show","id":"67063","scope":"s6","seasonNumber":6,"episodeNumbers":[8]},{"provider":"tvdb_show","id":"313488","scope":"s6","seasonNumber":6,"episodeNumbers":[8]}],"link":"105220","synopsis":"山谷谜题全部解开，但人心的算计从未停止。张楚岚说服张灵玉加入己方阵营，拉拢战力；金凤婆婆彻底放下心结，决定主动对抗曲彤；小队离开秦岭，转头布局营救被双全手改造的马仙洪。","thumbnail":"https://image.tmdb.org/t/p/w300/tTFQ08O6H25xHPsKCUSiL35Ttim.jpg"},{"title":"Episodio 9","episodeNumber":9,"sourceEpisodeNumber":9,"seasonNumber":6,"externalMappings":[{"provider":"anidb","id":"19808","scope":"R","episodeNumbers":[9]},{"provider":"anilist","id":"198749","episodeNumbers":[9]},{"provider":"mal","id":"62246","episodeNumbers":[9]},{"provider":"tmdb_show","id":"67063","scope":"s6","seasonNumber":6,"episodeNumbers":[9]},{"provider":"tvdb_show","id":"313488","scope":"s6","seasonNumber":6,"episodeNumbers":[9]}],"link":"105484","synopsis":"画面切回曲彤视角，她用双全手篡改马仙洪的外貌、记忆、声音，将其彻底藏在暗处，利用马仙洪的神机百炼制造傀儡、神器布局。哪都通公司查出内部存在内鬼，所有线索都指向曲彤势力。","thumbnail":"https://image.tmdb.org/t/p/w300/nVAWyds7rJanAiTHjOzNHc6Fchd.jpg"},{"title":"Episodio 10","episodeNumber":10,"sourceEpisodeNumber":10,"seasonNumber":6,"externalMappings":[{"provider":"anidb","id":"19808","scope":"R","episodeNumbers":[10]},{"provider":"anilist","id":"198749","episodeNumbers":[10]},{"provider":"mal","id":"62246","episodeNumbers":[10]},{"provider":"tmdb_show","id":"67063","scope":"s6","seasonNumber":6,"episodeNumbers":[10]},{"provider":"tvdb_show","id":"313488","scope":"s6","seasonNumber":6,"episodeNumbers":[10]}],"link":"105745","synopsis":"吕家紧急召回所有在外族人，吕良逃出吕家，掌握完整版双全手。他向张楚岚坦白吕家龌龊：吕慈为守护双全手不择手段，吕良想要为姐姐复仇，与张楚岚达成临时合作，共同对抗曲彤。","thumbnail":"https://image.tmdb.org/t/p/w300/ax2Ugo7ygtnk5iI6U7hyyTo1FQo.jpg"},{"title":"Episodio 11","episodeNumber":11,"sourceEpisodeNumber":11,"seasonNumber":6,"externalMappings":[{"provider":"anidb","id":"19808","scope":"R","episodeNumbers":[11]},{"provider":"anilist","id":"198749","episodeNumbers":[11]},{"provider":"mal","id":"62246","episodeNumbers":[11]},{"provider":"tmdb_show","id":"67063","scope":"s6","seasonNumber":6,"episodeNumbers":[11]},{"provider":"tvdb_show","id":"313488","scope":"s6","seasonNumber":6,"episodeNumbers":[11]}],"link":"105869","synopsis":"张楚岚与哪都通赵总合谋上演一场大戏，故意放出假情报，引诱改造后的马仙洪现身。敌方高手柴言、萧霄、六子出手阻拦，三方势力混战，冯宝宝凭借强悍肉身碾压敌方傀儡。","thumbnail":"https://image.tmdb.org/t/p/w300/vvTj2OwQHRyman7zl8WA4hkmhMz.jpg"},{"title":"Episodio 12","episodeNumber":12,"sourceEpisodeNumber":12,"seasonNumber":6,"externalMappings":[{"provider":"anidb","id":"19808","scope":"R","episodeNumbers":[12]},{"provider":"anilist","id":"198749","episodeNumbers":[12]},{"provider":"mal","id":"62246","episodeNumbers":[12]},{"provider":"tmdb_show","id":"67063","scope":"s6","seasonNumber":6,"episodeNumbers":[12]},{"provider":"tvdb_show","id":"313488","scope":"s6","seasonNumber":6,"episodeNumbers":[12]}],"link":"105969","synopsis":"众人找到藏匿马仙洪的暗堡，见到被双全手操控、性情大变的马仙洪。张楚岚没有直接动手，而是不断提起碧游村往事、马仙洪的姐姐马春花，试图唤醒他残存的本心。","thumbnail":"https://image.tmdb.org/t/p/w300/g1cdtEHFaoJgoclgc2Ri5a7DxXR.jpg"},{"title":"Episodio 13","episodeNumber":13,"sourceEpisodeNumber":13,"seasonNumber":6,"externalMappings":[{"provider":"anidb","id":"19808","scope":"R","episodeNumbers":[13]},{"provider":"anilist","id":"198749","episodeNumbers":[13]},{"provider":"mal","id":"62246","episodeNumbers":[13]},{"provider":"tmdb_show","id":"67063","scope":"s6","seasonNumber":6,"episodeNumbers":[13]},{"provider":"tvdb_show","id":"313488","scope":"s6","seasonNumber":6,"episodeNumbers":[13]}],"link":"106132","synopsis":"曲彤远程操控马仙洪全力进攻，打斗中张楚岚体内潜藏的神明灵不受控制爆发，瞬间瓦解马仙洪所有神机造物。神明灵力量透支重创张楚岚经络，胡兰兰诊断他肉身与精神连接濒临断裂，随时可能昏迷不醒。","thumbnail":"https://image.tmdb.org/t/p/w300/9OZjts1FdUpdSRlYkiPrlXC4mdw.jpg"},{"title":"Episodio 14","episodeNumber":14,"sourceEpisodeNumber":14,"seasonNumber":6,"externalMappings":[{"provider":"anidb","id":"19808","scope":"R","episodeNumbers":[14]},{"provider":"anilist","id":"198749","episodeNumbers":[14]},{"provider":"mal","id":"62246","episodeNumbers":[14]},{"provider":"tmdb_show","id":"67063","scope":"s6","seasonNumber":6,"episodeNumbers":[14]},{"provider":"tvdb_show","id":"313488","scope":"s6","seasonNumber":6,"episodeNumbers":[14]}],"link":"106247","synopsis":"张楚岚在昏迷中回顾一路走来的经历，坚定初心。众人合力唤醒马仙洪残存意识，马仙洪短暂挣脱双全手控制，透露曲彤在公司安插内鬼的关键线索。此战过后，小队决定动身前往蜀中唐门，寻找三十六贼幸存者许新。","thumbnail":"https://image.tmdb.org/t/p/w300/4DlsJISNCjOusTjzFvLDOQfUjm.jpg"},{"title":"Episodio 15","episodeNumber":15,"sourceEpisodeNumber":15,"seasonNumber":6,"externalMappings":[{"provider":"anidb","id":"19808","scope":"R","episodeNumbers":[15]},{"provider":"anilist","id":"198749","episodeNumbers":[15]},{"provider":"mal","id":"62246","episodeNumbers":[15]},{"provider":"tmdb_show","id":"67063","scope":"s6","seasonNumber":6,"episodeNumbers":[15]},{"provider":"tvdb_show","id":"313488","scope":"s6","seasonNumber":6,"episodeNumbers":[15]}],"link":"106342","synopsis":"剧情切换至武当线，回忆王也当年下山、机缘巧合悟得风后奇门的全过程。十佬之一陈金魁毕生痴迷风后奇门，认定这是陈家本该拥有的术法，向王也发起三局赌约，誓要夺走风后奇门。","thumbnail":"https://image.tmdb.org/t/p/w300/pEni6wp4vPjrrS0IePrIQKeixCZ.jpg"},{"title":"Episodio 16","episodeNumber":16,"sourceEpisodeNumber":16,"seasonNumber":6,"externalMappings":[{"provider":"anidb","id":"19808","scope":"R","episodeNumbers":[16]},{"provider":"anilist","id":"198749","episodeNumbers":[16]},{"provider":"mal","id":"62246","episodeNumbers":[16]},{"provider":"tmdb_show","id":"67063","scope":"s6","seasonNumber":6,"episodeNumbers":[16]},{"provider":"tvdb_show","id":"313488","scope":"s6","seasonNumber":6,"episodeNumbers":[16]}],"link":"106497","synopsis":"王也与陈金魁开启赌斗，二人轮番施展风后奇门、十佬独门术法，战场瞬息万变。陈金魁为取胜不惜损耗寿元，动用家族禁术，手段疯狂，王也始终留手，不愿伤害这位执念深重的老者。","thumbnail":"https://image.tmdb.org/t/p/w300/tT5kgl303Yzyb68jOoaPUOoePc1.jpg"},{"title":"Episodio 17","episodeNumber":17,"sourceEpisodeNumber":17,"seasonNumber":6,"externalMappings":[{"provider":"anidb","id":"19808","scope":"R","episodeNumbers":[17]},{"provider":"anilist","id":"198749","episodeNumbers":[17]},{"provider":"mal","id":"62246","episodeNumbers":[17]},{"provider":"tmdb_show","id":"67063","scope":"s6","seasonNumber":6,"episodeNumbers":[17]},{"provider":"tvdb_show","id":"313488","scope":"s6","seasonNumber":6,"episodeNumbers":[17]}],"link":"106647","synopsis":"两场赌斗结束，陈金魁意识到自己一辈子被术法困住，心中只剩执念。王也点醒他 “术法只是工具”，陈金魁内心动摇，暂时放下抢夺风后奇门的念头，但心中心结并未完全解开。","thumbnail":"https://image.tmdb.org/t/p/w300/a7UAOWjdS7Eodliz6ZFf0msBue0.jpg"},{"title":"Episodio 18","episodeNumber":18,"sourceEpisodeNumber":18,"seasonNumber":6,"externalMappings":[{"provider":"anidb","id":"19808","scope":"R","episodeNumbers":[18]},{"provider":"anilist","id":"198749","episodeNumbers":[18]},{"provider":"mal","id":"62246","episodeNumbers":[18]},{"provider":"tmdb_show","id":"67063","scope":"s6","seasonNumber":6,"episodeNumbers":[18]},{"provider":"tvdb_show","id":"313488","scope":"s6","seasonNumber":6,"episodeNumbers":[18]}],"link":"106815","synopsis":"王也线告一段落，各路异人收到消息：蜀中唐门藏着三十六贼幸存者许新。张楚岚小队、丁嶋安、王也、曲彤手下、十佬势力全部动身前往唐门，一场围绕甲申之乱真相的大战即将在唐门开启。","thumbnail":"https://image.tmdb.org/t/p/w300/voUKmiZjL9PnE9C9mmKARXzA42t.jpg"},{"title":"Episodio 19","episodeNumber":19,"sourceEpisodeNumber":19,"seasonNumber":6,"externalMappings":[{"provider":"anidb","id":"19808","scope":"R","episodeNumbers":[19]},{"provider":"anilist","id":"198749","episodeNumbers":[19]},{"provider":"mal","id":"62246","episodeNumbers":[19]},{"provider":"tmdb_show","id":"67063","scope":"s6","seasonNumber":6,"episodeNumbers":[19]},{"provider":"tvdb_show","id":"313488","scope":"s6","seasonNumber":6,"episodeNumbers":[19]}],"link":"107091","synopsis":"众人抵达唐门，唐门内外门分歧严重：内门固守传统暗器、丹噬传承，外门主张开放、融合外界异人功法。现任门长唐妙兴表面冷漠，实则早已布下大局，计划借外来之人打开禁地唐冢。","thumbnail":"https://image.tmdb.org/t/p/w300/oM6tyfpsZDieYxAp6PVCAKBJvTu.jpg"},{"title":"Episodio 20","episodeNumber":20,"sourceEpisodeNumber":20,"seasonNumber":6,"externalMappings":[{"provider":"anidb","id":"19808","scope":"R","episodeNumbers":[20]},{"provider":"anilist","id":"198749","episodeNumbers":[20]},{"provider":"mal","id":"62246","episodeNumbers":[20]},{"provider":"tmdb_show","id":"67063","scope":"s6","seasonNumber":6,"episodeNumbers":[20]},{"provider":"tvdb_show","id":"313488","scope":"s6","seasonNumber":6,"episodeNumbers":[20]}],"link":"107413","synopsis":"曲彤手下域画毒潜伏唐门，依靠伪装术暗中偷袭，绑架唐门弟子。冯宝宝感知气息异常，依靠纯粹本能识破所有伪装，一路追打域画毒，展现无敌的近身作战能力。","thumbnail":"https://image.tmdb.org/t/p/w300/tt3radnPUkPa5nu1kBCTroHlnGx.jpg"},{"title":"Episodio 21","episodeNumber":21,"sourceEpisodeNumber":21,"seasonNumber":6,"externalMappings":[{"provider":"anidb","id":"19808","scope":"R","episodeNumbers":[21]},{"provider":"anilist","id":"198749","episodeNumbers":[21]},{"provider":"mal","id":"62246","episodeNumbers":[21]},{"provider":"tmdb_show","id":"67063","scope":"s6","seasonNumber":6,"episodeNumbers":[21]},{"provider":"tvdb_show","id":"313488","scope":"s6","seasonNumber":6,"episodeNumbers":[21]}],"link":"107595","synopsis":"唐门庭院大乱，全性三尸、两豪杰之一丁嶋安先后现身，各方势力互相牵制。张楚岚游走各方势力之间，左右逢源，稳住局面，只为顺利进入唐冢见到许新。","thumbnail":"https://image.tmdb.org/t/p/w300/8CPbLzndCUQvl4OMepRZbFFcsip.jpg"},{"title":"Episodio 22","episodeNumber":22,"sourceEpisodeNumber":22,"seasonNumber":6,"externalMappings":[{"provider":"anidb","id":"19808","scope":"R","episodeNumbers":[22]},{"provider":"anilist","id":"198749","episodeNumbers":[22]},{"provider":"mal","id":"62246","episodeNumbers":[22]},{"provider":"tmdb_show","id":"67063","scope":"s6","seasonNumber":6,"episodeNumbers":[22]},{"provider":"tvdb_show","id":"313488","scope":"s6","seasonNumber":6,"episodeNumbers":[22]}],"link":"107754","synopsis":"唐妙兴履行计划，打开唐门禁地唐冢。唐冢内埋葬历代唐门先辈，还封存着当年三十六贼许新的所有记录，众人终于见到存活近百年的三十六贼 —— 许新。","thumbnail":"https://image.tmdb.org/t/p/w300/cptvzhQCaaNEZEesCqsbyQJukQ.jpg"},{"title":"Episodio 23","episodeNumber":23,"sourceEpisodeNumber":23,"seasonNumber":6,"externalMappings":[{"provider":"anidb","id":"19808","scope":"R","episodeNumbers":[23]},{"provider":"anilist","id":"198749","episodeNumbers":[23]},{"provider":"mal","id":"62246","episodeNumbers":[23]},{"provider":"tmdb_show","id":"67063","scope":"s6","seasonNumber":6,"episodeNumbers":[23]},{"provider":"tvdb_show","id":"313488","scope":"s6","seasonNumber":6,"episodeNumbers":[23]}],"link":"107894","synopsis":"许新开口讲述当年甲申之乱完整往事：三十六贼如何相遇、如何结义、无根生真实性格、当年为何遭到全天下异人围剿。无根生的形象彻底丰满，同时揭开丹噬功法的起源。","thumbnail":"https://image.tmdb.org/t/p/w300/vPQrfX1fkR37SSNabNSP9CCk4VA.jpg"},{"title":"Episodio 24","episodeNumber":24,"sourceEpisodeNumber":24,"seasonNumber":6,"externalMappings":[{"provider":"anidb","id":"19808","scope":"R","episodeNumbers":[24]},{"provider":"anilist","id":"198749","episodeNumbers":[24]},{"provider":"mal","id":"62246","episodeNumbers":[24]},{"provider":"tmdb_show","id":"67063","scope":"s6","seasonNumber":6,"episodeNumbers":[24]},{"provider":"tvdb_show","id":"313488","scope":"s6","seasonNumber":6,"episodeNumbers":[24]}],"link":"108006","synopsis":"唐妙兴向众人坦白唐门最大秘密：丹噬威力无穷，但修炼者必死。唐门数百年来为守护丹噬背负无数杀戮，内外门矛盾根源就是是否该舍弃这门伤人伤己的禁术。","thumbnail":"https://image.tmdb.org/t/p/w300/pY6lAQEC7zHStcmpgYlQ47Z9Ouo.jpg"},{"title":"Episodio 25","episodeNumber":25,"sourceEpisodeNumber":25,"seasonNumber":6,"externalMappings":[{"provider":"anidb","id":"19808","scope":"R","episodeNumbers":[25]},{"provider":"anilist","id":"198749","episodeNumbers":[25]},{"provider":"mal","id":"62246","episodeNumbers":[25]},{"provider":"tmdb_show","id":"67063","scope":"s6","seasonNumber":6,"episodeNumbers":[25]},{"provider":"tvdb_show","id":"313488","scope":"s6","seasonNumber":6,"episodeNumbers":[25]}],"link":"108155","synopsis":"外门弟子逼迫唐妙兴废除丹噬，内门长老誓死守护传承。唐妙兴做出决断：他要亲自修炼丹噬，以自己的性命，彻底了结丹噬传承带来的百年枷锁。","thumbnail":"https://image.tmdb.org/t/p/w300/w6MH5zYOOooZt9x6gu4TjRC0SAX.jpg"},{"title":"Episodio 26","episodeNumber":26,"sourceEpisodeNumber":26,"seasonNumber":6,"externalMappings":[{"provider":"anidb","id":"19808","scope":"R","episodeNumbers":[26]},{"provider":"anilist","id":"198749","episodeNumbers":[26]},{"provider":"mal","id":"62246","episodeNumbers":[26]},{"provider":"tmdb_show","id":"67063","scope":"s6","seasonNumber":6,"episodeNumbers":[26]},{"provider":"tvdb_show","id":"313488","scope":"s6","seasonNumber":6,"episodeNumbers":[26]}],"link":"108242","synopsis":"唐冢终极对决：唐妙兴燃烧性命施展丹噬，以自身死亡终结丹