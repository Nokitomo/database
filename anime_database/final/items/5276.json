ps://image.tmdb.org/t/p/original/fYTCUc6dkC7OIlK433Dx7uC8pQX.jpg"},{"source":"cinemeta","url":"https://live.metahub.space/background/medium/tt4954596/img"},{"source":"anizip","url":"https://artworks.thetvdb.com/banners/fanart/original/297311-1.jpg"},{"source":"provider","url":"https://img.animeunity.co/anime/21204-7xUTP7JNkSrP.png"},{"source":"anilist","url":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/21204-7xUTP7JNkSrP.png"}]}},"related":[],"linkList":[{"title":"Episodes 1-12","titleKey":"Episodes {{start}}-{{end}}","titleParams":{"start":1,"end":12},"availabilityStatus":"available","episodesLink":"5276|1|12"}]},"episodes":[{"title":"Episodio 1","episodeNumber":1,"sourceEpisodeNumber":1,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"11157","scope":"R","episodeNumbers":[1]},{"provider":"anilist","id":"21204","episodeNumbers":[1]},{"provider":"mal","id":"30437","episodeNumbers":[1]},{"provider":"tmdb_show","id":"77237","scope":"s1","seasonNumber":1,"episodeNumbers":[1]},{"provider":"tvdb_show","id":"297311","scope":"s1","seasonNumber":1,"episodeNumbers":[1]}],"link":"80226","synopsis":"Murasaki Wakako is a twenty-seven year old working lady. As per her daily routine, she rewards herself for a hard day at work by bar-hopping in search of the best alcohol and seafood the world has to offer. On tonight's menu, she has some crispy fried salted salmon and cold sake. This ultimate combination makes her purr in satisfaction.","thumbnail":"https://image.tmdb.org/t/p/w300/7OliIvPTDsW9c7collnAd1Pia2l.jpg"},{"title":"Episodio 2","episodeNumber":2,"sourceEpisodeNumber":2,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"11157","scope":"R","episodeNumbers":[2]},{"provider":"anilist","id":"21204","episodeNumbers":[2]},{"provider":"mal","id":"30437","episodeNumbers":[2]},{"provider":"tmdb_show","id":"77237","scope":"s1","seasonNumber":1,"episodeNumbers":[2]},{"provider":"tvdb_show","id":"297311","scope":"s1","seasonNumber":1,"episodeNumbers":[2]}],"link":"80227","synopsis":"Freshly-fried food is out of this world! Tonight's menu is comprised of stuff that Wakako has strong cravings for every now and then, fried chicken and chilled beer. The beer goes perfectly with the chicken as it washes down the fresh'n'juicy aftertaste. Dig in while it's hot!","thumbnail":"https://image.tmdb.org/t/p/w300/qknV52SCXvxmGeRMtyFdMlQgEzD.jpg"},{"title":"Episodio 3","episodeNumber":3,"sourceEpisodeNumber":3,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"11157","scope":"R","episodeNumbers":[3]},{"provider":"anilist","id":"21204","episodeNumbers":[3]},{"provider":"mal","id":"30437","episodeNumbers":[3]},{"provider":"tmdb_show","id":"77237","scope":"s1","seasonNumber":1,"episodeNumbers":[3]},{"provider":"tvdb_show","id":"297311","scope":"s1","seasonNumber":1,"episodeNumbers":[3]}],"link":"80228","synopsis":"Drown your sorrows in alcohol! On tonight's menu is a comfort meal, monkfish liver in ponzu accompanied by hot sake. After stuffing her face with the liver, Wakako washes it down with the sake. Even the worst days at the office can seem like no big deal after this.","thumbnail":"https://image.tmdb.org/t/p/w300/hcFfllexWyN0gQdXEIUboXzPxYM.jpg"},{"title":"Episodio 4","episodeNumber":4,"sourceEpisodeNumber":4,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"11157","scope":"R","episodeNumbers":[4]},{"provider":"anilist","id":"21204","episodeNumbers":[4]},{"provider":"mal","id":"30437","episodeNumbers":[4]},{"provider":"tmdb_show","id":"77237","scope":"s1","seasonNumber":1,"episodeNumbers":[4]},{"provider":"tvdb_show","id":"297311","scope":"s1","seasonNumber":1,"episodeNumbers":[4]}],"link":"80229","synopsis":"A local specialty! On tonight's menu is Hiroshima's famous sea urchin cresson and beer. When placed on a pan with melted butter, the urchins seem like they break out into a dance. And what else could go better with this working-class meal than a cold beer?","thumbnail":"https://image.tmdb.org/t/p/w300/eML4daHI9oJU8SIYPpbJWfxzhma.jpg"},{"title":"Episodio 5","episodeNumber":5,"sourceEpisodeNumber":5,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"11157","scope":"R","episodeNumbers":[5]},{"provider":"anilist","id":"21204","episodeNumbers":[5]},{"provider":"mal","id":"30437","episodeNumbers":[5]},{"provider":"tmdb_show","id":"77237","scope":"s1","seasonNumber":1,"episodeNumbers":[5]},{"provider":"tvdb_show","id":"297311","scope":"s1","seasonNumber":1,"episodeNumbers":[5]}],"link":"80230","synopsis":"The perfect plan! On tonight's menu is some charcoal-grilled yakitori and draft beer. With a glass of beer in hand, Wakako stuffs her face with the skewered yakitori and immediately washes it down with her drink. In that smoky ambience, this sip feels divine.","thumbnail":"https://image.tmdb.org/t/p/w300/oR3HdRY1qwvn6T7DmrX7GKo8WCV.jpg"},{"title":"Episodio 6","episodeNumber":6,"sourceEpisodeNumber":6,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"11157","scope":"R","episodeNumbers":[6]},{"provider":"anilist","id":"21204","episodeNumbers":[6]},{"provider":"mal","id":"30437","episodeNumbers":[6]},{"provider":"tmdb_show","id":"77237","scope":"s1","seasonNumber":1,"episodeNumbers":[6]},{"provider":"tvdb_show","id":"297311","scope":"s1","seasonNumber":1,"episodeNumbers":[6]}],"link":"80231","synopsis":"After a tiring day's work, have some relaxing steamed clams and sake. The perfectly-prepared soup soaks into the clams and heals your exhausted body and soul. The sake goes down smoothly, perhaps aided by the feelings of gratitude towards the seven seas for providing this delicacy.","thumbnail":"https://image.tmdb.org/t/p/w300/umxRkP803slKXW6jBid6NHPNGlE.jpg"},{"title":"Episodio 7","episodeNumber":7,"sourceEpisodeNumber":7,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"11157","scope":"R","episodeNumbers":[7]},{"provider":"anilist","id":"21204","episodeNumbers":[7]},{"provider":"mal","id":"30437","episodeNumbers":[7]},{"provider":"tmdb_show","id":"77237","scope":"s1","seasonNumber":1,"episodeNumbers":[7]},{"provider":"tvdb_show","id":"297311","scope":"s1","seasonNumber":1,"episodeNumbers":[7]}],"link":"80232","synopsis":"Nothing beats a good potato salad! On tonight's menu is the common man's best friend, potato salad, accompanied by oolong tea highball. The down-to-earth drink and potatoes form a top-class B+ duo, filling both your belly and your soul.","thumbnail":"https://image.tmdb.org/t/p/w300/hbofM0NS5CyAWHbUOhAvTz68a7V.jpg"},{"title":"Episodio 8","episodeNumber":8,"sourceEpisodeNumber":8,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"11157","scope":"R","episodeNumbers":[8]},{"provider":"anilist","id":"21204","episodeNumbers":[8]},{"provider":"mal","id":"30437","episodeNumbers":[8]},{"provider":"tmdb_show","id":"77237","scope":"s1","seasonNumber":1,"episodeNumbers":[8]},{"provider":"tvdb_show","id":"297311","scope":"s1","seasonNumber":1,"episodeNumbers":[8]}],"link":"80233","synopsis":"Wakako eats goya chanpuru.","thumbnail":"https://image.tmdb.org/t/p/w300/8xg38ZbPLtO8qXprQGvslpSAag5.jpg"},{"title":"Episodio 9","episodeNumber":9,"sourceEpisodeNumber":9,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"11157","scope":"R","episodeNumbers":[9]},{"provider":"anilist","id":"21204","episodeNumbers":[9]},{"provider":"mal","id":"30437","episodeNumbers":[9]},{"provider":"tmdb_show","id":"77237","scope":"s1","seasonNumber":1,"episodeNumbers":[9]},{"provider":"tvdb_show","id":"297311","scope":"s1","seasonNumber":1,"episodeNumbers":[9]}],"link":"80234","synopsis":"Wakako eats kani miso","thumbnail":"https://image.tmdb.org/t/p/w300/65aQ0npf1xLH41NXT9a8W39GUMK.jpg"},{"title":"Episodio 10","episodeNumber":10,"sourceEpisodeNumber":10,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"11157","scope":"R","episodeNumbers":[10]},{"provider":"anilist","id":"21204","episodeNumbers":[10]},{"provider":"mal","id":"30437","episodeNumbers":[10]},{"provider":"tm