a con tutta sé stessa, fino quasi a morire, ma al sua risveglio scopre che Arianne si è presa il merito delle sue azioni. Devastata dallo scoprire che Arianne l'ha sempre e solo usata, Lua si imbatte nel secondo principe in ordine di successione, il quale le propone un'allettante offerta. Sarà Lua pronta a diventare l'antagonista della storia per ottenere la sua vendetta?","date":"2025","episodes_count":12,"episodes_length":13,"author":" ","created_at":"2025-07-12 16:27:37","status":"Terminato","imageurl_cover":"","type":"TV Short","slug":"with-vengeance-sincerely-your-broken-saintess","title_eng":"With Vengeance, Sincerely, Your Broken Saintess","day":"Indeterminato","favorites":169,"score":"7.54","visite":119478,"studio":"Imageworks Studio","dub":0,"always_home":1,"members":953,"cover":"https://img.animeworld.ac/copertine/pA5XR.png","anilist_id":195209,"season":"Estate","title_it":null,"mal_id":59961,"crunchy_id":null,"netflix_id":null,"prime_id":null,"disney_id":null,"pivot":{"anime_id":7821,"related_id":6862,"number":1}},{"id":7821,"user_id":2,"title":"Kizu darake Seijo yori Houfuku wo Komete 2","imageurl":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/b212144-9qJMcEdy4Xbo.jpg","plot":"Seconda stagione di With Vengeance, Sincerely, Your Broken Saintess","date":"2026","episodes_count":0,"episodes_length":13,"author":" ","created_at":"2026-10-02 15:52:54","status":"In Corso","imageurl_cover":"","type":"TV Short","slug":"with-vengeance-sincerely-your-broken-saintess-2","title_eng":"With Vengeance, Sincerely, Your Broken Saintess 2","day":"Giovedì","favorites":35,"score":"7.94","visite":24433,"studio":"Imageworks Studio","dub":0,"always_home":1,"members":235,"cover":"https://img.animeworld.ac/copertine/y686a.png","anilist_id":212144,"season":"Autunno","title_it":null,"mal_id":64180,"crunchy_id":null,"netflix_id":null,"prime_id":null,"disney_id":null,"pivot":{"anime_id":7821,"related_id":7821,"number":1}}]},"archive":{"id":7821,"user_id":2,"title":"K