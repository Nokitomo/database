rl":"https://live.metahub.space/logo/medium/tt26450255/img"},{"source":"anizip","url":"https://artworks.thetvdb.com/banners/v4/series/418904/clearlogo/64348f194051b.png"}],"poster":[{"source":"tvdb","url":"https://artworks.thetvdb.com/banners/v4/series/418904/posters/63f882e6516a2.jpg"},{"source":"provider","url":"https://img.animeunity.co/anime/bx170018-1PqdLX68YayA.jpg"},{"source":"cinemeta","url":"https://live.metahub.space/poster/small/tt26450255/img"},{"source":"anizip","url":"https://artworks.thetvdb.com/banners/v4/series/418904/posters/63f8821f4aeda.jpg"}],"background":[{"source":"cinemeta","url":"https://live.metahub.space/background/medium/tt26450255/img"},{"source":"anizip","url":"https://artworks.thetvdb.com/banners/v4/series/418904/backgrounds/64060ae7ab78a.jpg"}]}},"related":[{"title":"The Blue Orchestra","link":"https://www.animeunity.co/anime/4578-the-blue-orchestra","image":"https://img.animeunity.co/anime/bx147369-Aodog1O7Nhuq.png","type":"TV","year":"2023","dubStatus":"subbed","dubStatusKey":"Subbed","variants":[{"status":"subbed","statusKey":"Subbed","title":"The Blue Orchestra","link":"https://www.animeunity.co/anime/4578-the-blue-orchestra","image":"https://img.animeunity.co/anime/bx147369-Aodog1O7Nhuq.png"}]},{"title":"The Blue Orchestra 2","link":"https://www.animeunity.co/anime/7104-the-blue-orchestra-2","image":"https://img.animeunity.co/anime/bx170018-1PqdLX68YayA.jpg","type":"TV","year":"2025","dubStatus":"subbed","dubStatusKey":"Subbed","variants":[{"status":"subbed","statusKey":"Subbed","title":"The Blue Orchestra 2","link":"https://www.animeunity.co/anime/7104-the-blue-orchestra-2","image":"https://img.animeunity.co/anime/bx170018-1PqdLX68YayA.jpg"}]}],"linkList":[{"title":"Episodes 1-21","titleKey":"Episodes {{start}}-{{end}}","titleParams":{"start":1,"end":21},"availabilityStatus":"available","episodesLink":"7104|1|21"}]},"episodes":[{"title":"Coming Apart","episodeNumber":1,"sourceEpisodeNumber":1,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"18234","scope":"R","episodeNumbers":[1]},{"provider":"anilist","id":"170018","episodeNumbers":[1]},{"provider":"mal","id":"56877","episodeNumbers":[1]},{"provider":"tmdb_show","id":"197368","scope":"s2","seasonNumber":2,"episodeNumbers":[1]},{"provider":"tvdb_show","id":"418904","scope":"s2","seasonNumber":2,"episodeNumbers":[1]}],"link":"101635","synopsis":"The Orchestra club has given their regular concert, and next will be the national competition. They will aim to continue their string of victories, but now with just the first and second-years. However, during the morning practice on the first day, the number of violins was surprisingly small. Furthermore, Sakuma, the leader of percussion, provokes new concertmaster Hatori and the members of the string instruments with harsh words. Aono is confused, and Saeki and Ritsuko are angry.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/10081988/screencap/68e245e64afce.jpg"},{"title":"Ripples","episodeNumber":2,"sourceEpisodeNumber":2,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"18234","scope":"R","episodeNumbers":[2]},{"provider":"anilist","id":"170018","episodeNumbers":[2]},{"provider":"mal","id":"56877","episodeNumbers":[2]},{"provider":"tmdb_show","id":"197368","scope":"s2","seasonNumber":2,"episodeNumbers":[2]},{"provider":"tvdb_show","id":"418904","scope":"s2","seasonNumber":2,"episodeNumbers":[2]}],"link":"101785","synopsis":"Takimoto, who was transferred from the first violin section to become the leader of the second violin section, has been skipping morning practice. At meetings, Sakuma and the others criticize him for not showing up despite being in a position to lead the section, but Takimoto continues to evade the question and doesn't explain the reason. Eventually, the frustration of the second violin section members explodes, and they confront Takimoto. Aono witnesses this. Takimoto leaves, saying something meaningful, and leaves. Then, Susono, who is worried about Takimoto, makes an unexpected suggestion.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/11320437/screencap/68e312cad3fff.jpg"},{"title":"Responsibility","episodeNumber":3,"sourceEpisodeNumber":3,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"18234","scope":"R","episodeNumbers":[3]},{"provider":"anilist","id":"170018","episodeNumbers":[3]},{"provider":"mal","id":"56877","episodeNumbers":[3]},{"provider":"tmdb_show","id":"197368","scope":"s2","seasonNumber":2,"episodeNumbers":[3]},{"provider":"tvdb_show","id":"418904","scope":"s2","seasonNumber":2,"episodeNumbers":[3]}],"link":"101871","synopsis":"On his way home from school, Aono unexpectedly bumps into Takimoto, who is crying alone in pain. As Aono shows concern for his senior, Takimoto slowly begins to speak. He talks about the events surrounding the club member who quit, and his own cold feelings and confusion after no longer finding meaning in club activities. These feelings overlap with Aono's, who once gave up the violin due to his relationship with his father. Aono talks about the pain he felt when he stopped playing, and how his feelings toward his father are different now than they were back then. Aono's words make Takimoto decide.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/11320438/screencap/68ec2e692aabf.jpg"},{"title":"Sports Day","episodeNumber":4,"sourceEpisodeNumber":4,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"18234","scope":"R","episodeNumbers":[4]},{"provider":"anilist","id":"170018","episodeNumbers":[4]},{"provider":"mal","id":"56877","episodeNumbers":[4]},{"provider":"tmdb_show","id":"197368","scope":"s2","seasonNumber":2,"episodeNumbers":[4]},{"provider":"tvdb_show","id":"418904","scope":"s2","seasonNumber":2,"episodeNumbers":[4]}],"link":"102070","synopsis":"With two months until the competition, the string instruments are beginning to come together under the guidance of concertmaster Hatori, and the sports festival is upon us. Ritsuko, a member of the inter-club relay team, is inspired by Aono's determination to have fun and give it her all as she competes. However, she is also chosen as the class's leader for the horse-riding battle. Aono is timid, and Saeki, who is also competing in the battle, becomes competitive. Haru, who can't help but root for Aono, who is in a different group, asks him a question that has been bothering her for a while.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/11320439/screencap/68f946ecdfd7f.jpg"},{"title":"Issues","episodeNumber":5,"sourceEpisodeNumber":5,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"18234","scope":"R","episodeNumbers":[5]},{"provider":"anilist","id":"170018","episodeNumbers":[5]},{"provider":"mal","id":"56877","episodeNumbers":[5]},{"provider":"tmdb_show","id":"197368","scope":"s2","seasonNumber":2,"episodeNumbers":[5]},{"provider":"tvdb_show","id":"418904","scope":"s2","seasonNumber":2,"episodeNumbers":[5]}],"link":"102320","synopsis":"There is one month until the competition. With the entire band still unable to agree on an interpretation of the piece, they split into three groups and begin block practice, with Aono ending up in the same group as Sakuma. \"Bacchanale\" from Saint-Saëns' opera \"Samson and Delilah\" depicts the love and hate between a man and a woman amidst an antagonistic relationship. It is filled with elegance and charm, anger and sadness, lies and secrets. Haru, who is in a different group from Aono, grasps something from a conversation with Machii, a third-year senior who knows how Haru feels about Aono.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/11320440/screencap/69038da798694.jpg"},{"title":"Regret and Progress","episodeNumber":6,"sourceEpisodeNumber":6,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"18234","scope":"R","episodeNumbers":[6]},{"provider":"anilist","id":"170018","episodeNumbers":[6]},{"provider":"mal","id":"56877","episodeNumbers":[6]},{"provider":"tmdb_show","id":"197368","scope":"s2","seasonNumber":2,"episodeNumbers":[6]},{"provider":"tvdb_show","id":"418904","scope":"s2","seasonNumber":2,"episodeNumbers":[6]}],"link":"102557","synopsis":"Tachibana, who is in the same group as Ritsuko during block practice, is irritated by the other members of the club who refuse to take the initiative. Ritsuko senses that Tachibana is always conscious of Sakuma, a senior from the same junior high school. Tachibana tells Ritsuko about how he took over as captain from Sakuma at the junior high school orchestra club, which was a regular gold medalist in competitions, and about the bitter experience and regret he had when his own enthusiasm and sense of responsibility didn't translate into results. Tachibana and Ritsuko are tuning their instruments together. Sakuma is playing the timpani in a separate room.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/11320441/screencap/69080a6e7e6c7.jpg"},{"title":"Anger","episodeNumber":7,"sourceEpisodeNumber":7,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"18234","scope":"R","episodeNumbers":[7]},{"provider":"anilist","id":"170018","episodeNumbers":[7]},{"provider":"mal","id":"56877","episodeNumbers":[7]},{"provider":"tmdb_show","id":"197368","scope":"s2","seasonNumber":2,"episodeNumbers":[7]},{"provider":"tvdb_show","id":"418904","scope":"s2","seasonNumber":2,"episodeNumbers":[7]}],"link":"102653","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/11320442/screencap/69202ecc944d2.jpg"},{"title":"Competition","episodeNumber":8,"sourceEpisodeNumber":8,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"18234","scope":"R","episodeNumbers":[8]},{"provider":"anilist","id":"170018","episodeNumbers":[8]},{"provider":"mal","id":"56877","episodeNumbers":[8]},{"provider":"tmdb_show","id":"197368","scope":"s2","seasonNumber":2,"episodeNumbers":[8]},{"provider":"tvdb_show","id":"418904","scope":"s2","seasonNumber":2,"episodeNumbers":[8]}],"link":"102757","synopsis":"And then the real competition arrives. Kaimaku High School is aiming for their ninth consecutive victory, while rival schools are determined to win this year. Ritsuko, who says that everyone looks good in their unfamiliar uniforms, is encouraged by Tachibana. Sakuma and Tsutsui renew their secret resolve to not run away from past regrets. Amid quiet tension and excitement, what supports each member is the days they poured all their passion into music. Harada and the other third-year students watch from the audience. With the call of \"One sound, one encounter,\" the curtain rises on the new orchestra club.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/11320443/screencap/69202ea221519.jpg"},{"title":"Bacchanale","episodeNumber":9,"sourceEpisodeNumber":9,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"18234","scope":"R","episodeNumbers":[9]},{"provider":"anilist","id":"170018","episodeNumbers":[9]},{"provider":"mal","id":"56877","episodeNumbers":[9]},{"provider":"tmdb_show","id":"197368","scope":"s2","seasonNumber":2,"episodeNumbers":[9]},{"provider":"tvdb_show","id":"418904","scope":"s2","seasonNumber":2,"episodeNumbers":[9]}],"link":"102838","synopsis":"The Kaimaku High School Orchestra Club has overcome differences in motivation among its members and discord over interpretations of the pieces they are performing by seriously competing with each other. Now they are taking on the competition, a stage where performances are judged on their merits. They have discovered the \"anger\" they feel in the story of \"Bacchanale,\" which depicts the love and hate between Samson and Delilah. Aono and his friends play with all their might, filled with emotion and emotion, a sound that can only be produced in this moment. Will they be able to achieve their ninth consecutive national victory?","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/11320444/screencap/692c1bcde2027.jpg"},{"title":"Identity","episodeNumber":10,"sourceEpisodeNumber":10,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"18234","scope":"R","episodeNumbers":[10]},{"provider":"anilist","id":"170018","episodeNumbers":[10]},{"provider":"mal","id":"56877","episodeNumbers":[10]},{"provider":"tmdb_show","id":"197368","scope":"s2","seasonNumber":2,"episodeNumbers":[10]},{"provider":"tvdb_show","id":"418904","scope":"s2","seasonNumber":2,"episodeNumbers":[10]}],"link":"102921","synopsis":"After the competition is over and there are no club activities, Aono and Haru go out together. Their destination is a music store that Aono has been going to since he was a child.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/11320445/screencap/693552c81110e.jpg"},{"title":"Present","episodeNumber":11,"sourceEpisodeNumber":11,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"18234","scope":"R","episodeNumbers":[11]},{"provider":"anilist","id":"170018","episodeNumbers":[11]},{"provider":"mal","id":"56877","episodeNumbers":[11]},{"provider":"tmdb_show","id":"197368","scope":"s2","seasonNumber":2,"episodeNumbers":[11]},{"provider":"tvdb_show","id":"418904","scope":"s2","seasonNumber":2,"episodeNumbers":[11]}],"link":"103089","synopsis":"Ritsuko calls Aono to ask for a favor. She wants to give him a performance of Bach's \"Concerto for Two Violins,\" Aono's mother's favorite, as a birthday present. Just like in middle school, Ritsuko tutors Aono, and Aono teaches her violin. On his birthday, Aono is excited to visit a girl's room for the first time. Ritsuko's mother is curious about Aono, whom she's meeting for the first time. The two begin playing. The sound of the violin holds special meaning in the relationship between Ritsuko and her mother.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/11320446/screencap/6946a9de6b2a4.jpg"},{"title":"Choir","episodeNumber":12,"sourceEpisodeNumber":12,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"18234","scope":"R","episodeNumbers":[12]},{"provider":"anilist","id":"170018","episodeNumbers":[12]},{"provider":"mal","id":"56877","episodeNumbers":[12]},{"provider":"tmdb_show","id":"197368","scope":"s2","seasonNumber":2,"episodeNumbers":[12]},{"provider":"tvdb_show","id":"418904","scope":"s2","seasonNumber":2,"episodeNumbers":[12]}],"link":"103174","synopsis":"Aono, Ritsuko, and Haru. Confused by their fluctuating feelings, the three of them continue to act as usual. Aono receives help from Ritsuko and Haru in his studies and finishes his final exams. The orchestra club's next performance is a Christmas concert held jointly with the choir club. Not only will the choir members sing along with the orchestra, but the orchestra members will also join in on some songs. Aono is embarrassed to sing in front of people and struggles with the unfamiliar songs. Then, a dignified voice resonates. Who is that voice?","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/11320447/screencap/6946aa15c602a.jpg"},{"title":"Morning Mist","episodeNumber":13,"sourceEpisodeNumber":13,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"18234","scope":"R","episodeNumbers":[13]},{"provider":"anilist","id":"170018","episodeNumbers":[13]},{"provider":"mal","id":"56877","episodeNumbers":[13]},{"provider":"tmdb_show","id":"197368","scope":"s2","seasonNumber":2,"episodeNumbers":[13]},{"provider":"tvdb_show","id":"418904","scope":"s2","seasonNumber":2,"episodeNumbers":[13]}],"link":"103359","synopsis":"Saeki heads to school early in the morning. The sky is at dawn, the air is cold. On a quiet winter morning, the voice of \"Ave Maria\" playing from his earphones brings back memories of his childhood in Germany with his mother.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/11320448/screencap/6950410b555b5.jpg"},{"title":"Christmas Concert","episodeNumber":14,"sourceEpisodeNumber":14,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"18234","scope":"R","episodeNumbers":[14]},{"provider":"anilist","id":"170018","episodeNumbers":[14]},{"provider":"mal","id":"56877","episodeNumbers":[14]},{"provider":"tmdb_show","id":"197368","scope":"s2","seasonNumber":2,"episodeNumbers":[14]},{"provider":"tvdb_show","id":"418904","scope":"s2","seasonNumber":2,"episodeNumbers":[14]}],"link":"103441","synopsis":"The Christmas concert, a joint performance with the choir club, opened with the orchestra members also singing \"Joy to the World.\" The voices resonated along with the majestic pipe organ. Ritsuko's mother was overwhelmed by the powerful sound that vibrated through her entire body. Aono's mother was also there. Next came \"Ave Maria.\" As she played, Saeki was enveloped in warm memories of her mother. Then came the magnificent \"Hallelujah Chorus.\" A sense of profound accomplishment remained in Aono's heart. After the performance, the cold rain had somehow turned into snow.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/11320449/screencap/69637a6a880ac.jpg"},{"title":"New Scenery","episodeNumber":15,"sourceEpisodeNumber":15,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"18234","scope":"R","episodeNumbers":[15]},{"provider":"anilist","id":"170018","episodeNumbers":[15]},{"provider":"mal","id":"56877","episodeNumbers":[15]},{"provider":"tmdb_show","id":"197368","scope":"s2","seasonNumber":2,"episodeNumbers":[15]},{"provider":"tvdb_show","id":"418904","scope":"s2","seasonNumber":2,"episodeNumbers":[15]}],"link":"103742","synopsis":"January 1st is Aono's birthday. Aono's new year begins with a visit to the shrine with Ritsuko, Haru, Saeki, and Yamada. Then comes the first club activity after the winter break.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/11320450/screencap/696cbb733dae1.jpg"},{"title":"Genroku Iwatora","episodeNumber":16,"sourceEpisodeNumber":16,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"18234","scope":"R","episodeNumbers":[16]},{"provider":"anilist","id":"170018","episodeNumbers":[16]},{"provider":"mal","id":"56877","episodeNumbers":[16]},{"provider":"tmdb_show","id":"197368","scope":"s2","seasonNumber":2,"episodeNumbers":[16]},{"provider":"tvdb_show","id":"418904","scope":"s2","seasonNumber":2,"episodeNumbers":[16]}],"link":"103954","synopsis":"Aono and his friends pass the audition and become members of the junior orchestra. However, many of the successful applicants are students from high schools attached to music colleges.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/11320451/screencap/697141124a545.jpg"},{"title":"A Distinguished Father","episodeNumber":17,"sourceEpisodeNumber":17,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"18234","scope":"R","episodeNumbers":[17]},{"provider":"anilist","id":"170018","episodeNumbers":[17]},{"provider":"mal","id":"56877","episodeNumbers":[17]},{"provider":"tmdb_show","id":"197368","scope":"s2","seasonNumber":2,"episodeNumbers":[17]},{"provider":"tvdb_show","id":"418904","scope":"s2","seasonNumber":2,"episodeNumbers":[17]}],"link":"104042","synopsis":"The heat radiating from Iwato's entire body guides the sound. Aono and the others hang on desperately to the strict instruction. The piece is Akutagawa Yasushi's \"Music for Symphony Orchestra.\"","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/11320452/screencap/697b9721ee0a1.jpg"},{"title":"Respective Signs","episodeNumber":18,"sourceEpisodeNumber":18,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"18234","scope":"R","episodeNumbers":[18]},{"provider":"anilist","id":"170018","episodeNumbers":[18]},{"provider":"mal","id":"56877","episodeNumbers":[18]},{"provider":"tmdb_show","id":"197368","scope":"s2","seasonNumber":2,"episodeNumbers":[18]},{"provider":"tvdb_show","id":"418904","scope":"s2","seasonNumber":2,"episodeNumbers":[18]}],"link":"104242","synopsis":"Valentine's Day is a time when chocolates fly all over the school. The orchestra club members are also in high spirits. Aono is upset when he discovers chocolate hidden in his desk. He also realizes that Ritsuko, who had been handing out chocolates to everyone, hasn't given him any.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/11320453/screencap/6986473bd64fc.jpg"},{"title":"True Nature","episodeNumber":19,"sourceEpisodeNumber":19,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"18234","scope":"R","episodeNumbers":[19]},{"provider":"anilist","id":"170018","episodeNumbers":[19]},{"provider":"mal","id":"56877","episodeNumbers":[19]},{"provider":"tmdb_show","id":"197368","scope":"s2","seasonNumber":2,"episodeNumbers":[19]},{"provider":"tvdb_show","id":"418904","scope":"s2","seasonNumber":2,"episodeNumbers":[19]}],"link":"104626","synopsis":"The members of the Junior Orchestra, who will be representing Japan in the competition, are all strong-willed individuals who want to pursue a career in music. Among them, Subaru Yukito, who sits in the concertmaster's seat, has a presence that seems to have poured everything into music, and Aono is overwhelmed by it.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/11320454/screencap/698dda9b0f22a.jpg"},{"title":"Surpass","episodeNumber":20,"sourceEpisodeNumber":20,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"18234","scope":"R","episodeNumbers":[20]},{"provider":"anilist","id":"170018","episodeNumbers":[20]},{"provider":"mal","id":"56877","episodeNumbers":[20]},{"provider":"tmdb_show","id":"197368","scope":"s2","seasonNumber":2,"episodeNumbers":[20]},{"provider":"tvdb_show","id":"418904","scope":"s2","seasonNumber":2,"episodeNumbers":[20]}],"link":"105318","synopsis":"The auditions were held in pairs, and it was Aono and Haru's turn. The highly synchronized performance of the two astounded the judges.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/11320455/screencap/6993648589ac7.jpg"},{"title":"Graduation","episodeNumber":21,"sourceEpisodeNumber":21,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"18234","scope":"R","episodeNumbers":[21]},{"provider":"anilist","id":"170018","episodeNumbers":[21]},{"provider":"mal","id":"56877","episodeNumbers":[21]},{"provider":"tmdb_show","id":"197368","scope":"s2","seasonNumber":2,"episodeNumbers":[21]},{"provider":"tvdb_show","id":"418904","scope":"s2","seasonNumber":2,"episodeNumbers":[21]}],"link":"105565","synopsis":"March, when the cherry blossoms bloom, is the season of departure. There's a graduation ceremony and a graduation party for the orchestra club. In their fleeting conversation, the feelings of those leaving and those seeing them off intertwine. Through their sometimes violent clashes, they achieve growth and create music.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/11320456/screencap/699dd9dca8e2f.jpg"}],"sourceIds":{"anilistId":170018,"malId":56877},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-28T07:48:11Z","sourceDescriptors":["anilist:170018","mal:56877"],"targets":[{"provider":"anidb","id":"18234","scope":"R","ranges":{"1-21":"1-21"}},{"provider":"anilist","id":"170018","ranges":{"1-21":"1-21"}},{"provider":"mal","id":"56877","ranges":{"1-21":"1-21"}},{"provider":"tmdb_show","id":"197368","scope":"s2","ranges":{"1-21":"1-21"}},{"provider":"tvdb_show","id":"418904","scope":"s2","ranges":{"1-21":"1-21"}}]},"sourceMetadata":{"info":{"id":7104,"title":"Ao no Orchestra 2","title_eng":"The Blue Orchestra 2","slug":"the-blue-orchestra-2","plot":"Seconda stagione di Ao no Orchestra","type":"TV","status":"Terminato","date":"2025","studio":"Nippon Animation","dub":0,"mal_id":56877,"anilist_id":170018,"imageurl":"https://img.animeunity.co/anime/bx170018-1PqdLX68YayA.jpg","imageurl_cover":null,"cover":"https://img.animeunity.co/anime/dapD6.png","score":"8.04","episodes_count":21,"genres":["Drama","Music","School"],"related":[{"id":4578,"title":"Ao no Orchestra","title_eng":"The Blue Orchestra","