[1]},{"provider":"mal","id":"62391","episodeNumbers":[1]},{"provider":"tmdb_show","id":"300131","scope":"s1","seasonNumber":1,"episodeNumbers":[1]},{"provider":"tvdb_show","id":"467414","scope":"s1","seasonNumber":1,"episodeNumbers":[1]}],"link":"107384","synopsis":"Mysteriously transformed in a kid, legendary hitman Juzo poses as a student to investigate a middle school. Later, he encounters a suspicious intruder.","thumbnail":"https://image.tmdb.org/t/p/w300/foXvhDu0iRMyAMxUWoZ7FVvnlR9.jpg"},{"title":"Episodio 2","episodeNumber":2,"sourceEpisodeNumber":2,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"19546","scope":"R","episodeNumbers":[2]},{"provider":"anilist","id":"198113","episodeNumbers":[2]},{"provider":"mal","id":"62391","episodeNumbers":[2]},{"provider":"tmdb_show","id":"300131","scope":"s1","seasonNumber":1,"episodeNumbers":[2]},{"provider":"tvdb_show","id":"467414","scope":"s1","seasonNumber":1,"episodeNumbers":[2]}],"link":"107661","synopsis":"Juzo discovers Mitsuoka Pharmaceuticals created the wasp and befriends the president's aloof daughter Noren. As he slowly befriends her, she's kidnapped.","thumbnail":"https://image.tmdb.org/t/p/w300/sYFdVMQvdAB4lb03HoHRgYzfCMK.jpg"},{"title":"Episodio 3","episodeNumber":3,"sourceEpisodeNumber":3,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"19546","scope":"R","episodeNumbers":[3]},{"provider":"anilist","id":"198113","episodeNumbers":[3]},{"provider":"mal","id":"62391","episodeNumbers":[3]},{"provider":"tmdb_show","id":"300131","scope":"s1","seasonNumber":1,"episodeNumbers":[3]},{"provider":"tvdb_show","id":"467414","scope":"s1","seasonNumber":1,"episodeNumbers":[3]}],"link":"107772","synopsis":"Juzo turns to a classmate to catch up on his studies and joins the home economics club with Noren. Mitsuoka Pharmaceuticals makes a big announcement.","thumbnail":"https://image.tmdb.org/t/p/w300/53nQfRTYaKMU7y9HTeXA1RaB8K2.jpg"},{"title":"Episodio 4","episodeNumber":4,"sourceEpisodeNumber":4,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"19546","scope":"R","episodeNumbers":[4]},{"provider":"anilist","id":"198113","episodeNumbers":[4]},{"provider":"mal","id":"62391","episodeNumbers":[4]},{"provider":"tmdb_show","id":"300131","scope":"s1","seasonNumber":1,"episodeNumbers":[4]},{"provider":"tvdb_show","id":"467414","scope":"s1","seasonNumber":1,"episodeNumbers":[4]}],"link":"107912","synopsis":"Juzo's cover as Noren's boyfriend comes under fire when a young assassin transfers in and challenges Juzo to a duel in a bid to become Noren's fiancé.","thumbnail":"https://image.tmdb.org/t/p/w300/u8vWZsKkNp7pgxiPkhC9To3ZDtI.jpg"},{"title":"Episodio 5","episodeNumber":5,"sourceEpisodeNumber":5,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"19546","scope":"R","episodeNumbers":[5]},{"provider":"anilist","id":"198113","episodeNumbers":[5]},{"provider":"mal","id":"62391","episodeNumbers":[5]},{"provider":"tmdb_show","id":"300131","scope":"s1","seasonNumber":1,"episodeNumbers":[5]},{"provider":"tvdb_show","id":"467414","scope":"s1","seasonNumber":1,"episodeNumbers":[5]}],"link":"108049","synopsis":"While on an errand, the Home Economics Club runs into Tenma, a brash multi-sport ace who challenges Juzo to a futsal match. Will Juzo take him on?","thumbnail":"https://image.tmdb.org/t/p/w300/7x3OKMX9bqogvWna3rZUnebpgrT.jpg"},{"title":"Episodio 6","episodeNumber":6,"sourceEpisodeNumber":6,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"19546","scope":"R","episodeNumbers":[6]},{"provider":"anilist","id":"198113","episodeNumbers":[6]},{"provider":"mal","id":"62391","episodeNumbers":[6]},{"provider":"tmdb_show","id":"300131","scope":"s1","seasonNumber":1,"episodeNumbers":[6]},{"provider":"tvdb_show","id":"467414","scope":"s1","seasonNumber":1,"episodeNumbers":[6]}],"link":"108176","synopsis":"Juzo and Tenma’s futsal showdown begins. With his astonishing physical ability, Tenma overwhelms the Home Ec Club team of Juzo, Shin, and Kito. Sensing that Juzo is no ordinary opponent, Tenma drops the handicap and starts playing for real. Juzo and the others fight desperately to keep up with Tenma’s dominant performance, but how will the match end?","thumbnail":"https://image.tmdb.org/t/p/w300/6bhdCAkKEEWeeyqM8FtOUlZkpet.jpg"},{"title":"Episodio 7","episodeNumber":7,"sourceEpisodeNumber":7,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"19546","scope":"R","episodeNumbers":[7]},{"provider":"anilist","id":"198113","episodeNumbers":[7]},{"provider":"mal","id":"62391","episodeNumbers":[7]},{"provider":"tmdb_show","id":"300131","scope":"s1","seasonNumber":1,"episodeNumbers":[7]},{"provider":"tvdb_show","id":"467414","scope":"s1","seasonNumber":1,"episodeNumbers":[7]}],"link":"108254","synopsis":"Juzo and Noren end up on a double date with Chisato and Tenma. The four enjoy shopping and lunch, but the moment the movie starts, Juzo mysteriously reverts to his adult body! He rushes to the restroom, only for Noren to be kidnapped again. Chasing the culprit’s car to a stadium, Juzo and Tenma face Kazuma and Eiji Rindou, assassin brothers from the industry’s top organization, JARDIN.","thumbnail":"https://image.tmdb.org/t/p/w300/A6ocpruU9RzlMdSCOe0RmoPIzFD.jpg"},{"title":"Episodio 8","episodeNumber":8,"sourceEpisodeNumber":8,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"19546","scope":"R","episodeNumbers":[8]},{"provider":"anilist","id":"198113","episodeNumbers":[8]},{"provider":"mal","id":"62391","episodeNumbers":[8]},{"provider":"tmdb_show","id":"300131","scope":"s1","seasonNumber":1,"episodeNumbers":[8]},{"provider":"tvdb_show","id":"467414","scope":"s1","seasonNumber":1,"episodeNumbers":[8]}],"link":"108403","synopsis":"Kazuma wields powerful hypnosis, while Eiji launches a brutal assault with explosive golf balls. They, too, are assassins chasing Mitsuoka Pharmaceutical’s secrets. Juzo struggles as Kazuma turns civilians against him. And Kazuma has already placed a certain hypnotic spell on Noren. To save her, Juzo races to her side...","thumbnail":"https://image.tmdb.org/t/p/w300/kAt7narqwG8x2fWaxpd3zbTuR3P.jpg"},{"title":"Episodio 9","episodeNumber":9,"sourceEpisodeNumber":9,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"19546","scope":"R","episodeNumbers":[9]},{"provider":"anilist","id":"198113","episodeNumbers":[9]},{"provider":"mal","id":"62391","episodeNumbers":[9]},{"provider":"tmdb_show","id":"300131","scope":"s1","seasonNumber":1,"episodeNumbers":[9]},{"provider":"tvdb_show","id":"467414","scope":"s1","seasonNumber":1,"episodeNumbers":[9]}],"link":"108531","synopsis":"Juzo races to Noren’s side. Meanwhile, Tenma and Eiji clash in an outrageous soccer-vs.-explosive-golf battle. Tenma prepares to end the fight with a move he developed in practice. But at the end of the life-or-death struggle against Kazuma and Eiji, the unconscious Noren awakens, and the first thing she sees is...","thumbnail":"https://image.tmdb.org/t/p/w300/4KjlUaaZfMxJT82QMmL7gwutMkA.jpg"},{"title":"Episodio 10","episodeNumber":10,"sourceEpisodeNumber":10,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"19546","scope":"R","episodeNumbers":[10]},{"provider":"anilist","id":"198113","episodeNumbers":[10]},{"provider":"mal","id":"62391","episodeNumbers":[10]},{"provider":"tmdb_show","id":"300131","scope":"s1","seasonNumber":1,"episodeNumbers":[10]},{"provider":"tvdb_show","id":"467414","scope":"s1","seasonNumber":1,"episodeNumbers":[10]}],"link":"108699","synopsis":"After Kazuma’s hypnosis makes Noren fall deeply for Juzo, she launches an all-out attack on his heart. But when Juzo gently turns her down, she tries to jump from the roof! Desperate to undo the spell, Juzo takes Noren to meet Kazuma at an amusement park, only to end up alone with her on a Ferris wheel, where things take a dangerously romantic turn?!","thumbnail":"https://image.tmdb.org/t/p/w300/9AvP94SyBJD8tUPGaK2lRrRZbq0.jpg"},{"title":"Episodio 11","episodeNumber":11,"sourceEpisodeNumber":11,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"19546","scope":"R","episodeNumbers":[11]},{"provider":"anilist","id":"198113","episodeNumbers":[11]},{"provider":"mal","id":"62391","episodeNumbers":[11]},{"provider":"tmdb_show","id":"300131","scope":"s1","seasonNumber":1,"episodeNumbers":[11]},{"provider":"tvdb_show","id":"467414","scope":"s1","seasonNumber":1,"episodeNumbers":[11]}],"link":"109021","synopsis":"With more assassins gathering at school, Ogami organizes the first-ever Hitman Summit in hopes of keeping everyone under control. However, the meeting quickly descends into chaos as the eccentric personalities clash. Meanwhile, a heated ramen challenge draws unexpected attention, and a mysterious girl makes a surprising appearance that may change everything.","thumbnail":"https://image.tmdb.org/t/p/w300/f3tduSg4VwCDyrL06h3A9rhYx1X.jpg"},{"title":"Episodio 12","episodeNumber":12,"sourceEpisodeNumber":12,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"19546","scope":"R","episodeNumbers":[12]},{"provider":"anilist","id":"198113","episodeNumbers":[12]},{"provider":"mal","id":"62391","episodeNumbers":[12]},{"provider":"tmdb_show","id":"300131","scope":"s1","seasonNumber":1,"episodeNumbers":[12]},{"provider":"tvdb_show","id":"467414","scope":"s1","seasonNumber":1,"episodeNumbers":[12]}],"link":"109186","synopsis":"Unicorn Mai Otohime is a marine-sports prodigy with expert-level ocean knowledge. She has come for a Mitsuoka Duel too, but her target is Juzo. This leads to Noren challenging Mai herself. As the duel nears, Juzo and the others face parent-teacher conferences and questions about their futures, leading Juzo to reflect on his school life, the friends he’s made, and the possibilities ahead.","thumbnail":"https://image.tmdb.org/t/p/w300/acqj2QaE0XAi9FGBP1WB6qrmi1Y.jpg"}],"sourceIds":{"anilistId":198113,"malId":62391},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-29T07:54: