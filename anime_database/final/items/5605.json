tica una degli assalitori, una spadaccina di nome Akame dal passato oscuro, Tatsumi scopre che in realtà la famiglia che lo ha accolto segretamente rapisce viandanti e vagabondi al solo scopo di torturarli a morte e trova proprio gli amici Ieyasu e Sayo tra le ultime vittime. Furente, uccide lui stesso l'ultima sopravvissuta e finisce per unirsi ai Night Raid con la speranza di riuscire a eliminare la malvagità dell'impero. Ma potrà un assassino portare giustizia?","date":"2014","episodes_count":24,"episodes_length":24,"author":" ","created_at":"2018-07-11 20:36:47","status":"Terminato","imageurl_cover":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/20613-CoEQF4qKiWDX.jpg","type":"TV","slug":"akame-ga-kill","title_eng":"Akame ga Kill!","day":"Domenica","favorites":1635,"score":"8.24","visite":1126585,"studio":"White Fox","dub":0,"always_home":0,"members":10278,"cover":null,"anilist_id":20613,"season":"Estate","title_it":null,"mal_id":22199,"crunchy_id":null,"netflix_id":null,"prime_id":null,"disney_id":null,"pivot":{"anime_id":5605,"related_id":19,"number":1}}]},"archive":null},"sourceEpisodes":[{"id":85301,"anime_id":5605,"user_id":2,"number":"1","created_at":"2024-09-14 16:24:39","link":"https://srv18-tsurukusa.sweetpixel.org/DDL/ANIME/AkaKill/AkameGaKill_Special_01_SUB_ITA.mp4","visite":14029,"hidden":0,"public":1,"scws_id":260625,"file_name":"AkameGaKill_Special_01_SUB_ITA.mp4","tg_post":0},{"id":85302,"anime_id":5605,"user_id":2,"number":"2","created_at":"2024-09-14 16:24:39","link":"https://srv18-tsurukusa.sweetpixel.org/DDL/ANIME/AkaKill/AkameGaKill_Special_02_SUB_ITA.mp4","visite":2104,"hidden":0,"public":1,"scws_id":260626,"file_name":"AkameGaKill_Special_02_SUB_ITA.mp4","tg_post":0},{"id":85303,"anime_id":5605,"user_id":2,"number":"3","created_at":"2024-09-14 16:24:40","link":"https://srv18-tsurukusa.sweetpixel.org/DDL/ANIME/AkaKill/AkameGaKill_Special_03_SUB_ITA.mp4","visite":1074,"hidden":0,"public":1,"scws_id":260627,"file_name":"AkameGaKill_