s":{"start":1,"end":25},"availabilityStatus":"available","episodesLink":"5506|1|25"}]},"episodes":[{"title":"Il ritorno di Genki","episodeNumber":1,"sourceEpisodeNumber":1,"seasonNumber":3,"externalMappings":[{"provider":"anidb","id":"4695","scope":"R","episodeNumbers":[1]},{"provider":"anilist","id":"13201","episodeNumbers":[1]},{"provider":"mal","id":"13201","episodeNumbers":[1]},{"provider":"tmdb_show","id":"15130","scope":"s3","seasonNumber":3,"episodeNumbers":[1]},{"provider":"tvdb_show","id":"72858","scope":"s3","seasonNumber":3,"episodeNumbers":[1]}],"link":"83774","synopsis":"A year has passed since the final battle with Moo, Genki still cannot forget his friends. Suddenly he is led by an image of Mocchi to a deserted shop with a Monster Rancher game disc. Playing the disc he sees his friends quest to defeat Moo unfolds before him and saw what happened in his absence. After the battle, the gang is seperated. After finding and unlocking Mocchi from his Mystery Disc, Holly and Mocchi embarked on a quest to reunite the gang. They found a Mystery Disc containing Moo and Holly's father. Baddies reappear to claim the disc and the duo are in danger with Mocchi losing all his fighting abilities when he was turned into a Mystery Disc after the final battle with Moo. Also, a mysterious enemy seems to be behind the baddies.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/72858/101348.jpg"},{"title":"Di nuovo insieme","episodeNumber":2,"sourceEpisodeNumber":2,"seasonNumber":3,"externalMappings":[{"provider":"anidb","id":"4695","scope":"R","episodeNumbers":[2]},{"provider":"anilist","id":"13201","episodeNumbers":[2]},{"provider":"mal","id":"13201","episodeNumbers":[2]},{"provider":"tmdb_show","id":"15130","scope":"s3","seasonNumber":3,"episodeNumbers":[2]},{"provider":"tvdb_show","id":"72858","scope":"s3","seasonNumber":3,"episodeNumbers":[2]}],"link":"83775","synopsis":"Holly is determined to free his father from the Disc and trap Moo inside. The three enters a city to eat and while they are there, they saw Poritoka and Most in the Legend Cup competition. They were shocked at Poritoka's amazing fighting abilities but even more surprised when they saw the Magic Stone on the Winner's Plate."},{"title":"Il ritorno di Tiger","episodeNumber":3,"sourceEpisodeNumber":3,"seasonNumber":3,"externalMappings":[{"provider":"anidb","id":"4695","scope":"R","episodeNumbers":[3]},{"provider":"anilist","id":"13201","episodeNumbers":[3]},{"provider":"mal","id":"13201","episodeNumbers":[3]},{"provider":"tmdb_show","id":"15130","scope":"s3","seasonNumber":3,"episodeNumbers":[3]},{"provider":"tvdb_show","id":"72858","scope":"s3","seasonNumber":3,"episodeNumbers":[3]}],"link":"83776","synopsis":"Genki and Mocchi take part in the first of six competition that leads to the Legend Cup. Not only was the title at stake, a Mystery Disc containing Tiger is also on the line!","thumbnail":"https://artworks.thetvdb.com/banners/episodes/72858/101350.jpg"},{"title":"Hare salva la situazione","episodeNumber":4,"sourceEpisodeNumber":4,"seasonNumber":3,"externalMappings":[{"provider":"anidb","id":"4695","scope":"R","episodeNumbers":[4]},{"provider":"anilist","id":"13201","episodeNumbers":[4]},{"provider":"mal","id":"13201","episodeNumbers":[4]},{"provider":"tmdb_show","id":"15130","scope":"s3","seasonNumber":3,"episodeNumbers":[4]},{"provider":"tvdb_show","id":"72858","scope":"s3","seasonNumber":3,"episodeNumbers":[4]}],"link":"83777","synopsis":"The gang runs into Hare at an orchard and finds out that he has been living with Tama who saved Hare after the battle with Moo. Seeing that they are on such good terms, the gang cannot bear to break them apart. Leaving Hare behind, the run into Zerbasaurians that are sent by General Durahan. With Holly held hostage; Hare comes at the nick of time to save the day. In the end, Tama makes a tough decision to let Hare go.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/72858/101351.jpg"},{"title":"Wonder Brothers","episodeNumber":5,"sourceEpisodeNumber":5,"seasonNumber":3,"externalMappings":[{"provider":"anidb","id":"4695","scope":"R","episodeNumbers":[5]},{"provider":"anilist","id":"13201","episodeNumbers":[5]},{"provider":"mal","id":"13201","episodeNumbers":[5]},{"provider":"tmdb_show","id":"15130","scope":"s3","seasonNumber":3,"episodeNumbers":[5]},{"provider":"tvdb_show","id":"72858","scope":"s3","seasonNumber":3,"episodeNumbers":[5]}],"link":"83778","synopsis":"While Mocchi is searching for food, he chance upon the Wondar Brothers. The younger Wondar is a huge Hare Type monster with immense strength while the elder Wondar is good with his brains. Mocchi brought them and their gift of gigantic potatoes back to the gang. Just as they were about to become good friends, the elder Wondar revealed that their goals clash, for he wants his younger brother to become the strongest monster there is!"},{"title":"La presunzione di Tiger","episodeNumber":6,"sourceEpisodeNumber":6,"seasonNumber":3,"externalMappings":[{"provider":"anidb","id":"4695","scope":"R","episodeNumbers":[6]},{"provider":"anilist","id":"13201","episodeNumbers":[6]},{"provider":"mal","id":"13201","episodeNumbers":[6]},{"provider":"tmdb_show","id":"15130","scope":"s3","seasonNumber":3,"episodeNumbers":[6]},{"provider":"tvdb_show","id":"72858","scope":"s3","seasonNumber":3,"episodeNumbers":[6]}],"link":"83779","synopsis":"Tiger wants to make his debut at the Mandy Cup but everyone is worried that he won't be able to do it without his abilities (which he has forgotten). Genki tried to teach Tiger some defensive moves but Tiger insists on continue practicing alone to receive his abilities. So, Genki and Tiger broke out into a fight and when they enter for the competition the next day, Tiger refuses to be coached by Genki.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/72858/101353.jpg"},{"title":"Il compagno perduto","episodeNumber":7,"sourceEpisodeNumber":7,"seasonNumber":3,"externalMappings":[{"provider":"anidb","id":"4695","scope":"R","episodeNumbers":[7]},{"provider":"anilist","id":"13201","episodeNumbers":[7]},{"provider":"mal","id":"13201","episodeNumbers":[7]},{"provider":"tmdb_show","id":"15130","scope":"s3","seasonNumber":3,"episodeNumbers":[7]},{"provider":"tvdb_show","id":"72858","scope":"s3","seasonNumber":3,"episodeNumbers":[7]}],"link":"83780","synopsis":"The gang got interested in Hare's little baggage but Hare refuses to show them. Then, a small Dinosaur came and stole Hare's baggage! The gang gives chase and found that the Dinosaur is an orphan living under the care of Fairy Hare, one of Hare's long lost friends.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/72858/101354.jpg"},{"title":"Il tesoro sommerso","episodeNumber":8,"sourceEpisodeNumber":8,"seasonNumber":3,"externalMappings":[{"provider":"anidb","id":"4695","scope":"R","episodeNumbers":[8]},{"provider":"anilist","id":"13201","episodeNumbers":[8]},{"provider":"mal","id":"13201","episodeNumbers":[8]},{"provider":"tmdb_show","id":"15130","scope":"s3","seasonNumber":3,"episodeNumbers":[8]},{"provider":"tvdb_show","id":"72858","scope":"s3","seasonNumber":3,"episodeNumbers":[8]}],"link":"83781","synopsis":"Fed up with their failures, General Durahan sends out his Shelly Gabus to deal with the gang. The Gabus caught up with the gang who found themselves on a deserted sea platform. After an intense battle, the Mystery Disc dropped into the ocean."},{"title":"Suezo campione","episodeNumber":9,"sourceEpisodeNumber":9,"seasonNumber":3,"externalMappings":[{"provider":"anidb","id":"4695","scope":"R","episodeNumbers":[9]},{"provider":"anilist","id":"13201","episodeNumbers":[9]},{"provider":"mal","id":"13201","episodeNumbers":[9]},{"provider":"tmdb_show","id":"15130","scope":"s3","seasonNumber":3,"episodeNumbers":[9]},{"provider":"tvdb_show","id":"72858","scope":"s3","seasonNumber":3,"episodeNumbers":[9]}],"link":"83782","synopsis":"In this competition (3 rounds, 1 on 1), Mocchi must enter with two other monsters in the list that is designated by the IMA. Guess what? Only Golem and Suezo qualify! While Golem is fine, Suezo is terrified. Furthermore, there is only one other team in this championship! So the decided to win the first two rounds so Suezo does not have to fight!","thumbnail":"https://artworks.thetvdb.com/banners/episodes/72858/101356.jpg"},{"title":"Una traversata pericolosa","episodeNumber":10,"sourceEpisodeNumber":10,"seasonNumber":3,"externalMappings":[{"provider":"anidb","id":"4695","scope":"R","episodeNumbers":[10]},{"provider":"anilist","id":"13201","episodeNumbers":[10]},{"provider":"mal","id":"13201","episodeNumbers":[10]},{"provider":"tmdb_show","id":"15130","scope":"s3","seasonNumber":3,"episodeNumbers":[10]},{"provider":"tvdb_show","id":"72858","scope":"s3","seasonNumber":3,"episodeNumbers":[10]}],"link":"83783","synopsis":"The gang tries to cross the marshlands but have problems with getting a cheap taxi. In the end they took Sandra's offer of 700 gold. The first half of the journey was a roller coaster ride with Golem barely hanging on! Halfway through the marshlands, Sandra suddenly stops and tells them that she is going back!","thumbnail":"https://artworks.thetvdb.com/banners/episodes/72858/101357.jpg"},{"title":"Grazie Allan","episodeNumber":11,"sourceEpisodeNumber":11,"seasonNumber":3,"externalMappings":[{"provider":"anidb","id":"4695","scope":"R","episodeNumbers":[11]},{"provider":"anilist","id":"13201","episodeNumbers":[11]},{"provider":"mal","id":"13201","episodeNumbers":[11]},{"provider":"tmdb_show","id":"15130","scope":"s3","seasonNumber":3,"episodeNumbers":[11]},{"provider":"tvdb_show","id":"72858","scope":"s3","seasonNumber":3,"episodeNumbers":[11]}],"link":"83784","synopsis":"In the forest, Genki is busy with creating battle plans when Wood Golem attacks. No one listens to Genki's battle plans and Genki, Mocchi and Wood Golem falls into the river.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/72858/101358.jpg"},{"title":"La generosità di Golem","episodeNumber":12,"sourceEpisodeNumber":12,"seasonNumber":3,"externalMappings":[{"provider":"anidb","id":"4695","scope":"R","episodeNumbers":[12]},{"provider":"anilist","id":"13201","episodeNumbers":[12]},{"provider":"mal","id":"13201","episodeNumbers":[12]},{"provider":"tmdb_show","id":"15130","scope":"s3","seasonNumber":3,"episodeNumbers":[12]},{"provider":"tvdb_show","id":"72858","scope":"s3","seasonNumber":3,"episodeNumbers":[12]}],"link":"83785","synopsis":"In the Winner's Cup held in a town by the seaside, Mocchi's partner has to be Golem who is the only 1 in the 5 IMA designated monsters that is with the gang. It will be 2 rounds of 1 on 1 battles and a Sudden Death in the event of a tie against the defending champions. While Golem is bend on making up for his mistakes the other time, Mocchi isn't feeling well at all and faints (from high fever) while registering. After being sent to the hospital, they ponder if they should withdraw but Golem decides that he will win the 1st round and even if Mocchi lost, he will win in the Sudden Death round. While on his way to practice, Golem runs into Michelle, a girl who shares much interest in common with Golem. Golem brings her to the beach and she faints from exhaustion.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/72858/101359.jpg"},{"title":"La scelta di Pink Jam","episodeNumber":13,"sourceEpisodeNumber":13,"seasonNumber":3,"externalMappings":[{"provider":"anidb","id":"4695","scope":"R","episodeNumbers":[13]},{"provider":"anilist","id":"13201","episodeNumbers":[13]},{"provider":"mal","id":"13201","episodeNumbers":[13]},{"provider":"tmdb_show","id":"15130","scope":"s3","seasonNumber":3,"episodeNumbers":[13]},{"provider":"tvdb_show","id":"72858","scope":"s3","seasonNumber":3,"episodeNumbers":[13]}],"link":"83786","synopsis":"Pink Jam and the gels who have changed their ways but are still failures in whatever they do. Incidentally, the gang meets up with them (but they don't realize it as they concealed their baddies' crest). Just as things where going well, a fearsome trio of Jokers attacked!","thumbnail":"https://artworks.thetvdb.com/banners/episodes/72858/101360.jpg"},{"title":"Un'arma infallibile","episodeNumber":14,"sourceEpisodeNumber":14,"seasonNumber":3,"externalMappings":[{"provider":"anidb","id":"4695","scope":"R","episodeNumbers":[14]},{"provider":"anilist","id":"13201","episodeNumbers":[14]},{"provider":"mal","id":"13201","episodeNumbers":[14]},{"provider":"tmdb_show","id":"15130","scope":"s3","seasonNumber":3,"episodeNumbers":[14]},{"provider":"tvdb_show","id":"72858","scope":"s3","seasonNumber":3,"episodeNumbers":[14]}],"link":"83787","synopsis":"The gang meets up with Horn who lost his pirate ship mysteriously one night! Also, they hear about the legend of a phantom ship in these parts of the ocean.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/72858/101361.jpg"},{"title":"Il ritorno di Naga","episodeNumber":15,"sourceEpisodeNumber":15,"seasonNumber":3,"externalMappings":[{"provider":"anidb","id":"4695","scope":"R","episodeNumbers":[15]},{"provider":"anilist","id":"13201","episodeNumbers":[15]},{"provider":"mal","id":"13201","episodeNumbers":[15]},{"provider":"tmdb_show","id":"15130","scope":"s3","seasonNumber":3,"episodeNumbers":[15]},{"provider":"tvdb_show","id":"72858","scope":"s3","seasonNumber":3,"episodeNumbers":[15]}],"link":"83788","synopsis":"When Mum Mew asks about his plans, General Durahan says that he has already found a very strong monster who can deal with the gang.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/72858/101362.jpg"},{"title":"Il leggendario Most","episodeNumber":16,"sourceEpisodeNumber":16,"seasonNumber":3,"externalMappings":[{"provider":"anidb","id":"4695","scope":"R","episodeNumbers":[16]},{"provider":"anilist","id":"13201","episodeNumbers":[16]},{"provider":"mal","id":"13201","episodeNumbers":[16]},{"provider":"tmdb_show","id":"15130","scope":"s3","seasonNumber":3,"episodeNumbers":[16]},{"provider":"tvdb_show","id":"72858","scope":"s3","seasonNumber":3,"episodeNumbers":[16]}],"link":"83789","synopsis":"Mum Mew and Gobi decides to personally deal with the gang and spare the General's monster collection.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/72858/101363.jpg"},{"title":"Shogun il potente guerriero","episodeNumber":17,"sourceEpisodeNumber":17,"seasonNumber":3,"externalMappings":[{"provider":"anidb","id":"4695","scope":"R","episodeNumbers":[17]},{"provider":"anilist","id":"13201","episodeNumbers":[17]},{"provider":"mal","id":"13201","episodeNumbers":[17]},{"provider":"tmdb_show","id":"15130","scope":"s3","seasonNumber":3,"episodeNumbers":[17]},{"provider":"tvdb_show","id":"72858","scope":"s3","seasonNumber":3,"episodeNumbers":[17]}],"link":"83790","synopsis":"In General Durahan's collection, there is a fearsome warrior - Shogun who is stronger that General Durahan himself . By accident, Gobi releases this warrior but General Durahan convinced Shogun to defeat the gang who General Durahan says is the strongest around.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/72858/101364.jpg"},{"title":"Il ritorno di Gray Wolf","episodeNumber":18,"sourceEpisodeNumber":18,"seasonNumber":3,"externalMappings":[{"provider":"anidb","id":"4695","scope":"R","episodeNumbers":[18]},{"provider":"anilist","id":"13201","episodeNumbers":[18]},{"provider":"mal","id":"13201","episodeNumbers":[18]},{"provider":"tmdb_show","id":"15130","scope":"s3","seasonNumber":3,"episodeNumbers":[18]},{"provider":"tvdb_show","id":"72858","scope":"s3","seasonNumber":3,"episodeNumbers":[18]}],"link":"83791","synopsis":"Tiger meets up with Grey Wolf but refuses to acknowledge him as his brother after realizing that they are opponent in tomorrow's battle! What is Tiger doing?","thumbnail":"https://artworks.thetvdb.com/banners/episodes/72858/101365.jpg"},{"title":"Il segreto di Rosetta","episodeNumber":19,"sourceEpisodeNumber":19,"seasonNumber":3,"externalMappings":[{"provider":"anidb","id":"4695","scope":"R","episodeNumbers":[19]},{"provider":"anilist","id":"13201","episodeNumbers":[19]},{"provider":"mal","id":"13201","episodeNumbers":[19]},{"provider":"tmdb_show","id":"15130","scope":"s3","seasonNumber":3,"episodeNumbers":[19]},{"provider":"tvdb_show","id":"72858","scope":"s3","seasonNumber":3,"episodeNumbers":[19]}],"link":"83792","synopsis":"Golem and gang runs into an Old Lady who cooks the best Pizza. Just when she was about to defend her crown in the cooking competition, her secret sauce is stolen!","thumbnail":"https://artworks.thetvdb.com/banners/episodes/72858/101366.jpg"},{"title":"Incontro con Granity","episodeNumber":20,"sourceEpisodeNumber":20,"seasonNumber":3,"externalMappings":[{"provider":"anidb","id":"4695","scope":"R","episodeNumbers":[20]},{"provider":"anilist","id":"13201","episodeNumbers":[20]},{"provider":"mal","id":"13201","episodeNumbers":[20]},{"provider":"tmdb_show","id":"15130","scope":"s3","seasonNumber":3,"episodeNumbers":[20]},{"provider":"tvdb_show","id":"72858","scope":"s3","seasonNumber":3,"episodeNumbers":[20]}],"link":"83793","synopsis":"The gang meets up with Granity but then she becomes controlled by a machine type Baddie which enter her head.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/72858/101367.jpg"},{"title":"L'audace scommessa di Mum Mew","episodeNumber":21,"sourceEpisodeNumber":21,"seasonNumber":3,"externalMappings":[{"provider":"anidb","id":"4695","scope":"R","episodeNumbers":[21]},{"provider":"anilist","id":"13201","episodeNumbers":[21]},{"provider":"mal","id":"13201","episodeNumbers":[21]},{"provider":"tmdb_show","id":"15130","scope":"s3","seasonNumber":3,"episodeNumbers":[21]},{"provider":"tvdb_show","id":"72858","scope":"s3","seasonNumber":3,"episodeNumbers":[21]}],"link":"83794","synopsis":"Mum Mew, Gobi and Weed tries to capture the gang by issuing wanted posters. When an old hotel owner turns up with the boun