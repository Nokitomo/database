ider":"anidb","id":"18065","scope":"R","episodeNumbers":[5]},{"provider":"anilist","id":"166215","episodeNumbers":[5]},{"provider":"mal","id":"55689","episodeNumbers":[5]},{"provider":"tmdb_show","id":"260848","scope":"s1","seasonNumber":1,"episodeNumbers":[5]},{"provider":"tvdb_show","id":"436237","scope":"s1","seasonNumber":1,"episodeNumbers":[5]}],"link":"106179","synopsis":"ついに6人揃ったアカペラ部。夏休みの登校日に初ライブの予定が決まり、本格的に練習が始まる。そんな彼女たちの前には期末テストが迫っていた。夏休み中の補修を回避するために結束する1年生だが――","thumbnail":"https://image.tmdb.org/t/p/w300/yGZbzJKPuNkRwvhrjFnTqc59YIW.jpg"},{"title":"Episodio 6","episodeNumber":6,"sourceEpisodeNumber":6,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"18065","scope":"R","episodeNumbers":[6]},{"provider":"anilist","id":"166215","episodeNumbers":[6]},{"provider":"mal","id":"55689","episodeNumbers":[6]},{"provider":"tmdb_show","id":"260848","scope":"s1","seasonNumber":1,"episodeNumbers":[6]},{"provider":"tvdb_show","id":"436237","scope":"s1","seasonNumber":1,"episodeNumbers":[6]}],"link":"106341","synopsis":"アカペラ部は路上ライブに挑戦。人前で歌うことの不安に震えるウタだが、部員たちの言葉に自分を奮い立たせる。それぞれの思いを乗せて、夏休みの登校日、はじめてのステージへ――","thumbnail":"https://image.tmdb.org/t/p/w300/K9zH2hytSKAsGtE0kmb2eNTrgm.jpg"},{"title":"Episodio 7","episodeNumber":7,"sourceEpisodeNumber":7,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"18065","scope":"R","episodeNumbers":[7]},{"provider":"anilist","id":"166215","episodeNumbers":[7]},{"provider":"mal","id":"55689","episodeNumbers":[7]},{"provider":"tmdb_show","id":"260848","scope":"s1","seasonNumber":1,"episodeNumbers":[7]},{"provider":"tvdb_show","id":"436237","scope":"s1","seasonNumber":1,"episodeNumbers":[7]}],"link":"106780","synopsis":"登校日ライブの後、部活に来なくなってしまったムスブとウルル。一日にして形を変えてしまったアカペラ部。ようやくできた自分たちの居場所をこのまま終わらせないためにウタとクマは立ち上がる――","thumbnail":"https://image.tmdb.org/t/p/w300/8vL6h7bXL7zzoTsyVDNjARO8x8T.jpg"},{"title":"Episodio 8","episodeNumber":8,"sourceEpisodeNumber":8,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"18065","scope":"R","episodeNumbers":[8]},{"provider":"anilist","id":"166215","episodeNumbers":[8]},{"provider":"mal","id":"55689","episodeNumbers":[8]},{"provider":"tmdb_show","id":"260848","scope":"s1","seasonNumber":1,"episodeNumbers":[8]},{"provider":"tvdb_show","id":"436237","scope":"s1","seasonNumber":1,"episodeNumbers":[8]}],"link":"106781","synopsis":"ウタは、ムスブのことを理解するためにキッカを通じてParabolaに話を聞きにいく。アカペラで音楽シーンを変えるという野望を持つリーダーのミズキに、部活でアカペラをすることの意味を改めて問われ――","thumbnail":"https://image.tmdb.org/t/p/w300/wtTWBzK0SMMbU63HG3JGq9PKIqn.jpg"},{"title":"Episodio 9","episodeNumber":9,"sourceEpisodeNumber":9,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"18065","scope":"R","episodeNumbers":[9]},{"provider":"anilist","id":"166215","episodeNumbers":[9]},{"provider":"mal","id":"55689","episodeNumbers":[9]},{"provider":"tmdb_show","id":"260848","scope":"s1","seasonNumber":1,"episodeNumbers":[9]},{"provider":"tvdb_show","id":"436237","scope":"s1","seasonNumber":1,"episodeNumbers":[9]}],"link":"107009","synopsis":"文化祭のライブが決まる。苦い思い出となった登校日ライブ以来のステージに向けて、部員たちはそれぞれの思いを胸にアカペラに向き合うが、ムスブは1人で練習することを選ぶ――","thumbnail":"https://image.tmdb.org/t/p/w300/oyZSStUhCOdq1e2E4MhoufFK1l9.jpg"},{"title":"Episodio 10","episodeNumber":10,"sourceEpisodeNumber":10,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"18065","scope":"R","episodeNumbers":[10]},{"provider":"anilist","id":"166215","episodeNumbers":[10]},{"provider":"mal","id":"55689","episodeNumbers":[10]},{"provider":"tmdb_show","id":"260848","scope":"s1","seasonNumber":1,"episodeNumbers":[10]},{"provider":"tvdb_show","id":"436237","scope":"s1","seasonNumber":1,"episodeNumbers":[10]}],"link":"107356","synopsis":"レイレイのParabola加入に戸惑うアカペラ部。掛け持ちを許さないミズキによって、レイレイの部活動はいずれ終わりを迎えることに。そんな中、6人の最後のステージであるクリスマスライブが決まる。しかしアイリは未だ迷いの中にいて――","thumbnail":"https://image.tmdb.org/t/p/w300/q5GtjxT34OvB3hvhfWLLviCEVJH.jpg"}],"sourceIds":{"anilistId":166215,"malId":55689},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn"