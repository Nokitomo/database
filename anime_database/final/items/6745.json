l":"https://images.metahub.space/poster/small/tt33472011/img"},{"source":"anilist","url":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/large/bx181841-R6fB3bmU5eOE.jpg"}],"background":[{"source":"tmdb","url":"https://image.tmdb.org/t/p/original/yEswlmsEwLCdA0Q8V0DZdPHBBRL.jpg"},{"source":"cinemeta","url":"https://images.metahub.space/background/medium/tt33472011/img"},{"source":"anizip","url":"https://artworks.thetvdb.com/banners/v4/series/454726/backgrounds/68649d1bcb5af.jpg"},{"source":"provider","url":"https://img.animeunity.co/anime/181841-aegccbKnNjxK.jpg"},{"source":"anilist","url":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/181841-aegccbKnNjxK.jpg"}]}},"related":[{"title":"City The Animation","link":"/anime/6744-city-the-animation","image":"https://img.animeunity.co/anime/bx181841-9TcjIyZefot2.jpg","type":"TV","year":"2025","dubStatus":"both","dubStatusKey":"Subbed and dubbed","variants":[{"status":"subbed","statusKey":"Subbed","title":"City The Animation","link":"/anime/6744-city-the-animation","image":"https://img.animeunity.co/anime/bx181841-9TcjIyZefot2.jpg"},{"status":"dubbed","statusKey":"Dubbed","title":"City The Animation","link":"/anime/6745-city-the-animation-ita","image":"https://img.animeunity.co/anime/bx181841-9TcjIyZefot2.jpg"}]}],"linkList":[{"title":"Episodes 1-13","titleKey":"Episodes {{start}}-{{end}}","titleParams":{"start":1,"end":13},"availabilityStatus":"available","episodesLink":"6745|1|13"}]},"episodes":[{"title":"Episodio 1","episodeNumber":1,"sourceEpisodeNumber":1,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"18874","scope":"R","episodeNumbers":[1]},{"provider":"anilist","id":"181841","episodeNumbers":[1]},{"provider":"mal","id":"59898","episodeNumbers":[1]},{"provider":"tmdb_show","id":"272118","scope":"s1","seasonNumber":1,"episodeNumbers":[1]},{"provider":"tvdb_show","id":"454726","scope":"s1","seasonNumber":1,"episodeNumbers":[1]}],"link":"98690","synopsis":"CITY - dove ogni giorno succede qualcosa: Tsurubishi infila dei noodle fritti nella borsa di un cliente, sotto gli occhi di Nagumo! Una situazione disperata! Matsuri ed Eri si divertono dopo la scuola. Todoroki e Onikamaboko non trovano uno scherzo per \"Rakutan-kun.\" Dopo aver sentito il sogno di Niikura, Nagumo inizia a pensare a quello che vogliono fare... Qualcosa inizia a sbocciare in CITY.","thumbnail":"https://image.tmdb.org/t/p/w300/8sb1d3Ev0JTyGfnLuIIKKVdAjmR.jpg"},{"title":"Episodio 2","episodeNumber":2,"sourceEpisodeNumber":2,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"18874","scope":"R","episodeNumbers":[2]},{"provider":"anilist","id":"181841","episodeNumbers":[2]},{"provider":"mal","id":"59898","episodeNumbers":[2]},{"provider":"tmdb_show","id":"272118","scope":"s1","seasonNumber":1,"episodeNumbers":[2]},{"provider":"tvdb_show","id":"454726","scope":"s1","seasonNumber":1,"episodeNumbers":[2]}],"link":"99270","synopsis":"Nagumo, sempre al verde, si scontra con Niikura, che rivuole semplicemente I suoi soldi. L'arrivo di Wako accende la caotica vita del campus. Nel frattempo, la squadra di calcio di CITY Minami Eleven Soccer si affanna per proteggere il suo asso sempre infortunato, Sasago. Todoroki negozia il destino di Rakutan-kun, mettendo alla prova il legame tra editore e autore. E il sole tramonta su City.","thumbnail":"https://image.tmdb.org/t/p/w300/xx3MYlhRSTKN1In0csXp0eUSrpl.jpg"},{"title":"Episodio 3","episodeNumber":3,"sourceEpisodeNumber":3,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"18874","scope":"R","episodeNumbers":[3]},{"provider":"anilist","id":"181841","episodeNumbers":[3]},{"provider":"mal","id":"59898","episodeNumbers":[3]},{"provider":"tmdb_show","id":"272118","scope":"s1","seasonNumber":1,"episodeNumbers":[3]},{"provider":"tvdb_show","id":"454726","scope":"s1","seasonNumber":1,"episodeNumbers":[3]}],"link":"99570","synopsis":"Con uno spettacolo imminente, Tekaridake, leader del Teatro Tekaridake, riunisce la sua troupe demotivata. La sonnambula Riko Izumi ruba il cuore del 16enne Tatewaku Makabe. La primavera è dietro l'angolo. Matsuri ed Eri cercano di proteggere la pace mondiale con la gentilezza. Nagumo, Niikura e Wako trovano una mappa del tesoro... che la battaglia inizi! Un altro giorno pacifico a CITY.","thumbnail":"https://image.tmdb.org/t/p/w300/glb3lveyGvpWFTHebQ6VMDxA9qW.jpg"},{"title":"Episodio 4","episodeNumber":4,"sourceEpisodeNumber":4,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"18874","scope":"R","episodeNumbers":[4]},{"provider":"anilist","id":"181841","episodeNumbers":[4]},{"provider":"mal","id":"59898","episodeNumbers":[4]},{"provider":"tmdb_show","id":"272118","scope":"s1","seasonNumber":1,"episodeNumbers":[4]},{"provider":"tvdb_show","id":"454726","scope":"s1","seasonNumber":1,"episodeNumbers":[4]}],"link":"99709","synopsis":"Tanabe ama dare premi per qualsiasi attività, e ora inizia la ricerca di Nagumo! Tsurubishi visita l'izakaya 'Yamabushi', che vuole arrivare a poter dire l'iconico 'Capo! Il solito!' e inizia a frequentarlo. Niikura insegue una collana rimasta attaccata a una 'Mimineko. Matsuri si avventurano nella ricerca della Mimineko. Le vite di ogni persona si intersecano in City.","thumbnail":"https://image.tmdb.org/t/p/w300/zZnFf48GcK9vkKHXPDx9cWXEtwv.jpg"},{"title":"Episodio 5","episodeNumber":5,"sourceEpisodeNumber":5,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"18874","scope":"R","episodeNumbers":[5]},{"provider":"anilist","id":"181841","episodeNumbers":[5]},{"provider":"mal","id":"59898","episodeNumbers":[5]},{"provider":"tmdb_show","id":"272118","scope":"s1","seasonNumber":1,"episodeNumbers":[5]},{"provider":"tvdb_show","id":"454726","scope":"s1","seasonNumber":1,"episodeNumbers":[5]}],"link":"99850","synopsis":"Nagumo viene portato via da Tanabe. Sono destinato alle Tanabe Residence Hospitality Twin Towers. Con l'aiuto di una persona gentile incontrata lungo la strada, Nagumo e Wako cercano di scappare, ma i guardiani di ogni piano tagliano loro la strada... Intanto, Niikura continua a correre temerariamente inseguendo la Mimineko. I punti scollegato iniziano a connettersi in CITY.","thumbnail":"https://image.tmdb.org/t/p/w300/rxYihcAcGkyW4U2D8YEMSkOp0qR.jpg"},{"title":"Episodio 6","episodeNumber":6,"sourceEpisodeNumber":6,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"18874","scope":"R","episodeNumbers":[6]},{"provider":"anilist","id":"181841","episodeNumbers":[6]},{"provider":"mal","id":"59898","episodeNumbers":[6]},{"provider":"tmdb_show","id":"272118","scope":"s1","seasonNumber":1,"episodeNumbers":[6]},{"provider":"tvdb_show","id":"454726","scope":"s1","seasonNumber":1,"episodeNumbers":[6]}],"link":"100069","synopsis":"La mattina a casa Adatara è sempre frenetica. Umi, Sora, Kamome, Tatsuta e Rota partono insieme come sempre. Il manoscritto anonimo 'Kanki-kun' arriva all'ufficio editoriale della rivista City. Vedendo qualcosa di speciale in esso, Todoroki fa una proposta a Onikamaboko. In riva al fiume al tramonto, Eri cerca di comunicare qualcosa a Matsuri... Le stagioni di CITY continuano a cambiare.","thumbnail":"https://image.tmdb.org/t/p/w300/9VFSQ5u0jTdMxqg6k5482r8lPi7.jpg"},{"title":"Episodio 7","episodeNumber":7,"sourceEpisodeNumber":7,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"18874","scope":"R","episodeNumbers":[7]},{"provider":"anilist","id":"181841","episodeNumbers":[7]},{"provider":"mal","id":"59898","episodeNumbers":[7]},{"provider":"tmdb_show","id":"272118","scope":"s1","seasonNumber":1,"episodeNumbers":[7]},{"provider":"tvdb_show","id":"454726","scope":"s1","seasonNumber":1,"episodeNumbers":[7]}],"link":"100226","synopsis":"Sostituendo il proprietario del Bar Yamabushi, Tsurubishi decide di fare il riso fritto definitivo. Ne va del suo orgoglio, quindi cerca gli ingredienti perfetti. A tarda notte, Niikura è affamata e mangia qualunque cosa trovi. Intanto, Kuratake, il barbiere noto come \"uomo più cattivo in città\", ha venduto i regali dei suoi clienti fissi... per uno scopo. In CITY, non c'è luce senza oscurità.","thumbnail":"https://image.tmdb.org/t/p/w300/9urgsLI7w0NgmxY6PfFbQiahGWS.jpg"},{"title":"Episodio 8","episodeNumber":8,"sourceEpisodeNumber":8,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"18874","scope":"R","episodeNumbers":[8]},{"provider":"anilist","id":"181841","episodeNumbers":[8]},{"provider":"mal","id":"59898","episodeNumbers":[8]},{"provider":"tmdb_show","id":"272118","scope":"s1","seasonNumber":1,"episodeNumbers":[8]},{"provider":"tvdb_show","id":"454726","scope":"s1","seasonNumber":1,"episodeNumbers":[8]}],"link":"100506","synopsis":"Una ragazza innamorata non riesce a smettere di piangere. Dopo 18 anni in attesa di un invito, Tanabe scopre finalmente il cibo preferito della sua bella? Tekaridake scrittura Nagumo come protagonista di \"Gola\". Nonostante innumerevoli fallimenti, riesce ad alzare il sipario! Un agente di polizia diventa un fan di Riko Izumi. Anche Tatewaku le chiede di uscire. Qualcosa sta sbocciando in CITY.","thumbnail":"https://image.tmdb.org/t/p/w300/nRoCMog9qpg5aGXfhhv47dkrXfD.jpg"},{"title":"Episodio 9","episodeNumber":9,"sourceEpisodeNumber":9,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"18874","scope":"R","episodeNumbers":[9]},{"provider":"anilist","id":"181841","episodeNumbers":[9]},{"provider":"mal","id":"59898","episodeNumbers":[9]},{"provider":"tmdb_show","id":"272118","scope":"s1","seasonNumber":1,"episodeNumbers":[9]},{"provider":"tvdb_show","id":"454726","scope":"s1","seasonNumber":1,"episodeNumbers":[9]}],"link":"100680","synopsis":"A CITY c'è una corsa con un premio di un milione di yen. Nagumo affronta Obaba. Niikura vuole rubare il ciondolo ai CITY Minami Eleven. Tekaridake corre con una coppia al traino. Matsuri ed Eri sono sincronizzati. I Tre Corvi tengono in mano del buon saké. Con sorprese a ogni turno, l'imprevedibile corsa tiene tutti in tensione... A chi sorriderà la dea? Mentre tutti corrono, CITY inizia a girare!","thumbnail":"https://image.tmdb.org/t/p/w300/x4anNRWMxUEgNW9lRtHgPtWhIzW.jpg"},{"title":"Episodio 10","episodeNumber":10,"sourceEpisodeNumber":10,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"18874","scope":"R","episodeNumbers":[10]},{"provider":"anilist","id":"181841","episodeNumbers":[10]},{"provider":"mal","id":"59898","episodeNumbers":[10]},{"provider":"tmdb_show","id":"272118","scope":"s1","seasonNumber":1,"episodeNumbers":[10]},{"provider":"tvdb_show","id":"454726","scope":"s1","seasonNumber":1,"episodeNumbers":[10]}],"link":"101022","synopsis":"Nagumo e Niikura hanno un piano per diventare ricchi tramite i video in streaming. Tutta via, la reazione di Nagumo al sincero copione di Niikura è... Intanto, il fan club di Riko Izumi ostacola Tatewaku. Il capitano dei CITY Minami Eleven, Obina, guida la carica per fermare la furia di Tatewaku! Intanto, i Tre Corvi partono per una breve vacanza. L'estate di CITY è frenetica!","thumbnail":"https://image.tmdb.org/t/p/w300/z9Ipdn6niG6qYbEGeBHeeYiR7zh.jpg"},{"title":"Episodio 11","episodeNumber":11,"sourceEpisodeNumber":11,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"18874","scope":"R","episodeNumbers":[11]},{"provider":"anilist","id":"181841","episodeNumbers":[11]},{"provider":"mal","id":"59898","episodeNumbers":[11]},{"provider":"tmdb_show","id":"272118","scope":"s1","seasonNumber":1,"episodeNumbers":[11]},{"provider":"tvdb_show","id":"454726","scope":"s1","seasonNumber":1,"episodeNumbers":[11]}],"link":"101232","synopsis":"Mentre Niikura registra un video, arriva Nagumo... Toki, Tsuchinoko e Mimineko... Ci sono tutte le creature di CITY. Nella \"Coppa Shogi a sorpresa\" si sfidano Arashima, 8° Dan e Hidari, 4° Dan. Chi crollerà per primo? Todo, proprietario di Todo Antichità, vede lo spirito degli oggetti antichi. Guardando ciò che resta degli abitanti di CITY tra gli oggetti di Kuratake... l'estate di CITY continua.","thumbnail":"https://image.tmdb.org/t/p/w300/rGy1DBgq6yuYBK6SxNkSyGFzt1Q.jpg"},{"title":"Episodio 12","episodeNumber":12,"sourceEpisodeNumber":12,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"18874","scope":"R","episodeNumbers":[12]},{"provider":"anilist","id":"181841","episodeNumbers":[12]},{"provider":"mal","id":"59898","episodeNumbers":[12]},{"provider":"tmdb_show","id":"272118","scope":"s1","seasonNumber":1,"episodeNumbers":[12]},{"provider":"tvdb_show","id":"454726","scope":"s1","seasonNumber":1,"episodeNumbers":[12]}],"link":"101405","synopsis":"Nagumo, Niikura e Wako si iscrivono a un concorso fotografico, con i loro migliori scatti, e attendono il risultato! Eri visita dei luoghi pieni di ricordi di Matsuri. I Tre Corvi bevono a volontà al ristorante occidentale Makabe durante le vacanze di primavera. L'infinito ritornello di \"delizioso\" continua. L'estate di CITY è tutt'altro che finita.","thumbnail":"https://image.tmdb.org/t/p/w300/3Lznvmgy8v9oPx8kCoiVQ3W95mA.jpg"},{"title":"Episodio 13","episodeNumber":13,"sourceEpisodeNumber":13,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"18874","scope":"R","episodeNumbers":[13]},{"provider":"anilist","id":"181841","episodeNumbers":[13]},{"provider":"mal","id":"59898","episodeNumbers":[13]},{"provider":"tmdb_show","id":"272118","scope":"s1","seasonNumber":1,"episodeNumbers":[13]},{"provider":"tvdb_show","id":"454726","scope":"s1","seasonNumber":1,"episodeNumbers":[13]}],"link":"101539","synopsis":"Eri lascia Matsuri senza dire una parola. Per dirle addio come si deve, Matsuri si fionda da Eri! Tsurubishi e il ristorante occidentale Makabe... una svolta inattesa? Tra risate, lacrime, e tutto quello che accade nel frattempo, l'ultimo episodio è pieno di sorprese! Mentre l'estate a CITY finisce, ne inizia un'altra.","thumbnail":"https://image.tmdb.org/t/p/w300/qkwBc3Fx4DvRUlKYcq8vTZAbdY0.jpg"}],"sourceIds":{"anilistId":181841,"malId":59898},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn"