nity.co/anime/6196-magilumiere-magical-girls-inc-ita","image":"https://img.animeunity.co/anime/bx171025-alBpVzKrgy1b.jpg"}]},{"title":"Magilumiere Magical Girls Inc. 2","link":"https://www.animeunity.co/anime/7667-magilumiere-magical-girls-inc-2","image":"https://img.animeunity.co/anime/bx185692-1a8huwOIx7gw.jpg","type":"TV","year":"2026","dubStatus":"both","dubStatusKey":"Subbed and dubbed","variants":[{"status":"subbed","statusKey":"Subbed","title":"Magilumiere Magical Girls Inc. 2","link":"https://www.animeunity.co/anime/7667-magilumiere-magical-girls-inc-2","image":"https://img.animeunity.co/anime/bx185692-1a8huwOIx7gw.jpg"},{"status":"dubbed","statusKey":"Dubbed","title":"Magilumiere Magical Girls Inc. 2","link":"https://www.animeunity.co/anime/7668-magilumiere-magical-girls-inc-2-ita","image":"https://img.animeunity.co/anime/bx185692-1a8huwOIx7gw.jpg"}]}],"linkList":[{"title":"Episodes 1-12","titleKey":"Episodes {{start}}-{{end}}","titleParams":{"start":1,"end":12},"availabilityStatus":"available","episodesLink":"6196|1|12"}]},"episodes":[{"title":"Welcome to Magilumiere","episodeNumber":1,"sourceEpisodeNumber":1,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"18292","scope":"R","episodeNumbers":[1]},{"provider":"anilist","id":"171025","episodeNumbers":[1]},{"provider":"mal","id":"57360","episodeNumbers":[1]},{"provider":"tmdb_show","id":"240576","scope":"s1","seasonNumber":1,"episodeNumbers":[1]},{"provider":"tvdb_show","id":"442767","scope":"s1","seasonNumber":1,"episodeNumbers":[1]}],"link":"91453","synopsis":"In this world, the job of a Magical Girl - to exterminate dangerous creatures known as “Kaii” – is a dream come true. College student Kana Sakuragi is losing confidence as she struggles to find a job. One day, she gets caught up in a Kaii attack. Magical Girl Hitomi Koshigaya flies to the rescue but faces a bigger foe than she bargained for. When she appeals for help, Kana steps forward...","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/10166491/screencap/66fd429d5775e.jpg"},{"title":"Brooms Are a Piece of Cake","episodeNumber":2,"sourceEpisodeNumber":2,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"18292","scope":"R","episodeNumbers":[2]},{"provider":"anilist","id":"171025","episodeNumbers":[2]},{"provider":"mal","id":"57360","episodeNumbers":[2]},{"provider":"tmdb_show","id":"240576","scope":"s1","seasonNumber":1,"episodeNumbers":[2]},{"provider":"tvdb_show","id":"442767","scope":"s1","seasonNumber":1,"episodeNumbers":[2]}],"link":"91454","synopsis":"Having helped Koshigaya, Kana decides to join Magilumiere Magical Girls Inc. President Kouji Shigemoto, engineer Kazuo Nikoyama, and Kaede Midorikawa in sales are unique to say the least, and Kana is taken aback. Maybe joining the company so impulsively was a mistake! Midorikawa encourages her to give BROOM riding a try. And then a request to exterminate a Kaii comes through...","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/10716753/screencap/6704feeb7a1a3.jpg"},{"title":"Our Aesthetic","episodeNumber":3,"sourceEpisodeNumber":3,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"18292","scope":"R","episodeNumbers":[3]},{"provider":"anilist","id":"171025","episodeNumbers":[3]},{"provider":"mal","id":"57360","episodeNumbers":[3]},{"provider":"tmdb_show","id":"240576","scope":"s1","seasonNumber":1,"episodeNumbers":[3]},{"provider":"tvdb_show","id":"442767","scope":"s1","seasonNumber":1,"episodeNumbers":[3]}],"link":"91455","synopsis":"A month after Kana joins Magilumiere Magical Girls Inc., she and Hitomi Koshigaya are busy exterminating Kaii when Magical Girl Mei Tsuchiba joins the fight, exterminating their prey in a flash. Later, an extermination request has everyone discussing solutions, and Kana is bewildered when Shigemoto criticizes her idea for not matching the company aesthetic. And the Kaii become even more active...","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/10716754/screencap/670e3bfdea6df.jpg"},{"title":"Whipped Up a Good One!","episodeNumber":4,"sourceEpisodeNumber":4,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"18292","scope":"R","episodeNumbers":[4]},{"provider":"anilist","id":"171025","episodeNumbers":[4]},{"provider":"mal","id":"57360","episodeNumbers":[4]},{"provider":"tmdb_show","id":"240576","scope":"s1","seasonNumber":1,"episodeNumbers":[4]},{"provider":"tvdb_show","id":"442767","scope":"s1","seasonNumber":1,"episodeNumbers":[4]}],"link":"91456","synopsis":"To protect the historic shopping district, Kana proposes using a new type of magic. But it's just a theory. Shigemoto gives the go sign, and Magic Engineer Nikoyama springs into action, racing to turn it into reality. At the scene, Kana and Koshigaya split up to deal with their foe. With each of them feeling the pinch, the original Magilumiere magic is finally completed!","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/10716755/screencap/67176d38c5e73.jpg"},{"title":"Joint Project","episodeNumber":5,"sourceEpisodeNumber":5,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"18292","scope":"R","episodeNumbers":[5]},{"provider":"anilist","id":"171025","episodeNumbers":[5]},{"provider":"mal","id":"57360","episodeNumbers":[5]},{"provider":"tmdb_show","id":"240576","scope":"s1","seasonNumber":1,"episodeNumbers":[5]},{"provider":"tvdb_show","id":"442767","scope":"s1","seasonNumber":1,"episodeNumbers":[5]}],"link":"91457","synopsis":"Shigemoto gives the order, and it’s off to karaoke for the gang at Magilumiere. Everyone except Midorikawa sings, and their personalities take center stage! The party is a huge success. The next day, there’s a call from Shigemoto’s old friend Miyako Asou, the president of Miyakodo, a major cosmetics manufacturer. Kana ends up assigned to help out in Miyakodo's Magical Girl Department for a week.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/10716756/screencap/6720bf8b7b42f.jpg"},{"title":"Miyakodo`s Magical Girl","episodeNumber":6,"sourceEpisodeNumber":6,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"18292","scope":"R","episodeNumbers":[6]},{"provider":"anilist","id":"171025","episodeNumbers":[6]},{"provider":"mal","id":"57360","episodeNumbers":[6]},{"provider":"tmdb_show","id":"240576","scope":"s1","seasonNumber":1,"episodeNumbers":[6]},{"provider":"tvdb_show","id":"442767","scope":"s1","seasonNumber":1,"episodeNumbers":[6]}],"link":"91458","synopsis":"On her first day at Miyakodo, Kana is paired with Magical Girl Lily Aoi. They’re supposed to be working together... but Lily takes Kana shopping instead! It’s fun, but Lily’s free spirit overwhelms Kana. Lily’s admiration for the profession they share has Kana realizing that Magical Girls come in all shapes and sizes. Then the two of them head to Hotel Alberic for a routine Kaii inspection...","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/10716757/screencap/6729ec58c822c.jpg"},{"title":"Results vs. Aesthetic","episodeNumber":7,"sourceEpisodeNumber":7,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"18292","scope":"R","episodeNumbers":[7]},{"provider":"anilist","id":"171025","episodeNumbers":[7]},{"provider":"mal","id":"57360","episodeNumbers":[7]},{"provider":"tmdb_show","id":"240576","scope":"s1","seasonNumber":1,"episodeNumbers":[7]},{"provider":"tvdb_show","id":"442767","scope":"s1","seasonNumber":1,"episodeNumbers":[7]}],"link":"91459","synopsis":"Kana and Lily find themselves in a tough spot as they are attacked by a mutated Kaii. Reinforcements arrive in the form of Mei from AST Corporation. On her orders, Kana and Lily leave to evacuate passersby, and Mei begins fighting the Kaii alone. A fierce battle ensues. Worried about her, Kana returns to the scene. Finding Mei injured, Kana offers to fight alongside her...","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/10716758/screencap/6733265ddc5df.jpg"},{"title":"Magical Technology Expo","episodeNumber":8,"sourceEpisodeNumber":8,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"18292","scope":"R","episodeNumbers":[8]},{"provider":"anilist","id":"171025","episodeNumbers":[8]},{"provider":"mal","id":"57360","episodeNumbers":[8]},{"provider":"tmdb_show","id":"240576","scope":"s1","seasonNumber":1,"episodeNumbers":[8]},{"provider":"tvdb_show","id":"442767","scope":"s1","seasonNumber":1,"episodeNumbers":[8]}],"link":"91460","synopsis":"Welcome to the annual Magical Technology EXPO, a showcase for new magical tools and technologies. At the expo, the reticent Nikoyama is tongue-tied when the Magilumiere gang is approached by some famous magic engineers. It seems the magic activated in the shopping district incident is the talk of the town! While watching a magic demo on dealing with mutated Kaii, one appears at the venue!","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/10716759/screencap/673c813bdf151.jpg"},{"title":"Colleagues","episodeNumber":9,"sourceEpisodeNumber":9,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"18292","scope":"R","episodeNumbers":[9]},{"provider":"anilist","id":"171025","episodeNumbers":[9]},{"provider":"mal","id":"57360","episodeNumbers":[9]},{"provider":"tmdb_show","id":"240576","scope":"s1","seasonNumber":1,"episodeNumbers":[9]},{"provider":"tvdb_show","id":"442767","scope":"s1","seasonNumber":1,"episodeNumbers":[9]}],"link":"91461","synopsis":"Three years ago, Nikoyama was a university student whose hobby was making magic. His obsession was off the charts, but his fear of criticism had him almost giving up on working in the magic industry. Then came a phone call! Now, at the Magical Technology EXPO, Nikoyama is developing magic to deal with the mutant Kaii, but his PC starts to slow down. So he asks the engineers around him for help...","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/10716760/screencap/67459b0abfc0d.jpg"},{"title":"Ginji","episodeNumber":10,"sourceEpisodeNumber":10,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"18292","scope":"R","episodeNumbers":[10]},{"provider":"anilist","id":"171025","episodeNumbers":[10]},{"provider":"mal","id":"57360","episodeNumbers":[10]},{"provider":"tmdb_show","id":"240576","scope":"s1","seasonNumber":1,"episodeNumbers":[10]},{"provider":"tvdb_show","id":"442767","scope":"s1","seasonNumber":1,"episodeNumbers":[10]}],"link":"91462","synopsis":"Kana and Koshigaya visit Hana Ginji, the creator of the BROOMs used by Magilumiere. They ask Hana to adjust the BROOM specs, but she says she’ll create a new one instead! Meanwhile, Magilumiere is in the news after a video of their work at the EXPO is posted online. Shigemoto reveals his plans to use this to expand his business and sell Magilumiere's technology and know-how to other companies.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/10716761/screencap/674ef376517e6.jpg"},{"title":"The Dazzling Akane","episodeNumber":11,"sourceEpisodeNumber":11,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"18292","scope":"R","episodeNumbers":[11]},{"provider":"anilist","id":"171025","episodeNumbers":[11]},{"provider":"mal","id":"57360","episodeNumbers":[11]},{"provider":"tmdb_show","id":"240576","scope":"s1","seasonNumber":1,"episodeNumbers":[11]},{"provider":"tvdb_show","id":"442767","scope":"s1","seasonNumber":1,"episodeNumbers":[11]}],"link":"91463","synopsis":"Kana is assigned to train Akane Makino, a Magical Girl seconded to Magilumiere from Apda. On her first day, Akane is really pushy, and Kana is taken aback. But then she realizes how serious Akane is about her work, and the gap between them gradually closes. When Kana, Koshigaya, and Akane are dispatched on a job together, Kana’s role isn’t to partner Koshigaya, but to support her trainee...","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/10716762/screencap/6758198b44572.jpg"},{"title":"Solo vs. Teamwork","episodeNumber":12,"sourceEpisodeNumber":12,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"18292","scope":"R","episodeNumbers":[12]},{"provider":"anilist","id":"171025","episodeNumbers":[12]},{"provider":"mal","id":"57360","episodeNumbers":[12]},{"provider":"tmdb_show","id":"240576","scope":"s1","seasonNumber":1,"episodeNumbers":[12]},{"provider":"tvdb_show","id":"442767","scope":"s1","seasonNumber":1,"episodeNumbers":[12]}],"link":"91464","synopsis":"A gigantic mutant Kaii in the abandoned apartment complex Kana and Akane are at surrounds them in flames. Shigemoto and the others race to find a solution to the problem, but they lack data on the enemy... Kana and Akane try to meet up with Koshigaya, but the flames close in on them. Then Kana remembers something Shigemoto once said to her, and she rallies everyone to take on the Kaii again!","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/10716763/screencap/67652f60378d2.jpg"}],"sourceIds":{"anilistId":171025,"malId":57360},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-28T07:48:11Z","sourceDescriptors":["anilist:171025","mal:57360"],"targets":[{"provider":"anidb","id":"18292","scope":"R","ranges":{"1-12":"1-12"}},{"provider":"anilist","id":"171025","ranges":{"1-12":"1-12"}},{"provider":"mal","id":"57360","ranges":{"1-12":"1-12"}},{"provider":"tmdb_show","id":"240576","scope":"s1","ranges":{"1-12":"1-12"}},{"provider":"tvdb_show","id":"442767","scope":"s1","ranges":{"1-12":"1-12"}}]},"sourceMetadata":{"info":{"id":6196,"title":"Kabushikigaisha Magi-Lumière (ITA)","title_eng":"Magilumiere Magical Girls Inc. (ITA)","slug":"magilumiere-magical-girls-inc-ita","plot":"Kana Sakuragi è una neolaureata alla ricerca di un lavoro e, non riuscendo a trovarne uno, inizia a perdere fiducia in se stessa arrivando al punto di pensare \"la società non ha bisogno di me\". Un giorno, mentre si dirige verso il luogo del prossimo colloquio, si ritrova coinvolta in uno dei disastri naturali chiamati \"kaii\" e ver