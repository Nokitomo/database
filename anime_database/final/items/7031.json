l":"https://image.tmdb.org/t/p/original/oGvGNJzJ36d6RIknuJa2c1NutFC.jpg"},{"source":"tvdb","url":"https://artworks.thetvdb.com/banners/v4/series/392226/posters/6a5e19983ff75.jpg"},{"source":"provider","url":"https://img.animeunity.co/anime/bx117012-l2rktMbQbn0Z.png"},{"source":"anizip","url":"https://artworks.thetvdb.com/banners/series/392226/posters/5fb7c48305841.jpg"},{"source":"anilist","url":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/large/bx117012-l2rktMbQbn0Z.png"}],"background":[{"source":"tmdb","url":"https://image.tmdb.org/t/p/original/55IjfY12ExzDOK01QJk4nOzfFpu.jpg"},{"source":"anizip","url":"https://artworks.thetvdb.com/banners/series/392226/backgrounds/5fdad2a5ad692.jpg"},{"source":"provider","url":"https://img.animeunity.co/anime/117012-SVUMvVnJiOWt.jpg"},{"source":"anilist","url":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/117012-SVUMvVnJiOWt.jpg"}]}},"related":[{"title":"Swallowed Star","link":"/anime/7031-swallowed-star","image":"https://img.animeunity.co/anime/bx117012-l2rktMbQbn0Z.png","type":"ONA","year":"2020","dubStatus":"subbed","dubStatusKey":"Subbed","variants":[{"status":"subbed","statusKey":"Subbed","title":"Swallowed Star","link":"/anime/7031-swallowed-star","image":"https://img.animeunity.co/anime/bx117012-l2rktMbQbn0Z.png"}]},{"title":"Swallowed Star 2","link":"/anime/7032-swallowed-star-2","image":"https://img.animeunity.co/anime/bx134283-VKSWjndQWceF.png","type":"ONA","year":"2021","dubStatus":"subbed","dubStatusKey":"Subbed","variants":[{"status":"subbed","statusKey":"Subbed","title":"Swallowed Star 2","link":"/anime/7032-swallowed-star-2","image":"https://img.animeunity.co/anime/bx134283-VKSWjndQWceF.png"}]}],"linkList":[{"title":"Episodes 1-26","titleKey":"Episodes {{start}}-{{end}}","titleParams":{"start":1,"end":26},"availabilityStatus":"available","episodesLink":"7031|1|26"}]},"episodes":[{"title":"Episodio 1","episodeNumber":1,"sourceEpisodeNumber":1,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"15867","scope":"R","episodeNumbers":[1]},{"provider":"anilist","id":"117012","episodeNumbers":[1]},{"provider":"mal","id":"44218","episodeNumbers":[1]},{"provider":"tmdb_show","id":"101172","scope":"s1","seasonNumber":1,"episodeNumbers":[1]},{"provider":"tvdb_show","id":"392226","scope":"s1","seasonNumber":1,"episodeNumbers":[1]}],"link":"101097","synopsis":"The RR virus has brought monsters, and mankind has entered the era of Nirvana. In the case of the fall of many countries, only five major countries survived, formed the Earth Alliance and established bases. The main reason for the survival of human beings is that warriors were born among human beings under the influence of RR virus antibodies. Back to 5 years ago, Luo Feng, who was born in a low-rent area, decided to take the college entrance examination in order to realize his dream of becoming a martial artist. That day, Luo Feng met Xu Xin on the street and was about to talk to him. At this time, a flying alien appeared in the sky...","thumbnail":"https://image.tmdb.org/t/p/w300/i7uxko4EQ8iXy6qfKX3CNftf4KN.jpg"},{"title":"Episodio 2","episodeNumber":2,"sourceEpisodeNumber":2,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"15867","scope":"R","episodeNumbers":[2]},{"provider":"anilist","id":"117012","episodeNumbers":[2]},{"provider":"mal","id":"44218","episodeNumbers":[2]},{"provider":"tmdb_show","id":"101172","scope":"s1","seasonNumber":1,"episodeNumbers":[2]},{"provider":"tvdb_show","id":"392226","scope":"s1","seasonNumber":1,"episodeNumbers":[2]}],"link":"101098","synopsis":"After Luo Feng left the school gate, he was besieged by Zhang Haobai, a senior martial arts student, and three others. Luo Feng was in excellent physical condition and fell three people down in a few strokes. The next day was the college entrance examination. Luo Feng left early, and was actually blocked by a group of punks. It turned out that Zhang Haobai had come to hold Luo Feng to prevent him from taking the college entrance examination. Although he was overwhelmed, Luo Feng was still late. Thanks to Mr. Jiang’s help, Luo Feng was allowed to take the exam...","thumbnail":"https://image.tmdb.org/t/p/w300/453fFUeOH1jDwk5umGaZgaGtJrV.jpg"},{"title":"Episodio 3","episodeNumber":3,"sourceEpisodeNumber":3,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"15867","scope":"R","episodeNumbers":[3]},{"provider":"anilist","id":"117012","episodeNumbers":[3]},{"provider":"mal","id":"44218","episodeNumbers":[3]},{"provider":"tmdb_show","id":"101172","scope":"s1","seasonNumber":1,"episodeNumbers":[3]},{"provider":"tvdb_show","id":"392226","scope":"s1","seasonNumber":1,"episodeNumbers":[3]}],"link":"101099","synopsis":"The simulation location of the Quasi-Martial Artists assessment is set in the old world, which mainly assesses the strength, speed, survivability and the number of monsters killed. Luo Feng passed the assessment with the first overall quality ranking, and also won the quasi-martialist award-the gene source energy training method, and the actual combat assessment is scheduled for the first of next month...","thumbnail":"https://image.tmdb.org/t/p/w300/2aMtXZygnkceAEx7TKlxjERujeO.jpg"},{"title":"Episodio 4","episodeNumber":4,"sourceEpisodeNumber":4,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"15867","scope":"R","episodeNumbers":[4]},{"provider":"anilist","id":"117012","episodeNumbers":[4]},{"provider":"mal","id":"44218","episodeNumbers":[4]},{"provider":"tmdb_show","id":"101172","scope":"s1","seasonNumber":1,"episodeNumbers":[4]},{"provider":"tvdb_show","id":"392226","scope":"s1","seasonNumber":1,"episodeNumbers":[4]}],"link":"101100","synopsis":"罗峰的爸爸迟迟没有接他的电话，他不放心，按照爸爸今天说过的地址找了过去，正看到张昊白家的保镖在欺负爸爸和那些工人。罗峰十分生气，出手打倒了那些欺负他爸爸的人，然而张昊白早就算好了这一步，他报警说张昊白私闯民宅，罗峰被警察带走了。警察厅的人得知罗峰参加了准武者考核的时候十分吃惊，罗峰被关进的那间屋子里也有一天个十分不怀好意的人，他也曾经通过过准武者考核，罗峰不想和他正面交手，一直在躲避着。原来这又是张昊白搞得鬼，甚至找到了曾经的武者眼镜蛇，他制造了史上最严重的实战伤亡记录。","thumbnail":"https://image.tmdb.org/t/p/w300/zV6SDZbxKczNv0y40H8kOVCgyXR.jpg"},{"title":"Episodio 5","episodeNumber":5,"sourceEpisodeNumber":5,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"15867","scope":"R","episodeNumbers":[5]},{"provider":"anilist","id":"117012","episodeNumbers":[5]},{"provider":"mal","id":"44218","episodeNumbers":[5]},{"provider":"tmdb_show","id":"101172","scope":"s1","seasonNumber":1,"episodeNumbers":[5]},{"provider":"tvdb_show","id":"392226","scope":"s1","seasonNumber":1,"episodeNumbers":[5]}],"link":"101101","synopsis":"罗峰正在修炼五星向天的功法，忽然感到了仿佛被毒蛇盯上的毛骨悚然的感觉，罗峰回过神来，查看四周，但是他暂时没有发现异常，但是他总感觉有一股恶意在逼近他。正在吃饭的罗峰被几个人盯上了，他们打翻了罗峰的饭盆，摆明了要挑事，而眼镜蛇此时正坐在食堂的另一头，等待着最后出场解决罗峰。罗峰一个人应付他们也绰绰有余，罗峰将那几人都打趴下之后警报响了起来，眼镜蛇还十分惋惜的说只能速战速决，说着就攻击起了罗峰。罗峰和眼镜蛇的对战十分焦灼，罗峰的强大的精神力让原本会刺中他眼睛的飞到改变了方向，而这也让他因为精神力过度使用而头疼不已，眼镜蛇也没想到他的飞刀居然会失误。","thumbnail":"https://image.tmdb.org/t/p/w300/xB8nqa7Y01HLo4psvVT3e3VFdrw.jpg"},{"title":"Episodio 6","episodeNumber":6,"sourceEpisodeNumber":6,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"15867","scope":"R","episodeNumbers":[6]},{"provider":"anilist","id":"117012","episodeNumbers":[6]},{"provider":"mal","id":"44218","episodeNumbers":[6]},{"provider":"tmdb_show","id":"101172","scope":"s1","seasonNumber":1,"episodeNumbers":[6]},{"provider":"tvdb_show","id":"392226","scope":"s1","seasonNumber":1,"episodeNumbers":[6]}],"link":"101102","synopsis":"罗峰在和教官进行训练，教官教授了罗峰入微级身法，只要一点点轻微的移动就可以神不知鬼不觉的躲开敌人的攻击，其原理是通过观察对方的动作轨迹做出预判，以最小幅度的动作来躲避攻击的身法，这时建立在大量战斗经验基础上的技术，就连身法分段位就连武者也是分段位的，战士级、战将级、以及极为稀少的战神级，每一级之间都存在着实力的绝对压制。五大国之一的华夏只有两三名超越战神的武者，就在这时诸葛教官到了，江年带着罗峰去见了诸葛教官。","thumbnail":"https://image.tmdb.org/t/p/w300/yuZq1uMGKn2kLrgrNTWQSTLrrU9.jpg"},{"title":"Episodio 7","episodeNumber":7,"sourceEpisodeNumber":7,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"15867","scope":"R","episodeNumbers":[7]},{"provider":"anilist","id":"117012","episodeNumbers":[7]},{"provider":"mal","id":"44218","episodeNumbers":[7]},{"provider":"tmdb_show","id":"101172","scope":"s1","seasonNumber":1,"episodeNumbers":[7]},{"provider":"tvdb_show","id":"392226","scope":"s1","seasonNumber":1,"episodeNumbers":[7]}],"link":"101103","synopsis":"诸葛发现考场里突然出现了一只Ｄ级的金兀鹫，但他判断金兀鹫刚刚孵化不久，实力完全符合考场的设定登记，准武者们只要战术得当，即使不能战胜金兀鹫，也应当可以逃脱它的追捕。而罗峰恰好是距离金兀鹫最近的准武者，罗峰果然对着金兀鹫发动了攻击，诸葛教官等人在监控上看着罗峰的全部作战过程，罗峰完美的战术成功击杀了那只金兀鹫。罗峰等人顺利完成了考核，成为了真正的武者。","thumbnail":"https://image.tmdb.org/t/p/w300/cIQxsPl7UHa4FsDaWNAr0O6eRUT.jpg"},{"title":"Episodio 8","episodeNumber":8,"sourceEpisodeNumber":8,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"15867","scope":"R","episodeNumbers":[8]},{"provider":"anilist","id":"117012","episodeNumbers":[8]},{"provider":"mal","id":"44218","episodeNumbers":[8]},{"provider":"tmdb_show","id":"101172","scope":"s1","seasonNumber":1,"episodeNumbers":[8]},{"provider":"tvdb_show","id":"392226","scope":"s1","seasonNumber":1,"episodeNumbers":[8]}],"link":"101104","synopsis":"罗峰完成武者考核顺利加入了火锤小队，然而在罗峰进入火锤小队的第一天就有突发任务需要罗峰出马。他们到达了集合地，了解到ＨＲ联盟名下的生物研究所组成了一支志愿小队前往０２０１县城采集怪兽基因样本，报警的人希望火锤小队能够将困在里面的人尽快解救出来。罗峰发现徐欣的名字也在搜救人员的名单里，罗峰决定一定要尽快救出被困住的人。罗峰遇见犀牛怪，使出了九重雷刀，就在这时火锤小队赶来帮他解决了。\\n\\n各个小队分开集合，罗峰发下来他送给徐欣的匕首落在了地上，然而没想到的是，在这片废墟中还有另一伙人藏在这里，他们决定暗中除掉罗峰，却被火锤小队的队员们发现了他们的踪迹。最终在千钧一发之际，罗峰赶到了徐欣的身边，在怪兽袭击她的前一秒打败了怪兽。本次营救任务顺利完成。","thumbnail":"https://image.tmdb.org/t/p/w300/IArFu1x7YuFK1CPB7cCnQjiZwP.jpg"},{"title":"Episodio 9","episodeNumber":9,"sourceEpisodeNumber":9,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"15867","scope":"R","episodeNumbers":[9]},{"provider":"anilist","id":"117012","episodeNumbers":[9]},{"provider":"mal","id":"44218","episodeNumbers":[9]},{"provider":"tmdb_show","id":"101172","scope":"s1","seasonNumber":1,"episodeNumbers":[9]},{"provider":"tvdb_show","id":"392226","scope":"s1","seasonNumber":1,"episodeNumbers":[9]}],"link":"101105","synopsis":"罗峰救出徐欣之后连忙向着安全地方撤退，此时一个人一直在高楼上看着她们，不久，罗峰小队就被一直初级战兽双尾虎猫拦住了去路，火锤小队的队长高峰负责断后，让罗峰等人先带着徐欣撤离，与此同时潘亚等人组成的小队正在不远处的高楼上监视着他们的一举一动，她们决定出手击杀高风，趁火锤小队手足无措的时候将他们各个击破，躲进了废墟里的罗峰等人也被三头怪兽包围了，罗峰利用他精神年时的能力成功击杀了三头怪兽，与此同时高风也解决了双尾虎猫，潘亚等人决定利用高风去引出他们想要猎杀的怪兽，最后在坐收渔翁之利。\\n\\n而火锤小队此时已经从徐欣的描述中了解到了潘亚等人想要做的事情，他们猜测对方想要捕杀的怪兽还没露面，而他们很可能被对方当成了新的诱饵。潘亚开启超声波将银月凶狼引到了火锤小队的附近，张科被火箭弹打断了一条胳膊，众人逃跑的道路也被潘亚堵住了，大家一时之间伤亡惨重。而高风也发现这一切是虎牙小队做的，他们连忙撤退了，然而这些动静将周围的战兽全都引来了，罗峰等人陷入了前所未有的危急时刻。","thumbnail":"https://image.tmdb.org/t/p/w300/cse672TKyJX0nWdYADtBpNiRjUY.jpg"},{"title":"Episodio 10","episodeNumber":10,"sourceEpisodeNumber":10,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"15867","scope":"R","episodeNumbers":[10]},{"provider":"anilist","id":"117012","episodeNumbers":[10]},{"provider":"mal","id":"44218","episodeNumbers":[10]},{"provider":"tmdb_show","id":"101172","scope":"s1","seasonNumber":1,"episodeNumbers":[10]},{"provider":"tvdb_show","id":"392226","scope":"s1","seasonNumber":1,"episodeNumbers":[10]}],"link":"101107","synopsis":"被怪兽包围的火锤小队疲于逃命，罗峰为了掩护大家安全离开只好将他是精神念师的事情暴露了出来，而银月凶狼也盯上了罗峰等人，与此同时潘亚等人打算去追击受了上的银月凶狼，这也是他门此行的真正目的。罗峰十分愧疚，他觉得他们这次被虎牙小队针对，很可能是因为罗峰之前得罪了张泽虎，张科的手笔被打断了一条，大家都清楚他的武者生涯算是到此为止了。","thumbnail":"https://image.tmdb.org/t/p/w300/fgPr5feS9Q7FyjeUMvN5UU3QR3a.jpg"},{"title":"Episodio 11","episodeNumber":11,"sourceEpisodeNumber":11,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"15867","scope":"R","episodeNumbers":[11]},{"provider":"anilist","id":"117012","episodeNumbers":[11]},{"provider":"mal","id":"44218","episodeNumbers":[11]},{"provider":"tmdb_show","id":"101172","scope":"s1","seasonNumber":1,"episodeNumbers":[11]},{"provider":"tvdb_show","id":"392226","scope":"s1","seasonNumber":1,"episodeNumbers":[11]}],"link":"101106","synopsis":"领主级怪兽巨岩黑熊正在接近江南基地市，幸好战神陆纲及时出现，依靠九重雷刀击败了巨岩黑熊...","thumbnail":"https://image.tmdb.org/t/p/w300/jFsCr2SdxD3ipxFLcZ4KNgRfXZp.jpg"},{"title":"Episodio 12","episodeNumber":12,"sourceEpisodeNumber":12,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"15867","scope":"R","episodeNumbers":[12]},{"provider":"anilist","id":"117012","episodeNumbers":[12]},{"provider":"mal","id":"44218","episodeNumbers":[12]},{"provider":"tmdb_show","id":"101172","scope":"s1","seasonNumber":1,"episodeNumbers":[12]},{"provider":"tvdb_show","id":"392226","scope":"s1","seasonNumber":1,"episodeNumbers":[12]}],"link":"101109","synopsis":"为了尽快领悟九重雷刀的第二重，罗峰独自前往了0201县城进行历练。却没想到鼠潮意外爆发，为了保护基地市。战神陆纲出现，以身引雷击退了鼠潮，而他自己也化作一缕青烟陨落了。这一幕无疑对罗峰造成了极大的打击，如果自己当时的实力再高一些就好了...","thumbnail":"https://image.tmdb.org/t/p/w300/7S1g8P3tFWimJd8kLSiKihynbqX.jpg"},{"title":"Episodio 13","episodeNumber":13,"sourceEpisodeNumber":13,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"15867","scope":"R","episodeNumbers":[13]},{"provider":"anilist","id":"117012","episodeNumbers":[13]},{"provider":"mal","id":"44218","episodeNumbers":[13]},{"provider":"tmdb_show","id":"101172","scope":"s1","seasonNumber":1,"episodeNumbers":[13]},{"provider":"tvdb_show","id":"392226","scope":"s1","seasonNumber":1,"episodeNumbers":[13]}],"link":"101108","synopsis":"在参加了陆纲的追悼会之后，火锤小队打算去003号城市清理怪兽。这里，怪兽肆虐，罗峰他们还救下了一支印度小队。谁知，雷霆小队和虎牙小队 结伙出现，原来他们是看上了罗峰击杀的猎物...","thumbnail":"https://image.tmdb.org/t/p/w300/rq7hHPN419MblUGSpDmfRWW3ZtY.jpg"},{"title":"Episodio 14","episodeNumber":14,"sourceEpisodeNumber":14,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"15867","scope":"R","episodeNumbers":[14]},{"provider":"anilist","id":"117012","episodeNumbers":[14]},{"provider":"mal","id":"44218","episodeNumbers":[14]},{"provider":"tmdb_show","id":"101172","scope":"s1","seasonNumber":1,"episodeNumbers":[14]},{"provider":"tvdb_show","id":"392226","scope":"s1","seasonNumber":1,"episodeNumbers":[14]}],"link":"101111","synopsis":"罗峰留下来给火锤小队做掩护，顺便追踪雷霆小队的行踪。为了给张科报仇，罗峰打算解决与雷霆小队同行的虎牙小队。在多天的等待之后，罗峰终于迎来了机会...","thumbnail":"https://image.tmdb.org/t/p/w300/zOgPGoM23PCGtj711MHcVAjpv4O.jpg"},{"title":"Episodio 15","episodeNumber":15,"sourceEpisodeNumber":15,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"15867","scope":"R","episodeNumbers":[15]},{"provider":"anilist","id":"117012","episodeNumbers":[15]},{"provider":"mal","id":"44218","episodeNumbers":[15]},{"provider":"tmdb_show","id":"101172","scope":"s1","seasonNumber":1,"episodeNumbers":[15]},{"provider":"tvdb_show","id":"392226","scope":"s1","seasonNumber":1,"episodeNumbers":[15]}],"link":"101110","synopsis":"两位战神恰巧出现，为雷霆小队解了围，原来他们来这里是为了毁掉即将 孵化的铁甲龙蛋。在嘱咐一番雷霆小队后，两位战神便离开了。罗峰听到这个消息，决定去观看战神和高级领主怪兽的战斗以提升自己的战斗经验...","thumbnail":"https://image.tmdb.org/t/p/w300/lDiDQzcB5aw4tDnifBvVP2QVpfL.jpg"},{"title":"Episodio 16","episodeNumber":16,"sourceEpisodeNumber":16,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"15867","scope":"R","episodeNumbers":[16]},{"provider":"anilist","id":"117012","episodeNumbers":[16]},{"provider":"mal","id":"44218","episodeNumbers":[16]},{"provider":"tmdb_show","id":"101172","scope":"s1","seasonNumber":1,"episodeNumbers":[16]},{"provider":"tvdb_show","id":"392226","scope":"s1","seasonNumber":1,"episodeNumbers":[16]}],"link":"101113","synopsis":"战神与铁甲龙激战不断，为了帮助两位战神，罗峰打算前去摧毁龙蛋。但龙蛋的价值毕竟很高，与其摧毁它还不如将其交给研究机构让龙蛋发挥更大的作用...","thumbnail":"https://image.tmdb.org/t/p/w300/7YArSxw9hxM1B6LeuLSPMB6txgf.jpg"},{"title":"Episodio 17","episodeNumber":17,"sourceEpisodeNumber":17,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"15867","scope":"R","episodeNumbers":[17]},{"provider":"anilist","id":"117012","episodeNumbers":[17]},{"provider":"mal","id":"44218","episodeNumbers":[17]},{"provider":"tmdb_show","id":"101172","scope":"s1","seasonNumber":1,"episodeNumbers":[17]},{"provider":"tvdb_show","id":"392226","scope":"s1","seasonNumber":1,"episodeNumbers":[17]}],"link":"101112","synopsis":"罗峰摆脱了铁甲龙的追击，却又遇上了雷霆小队和虎牙小队。面对罗峰拿到的铁甲龙蛋，雷霆和虎牙小队都非常眼热。他们抢先对罗峰出手，却反被罗峰一个人击杀..","thumbnail":"https://image.tmdb.org/t/p/w300/unM9YHOZY6O2EUf3kxV6pOs1M7A.jpg"},{"title":"Episodio 18","episodeNumber":18,"sourceEpisodeNumber":18,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"15867","scope":"R","episodeNumbers":[18]},{"provider":"anilist","id":"117012","episodeNumbers":[18]},{"provider":"mal","id":"44218","episodeNumbers":[18]},{"provider":"tmdb_show","id":"101172","scope":"s1","seasonNumber":1,"epis