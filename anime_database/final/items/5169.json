X59hJEoqwudjfpp4G7zsb.jpg"},{"title":"Celebrazione","episodeNumber":2,"sourceEpisodeNumber":2,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"18104","scope":"R","episodeNumbers":[2]},{"provider":"anilist","id":"166873","episodeNumbers":[2]},{"provider":"mal","id":"55888","episodeNumbers":[2]},{"provider":"tmdb_show","id":"94664","scope":"s2","seasonNumber":2,"episodeNumbers":[14]},{"provider":"tvdb_show","id":"371310","scope":"s2","seasonNumber":2,"episodeNumbers":[14]}],"link":"80209","synopsis":"Rudeus e Sylphie organizzano nella nuova casa una festa per celebrare il matrimonio, invitando amici e conoscenti dell'Accademia. Tra i preparativi e gli ospiti, la giornata diventa l'occasione per capire quante persone si siano ormai legate a loro.","thumbnail":"https://image.tmdb.org/t/p/w300/t9goEAxsd8LudOnzgHJHMwIFzJB.jpg"},{"title":"Distanza","episodeNumber":3,"sourceEpisodeNumber":3,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"18104","scope":"R","episodeNumbers":[3]},{"provider":"anilist","id":"166873","episodeNumbers":[3]},{"provider":"mal","id":"55888","episodeNumbers":[3]},{"provider":"tmdb_show","id":"94664","scope":"s2","seasonNumber":2,"episodeNumbers":[15]},{"provider":"tvdb_show","id":"371310","scope":"s2","seasonNumber":2,"episodeNumbers":[15]}],"link":"80482","synopsis":"Arriva una lettera di Paul: dopo anni di ricerche, si sono finalmente trovate tracce di Zenith. Nello stesso periodo Rudeus riceve un'altra notizia da casa, perché Aisha e Norn stanno per raggiungerlo a Ranoa, e la quiete della sua nuova vita è destinata a durare poco.","thumbnail":"https://image.tmdb.org/t/p/w300/73G9pW6Hq6KSe32iYcSrwSllppN.jpg"},{"title":"Norn e Aisha","episodeNumber":4,"sourceEpisodeNumber":4,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"18104","scope":"R","episodeNumbers":[4]},{"provider":"anilist","id":"166873","episodeNumbers":[4]},{"provider":"mal","id":"55888","episodeNumbers":[4]},{"provider":"tmdb_show","id":"94664","scope":"s2","seasonNumber":2,"episodeNumbers":[16]},{"provider":"tvdb_show","id":"371310","scope":"s2","seasonNumber":2,"episodeNumbers":[16]}],"link":"80789","synopsis":"Le due sorelle arrivano da Rudeus con stati d'animo opposti: Aisha è entusiasta all'idea di vivere con il fratello maggiore, mentre Norn mal sopporta di essere stata allontanata dal padre e non fa nulla per nasconderlo.","thumbnail":"https://image.tmdb.org/t/p/w300/9YJCqvhLiRHHIfaR7PE1ou3ny3w.jpg"},{"title":"I sentimenti di un fratello maggiore","episodeNumber":5,"sourceEpisodeNumber":5,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"18104","scope":"R","episodeNumbers":[5]},{"provider":"anilist","id":"166873","episodeNumbers":[5]},{"provider":"mal","id":"55888","episodeNumbers":[5]},{"provider":"tmdb_show","id":"94664","scope":"s2","seasonNumber":2,"episodeNumbers":[17]},{"provider":"tvdb_show","id":"371310","scope":"s2","seasonNumber":2,"episodeNumbers":[17]}],"link":"81176","synopsis":"Il rapporto con Norn continua a deteriorarsi, e Rudeus si rende conto di stare ripetendo errori che riconosce fin troppo bene dalla vita precedente. Per non perdere anche questa occasione, decide di provare a capire davvero che cosa stia passando la sorella.","thumbnail":"https://image.tmdb.org/t/p/w300/5uqn76jSS3Zy3NPbPSvO6bLIR08.jpg"},{"title":"Punto di svolta n°3","episodeNumber":6,"sourceEpisodeNumber":6,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"18104","scope":"R","episodeNumbers":[6]},{"provider":"anilist","id":"166873","episodeNumbers":[6]},{"provider":"mal","id":"55888","episodeNumbers":[6]},{"provider":"tmdb_show","id":"94664","scope":"s2","seasonNumber":2,"episodeNumbers":[18]},{"provider":"tvdb_show","id":"371310","scope":"s2","seasonNumber":2,"episodeNumbers":[18]}],"link":"81315","synopsis":"Il dio-uomo torna a comparire in sogno e annuncia a Rudeus quali saranno i prossimi eventi, indicandogli esattamente come dovrebbe comportarsi. Questa volta, però, Rudeus ha imparato qualcosa sul conto di quella voce, e non è affatto disposto a seguirla.","thumbnail":"https://image.tmdb.org/t/p/w300/lBwC3cCgMuGJRxAX52tRJaWi6dd.jpg"},{"title":"Il viaggio nel deserto","episodeNumber":7,"sourceEpisodeNumber":7,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"18104","scope":"R","episodeNumbers":[7]},{"provider":"anilist","id":"166873","episodeNumbers":[7]},{"provider":"mal","id":"55888","episodeNumbers":[7]},{"provider":"tmdb_show","id":"94664","scope":"s2","seasonNumber":2,"episodeNumbers":[19]},{"provider":"tvdb_show","id":"371310","scope":"s2","seasonNumber":2,"episodeNumbers":[19]}],"link":"81622","synopsis":"Rudeus parte insieme a Elinalise per raggiungere il padre e unirsi alle ricerche di Zenith. Il cammino attraversa un deserto ostile che li separa dalla città di Rapan, e lungo la strada emergono verità scomode sul passato della sua compagna di viaggio.","thumbnail":"https://image.tmdb.org/t/p/w300/xSi2t4SSx7XGrLdzy8Gp9GLJ1SD.jpg"},{"title":"Ingresso nel labirinto","episodeNumber":8,"sourceEpisodeNumber":8,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"18104","scope":"R","episodeNumbers":[8]},{"provider":"anilist","id":"166873","episodeNumbers":[8]},{"provider":"mal","id":"55888","episodeNumbers":[8]},{"provider":"tmdb_show","id":"94664","scope":"s2","seasonNumber":2,"episodeNumbers":[20]},{"provider":"tvdb_show","id":"371310","scope":"s2","seasonNumber":2,"episodeNumbers":[20]}],"link":"81771","synopsis":"A Rapan, Rudeus ritrova Geese e finalmente Paul, insieme alla squadra che da tempo esplora il labirinto in cui si troverebbe Zenith. La notizia che lo accoglie è però pessima: Roxy è entrata nel dungeon e non è più tornata.","thumbnail":"https://image.tmdb.org/t/p/w300/6UmlIWL3pW28dMVmPJvI0cGm8uY.jpg"},{"title":"Il cerchio magico del sesto livello","episodeNumber":9,"sourceEpisodeNumber":9,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"18104","scope":"R","episodeNumbers":[9]},{"provider":"anilist","id":"166873","episodeNumbers":[9]},{"provider":"mal","id":"55888","episodeNumbers":[9]},{"provider":"tmdb_show","id":"94664","scope":"s2","seasonNumber":2,"episodeNumbers":[21]},{"provider":"tvdb_show","id":"371310","scope":"s2","seasonNumber":2,"episodeNumbers":[21]}],"link":"81976","synopsis":"Rudeus riesce a raggiungere Roxy e a strapparla a un'orda di mostri, ma la donna non sembra rendersi conto di chi abbia davanti. Ricomposto il gruppo, la squadra si prepara a scendere di nuovo nel labirinto, consapevole che stavolta non ci sarà spazio per errori.","thumbnail":"https://image.tmdb.org/t/p/w300/2iZ0wOEnZ6DyvBWqdLPvPDFjU8q.jpg"},{"title":"Genitori","episodeNumber":10,"sourceEpisodeNumber":10,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"18104","scope":"R","episodeNumbers":[10]},{"provider":"anilist","id":"166873","episodeNumbers":[10]},{"provider":"mal","id":"55888","episodeNumbers":[10]},{"provider":"tmdb_show","id":"94664","scope":"s2","seasonNumber":2,"episodeNumbers":[22]},{"provider":"tvdb_show","id":"371310","scope":"s2","seasonNumber":2,"episodeNumbers":[22]}],"link":"82159","synopsis":"Nelle profondità del labirinto il gruppo trova finalmente Zenith, ma a vegliare su di lei c'è una creatura enorme che non ha alcuna intenzione di lasciarla andare. Rudeus e Paul si mettono in prima linea per affrontarla, padre e figlio fianco a fianco per la prima volta.","thumbnail":"https://image.tmdb.org/t/p/w300/oe5fQnzK6uixFvpmN0w0WAuc3Lk.jpg"},{"title":"Torniamo a casa","episodeNumber":11,"sourceEpisodeNumber":11,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"18104","scope":"R","episodeNumbers":[11]},{"provider":"anilist","id":"166873","episodeNumbers":[11]},{"provider":"mal","id":"55888","episodeNumbers":[11]},{"provider":"tmdb_show","id":"94664","scope":"s2","seasonNumber":2,"episodeNumbers":[23]},{"provider":"tvdb_show","id":"371310","scope":"s2","seasonNumber":2,"episodeNumbers":[23]}],"link":"82742","synopsis":"Il prezzo pagato nel labirinto lascia Rudeus incapace di reagire. A rimetterlo in piedi è Roxy, e ciò che accade tra loro lo porterà a rimettere in discussione alcune delle scelte che credeva già fatte.","thumbnail":"https://image.tmdb.org/t/p/w300/zsJlKRwGXI2dcgyMjiZqnQuO0gf.jpg"},{"title":"Eredità","episodeNumber":12,"sourceEpisodeNumber":12,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"18104","scope":"R","episodeNumbers":[12]},{"provider":"anilist","id":"166873","episodeNumbers":[12]},{"provider":"mal","id":"55888","episodeNumbers":[12]},{"provider":"tmdb_show","id":"94664","scope":"s2","seasonNumber":2,"episodeNumbers":[24]},{"provider":"tvdb_show","id":"371310","scope":"s2","seasonNumber":2,"episodeNumbers":[24]}],"link":"83198","synopsis":"Rudeus fa ritorno a casa portando con sé notizie buone e notizie che avrebbe voluto non dover dare. A Sylphie rivolge poi una richiesta tutt'altro che semplice, che riguarda il futuro della loro famiglia e ciò che ha deciso di farsene dell'eredità ricevuta.","thumbnail":"https://image.tmdb.org/t/p/w300/34qxeVn9C6L15CnvovgP7smyNyq.jpg"}],"sourceIds":{"anilistId":166873,"malId":55888},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-29T07:54:59Z","sourceDescriptors":["anilist:166873","mal:55888"],"targets":[{"provider":"anidb","id":"17236","scope":"R"},{"provider":"anidb","id":"18104","scope":"R","ranges":{"1-12":"1-12"}},{"provider":"anilist","id":"146065"},{"provider":"anilist","id":"166873","ranges":{"1-12":"1-12"}},{"provider":"mal","id":"51179"},{"provider":"mal","id":"55888","ranges":{"1-12":"1-12"}},{"provider":"tmdb_show","id":"94664","scope":"s2","ranges":{"1-12":"13-24"}},{"provider":"tvdb_show","id":"371310","scope":"s2","ranges":{"1-12":"13-24"}}]},"sourceMetadata":{"info":{"id":5169,"title":"Mushoku Tensei II: Isekai Ittara Honki Dasu Part 2 (ITA)","title_eng":"Mushoku Tensei: Jobless Reincarnation 2 Part 2 (ITA)","slug":"mushoku-tensei-jobless-reincarnation-2-part-2-it