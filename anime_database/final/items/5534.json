etvdb.com/banners/fanart/original/321535-5.jpg"},{"source":"provider","url":"https://img.animeunity.co/anime/n21452-HttTXJ1kgmxs.jpg"}]}},"related":[],"linkList":[{"title":"Stagione 1","seasonNumber":1,"availabilityStatus":"available","episodesLink":"5534|1|12|tmdb_show%3A71016%3As1"}]},"episodes":[{"title":"Yaha-kui zaShunina","episodeNumber":1,"sourceEpisodeNumber":1,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"11762","scope":"R","episodeNumbers":[1]},{"provider":"anilist","id":"21452","episodeNumbers":[2]},{"provider":"tmdb_show","id":"71016","scope":"s1","seasonNumber":1,"episodeNumbers":[1]},{"provider":"tvdb_show","id":"321535","scope":"s0","seasonNumber":0,"episodeNumbers":[1]},{"provider":"tvdb_show","id":"321535","scope":"s1","seasonNumber":1,"episodeNumbers":[1]}],"link":"84281","synopsis":"A huge, 2 kilometer cube appears in the middle of Haneda airport. A passenger plane is absorbed inside it, and no one knows if the passengers are dead or alive. The Japanese government convenes an emergency meeting to deal with this unexpected event, and tries various things to learn about the cube, which it names \"Kado.\" But when even the most powerful weapons fail, what's left for the people of Japan to do?","thumbnail":"https://image.tmdb.org/t/p/w300/kDDyAcoL8wavUa9pKjXtnV9Lxxd.jpg"},{"title":"Yaha-kui zaShunina","episodeNumber":2,"sourceEpisodeNumber":2,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"11762","scope":"R","episodeNumbers":[1,2]},{"provider":"anilist","id":"21452","episodeNumbers":[3]},{"provider":"mal","id":"32032","episodeNumbers":[1]},{"provider":"tmdb_show","id":"71016","scope":"s1","seasonNumber":1,"episodeNumbers":[1,2]},{"provider":"tvdb_show","id":"321535","scope":"s1","seasonNumber":1,"episodeNumbers":[1,2]}],"link":"84282","synopsis":"A huge, 2 kilometer cube appears in the middle of Haneda airport. A passenger plane is absorbed inside it, and no one knows if the passengers are dead or alive. The Japanese government convenes an emergency meeting to deal with this unexpected event, and tries various things to learn about the cube, which it names \"Kado.\" But when even the most powerful weapons fail, what's left for the people of Japan to do?","thumbnail":"https://image.tmdb.org/t/p/w300/kDDyAcoL8wavUa9pKjXtnV9Lxxd.jpg"},{"title":"Novo","episodeNumber":3,"sourceEpisodeNumber":3,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"11762","scope":"R","episodeNumbers":[2,3]},{"provider":"anilist","id":"21452","episodeNumbers":[4]},{"provider":"mal","id":"32032","episodeNumbers":[2]},{"provider":"tmdb_show","id":"71016","scope":"s1","seasonNumber":1,"episodeNumbers":[2,3]},{"provider":"tvdb_show","id":"321535","scope":"s1","seasonNumber":1,"episodeNumbers":[2,3]}],"link":"84283","synopsis":"Japanese government negotiator Koujirou Shindou has been absorbed into a giant 2km long cube known as Kado. Inside, he meets a being called Yaha-kui zaShunina, who seems to possess powers beyond humanity's ability to comprehend. Who is this being, and what are his plans for humanity? Shindou agrees to become this creature's representative as it begins its negotiations with the Japanese government.","thumbnail":"https://image.tmdb.org/t/p/w300/r0GMQv6zF1ZifR0PHL3scfS6VXu.jpg"},{"title":"Wam","episodeNumber":4,"sourceEpisodeNumber":4,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"11762","scope":"R","episodeNumbers":[3,4]},{"provider":"anilist","id":"21452","episodeNumbers":[5]},{"provider":"mal","id":"32032","episodeNumbers":[3]},{"provider":"tmdb_show","id":"71016","scope":"s1","seasonNumber":1,"episodeNumbers":[3,4]},{"provider":"tvdb_show","id":"321535","scope":"s1","seasonNumber":1,"episodeNumbers":[3,4]}],"link":"84284","synopsis":"In a meeting with the Japanese government, broadcast in front of the entire world, Yaha-kui zaShunina states that his goal is humanity's advancement. To this end, he offers them the Wam, a simple device capable of generating limitless energy from dimensions beyond our own.","thumbnail":"https://image.tmdb.org/t/p/w300/qZCwXoOTEKRgYNLYwVykNdkYPWd.jpg"},{"title":"Rotowa","episodeNumber":5,"sourceEpisodeNumber":5,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"11762","scope":"R","episodeNumbers":[4,5]},{"provider":"anilist","id":"21452","episodeNumbers":[6]},{"provider":"mal","id":"32032","episodeNumbers":[4]},{"provider":"tmdb_show","id":"71016","scope":"s1","seasonNumber":1,"episodeNumbers":[4,5]},{"provider":"tvdb_show","id":"321535","scope":"s1","seasonNumber":1,"episodeNumbers":[4,5]}],"link":"84285","synopsis":"The UN Security Council is greatly concerned by the Japanese government's possession of the Wam, sources of limitless energy. They demand that all Wam be turned over to them, and promise that noncompliance will be met with potential military action. But Yaha-kui zaShunina wants all humanity to have the Wam, and does not want its use to be restricted to only a few governments. He comes up with an alternate plan...","thumbnail":"https://image.tmdb.org/t/p/w300/3D4RG1vo0IEcf7N84m9RPvg1OWx.jpg"},{"title":"Nanoka","episodeNumber":6,"sourceEpisodeNumber":6,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"11762","scope":"R","episodeNumbers":[5,6]},{"provider":"anilist","id":"21452","episodeNumbers":[7]},{"provider":"mal","id":"32032","episodeNumbers":[5]},{"provider":"tmdb_show","id":"71016","scope":"s1","seasonNumber":1,"episodeNumbers":[5,6]},{"provider":"tvdb_show","id":"321535","scope":"s1","seasonNumber":1,"episodeNumbers":[5,6]}],"link":"84286","synopsis":"The world's governments are demanding the Wam be handed over immediately. An American carrier strike force has left Yokosuka port. Economic sanctions are in place. The Japanese government must either hand over the Wam and give up a source of free, infinite energy, or be ready to fight the entire world. Shindou, however, offers the Prime Minister a third option...","thumbnail":"https://image.tmdb.org/t/p/w300/nDTKrNBOtlWPCBiJH8AB2LmPdND.jpg"},{"title":"Tetrok","episodeNumber":7,"sourceEpisodeNumber":7,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"11762","scope":"R","episodeNumbers":[6,7]},{"provider":"anilist","id":"21452","episodeNumbers":[8]},{"provider":"mal","id":"32032","episodeNumbers":[6]},{"provider":"tmdb_show","id":"71016","scope":"s1","seasonNumber":1,"episodeNumbers":[6,7]},{"provider":"tvdb_show","id":"321535","scope":"s1","seasonNumber":1,"episodeNumbers":[6,7]}],"link":"84287","synopsis":"The last of the passengers are leaving the inside of the giant Kado cube, and it's time for the next step: moving the cube itself to a new location away from Haneda airport. Shindou takes the lead in organizing the project, leading Tsukai to ask how long it's been since he slept. He can't remember. This is the next step of the anisotropic's plan.","thumbnail":"https://image.tmdb.org/t/p/w300/zjoW1jHmfoBxWL3lPQHvy9EqVsH.jpg"},{"title":"Sansa","episodeNumber":8,"sourceEpisodeNumber":8,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"11762","scope":"R","episodeNumbers":[7,8]},{"provider":"anilist","id":"21452","episodeNumbers":[9]},{"provider":"mal","id":"32032","episodeNumbers":[7]},{"provider":"tmdb_show","id":"71016","scope":"s1","seasonNumber":1,"episodeNumbers":[7,8]},{"provider":"tvdb_show","id":"321535","scope":"s1","seasonNumber":1,"episodeNumbers":[7,8]}],"link":"84288","synopsis":"After the Wam, zaShunina reveals his second invention: A device that allows humans to go without sleep. The CEO of SETTEN, the world's largest internet company, with assets in the hundreds of billions of dollars, wants to be involved in the process. Does he just want his company to have a piece of the pie, or does he have other motives?","thumbnail":"https://image.tmdb.org/t/p/w300/rYucGyB4ggGqqYGnH6vhdv1B3Ru.jpg"},{"title":"Talnel","episodeNumber":9,"sourceEpisodeNumber":9,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"11762","scope":"R","episodeNumbers":[8,9]},{"provider":"anilist","id":"21452","episodeNumbers":[10]},{"provider":"mal","id":"32032","episodeNumbers":[8]},{"provider":"tmdb_show","id":"71016","scope":"s1","seasonNumber":1,"episodeNumbers":[8,9]},{"provider":"tvdb_show","id":"321535","scope":"s1","seasonNumber":1,"episodeNumbers":[8,9]}],"link":"84289","synopsis":"Shindou takes a break from dealing with the anisotropic to go around with Tsukai, who wants to dissuade him from helping the anisotropic. He meets her family, and travels on a boat with her. She wants human dignity to be protected, and tells him that zaShunina is a threat to the universe that she loves.","thumbnail":"https://image.tmdb.org/t/p/w300/f9xwV3HokYymhnfSvMGdBsuCTuG.jpg"},{"title":"Nanomis-hein","episodeNumber":10,"sourceEpisodeNumber":10,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"11762","scope":"R","episodeNumbers":[9,10]},{"provider":"anilist","id":"21452","episodeNumbers":[11]},{"provider":"mal","id":"32032","episodeNumbers":[9]},{"provider":"tmdb_show","id":"71016","scope":"s1","seasonNumber":1,"episodeNumbers":[9,10]},{"provider":"tvdb_show","id":"321535","scope":"s1","seasonNumber":1,"episodeNumbers":[9,10]}],"link":"84290","synopsis":"Yaha-kui reveals his next device: a device that gives its wearer control over the constants of the universe. He tells Shindou about the reason for his visit to the universe, and what his plans for the future are.","thumbnail":"https://image.tmdb.org/t/p/w300/xh0M64uCwB7dTM3gBAh67ZSnRba.jpg"},{"title":"Towanosakiwa'","episodeNumber":11,"sourceEpisodeNumber":11,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"11762","scope":"R","episodeNumbers":[10,11]},{"provider":"anilist","id":"21452","episodeNumbers":[12]},{"provider":"mal","id":"32032","episodeNumbers":[10]},{"provider":"tmdb_show","id":"71016","scope":"s1","seasonNumber":1,"episodeNumbers":[10,11]},{"provider":"tvdb_show","id":"321535","scope":"s1","seasonNumber":1,"episodeNumbers":[10,11]}],"link":"84292","synopsis":"Yahakui is ready to absorb all of humanity and take them to the higher dimensions using Kado. But Shindo has a plan: he has to surprise him. How do you surprise a being that literlly exists on a higher dimension?","thumbnail":"https://image.tmdb.org/t/p/w300/fiibLdA8rhM5qCkLJdjdulDooex.jpg"},{"title":"Wanoraru","episodeNumber":12,"sourceEpisodeNumber":12,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"11762","scope":"R","episodeNumbers":[11,12]},{"provider":"anilist","id":"21452","episodeNumbers":[13]},{"provider":"mal","id":"32032","episodeNumbers":[11]},{"provider":"tmdb_show","id":"71016","scope":"s1","seasonNumber":1,"episodeNumbers":[11,12]},{"provider":"tvdb_show","id":"321535","scope":"s1","seasonNumber":1,"episodeNumbers":[11,12]}],"link":"84291","synopsis":"To stop Yahakui-zashunina's plan, Shindo is hidden in an isolated pocket dimension. There he needs to come up with a way to defeat an omnipotent being.","thumbnail":"https://image.tmdb.org/t/p/w300/nRUdlyPgi7yrJQ8LPJazVkp4SHC.jpg"},{"link":"84293","title":"Episode 13","titleKey":"Episode {{number}}","titleParams":{"number":"13"},"episodeNumber":13,"sourceEpisodeNumber":13}],"sourceIds":{"anilistId":21452,"malId":32032},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-28T07:48:11Z","sourceDescriptors":["anilist:21452","mal:32032"],"imdbSource":"plexanibridge-v2","targets":[{"provider":"anidb","id":"11762","scope":"R","ranges":{"2-13":"1-12","1-12":"1-12"}},{"provider":"anidb","id":"14101","scope":"R"},{"provider":"anilist","id":"119548"},{"provider":"anilist","id":"21452","ranges":{"1-12":"2-13"}},{"provider":"mal","id":"32032","ranges":{"2-13":"1-12"}},{"provider":"mal","id":"37922"},{"provider":"tmdb_movie","id":"526094"},{"provider":"tmdb_show","id":"71016","scope":"s0","ranges":{"1":"1"}},{"provider":"tmdb_show","id":"71016","scope":"s1","ranges":{"2-13":"1-12","1-12":"1-12"}},{"provider":"tvdb_show","id":"321535","scope":"