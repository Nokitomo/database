":[3]},{"provider":"tvdb_show","id":"438151","scope":"s1","seasonNumber":1,"episodeNumbers":[3]}],"link":"76560","synopsis":"Jinka pours his fury out on the Dangaisyuu temple, prompting the local leaders to discuss moving operations elsewhere. Meanwhile, Tama tells Shinsuke and Shakugan a little more about herself and Jinka's spirit transformation.","thumbnail":"https://image.tmdb.org/t/p/w300/vUKzFgnmtalUZDAKuZU6niWqg5S.jpg"},{"title":"Episodio 4","episodeNumber":4,"sourceEpisodeNumber":4,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"18156","scope":"R","episodeNumbers":[4]},{"provider":"anilist","id":"168194","episodeNumbers":[4]},{"provider":"mal","id":"56242","episodeNumbers":[4]},{"provider":"tmdb_show","id":"234995","scope":"s1","seasonNumber":1,"episodeNumbers":[4]},{"provider":"tvdb_show","id":"438151","scope":"s1","seasonNumber":1,"episodeNumbers":[4]}],"link":"76644","synopsis":"Shinsuke and Shakugan are staying with Jinka and Tama, but Shinsuke isn't learning much in the way of fighting skills. Instead, Shinsuke is left behind to do chores when Tama and Jinka are informed of trouble with a local katawara.","thumbnail":"https://image.tmdb.org/t/p/w300/phmm669cayHIQiHfUcONI8Kn1jc.jpg"},{"title":"Episodio 5","episodeNumber":5,"sourceEpisodeNumber":5,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"18156","scope":"R","episodeNumbers":[5]},{"provider":"anilist","id":"168194","episodeNumbers":[5]},{"provider":"mal","id":"56242","episodeNumbers":[5]},{"provider":"tmdb_show","id":"234995","scope":"s1","seasonNumber":1,"episodeNumbers":[5]},{"provider":"tvdb_show","id":"438151","scope":"s1","seasonNumber":1,"episodeNumbers":[5]}],"link":"76884","synopsis":"Shinsuke starts training with Zanzou, who's recuperating in a mountain cave and requests payment in the form of food. Zanzou tells Shinsuke about his sister, and how she came to join the Dangaisyuu as a nun.","thumbnail":"https://image.tmdb.org/t/p/w300/fYQfzSL6dvjJrAEi7Im0P069RjR.jpg"},{"title":"Episodio 6","episodeNumber":6,"sourceEpisodeNumber":6,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"18156","scope":"R","episodeNumbers":[6]},{"provider":"anilist","id":"168194","episodeNumbers":[6]},{"provider":"mal","id":"56242","episodeNumbers":[6]},{"provider":"tmdb_show","id":"234995","scope":"s1","seasonNumber":1,"episodeNumbers":[6]},{"provider":"tvdb_show","id":"438151","scope":"s1","seasonNumber":1,"episodeNumbers":[6]}],"link":"77018","synopsis":"Raidou departs the party, but not without giving Shinsuke a surprising gift first. The journey to Kagan's home is long, and the others are exhausted when they cross paths with a group of monkey katawara.","thumbnail":"https://image.tmdb.org/t/p/w300/9adFPE6HaF6XUeRgPE4bkyoC32h.jpg"},{"title":"Episodio 7","episodeNumber":7,"sourceEpisodeNumber":7,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"18156","scope":"R","episodeNumbers":[7]},{"provider":"anilist","id":"168194","episodeNumbers":[7]},{"provider":"mal","id":"56242","episodeNumbers":[7]},{"provider":"tmdb_show","id":"234995","scope":"s1","seasonNumber":1,"episodeNumbers":[7]},{"provider":"tvdb_show","id":"438151","scope":"s1","seasonNumber":1,"episodeNumbers":[7]}],"link":"77254","synopsis":"The party finally reaches Kagan's hometown, a settlement of katawara. Coincidentally, a pregnant human arrives at the same time, seeking shelter so she can give birth. Not coincidentally, some Dangaisyuu agents also arrive...","thumbnail":"https://image.tmdb.org/t/p/w300/gYPKm32Vbj5dfw773sOsW4SWrWa.jpg"},{"title":"Episodio 8","episodeNumber":8,"sourceEpisodeNumber":8,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"18156","scope":"R","episodeNumbers":[8]},{"provider":"anilist","id":"168194","episodeNumbers":[8]},{"provider":"mal","id":"56242","episodeNumbers":[8]},{"provider":"tmdb_show","id":"234995","scope":"s1","seasonNumber":1,"episodeNumbers":[8]},{"provider":"tvdb_show","id":"438151","scope":"s1","seasonNumb