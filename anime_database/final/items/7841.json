/bx209499-S0sWFrCpft85.jpg"},{"status":"dubbed","statusKey":"Dubbed","title":"Tank Chair","link":"/anime/7842-tank-chair-ita","image":"https://img.animeunity.co/anime/bx209499-S0sWFrCpft85.jpg"}]}],"linkList":[{"title":"Episodes 1-4","titleKey":"Episodes {{start}}-{{end}}","titleParams":{"start":1,"end":4},"availabilityStatus":"available","episodesLink":"7841|1|4"}]},"episodes":[{"title":"Episodio 1","episodeNumber":1,"sourceEpisodeNumber":1,"externalMappings":[{"provider":"anidb","id":"19952","scope":"R","episodeNumbers":[1]},{"provider":"mal","id":"63751","episodeNumbers":[1]},{"provider":"tvdb_show","id":"475617","scope":"s1","seasonNumber":1,"episodeNumbers":[1]}],"link":"110436","synopsis":"Once the city's strongest assassin, Nagi Taira is left unresponsive after protecting his younger sister, Shizuka, and now lives in a wheelchair. Working as an assassin broker, Shizuka takes on assassination jobs and brings her brother to the battlefield for his \"rehab.\" Hoping to fully awaken Nagi, Shizuka accepts a contract to take out Goro Arashiyama, the boss of a notorious robbery gang.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/11682829/screencap/6ac1746220497.jpg"},{"title":"Episodio 2","episodeNumber":2,"sourceEpisodeNumber":2,"externalMappings":[{"provider":"anidb","id":"19952","scope":"R","episodeNumbers":[2]},{"provider":"mal","id":"63751","episodeNumbers":[2]},{"provider":"tvdb_show","id":"475617","scope":"s1","seasonNumber":1,"episodeNumbers":[2]}],"link":"110521","synopsis":"For Nagi's rehabilitation, Shizuka searches for someone with an even stronger killing intent and sets her sights on Ryo Takanashi, a highly skilled sniper. Takanashi is a deranged man interested only in \"good targets.\" Shizuka asks him to shoot Nagi, hoping his intense killing intent will fully awaken her brother.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/12017411/screencap/6acae6f54a5a1.jpg"},{"title":"Episodio 3","episodeNumber":3,"sourceEpisodeNu