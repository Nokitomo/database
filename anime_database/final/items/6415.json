mages.metahub.space/poster/small/tt32281073/img"},{"source":"anilist","url":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/large/bx143598-FCvAhQJLllSP.png"}],"background":[{"source":"tmdb","url":"https://image.tmdb.org/t/p/original/di17PRqnR0THblo92QLGs1qgdCM.jpg"},{"source":"cinemeta","url":"https://images.metahub.space/background/medium/tt32281073/img"},{"source":"anizip","url":"https://artworks.thetvdb.com/banners/v4/series/442540/backgrounds/655db0819591c.jpg"},{"source":"provider","url":"https://img.animeunity.co/anime/143598-WWxsc0g9pVB2.jpg"},{"source":"anilist","url":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/143598-WWxsc0g9pVB2.jpg"}]}},"related":[],"linkList":[{"title":"Episodes 1-24","titleKey":"Episodes {{start}}-{{end}}","titleParams":{"start":1,"end":24},"availabilityStatus":"available","episodesLink":"6415|1|24"}]},"episodes":[{"title":"Uomini e demoni","episodeNumber":1,"sourceEpisodeNumber":1,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"16614","scope":"R","episodeNumbers":[1]},{"provider":"anilist","id":"143598","episodeNumbers":[1]},{"provider":"mal","id":"49778","episodeNumbers":[1]},{"provider":"tmdb_show","id":"133154","scope":"s1","seasonNumber":1,"episodeNumbers":[1]},{"provider":"tvdb_show","id":"442540","scope":"s1","seasonNumber":1,"episodeNumbers":[1]}],"link":"94925","synopsis":"Jinta fugge di casa insieme alla sorella minore maltrattata perché in lei scorre sangue demoniaco. I due bambini vengono trovati e adottati da un uomo che li porta nel proprio villaggio dove fanno la conoscenza della giovane Shirayuki. Trascorrono gli anni e Jinta diventa il guardiano della itsukihime, la sacra sacerdotessa del villaggio che si opppne alla minaccia dei demoni.","thumbnail":"https://image.tmdb.org/t/p/w300/jM1YEDBg7I9ZUts4ymX4YausW8a.jpg"},{"title":"La figlia del demone","episodeNumber":2,"sourceEpisodeNumber":2,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"16614","scope":"R","episodeNumbers":[2]},{"provider":"anilist","id":"143598","episodeNumbers":[2]},{"provider":"mal","id":"49778","episodeNumbers":[2]},{"provider":"tmdb_show","id":"133154","scope":"s1","seasonNumber":1,"episodeNumbers":[2]},{"provider":"tvdb_show","id":"442540","scope":"s1","seasonNumber":1,"episodeNumbers":[2]}],"link":"95299","synopsis":"A Edo, Jin'ya viene assoldato da un negoziante per fare da scorta a sua figlia adottiva che dice di aver visto un demone fuori dalla sua stanza durante le ore piccole. Quella stessa notte, compare nuovamente il demone che continua a chiedere che gli venga restituita sua figlia.","thumbnail":"https://image.tmdb.org/t/p/w300/2yNtSJdpDYMQI1GjHHFGqdW7r30.jpg"},{"title":"Il divoratore (prima parte)","episodeNumber":3,"sourceEpisodeNumber":3,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"16614","scope":"R","episodeNumbers":[3]},{"provider":"anilist","id":"143598","episodeNumbers":[3]},{"provider":"mal","id":"49778","episodeNumbers":[3]},{"provider":"tmdb_show","id":"133154","scope":"s1","seasonNumber":1,"episodeNumbers":[3]},{"provider":"tvdb_show","id":"442540","scope":"s1","seasonNumber":1,"episodeNumbers":[3]}],"link":"95499","synopsis":"Jin'ya sente parlare di uno tsujigiri che terrorizza le strade della città e si mette sulle sue tracce credendo che possa essere un demone. Quella notte, si trova davanti a tre uomini massacrati e incontra un demone in grado di celare la propria presenza. Dopo un breve scontro il demone rivela di non essere il colpevole, ma che lo sta cercando per vendicare la moglie uccisa.","thumbnail":"https://image.tmdb.org/t/p/w300/mZWN54oaCGDVCtof1OmXcYThcO6.jpg"},{"title":"Il divoratore (seconda parte)","episodeNumber":4,"sourceEpisodeNumber":4,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"16614","scope":"R","episodeNumbers":[4]},{"provider":"anilist","id":"143598","episodeNumbers":[4]},{"provider":"mal","id":"49778","episodeNumbers":[4]},{"provider":"tmdb_show","id":"133154","scope":"s1","seasonNumber":1,"episodeNumbers":[4]},{"provider":"tvdb_show","id":"442540","scope":"s1","seasonNumber":1,"episodeNumbers":[4]}],"link":"95672","synopsis":"Jin'ya ha unito le forze con Mosuke per mettersi sulle tracce del demone che uccide gli uomini e rapisce le donne a Edo. Durante un giro di pattuglia, Jin'ya assiste a un attacco dello tsujigiri su uno dei ponti della città e lo mette in fuga dopo un breve scontro. Grazie a un indizio fornito da un conoscente, il cacciatore scopre che il demone si è rifugiato in un tempio in disuso.","thumbnail":"https://image.tmdb.org/t/p/w300/k7Vzqb5tTBNhncRZJOG2tIqzP32.jpg"},{"title":"Il giardino della felicità (prima parte)","episodeNumber":5,"sourceEpisodeNumber":5,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"16614","scope":"R","episodeNumbers":[5]},{"provider":"anilist","id":"143598","episodeNumbers":[5]},{"provider":"mal","id":"49778","episodeNumbers":[5]},{"provider":"tmdb_show","id":"133154","scope":"s1","seasonNumber":1,"episodeNumbers":[5]},{"provider":"tvdb_show","id":"442540","scope":"s1","seasonNumber":1,"episodeNumbers":[5]}],"link":"95802","synopsis":"Un samurai di nome Naotsugu vaga per le strade di Edo in cerca di suo fratello maggiore che è scomparso da un giorno all'altro, ma nessuno sembra ricordarsi della sua esistenza, nemmeno la sua stessa famiglia. Su richiesta di Kihei e Ofuu, Jin'ya decide di indagare su questo caso misterioso anche se non potrebbe c'entrare un demone.","thumbnail":"https://image.tmdb.org/t/p/w300/wlc1GqVErZraE8MTzH8omw2j8GA.jpg"},{"title":"Il giardino della felicità (seconda parte)","episodeNumber":6,"sourceEpisodeNumber":6,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"16614","scope":"R","episodeNumbers":[6]},{"provider":"anilist","id":"143598","episodeNumbers":[6]},{"provider":"mal","id":"49778","episodeNumbers":[6]},{"provider":"tmdb_show","id":"133154","scope":"s1","seasonNumber":1,"episodeNumbers":[6]},{"provider":"tvdb_show","id":"442540","scope":"s1","seasonNumber":1,"episodeNumbers":[6]}],"link":"96100","synopsis":"Naotsugu accompagna Jin'ya a casa sua e gli mostra i fiori che ha trovato nella stanza di suo fratello Sadanaga. Dopo aver compreso che la sua scomparsa è stata causata da un demone, Jin'ya chiede al samurai di mostrargli la stanza e quando arrivano lì i due hanno la visione di un grande incendio e vengono trasportati in un giardino sconosciuto.","thumbnail":"https://image.tmdb.org/t/p/w300/lixiRgpB9Q4tOS1UCmObRNz36Uw.jpg"},{"title":"Sera stregata a Kudanzaka","episodeNumber":7,"sourceEpisodeNumber":7,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"16614","scope":"R","episodeNumbers":[7]},{"provider":"anilist","id":"143598","episodeNumbers":[7]},{"provider":"mal","id":"49778","episodeNumbers":[7]},{"provider":"tmdb_show","id":"133154","scope":"s1","seasonNumber":1,"episodeNumbers":[7]},{"provider":"tvdb_show","id":"442540","scope":"s1","seasonNumber":1,"episodeNumbers":[7]}],"link":"96513","synopsis":"Jin'ya riceve l'incarico di indagare su un disegno di un demone che si dice porti la calamità su chiunque lo possieda e conduca il malcapitato perfino alla morte. Grazie all'aiuto di Zenji, il ronin scopre dove abita l'artista che ha realizzato quell'ukiyo-e e così va a casa sua per farsi raccontare come stanno veramente le cose.","thumbnail":"https://image.tmdb.org/t/p/w300/i5AZYmKosyT24kApHlEONSdFA3S.jpg"},{"title":"La forcina della notte fiorita (prima parte)","episodeNumber":8,"sourceEpisodeNumber":8,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"16614","scope":"R","episodeNumbers":[8]},{"provider":"anilist","id":"143598","episodeNumbers":[8]},{"provider":"mal","id":"49778","episodeNumbers":[8]},{"provider":"tmdb_show","id":"133154","scope":"s1","seasonNumber":1,"episodeNumbers":[8]},{"provider":"tvdb_show","id":"442540","scope":"s1","seasonNumber":1,"episodeNumbers":[8]}],"link":"97210","synopsis":"Al mercato di Asakusa, durante la sagra dei 46.000 giorni, Natsu compra una forcina da un misterioso negoziante venuto da Kyoto. Quando la indossa, la ragazza sembra cambiare del tutto personalità e inizia a desiderare la compagnia di Jin'ya che crede essere suo fratello.","thumbnail":"https://image.tmdb.org/t/p/w300/nOFzExv6mspzaKNmiNWQS1NgkgI.jpg"},{"title":"La forcina della notte fiorita (seconda parte)","episodeNumber":9,"sourceEpisodeNumber":9,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"16614","scope":"R","episodeNumbers":[9]},{"provider":"anilist","id":"143598","episodeNumbers":[9]},{"provider":"mal","id":"49778","episodeNumbers":[9]},{"provider":"tmdb_show","id":"133154","scope":"s1","seasonNumber":1,"episodeNumbers":[9]},{"provider":"tvdb_show","id":"442540","scope":"s1","seasonNumber":1,"episodeNumbers":[9]}],"link":"97309","synopsis":"Jin'ya affronta gli inugami evocati da Akitsu, notando che si tratta di un potere molto simile a quello dei demoni. Al termine dello scontro viene chiarito il malinteso e Akitsu si offre di aiutare il ronin a far tornare alla normalità Natsu che è stata come posseduta dalla forcina acquistata il giorno prima.","thumbnail":"https://image.tmdb.org/t/p/w300/pkoax6MvdAmutByf9rACHiKK88S.jpg"},{"title":"Lucciola nella pioggia","episodeNumber":10,"sourceEpisodeNumber":10,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"16614","scope":"R","episodeNumbers":[10]},{"provider":"anilist","id":"143598","episodeNumbers":[10]},{"provider":"mal","id":"49778","episodeNumbers":[10]},{"provider":"tmdb_show","id":"133154","scope":"s1","seasonNumber":1,"episodeNumbers":[10]},{"provider":"tvdb_show","id":"442540","scope":"s1","seasonNumber":1,"episodeNumbers":[10]}],"link":"97518","synopsis":"Una notte di pioggia Naotsugu trova riparo sotto una gronda e fa la conoscenza di Lucciola, la prostituta che fornisce informazioni su strani eventi a Jin'ya. Il samurai subito si invaghisce della donna e il giorno dopo torna di nuovo nello stesso luogo per rivederla, ma davanti ai due compare un'ombra che sembra avere l'aspetto di persone del loro passato.","thumbnail":"https://image.tmdb.org/t/p/w300/dSOPtIBJvI1MFDBW0A0wy28B3Rr.jpg"},{"title":"L'ebbrezza della neve residua (prima parte)","episodeNumber":11,"sourceEpisodeNumber":11,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"16614","scope":"R","episodeNumbers":[11]},{"provider":"anilist","id":"143598","episodeNumbers":[11]},{"provider":"mal","id":"49778","episodeNumbers":[11]},{"provider":"tmdb_show","id":"133154","scope":"s1","seasonNumber":1,"episodeNumbers":[11]},{"provider":"tvdb_show","id":"442540","scope":"s1","seasonNumber":1,"episodeNumbers":[11]}],"link":"97746","synopsis":"Per le strade di Edo inizia a circolare uno strano sakè chiamato Vestigia di neve che ottiene subito incredibile popolarità e va a ruba, ma spesso chi lo beve diventa aggressivo e finisce coinvolto in casi con morti violente. Così Jin'ya inizia a indagare sulla situazione che lo tocca più da vicino di quanto crede.","thumbnail":"https://image.tmdb.org/t/p/w300/kzi3IzkiCXcwhZX6iA1pwWlfxmY.jpg"},{"title":"L'ebbrezza della neve residua (seconda parte)","episodeNumber":12,"sourceEpisodeNumber":12,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"16614","scope":"R","episodeNumbers":[12]},{"provider":"anilist","id":"143598","episodeNumbers":[12]},{"provider":"mal","id":"49778","episodeNumbers":[12]},{"provider":"tmdb_show","id":"133154","scope":"s1","seasonNumber":1,"episodeNumbers":[12]},{"provider":"tvdb_show","id":"442540","scope":"s1","seasonNumber":1,"episodeNumbers":[12]}],"link":"98040","synopsis":"Jin'ya e Akitsu Somegoro continuano a indagare sullo strano sake che sembra rendere violento chi ne beve quantità eccessive e si rivolgono a Lucciola. Grazie a informazioni ottenute dai suoi clienti, la prostituta indirizza Jin'ya al Mizuki-ya, un negozio di liquori il cui proprietario aveva assoldato il ronin due anni prima.","thumbnail":"https://image.tmdb.org/t/p/w300/2DcgnNc08gnFU3lGvG4VbHbRdr8.jpg"},{"title":"L'ebbrezza della neve residua (terza parte)","episodeNumber":13,"sourceEpisodeNumber":13,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"16614","scope":"R","episodeNumbers":[13]},{"provider":"anilist","id":"143598","episodeNumbers":[13]},{"provider":"mal","id":"49778","episodeNumbers":[13]},{"provider":"tmdb_show","id":"133154","scope":"s1","seasonNumber":1,"episodeNumbers":[13]},{"provider":"tvdb_show","id":"442540","scope":"s1","seasonNumber":1,"episodeNumbers":[13]}],"link":"98244","synopsis":"A causa del troppo sakè Vestigia di neve ingerito Juzo si tramuta in demone e perde la ragione attaccando anche figlia Natsu, ma grazie all'intervento di Jin'ya si evita il peggio. Adesso il ronin dovrà affrontare il suo stesso padre con cui si era riconciliato dopo lunghi anni di separazione, per non parlare della misteriosa fonte di sakè in cui è coinvolta una donna dai capelli biondi.","thumbnail":"https://image.tmdb.org/t/p/w300/xqIbhQlhcqq3GrG7ZGAhKk5OTRd.jpg"},{"title":"Gelosia incarnata","episodeNumber":14,"sourceEpisodeNumber":14,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"16614","scope":"R","episodeNumbers":[14]},{"provider":"anilist","id":"143598","episodeNumbers":[14]},{"provider":"mal","id":"49778","episodeNumbers":[14]},{"provider":"tmdb_show","id":"133154","scope":"s1","seasonNumber":1,"episodeNumbers":[14]},{"provider":"tvdb_show","id":"442540","scope":"s1","seasonNumber":1,"episodeNumbers":[14]}],"link":"99436","synopsis":"Nel passato, Jinta svolge i suoi doveri di guardiano della itsukihime e di falciademoni, ma quando il capovillaggio propone suo figlio Kiyomasa come secondo guardiano della principessa, la gelosia inizia a insinuarsi nell'animo dello spadaccino, nonostante su Kadono incomba la minaccia di un pericoloso yokai.","thumbnail":"https://image.tmdb.org/t/p/w300/cYrBwL3kbi7YnYGYBSs91XnsdXw.jpg"},{"title":"I racconti notturni delle spade mistiche ~Lama volante~","episodeNumber":15,"sourceEpisodeNumber":15,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"16614","scope":"R","episodeNumbers":[15]},{"provider":"anilist","id":"143598","episodeNumbers":[15]},{"provider":"mal","id":"49778","episodeNumbers":[15]},{"provider":"tmdb_show","id":"133154","scope":"s1","seasonNumber":1,"episodeNumbers":[15]},{"provider":"tvdb_show","id":"442540","scope":"s1","seasonNumber":1,"episodeNumbers":[15]}],"link":"99580","synopsis":"Naotsugu racconta a Jin'ya di un uomo che ha ucciso la moglie perché apparentemente manovrato da una spada forgiata con il sangue di un demone. Il ronin è incuriosito dalla storia e insieme i due visitano la villa di Hatakeyama Yasuhide, il vassallo di Aizu per cui lavorava l'assassino, che propone a Jin'ya di mettersi al suo servizio per il futuro della nazione.","thumbnail":"https://image.tmdb.org/t/p/w300/tLTgdVZ5VfgdPzPad0TkKWdB113.jpg"},{"title":"Le ragioni dell'amanojaku","episodeNumber":16,"sourceEpisodeNumber":16,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"16614","scope":"R","episodeNumbers":[16]},{"provider":"anilist","id":"143598","episodeNumbers":[16]},{"provider":"mal","id":"49778","episodeNumbers":[16]},{"provider":"tmdb_show","id":"133154","scope":"s1","seasonNumber":1,"episodeNumbers":[16]},{"provider":"tvdb_show","id":"442540","scope":"s1","seasonNumber":1,"episodeNumbers":[16]}],"link":"99722","synopsis":"Seguendo le voci su un demone mangiauomini, Jin'ya visita il tempio Mizuho dove in passato ha abbattuto il demone che divorava le donne della città. Quando il ronin torna al ristorante di soba trova ad aspettarlo sua moglie Yunagi con la figlia ancora in fasce.","thumbnail":"https://image.tmdb.org/t/p/w300/h1z9kLtWgz7yTJcjW2fatfK4t4f.jpg"},{"title":"Dove conduce la spada","episodeNumber":17,"sourceEpisodeNumber":17,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"16614","scope":"R","episodeNumbers":[17]},{"provider":"anilist","id":"143598","episodeNumbers":[17]},{"provider":"mal","id":"49778","episodeNumbers":[17]},{"provider":"tmdb_show","id":"133154","scope":"s1","seasonNumber":1,"episodeNumbers":[17]},{"provider":"tvdb_show","id":"442540","scope":"s1","seasonNumber":1,"episodeNumbers":[17]}],"link":"99863","synopsis":"Jin'ya si sta abituando alla nuova vita con la figlia adottiva Nomari, ma riceve una visita da Hatekeyama che gli chiede di occuparsi di un demone al suo servizio che ha iniziato a uccidere indiscriminatamente anche persone innocenti. Dopo un breve momento per analizzare la situazione, il ronin si appresta ad affrontare un avversario che cambierà la sua vita per sempre.","thumbnail":"https://image.tmdb.org/t/p/w300/bt5Bx5YZeyZ7ba9CC5LC8TANhPt.jpg"},{"title":"Due chiacchiere bevendo il tè","episodeNumber":18,"sourceEpisodeNumber":18,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"16614","scope":"R","episodeNumbers":[18]},{"provider":"anilist","id":"143598","episodeNumbers":[18]},{"provider":"mal","id":"49778","episodeNumbers":[18]},{"provider":"tmdb_show","id":"133154","scope":"s1","seasonNumber":1,"episodeNumbers":[18]},{"provider":"tvdb_show","id":"442540","scope":"s1","seasonNumber":1,"episodeNumbers":[18]}],"link":"100083","synopsis":"Jin'ya riceve la visita di Akitsu Somegoro che è passato per chiacchierare un po' e portargli un hira-natsume, un contenitore per il matcha in polvere utilizzato nella cerimonia del tè. Dato che nessuno dei due sa come preparare il tè, il ronin porta l'artigiano a casa di Naotsugu che vuole sapere com'è la situazione a Kyoto durante questo periodo turbolento.","thumbnail":"https://image.tmdb.org/t/p/w300/1h1hpiAT97pLhHHqdgF31vYsAEs.jpg"},{"title":"Tutto scorre","episodeNumber":19,"sourceEpisodeNumber":19,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"16614","scope":"R","episodeNumbers":[19]},{"provider":"anilist","id":"143598","episodeNumbers":[19]},{"provider":"mal","id":"49778","episodeNumbers":[19]},{"provider":"tmdb_show","id":"133154","scope":"s1","seasonNumber":1,"episodeNumbers":[19]},{"provider":"tvdb_show","id":"442540","scope":"s1","seasonNumber":1,"episodeNumbers":[19]}],"link":"100239","synopsis":"Il Giappone si trova alla vigilia di grandi cambiamenti e Naotsugu, che ha perso ogni fiducia nello shogunato, vuole prendere parte agli scontri che definiranno il futuro della nazione, così chiede a Jin'ya di dargli lezioni pratiche con la spada. Tuttavia, proprio come il Paese, anche la vita del ronin andrà incontro a cambiamenti improvvisi.","thumbnail":"https://image.tmdb.org/t/p/w300/n1omX3BtYEMeC1gyFWixpRI1HZa.jpg"},{"title":"Desiderio (prima parte)","episodeNumber":20,"sourceEpisodeNumber":20,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"16614","scope":"R","episodeNumbers":[20]},{"provider":"anilist","id":"143598","episodeNumbers":[20]},{"provider":"mal","id":"49778","episodeNumbers":[20]},{"provider":"tmdb_show","id":"133154","scope":"s1","seasonNumber":1,"episodeNumbers":[20]},{"provider":"tvdb_show","id":"442540","scope":"s1","seasonNumber":1,"episodeNumbers":[20]}],"link":"100514","synopsis":"Dopo aver rivelato la sua identità davanti agli abitanti della città, Jin'ya si rifugia nel tempio dove in passato ha trovato la piccola Nomari, ma viene presto trovato da Ofuu che è in pensiero per lui. Nel frattempo, Tsuchiura ha riferito il fallimento della missione ad Hatakeyama, che invece di punirlo è soddisfatto e decide di inviarlo a Kyoto con un gruppo di demoni.","thumbnail":"https://image.tmdb.org/t/p/w300/nxjaC4Hz1VlCsIc0wPil9kaE2y2.jpg"},{"title":"Desiderio (seconda parte)","episodeNumber":21,"sourceEpisodeNumber":21,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"16614","scope":"R","episodeNumbers":[21]},{"provider":"anilist","id":"143598","episodeNumbers":[21]},{"provider":"mal","id":"49778","episodeNumbers":[21]},{"provider":"tmdb_show","id":"133154","scope":"s1","seasonNumber":1,"episodeNumbers":[21]},{"provider":"tvdb_show","id":"442540","scope":"s1","seasonNumber":1,"episodeNumbers":[21]}],"link":"100722","synopsis":"Cercando di assorbire Tsuchiura, Jin'ya vede i ricordi dell'avversario, ma anche il possente demone ha una visione del passato del ronin e capisce che i due sono più simili di quanto sembra. Tuttavia, nessuno dei due può tirarsi indietro dallo scontro finché non avrà sconfitto il nemico. Nel frattempo Ofuu e Nomari aspettano preoccupate il ritorno di Jin'ya nel ristorante di soba.","thumbnail":"https://image.tmdb.org/t/p/w300/X1L9fdgmlDrWP2SXWdkyx5aJ4X.jpg"},{"title":"Futari-shizuka","episodeNumber":22,"sourceEpisodeNumber":22,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"16614","scope":"R","episodeNumbers":[22]},{"provider":"anilist","id":"143598","episodeNumbers":[22]},{"provider":"mal","id":"49778","episodeNumbers":[22]},{"provider":"tmdb_show","id":"133154","scope":"s1","seasonNumber":1,"episodeNumbers":[22]},{"provider":"tvdb_show","id":"442540","scope":"s1","seasonNumber":1,"episodeNumbers":[22]}],"link":"101060","synopsis":"I tempi cambiano, Jin'ya e Nomari si sono stabiliti a Kyoto ormai da cinque anni e il ronin ora gestisce un ristorante che serve la soba. Tuttavia, la minaccia dei demoni non è ancora passata e ogni notte Jin'ya esce per dare la caccia a quelli che minacciano la tranquillità della città. Un giorno, lo spadaccino riceve la visita di Akitsu che gli presenta una cliente con un incarico per lui.","thumbnail":"https://image.tmdb.org/t/p/w300/piNpkRbn33c7mb1sJzaCa6p9iYC.jpg"},{"title":"L'angelo delle mele caramellate (prima parte)","episodeNumber":23,"sourceEpisodeNumber":23,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"16614","scope":"R","episodeNumbers":[23]},{"provider":"anilist","id":"143598","episodeNumbers":[23]},{"provider":"mal","id":"49778","episodeNumbers":[23]},{"provider":"tmdb_show","id":"133154","scope":"s1","seasonNumber":1,"episodeNumbers":[23]},{"provider":"tvdb_show","id":"442540","scope":"s1","seasonNumber":1,"episodeNumbers":[23]}],"link":"101443","synopsis":"Akitsu Somegoro racconta a Jin'ya di una leggenda riguardante un angelo che si tramanda nel santuario vicino a dove si trova il ristorante e di uno specchio che collegherebbe cielo e terra. Quando il demone va a indagare sul posto, purtroppo non gli danno possibilità di vedere lo specchio, ma nel bosco incontra una ragazza smarrita che sembra conoscerlo bene.","thumbnail":"https://image.tmdb.org/t/p/w300/lUWheK7cbSmiI9F7ev0nnGawYwn.jpg"},{"title":"L'angelo delle mele caramellate (seconda parte)","episodeNumber":24,"sourceEpisodeNumber":24,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"16614","scope":"R","episodeNumbers":[24]},{"provider":"anilist","id":"143598","episodeNumbers":[24]},{"provider":"mal","id":"49778","episodeNumbers":[24]},{"provider":"tmdb_show","id":"133154","scope":"s1","seasonNumber":1,"episodeNumbers":[24]},{"provider":"tvdb_show","id":"442540","scope":"s1","seasonNumber":1,"episodeNumbers":[24]}],"link":"101549","synopsis":"Kaoru viene trasportata all'improvviso nel passato dove incontra Jin'ya, ma decide di nascondere la propria identità per paura che ci siano ripercussioni sul futuro. Nonostante la situazione sospetta, il demone decide di ospitare a casa sua la ragazza e raccogliere informazioni al vicino santuario su come poterla far tornare da dove proviene.","thumbnail":"https://image.tmdb.org/t/p/w300/cb1BRcwddAKIr5lgpizNcEhyOJC.jpg"}],"sourceIds":{"anilistId":143598,"malId":49778},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-29T07:54:59Z","sourceDescriptors":["anilist:143598","mal:49778"],"imdbSource":"plexanibridge-v2","targets":[{"provider":"anidb","id":"16614","scope":"R","ranges":{"1-24":"1-24"}},{"provider":"anilist","id":"143598","ranges":{"1-24":"1-24"}},{"provider":"mal","id":"49778","ranges":{"1-24":"1-24"}},{"provider":"tmdb_show","id":"133154","scope":"s1","ranges":{"1-24":"1-24"}},{"provider":"tvdb_show","id":"442540","scope":"s1","ranges":{"1-24":"1-24"}}]},"sou