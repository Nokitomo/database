{"id":4614,"path":"/anime/4614-the-perfect-insider","linkSchemaVersion":2,"updatedAt":"2026-10-29T21:28:37.036Z","info":{"title":"The Perfect Insider","synopsis":"Sohei Saikawa è un a membro del Saikawa Research Lab. Durante una vacanza organizzata dal laboratorio di ricerca, incontra Moe Nishinosono, la figlia del suo mentore, poiché la ragazza si è unita al gruppo del protagonista, anche se non lavora presso i laboratori. I due trovano un cadavere e finiscono per essere coinvolti nelle investigazioni di un misterioso caso di omicidi seriali.","image":"https://image.tmdb.org/t/p/original/3mH6zXHuNKxJNLvV0X01G8pf5kx.jpg","poster":"https://image.tmdb.org/t/p/original/qsgMEPV85QBPrnDZJN43o9EbnOE.jpg","logo":"https://image.tmdb.org/t/p/original/niLUtlxjej5xktRvb2RKJKVD5RU.png","background":"https://image.tmdb.org/t/p/original/3mH6zXHuNKxJNLvV0X01G8pf5kx.jpg","trailers":["https://www.youtube.com/watch?v=nmT4jMKAQhk"],"imdbId":"tt5247480","type":"series","tags":["TV","Terminato","Autunno","2015"],"tagKeys":{"TV":"TV","Terminato":"Completed","Autunno":"Autumn"},"genres":["Drama","Mystery","Psychological","Sci-fi","Thriller"],"rating":"7.4","studio":"A-1 Pictures","episodesCount":11,"extra":{"ids":{"malId":28621,"anilistId":21190,"crunchyId":null,"disneyId":null,"netflixId":null,"primeId":null,"anilistIds":[21190],"malIds":[28621],"anidbIds":[10950],"imdbMovieIds":[],"imdbShowIds":[],"tmdbMovieIds":[],"tmdbShowIds":[70292],"tvdbMovieIds":[],"tvdbShowIds":[296072]},"stats":{"scoreRaw":"7.41","favorites":29,"members":340,"views":19019,"episodesCountRaw":11,"episodesLength":24},"flags":{"dub":0,"alwaysHome":0},"meta":{"day":"Giovedì","season":"Autunno","status":"Terminato","type":"TV","createdAt":"2023-05-03 13:41:35","userId":2},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-29T07:54:59Z","sourceDescriptors":["anilist:21190","mal:28621"],"imdbSource":"plexanibridge-v2","targets":[{"provider":"anidb","id":"10950","scope":"R","ranges":{"1-11