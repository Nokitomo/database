":[{"source":"tmdb","url":"https://image.tmdb.org/t/p/original/5alskNru0lAl9ao2Tz0WIznu7nf.jpg"},{"source":"cinemeta","url":"https://images.metahub.space/background/medium/tt5839698/img"},{"source":"anizip","url":"https://artworks.thetvdb.com/banners/fanart/original/309208-1.jpg"},{"source":"provider","url":"https://img.animeunity.co/anime/21643-TehjY9mfzzy1.jpg"},{"source":"anilist","url":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/21643-TehjY9mfzzy1.jpg"}]}},"related":[{"title":"The Morose Mononokean","link":"/anime/4816-the-morose-mononokean","image":"https://img.animeunity.co/anime/bx21643-1zrEKuiV3ASs.png","type":"TV","year":"2016","dubStatus":"subbed","dubStatusKey":"Subbed","variants":[{"status":"subbed","statusKey":"Subbed","title":"The Morose Mononokean","link":"/anime/4816-the-morose-mononokean","image":"https://img.animeunity.co/anime/bx21643-1zrEKuiV3ASs.png"}]},{"title":"The Morose Mononokean II","link":"/anime/4817-the-morose-mononokean-ii","image":"https://img.animeunity.co/anime/bx102949-sWYUrBmfCQKc.jpg","type":"TV","year":"2019","dubStatus":"subbed","dubStatusKey":"Subbed","variants":[{"status":"subbed","statusKey":"Subbed","title":"The Morose Mononokean II","link":"/anime/4817-the-morose-mononokean-ii","image":"https://img.animeunity.co/anime/bx102949-sWYUrBmfCQKc.jpg"}]}],"linkList":[{"title":"Episodes 1-13","titleKey":"Episodes {{start}}-{{end}}","titleParams":{"start":1,"end":13},"availabilityStatus":"available","episodesLink":"4816|1|13"}]},"episodes":[{"title":"Episodio 1","episodeNumber":1,"sourceEpisodeNumber":1,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"11924","scope":"R","episodeNumbers":[1]},{"provider":"anilist","id":"21643","episodeNumbers":[1]},{"provider":"mal","id":"32696","episodeNumbers":[1]},{"provider":"tmdb_show","id":"65956","scope":"s1","seasonNumber":1,"episodeNumbers":[1]},{"provider":"tvdb_show","id":"309208","scope":"s1","seasonNumber":1,"episodeNumbers":[1]}],"link":"73369","synopsis":"The day before he begins attending high school, Ashiya Hanae becomes possessed by a strange fuzzy yokai. Being possessed causes him to fall ill, and while spending the start of his high school life repeatedly making trips to the nurse's office, he comes across the contact information of the Mononokean, which specializes in exorcising yokai, and decides to call them. When Ashiya finally visits the Mononokean, he meets the morose master Abeno Haruitsuki.","thumbnail":"https://image.tmdb.org/t/p/w300/A2UWubK9nNAwV1KO5SekdiSCX65.jpg"},{"title":"Episodio 2","episodeNumber":2,"sourceEpisodeNumber":2,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"11924","scope":"R","episodeNumbers":[2]},{"provider":"anilist","id":"21643","episodeNumbers":[2]},{"provider":"mal","id":"32696","episodeNumbers":[2]},{"provider":"tmdb_show","id":"65956","scope":"s1","seasonNumber":1,"episodeNumbers":[2]},{"provider":"tvdb_show","id":"309208","scope":"s1","seasonNumber":1,"episodeNumbers":[2]}],"link":"73370","synopsis":"When Ashiya begins working part time at the Mononokean, the master Abeno impresses upon him that he should pretend not to see any yokai other than the Mononokean's clients. However, the kind-hearted Ashiya is unable to keep his word, and the yokai won't leave him alone. Based on their surprising strength and numbers, Abeno believes there must be a powerful demon serving as their leader.","thumbnail":"https://image.tmdb.org/t/p/w300/7eOHqar2vkKJDSMpvEbvjHU3dFJ.jpg"},{"title":"Episodio 3","episodeNumber":3,"sourceEpisodeNumber":3,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"11924","scope":"R","episodeNumbers":[3]},{"provider":"anilist","id":"21643","episodeNumbers":[3]},{"provider":"mal","id":"32696","episodeNumbers":[3]},{"provider":"tmdb_show","id":"65956","scope":"s1","seasonNumber":1,"episodeNumbers":[3]},{"provider":"tvdb_show","id":"309208","scope":"s1","seasonNumber":1,"episodeNumbers":[3]}],"link":"73371","synopsis":"After making friends with his classmates Saga and Fushimi, Ashiya believes the high school life he dreamed of may finally be his. But before he has the chance to enjoy his new life, he's instructed to go to a certain temple alone to find and return a yokai's lost possession. At the temple, Ashiya meets a girl named Fujiwara Zenko, and it seems the lost possession in question has something to do with Zenko's father, the head priest...","thumbnail":"https://image.tmdb.org/t/p/w300/mTDmetCYzJvLDg3vCQFrDsOeezF.jpg"},{"title":"Episodio 4","episodeNumber":4,"sourceEpisodeNumber":4,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"11924","scope":"R","episodeNumbers":[4]},{"provider":"anilist","id":"21643","episodeNumbers":[4]},{"provider":"mal","id":"32696","episodeNumbers":[4]},{"provider":"tmdb_show","id":"65956","scope":"s1","seasonNumber":1,"episodeNumbers":[4]},{"provider":"tvdb_show","id":"309208","scope":"s1","seasonNumber":1,"episodeNumbers":[4]}],"link":"73372","synopsis":"When Ashiya hears that Abeno will be going to a pharmacist called the “Kiyakudo” in the Underworld, he asks to go with him. Though Abeno is reluctant to bring a human to the Underworld, he relents when the Mononokean suggests that Ashiya accompany him. Concerned for Ashiya, Abeno forbids him to travel in the Underworld alone, but Ashiya finds himself unable to keep his word again...","thumbnail":"https://image.tmdb.org/t/p/w300/7YKeXYkLfUxaN1ZSlyXhsoTDUTb.jpg"},{"title":"Episodio 5","episodeNumber":5,"sourceEpisodeNumber":5,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"11924","scope":"R","episodeNumbers":[5]},{"provider":"anilist","id":"21643","episodeNumbers":[5]},{"provider":"mal","id":"32696","episodeNumbers":[5]},{"provider":"tmdb_show","id":"65956","scope":"s1","seasonNumber":1,"episodeNumbers":[5]},{"provider":"tvdb_show","id":"309208","scope":"s1","seasonNumber":1,"episodeNumbers":[5]}],"link":"73373","synopsis":"The Legislator, one of three influential figures of the Underworld, issues a rule that Abeno must bring Ashiya to see him. Unable to defy the Legislator's rules, Abeno is forced to pay a visit to him with Ashiya in tow. As Abeno hired Ashiya without informing the Legislator, he now seeks to determine for himself if Ashiya is truly worthy of being an employee of the Mononokean. What will the Legislator conclude?","thumbnail":"https://image.tmdb.org/t/p/w300/tqqoA5Y2ke6evQxyLFUjbaoI36e.jpg"},{"title":"Episodio 6","episodeNumber":6,"sourceEpisodeNumber":6,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"11924","scope":"R","episodeNumbers":[6]},{"provider":"anilist","id":"21643","episodeNumbers":[6]},{"provider":"mal","id":"32696","episodeNumbers":[6]},{"provider":"tmdb_show","id":"65956","scope":"s1","seasonNumber":1,"episodeNumbers":[6]},{"provider":"tvdb_show","id":"309208","scope":"s1","seasonNumber":1,"episodeNumbers":[6]}],"link":"73374","synopsis":"Abeno is hired by a certain yokai to find a human woman's missing ring and return it to her. Unable to find the ring on his own, he gets Ashiya to help him look for it. During their search, Ashiya demonstrates a surprising talent. The ring is found, but when the time comes to return the ring to the woman, Ashiya and Abeno disagree over how they should return the lost ring to the woman","thumbnail":"https://image.tmdb.org/t/p/w300/togYuhO0NmyPHmBjcKIlpitaewu.jpg"},{"title":"Episodio 7","episodeNumber":7,"sourceEpisodeNumber":7,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"11924","scope":"R","episodeNumbers":[7]},{"provider":"anilist","id":"21643","episodeNumbers":[7]},{"provider":"mal","id":"32696","episodeNumbers":[7]},{"provider":"tmdb_show","id":"65956","scope":"s1","seasonNumber":1,"episodeNumbers":[7]},{"provider":"tvdb_show","id":"309208","scope":"s1","seasonNumber":1,"episodeNumbers":[7]}],"link":"73375","synopsis":"When Ashiya and Abeno see Zenko at school again, she asks them for help with a particular yokai. Zenko was bitten by a strange dog-like animal a few days prior. However, ordinary people can't see the bite mark, and Zenko, who was previously unable to see yokai, has begun seeing strange things. While listening to her story, a fox yokai suddenly appears behind Ashiya and Abeno. The yokai appears to recognize Abeno, but Abeno doesn't recognize him at all...","thumbnail":"https://image.tmdb.org/t/p/w300/shw2oBWXe4tmRL1T47QzdTqsKxq.jpg"},{"title":"Episodio 8","episodeNumber":8,"sourceEpisodeNumber":8,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"11924","scope":"R","episodeNumbers":[8]},{"provider":"anilist","id":"21643","episodeNumbers":[8]},{"provider":"mal","id":"32696","episodeNumbers":[8]},{"provider":"tmdb_show","id":"65956","scope":"s1","seasonNumber":1,"episodeNumbers":[8]},{"provider":"tvdb_show","id":"309208","scope":"s1","seasonNumber":1,"episodeNumbers":[8]}],"link":"73376","synopsis":"Zenko arranges for Yahiko to help around the temple while he stays with her. Ashiya is relieved, but he soon runs into another yokai. The bird yokai Jomatsu is concerned for his heartbroken mistress Princess Anmo, who withdrew into an egg shell she made and hasn't come out for a long time. Jomatsu has been searching for the Mononokean so he can return to the Underworld with Princess Anmo still inside her egg.","thumbnail":"https://image.tmdb.org/t/p/w300/kaNkSxFlP7EjeBTG0IqjvhzBW4l.jpg"},{"title":"Episodio 9","episodeNumber":9,"sourceEpisodeNumber":9,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"11924","scope":"R","episodeNumbers":[9]},{"provider":"anilist","id":"21643","episodeNumbers":[9]},{"provider":"mal","id":"32696","episodeNumbers":[9]},{"provider":"tmdb_show","id":"65956","scope":"s1","seasonNumber":1,"episodeNumbers":[9]},{"provider":"tvdb_show","id":"309208","scope":"s1","seasonNumber":1,"episodeNumbers":[9]}],"link":"73377","synopsis":"When Abeno is hired to exorcise a yokai by a human, he unenthusiastically heads to the client's house with Ashiya and Fuzzy. The girl who hired him is unable to see yokai but is interested in the occult and seems very interested in their work. Abeno asks Ashiya to watch the door while he works so nobody bothers him, but the girl's mother, who doesn't believe in the supernatural, begins asking Ashiya some nosy questions.","thumbnail":"https://image.tmdb.org/t/p/w300/9nNwD0bRgeH9yxCqwPr3AW5d5Jd.jpg"},{"title":"Episodio 10","episodeNumber":10,"sourceEpisodeNumber":10,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"11924","scope":"R","episodeNumbers":[10]},{"provider":"anilist","id":"21643","episodeNumbers":[10]},{"provider":"mal","id":"32696","episodeNumbers":[10]},{"provider":"tmdb_show","id":"65956","scope":"s1","seasonNumber":1,"episodeNumbers":[10]},{"provider":"tvdb_show","id":"309208","scope":"s1","seasonNumber":1,"episodeNumbers":[10]}],"link":"73378","synopsis":"When Ashiya and Abeno smell a yokai on the potatoes Yahiko has been sneaking, they head to the farm where they were grown. There they encounter a yokai calling himself Nobou. Nobou has been attempting to leave the farm, but each time he does, he is enveloped in a strange smoke, forced to witness the events of his past, and returns to where he started. Nobou asked to be exorcised so he can leave the farm, but Abeno notices something about the situation.","thumbnail":"https://image.tmdb.org/t/p/w300/s24uH7XDdiWt1Kd0e9vToSHvhXL.jpg"},{"title":"Episodio 11","episodeNumber":11,"sourceEpisodeNumber":11,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"11924","scope":"R","episodeNumbers":[11]},{"provider":"anilist","id":"21643","episodeNumbers":[11]},{"provider":"mal","id":"32696","episodeNumbers":[11]},{"provider":"tmdb_show","id":"65956","scope":"s1","seasonNumber":1,"episodeNumbers":[11]},{"provider":"tvdb_show","id":"309208","scope":"s1","seasonNumber":1,"episodeNumbers":[11]}],"link":"73379","synopsis":"A yokai worshipped as a kami by humans and known as Okina-sama to other yokai comes to the Mononokean with a request: to send the blind yokai Tomori back to the Underworld. After hearing Okina's story, Abeno and Ashiya immediately head to see Tomori. However, upon seeing how Tomori longs to once again see the sights of the Underworld, he tries to see what he can do before Tomori is returned to the Underworld...","thumbnail":"https://image.tmdb.org/t/p/w300/kgmU24QZIrFn6MX0buA3W0a8CFW.jpg"},{"title":"Episodio 12","episodeNumber":12,"sourceEpisodeNumber":12,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"11924","scope":"R","episodeNumbers":[12]},{"provider":"anilist","id":"21643","episodeNumbers":[12]},{"provider":"mal","id":"32696","episodeNumbers":[12]},{"provider":"tmdb_show","id":"65956","scope":"s1","seasonNumber":1,"episodeNumbers":[12]},{"provider":"tvdb_show","id":"309208","scope":"s1","seasonNumber":1,"episodeNumbers":[12]}],"link":"73381","synopsis":"Abeno visits the Legislator to inform him that Ashiya is no longer working for the Mononokean. As Abeno rarely comes to visit without his presence being requested, the curious Legislator asks why, but when he hears what Abeno has to say...? Meanwhile, Ashiya stops by the Kiyakudo when he hears from Shizuku, where he runs into the yokai Big Boss Scree, a yokai he previously exorcised, and his children. When they hear that Ashiya is in trouble...?","thumbnail":"https://image.tmdb.org/t/p/w300/mAnPvd88Judel0kWjgk3u96KLMR.jpg"},{"title":"Episodio 13","episodeNumber":13,"sourceEpisodeNumber":13,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"11924","scope":"R","episodeNumbers":[13]},{"provider":"anilist","id":"21643","episodeNumbers":[13]},{"provider":"mal","id":"32696","episodeNumbers":[13]},{"provider":"tmdb_show","id":"65956","scope":"s1","seasonNumber":1,"episodeNumbers":[13]},{"provider":"tvdb_show","id":"309208","scope":"s1","seasonNumber":1,"episodeNumbers":[13]}],"link":"73380","synopsis":"Reunited with the yokai he and Ashiya exorcised together, Abeno realizes the Mononokean still needs Ashiya. Abeno suddenly misses him, and with the help of the yokai, he decides to give his idea a try. Meanwhile, Ashiya wonders if the reason Abeno has been absent from school so much is because he's busy exorcising yokai and decides to check out the shrine in the mountains Yahiko mentioned.","thumbnail":"https://image.tmdb.org/t/p/w300/fWiKeVPFiIrVLItzYcxHusVhsZx.jpg"}],"sourceIds":{"anilistId":21643,"malId":32696},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-29T07:54:59Z","sourceDescriptors":["anilist:21643","mal:32696"],"targets":[{"provider":"anidb","id":"11924","scope":"R","ranges":{"1-13":"1-13"}},{"provider":"anilist","id":"21643","ranges":{"1-13":"1-13"}},{"provider":"mal","id":"32696","ranges":{"1-13":"1-13"}},{"provider":"tmdb_show","id":"65956","scope":"s1","ranges":{"1-13":"1-13"}},{"provider":"tvdb_show","id":"309208","scope":"s1","ranges":{"1-13":"1-13"}}]},"sourceMetadata":{"info":{"id":4816,"title":"Fukigen na Mononokean","title_eng":"The Morose Mononokean","slug":"the-morose-mononokean","plot":"Ashiya ha passato i primi 7 giorni della sua vita scolastica alle superiori in infermeria per colpa di uno yokai che gli si è attaccato addosso. Disperato finisce col chiedere aiuto al proprietario di una piccola sala da tè chiamata “Mononokean”. Seguiremo una serie di storie misteriose, che coinvolgono lo scontroso proprietario del Mononokean, egli guida gli yokai, che vagano in questo modo, verso l’altro mondo.","type":"TV","status":"Terminato","date":"2016","studio":"Studio Signpost","dub":0,"mal_id":32696,"anilist_id":21643,"imageurl":"https://img.animeunity.co/anime/bx21643-1zrEKuiV3ASs.png","imageurl_cover":"https://img.animeunity.co/anime/21643-TehjY9mfzzy1.jpg","cover":null,"score":"7.68","episodes_count":13,"genres":["Comedy","Supernatural"],"related":[{"id":4816,"title":"Fukigen na Mononokean","title_eng":"The Morose Mononokean","type":"TV","date":"2016","episodes_count":13},{"id":4817,"title":"Fukigen na Mon