ways_home":1,"members":1141,"cover":"https://img.animeworld.so/copertine/-CY4o.png","anilist_id":178533,"season":"Autunno","title_it":null,"mal_id":59145,"crunchy_id":null,"netflix_id":"81171925","prime_id":null,"disney_id":null,"genres":[{"id":51,"name":"Action","pivot":{"anime_id":5710,"genre_id":51}},{"id":37,"name":"Comedy","pivot":{"anime_id":5710,"genre_id":37}},{"id":5,"name":"Ecchi","pivot":{"anime_id":5710,"genre_id":5}},{"id":31,"name":"Martial Arts","pivot":{"anime_id":5710,"genre_id":31}},{"id":17,"name":"Romance","pivot":{"anime_id":5710,"genre_id":17}},{"id":33,"name":"School","pivot":{"anime_id":5710,"genre_id":33}},{"id":34,"name":"Shounen","pivot":{"anime_id":5710,"genre_id":34}}],"related":[{"id":1665,"user_id":2,"title":"Ranma 1/2","imageurl":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/bx210-qgahLDYT0t9b.png","plot":"Ranma Saotome (16 anni) è un giovane esperto di arti marziali afflitto da una singolare maledizione: durante un allenamento in Cina, lui e suo padre sono caduti nelle Sorgenti Maledette di Jusenkyo. Chiunque cada in una di queste sorgenti, non appena entra a contatto con l'acqua fredda, è destinato a trasformarsi nell'animale o nella persona che ci annegò centinaia o migliaia di anni prima; per ritornare al proprio aspetto bisogna bagnarsi con dell'acqua calda. Genma Saotome, il padre di Ranma, cade nella sorgente in cui era annegato un panda gigante, mentre Ranma in quella in cui era annegata una ragazza. Ranma è inoltre affetto da una debilitante fobia dei gatti che lo rende in grado di diventare, anche se solo mentalmente, un gatto egli stesso nel comportamento e nelle movenze (ma non nell'aspetto).","date":"1989","episodes_count":161,"episodes_length":24,"author":" ","created_at":"2019-10-12 20:49:30","status":"Terminato","imageurl_cover":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/210-XD1uaTCNg8th.jpg","type":"TV","slug":"ranma-ita","title_eng":"Ranma ½ (ITA)","day":"Indeterminato","favorites":621,"score":"8.64","visite":2684058,"studio":"Studio DEEN","dub":1,"always_home":0,"members":2267,"cover":null,"anilist_id":210,"season":"Primavera","title_it":null,"mal_id":210,"crunchy_id":null,"netflix_id":null,"prime_id":null,"disney_id":null,"pivot":{"anime_id":5710,"related_id":1665,"number":1}},{"id":6094,"user_id":2,"title":"Ranma ½: Chuugoku Nekonron Daikessen! Okite Yaburi no Gekitou-hen!! (ITA)","imageurl":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/bx418-O6mu6r1k40jt.png","plot":"Sembra una giornata normale nella palestra Tendo, fino al momento in cui arriva una graziosa ragazza cinese di nome Lychee in compagnia del suo elefante Jasmine. La ragazza è alla ricerca di un misterioso \"rotolo della fortuna\" affidata ad Happosai, ultimo documento in cui viene spiegata una non meglio definita \"tecnica definitiva\". Oltre a Lychee sulle tracce del rotolo però ci sono anche i valorosi guerrieri di Nekonron, guidati dal fortissimo principe Kirin. Tuttavia Kirin si invaghisce di Akane e la rapisce per convincerla a sposarlo. Ranma e i suoi amici partono per soccorrere la ragazza, e nel frattempo aiutare Lychee nel ritrovare la misteriosa pergamena.","date":"1991","episodes_count":1,"episodes_length":74,"author":" ","created_at":"2025-01-31 15:53:57","status":"Terminato","imageurl_cover":"","type":"Movie","slug":"ranma-le-sette-divinita-della-fortuna-ita","title_eng":"Ranma ½ - Le sette divinità della fortuna (ITA)","day":"Indeterminato","favorites":38,"score":"8.70","visite":8670,"studio":"Studio DEEN","dub":1,"always_home":0,"members":125,"cover":null,"anilist_id":418,"season":"Autunno","title_it":"Ranma ½: Big Trouble in Nekonron, China (ITA)","mal_id":418,"crunchy_id":null,"netflix_id":null,"prime_id":null,"disney_id":null,"pivot":{"anime_id":5710,"related_id":6094,"number":1}},{"id":6095,"user_id":2,"title":"Ranma ½: Kessen Tougenkyou! Hanayome wo Torimodose! (ITA)","imageurl":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/bx792-38rjJ2pXILwU.png","plot":"Una gita in barca organizzata da Tatewaki Kuno, in cui si erano infiltrati Ranma e tutti i suoi amici, si risolve in un naufragio in un'isola sperduta in mezzo all'oceano. Qui le ragazze cominciano a sparire una per volta, rapite dai misteriosi abitanti di un'isoletta vicina. A organizzare i rapimenti è il giovanissimo Toma, che in preda alla solitudine ha deciso di organizzare una specie di concorso fra donne, la cui vincitrice diverrà sua moglie. Ranma e tutti gli altri devono affrontare gli emissari di Toma, per riuscire a salvare le proprie ragazze.","date":"1992","episodes_count":1,"episodes_length":60,"author":" ","created_at":"2025-01-31 15:55:34","status":"Terminato","imageurl_cover":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/792-0FEkS11MeEd6.jpg","type":"Movie","slug":"ranma-la-sposa-dellisola-delle-illusioni-ita","title_eng":"Ranma ½: La sposa dell'isola delle illusioni (ITA)","day":"Indeterminato","favorites":36,"score":"9.10","visite":7581,"studio":"Studio Deen","dub":1,"always_home":0,"members":113,"cover":null,"anilist_id":792,"season":"Estate","title_it":"Ranma ½: The Movie 2 - The Battle of Togenkyo: Rescue the Brides! (ITA)","mal_id":792,"crunchy_id":null,"netflix_id":null,"prime_id":null,"disney_id":null,"pivot":{"anime_id":5710,"related_id":6095,"number":1}},{"id":6091,"user_id":2,"title":null,"imageurl":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/1007-UPcDEzlonXK6.png","plot":"Episodi OVA della serie Ranma ½","date":"1993","episodes_count":6,"episodes_length":30,"author":" ","created_at":"2025-01-31 15:40:09","status":"Terminato","imageurl_cover":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/n1007-dJU6x9tFw9OD.jpg","type":"OVA","slug":"ranma-ova-ita","title_eng":"Ranma ½ OVA (ITA)","day":"Indeterminato","favorites":35,"score":"8.54","visite":22531,"studio":"Studio DEEN","dub":1,"always_home":0,"members":116,"cover":null,"anilist_id":1007,"season":"Estate","title_it":n