/206914-owssGq2CGhRZ.jpg"}]},"artworkFallbacks":{"logo":[{"source":"tmdb","url":"https://image.tmdb.org/t/p/original/7iNdA5c8yccZIAGIpCBwNEPD1OS.png"},{"source":"cinemeta","url":"https://images.metahub.space/logo/medium/tt40548519/img"},{"source":"anizip","url":"https://artworks.thetvdb.com/banners/v4/series/473228/clearlogo/69dc501cd939e.png"}],"poster":[{"source":"tmdb","url":"https://image.tmdb.org/t/p/original/sM7zYE6xOmaNwC28LR7cEneAtuN.jpg"},{"source":"tvdb","url":"https://artworks.thetvdb.com/banners/v4/series/473228/posters/69d2c0d1415b3.jpg"},{"source":"provider","url":"https://img.animeunity.co/anime/bx206914-SHKX08LarRzB.jpg"},{"source":"cinemeta","url":"https://images.metahub.space/poster/small/tt40548519/img"},{"source":"anizip","url":"https://artworks.thetvdb.com/banners/v4/series/473228/posters/69d11a27b9417.jpg"},{"source":"anilist","url":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/large/bx206914-SHKX08LarRzB.jpg"}],"background":[{"source":"tmdb","url":"https://image.tmdb.org/t/p/original/5ar8gtdfMvxlQtBmOvgN4BzPSgy.jpg"},{"source":"cinemeta","url":"https://images.metahub.space/background/medium/tt40548519/img"},{"source":"tvdb","url":"https://artworks.thetvdb.com/banners/v4/series/473228/backgrounds/69d2c018c4a25.jpg"},{"source":"anizip","url":"https://artworks.thetvdb.com/banners/v4/series/473228/backgrounds/69ca411d2c50d.jpg"},{"source":"provider","url":"https://img.animeunity.co/anime/206914-owssGq2CGhRZ.jpg"},{"source":"anilist","url":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/206914-owssGq2CGhRZ.jpg"}]}},"related":[],"linkList":[{"title":"Episodes 1-12","titleKey":"Episodes {{start}}-{{end}}","titleParams":{"start":1,"end":12},"availabilityStatus":"available","episodesLink":"7518|1|12"}]},"episodes":[{"title":"Giuramento di Pace","episodeNumber":1,"sourceEpisodeNumber":1,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"19861","scope":"R","episodeNumbers":[1]},{"provider":"anilist","id":"206914","episodeNumbers":[1]},{"provider":"mal","id":"63375","episodeNumbers":[1]},{"provider":"tmdb_show","id":"312474","scope":"s1","seasonNumber":1,"episodeNumbers":[1]},{"provider":"tvdb_show","id":"473228","scope":"s1","seasonNumber":1,"episodeNumbers":[1]}],"link":"106278","synopsis":"Aoteru Misumi è un giovane che vive nella campagna di Ehime, a Yamato. Lavora come funzionario agricolo e conduce una vita tranquilla con la moglie Saki. Un giorno, arriva una processione a cavallo degna di un re. Sulla carrozza più sfarzosa viaggia nientedimeno che Denki Taira, Ministro degli Interni e vero governante di Yamato.","thumbnail":"https://image.tmdb.org/t/p/w300/6s3ccjClJaAgYEMNpAEKrjPypmM.jpg"},{"title":"L'arrivo a Osaka di Ao Teru","episodeNumber":2,"sourceEpisodeNumber":2,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"19861","scope":"R","episodeNumbers":[2]},{"provider":"anilist","id":"206914","episodeNumbers":[2]},{"provider":"mal","id":"63375","episodeNumbers":[2]},{"provider":"tmdb_show","id":"312474","scope":"s1","seasonNumber":1,"episodeNumbers":[2]},{"provider":"tvdb_show","id":"473228","scope":"s1","seasonNumber":1,"episodeNumbers":[2]}],"link":"106393","synopsis":"Perduto l'amore della sua vita, Aoteru è deciso a onorare la promessa di creare un mondo di pace. Va a Osaka per sostenere l'esame del Generale di Frontiera Mitsuhide Ryumon, sperando di servire sotto di lui. Al suo arrivo, trova un alloggio economico. Aoteru non avrà però riposo, poiché lì incontra subito un certo individuo.","thumbnail":"https://image.tmdb.org/t/p/w300/s3CIOGaLGso5yXE7XRG1QsOfCks.jpg"},{"title":"Toryumon","episodeNumber":3,"sourceEpisodeNumber":3,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"19861","scope":"R","episodeNumbers":[3]},{"provider":"anilist","id":"206914","episodeNumbers":[3]},{"provider":"mal","id":"63375","episodeNumbers":[3]},{"provider":"tmdb_show","id":"312474","scope":"s1","seasonNumber":1,"episodeNumbers":[3]},{"provider":"tvdb_show","id":"473228","scope":"s1","seasonNumber":1,"episodeNumbers":[3]}],"link":"106601","synopsis":"Aoteru e Yoshitsune Asama sostengono il Toryumon, l'esame necessario per servire sotto Ryumon. Le condizioni per superarlo sono semplici: i candidati devono metterlo in ginocchio. Non basta conoscere l'arte della guerra. Servirà anche ingegno per superare questa prova.","thumbnail":"https://image.tmdb.org/t/p/w300/A4qG93VTYXsBKSP2VwRALByaHEa.jpg"},{"title":"Consiglio di corte","episodeNumber":4,"sourceEpisodeNumber":4,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"19861","scope":"R","episodeNumbers":[4]},{"provider":"anilist","id":"206914","episodeNumbers":[4]},{"provider":"mal","id":"63375","episodeNumbers":[4]},{"provider":"tmdb_show","id":"312474","scope":"s1","seasonNumber":1,"episodeNumbers":[4]},{"provider":"tvdb_show","id":"473228","scope":"s1","seasonNumber":1,"episodeNumbers":[4]}],"link":"106690","synopsis":"Tre anni dopo aver passato il Toryumon, Aoteru si impegna a fondo sotto Ryumon per adempiere ai suoi doveri. Intanto Yamato invia una richiesta di resa incondizionata al vicino regno di Seii, indebolito dal rigido inverno. Nel Seii, le braci della rivolta vengono alimentate.","thumbnail":"https://image.tmdb.org/t/p/w300/4VkIjPNAQZv7XAhl4m2E0VvhPKm.jpg"},{"title":"Il Kanji Misumi","episodeNumber":5,"sourceEpisodeNumber":5,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"19861","scope":"R","episodeNumbers":[5]},{"provider":"anilist","id":"206914","episodeNumbers":[5]},{"provider":"mal","id":"63375","episodeNumbers":[5]},{"provider":"tmdb_show","id":"312474","scope":"s1","seasonNumber":1,"episodeNumbers":[5]},{"provider":"tvdb_show","id":"473228","scope":"s1","seasonNumber":1,"episodeNumbers":[5]}],"link":"106978","synopsis":"Una nuova dittatura prende il potere nel Seii quando Ohga Wajima propone di sottomettere Yamato con la forza. In una notte instaura il suo governo e proclama la sua determinazione. Con fascino e abilità politica conquista rapidamente il popolo, e nel Seii cresce l'impeto di lanciare una campagna contro Yamato.","thumbnail":"https://image.tmdb.org/t/p/w300/tJJmbGKL6hJ1sHbYUrTLP0wA5LY.jpg"},{"title":"Colpo di Stato al Seii","episodeNumber":6,"sourceEpisodeNumber":6,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"19861","scope":"R","episodeNumbers":[6]},{"provider":"anilist","id":"206914","episodeNumbers":[6]},{"provider":"mal","id":"63375","episodeNumbers":[6]},{"provider":"tmdb_show","id":"312474","scope":"s1","seasonNumber":1,"episodeNumbers":[6]},{"provider":"tvdb_show","id":"473228","scope":"s1","seasonNumber":1,"episodeNumbers":[6]}],"link":"107244","synopsis":"Tonotsugu Taira, erede di Denki Taira, riceve dall'Imperatore Fuji III l'ordine di recarsi a Kanazawa con Goh Sugoh, Generale dell'Ala Destra dell'Unità di Frontiera. Tonotsugu vede l'incarico con ottimismo, ma Sugoh teme che sia una trappola tesa dal Seii.","thumbnail":"https://image.tmdb.org/t/p/w300/keSGg8zg3TREzppo1p0Zn2esV6X.jpg"},{"title":"Dichiarazione d'intenti","episodeNumber":7,"sourceEpisodeNumber":7,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"19861","scope":"R","episodeNumbers":[7]},{"provider":"anilist","id":"206914","episodeNumbers":[7]},{"provider":"mal","id":"63375","episodeNumbers":[7]},{"provider":"tmdb_show","id":"312474","scope":"s1","seasonNumber":1,"episodeNumbers":[7]},{"provider":"tvdb_show","id":"473228","scope":"s1","seasonNumber":1,"episodeNumbers":[7]}],"link":"107462","synopsis":"Con l'assalto al Castello di Kuzuryu, le tensioni tra Seii e Yamato raggiungono il culmine. Avvertendo qualcosa di strano, l'esercito di Yamato guidato da Ryumon decide di fermare l'avanzata. Intanto gli uomini di Tonotsugu, già avanti, entrano nel Seii ignari dello scoppio della guerra e vengono accolti calorosamente da Muuton Nagao.","thumbnail":"https://image.tmdb.org/t/p/w300/ftr7C1Ho7DwGPG427DELehBjVNZ.jpg"},{"title":"Ferisciti per persuadere","episodeNumber":8,"sourceEpisodeNumber":8,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"19861","scope":"R","episodeNumbers":[8]},{"provider":"anilist","id":"206914","episodeNumbers":[8]},{"provider":"mal","id":"63375","episodeNumbers":[8]},{"provider":"tmdb_show","id":"312474","scope":"s1","seasonNumber":1,"episodeNumbers":[8]},{"provider":"tvdb_show","id":"473228","scope":"s1","seasonNumber":1,"episodeNumbers":[8]}],"link":"107667","synopsis":"Il blitz notturno di Muuton a Kanazawa fallisce, ma l'armata del Seii continua l'avanzata verso l'Unità del Generale di Frontiera. La battaglia decisiva tra Ohga e Ryumon si avvicina.","thumbnail":"https://image.tmdb.org/t/p/w300/8AKittjLZ1Y4g8SUu8zE647GbIS.jpg"},{"title":"Gli argomenti di Kaku","episodeNumber":9,"sourceEpisodeNumber":9,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"19861","scope":"R","episodeNumbers":[9]},{"provider":"anilist","id":"206914","episodeNumbers":[9]},{"provider":"mal","id":"63375","episodeNumbers":[9]},{"provider":"tmdb_show","id":"312474","scope":"s1","seasonNumber":1,"episodeNumbers":[9]},{"provider":"tvdb_show","id":"473228","scope":"s1","seasonNumber":1,"episodeNumbers":[9]}],"link":"107832","synopsis":"Lo scontro decisivo tra Ohga e Ryumon si conclude con la vittoria di quest'ultimo, ottenuta grazie alla \"Strategia del Forte Vuoto\", rendendo evidente a tutti la perdita d'autorità di Ohga. Privata del suo prestigio, Ohga si affida ai consigli del suo fidato stratega, Yayakichi Hei.","thumbnail":"https://image.tmdb.org/t/p/w300/2YyiWTgKWQedEXYoCSzPwUMkmIk.jpg"},{"title":"L'armata per il fronte","episodeNumber":10,"sourceEpisodeNumber":10,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"19861","scope":"R","episodeNumbers":[10]},{"provider":"anilist","id":"206914","episodeNumbers":[10]},{"provider":"mal","id":"63375","episodeNumbers":[10]},{"provider":"tmdb_show","id":"312474","scope":"s1","seasonNumber":1,"episodeNumbers":[10]},{"provider":"tvdb_show","id":"473228","scope":"s1","seasonNumber":1,"episodeNumbers":[10]}],"link":"107942","synopsis":"Grazie alla strategia di Yayakichi, Ohga ristabilisce la sua autorità e si risolleva. Con le forze di Yamato vicine al tracollo, Ryumon e il suo stratega Kaku hanno già affidato a un giovane un piano audace per rompere lo stallo.","thumbnail":"https://image.tmdb.org/t/p/w300/yKwIvynzxIQsJI2OKwdxC5fCGiH.jpg"},{"title":"La trappola di Muuton","episodeNumber":11,"sourceEpisodeNumber":11,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"19861","scope":"R","episodeNumbers":[11]},{"provider":"anilist","id":"206914","episodeNumbers":[11]},{"provider":"mal","id":"63375","episodeNumbers":[11]},{"provider":"tmdb_show","id":"312474","scope":"s1","seasonNumber":1,"episodeNumbers":[11]},{"provider":"tvdb_show","id":"473228","scope":"s1","seasonNumber":1,"episodeNumbers":[11]}],"link":"108054","synopsis":"Aoteru ritrova finalmente Denki Taira, ma il suo pensiero è rivolto a ben altro. Quando svela il vero significato del suo ordine di ritirata, Denki si oppone con fermezza. Alla fine, la decisione viene rimessa nelle mani dell'imperatore.","thumbnail":"https://image.tmdb.org/t/p/w300/AvAv4dL0MVkaS8QFXLK4msuQWrk.jpg"},{"title":"Vigilia della guerra","episodeNumber":12,"sourceEpisodeNumber":12,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"19861","scope":"R","episodeNumbers":[12]},{"provider":"anilist","id":"206914","episodeNumbers":[12]},{"provider":"mal","id":"63375","episodeNumbers":[12]},{"provider":"tmdb_show","id":"312474","scope":"s1","seasonNumber":1,"episodeNumbers":[12]},{"provider":"tvdb_show","id":"473228","scope":"s1","seasonNumber":1,"episodeNumbers":[12]}],"link":"108194","synopsis":"Con un appello sincero, Aoteru riesce finalmente a persuadere l'imperatore. Yoshitsune consegna un decreto imperiale a Ryumon, che si prepara ad affrontare le forze nemiche. Intanto Seii pianifica di annientare Yamato con la sua \"Strategia Generale d'Inverno\". Le mosse di entrambi portano i