":"https://img.animeunity.co/anime/bx1179-bagCTqAIonYz.png"},{"source":"cinemeta","url":"https://live.metahub.space/poster/small/tt1073234/img"},{"source":"anilist","url":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/large/bx1179-bagCTqAIonYz.png"}],"background":[{"source":"tmdb","url":"https://image.tmdb.org/t/p/original/dULA8iJWcWpzGG9x5YgdjRV7Z1p.jpg"},{"source":"cinemeta","url":"https://live.metahub.space/background/medium/tt1073234/img"},{"source":"anizip","url":"https://artworks.thetvdb.com/banners/fanart/original/83295-1.jpg"},{"source":"provider","url":"https://img.animeunity.co/anime/1179-3W36hViLNehi.jpg"},{"source":"anilist","url":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/1179-3W36hViLNehi.jpg"}]}},"related":[],"linkList":[{"title":"Episodes 1-26","titleKey":"Episodes {{start}}-{{end}}","titleParams":{"start":1,"end":26},"availabilityStatus":"available","episodesLink":"7349|1|26"}]},"episodes":[{"title":"Episodio 1","episodeNumber":1,"sourceEpisodeNumber":1,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"482","scope":"R","episodeNumbers":[1]},{"provider":"anilist","id":"1179","episodeNumbers":[1]},{"provider":"mal","id":"1179","episodeNumbers":[1]},{"provider":"tmdb_show","id":"113907","scope":"s1","seasonNumber":1,"episodeNumbers":[1]},{"provider":"tvdb_show","id":"83295","scope":"s1","seasonNumber":1,"episodeNumbers":[1]}],"link":"104513","synopsis":"Hajime wakes up to discover that aliens have landed, and coincidentally there's a mysterious new transfer student in his class. After a morning of startling revelations, the interesting day is just getting started.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/83295/394023.jpg"},{"title":"Episodio 2","episodeNumber":2,"sourceEpisodeNumber":2,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"482","scope":"R","episodeNumbers":[2]},{"provider":"anilist","id":"1179","episodeNumbers":[2]},{"provider":"mal","id":"1179","episodeNumbers":[2]},{"provider":"tmdb_show","id":"113907","scope":"s1","seasonNumber":1,"episodeNumbers":[2]},{"provider":"tvdb_show","id":"83295","scope":"s1","seasonNumber":1,"episodeNumbers":[2]}],"link":"104514","synopsis":"Hajime witnesses an argument gone battle that involves more than just fists between Muryou and Kyoichi. Bewildered by this show of psychic powers, Hajime questions Muryou. What will he tell Hajime?","thumbnail":"https://artworks.thetvdb.com/banners/episodes/83295/394024.jpg"},{"title":"Episodio 3","episodeNumber":3,"sourceEpisodeNumber":3,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"482","scope":"R","episodeNumbers":[3]},{"provider":"anilist","id":"1179","episodeNumbers":[3]},{"provider":"mal","id":"1179","episodeNumbers":[3]},{"provider":"tmdb_show","id":"113907","scope":"s1","seasonNumber":1,"episodeNumbers":[3]},{"provider":"tvdb_show","id":"83295","scope":"s1","seasonNumber":1,"episodeNumbers":[3]}],"link":"104515","synopsis":"The talk around Misumaru Middle School is that someone stole a pair of girls clothing from the school. Who is this thief and what connections does he have with the strange events witnessed by Hajime?","thumbnail":"https://artworks.thetvdb.com/banners/episodes/83295/394025.jpg"},{"title":"Episodio 4","episodeNumber":4,"sourceEpisodeNumber":4,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"482","scope":"R","episodeNumbers":[4]},{"provider":"anilist","id":"1179","episodeNumbers":[4]},{"provider":"mal","id":"1179","episodeNumbers":[4]},{"provider":"tmdb_show","id":"113907","scope":"s1","seasonNumber":1,"episodeNumbers":[4]},{"provider":"tvdb_show","id":"83295","scope":"s1","seasonNumber":1,"episodeNumbers":[4]}],"link":"104516","synopsis":"Hajime attempts to uncover the secrets of Tenmo town while those behind the strange events watch him.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/83295/394026.jpg"},{"title":"Episodio 5","episodeNumber":5,"sourceEpisodeNumber":5,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"482","scope":"R","episodeNumbers":[5]},{"provider":"anilist","id":"1179","episodeNumbers":[5]},{"provider":"mal","id":"1179","episodeNumbers":[5]},{"provider":"tmdb_show","id":"113907","scope":"s1","seasonNumber":1,"episodeNumbers":[5]},{"provider":"tvdb_show","id":"83295","scope":"s1","seasonNumber":1,"episodeNumbers":[5]}],"link":"104517","synopsis":"Hajime has learned the origin of Shingu and everything that has gone on in Tenmo, yet life still continues to remain normal for him. Elsewhere, Jiltosh attempts to tutor an alien spy, but with terrible results.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/83295/394027.jpg"},{"title":"Episodio 6","episodeNumber":6,"sourceEpisodeNumber":6,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"482","scope":"R","episodeNumbers":[6]},{"provider":"anilist","id":"1179","episodeNumbers":[6]},{"provider":"mal","id":"1179","episodeNumbers":[6]},{"provider":"tmdb_show","id":"113907","scope":"s1","seasonNumber":1,"episodeNumbers":[6]},{"provider":"tvdb_show","id":"83295","scope":"s1","seasonNumber":1,"episodeNumbers":[6]}],"link":"104518","synopsis":"It's the arrival of the Athletic Festival and both teams, the Red team and the White team, are both eager to win. On the Red team we've got Kyoich who wants to blaze a path to victory, while on the White team we've got Nayuta who's equally revved up. Will Muryou and Hajime be able to help her do just that? At the same time, someone has snuck onto school grounds.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/83295/394028.jpg"},{"title":"Episodio 7","episodeNumber":7,"sourceEpisodeNumber":7,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"482","scope":"R","episodeNumbers":[7]},{"provider":"anilist","id":"1179","episodeNumbers":[7]},{"provider":"mal","id":"1179","episodeNumbers":[7]},{"provider":"tmdb_show","id":"113907","scope":"s1","seasonNumber":1,"episodeNumbers":[7]},{"provider":"tvdb_show","id":"83295","scope":"s1","seasonNumber":1,"episodeNumbers":[7]}],"link":"104519","synopsis":"While the Athletic Festival may be over, people are still wondering who the victor of the final event was. At the same time, everyone has a chance to watch the Cheer team skits, much to the shock of Nayuta and Kyoichi who both participated.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/83295/394029.jpg"},{"title":"Episodio 8","episodeNumber":8,"sourceEpisodeNumber":8,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"482","scope":"R","episodeNumbers":[8]},{"provider":"anilist","id":"1179","episodeNumbers":[8]},{"provider":"mal","id":"1179","episodeNumbers":[8]},{"provider":"tmdb_show","id":"113907","scope":"s1","seasonNumber":1,"episodeNumbers":[8]},{"provider":"tvdb_show","id":"83295","scope":"s1","seasonNumber":1,"episodeNumbers":[8]}],"link":"104520","synopsis":"Hachiyou comes up with an idea for the pending Cultural Festival, but it would seem that Nayuta won't here of it. Even with the support of Hajime and Muryou, Nayuta still refuses to allow it. After a fire destroys Jiltosh's house, he and Weinul, the Zaiglian who had previously requested asylum on Earth, move into the Sanemori manor. A run in with Hajime's mother while grocery shopping causes Hajime's family to have dinner with them.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/83295/394030.jpg"},{"title":"Episodio 9","episodeNumber":9,"sourceEpisodeNumber":9,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"482","scope":"R","episodeNumbers":[9]},{"provider":"anilist","id":"1179","episodeNumbers":[9]},{"provider":"mal","id":"1179","episodeNumbers":[9]},{"provider":"tmdb_show","id":"113907","scope":"s1","seasonNumber":1,"episodeNumbers":[9]},{"provider":"tvdb_show","id":"83295","scope":"s1","seasonNumber":1,"episodeNumbers":[9]}],"link":"104521","synopsis":"Before, the Zaiglians were always content to lurk around in shadows… but no longer. Jiltosh and the others now find themselves face-to-face with the largest squadron of Zaiglian soldiers ever to set foot in Tenmo.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/83295/394031.jpg"},{"title":"Episodio 10","episodeNumber":10,"sourceEpisodeNumber":10,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"482","scope":"R","episodeNumbers":[10]},{"provider":"anilist","id":"1179","episodeNumbers":[10]},{"provider":"mal","id":"1179","episodeNumbers":[10]},{"provider":"tmdb_show","id":"113907","scope":"s1","seasonNumber":1,"episodeNumbers":[10]},{"provider":"tvdb_show","id":"83295","scope":"s1","seasonNumber":1,"episodeNumbers":[10]}],"link":"104522","synopsis":"Something big is coming. School has been cancelled, and the Student Government has been called into a secret meeting with the Sanemori Clan. Most of the students happily head home, oblivious to the danger; but Hajime is about to be witness to one of the Shingu’s most powerful secrets…","thumbnail":"https://artworks.thetvdb.com/banners/episodes/83295/394032.jpg"},{"title":"Episodio 11","episodeNumber":11,"sourceEpisodeNumber":11,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"482","scope":"R","episodeNumbers":[11]},{"provider":"anilist","id":"1179","episodeNumbers":[11]},{"provider":"mal","id":"1179","episodeNumbers":[11]},{"provider":"tmdb_show","id":"113907","scope":"s1","seasonNumber":1,"episodeNumbers":[11]},{"provider":"tvdb_show","id":"83295","scope":"s1","seasonNumber":1,"episodeNumbers":[11]}],"link":"104523","synopsis":"The battle with the “Sanadon” is at hand! Using the dangerous technique of Astral Deviation, Nayuta’s spirit is sent into space along with the Shingu to fight. But with an invasion force closing in on the Chosen’s location on the ground, it’s up to Harumi to protect everyone.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/83295/394033.jpg"},{"title":"Episodio 12","episodeNumber":12,"sourceEpisodeNumber":12,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"482","scope":"R","episodeNumbers":[12]},{"provider":"anilist","id":"1179","episodeNumbers":[12]},{"provider":"mal","id":"1179","episodeNumbers":[12]},{"provider":"tmdb_show","id":"113907","scope":"s1","seasonNumber":1,"episodeNumbers":[12]},{"provider":"tvdb_show","id":"83295","scope":"s1","seasonNumber":1,"episodeNumbers":[12]}],"link":"104524","synopsis":"Nayuta’s been acting a little strange lately. Normally very confrontational, she seems to be backing off… what could be bothering her so much that her personality has changed 180 degrees?","thumbnail":"https://artworks.thetvdb.com/banners/episodes/83295/394034.jpg"},{"title":"Episodio 13","episodeNumber":13,"sourceEpisodeNumber":13,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"482","scope":"R","episodeNumbers":[13]},{"provider":"anilist","id":"1179","episodeNumbers":[13]},{"provider":"mal","id":"1179","episodeNumbers":[13]},{"provider":"tmdb_show","id":"113907","scope":"s1","seasonNumber":1,"episodeNumbers":[13]},{"provider":"tvdb_show","id":"83295","scope":"s1","seasonNumber":1,"episodeNumbers":[13]}],"link":"104525","synopsis":"Exams are over and the summer is finally here. That means it’s time for a little summer trip! Setsuna invites Hajime, Shun, and Nayuta to visit the mysterious Village of Falling Stars… but this little vacation isn’t going to be all fun and games…","thumbnail":"https://artworks.thetvdb.com/banners/episodes/83295/394035.jpg"},{"title":"Episodio 14","episodeNumber":14,"sourceEpisodeNumber":14,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"482","scope":"R","episodeNumbers":[14]},{"provider":"anilist","id":"1179","episodeNumbers":[14]},{"provider":"mal","id":"1179","episodeNumbers":[14]},{"provider":"tmdb_show","id":"113907","scope":"s1","seasonNumber":1,"episodeNumbers":[14]},{"provider":"tvdb_show","id":"83295","scope":"s1","seasonNumber":1,"episodeNumbers":[14]}],"link":"104526","synopsis":"The evidence from the battle with Sanadon leads to some troubling discoveries for the Sanemori Clan. Of course, laid-back Jiltosh would rather everyone focus on a more important matter… the Zaiglians are finally returning home and that means a going-away party is in order!","thumbnail":"https://artworks.thetvdb.com/banners/episodes/83295/394036.jpg"},{"title":"Episodio 15","episodeNumber":15,"sourceEpisodeNumber":15,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"482","scope":"R","episodeNumbers":[15]},{"provider":"anilist","id":"1179","episodeNumbers":[15]},{"provider":"mal","id":"1179","episodeNumbers":[15]},{"provider":"tmdb_show","id":"113907","scope":"s1","seasonNumber":1,"episodeNumbers":[15]},{"provider":"tvdb_show","id":"83295","scope":"s1","seasonNumber":1,"episodeNumbers":[15]}],"link":"104527","synopsis":"Hajime’s father, Kazuo Murata, is finally getting a vacation to see his family! What is it, exactly, that he does again? But his appearance at home is overshadowed by a startling announcement on the early morning news…","thumbnail":"https://artworks.thetvdb.com/banners/episodes/83295/394037.jpg"},{"title":"Episodio 16","episodeNumber":16,"sourceEpisodeNumber":16,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"482","scope":"R","episodeNumbers":[16]},{"provider":"anilist","id":"1179","episodeNumbers":[16]},{"provider":"mal","id":"1179","episodeNumbers":[16]},{"provider":"tmdb_show","id":"113907","scope":"s1","seasonNumber":1,"episodeNumbers":[16]},{"provider":"tvdb_show","id":"83295","scope":"s1","seasonNumber":1,"episodeNumbers":[16]}],"link":"104528","synopsis":"Alien forces are on the move and, aside from keeping Setsuna up all night, they seem to have a darker purpose. With a new impending invasion, could it be time to ask for the Galactic Federation’s support?","thumbnail":"https://artworks.thetvdb.com/banners/episodes/83295/394038.jpg"},{"title":"Episodio 17","episodeNumber":17,"sourceEpisodeNumber":17,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"482","scope":"R","episodeNumbers":[17]},{"provider":"anilist","id":"1179","episodeNumbers":[17]},{"provider":"mal","id":"1179","episodeNumbers":[17]},{"provider":"tmdb_show","id":"113907","scope":"s1","seasonNumber":1,"episodeNumbers":[17]},{"provider":"tvdb_show","id":"83295","scope":"s1","seasonNumber":1,"episodeNumbers":[17]}],"link":"104529","synopsis":"Everyone is shocked to discover that Hajime’s father is involved with the space diplomacy talks - even Hajime! But right now Hajime is more focused on the Festival Club. Nayuta seems to be taking a special interest in the club and she decides to hold a meeting regarding their plans for the Cultural Festival, but the meeting is cut short when yet another alien battleship appears!","thumbnail":"https://artworks.thetvdb.com/banners/episodes/83295/394039.jpg"},{"title":"Episodio 18","episodeNumber":18,"sourceEpisodeNumber":18,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"482","scope":"R","episodeNumbers":[18]},{"provider":"anilist","id":"1179","episodeNumbers":[18]},{"provider":"mal","id":"1179","episodeNumbers":[18]},{"provider":"tmdb_show","id":"113907","scope":"s1","seasonNumber":1,"episodeNumbers":[18]},{"provider":"tvdb_show","id":"83295","scope":"s1","seasonNumber":1,"episodeNumbers":[18]}],"link":"104530","synopsis":"The students stumble upon an old video containing a short film from 100 years ago! Who could that be playing the lead? Is it… a young Lady Momoe? While the Festival Club draws in the curious viewers, a troubled Harumi must face Kyoichi and tell him the truth… the truth about what really happened 11 years ago.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/83295/394040.jpg"},{"title":"Episodio 19","episodeNumber":19,"sourceEpisodeNumber":19,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"482","scope":"R","episodeNumbers":[19]},{"provider":"anilist","id":"1179","episodeNumbers":[19]},{"provider":"mal","id":"1179","episodeNumbers":[19]},{"provider":"tmdb_show","id":"113907","scope":"s1","seasonNumber":1,"episodeNumbers":[19]},{"provider":"tvdb_show","id":"83295","scope":"s1","seasonNumber":1,"episodeNumbers":[19]}],"link":"104531","synopsis":"Aliens have appeared in Kyushu and they’re making short work of the Protectors! Will Harumi be strong enough to protect the Chosen by herself? And why isn’t Muryou around when he’s needed the most?","thumbnail":"https://artworks.thetvdb.com/banners/episodes/83295/394041.jpg"},{"title":"Episodio 20","episodeNumber":20,"sourceEpisodeNumber":20,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"482","scope":"R","episodeNumbers":[20]},{"provider":"anilist","id":"1179","episodeNumbers":[20]},{"provider":"mal","id":"1179","episodeNumbers":[20]},{"provider":"tmdb_show","id":"113907","scope":"s1","seasonNumber":1,"episodeNumbers":[20]},{"provider":"tvdb_show","id":"83295","scope":"s1","seasonNumber":1,"episodeNumbers":[20]}],"link":"104532","synopsis":"It’s festival time at Futaba’s elementary school! The members of the Festival Club have been invited to participate and that means a fun change of pace for the weary middle school students.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/83295/394042.jpg"},{"title":"Episodio 21","episodeNumber":21,"sourceEpisodeNumber":21,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"482","scope":"R","episodeNumbers":[21]},{"provider":"anilist","id":"1179","episodeNumbers":[21]},{"provider":"mal","id":"1179","episodeNumbers":[21]},{"provider":"tmdb_show","id":"113907","scope":"s1","seasonNumber":1,"episodeNumbers":[21]},{"provider":"tvdb_show","id":"83295","scope":"s1","seasonNumber":1,"episodeNumbers":[21]}],"link":"104533","synopsis":"The sports clubs have finally cornered Muryou! Will he finally agree to help them in their upcoming judo match against Misumaru’s school rival, Miyanomori? One match couldn’t really hurt, right?","thumbnail":"https://artworks.thetvdb.com/banners/episodes/83295/394043.jpg"},{"title":"Episodio 22","episodeNumber":22,"sourceEpisodeNumber":22,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"482","scope":"R","episodeNumbers":[22]},{"provider":"anilist","id":"1179","episodeNumbers":[22]},{"provider":"mal","id":"1179","episodeNumbers":[22]},{"provider":"tmdb_show","id":"113907","scope":"s1","seasonNumber":1,"episodeNumbers":[22]},{"provider":"tvdb_show","id":"83295","scope":"s1","seasonNumber":1,"episodeNumbers":[22]}],"link":"104534","synopsis":"There’s a mysterious new student wandering around in Tenmo. All that’s known about this pale-skinned, green-eyed newcomer is his name: Kanata. But while Momoe and the others try to dig up information on him, he’s busy tracking down Muryou! Is he a friend or a foe?","thumbnail":"https://artworks.thetvdb.com/banners/episodes/83295/394044.jpg"},{"title":"Episodio 23","episodeNumber":23,"sourceEpisodeNumber":23,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"482","scope":"R","episodeNumbers":[23]},{"provider":"anilist","id":"1179","episodeNumbers":[23]},{"provider":"mal","id":"1179","episodeNumbers":[23]},{"provider":"tmdb_show","id":"113907","scope":"s1","seasonNumber":1,"episodeNumbers":[23]},{"provider":"tvdb_show","id":"83295","scope":"s1","seasonNumber":1,"episodeNumbers":[23]}],"link":"104535","synopsis":"It’s a day like any other in Tenmo… except that a gigantic spaceship is now hovering low in the skies over the town. While most people are in a frenzied panic, the natives of Tenmo are strangely calm - until a second spaceship closes in and the two ships face-off!","thumbnail":"https://artworks.thetvdb.com/banners/episodes/83295/394045.jpg"},{"title":"Episodio 24","episodeNumber":24,"sourceEpisodeNumber":24,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"482","scope":"R","episodeNumbers":[24]},{"provider":"anilist","id":"1179","episodeNumbers":[24]},{"provider":"mal","id":"1179","episodeNumbers":[24]},{"provider":"tmdb_show","id":"113907","scope":"s1","seasonNumber":1,"episodeNumbers":[24]},{"provider":"tvdb_show","id":"83295","scope":"s1","seasonNumber":1,"episodeNumbers":[24]}],"link":"104536","synopsis":"With the looming alien threat, school has been cancelled… but that hasn’t stopped the students of Misumaru Middle School from making their own plans for the day! Danger surrounds them, but it will be a day of revelation both for the people of Tenmo, and the world.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/83295/394046.jpg"},{"title":"Episodio 25","episodeNumber":25,"sourceEpisodeNumber":25,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"482","scope":"R","episodeNumbers":[25]},{"provider":"anilist","id":"1179","episodeNumbers":[25]},{"provider":"mal","id":"1179","episodeNumbers":[25]},{"provider":"tmdb_show","id":"113907","scope":"s1","seasonNumber":1,"episodeNumbers":[25]},{"provider":"tvdb_show","id":"83295","scope":"s1","seasonNumber":1,"episodeNumbers":[25]}],"link":"104537","synopsis":"Nayuta is forced to take drastic action. As she pushes the power of the Shingu farther than ever before, the Shingu’s darkest secret will finally be revealed.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/83295/394047.jpg"},{"title":"Episodio 26","episodeNumber":26,"sourceEpisodeNumber":26,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"482","scope":"R","episodeNumbers":[26]},{"provider":"anilist","id":"1179","episodeNumbers":[26]},{"provider":"mal","id":"1179","episodeNumbers":[26]},{"provider":"tmdb_show","id":"113907","scope":"s1","seasonNumber":1,"episodeNumbers":[26]},{"provider":"tvdb_show","id":"83295","scope":"s1","seasonNumber":1,"episodeNumbers":[26]}],"link":"104538","synopsis":"…you didn’t really think we’d tell you how it ends, did you?","thumbnail":"https://artworks.thetvdb.com/banners/episodes/83295/394048.jpg"}],"sourceIds":{"anilistId":1179,"malId":1179},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-29T07:54:59Z","sourceDescriptors":