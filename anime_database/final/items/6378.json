deNumber":3,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"14582","scope":"R","episodeNumbers":[3]},{"provider":"tmdb_show","id":"34114","scope":"s2","seasonNumber":2,"episodeNumbers":[3]},{"provider":"tvdb_show","id":"79835","scope":"s2","seasonNumber":2,"episodeNumbers":[3]}],"link":"93560","synopsis":"A group of armed men kidnap children… and everyone thinks that Cat’s Eye is behind it! The three sisters have to get the paintings, take down the bad guys, and get the kids back!","thumbnail":"https://artworks.thetvdb.com/banners/episodes/79835/320928.jpg"},{"title":"A Scare in the Dark","episodeNumber":4,"sourceEpisodeNumber":4,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"14582","scope":"R","episodeNumbers":[4]},{"provider":"tmdb_show","id":"34114","scope":"s2","seasonNumber":2,"episodeNumbers":[4]},{"provider":"tvdb_show","id":"79835","scope":"s2","seasonNumber":2,"episodeNumbers":[4]}],"link":"93561","synopsis":"The unthinkable has happened and Toshio actually gets a good look at Cat’s Eye! Will Hitomi have to come clean and let Toshio arrest her? Or will she find a way to keep him in the dark?","thumbnail":"https://artworks.thetvdb.com/banners/episodes/79835/320929.jpg"},{"title":"The Hunter Wore a Badge","episodeNumber":5,"sourceEpisodeNumber":5,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"14582","scope":"R","episodeNumbers":[5]},{"provider":"tmdb_show","id":"34114","scope":"s2","seasonNumber":2,"episodeNumbers":[5]},{"provider":"tvdb_show","id":"79835","scope":"s2","seasonNumber":2,"episodeNumbers":[5]}],"link":"93562","synopsis":"After many failed attempts to catch Cat’s Eye, Special Investigations sends in the ruthless Chief Himuro. Can Cat’s Eye avoid Himuro, a man who is willing to kill for a perfect arrest record?","thumbnail":"https://artworks.thetvdb.com/banners/episodes/79835/320930.jpg"},{"title":"The Stolen \"I Love You\"","episodeNumber":6,"sourceEpisodeNumber":6,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"14582","scope":"R","episodeNumbers":[6]},{"provider":"tmdb_show","id":"34114","scope":"s2","seasonNumber":2,"episodeNumbers":[6]},{"provider":"tvdb_show","id":"79835","scope":"s2","seasonNumber":2,"episodeNumbers":[6]}],"link":"93563","synopsis":"After a burglar steals Toshio’s money, he gets kicked out of his apartment. He begs Hitomi to let him stay, but the burglar tracks him down and cleans out the Kisugi household!","thumbnail":"https://artworks.thetvdb.com/banners/episodes/79835/320931.jpg"},{"title":"The Good Life","episodeNumber":7,"sourceEpisodeNumber":7,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"14582","scope":"R","episodeNumbers":[7]},{"provider":"tmdb_show","id":"34114","scope":"s2","seasonNumber":2,"episodeNumbers":[7]},{"provider":"tvdb_show","id":"79835","scope":"s2","seasonNumber":2,"episodeNumbers":[7]}],"link":"93564","synopsis":"Toshio is enjoying his stay at the Kisugi household, but with a detective staying under their roof, Cat’s Eye can’t pull off their heists. The sisters concoct a plan to make Toshio leave.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/79835/320932.jpg"},{"title":"The Magnificent Trap","episodeNumber":8,"sourceEpisodeNumber":8,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"14582","scope":"R","episodeNumbers":[8]},{"provider":"tmdb_show","id":"34114","scope":"s2","seasonNumber":2,"episodeNumbers":[8]},{"provider":"tvdb_show","id":"79835","scope":"s2","seasonNumber":2,"episodeNumbers":[8]}],"link":"93565","synopsis":"Cat’s Eye steals another of their father’s paintings, but it turns out to be a fake! In retaliation, the sisters set up a trap of their own to reclaim the painting.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/79835/320933.jpg"},{"title":"Cap-race-io of Love","episodeNumber":9,"sourceEpisodeNumber":9,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"14582","scope":"R","episodeNumbers":[9]},{"provider":"tmdb_show","id":"34114","scope":"s2","seasonNumber":2,"episodeNumbers":[9]},{"provider":"tvdb_show","id":"79835","scope":"s2","seasonNumber":2,"episodeNumbers":[9]}],"link":"93566","synopsis":"After stealing a gem, Ai panics and hides it in Toshio’s police car. But Toshio’s car gets stolen by a young punk and Hitomi has to get both the car and gem back!","thumbnail":"https://artworks.thetvdb.com/banners/episodes/79835/320934.jpg"},{"title":"The Most Dangerous Game","episodeNumber":10,"sourceEpisodeNumber":10,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"14582","scope":"R","episodeNumbers":[10]},{"provider":"tmdb_show","id":"34114","scope":"s2","seasonNumber":2,"episodeNumbers":[10]},{"provider":"tvdb_show","id":"79835","scope":"s2","seasonNumber":2,"episodeNumbers":[10]}],"link":"93567","synopsis":"A thief is brought in for questioning, but Toshio can’t pin anything on him. Cat’s Eye has to find a way to get their father’s painting from the thief before he delivers it to the Mafia!","thumbnail":"https://artworks.thetvdb.com/banners/episodes/79835/320935.jpg"},{"title":"The Gift Is Dad`s Wine","episodeNumber":11,"sourceEpisodeNumber":11,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"14582","scope":"R","episodeNumbers":[11]},{"provider":"tmdb_show","id":"34114","scope":"s2","seasonNumber":2,"episodeNumbers":[11]},{"provider":"tvdb_show","id":"79835","scope":"s2","seasonNumber":2,"episodeNumbers":[11]}],"link":"93568","synopsis":"A man comes to the café claiming to be Heinz’s art teacher! He’s looking for a bottle of wine with a label drawn by Heinz, but something doesn’t seem right with the mysterious visitor.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/79835/320936.jpg"},{"title":"A Mystery for a Winter Night","episodeNumber":12,"sourceEpisodeNumber":12,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"14582","scope":"R","episodeNumbers":[12]},{"provider":"tmdb_show","id":"34114","scope":"s2","seasonNumber":2,"episodeNumbers":[12]},{"provider":"tvdb_show","id":"79835","scope":"s2","seasonNumber":2,"episodeNumbers":[12]}],"link":"93569","synopsis":"Somehow, paintings stolen by Cat’s Eye have been sold back to their owners! Surely, one of the three sisters couldn’t be responsible… right?","thumbnail":"https://artworks.thetvdb.com/banners/episodes/79835/320937.jpg"},{"title":"Yokohama Bay Blues","episodeNumber":13,"sourceEpisodeNumber":13,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"14582","scope":"R","episodeNumbers":[13]},{"provider":"tmdb_show","id":"34114","scope":"s2","seasonNumber":2,"episodeNumbers":[13]},{"provider":"tvdb_show","id":"79835","scope":"s2","seasonNumber":2,"episodeNumbers":[13]}],"link":"93570","synopsis":"The painting Cat’s Eye is after ends up getting taken by the owner’s daughter, as she runs away from home! Ai has to catch her, but a dubious private eye has his own plans.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/79835/320938.jpg"},{"title":"For You, the Tear of the Stars","episodeNumber":14,"sourceEpisodeNumber":14,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"14582","scope":"R","episodeNumbers":[14]},{"provider":"tmdb_show","id":"34114","scope":"s2","seasonNumber":2,"episodeNumbers":[14]},{"provider":"tvdb_show","id":"79835","scope":"s2","seasonNumber":2,"episodeNumbers":[14]}],"link":"93571","synopsis":"Hitomi poses as the daughter of a skilled gem cutter to get close to a band of jewel thieves. But with the Inunari Police targeting the thieves too, Hitomi may blow her cover!","thumbnail":"https://artworks.thetvdb.com/banners/episodes/79835/320939.jpg"},{"title":"Fake Wedding Bells","episodeNumber":15,"sourceEpisodeNumber":15,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"14582","scope":"R","episodeNumbers":[15]},{"provider":"tmdb_show","id":"34114","scope":"s2","seasonNumber":2,"episodeNumbers":[15]},{"provider":"tvdb_show","id":"79835","scope":"s2","seasonNumber":2,"episodeNumbers":[15]}],"link":"93572","synopsis":"Cat’s Eye plans to steal a statue of Mary from a church, so Toshio plans a sting operation—by holding a fake wedding! But can Hitomi be Toshio’s bride and be Cat’s Eye at the same time?","thumbnail":"https://artworks.thetvdb.com/banners/episodes/79835/320940.jpg"},{"title":"Beware of Sweet Invitations","episodeNumber":16,"sourceEpisodeNumber":16,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"14582","scope":"R","episodeNumbers":[16]},{"provider":"tmdb_show","id":"34114","scope":"s2","seasonNumber":2,"episodeNumbers":[16]},{"provider":"tvdb_show","id":"79835","scope":"s2","seasonNumber":2,"episodeNumbers":[16]}],"link":"93573","synopsis":"The owner of a gallery takes a strong interest in Hitomi, but his intentions seem far from innocent. Could this gallery owner be that dangerous?","thumbnail":"https://artworks.thetvdb.com/banners/episodes/79835/320941.jpg"},{"title":"Farewell, Winter Seagull","episodeNumber":17,"sourceEpisodeNumber":17,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"14582","scope":"R","episodeNumbers":[17]},{"provider":"tmdb_show","id":"34114","scope":"s2","seasonNumber":2,"episodeNumbers":[17]},{"provider":"tvdb_show","id":"79835","scope":"s2","seasonNumber":2,"episodeNumbers":[17]}],"link":"93574","synopsis":"When a sailor’s girlfriend somehow gets ahold of a gem that Cat’s Eye is after, she’s kidnapped! Hitomi teams up with the sailor to look for her.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/79835/320942.jpg"},{"title":"The Woman the Chief Fell For","episodeNumber":18,"sourceEpisodeNumber":18,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"14582","scope":"R","episodeNumbers":[18]},{"provider":"tmdb_show","id":"34114","scope":"s2","seasonNumber":2,"episodeNumbers":[18]},{"provider":"tvdb_show","id":"79835","scope":"s2","seasonNumber":2,"episodeNumbers":[18]}],"link":"93575","synopsis":"The chief is head over heels for a beautiful woman. At the same time, a thief by the name of “Winter Firefly” has been eluding Inunari Police. Could the chief’s affair be related somehow?","thumbnail":"https://artworks.thetvdb.com/banners/episodes/79835/320943.jpg"},{"title":"The Inunari Police Triumvirate","episodeNumber":19,"sourceEpisodeNumber":19,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"14582","scope":"R","episodeNumbers":[19]},{"provider":"tmdb_show","id":"34114","scope":"s2","seasonNumber":2,"episodeNumbers":[19]},{"provider":"tvdb_show","id":"79835","scope":"s2","seasonNumber":2,"episodeNumbers":[19]}],"link":"93576","synopsis":"The police have a new computer to come up with security plans! The sisters will have to beat them to the punch and get the access codes from the chief, Asatani and Toshio.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/79835/320944.jpg"},{"title":"Uneasy Feelings About a Transfer Student","episodeNumber":20,"sourceEpisodeNumber":20,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"14582","scope":"R","episodeNumbers":[20]},{"provider":"tmdb_show","id":"34114","scope":"s2","seasonNumber":2,"episodeNumbers":[20]},{"provider":"tvdb_show","id":"79835","scope":"s2","seasonNumber":2,"episodeNumbers":[20]}],"link":"93577","synopsis":"A new student comes to Ai’s school. He’s good looking, athletic, and intelligent…and has a prized violin that Cat’s Eye is after!","thumbnail":"https://artworks.thetvdb.com/banners/episodes/79835/320945.jpg"},{"title":"A Requiem for the Villains","episodeNumber":21,"sourceEpisodeNumber":21,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"14582","scope":"R","episodeNumbers":[21]},{"provider":"tmdb_show","id":"34114","scope":"s2","seasonNumber":2,"episodeNumbers":[21]},{"provider":"tvdb_show","id":"79835","scope":"s2","seasonNumber":2,"episodeNumbers":[21]}],"link":"93578","synopsis":"Cat’s Eye has been framed for murder! They’ll have to clear their name, steal the painting, and expose the bad guys!","thumbnail":"https://artworks.thetvdb.com/banners/episodes/79835/320946.jpg"},{"title":"Toshio Falls in Love with a Phantom Woman","episodeNumber":22,"sourceEpisodeNumber":22,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"14582","scope":"R","episodeNumbers":[22]},{"provider":"tmdb_show","id":"34114","scope":"s2","seasonNumber":2,"episodeNumbers":[22]},{"provider":"tvdb_show","id":"79835","scope":"s2","seasonNumber":2,"episodeNumbers":[22]}],"link":"93579","synopsis":"For their next heist, Hitomi puts on a disguise and tries to seduce Toshio. But things go a little too well and now Toshio is in love with the mystery woman!","thumbnail":"https://artworks.thetvdb.com/banners/episodes/79835/320947.jpg"},{"title":"Romance Out of the Blue","episodeNumber":23,"sourceEpisodeNumber":23,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"14582","scope":"R","episodeNumbers":[23]},{"provider":"tmdb_show","id":"34114","scope":"s2","seasonNumber":2,"episodeNumbers":[23]},{"provider":"tvdb_show","id":"79835","scope":"s2","seasonNumber":2,"episodeNumbers":[23]}],"link":"93580","synopsis":"A young artist is replacing works with expertly-crafted forgeries, but is it his fault? Rui goes undercover as a model but what will she do about her growing feelings for the young painter?","thumbnail":"https://artworks.thetvdb.com/banners/episodes/79835/320948.jpg"},{"title":"Enthusiasm Is a Must for April Fools`","episodeNumber":24,"sourceEpisodeNumber":24,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"14582","scope":"R","episodeNumbers":[24]},{"provider":"tmdb_show","id":"34114","scope":"s2","seasonNumber":2,"episodeNumbers":[24]},{"provider":"tvdb_show","id":"79835","scope":"s2","seasonNumber":2,"episodeNumbers":[24]}],"link":"93581","synopsis":"Toshio begs the sisters to pose as Cat’s Eye for a sting operation, but how can Cat’s Eye make their heist with the Inunari Police already there?","thumbnail":"https://artworks.thetvdb.com/banners/episodes/79835/320949.jpg"},{"title":"Capricious Scramble","episodeNumber":25,"sourceEpisodeNumber":25,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"14582","scope":"R","episodeNumbers":[25]},{"provider":"tmdb_show","id":"34114","scope":"s2","seasonNumber":2,"episodeNumbers":[25]},{"provider":"tvdb_show","id":"79835","scope":"s2","seasonNumber":2,"episodeNumbers":[25]}],"link":"93582","synopsis":"A young woman joins the police force and falls madly in love with Toshio. She’s cute and tenacious, and she may end up foiling Cat’s heist and Hitomi’s love life!","thumbnail":"https://artworks.thetvdb.com/banners/episodes/79835/320950.jpg"},{"title":"The Halftime of Love","episodeNumber":26,"sourceEpisodeNumber":26,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"14582","scope":"R","episodeNumbers":[26]},{"provider":"tmdb_show","id":"34114","scope":"s2","seasonNumber":2,"episodeNumbers":[26]},{"provider":"tvdb_show","id":"79835","scope":"s2","seasonNumber":2,"episodeNumbers":[26]}],"link":"93583","synopsis":"To avoid being caught, Hitomi and Rui hide a stolen gem in a football at Ai’s school. But when the ball gets used in a game, Cat’s Eye and the Inunari Police hit the field!","thumbnail":"https://artworks.thetvdb.com/banners/episodes/79835/320951.jpg"},{"title":"Don`t Cry, Inunari Trio","episodeNumber":27,"sourceEpisodeNumber":27,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"14582","scope":"R","episodeNumbers":[27]},{"provider":"tmdb_show","id":"34114","scope":"s2","seasonNumber":2,"episodeNumbers":[27]},{"provider":"tvdb_show","id":"79835","scope":"s2","seasonNumber":2,"episodeNumbers":[27]}],"link":"93584","synopsis":"After HQ brings in a new hotshot chief, the former chief, Toshio, and Asatani are demoted! Desperate to return to their old jobs, they plan to catch Cat’s Eye on their own!","thumbnail":"https://artworks.thetvdb.com/banners/episodes/79835/320952.jpg"},{"title":"Goodbye to My Mommies","episodeNumber":28,"sourceEpisodeNumber":28,"seas