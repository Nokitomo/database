llo di Odawara, protetto dal “Leone di Sagami” Ujiyasu Hojo. I generali Ishida Mitsunari, Kato Kiyomasa, Fukushima Masanori, Otani Yoshitsugu, Shima Sakon, e Naoe Kanetsugu, personalmente addestrati da Hideyoshi, sono schierati sulla prima linea, pronti alla battaglia. Nel mezzo dello schieramento si trovano i protagonisti, i due giovani guerrieri della casa Sanada: il fratello maggiore Nobuyuki e il minore Yukimura.","date":"2015","episodes_count":12,"episodes_length":24,"author":" ","created_at":"2025-03-18 23:30:11","status":"Terminato","imageurl_cover":"","type":"TV","slug":"samurai-warriors","title_eng":"Samurai Warriors","day":"Domenica","favorites":3,"score":"7.00","visite":3129,"studio":"Tezuka Productions","dub":0,"always_home":0,"members":12,"cover":null,"anilist_id":20944,"season":"Inverno","title_it":null,"mal_id":28283,"crunchy_id":null,"netflix_id":null,"prime_id":null,"disney_id":null,"pivot":{"anime_id":6311,"related_id":6310,"number":1}}]},"archive":null},"sourceEpisodes":[{"id":92814,"anime_id":6311,"user_id":2,"number":"1","created_at":"2025-03-18 23:31:10","link":"Samurai.Warriors.S01E00.La.leggenda.dei.Sanada.1080p.CR.WEB-DL.JPN.AAC2.0.H.264.mkv","visite":2128,"hidden":0,"public":1,"scws_id":294425,"file_name":"Samurai.Warriors.S01E00.La.leggenda.dei.Sanada.1080p.CR.WEB-DL.JPN.AAC2.0.H.264.mkv","tg_post":0}],"artworkInventory":{"logo":[],"poster":[{"source":"tvdb","url":"https://artworks.thetvdb.com/banners/posters/290122-1.jpg"},{"source":"provider","url":"https://img.animeunity.co/anime/20540.jpg"},{"source":"anilist","url":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/20540.jpg"}],"background":[{"source":"tvdb","url":"https://artworks.thetvdb.com/banners/fanart/original/290122-1.jpg"}]},"sourceStatus":{"tmdbWeb":{"attempts":0,"transientFailures":0,"lastFailureCode":null,"retryCount":0}},"rawFingerprint":"43b9e0dd1d2ddca0c432c6e76d78fdfb3a396a4ca354f4bd2785a8649f3a082a","mappingFingerprint":"cea8a9fe7114dc07db0831fae9f8000158