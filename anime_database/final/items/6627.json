uls.","thumbnail":"https://image.tmdb.org/t/p/w300/iWvWs756GQSXUvSdZDJLLRyYPcE.jpg"},{"title":"Episodio 2","episodeNumber":2,"sourceEpisodeNumber":2,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"4860","scope":"R","episodeNumbers":[2]},{"provider":"anilist","id":"1696","episodeNumbers":[2]},{"provider":"mal","id":"1696","episodeNumbers":[2]},{"provider":"tmdb_show","id":"95039","scope":"s1","seasonNumber":1,"episodeNumbers":[2]},{"provider":"tvdb_show","id":"80004","scope":"s1","seasonNumber":1,"episodeNumbers":[2]}],"link":"96905","synopsis":"After the successful liberation of Forland Castle, Alita vows to serve Falis by posing as the newly-crowned queen's handmaiden. All goes according to plan until the coronation festivities are interrupted by a genetically engineered monster.","thumbnail":"https://image.tmdb.org/t/p/w300/sMHwUAw2XNouxqjanrACvC8OGGX.jpg"},{"title":"Episodio 3","episodeNumber":3,"sourceEpisodeNumber":3,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"4860","scope":"R","episodeNumbers":[3]},{"provider":"anilist","id":"1696","episodeNumbers":[3]},{"provider":"mal","id":"1696","episodeNumbers":[3]},{"provider":"tmdb_show","id":"95039","scope":"s1","seasonNumber":1,"episodeNumbers":[3]},{"provider":"tvdb_show","id":"80004","scope":"s1","seasonNumber":1,"episodeNumbers":[3]}],"link":"96906","synopsis":"A shattered keepsake creates a rift between Alita and Falis. When the bounty hunter races off to slay goblins, Alita is captured by Dr. Akamashi. Falis returns for a daring rescue, but she'll need help to even the odds.","thumbnail":"https://image.tmdb.org/t/p/w300/8qocn9VOvm4UU01ioLvUVQkcr0P.jpg"},{"title":"Episodio 4","episodeNumber":4,"sourceEpisodeNumber":4,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"4860","scope":"R","episodeNumbers":[4]},{"provider":"anilist","id":"1696","episodeNumbers":[4]},{"provider":"mal","id":"1696","episodeNumbers":[4]},{"provider":"tmdb_show","id":"95039","scope":"s1","season