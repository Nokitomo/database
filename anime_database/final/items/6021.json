om/banners/posters/117671-3.jpg"},{"source":"provider","url":"https://img.animeunity.co/anime/bx5678-yqeedxnJLoT8.jpg"},{"source":"cinemeta","url":"https://images.metahub.space/poster/small/tt1482965/img"},{"source":"anizip","url":"https://artworks.thetvdb.com/banners/v4/series/117671/posters/67ccdd2d6af2d.jpg"},{"source":"anilist","url":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/large/bx5678-yqeedxnJLoT8.jpg"}],"background":[{"source":"tmdb","url":"https://image.tmdb.org/t/p/original/k4sRP3AuKIqPmjEpxfp5qCCBhxX.jpg"},{"source":"cinemeta","url":"https://images.metahub.space/background/medium/tt1482965/img"},{"source":"tvdb","url":"https://artworks.thetvdb.com/banners/fanart/original/117671-8.jpg"},{"source":"anizip","url":"https://artworks.thetvdb.com/banners/fanart/original/117671-4.jpg"},{"source":"provider","url":"https://img.animeunity.co/anime/5678-EgfgEOrgETII.jpg"},{"source":"anilist","url":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/5678-EgfgEOrgETII.jpg"}]}},"related":[],"linkList":[{"title":"Episodes 1-24","titleKey":"Episodes {{start}}-{{end}}","titleParams":{"start":1,"end":24},"availabilityStatus":"available","episodesLink":"6021|1|24"}]},"episodes":[{"title":"Episodio 1","episodeNumber":1,"sourceEpisodeNumber":1,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"6258","scope":"R","episodeNumbers":[1]},{"provider":"anilist","id":"5678","episodeNumbers":[1]},{"provider":"mal","id":"5678","episodeNumbers":[1]},{"provider":"tmdb_show","id":"46344","scope":"s1","seasonNumber":1,"episodeNumbers":[1]},{"provider":"tvdb_show","id":"117671","scope":"s1","seasonNumber":1,"episodeNumbers":[1]}],"link":"89420","synopsis":"Kobato Hanato has a wish. In order to collect all the wounded hearts, she must embark on a mission and succeed and so begins her story.","thumbnail":"https://image.tmdb.org/t/p/w300/z5ZSva9DoV9BsOr2LA6lk35Q9e.jpg"},{"title":"Episodio 2","episodeNumber":2,"sourceEpisodeNumber":2,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"6258","scope":"R","episodeNumbers":[2]},{"provider":"anilist","id":"5678","episodeNumbers":[2]},{"provider":"mal","id":"5678","episodeNumbers":[2]},{"provider":"tmdb_show","id":"46344","scope":"s1","seasonNumber":1,"episodeNumbers":[2]},{"provider":"tvdb_show","id":"117671","scope":"s1","seasonNumber":1,"episodeNumbers":[2]}],"link":"89421","synopsis":"Kobato barely manages to pass her initial test to get her bottle. Now she must fill it to the brim with wounded hearts in order to have her wish granted. Not wasting a moment, she sets out about town looking for people in need of help. But Kobato is at a loss as to how broken hearts are mended.","thumbnail":"https://image.tmdb.org/t/p/w300/R289rs577CxDCH4vlclpEWpJ76.jpg"},{"title":"Episodio 3","episodeNumber":3,"sourceEpisodeNumber":3,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"6258","scope":"R","episodeNumbers":[3]},{"provider":"anilist","id":"5678","episodeNumbers":[3]},{"provider":"mal","id":"5678","episodeNumbers":[3]},{"provider":"tmdb_show","id":"46344","scope":"s1","seasonNumber":1,"episodeNumbers":[3]},{"provider":"tvdb_show","id":"117671","scope":"s1","seasonNumber":1,"episodeNumbers":[3]}],"link":"89422","synopsis":"Kobato and Ioryogi stay inside an unused sewer pipe in the park to avoid getting wet. Ms. Sayaka, the head of Yomogi Kindergarten, decides to take Kobato to an apartment her friend Chitose looks after. Moved by Ms. Sayaka’s kindness, Kobato heads to the kindergarten to help out.","thumbnail":"https://image.tmdb.org/t/p/w300/x1KeEUw89VV8ekgOadMl8Q0CJd5.jpg"},{"title":"Episodio 4","episodeNumber":4,"sourceEpisodeNumber":4,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"6258","scope":"R","episodeNumbers":[4]},{"provider":"anilist","id":"5678","episodeNumbers":[4]},{"provider":"mal","id":"5678","episodeNumbers":[4]},{"provider":"tmdb_show","id":"46344","scope":"s1","seasonNumber":1,"episodeNumbers":[4]},{"provider":"tvdb_show","id":"117671","scope":"s1","seasonNumber":1,"episodeNumbers":[4]}],"link":"89423","synopsis":"Kobato is off on her usual search for people with broken hearts so that she can collect \"kompeitos\" in her bottle. Ioryogi’s anxiety mounts as Kobato bungles again and again.Kobato is lured to the front of a small church where she meets Kohaku, an angel from Tenkai (Heavens) with a most beautiful heart.","thumbnail":"https://image.tmdb.org/t/p/w300/fCiuR8hIYW6uSM1IM6MIIM7Gm6P.jpg"},{"title":"Episodio 5","episodeNumber":5,"sourceEpisodeNumber":5,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"6258","scope":"R","episodeNumbers":[5]},{"provider":"anilist","id":"5678","episodeNumbers":[5]},{"provider":"mal","id":"5678","episodeNumbers":[5]},{"provider":"tmdb_show","id":"46344","scope":"s1","seasonNumber":1,"episodeNumbers":[5]},{"provider":"tvdb_show","id":"117671","scope":"s1","seasonNumber":1,"episodeNumbers":[5]}],"link":"89424","synopsis":"Kobato reads a book to the children at Yomogi Kindergarten, but she cannot read well, which Fujimoto quickly and meanly points out. Kobato practices at the park where she meets the book’s author. Having lost his girlfriend, this man is left with a broken heart. Upon learning that he had lost all will to write picture books, Kobato decides to take action…","thumbnail":"https://image.tmdb.org/t/p/w300/m16Uo4vycJ4AYgFKc20A4R3Oai2.jpg"},{"title":"Episodio 6","episodeNumber":6,"sourceEpisodeNumber":6,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"6258","scope":"R","episodeNumbers":[6]},{"provider":"anilist","id":"5678","episodeNumbers":[6]},{"provider":"mal","id":"5678","episodeNumbers":[6]},{"provider":"tmdb_show","id":"46344","scope":"s1","seasonNumber":1,"episodeNumbers":[6]},{"provider":"tvdb_show","id":"117671","scope":"s1","seasonNumber":1,"episodeNumbers":[6]}],"link":"89425","synopsis":"It’s early summer, and Kobato is going on a picnic with all of the children at Yomogi Kindergarten. While playing in the park, Marina goes missing. Kobato and Fujimoto do everything they can to search for her. Meanwhile, Ioryogi heads off alone to see Genko from Ikai regarding some debt trouble the kindergarten is in…","thumbnail":"https://image.tmdb.org/t/p/w300/epxznOQVkEP1RH9WGKCbl2UPlgH.jpg"},{"title":"Episodio 7","episodeNumber":7,"sourceEpisodeNumber":7,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"6258","scope":"R","episodeNumbers":[7]},{"provider":"anilist","id":"5678","episodeNumbers":[7]},{"provider":"mal","id":"5678","episodeNumbers":[7]},{"provider":"tmdb_show","id":"46344","scope":"s1","seasonNumber":1,"episodeNumbers":[7]},{"provider":"tvdb_show","id":"117671","scope":"s1","seasonNumber":1,"episodeNumbers":[7]}],"link":"89426","synopsis":"Fujimoto has headed off to university without his essay, and Ms. Sayaka asks Kobato to deliver it. Excited about being able to show the ever-so-mean Fujimoto up, Kobato sets off to find him at school. There she meets Domoto, who helps her look for Fujimoto. Somehow, this puts Ioryogi in a bad mood…","thumbnail":"https://image.tmdb.org/t/p/w300/6Wiexge483QLvjsg8aEH68EwQ1q.jpg"},{"title":"Episodio 8","episodeNumber":8,"sourceEpisodeNumber":8,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"6258","scope":"R","episodeNumbers":[8]},{"provider":"anilist","id":"5678","episodeNumbers":[8]},{"provider":"mal","id":"5678","episodeNumbers":[8]},{"provider":"tmdb_show","id":"46344","scope":"s1","seasonNumber":1,"episodeNumbers":[8]},{"provider":"tvdb_show","id":"117671","scope":"s1","seasonNumber":1,"episodeNumbers":[8]}],"link":"89427","synopsis":"In town, Kobato hears the helpless cry of a kitten coming from a box. Against the advice of both Ioryogi and Fujimoto, who tell her not to get involved if she can’t take care of it, she takes the kitten back to her apartment. Chiho and Chise, the landlord’s twin daughters help Kobato look for a home for the kitten…","thumbnail":"https://image.tmdb.org/t/p/w300/xAZ7TXIAcqcbHyLu3zs13sN08VH.jpg"},{"title":"Episodio 9","episodeNumber":9,"sourceEpisodeNumber":9,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"6258","scope":"R","episodeNumbers":[9]},{"provider":"anilist","id":"5678","episodeNumbers":[9]},{"provider":"mal","id":"5678","episodeNumbers":[9]},{"provider":"tmdb_show","id":"46344","scope":"s1","seasonNumber":1,"episodeNumbers":[9]},{"provider":"tvdb_show","id":"117671","scope":"s1","seasonNumber":1,"episodeNumbers":[9]}],"link":"89428","synopsis":"It’s summer vacation for Yomogi Kindergarten. While Kobato is washing Ioryogi, the summer festival leaflet gets blown away by the wind. A high school girl picks it up. As she returns the leaflet to Kobato, she notices that Kobato’s hands are wet and lends her a handkerchief. Kobato finds out which school the girl goes to and sets out to see her…","thumbnail":"https://image.tmdb.org/t/p/w300/lxRT86adZfwHuejOHRaodKYg9BG.jpg"},{"title":"Episodio 10","episodeNumber":10,"sourceEpisodeNumber":10,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"6258","scope":"R","episodeNumbers":[10]},{"provider":"anilist","id":"5678","episodeNumbers":[10]},{"provider":"mal","id":"5678","episodeNumbers":[10]},{"provider":"tmdb_show","id":"46344","scope":"s1","seasonNumber":1,"episodeNumbers":[10]},{"provider":"tvdb_show","id":"117671","scope":"s1","seasonNumber":1,"episodeNumbers":[10]}],"link":"89429","synopsis":"It’s a beautiful day, and Kobato decides to make herself useful. She goes to the kindergarten to air out the futons. On the way, she is clumsy as usual and nearly bumps into Fujimoto, who badmouths her yet again. At the kindergarten, Ms. Sayaka tells her the story of Fujimoto’s childhood. Perhaps he’s not such a mean guy after all…","thumbnail":"https://image.tmdb.org/t/p/w300/xkh52ABH9YgDCPVj1qiW7BZrdY2.jpg"},{"title":"Episodio 11","episodeNumber":11,"sourceEpisodeNumber":11,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"6258","scope":"R","episodeNumbers":[11]},{"provider":"anilist","id":"5678","episodeNumbers":[11]},{"provider":"mal","id":"5678","episodeNumbers":[11]},{"provider":"tmdb_show","id":"46344","scope":"s1","seasonNumber":1,"episodeNumbers":[11]},{"provider":"tvdb_show","id":"117671","scope":"s1","seasonNumber":1,"episodeNumbers":[11]}],"link":"89431","synopsis":"Done helping at Yomogi Kindergarten, Kobato finds a classifieds magazine on Fujimoto’s desk. Wishing to help the kindergarten, she decides to find a job too. Chitose introduces her to Hiroyasu Ueda, the manager of a coffee shop called Bakery Tirol. Kobato gets the job but, as it usually does, trouble soon finds her!","thumbnail":"https://image.tmdb.org/t/p/w300/iNW2SC3d9X5Gf6k5WbDeOIeqmQ.jpg"},{"title":"Episodio 12","episodeNumber":12,"sourceEpisodeNumber":12,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"6258","scope":"R","episodeNumbers":[12]},{"provider":"anilist","id":"5678","episodeNumbers":[12]},{"provider":"mal","id":"5678","episodeNumbers":[12]},{"provider":"tmdb_show","id":"46344","scope":"s1","seasonNumber":1,"episodeNumbers":[12]},{"provider":"tvdb_show","id":"117671","scope":"s1","seasonNumber":1,"episodeNumbers":[12]}],"link":"89430","synopsis":"Marina ties a cute ribbon around Ioryogi, who is sitting in Kobato’s bag as always. Kobato doesn’t notice how upset Ioryogi is about this. Meanwhile, Ginsei shows up at the Bear’s Baumkuchen shop looking for Genko. He says he wants to know why Ioryogi continues to stay with Kobato as a stuffed doll. What could his real purpose be…?","thumbnail":"https://image.tmdb.org/t/p/w300/ebvzdS9wj7zjqvqEAat7Zb58ojv.jpg"},{"title":"Episodio 13","episodeNumber":13,"sourceEpisodeNumber":13,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"6258","scope":"R","episodeNumbers":[13]},{"provider":"anilist","id":"5678","episodeNumbers":[13]},{"provider":"mal","id":"5678","episodeNumbers":[13]},{"provider":"tmdb_show","id":"46344","scope":"s1","seasonNumber":1,"episodeNumbers":[13]},{"provider":"tvdb_show","id":"117671","scope":"s1","seasonNumber":1,"episodeNumbers":[13]}],"link":"89433","synopsis":"While taking a walk with Ioryogi, enjoying the fragrance of autumn, Kobato finds a huge ginkgo tree. She takes the children to see the tree after Toshihiko has a fight over building blocks. They decide to use the beautiful fallen leaves to make pictures. While they are collecting the leaves, they find out that the tree is going to be cut down…","thumbnail":"https://image.tmdb.org/t/p/w300/uHN04ZGMMiMtzJdiM5A7UAJl9E8.jpg"},{"title":"Episodio 14","episodeNumber":14,"sourceEpisodeNumber":14,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"6258","scope":"R","episodeNumbers":[14]},{"provider":"anilist","id":"5678","episodeNumbers":[14]},{"provider":"mal","id":"5678","episodeNumbers":[14]},{"provider":"tmdb_show","id":"46344","scope":"s1","seasonNumber":1,"episodeNumbers":[14]},{"provider":"tvdb_show","id":"117671","scope":"s1","seasonNumber":1,"episodeNumbers":[14]}],"link":"89432","synopsis":"It’s sweet potato-digging day at Yomogi Kindergarten. Kobato excitedly gets ready for her first ever experience, but Ioryogi is quick to comment on her inappropriate behavior. At the farm, everyone is having fun digging when Kobato notices a boy who seems out of place. Fujimoto calls to him and he runs away, sweet potatoes in hand.","thumbnail":"https://image.tmdb.org/t/p/w300/nyj3oxRtZ5SxmiDB7YUYZOZ0gv3.jpg"},{"title":"Episodio 15","episodeNumber":15,"sourceEpisodeNumber":15,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"6258","scope":"R","episodeNumbers":[15]},{"provider":"anilist","id":"5678","episodeNumbers":[15]},{"provider":"mal","id":"5678","episodeNumbers":[15]},{"provider":"tmdb_show","id":"46344","scope":"s1","seasonNumber":1,"episodeNumbers":[15]},{"provider":"tvdb_show","id":"117671","scope":"s1","seasonNumber":1,"episodeNumbers":[15]}],"link":"89435","synopsis":"Kobato receives some beautiful origami from her landlady, Chisato. Not knowing what to do with the paper, Kobato cuts it up to decorate the kindergarten. Ioryogi scolds her and tells her how it’s supposed to be used. Kobato decides to take the rest of the origami to the kindergarten and gives it to Ms. Sayaka, but Ms. Sayaka suddenly falls ill…!","thumbnail":"https://image.tmdb.org/t/p/w300/h9oV4tlplkNPF8PwFlH47rFZo21.jpg"},{"title":"Episodio 16","episodeNumber":16,"sourceEpisodeNumber":16,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"6258","scope":"R","episodeNumbers":[16]},{"provider":"anilist","id":"5678","episodeNumbers":[16]},{"provider":"mal","id":"5678","episodeNumbers":[16]},{"provider":"tmdb_show","id":"46344","scope":"s1","seasonNumber":1,"episodeNumbers":[16]},{"provider":"tvdb_show","id":"117671","scope":"s1","seasonNumber":1,"episodeNumbers":[16]}],"link":"89434","synopsis":"Returning to her apartment after helping at Yomogi Kindergarten, Kobato hears from Chitose, Chiho and Chise about a bazaar being held at the elementary school. Thinking a bazaar might help the kindergarten’s financial crisis Kobato suggests it to Ms. Sayaka. Fujimoto says it’s a waste of time, but Ms. Sayaka is willing to give it a try…","thumbnail":"https://image.tmdb.org/t/p/w300/A0pnXv7czAjgjJj324Qs6wUyBdN.jpg"},{"title":"Episodio 17","episodeNumber":17,"sourceEpisodeNumber":17,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"6258","scope":"R","episodeNumbers":[17]},{"provider":"anilist","id":"5678","episodeNumbers":[17]},{"provider":"mal","id":"5678","episodeNumbers":[17]},{"provider":"tmdb_show","id":"46344","scope":"s1","seasonNumber":1,"episodeNumbers":[17]},{"provider":"tvdb_show","id":"117671","scope":"s1","seasonNumber":1,"episodeNumbers":[17]}],"link":"89436","synopsis":"On the day of the bazaar, Ioryogi heads out to Genko’s to find something that would surely sell. When he gets there, the Bear’s Baumkuchen Shop is overflowing with customers! Zuisho is helping out just to keep things going. Even Ginsei is out doing deliveries. Ioryogi is full of sarcasm for them, but they take no note of it.","thumbnail":"https://image.tmdb.org/t/p/w300/r8tOwsk0TP6iu9PLonyIzOX0vwG.jpg"},{"title":"Episodio 18","episodeNumber":18,"sourceEpisodeNumber":18,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"6258","scope":"R","episodeNumbers":[18]},{"provider":"anilist","id":"5678","episodeNumbers":[18]},{"provider":"mal","id":"5678","episodeNumbers":[18]},{"provider":"tmdb_show","id":"46344","scope":"s1","seasonNumber":1,"episodeNumbers":[18]},{"provider":"tvdb_show","id":"117671","scope":"s1","seasonNumber":1,"episodeNumbers":[18]}],"link":"89437","synopsis":"It’s winter, and Kobato is thrilled at the sight of Christmas trees. But at the kindergarten, that debt collector who had been by to hassle them before, is by the gate. Unable to do anything about a man just standing there, Fujimoto holds back his frustration. Meanwhile, the children are happily decorating for Christmas. Even Domoto comes to help…","thumbnail":"https://image.tmdb.org/t/p/w300/x4GK2g1L4Wywki3BDcmILV8b0P4.jpg"},{"title":"Episodio 19","episodeNumber":19,"sourceEpisodeNumber":19,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"6258","scope":"R","episodeNumbers":[19]},{"provider":"anilist","id":"5678","episodeNumbers":[19]},{"provider":"mal","id":"5678","episodeNumbers":[19]},{"provider":"tmdb_show","id":"46344","scope":"s1","seasonNumber":1,"episodeNumbers":[19]},{"provider":"tvdb_show","id":"117671","scope":"s1","seasonNumber":1,"episodeNumbers":[19]}],"link":"89438","synopsis":"Preparations for the Christmas party are underway. Fujimoto, who always dresses as Santa Claus, is ironing his suit. His attitude bothers Kobato because every time their eyes meet, he turns away. On such a day, Domoto waits for Kobato at the kindergarten. It is late, so he offers to walk her home. As they’re walking through town, who would coincidentally appear before them, but Fujimoto…?","thumbnail":"https://image.tmdb.org/t/p/w300/zCXw3qUTKpC9b0rc1jWkA4BgI8M.jpg"},{"title":"Episodio 20","episodeNumber":20,"sourceEpisodeNumber":20,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"6258","scope":"R","episodeNumbers":[20]},{"provider":"anilist","id":"5678","episodeNumbers":[20]},{"provider":"mal","id":"5678","episodeNumbers":[20]},{"provider":"tmdb_show","id":"46344","scope":"s1","seasonNumber":1,"episodeNumbers":[20]},{"provider":"tvdb_show","id":"117671","scope":"s1","seasonNumber":1,"episodeNumbers":[20]}],"link":"89439","synopsis":"One February evening when the air is still cold, Kobato tells Ioryogi about all the magazines she saw with pictures of chocolates on them. Ioryogi explains Valentine’s Day, and Kobato talks to Fujimoto about having a Valentine’s Day party at the kindergarten. As the kindergarten lacks funds, she decides to work at Bakery Tirol in return for a supply of ingredients to make chocolates…","thumbnail":"https://image.tmdb.org/t/p/w300/nS8XwT87INu605kX5t4HIZh1ULd.jpg"},{"title":"Episodio 21","episodeNumber":21,"sourceEpisodeNumber":21,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"6258","scope":"R","episodeNumbers":[21]},{"provider":"anilist","id":"5678","episodeNumbers":[21]},{"provider":"mal","id":"5678","episodeNumbers":[21]},{"provider":"tmdb_show","id":"46344","scope":"s1","seasonNumber":1,"episodeNumbers":[21]},{"provider":"tvdb_show","id":"117671","scope":"s1","seasonNumber":1,"episodeNumbers":[21]}],"link":"89440","synopsis":"Kobato is helping out at the kindergarten as usual, when Kazuto Okiura, the man who promises to shut the place down, shows up saying he’s willing to talk. Kobato and Fujimoto are wary, but Sayaka accepts Okiura’s demands…","thumbnail":"https://image.tmdb.org/t/p/w300/klAb2QHtAoMlUkPkMU7vNajiofd.jpg"},{"title":"Episodio 22","episodeNumber":22,"sourceEpisodeNumber":22,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"6258","scope":"R","episodeNumbers":[22]},{"provider":"anilist","id":"5678","episodeNumbers":[22]},{"provider":"mal","id":"5678","episodeNumbers":[22]},{"provider":"tmdb_show","id":"46344","scope":"s1","seasonNumber":1,"episodeNumbers":[22]},{"provider":"tvdb_show","id":"117671","scope":"s1","seasonNumber":1,"episodeNumbers":[22]}],"link":"89441","synopsis":"Kobato and Sayaka are tidying up at the kindergarten. Having taken on even more jobs, Fujimoto hasn’t had time to show up at the kindergarten anymore. Meanwhile, Ioryogi heads over to the Bear’s Baumkuchen Shop to see Genko with a secret plan for an extension on the deadline to gather kompeito…","thumbnail":"https://image.tmdb.org/t/p/w300/AbJvErxlwNIocGyBvJg2rEb1ycW.jpg"},{"title":"Episodio 23","episodeNumber":23,"sourceEpisodeNumber":23,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"6258","scope":"R","episodeNumbers":[23]},{"provider":"anilist","id":"5678","episodeNumbers":[23]},{"provider":"mal","id":"5678","episodeNumbers":[23]},{"provider":"tmdb_show","id":"46344","scope":"s1","seasonNumber":1,"episodeNumbers":[23]},{"provider":"tvdb_show","id":"117671","scope":"s1","seasonNumber":1,"episodeNumbers":[23]}],"link":"89442","synopsis":"Worried about Fujimoto who injured himself at work, Kobato visits his apartment every morning. He appears to be dubious, but still Kobato is determined to help him out. Ignoring Ioryogi’s anxieties about filling the \"bottle\" full of kompeito before the approaching deadline, Kobato invites Fujimoto to go on a walk. At the park, Fujimoto, as usual, seems to be bothered by Kobato’s presence…","thumbnail":"https://image.tmdb.org/t/p/w300/bab2gXkk0xksrskXYvLPSYCCe5R.jpg"},{"title":"Episodio 24","episodeNumber":24,"sourceEpisodeNumber":24,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"6258","scope":"R","episodeNumbers":[24]},{"provider":"anilist","id":"5678","episodeNumbers":[24]},{"provider":"mal","id":"5678","episodeNumbers":[24]},{"provider":"tmdb_show","id":"46344","scope":"s1","seasonNumber":1,"episodeNumbers":[24]},{"