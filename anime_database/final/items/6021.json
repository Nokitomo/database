{"id":6021,"path":"/anime/6021-kobato","linkSchemaVersion":2,"updatedAt":"2026-10-29T16:42:30.039Z","info":{"title":"Kobato.","synopsis":"Kobato è una ragazza dolce e vivace, ma estremamente ingenua sul mondo intorno a lei. Ha una missione che deve svolgere, quella di guarire le sofferenze del cuore delle persone, in modo tale da poter andare in un luogo da lei tanto desiderato.Poco approfondito secondo me la storia d'amore, ma rimane comunque un anime molto dolce e tenero!","image":"https://image.tmdb.org/t/p/original/k4sRP3AuKIqPmjEpxfp5qCCBhxX.jpg","poster":"https://image.tmdb.org/t/p/original/2aWll5Yav9SWVH4TYVJUpR0aP5u.jpg","logo":"https://image.tmdb.org/t/p/original/coFQqhGHRDW58w9VvKFzCOTpFDC.png","background":"https://image.tmdb.org/t/p/original/k4sRP3AuKIqPmjEpxfp5qCCBhxX.jpg","trailers":["https://www.youtube.com/watch?v=_fD6NEi_Czo"],"imdbId":"tt1482965","type":"series","tags":["TV","Terminato","Autunno","2009"],"tagKeys":{"TV":"TV","Terminato":"Completed","Autunno":"Autumn"},"genres":["Adventure","Comedy","Drama","Fantasy","Romance"],"rating":"8.4","studio":"MADHOUSE","episodesCount":24,"extra":{"ids":{"malId":5678,"anilistId":5678,"crunchyId":null,"disneyId":null,"netflixId":null,"primeId":null,"anilistIds":[5678],"malIds":[5678],"anidbIds":[6258],"imdbMovieIds":[],"imdbShowIds":[],"tmdbMovieIds":[],"tmdbShowIds":[46344],"tvdbMovieIds":[],"tvdbShowIds":[117671]},"stats":{"scoreRaw":"8.39","favorites":22,"members":131,"views":12129,"episodesCountRaw":24,"episodesLength":24},"flags":{"dub":0,"alwaysHome":0},"meta":{"day":"Indeterminato","season":"Autunno","status":"Terminato","type":"TV","createdAt":"2025-01-27 18:38:53","userId":2},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-29T07:54:59Z","sourceDescriptors":["anilist:5678","mal:5678"],"imdbSource":"plexanibridge-v2","targets":[{"provider":"anidb","id":"6258","scope":"R","ranges":{"1-24":"1-24"}},{"provider":"anilist","id":"5678","ranges":{"1-24":"1-24"}},{"provider"