https://image.tmdb.org/t/p/original/cO7Xuxf8dkv2LXcOr9mYeRSFYyX.jpg"},{"source":"tvdb","url":"https://artworks.thetvdb.com/banners/fanart/original/5b3a5afe239e0.jpg"},{"source":"anizip","url":"https://artworks.thetvdb.com/banners/fanart/original/5b9a9543b4267.jpg"}]}},"related":[{"title":"Muhyo & Roji's Bureau of Supernatural Investigation","link":"/anime/4539-muhyo-rojis-bureau-of-supernatural-investigation","image":"https://img.animeunity.co/anime/bx101340-OstJznHblBXq.jpg","type":"TV","year":"2018","dubStatus":"subbed","dubStatusKey":"Subbed","variants":[{"status":"subbed","statusKey":"Subbed","title":"Muhyo & Roji's Bureau of Supernatural Investigation","link":"/anime/4539-muhyo-rojis-bureau-of-supernatural-investigation","image":"https://img.animeunity.co/anime/bx101340-OstJznHblBXq.jpg"}]},{"title":"Muhyo & Roji's Bureau of Supernatural Investigation 2","link":"/anime/4540-muhyo-rojis-bureau-of-supernatural-investigation-2","image":"https://img.animeunity.co/anime/bx110028-bosDZpze4Chn.png","type":"TV","year":"2020","dubStatus":"subbed","dubStatusKey":"Subbed","variants":[{"status":"subbed","statusKey":"Subbed","title":"Muhyo & Roji's Bureau of Supernatural Investigation 2","link":"/anime/4540-muhyo-rojis-bureau-of-supernatural-investigation-2","image":"https://img.animeunity.co/anime/bx110028-bosDZpze4Chn.png"}]}],"linkList":[{"title":"Episodes 1-12","titleKey":"Episodes {{start}}-{{end}}","titleParams":{"start":1,"end":12},"availabilityStatus":"available","episodesLink":"4540|1|12"}]},"episodes":[{"title":"Episodio 1","episodeNumber":1,"sourceEpisodeNumber":1,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"14953","scope":"R","episodeNumbers":[1]},{"provider":"anilist","id":"110028","episodeNumbers":[1]},{"provider":"mal","id":"39948","episodeNumbers":[1]},{"provider":"tmdb_show","id":"80853","scope":"s2","seasonNumber":2,"episodeNumbers":[1]},{"provider":"tvdb_show","id":"347467","scope":"s2","seasonNumber":2,"episodeNumbers":[1]}],"link":"70098","synopsis":"ナナのクラスメートのユミとリカが、放課後、『コックリさん』をしていた。ナナはやめるようにと言い、バイトの為、急いで帰る。夜、『六氷魔法律相談事務所』で、ナナからその話を聞いたムヒョは、嫌な予感を抱いた。ロージーとナナがユミの元に駆け付けると、案の定、霊が襲った後であった。すると、瀕死のユミを、二人の魔法律家が救った。それはーー『ゴリョーグループ』頭取、五嶺陀羅尼丸と助手の恵比寿花夫であった。","thumbnail":"https://image.tmdb.org/t/p/w300/hck4q1YNSRUhyVvkxGrXz8PFyF8.jpg"},{"title":"Episodio 2","episodeNumber":2,"sourceEpisodeNumber":2,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"14953","scope":"R","episodeNumbers":[2]},{"provider":"anilist","id":"110028","episodeNumbers":[2]},{"provider":"mal","id":"39948","episodeNumbers":[2]},{"provider":"tmdb_show","id":"80853","scope":"s2","seasonNumber":2,"episodeNumbers":[2]},{"provider":"tvdb_show","id":"347467","scope":"s2","seasonNumber":2,"episodeNumbers":[2]}],"link":"70099","synopsis":"五嶺は、ムヒョへ、事務所を賭けて勝負を挑んできた。五嶺たちが負ければ、『コックリさん』の霊を除霊した法外な料金をタダにするという申し入れもあり、ロージーはムヒョが負ける訳がないと、その勝負を受けてしまう。舞台は、長い間廃墟となった、霊が巣食うという赤川団地跡。先に霊を倒した側が勝利となる。五嶺とムヒョの、魔法律勝負が始まったーー。","thumbnail":"https://image.tmdb.org/t/p/w300/bTx4AlKwzrU1gIV7EoxvwbyKURi.jpg"},{"title":"Episodio 3","episodeNumber":3,"sourceEpisodeNumber":3,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"14953","scope":"R","episodeNumbers":[3]},{"provider":"anilist","id":"110028","episodeNumbers":[3]},{"provider":"mal","id":"39948","episodeNumbers":[3]},{"provider":"tmdb_show","id":"80853","scope":"s2","seasonNumber":2,"episodeNumbers":[3]},{"provider":"tvdb_show","id":"347467","scope":"s2","seasonNumber":2,"episodeNumbers":[3]}],"link":"70100","synopsis":"事務所を賭けた、赤川団地跡の勝負が続くーー。霊の群れを中空の結界に集める『電磁気吸』の陣を恵比寿が発動した。集めた霊達を、一気に魔法律で片付ける戦略。その中の霊が漏らす声をナナが聞いていた。『会イタイ…』と、それは祈りのような声であった。だが、その時、五嶺の魔法律、『雷獄童子』が執行された。中空へ飛び上がった巨大な童子、『雷獄童子』が口を開け、集めた霊達を飲み込もうとするーー。","thumbnail":"https://image.tmdb.org/t/p/w300/urTwSQNK7DBAXSqBlroZmI4f6NZ.jpg"},{"title":"Episodio 4","episodeNumber":4,"sourceEpisodeNumber":4,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"14953","scope":"R","episodeNumbers":[4]},{"provider":"anilist","id":"110028","episodeNumbers":[4]},{"provider":"mal","id":"39948","episodeNumbers":[4]},{"provider":"tmdb_show","id":"80853","scope":"s2","seasonNumber":2,"episodeNumbers":[4]},{"provider":"tvdb_show","id":"347467","scope":"s2","seasonNumber":2,"episodeNumbers":[4]}],"link":"70101","synopsis":"赤川団地跡の勝負が決した。ムヒョは、先に魔法律を執行したにもかかわらず、敗北を宣言した。事務所は五嶺のものとなったーー。後日。魔法律院行きの列車に、ロージーは今井とともに乗り込んだ。魔法律院で改めて勉強することとなったロージーと、ムヒョは、しばし別れることとなった。動き出す列車をムヒョが見送る。走る車内で、ロージーは思い出していた。ムヒョと初めて会った日のことをーー。","thumbnail":"https://image.tmdb.org/t/p/w300/qE07wAJen9jjR2C9ZfSjYNauR1r.jpg"},{"title":"Episodio 5","episodeNumber":5,"sourceEpisodeNumber":5,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"14953","scope":"R","episodeNumbers":[5]},{"provider":"anilist","id":"110028","episodeNumbers":[5]},{"provider":"mal","id":"39948","episodeNumbers":[5]},{"provider":"tmdb_show","id":"80853","scope":"s2","seasonNumber":2,"episodeNumbers":[5]},{"provider":"tvdb_show","id":"347467","scope":"s2","seasonNumber":2,"episodeNumbers":[5]}],"link":"70102","synopsis":"今井の家に寄宿することとなったロージーは、ムヒョが自分の何に期待しているのかを知る為にも、自分を知るべきだと、魔法律院主催の魔法律検定を受けることにした。魔法律院には、様々な者達が集まっていた。その中に、ロージーは、五嶺の元をクビになった、恵比寿の姿を見つけた。一方、ヨイチ、ビコと合流したムヒョは、魔法律協会内にある林の中の一軒家にいた。そこで、何かを始める準備をしていたーー。","thumbnail":"https://image.tmdb.org/t/p/w300/iMDNUL2NRni6IoVYI7U5ZWCo1l5.jpg"},{"title":"Episodio 6","episodeNumber":6,"sourceEpisodeNumber":6,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"14953","scope":"R","episodeNumbers":[6]},{"provider":"anilist","id":"110028","episodeNumbers":[6]},{"provider":"mal","id":"39948","episodeNumbers":[6]},{"provider":"tmdb_show","id":"80853","scope":"s2","seasonNumber":2,"episodeNumbers":[6]},{"provider":"tvdb_show","id":"347467","scope":"s2","seasonNumber":2,"episodeNumbers":[6]}],"link":"70103","synopsis":"ロージーら魔法律特別強化合宿の選抜メンバーが宿泊する魔法律院に、いくつもの指をヒトデのように広げた、奇怪な怨霊が現れた。廊下のそこここでは、シャッターが下ろされ、逃げる者の退路をふさぐ。選抜メンバーを閉じ込め、襲いくる霊に立ち向かわせる。恐るべき強化合宿が始まったのだ。その頃。林の中の一軒家では、ムヒョ、ヨイチ、ビコの前に冥王ルアラリエが出現していたーー。","thumbnail":"https://image.tmdb.org/t/p/w300/zncaUUPddXItsuBO4gQldsaz3l7.jpg"},{"title":"Episodio 7","episodeNumber":7,"sourceEpisodeNumber":7,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"14953","scope":"R","episodeNumbers":[7]},{"provider":"anilist","id":"110028","episodeNumbers":[7]},{"provider":"mal","id":"39948","episodeNumbers":[7]},{"provider":"tmdb_show","id":"80853","scope":"s2","seasonNumber":2,"episodeNumbers":[7]},{"provider":"tvdb_show","id":"347467","scope":"s2","seasonNumber":2,"episodeNumbers":[7]}],"link":"70104","synopsis":"第３魔監獄を密かに脱獄した、伝説の悪霊、霧吹き山のブイヨセンが、ロージー達の前に現れた。今井が陣で攻撃するが、ブイヨセンには効かない。ブイヨセンは、念動力を使って、ロージー達を追いつめてゆく。一方、一軒家の外の中空では、冥王とムヒョの使者、幽李が戦っていた。圧倒的な力を誇る冥王の攻撃をかわすだけで精一杯の幽李。だが、ムヒョは逆転の機会をうかがっていたーー。","thumbnail":"https://image.tmdb.org/t/p/w300/1MAazrd5mr92vUTvh8oYukTrjiU.jpg"},{"title":"Episodio 8","episodeNumber":8,"sourceEpisodeNumber":8,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"14953","scope":"R","episodeNumbers":[8]},{"provider":"anilist","id":"110028","episodeNumbers":[8]},{"provider":"mal","id":"39948","episodeNumbers":[8]},{"provider":"tmdb_show","id":"80853","scope":"s2","seasonNumber":2,"episodeNumbers":[8]},{"provider":"tvdb_show","id":"347467","scope":"s2","seasonNumber":2,"episodeNumbers":[8]}],"link":"70105","synopsis":"ロージーが直式魔縛りの術で、霧吹き山のブイヨセンの背中に印を直接書こうとする。が、その時、煉が足りなくなり、印が途切れてしまう！　一軒家の外の中空ではーー。使い魔のキリコによる契約の途中放棄を許さぬ冥王が、その姿を巨大な黒い怪鳥に変え、燃え上がる翼から突き出た、『ドゥアトの槍』を手にして、ムヒョたちへ投げつけた。万事休すのムヒョたち。冥王との契約どころか、この攻撃が決まれば、彼らの命はないーー。","thumbnail":"https://image.tmdb.org/t/p/w300/wwpkyK4IXa4hubBAkRIw2eJK2p7.jpg"},{"title":"Episodio 9","episodeNumber":9,"sourceEpisodeNumber":9,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"14953","scope":"R","episodeNumbers":[9]},{"provider":"anilist","id":"110028","episodeNumbers":[9]},{"provider":"mal","id":"39948","episodeNumbers":[9]},{"provider":"tmdb_show","id":"80853","scope":"s2","seasonNumber":2,"episodeNumbers":[9]},{"provider":"tvdb_show","id":"347467","scope":"s2","seasonNumber":2,"episodeNumbers":[9]}],"link":"70106","synopsis":"何故、ムヒョはロージーを助手に選んだのか？　その命題を、ようやくロージーは理解した。ムヒョとロージーは互いの思いを確認し、再びコンビが復活した。そんな折――。ナナの携帯にケンジから連絡が入った。ケンジは、慌てた様子で、ムヒョとロージーに、事務所に戻ってくれと言う。仕方なくムヒョ、ロージー、ナナは、今は五嶺のものとなった事務所にやって来たが、そこには不気味な影が……。","thumbnail":"https://image.tmdb.org/t/p/w300/7yW60ZhuvLBB4MqPUZzTp3TqGiI.jpg"},{"title":"Episodio 10","episodeNumber":10,"sourceEpisodeNumber":10,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"14953","scope":"R","episodeNumbers":[10]},{"provider":"anilist","id":"110028","episodeNumbers":[10]},{"provider":"mal","id":"39948","episodeNumbers":[10]},{"provider":"tmdb_show","id":"80853","scope":"s2","seasonNumber":2,"episodeNumbers":[10]},{"provider":"tvdb_show","id":"347467","scope":"s2","seasonNumber":2,"episodeNumbers":[10]}],"link":"70107","synopsis":"エンチューと、彼に忠誠を誓う禁魔法律家達の組織『箱舟』は、遂に禁書を手に入れた。禁書――それは、永遠の生と復活を約束する禁魔法律の奥義。その封印が解かれた時、魔法律家達に終わりが訪れるであろう、恐るべきもの。彼らは手始めに、禁魔法律家へ敵対の姿勢を見せた、五嶺家総本山を焼き打ちした。そして、『箱舟』のトーマスが五嶺を倉庫に拉致した。魔法律家に突きつけられたエンチューの新たな挑戦にムヒョはーー。","thumbnail":"https://image.tmdb.org/t/p/w300/hNIbNNeBwbfRSbDHsefwqmxLkpX.jpg"},{"title":"Episodio 11","episodeNumber":11,"sourceEpisodeNumber":11,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"14953","scope":"R","episodeNumbers":[11]},{"provider":"anilist","id":"110028","episodeNumbers":[11]},{"provider":"mal","id":"39948","episodeNumbers":[11]},{"provider":"tmdb_show","id":"80853","scope":"s2","seasonNumber":2,"episodeNumbers":[11]},{"provider":"tvdb_show","id":"347467","scope":"s2","seasonNumber":2,"episodeNumbers":[11]}],"link":"70108","synopsis":"五嶺を霊化すべく体内に霊化蟲を入れ、その身を操るトーマス。攻撃はすべて、五嶺が盾となって受け、ムヒョは魔法律を使うことが出来ない。だが、その時――。ナナがトーマスに向かってカメラのフラッシュを浴びせて、その目を射た。続けて、使い魔のキリコが現れ、術で、霊化蟲を五嶺の体から排出させ、地獄へ送り返そうとする。一方――。魔法律協会の調査本部では、ペイジが今井にトーマスとの因縁を語る。","thumbnail":"https://image.tmdb.org/t/p/w300/aOFhFShhMn9RvZmLdBchK7FKCpZ.jpg"},{"title":"Episodio 12","episodeNumber":12,"sourceEpisodeNumber":12,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"14953","scope":"R","episodeNumbers":[12]},{"provider":"anilist","id":"110028","episodeNumbers":[12]},{"provider":"mal","id":"39948","episodeNumbers":[12]},{"provider":"tmdb_show","id":"80853","scope":"s2","seasonNumber":2,"episodeNumbers":[12]},{"provider":"tvdb_show","id":"347467","scope":"s2","seasonNumber":2,"episodeNumbers":[12]}],"link":"70109","synopsis":"蠅王の鎧を身にまとったトーマスがムヒョたちへ襲いくる。トーマスが床と同化した。床は液状化して、崩れ始める。それは、地獄につながる冥府の流砂。食器棚がいくつも浮かび、流れる。ムヒョ達が乗った食器棚が流れゆく中、ムヒョはロージーに、この流砂の中へ飛び込むよう言う。流砂の渦の中心に行って、ある物を破壊する。ロージーならそれが出来ると。ムヒョの信頼にロージーは応えることが出来るのか？　その結末はーー？","thumbnail":"https://image.tmdb.org/t/p/w300/a16vKKbeBlWihU58EMnZQkkXG4U.jpg"}],"sourceIds":{"anilistId":110028,"malId":39948},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-29T07:54:59Z","sourceDescriptors":["anilist:110028","mal:39948"],"targets":[{"provider":"anidb","id":"14953","scope":"R","ranges":{"1-12":"1-12"}},{"provider":"anilist","id":"110028","ranges":{"1-12":"1-12"}},{"provider":"mal","id":"39948","ranges":{"1-12":"1-12"}},{"provider":"tmdb_show","id":"80853","scope":"s2","ranges":{"1-12":"1-12"}},{"provider":"tvdb_show","id":"347467","scope":"s2","ranges":{"1-12":"1-12"}}]},"sourceMetadata":{"info":{"id":4540,"title":"Muhyo to Rouji no Mahouritsu Soudan Jimusho 2","title_eng":"Muhyo & Roji's Bureau of Supernatural Investigation 2","slug":"muhyo-rojis-bureau-of-supernatural-investigation-2","plot":"Seconda stagione di Muhyo to Rouji no Mahouritsu Soudan Jimusho","type":"TV","status":"Terminato","date":"2020","studio":"Studio DEEN","dub":0,"mal_id":39948,"anilist_id":110028,"imageurl":"https://img.animeunity.co/anime/bx110028-bosDZpze4Chn.png","imageurl_cover":null,"cover":null,"score":"6.56","episodes_count":12,"genres":["Action","Comedy","Mystery","Shounen","Supernatural"],"related":[{"id":4539,"title":"Muhyo to Rouji no Mahouritsu Soudan Jimusho","title_eng":"Muhyo & Roji's Bureau of Supernatural Investigation","type":"TV","date":"2018","episodes_count":12},{"id":4540,"title":"Muhyo to Rouji 