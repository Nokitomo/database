e-dangers-in-my-heart-2-ita","image":"https://img.animeunity.co/anime/bx166216-JVyN7PHel5K9.jpg"}]},{"title":"The Dangers in My Heart: The Movie","link":"/anime/7710-the-dangers-in-my-heart-the-movie","image":"https://img.animeunity.co/anime/bx182317-zzpOnAECrM2o.png","type":"Movie","year":"2026","dubStatus":"both","dubStatusKey":"Subbed and dubbed","variants":[{"status":"subbed","statusKey":"Subbed","title":"The Dangers in My Heart: The Movie","link":"/anime/7710-the-dangers-in-my-heart-the-movie","image":"https://img.animeunity.co/anime/bx182317-zzpOnAECrM2o.png"},{"status":"dubbed","statusKey":"Dubbed","title":"The Dangers in My Heart: The Movie","link":"/anime/7711-the-dangers-in-my-heart-the-movie-ita","image":"https://img.animeunity.co/anime/bx182317-zzpOnAECrM2o.png"}]}],"linkList":[{"title":"Stagione 1","seasonNumber":1,"availabilityStatus":"available","episodesLink":"5794|1|13|tmdb_show%3A207250%3As1"}]},"episodes":[{"title":"Noi stiamo cercando","episodeNumber":1,"sourceEpisodeNumber":1,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"18066","scope":"R","episodeNumbers":[1]},{"provider":"anilist","id":"166216","episodeNumbers":[1]},{"provider":"mal","id":"55690","episodeNumbers":[1]},{"provider":"tmdb_show","id":"207250","scope":"s1","seasonNumber":1,"episodeNumbers":[13]},{"provider":"tvdb_show","id":"422981","scope":"s2","seasonNumber":2,"episodeNumbers":[1]}],"link":"87032","synopsis":"Ichikawa, con un braccio rotto dopo l’incidente della stagione precedente, si trova a doversi affidare a Yamada per gestire la vita scolastica. Questo renderà sempre più evidente il loro avvicinamento a molti dei loro compagni, anche per via di una drammatica situazione intorno a Cantaro.","thumbnail":"https://image.tmdb.org/t/p/w300/ozZD9bwwz9b0G9MkX8M0QLISO57.jpg"},{"title":"Io sto per diventare adulto","episodeNumber":2,"sourceEpisodeNumber":2,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"18066","scope":"R","episodeNumbers":[2]},{"provider":"anilist","id":"166216","episodeNumbers":[2]},{"provider":"mal","id":"55690","episodeNumbers":[2]},{"provider":"tmdb_show","id":"207250","scope":"s1","seasonNumber":1,"episodeNumbers":[14]},{"provider":"tvdb_show","id":"422981","scope":"s2","seasonNumber":2,"episodeNumbers":[2]}],"link":"87033","synopsis":"Ichikawa si ritrova in modo del tutto inaspettato a casa di Yamada, cosa che lo mette in profondo imbarazzo, ma che permette anche ai due giovani di parlare di cose nuove in modo aperto. Entrambi si chiedono cosa comporterà il diventare adulti, e Ichikawa in particolare dovrà iniziare a venire a patti con ciò che sta cambiando nella sua vita.","thumbnail":"https://image.tmdb.org/t/p/w300/9Yd2yJxYeKbPcOMEp0dnAjmZFB4.jpg"},{"title":"Voglio stare con Yamada","episodeNumber":3,"sourceEpisodeNumber":3,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"18066","scope":"R","episodeNumbers":[3]},{"provider":"anilist","id":"166216","episodeNumbers":[3]},{"provider":"mal","id":"55690","episodeNumbers":[3]},{"provider":"tmdb_show","id":"207250","scope":"s1","seasonNumber":1,"episodeNumbers":[15]},{"provider":"tvdb_show","id":"422981","scope":"s2","seasonNumber":2,"episodeNumbers":[3]}],"link":"87160","synopsis":"Ichikawa si ritrova coinvolto in una giornata di cucina con le altre ragazze in vista di San Valentino, una situazione per cui è drammaticamente impreparato. Avere a che fare con i genitori di Yamada darà origine a più di un equivoco, ma alla fine i due giovani riusciranno a comprendere nuovi aspetti di ciò che provano.","thumbnail":"https://image.tmdb.org/t/p/w300/thIHmce7csRiFarL4lJHe7R1VTf.jpg"},{"title":"Per Yamada, io...","episodeNumber":4,"sourceEpisodeNumber":4,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"18066","scope":"R","episodeNumbers":[4]},{"provider":"anilist","id":"166216","episodeNumbers":[4]},{"provider":"mal","id":"55690","episodeNumbers":[4]},{"provider":"tmdb_show","id":"207250","scope":"s1","seasonNumber":1,"episodeNumbers":[16]},{"provider":"tvdb_show","id":"422981","scope":"s2","seasonNumber":2,"episodeNumbers":[4]}],"link":"87214","synopsis":"È finalmente arrivato il giorno di San Valentino. Verrà donato tanto cioccolato in più modi, e sia Ichikawa che Yamada dovranno riflettere molto sulle loro azioni e sulle scelte altrui. Per Ichikawa, come sempre, è difficile pensare che i suoi sentimenti possano essere corrisposti, e quindi Yamada dovrà impegnarsi un po’ più del solito.","thumbnail":"https://image.tmdb.org/t/p/w300/95HAO1ZlUPUu12JoOs7a4U1lysz.jpg"},{"title":"Io voglio saperne di più","episodeNumber":5,"sourceEpisodeNumber":5,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"18066","scope":"R","episodeNumbers":[5]},{"provider":"anilist","id":"166216","episodeNumbers":[5]},{"provider":"mal","id":"55690","episodeNumbers":[5]},{"provider":"tmdb_show","id":"207250","scope":"s1","seasonNumber":1,"episodeNumbers":[17]},{"provider":"tvdb_show","id":"422981","scope":"s2","seasonNumber":2,"episodeNumbers":[5]}],"link":"87588","synopsis":"Ichikawa si ritrova coinvolto in una uscita pomeridiana con Yamada, durante la quale si troverà a fare più di una riflessione sul modo in cui la vede. Con l’occasione Yamada lo invita ad assistere alle riprese durante una giornata di lavoro, dandogli l’occasione di osservarla nel contesto lavorativo.","thumbnail":"https://image.tmdb.org/t/p/w300/pzOnIgjJVYAHzAdV1v3hARMW6mi.jpg"},{"title":"Yamada è innamorata di me","episodeNumber":6,"sourceEpisodeNumber":6,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"18066","scope":"R","episodeNumbers":[6]},{"provider":"anilist","id":"166216","episodeNumbers":[6]},{"provider":"mal","id":"55690","episodeNumbers":[6]},{"provider":"tmdb_show","id":"207250","scope":"s1","seasonNumber":1,"episodeNumbers":[18]},{"provider":"tvdb_show","id":"422981","scope":"s2","seasonNumber":2,"episodeNumbers":[6]}],"link":"87699","synopsis":"Ichikawa si ritrova coinvolto suo malgrado nella cerimonia di diploma degli studenti del terzo anno, e anche se vorrebbe tirarsi indietro finisce per accettare. A motivarlo c’è il desiderio di mostrarsi al meglio agli occhi di Yamada, ma per riuscirci dovrà superare le sue paure e un trauma nascosto nel suo passato.","thumbnail":"https://image.tmdb.org/t/p/w300/uzCDL6VBBqiSugfS9hY2pOFdp4S.jpg"},{"title":"Noi siamo traboccanti","episodeNumber":7,"sourceEpisodeNumber":7,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"18066","scope":"R","episodeNumbers":[7]},{"provider":"anilist","id":"166216","episodeNumbers":[7]},{"provider":"mal","id":"55690","episodeNumbers":[7]},{"provider":"tmdb_show","id":"207250","scope":"s1","seasonNumber":1,"episodeNumbers":[19]},{"provider":"tvdb_show","id":"422981","scope":"s2","seasonNumber":2,"episodeNumbers":[7]}],"link":"87911","synopsis":"Ichikawa si ritrova ad avere una notorietà imprevista e forse indesiderata dopo il suo discorso, ma i suoi pensieri sono occupati solo dai dubbi su come comportarsi con Yamada. Tra un tormento e l’altro arriva al White Day, e col supporto di Hara si verificheranno situazioni imprevedibili.","thumbnail":"https://image.tmdb.org/t/p/w300/pcER1A0sQtIgaRdYlZkx1yOPTHT.jpg"},{"title":"Noi abbiamo fatto le ore piccole","episodeNumber":8,"sourceEpisodeNumber":8,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"18066","scope":"R","episodeNumbers":[8]},{"provider":"anilist","id":"166216","episodeNumbers":[8]},{"provider":"mal","id":"55690","episodeNumbers":[8]},{"provider":"tmdb_show","id":"207250","scope":"s1","seasonNumber":1,"episodeNumbers":[20]},{"provider":"tvdb_show","id":"422981","scope":"s2","seasonNumber":2,"episodeNumbers":[8]}],"link":"87989","synopsis":"Con la fine dell’anno scolastico i personaggi si trovano a dover fare i conti con la possibilità di non essere più insieme nella stessa classe, ma oramai Ichikawa ha rapporti consolidati con i suoi compagni e, soprattutto, con Yamada. L’avvicinarsi del suo compleanno sarà una nuova occasione per far avvicinare i due giovani.","thumbnail":"https://image.tmdb.org/t/p/w300/inlTm8MCIb8m0h9As0i4nPekFFP.jpg"},{"title":"Noi l'abbiamo promesso","episodeNumber":9,"sourceEpisodeNumber":9,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"18066","scope":"R","episodeNumbers":[9]},{"provider":"anilist","id":"166216","episodeNumbers":[9]},{"provider":"mal","id":"55690","episodeNumbers":[9]},{"provider":"tmdb_show","id":"207250","scope":"s1","seasonNumber":1,"episodeNumbers":[21]},{"provider":"tvdb_show","id":"422981","scope":"s2","seasonNumber":2,"episodeNumbers":[9]}],"link":"90234","synopsis":"Yamada parte verso la zona di Hiroshima, dove si svolgeranno le riprese per un film. Ichikawa è come sempre in contatto con lei, ma inizierà a rendersi conto di cosa comporta la celebrità di Yamada e di come ci siano rischi su internet di cui lei non si rende ancora conto.","thumbnail":"https://image.tmdb.org/t/p/w300/wc5CUA6ZqJLE5ANKqjdEJ1tpUqe.jpg"},{"title":"Io voglio avvicinarmi a Yamada","episodeNumber":10,"sourceEpisodeNumber":10,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"18066","scope":"R","episodeNumbers":[10]},{"provider":"anilist","id":"166216","episodeNumbers":[10]},{"provider":"mal","id":"55690","episodeNumbers":[10]},{"provider":"tmdb_show","id":"207250","scope":"s1","seasonNumber":1,"episodeNumbers":[22]},{"provider":"tvdb_show","id":"422981","scope":"s2","seasonNumber":2,"episodeNumbers":[10]}],"link":"90325","synopsis":"Ha inizio il nuovo anno scolastico, con tante paure e nuove conoscenze. Molti nuovi compagni sono sconosciuti a Ichikawa ma hanno rapporti con le persone che adesso considera amiche. In questo vortice di nuove esperienze l’unica costante per lui resterà dare il massimo per gestire col giusto equilibrio il rapporto con Yamada.","thumbnail":"https://image.tmdb.org/t/p/w300/qv2WxtCgmLFdldlVKoxXtXBlPJx.jpg"},{"title":"Io non voglio perdere","episodeNumber":11,"sourceEpisodeNumber":11,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"18066","scope":"R","episodeNumbers":[11]},{"provider":"anilist","id":"166216","episodeNumbers":[11]},{"provider":"mal","id":"55690","episodeNumbers":[11]},{"provider":"tmdb_show","id":"207250","scope":"s1","seasonNumber":1,"episodeNumbers":[23]},{"provider":"tvdb_show","id":"422981","scope":"s2","seasonNumber":2,"episodeNumbers":[11]}],"link":"90875","synopsis":"L’avvicinarsi del festival sportivo della scuola è di norma un momento infausto per Ichikawa, ma con le novità del nuovo anno scolastico diventerà l’occasione per un confronto col suo amico Adachi. Tante tensioni rimaste sommerse a lungo verranno finalmente a galla, e Ichikawa avrà come sempre il supporto di Yamada.","thumbnail":"https://image.tmdb.org/t/p/w300/1P7GdtiF1HaKyyn7PV9CjwLQ98e.jpg"},{"title":"Io voglio dirglielo","episodeNumber":12,"sourceEpisodeNumber":12,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"18066","scope":"R","episodeNumbers":[12]},{"provider":"anilist","id":"166216","episodeNumbers":[12]},{"provider":"mal","id":"55690","episodeNumbers":[12]},{"provider":"tmdb_show","id":"207250","scope":"s1","seasonNumber":1,"episodeNumbers":[24]},{"provider":"tvdb_show","id":"422981","scope":"s2","seasonNumber":2,"episodeNumbers":[12]}],"link":"91170","synopsis":"Con l'avvicinarsi dell'estate, per la classe di Ichikawa arriva il momento del viaggio di istruzione. In gita, però, Yamada pare persa e si comporta in modo strano. Combattuto in una morsa di paranoie e fantasticherie, Ichikawa cercherà di capire cosa faccia star male la sua amica.","thumbnail":"https://image.tmdb.org/t/p/w300/5Gd8i6MehtWPz7I3g9KsjM2fUAM.jpg"},{"title":"Il nostro amore più puro","episodeNumber":13,"sourceEpisodeNumber":13,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"18066","scope":"R","episodeNumbers":[13]},{"provider":"anilist","id":"166216","episodeNumbers":[13]},{"provider":"mal","id":"55690","episodeNumbers":[13]},{"provider":"tmdb_show","id":"20