{"id":5043,"path":"/anime/5043-the-way-of-pon","linkSchemaVersion":2,"enrichmentSchemaVersion":2,"updatedAt":"2026-10-30T17:32:51.572Z","info":{"title":"The Way of Pon","synopsis":"Nashiko Jippensha è una studentessa delle superiori che vive ad Onomichi, nella prefettura di Hiroshima. Un giorno viene cacciata di casa e, mentre cerca un nuovo luogo dove si possa divertire con le sue amiche, scopre che la sala da mahjong gestita in precedenza dal padre è ormai abbandonata. Nashiko decide di ripararla e la trasforma in un luogo dove lei assieme alle amiche possono divertirsi, cucinare, prendere il tè e talvolta giocare a mahjong.","image":"https://image.tmdb.org/t/p/original/7JZyPMzueSk5iETqwTnEJwfQ1OG.jpg","poster":"https://image.tmdb.org/t/p/original/6uCwDazQQwEwW95nd4mInfOvvRV.jpg","logo":"https://image.tmdb.org/t/p/original/8tGD4gb1CGVDB0n8Y17SvyLMvJz.png","background":"https://image.tmdb.org/t/p/original/7JZyPMzueSk5iETqwTnEJwfQ1OG.jpg","imdbId":"tt31309480","type":"series","tags":["TV","Terminato","Inverno","2024"],"tagKeys":{"TV":"TV","Terminato":"Completed","Inverno":"Winter"},"genres":["Comedy","Slice of Life","Supernatural"],"rating":"7.0","studio":"OLM","episodesCount":12,"extra":{"ids":{"malId":55397,"anilistId":165314,"crunchyId":null,"disneyId":null,"netflixId":null,"primeId":null,"anilistIds":[165314],"malIds":[55397],"anidbIds":[18043],"imdbMovieIds":[],"imdbShowIds":[],"tmdbMovieIds":[],"tmdbShowIds":[234176],"tvdbMovieIds":[],"tvdbShowIds":[435253]},"stats":{"scoreRaw":"7.02","favorites":72,"members":513,"views":55499,"episodesCountRaw":12,"episodesLength":24},"flags":{"dub":0,"alwaysHome":1},"meta":{"day":"Venerdì","season":"Inverno","status":"Terminato","type":"TV","createdAt":"2024-01-01 14:46:29","userId":78495},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-29T07:54:59Z","sourceDescriptors":["anilist:165314","mal:55397"],"imdbSource":"plexanibridge-v2","targets":[{"provider":"anidb","id":"18043","scope":"R","ra