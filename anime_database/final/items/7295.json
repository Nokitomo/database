198749-hb8hWniEYzYy.jpg","type":"ONA","year":"2026","dubStatus":"subbed","dubStatusKey":"Subbed","variants":[{"status":"subbed","statusKey":"Subbed","title":"Hitori No Shita: The Outcast 6","link":"https://www.animeunity.co/anime/7292-hitori-no-shita-the-outcast-6","image":"https://img.animeunity.co/anime/b198749-hb8hWniEYzYy.jpg"}]}],"linkList":[{"title":"Episodes 1-12","titleKey":"Episodes {{start}}-{{end}}","titleParams":{"start":1,"end":12},"availabilityStatus":"available","episodesLink":"7295|1|12"}]},"episodes":[{"title":"Episodio 1","episodeNumber":1,"sourceEpisodeNumber":1,"seasonNumber":4,"externalMappings":[{"provider":"anidb","id":"16719","scope":"R","episodeNumbers":[1]},{"provider":"anilist","id":"122631","episodeNumbers":[1]},{"provider":"mal","id":"49915","episodeNumbers":[1]},{"provider":"tmdb_show","id":"67063","scope":"s4","seasonNumber":4,"episodeNumbers":[1]},{"provider":"tvdb_show","id":"313488","scope":"s4","seasonNumber":4,"episodeNumbers":[1]}],"link":"103329","synopsis":"哪都通公司陆南区临时工陈朵杀害负责人廖忠后叛逃，出现在贵州六盘水。五大区临时工奉命集结六盘水追捕陈朵，黑管第一个到达，但其线人已被杀。肖自在得知陈朵去过羊肉馆，便前往该处，王震球因好奇跟随。陈朵用蛊毒吸引老鼠群，肖自在则施展大慈大悲手应对，临时工们得知陈朵目的是获取金凤婆婆的地址。","thumbnail":"https://image.tmdb.org/t/p/w300/msXhl1UUfYv2QS5cVGn0akQZ90h.jpg"},{"title":"Episodio 2","episodeNumber":2,"sourceEpisodeNumber":2,"seasonNumber":4,"externalMappings":[{"provider":"anidb","id":"16719","scope":"R","episodeNumbers":[2]},{"provider":"anilist","id":"122631","episodeNumbers":[2]},{"provider":"mal","id":"49915","episodeNumbers":[2]},{"provider":"tmdb_show","id":"67063","scope":"s4","seasonNumber":4,"episodeNumbers":[2]},{"provider":"tvdb_show","id":"313488","scope":"s4","seasonNumber":4,"episodeNumbers":[2]}],"link":"103330","synopsis":"肖自在和王震球追踪陈朵到金凤婆婆的小屋，二壮也参与行动。肖自在的大慈大悲手遭遇法器攻击，王震球使用爱之马杀鸡技能，老孟怯懦出场未出手。王震球在此继承神格面具，战力升级，陈朵身世背景也揭开一角，碧游村杂兵小队的法宝引起临时工注意。老孟主导第一次战略方向调整，决定对陈朵由杀改为不杀。","thumbnail":"https://image.tmdb.org/t/p/w300/d4QY5lKV3Iv8fKj2Q78vo26hFMr.jpg"},{"title":"Episodio 3","episodeNumber":3,"sourceEpisodeNumber":3,"seasonNumber":4,"externalMappings":[{"provider":"anidb","id":"16719","scope":"R","episodeNumbers":[3]},{"provider":"anilist","id":"122631","episodeNumbers":[3]},{"provider":"mal","id":"49915","episodeNumbers":[3]},{"provider":"tmdb_show","id":"67063","scope":"s4","seasonNumber":4,"episodeNumbers":[3]},{"provider":"tvdb_show","id":"313488","scope":"s4","seasonNumber":4,"episodeNumbers":[3]}],"link":"103331","synopsis":"临时工们在废弃工厂与陈朵展开战斗，肖自在的金钟罩、王震球的神格面具、老孟操控动物等手段纷纷登场，冯宝宝施展阿威十八式大显神通，张楚岚用雷法帮老孟解围。陈朵独自逃跑，张楚岚带着冯宝宝追击至桥面。宝儿姐正面强压陈朵，张楚岚辅助创造机会，陈朵后援仇让到达后，黑管出手破坏仇让法器，逆转战局。黑管主导第二次战略方向调整，停止追击陈朵，组织公司人员善后，由二壮继续追踪陈朵信息。","thumbnail":"https://image.tmdb.org/t/p/w300/5HZ4GMwko6NjjS7JWRcmQU4rmpL.jpg"},{"title":"Episodio 4","episodeNumber":4,"sourceEpisodeNumber":4,"seasonNumber":4,"externalMappings":[{"provider":"anidb","id":"16719","scope":"R","episodeNumbers":[4]},{"provider":"anilist","id":"122631","episodeNumbers":[4]},{"provider":"mal","id":"49915","episodeNumbers":[4]},{"provider":"tmdb_show","id":"67063","scope":"s4","seasonNumber":4,"episodeNumbers":[4]},{"provider":"tvdb_show","id":"313488","scope":"s4","seasonNumber":4,"episodeNumbers":[4]}],"link":"103332","synopsis":"张楚岚作为公司代表与碧游村村长马仙洪会晤，试图攀亲戚扯关系，最终达成和平共处、共同寻找解决办法的决定。之后，临时工们全员出动搜集情报，张楚岚找到王也，获取了关于修身炉和诸葛青的情报，还争取到王也的帮助；冯宝宝深入基层了解村民情况；肖自在发现同类赵归真，以其为调研核心；王震球则奔着刘五魁而去；老孟依旧以陈朵为支线任务目标，在此过程中与仇让动手；黑管也在搜集村民信息。","thumbnail":"https://image.tmdb.org/t/p/w300/2baZqRIAG0putFAJHqj7QFwiTtj.jpg"},{"title":"Episodio 5","episodeNumber":5,"sourceEpisodeNumber":5,"seasonNumber":4,"externalMappings":[{"provider":"anidb","id":"16719","scope":"R","episodeNumbers":[5]},{"provider":"anilist","id":"122631","episodeNumbers":[5]},{"provider":"mal","id":"49915","episodeNumbers":[5]},{"provider":"tmdb_show","id":"67063","scope":"s4","seasonNumber":4,"episodeNumbers":[5]},{"provider":"tvdb_show","id":"313488","scope":"s4","seasonNumber":4,"episodeNumbers":[5]}],"link":"103333","synopsis":"二壮整理好情报后交给张楚岚和黑管。张楚岚意识到需要请示公司此次行动做到什么程度，是活捉还是杀光等问题，黑管则主动担任起总指挥的责任，制定了三层套绳车裂马仙洪的作战方案。董事会下达命令，要求以活捉为主，黑管随即展开相关部署。","thumbnail":"https://image.tmdb.org/t/p/w300/rln1otuEapXBvlnyszBOTLn2dDw.jpg"},{"title":"Episodio 6","episodeNumber":6,"sourceEpisodeNumber":6,"seasonNumber":4,"externalMappings":[{"provider":"anidb","id":"16719","scope":"R","episodeNumbers":[6]},{"provider":"anilist","id":"122631","episodeNumbers":[6]},{"provider":"mal","id":"49915","episodeNumbers":[6]},{"provider":"tmdb_show","id":"67063","scope":"s4","seasonNumber":4,"episodeNumbers":[6]},{"provider":"tvdb_show","id":"313488","scope":"s4","seasonNumber":4,"episodeNumbers":[6]}],"link":"103334","synopsis":"公司高层改变任务，要求临时工无论死活，带回陈朵并摧毁碧游村。临时工们得知后讨论应对方案，张楚岚试探大家对高层收权的态度，虽被王震球等人耍了，但随后众人表明不愿被高层直接管理。最终临时工们达成一致，要圆满完成任务，同时也对马仙洪的修身炉和碧游村的情况做进一步分析，为即将到来的战斗做准备。","thumbnail":"https://image.tmdb.org/t/p/w300/3vsOHQlL6NVtYlXHtSkcaLNeoEc.jpg"},{"title":"Episodio 7","episodeNumber":7,"sourceEpisodeNumber":7,"seasonNumber":4,"externalMappings":[{"provider":"anidb","id":"16719","scope":"R","episodeNumbers":[7]},{"provider":"anilist","id":"122631","episodeNumbers":[7]},{"provider":"mal","id":"49915","episodeNumbers":[7]},{"provider":"tmdb_show","id":"67063","scope":"s4","seasonNumber":4,"episodeNumbers":[7]},{"provider":"tvdb_show","id":"313488","scope":"s4","seasonNumber":4,"episodeNumbers":[7]}],"link":"103335","synopsis":"临时工们开始对碧游村展开行动，战斗正式打响。他们与碧游村的异人激烈交锋，老孟操控动物作战，展现出强大的控场能力；冯宝宝凭借强悍的身体素质和独特的招式，在敌群中横冲直撞。战斗中，陈朵的过往经历进一步展现，她自幼被当作蛊童，在痛苦中成长，其悲惨身世让老孟等人心生怜悯，也让这场战斗变得更加复杂。","thumbnail":"https://image.tmdb.org/t/p/w300/pJ7aUkT2yl8W2BtDPddSSgyohJQ.jpg"},{"title":"Episodio 8","episodeNumber":8,"sourceEpisodeNumber":8,"seasonNumber":4,"externalMappings":[{"provider":"anidb","id":"16719","scope":"R","episodeNumbers":[8]},{"provider":"anilist","id":"122631","episodeNumbers":[8]},{"provider":"mal","id":"49915","episodeNumbers":[8]},{"provider":"tmdb_show","id":"67063","scope":"s4","seasonNumber":4,"episodeNumbers":[8]},{"provider":"tvdb_show","id":"313488","scope":"s4","seasonNumber":4,"episodeNumbers":[8]}],"link":"103336","synopsis":"战斗愈发激烈，马仙洪亲自参与其中，他利用神机百炼制造的各种法器给临时工们带来诸多麻烦。王也和诸葛青也被卷入战斗，王也展示出强大的实力，与诸葛青一同应对马仙洪及其手下。期间，马仙洪向王也和诸葛青进一步阐述修身炉的原理和他的理想，试图让他们理解自己。而陈朵在面对昔日同事和碧游村众人时，内心矛盾不断加剧，不知该如何抉择。","thumbnail":"https://image.tmdb.org/t/p/w300/yyHpK7shf3OdwcfLsinJUdPTVm1.jpg"},{"title":"Episodio 9","episodeNumber":9,"sourceEpisodeNumber":9,"seasonNumber":4,"externalMappings":[{"provider":"anidb","id":"16719","scope":"R","episodeNumbers":[9]},{"provider":"anilist","id":"122631","episodeNumbers":[9]},{"provider":"mal","id":"49915","episodeNumbers":[9]},{"provider":"tmdb_show","id":"67063","scope":"s4","seasonNumber":4,"episodeNumbers":[9]},{"provider":"tvdb_show","id":"313488","scope":"s4","seasonNumber":4,"episodeNumbers":[9]}],"link":"103337","synopsis":"临时工们与马仙洪一方的战斗进入白热化阶段。张楚岚在战斗中不断分析局势，寻找破局之法，他发现陈朵对自由选择有着强烈渴望。肖自在、王震球等临时工也各自发挥优势，与碧游村异人展开殊死搏斗，双方都拼尽全力，战场一片狼藉。","thumbnail":"https://image.tmdb.org/t/p/w300/l2Zdp76sKcoXZoT4PkX3VZqzL3m.jpg"},{"title":"Episodio 10","episodeNumber":10,"sourceEpisodeNumber":10,"seasonNumber":4,"externalMappings":[{"provider":"anidb","id":"16719","scope":"R","episodeNumbers":[10]},{"provider":"anilist","id":"122631","episodeNumbers":[10]},{"provider":"mal","id":"49915","episodeNumbers":[10]},{"provider":"tmdb_show","id":"67063","scope":"s4","seasonNumber":4,"episodeNumbers":[10]},{"provider":"tvdb_show","id":"313488","scope":"s4","seasonNumber":4,"episodeNumbers":[10]}],"link":"103338","synopsis":"陈朵回忆起更多与廖忠相关的过往。廖忠虽将她从蛊童的悲惨命运中救出，引导她拥有人性，但也在一定程度上对她进行着控制。马仙洪让陈朵明白人生有多种选择后，她对廖忠的 “控制” 产生抵触。最终，陈朵在与廖忠的冲突中，选择与他同归于尽，不过在马仙洪的帮助和廖忠的爱意下，陈朵存活下来，但内心更加迷茫痛苦。","thumbnail":"https://image.tmdb.org/t/p/w300/A0IANmhAc5ZZyDlE1zfqc1IlKVG.jpg"},{"title":"Episodio 11","episodeNumber":11,"sourceEpisodeNumber":11,"seasonNumber":4,"externalMappings":[{"provider":"anidb","id":"16719","scope":"R","episodeNumbers":[11]},{"provider":"anilist","id":"122631","episodeNumbers":[11]},{"provider":"mal","id":"49915","episodeNumbers":[11]},{"provider":"tmdb_show","id":"67063","scope":"s4","seasonNumber":4,"episodeNumbers":[11]},{"provider":"tvdb_show","id":"313488","scope":"s4","seasonNumber":4,"episodeNumbers":[11]}],"link":"103339","synopsis":"战斗接近尾声，陈朵的内心挣扎达到顶点。张楚岚深知陈朵渴望自由选择，试图引导她做出决定。其他临时工们也在清理剩余的抵抗力量，碧游村逐渐被控制。马仙洪看着自己的村子被破坏，却也无力回天，只能眼睁睁看着局势发展。","thumbnail":"https://image.tmdb.org/t/p/w300/j5gXTmu5NX3FoYYgzCny0eeXNvR.jpg"},{"title":"Episodio 12","episodeNumber":12,"sourceEpisodeNumber":12,"seasonNumber":4,"externalMappings":[{"provider":"anidb","id":"16719","scope":"R","episodeNumbers":[12]},{"provider":"anilist","id":"122631","episodeNumbers":[12]},{"provider":"mal","id":"49915","episodeNumbers":[12]},{"provider":"tmdb_show","id":"67063","scope":"s4","seasonNumber":4,"episodeNumbers":[12]},{"provider":"tvdb_show","id":"313488","scope":"s4","seasonNumber":4,"episodeNumbers":[12]}],"link":"103340","synopsis":"张楚岚给予陈朵自由选择的权利，陈朵最终选择了死亡。她带着幸福的笑颜在人流涌动的大街上离世，结束了自己悲惨而又充满挣扎的一生。碧游村之战以临时工们完成任务告终，马仙洪被擒获（后被救走），大部分上根器被公司抓获，碧游村被摧毁，临时工们也因出色完成任务，暂时保住了各自地区对临时工的控制权。","thumbnail":"https://image.tmdb.org/t/p/w300/wyMdqHjOa7wsGVi2kchejnNz2vN.jpg"}],"sourceIds":{"anilistId":122631,"malId":49915},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-28T07:48:11Z","sourceDescriptors":["anilist:122631","mal:49915"],"targets":[{"provider":"anidb","id":"16719","scope":"R","ranges":{"1-12":"1-12"}},{"provider":"anilist","id":"122631","ranges":{"1-12":"1-12"}},{"provider":"mal","id":"49915","ranges":{"1-12":"1-12"}},{"provider":"tmdb_show","id":"67063","scope":"s4","ranges":{"1-12":"1-12"}},{"provider":"tvdb_show","id":"313488","scope":"s4","ranges":{"1-12":"1-12"}}]},"sourceMetadata":{"info":{"id":7295,"title":"Yi Ren Zhi Xia 4","title_eng":"Hitori no Shita: The Outcast 4","slug":"hitori-no-shita-the-outcast-4","plot":"Quarta stagione di Hitori no Shita: The Outcast","type":"ONA","status":"Terminato","date":"2021","studio":"Qiyuan Yinghua","dub":0,"mal_id":49915,"anilist_id":122631,"imageurl":"https://img.animeunity.co/anime/bx122631-YLTfCEy