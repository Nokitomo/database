ntato un discepolo di arti marziali, anche se nel migliore dei casi decente. Mentre si allena da solo in montagna, trova una pietra di meteorite caduta che si fonde con il suo corpo, permettendogli di imparare le arti interne. Con il suo nuovo talento, Qin Yu può finalmente essere utile a suo padre e al loro regno. Tuttavia, dopo aver trovato la misteriosa pietra meteorica ha alcune battute d’arresto.","date":"2018","episodes_count":12,"episodes_length":24,"author":" ","created_at":"2020-02-25 14:40:51","status":"Terminato","imageurl_cover":"","type":"ONA","slug":"legend-of-immortals","title_eng":"Legend of Immortals","day":"Indeterminato","favorites":153,"score":"7.95","visite":136966,"studio":"Shanghai Foch Film Culture Investment","dub":0,"always_home":0,"members":802,"cover":null,"anilist_id":105626,"season":"Autunno","title_it":null,"mal_id":38491,"crunchy_id":null,"netflix_id":null,"prime_id":null,"disney_id":null,"pivot":{"anime_id":7610,"related_id":2098,"number":1}},{"id":2443,"user_id":2,"title":"Xing Chen Bian: Yu Li Cang Hai","imageurl":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/bx119938-2C7bla1mTA6R.jpg","plot":"Seconda stagione di Xing Chen Bian","date":"2020","episodes_count":12,"episodes_length":25,"author":" ","created_at":"2020-07-03 12:03:29","status":"Terminato","imageurl_cover":"","type":"ONA","slug":"legend-of-immortals-2","title_eng":"Legend of Immortals 2","day":"Indeterminato","favorites":55,"score":"8.00","visite":87509,"studio":"Shanghai Foch Film Culture Investment","dub":0,"always_home":1,"members":292,"cover":null,"anilist_id":119938,"season":"Primavera","title_it":null,"mal_id":41528,"crunchy_id":null,"netflix_id":null,"prime_id":null,"disney_id":null,"pivot":{"anime_id":7610,"related_id":2443,"number":1}},{"id":3215,"user_id":2,"title":"Xing Chen Bian: Xingchen Yao Hai","imageurl":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/bx122652-Ie2VIwDmL34r.jpg","plot":"Terza stagione di Xing Chen Bian","d