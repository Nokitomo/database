crunchy_id":null,"netflix_id":null,"prime_id":null,"disney_id":null,"genres":[{"id":51,"name":"Action","pivot":{"anime_id":5758,"genre_id":51}},{"id":9,"name":"Fantasy","pivot":{"anime_id":5758,"genre_id":9}},{"id":42,"name":"Supernatural","pivot":{"anime_id":5758,"genre_id":42}}],"related":[{"id":1191,"user_id":78495,"title":"Garo: Honoo no Kokuin","imageurl":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/bx20753-62eogj8hzT6h.jpg","plot":"Garo: Honoo no kokuin si apre con una caccia alle streghe su larga scala lanciata dal consigliere reale del regno di Valiante contro cavalieri e sacerdoti Makai, presunti protettori del popolo. Anna, una sacerdotessa Makai condannata al rogo, da alla luce il piccolo Leon Lewis. Il bambino viene tratto in salvo dal padre Herman, un cavaliere Makai. Una volta cresciuto secondo i valori della cavalleria, Leon ottiene l'armatura d'oro di Garo. Intanto, approfittando della malattia del sovrano, con un golpe il consigliere prende il governo del paese, mandando in esilio il giovane principe ereditario, Alfonso San Valiante, e sua madre, la regina. Al principe non resta che andare in cerca del mitico cavaliere dorato per poter riconquistare il regno'","date":"2014","episodes_count":24,"episodes_length":24,"author":" ","created_at":"2019-07-20 23:24:52","status":"Terminato","imageurl_cover":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/20753-bZjni2cTv8uG.jpg","type":"TV","slug":"garo-the-animation","title_eng":"Garo: The Animation","day":"Venerdì","favorites":99,"score":"7.38","visite":94583,"studio":"MAPPA","dub":0,"always_home":0,"members":715,"cover":null,"anilist_id":20753,"season":"Autunno","title_it":null,"mal_id":23311,"crunchy_id":null,"netflix_id":null,"prime_id":null,"disney_id":null,"pivot":{"anime_id":5758,"related_id":1191,"number":1}},{"id":6855,"user_id":2,"title":"Garo: Guren no Tsuki","imageurl":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/b21277-7OUgZPMaUyk1.png","plot":"Durante l'epoca Heian (794-1185) seguiamo le avventure del nuovo \"Garo\", ovvero Raikou il più potente guerriero Makai. Questi guerrieri, grazie al loro potere, eseguono missioni per eliminare le forze malefiche che cercano di distruggere l'umanità. Nella sua lotta lui è accompagnato dalla sacerdotessa Seimei e dal suo fedele servitore Kintoki.","date":"2015","episodes_count":23,"episodes_length":24,"author":" ","created_at":"2025-07-08 23:42:05","status":"Terminato","imageurl_cover":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/21277-V6dVZ4aHV2N4.jpg","type":"TV","slug":"garo-crimson-moon","title_eng":"Garo: Crimson Moon","day":"Venerdì","favorites":4,"score":"6.80","visite":5590,"studio":"MAPPA","dub":0,"always_home":0,"members":32,"cover":null,"anilist_id":21277,"season":"Autunno","title_it":null,"mal_id":28537,"crunchy_id":null,"netflix_id":null,"prime_id":null,"disney_id":null,"pivot":{"anime_id":5758,"related_id":6855,"number":1}},{"id":6854,"user_id":2,"title":"Garo: Guren no Tsuki Special","imageurl":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/nx102429-Zh1cvz9Y5FW6.jpg","plot":"Episodio 24 di Garo: Guren no Tsuki","date":"2016","episodes_count":1,"episodes_length":23,"author":" ","created_at":"2025-07-08 23:41:27","status":"Terminato","imageurl_cover":"","type":"Special","slug":"garo-crimson-moon-the-butterfly-of-time","title_eng":"Garo: Crimson Moon - The Butterfly of Time","day":"Indeterminato","favorites":2,"score":"7.33","visite":2537,"studio":"MAPPA","dub":0,"always_home":0,"members":13,"cover":null,"anilist_id":102429,"season":"Estate","title_it":null,"mal_id":33709,"crunchy_id":null,"netflix_id":null,"prime_id":null,"disney_id":null,"pivot":{"anime_id":5758,"related_id":6854,"number":1}},{"id":335,"user_id":2,"title":"Garo Movie: Divine Flame","imageurl":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/bx21426-VXIooRCA91lv.png","plot":"León, che ha ricevuto il nome di Golden Knight \"GARO\" si dedica all'addestramento di un giovane Makai Knight per la nuova generazione, insieme al Principe Alfonso del Regno di Valiante. Ad un certo punto ricevono l'ordine di sterminare i più begli Horror al mondo che risiedono nel vicino paese Vazelia. Allo stesso tempo, un giovane Makai Knight per la nuova generazione viene rapito da un individuo sconosciuto. León li insegue disperatamente, solo per trovarsi circorndato dai suoi nemici in un vicolo cieco, Così, un Makai Knight di nome Dario che si riteneva scomparso da tempo, appare improvvisamente e lo salva. Sotto la sua guida, León viene portato nella città dove incontra una persona completamente inaspettata!","date":"2016","episodes_count":1,"episodes_length":78,"author":" ","created_at":"2018-11-27 18:26:36","status":"Terminato","imageurl_cover":"","type":"Movie","slug":"garo-divine-flame","title_eng":"Garo: Divine Flame","day":"Venerdì","favorites":35,"score":"7.81","visite":22089,"studio":"MAPPA","dub":0,"always_home":0,"members":205,"cover":null,"anilist_id":21426,"season":"Primavera","title_it":null,"mal_id":28539,"crunchy_id":null,"netflix_id":null,"prime_id":null,"disney_id":null,"pivot":{"anime_id":5758,"related_id":335,"number":1}},{"id":2662,"user_id":78495,"title":"GARO -VANISHING LINE-","imageurl":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/b99796-rzZSKHBRIn6E.png","plot":"La prosperità di Russel City è minacciata da una pericolosa cospirazione. Un uomo chiamato Sword è il primo a ricevere una soffiata riguardo al sordido complotto e, per fermarlo, si lancia in una guerra di spionaggio. L'unico indizio che ha in mano è la parola d'ordine “El Dorado”. Durante le indagini incontra Sophie; la ragazza è orfana e alla ricerca del fratello maggiore scomparso. Qual è il collegamento tra “El Dorado”, Sophie e Sword? L'indagine si trasforma presto in una battaglia, quella contro i mostruosi Horrors.","date":"2017","episodes_count":24,"episodes_length":24,"author":" ","created_at":"2020-08-07 16:11:15","stat