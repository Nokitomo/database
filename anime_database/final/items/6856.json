:"R","episodeNumbers":[1]},{"provider":"anilist","id":"163270","episodeNumbers":[1]},{"provider":"mal","id":"54900","episodeNumbers":[1]},{"provider":"tmdb_show","id":"223500","scope":"s1","seasonNumber":1,"episodeNumbers":[1]},{"provider":"tvdb_show","id":"433088","scope":"s1","seasonNumber":1,"episodeNumbers":[1]}],"link":"98958","synopsis":"An admirer of strong people with a complete disinterest in the weak, Haruka Sakura, a loner and delinquent high school student, aims to be a fighter at the top of Furin High School. Coming from outside the city, Sakura enrolls in Furin High School, infamous for its delinquents.","thumbnail":"https://image.tmdb.org/t/p/w300/g84xbY09pycSbUHIf37ehvtruoL.jpg"},{"title":"L'eroe che ammiro","episodeNumber":2,"sourceEpisodeNumber":2,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"17963","scope":"R","episodeNumbers":[2]},{"provider":"anilist","id":"163270","episodeNumbers":[2]},{"provider":"mal","id":"54900","episodeNumbers":[2]},{"provider":"tmdb_show","id":"223500","scope":"s1","seasonNumber":1,"episodeNumbers":[2]},{"provider":"tvdb_show","id":"433088","scope":"s1","seasonNumber":1,"episodeNumbers":[2]}],"link":"98959","synopsis":"It is the morning of the school entrance ceremony, and Furin High School has transformed into a group that protects the town now known as the \"Chime of the Wind Breaker\" — Bofurin.","thumbnail":"https://image.tmdb.org/t/p/w300/9Ld4WJiU31CZKn4kj3iiajlVMg3.jpg"},{"title":"Colui che ha raggiunto la vetta","episodeNumber":3,"sourceEpisodeNumber":3,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"17963","scope":"R","episodeNumbers":[3]},{"provider":"anilist","id":"163270","episodeNumbers":[3]},{"provider":"mal","id":"54900","episodeNumbers":[3]},{"provider":"tmdb_show","id":"223500","scope":"s1","seasonNumber":1,"episodeNumbers":[3]},{"provider":"tvdb_show","id":"433088","scope":"s1","seasonNumber":1,"episodeNumbers":[3]}],"link":"98960","synopsis":"Furin High School's first-year Class 1 is infamous for its group of strong fighters.\n\nOne of the students in the class, Kyotaro Sugishita, becomes furious with what Sakura said and throws a punch at him. The two begin a spectacular fight, ignoring an aloof Hayato Suo, who's carefully watching the fight, and Nirei, who's now panicking.\n\nA tremendously loud voice echoes throughout the school, interrupting the fight between the two young men. The owner of that voice that instantly changed the mood of the entire school is none other than Umemiya, the Representative of Bofurin. Sakura and the rest look nervously up at the speakers to hear Umemiya say something completely unexpected.","thumbnail":"https://image.tmdb.org/t/p/w300/jDCzX14ewVMUDKeE0lNkUGWUaer.jpg"},{"title":"Scontro","episodeNumber":4,"sourceEpisodeNumber":4,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"17963","scope":"R","episodeNumbers":[4]},{"provider":"anilist","id":"163270","episodeNumbers":[4]},{"provider":"mal","id":"54900","episodeNumbers":[4]},{"provider":"tmdb_show","id":"223500","scope":"s1","seasonNumber":1,"episodeNumbers":[4]},{"provider":"tvdb_show","id":"433088","scope":"s1","seasonNumber":1,"episodeNumbers":[4]}],"link":"98961","synopsis":"A fight breaks out between Bofurin and Shishitoren as Bofurin tries to protect the town's middle schoolers. Sakura receives a declaration of war from the group's second-in-command, Jo Togame. Sakura and one of the Four Kings of Bofurin, Toma Hiragi, tell Umemiya what happened.","thumbnail":"https://image.tmdb.org/t/p/w300/zkegatnupvc45ilhARSSaH8ghbC.jpg"},{"title":"L'uomo dal cuore tenero","episodeNumber":5,"sourceEpisodeNumber":5,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"17963","scope":"R","episodeNumbers":[5]},{"provider":"anilist","id":"163270","episodeNumbers":[5]},{"provider":"mal","id":"54900","episodeNumbers":[5]},{"provider":"tmdb_show","id":"223500","scope":"s1","seasonNumber":1,"episodeNumbers":[5]},{"provider":"tvdb_show","id":"433088","scope":"s1","seasonNumber":1,"episodeNumbers":[5]}],"link":"98962","synopsis":"\"That’s why I'm going to take all of Furin…and you for myself!\" declares Shishitoren's leader, Choji Tomiyama, as he makes his way onto Furin High School grounds. Finally, it's a one-on-one showdown between Bofurin and Shishitoren!","thumbnail":"https://image.tmdb.org/t/p/w300/qSVvOx05fLB0YuuCvz5wkQEMcup.jpg"},{"title":"Seguire le sue orme","episodeNumber":6,"sourceEpisodeNumber":6,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"17963","scope":"R","episodeNumbers":[6]},{"provider":"anilist","id":"163270","episodeNumbers":[6]},{"provider":"mal","id":"54900","episodeNumbers":[6]},{"provider":"tmdb_show","id":"223500","scope":"s1","seasonNumber":1,"episodeNumbers":[6]},{"provider":"tvdb_show","id":"433088","scope":"s1","seasonNumber":1,"episodeNumbers":[6]}],"link":"98963","synopsis":"Tomiyama and Togame, far from worrying about their teammate who lost the battle, expel him from their team. While this peculiar spectacle shakes Sakura and the rest, Suo becomes unexpectedly emotional and wins against Minoru Kanuma, earning another win for Bofurin.","thumbnail":"https://image.tmdb.org/t/p/w300/AjByIqC431kE3r4XXAxogyvPOwg.jpg"},{"title":"Una sfida da vincere","episodeNumber":7,"sourceEpisodeNumber":7,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"17963","scope":"R","episodeNumbers":[7]},{"provider":"anilist","id":"163270","episodeNumbers":[7]},{"provider":"mal","id":"54900","episodeNumbers":[7]},{"provider":"tmdb_show","id":"223500","scope":"s1","seasonNumber":1,"episodeNumbers":[7]},{"provider":"tvdb_show","id":"433088","scope":"s1","seasonNumber":1,"episodeNumbers":[7]}],"link":"98964","synopsis":"It’s now time for the battle of those second-in-command: Sakura versus Togame — a fight that will set things on fire!","thumbnail":"https://image.tmdb.org/t/p/w300/nceIP73rvOb8v2suNmmJGmNcYGe.jpg"},{"title":"Eredita quei pensieri","episodeNumber":8,"sourceEpisodeNumber":8,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"17963","scope":"R","episodeNumbers":[8]},{"provider":"anilist","id":"163270","episodeNumbers":[8]},{"provider":"mal","id":"54900","episodeNumbers":[8]},{"provider":"tmdb_show","id":"223500","scope":"s1","seasonNumber":1,"episodeNumbers":[8]},{"provider":"tvdb_show","id":"433088","scope":"s1","seasonNumber":1,"episodeNumbers":[8]}],"link":"98965","synopsis":"Togame can no longer hide the fact he's feeling lost. He remembers when he met Tomiyama, the fun days he had with Shishitoren, how the team changed when Tomiyama became the leader, and the things he's done himself.","thumbnail":"https://image.tmdb.org/t/p/w300/7azHDs1BZFgDhQcdMCZ1MCJFU47.jpg"},{"title":"Lo stile Umemiya","episodeNumber":9,"sourceEpisodeNumber":9,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"17963","scope":"R","episodeNumbers":[9]},{"provider":"anilist","id":"163270","episodeNumbers":[9]},{"provider":"mal","id":"54900","episodeNumbers":[9]},{"provider":"tmdb_show","id":"223500","scope":"s1","seasonNumber":1,"episodeNumbers":[9]},{"provider":"tvdb_show","id":"433088","scope":"s1","seasonNumber":1,"episodeNumbers":[9]}],"link":"98966","synopsis":"It's now time for a one-on-one fight between Umemiya and Tomiyama. Tomiyama believed that by winning against Umemiya, he would obtain Furin High School, freedom, and a sense of fun that would rival no other.","thumbnail":"https://image.tmdb.org/t/p/w300/h3A3Ak6aSnVM3R5Bntlt8p1nNXw.jpg"},{"title":"Conversazione","episodeNumber":10,"sourceEpisodeNumber":10,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"17963","scope":"R","episodeNumbers":[10]},{"provider":"anilist","id":"163270","episodeNumbers":[10]},{"provider":"mal","id":"54900","episodeNumbers":[10]},{"provider":"tmdb_show","id":"223500","scope":"s1","seasonNumber":1,"episodeNumbers":[10]},{"provider":"tvdb_show","id":"433088","scope":"s1","seasonNumber":1,"episodeNumbers":[10]}],"link":"98967","synopsis":"Admitting defeat, Tomiyama tries to pass Shishitoren on to Umemiya — to which Umemiya declares, \"Instead of taking over your team, we'll be friends!\" Bofurin and Shishitoren are dumbfounded at this turn of events but talks progress, food is brought, and a celebratory afterparty starts.","thumbnail":"https://image.tmdb.org/t/p/w300/biWhvQJFdMDtWESbtPjeVPibF0n.jpg"},{"title":"Un nuovo amico","episodeNumber":11,"sourceEpisodeNumber":11,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"17963","scope":"R","episodeNumbers":[11]},{"provider":"anilist","id":"163270","episodeNumbers":[11]},{"provider":"mal","id":"54900","episodeNumbers":[11]},{"provider":"tmdb_show","id":"223500","scope":"s1","seasonNumber":1,"episodeNumbers":[11]},{"provider":"tvdb_show","id":"433088","scope":"s1","seasonNumber":1,"episodeNumbers":[11]}],"link":"98968","synopsis":"With the fights against Shishitoren over, Class 1 enthusiastically welcomes Sakura, Nirei, and Suo's return. Their classmates, brimming with interest in the details of the fights, surround them, asking questions. Sakura can't hide his bashfulness.","thumbnail":"https://image.tmdb.org/t/p/w300/2okNdGHLbTzb5KdY9kNWkEV19GE.jpg"},{"title":"Colui su cui si può contare","episodeNumber":12,"sourceEpisodeNumber":12,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"17963","scope":"R","episodeNumbers":[12]},{"provider":"anilist","id":"163270","episodeNumbers":[12]},{"provider":"mal","id":"54900","episodeNumbers":[12]},{"provider":"tmdb_show","id":"223500","scope":"s1","seasonNumber":1,"episodeNumbers":[12]},{"provider":"tvdb_show","id":"433088","scope":"s1","seasonNumber":1,"episodeNumbers":[12]}],"link":"98969","synopsis":"Ren Kaji, Yuto Kusumi, and Takeshi Enomoto, second-year students from the Tamon Team, start their ruling on who will be Grade Captain for first-year Class 1. Suo is the first to raise his hand, immediately nominating Sakura as the other classmates vote for him one after the other.","thumbnail":"https://image.tmdb.org/t/p/w300/ayihh6LIUKJgHPmSZFu04C3Fbto.jpg"},{"title":"Per il bene di un amico","episodeNumber":13,"sourceEpisodeNumber":13,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"17963","scope":"R","episodeNumbers":[13]},{"provider":"anilist","id":"163270","episodeNumbers":[13]},{"provider":"mal","id":"54900","episodeNumbers":[13]},{"provider":"tmdb_show","id":"223500","scope":"s1","seasonNumber":1,"episodeNumbers":[13]},{"provider":"tvdb_show","id":"433088","scope":"s1","seasonNumber":1,"episodeNumbers":[13]}],"link":"98970","synopsis":"Sakura, Nirei, and Suo finish their meeting with Umemiya, the other members of the Four Kings, and other prominent leading figures and join up with Kiryu and Tsugeura on their way home.","thumbnail":"https://image.tmdb.org/t/p/w300/rNIv35v842nTpwUiOSHePaCRwOO.jpg"}],"sourceIds":{"anilistId":163270,"malId":54900},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-29T07:54:59Z","sourceDescriptors":["anilist:163270","mal:54900"],"targets":[{"provider":"anidb","id":"17963","scope":"R","ranges":{"1-13":"1-13"}},{"provider":"anidb","id":"18718","scope":"R"},{"provider":"anilist","id":"163270","ranges":{"1-13":"1-13"}},{"provider":"anilist","id":"178680"},{"provider":"mal","id":"54900","ranges":{"1-13":"1-13"}},{"provider":"mal","id":"59160"},{"provider":"tmdb_show","id":"223500","scope":"s1","ranges":{"1-13":"1-13"}},{"provider":"tvdb_show","id":"433088","scope":"s1","ranges":{"1-13":"1-13"}},{"provider":"tvdb_show","id":"433088","scope":"s2"}]},"sourceMetadata":{"info":{"id":6856,"title":"Wind Breaker (ITA)","title_eng":"Wind Breaker (ITA)","slug":"wind-breaker-ita","plot":"La Fuurin è una scuola nota per avere gli studenti con i peggiori rendimenti scolastici e i combattenti più forti in circolazione. Volendo diventare il più forte di tutti e venire considerato alla stregua di un eroe, Sakura Haruka si unisce a un gruppo nato per proteggere la città.","type":"TV","statu