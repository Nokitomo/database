JEEsHUeVC2mc8dLaeBLQ.jpg"},{"title":"Episodio 2","episodeNumber":2,"sourceEpisodeNumber":2,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"17078","scope":"R","episodeNumbers":[2]},{"provider":"anilist","id":"143085","episodeNumbers":[2]},{"provider":"mal","id":"50664","episodeNumbers":[2]},{"provider":"tmdb_show","id":"123525","scope":"s2","seasonNumber":2,"episodeNumbers":[2]},{"provider":"tvdb_show","id":"401915","scope":"s2","seasonNumber":2,"episodeNumbers":[2]}],"link":"74321","synopsis":"Will and Menel investigate why the seasons are not changing as they should in the surrounding forest. Two wise Lords of the Forest may have the answers they seek... as well as a warning of what's yet to come.","thumbnail":"https://image.tmdb.org/t/p/w300/1D8P4RV7kT2HzkCELtp5OawpGvc.jpg"},{"title":"Episodio 3","episodeNumber":3,"sourceEpisodeNumber":3,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"17078","scope":"R","episodeNumbers":[3]},{"provider":"anilist","id":"143085","episodeNumbers":[3]},{"provider":"mal","id":"50664","episodeNumbers":[3]},{"provider":"tmdb_show","id":"123525","scope":"s2","seasonNumber":2,"episodeNumbers":[3]},{"provider":"tvdb_show","id":"401915","scope":"s2","seasonNumber":2,"episodeNumbers":[3]}],"link":"74415","synopsis":"Will talks to some of the dwarfs who have made their new home in Torch Port and learns about the history of the Rust Mountains.","thumbnail":"https://image.tmdb.org/t/p/w300/zmD3mZqgf7G7nN6anNPsN7Bhev0.jpg"},{"title":"Episodio 4","episodeNumber":4,"sourceEpisodeNumber":4,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"17078","scope":"R","episodeNumbers":[4]},{"provider":"anilist","id":"143085","episodeNumbers":[4]},{"provider":"mal","id":"50664","episodeNumbers":[4]},{"provider":"tmdb_show","id":"123525","scope":"s2","seasonNumber":2,"episodeNumbers":[4]},{"provider":"tvdb_show","id":"401915","scope":"s2","seasonNumber":2,"episodeNumbers":[4]}],"link":"74531","synopsis":"Ru begins his training under Will and Menel. He tells Will that he's eager to learn from him what courage is and what it means to be a warrior, but Will himself is struggling with the meaning of courage as he recalls the Lord of Holly's prophecy.","thumbnail":"https://image.tmdb.org/t/p/w300/zI93DeMruxrwLU75gNcF17lPC2r.jpg"},{"title":"Episodio 5","episodeNumber":5,"sourceEpisodeNumber":5,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"17078","scope":"R","episodeNumbers":[5]},{"provider":"anilist","id":"143085","episodeNumbers":[5]},{"provider":"mal","id":"50664","episodeNumbers":[5]},{"provider":"tmdb_show","id":"123525","scope":"s2","seasonNumber":2,"episodeNumbers":[5]},{"provider":"tvdb_show","id":"401915","scope":"s2","seasonNumber":2,"episodeNumbers":[5]}],"link":"74654","synopsis":"Following reports of undead sightings in Beast Woods, Will and Ru find an old burial site where they encounter a Herald of Stagnate, god of the undead. It turns out the Herald was using the undead to lure Will there and convey a message to him...","thumbnail":"https://image.tmdb.org/t/p/w300/5q2kGAFljNz9fYCkirBk5By1zSk.jpg"},{"title":"Un breve ritorno a casa","episodeNumber":6,"sourceEpisodeNumber":6,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"17078","scope":"R","episodeNumbers":[6]},{"provider":"anilist","id":"143085","episodeNumbers":[6]},{"provider":"mal","id":"50664","episodeNumbers":[6]},{"provider":"tmdb_show","id":"123525","scope":"s2","seasonNumber":2,"episodeNumbers":[6]},{"provider":"tvdb_show","id":"401915","scope":"s2","seasonNumber":2,"episodeNumbers":[6]}],"link":"74847","synopsis":"Will and his companions set out for the Rust Mountains to fight the dragon Valacirca. On the way, they pass by the City of the Dead, so Will decides to stop and visit his old home.","thumbnail":"https://image.tmdb.org/t/p/w300/8jleX7IAoEZzOl7FXlh5g1m7B8e.jpg"},{"title":"Episodio 7","episodeNumber":7,"sourceEpisodeNumber":7,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"17078","scope":"R","episodeNumbers":[7]},{"provider":"anilist","id":"143085","episodeNumbers":[7]},{"provider":"mal","id":"50664","episodeNumbers":[7]},{"provider":"tmdb_show","id":"123525","scope":"s2","seasonNumber":2,"episodeNumbers":[7]},{"provider":"tvdb_show","id":"401915","scope":"s2","seasonNumber":2,"episodeNumbers":[7]}],"link":"75012","synopsis":"As the party rests in the City of the Dead, Gus warns Will about how dangerous Valacirca is and tells him it's okay to turn back. But Will's mind is made up. All Gus can do is send him on his way with a word of advice...","thumbnail":"https://image.tmdb.org/t/p/w300/rd09xygqsawI3vAm6XjMFjF5OfT.jpg"},{"title":"Episodio 8","episodeNumber":8,"sourceEpisodeNumber":8,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"17078","scope":"R","episodeNumbers":[8]},{"provider":"anilist","id":"143085","episodeNumbers":[8]},{"provider":"mal","id":"50664","episodeNumbers":[8]},{"provider":"tmdb_show","id":"123525","scope":"s2","seasonNumber":2,"episodeNumbers":[8]},{"provider":"tvdb_show","id":"401915","scope":"s2","seasonNumber":2,"episodeNumbers":[8]}],"link":"75167","synopsis":"Will's crew saves Dine, an elf, from a hydra's attack. Dine tells them that the dragon's miasma has tainted her homeland of Lothdor and sickened its people, so Will decides to go there and heal them.","thumbnail":"https://image.tmdb.org/t/p/w300/jqsL0XqnHEK79XRp9J7yuTMebZ5.jpg"},{"title":"Episodio 9","episodeNumber":9,"sourceEpisodeNumber":9,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"17078","scope":"R","episodeNumbers":[9]},{"provider":"anilist","id":"143085","episodeNumbers":[9]},{"provider":"mal","id":"50664","episodeNumbers":[9]},{"provider":"tmdb_show","id":"123525","scope":"s2","seasonNumber":2,"episodeNumbers":[9]},{"provider":"tvdb_show","id":"401915","scope":"s2","seasonNumber":2,"episodeNumbers":[9]}],"link":"75431","synopsis":"William and the others enter into the Iron Country. As they delve further in they begin to hear the sounds of clanking metal and footsteps as they approach the Hall of Stone. As they carefully make their way in they find a large group of undead dwarves.","thumbnail":"https://image.tmdb.org/t/p/w300/oR4IsBQyUk08nKpyF0dDifnHFTc.jpg"},{"title":"Episodio 10","episodeNumber":10,"sourceEpisodeNumber":10,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"17078","scope":"R","episodeNumbers":[10]},{"provider":"anilist","id":"143085","episodeNumbers":[10]},{"provider":"mal","id":"50664","episodeNumbers":[10]},{"provider":"tmdb_show","id":"123525","scope":"s2","seasonNumber":2,"episodeNumbers":[10]},{"provider":"tvdb_show","id":"401915","scope":"s2","seasonNumber":2,"episodeNumbers":[10]}],"link":"75704","synopsis":"When Will's party finally faces the overwhelming power of Valacirca, they prepare for a fight to the death... but then the dragon suddenly offers to become Will's servant. What is Valacirca thinking, and what choice is Will going to make?","thumbnail":"https://image.tmdb.org/t/p/w300/iRnu8Aofn93qafD3dHcbzYgDGbA.jpg"},{"title":"Episodio 11","episodeNumber":11,"sourceEpisodeNumber":11,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"17078","scope":"R","episodeNumbers":[11]},{"provider":"anilist","id":"143085","episodeNumbers":[11]},{"provider":"mal","id":"50664","episodeNumbers":[11]},{"provider":"tmdb_show","id":"123525","scope":"s2","seasonNumber":2,"episodeNumbers":[11]},{"provider":"tvdb_show","id":"401915","scope":"s2","seasonNumber":2,"episodeNumbers":[11]}],"link":"75895","synopsis":"The battle between Will and Valacirca rages on. Will has exhausted his strength and depleted his mana, his companions have fallen, and his beloved weapon, Pale Moon, is broken. Then, just when the situation is looking dire...","thumbnail":"https://image.tmdb.org/t/p/w300/eqCwjiuY5Ji6eb3PFPeQnW63PUh.jpg"},{"title":"Episodio 12","episodeNumber":12,"sourceEpisodeNumber":12,"seasonNumber":2,"externalMappings":[{"provider":"anidb