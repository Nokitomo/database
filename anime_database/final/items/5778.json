rie di eventi, e l'aiuto di uno degli scienziati prigionieri della Gang, fa sì che il robot gigante venga attivato e programmato a obbedire a Daisaku, che viene anche reclutato da Jūrō nell'organizzazione segreta Unicorn, la cui missione è difendere la Terra dagli invasori.","date":"1992","episodes_count":7,"episodes_length":49,"author":" ","created_at":"2025-03-14 21:33:08","status":"Terminato","imageurl_cover":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/2321-2XL84oxJ2xrt.jpg","type":"OVA","slug":"giant-robo-the-animation-the-day-the-earth-stood-still-ita","title_eng":"Giant Robo the Animation: The Day the Earth Stood Still (ITA)","day":"Indeterminato","favorites":28,"score":"7.44","visite":9566,"studio":"Phoenix Entertainment","dub":1,"always_home":0,"members":106,"cover":null,"anilist_id":2321,"season":"Estate","title_it":null,"mal_id":2321,"crunchy_id":null,"netflix_id":null,"prime_id":null,"disney_id":null,"pivot":{"anime_id":5778,"related_id":6272,"number":1}},{"id":6273,"user_id":2,"title":"Giant Robo Gaiden Ginrei","imageurl":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/bx2322-ponF6coqrn1g.png","plot":"OVA della serie Giant Robo the Animation: The Day the Earth Stood Still","date":"1994","episodes_count":3,"episodes_length":30,"author":" ","created_at":"2025-03-14 21:36:52","status":"Terminato","imageurl_cover":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/2322-EJqCvmRBE9Nh.jpg","type":"OVA","slug":"giant-robo-ginrei-special","title_eng":"Giant Robo: Ginrei Special","day":"Indeterminato","favorites":16,"score":"6.00","visite":12412,"studio":"Phoenix Entertainment","dub":0,"always_home":0,"members":46,"cover":null,"anilist_id":2322,"season":"Inverno","title_it":null,"mal_id":2322,"crunchy_id":null,"netflix_id":null,"prime_id":null,"disney_id":null,"pivot":{"anime_id":5778,"related_id":6273,"number":1}},{"id":5778,"user_id":2,"title":null,"imageurl":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/b31