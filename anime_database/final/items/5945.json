abilityStatus":"available","episodesLink":"5945|1|9"}]},"episodes":[{"title":"Episodio 1","episodeNumber":1,"sourceEpisodeNumber":1,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"14112","scope":"R","episodeNumbers":[1]},{"provider":"anilist","id":"101981","episodeNumbers":[1]},{"provider":"mal","id":"37281","episodeNumbers":[1]},{"provider":"tmdb_show","id":"81044","scope":"s1","seasonNumber":1,"episodeNumbers":[1]},{"provider":"tvdb_show","id":"349640","scope":"s1","seasonNumber":1,"episodeNumbers":[1]}],"link":"88414","synopsis":"俺はボロアパートに住む、冴えないフリーター・壮介。可愛くて巨乳の大家さん・由紀だけが心の癒し。\n\nでも２階の住人が床を毎日ドンドンしてきて…許せん！怒りに行ったら出てきたのは、これまた可愛い女の子・砂生。\n\nつい許しちゃった俺は、ついでに砂生でエロい妄想してたら…なんと天井が底抜けて、２階のあの子が落ちてきた！！\n\nしかもそのまま「俺」の真上へ…こんなのもう、ガマンできるわけねぇーっ！！","thumbnail":"https://image.tmdb.org/t/p/w300/eX1ZgXnWu57PaU7t7CsMmOANaoX.jpg"},{"title":"Episodio 2","episodeNumber":2,"sourceEpisodeNumber":2,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"14112","scope":"R","episodeNumbers":[2]},{"provider":"anilist","id":"101981","episodeNumbers":[2]},{"provider":"mal","id":"37281","episodeNumbers":[2]},{"provider":"tmdb_show","id":"81044","scope":"s1","seasonNumber":1,"episodeNumbers":[2]},{"provider":"tvdb_show","id":"349640","scope":"s1","seasonNumber":1,"episodeNumbers":[2]}],"link":"88415","synopsis":"砂生と密着してたのを由紀さんに見られて…完全に詰んだ俺。と思っていたら、大家として穴が空いた責任を取ると言い出し…！？\n\nなぜか由紀さんと同じ部屋で暮らすことに！\n\nだけど由紀さんの寝姿、胸とか尻とか無防備すぎる…っ！\n\nしかも寝相が悪すぎて、向こうからガンガン密着してくる始末！ここまでされたらもうたまんねぇーっ！\n\nちょっとくらいちょっかい出しても…俺、悪くないよねっ！？","thumbnail":"https://image.tmdb.org/t/p/w300/qcgyyf8BVSTNWCGI7OYsQDEkQ52.jpg"},{"title":"Episodio 3","episodeNumber":3,"sourceEpisodeNumber":3,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"14112","scope":"R","episodeNumbers":[3]},{"provider":"anilist","id":"101981","episodeNumbers":[3]},{"provider":"mal","id":"37281","episodeNumbers":[3]},{"provider":"tmdb_show","id":"81044","scope":"s1","seasonNumber":1,"episodeNumbers":[3]},{"provider":"tvdb_show","id":"349640","scope":"s1","seasonNumber":1,"episodeNumbers":[3]}],"link":"88416","synopsis":"由紀さんにイタズラしちゃって…部屋に境界線を引かれてしまった…。あの癒しが無くなるなんて嫌だ…と思いつつ、気まずい夜がまたやってくる…。もうエロいことは自粛しよう…と誓う俺だが、なんと天井の穴から砂生が降りてきたっ！しかもエロい格好で誘ってきて…！？隣に由紀さんいるのに…！バレたら終わりなのに…！でも、おねだり断るなんて男じゃない！しゃぁねぇ…！やってやるぜーっ！","thumbnail":"https://image.tmdb.org/t/p/w300/9uVECHCMWNCGyqRcNoA3LOrmvlq.jpg"},{"title":"Episodio 4","episodeNumber":4,"sourceEpisodeNumber":4,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"14112","scope":"R","episodeNumbers":[4]},{"provider":"anilist","id":"101981","episodeNumbers":[4]},{"provider":"mal","id":"37281","episodeNumbers":[4]},{"provider":"tmdb_show","id":"81044","scope":"s1","seasonNumber":1,"episodeNumbers":[4]},{"provider":"tvdb_show","id":"349640","scope":"s1","seasonNumber":1,"episodeNumbers":[4]}],"link":"88417","synopsis":"砂生が忘れてったパンツを由紀さんが見つけちゃって…問い詰められる俺。\n\n今度こそ終わりか…と思ったら、玄関から突然砂生の声が！\n\nそれに驚き転んだ拍子に、由紀さんの前ボタンが弾けて…ぽろりっ！？\n\nしかも砂生はパンツ探しに部屋へ入ろうとして…この状況、ヤバすぎる！\n\nとっさに由紀さんと押し入れに隠れた俺。だけど暗くて狭くて密着してたら…外に砂生がいるのに…またエロいことしたくなってきた…。","thumbnail":"https://image.tmdb.org/t/p/w300/esEVpAta0qK2z82n4QffgiG5PU6.jpg"},{"title":"Episodio 5","episodeNumber":5,"sourceEpisodeNumber":5,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"14112","scope":"R","episodeNumbers":[5]},{"provider":"anilist","id":"101981","episodeNumbers":[5]},{"provider":"mal","id":"37281","episodeNumbers":[5]},{"provider":"tmdb_show","id":"81044","scope":"s1","seasonNumber":1,"episodeNumbers":[5]},{"provider":"tvdb_show","id":"349640","scope":"s1","seasonNumber":1,"episodeNumbers":[5]}],"link":"88418","synopsis":"エロいことしすぎちゃった俺を監視するため、なぜか砂生まで一緒に寝ることに…。\n\n美女2人に挟まれて、寝れるわけねぇっ…！しかもお風呂に入ろうとしたら、そこにも砂生が！？\n\nごめん…っ！と退散しようとするも、一緒に入ろ？と誘われて…。\n\nそこまで言われて逃げられるか…っ！\n\n泡でぬるぬる！シャワーで責め責め！\n\nあんなとこやこんなとこまで、徹底的に洗いっこしてやるっ！","thumbnail":"https://image.tmdb.org/t/p/w300/zOZNaicrHtrraTX71dn6s38LcmT.jpg"},{"title":"Episodio 6","episodeNumber":6,"sourceEpisodeNumber":6,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"14112","scope":"R","episodeNumbers":[6]},{"provider":"anilist","id":"101981","episodeNumbers":[6]},{"provider":"mal","id":"37281","episodeNumbers":[6]},{"provider":"tmdb_show","id":"81044","scope":"s1","seasonNumber":1,"episodeNumbers":[6]},{"provider":"tvdb_show","id":"349640","scope":"s1","seasonNumber":1,"episodeNumbers":[6]}],"link":"88419","synopsis":"３人で温泉旅行に行くことになった俺達。\n\n露天風呂から聞こえてきた女子トークは…「３人で楽しいことしたい」っ！？３人でって…それってまさか…？今夜は絶対寝れねぇ…っ！\n\nなのに、夕飯食べたら砂生は早々に寝てて…由紀さんも酔っ払ってる…。だめだこりゃ…と思ってたら、浴衣のはだけた由紀さんが絡んできて…！？\n\n赤らんで汗ばむカラダがエロすぎる…っ！砂生を待たずして…始めちゃうってこと！？","thumbnail":"https://image.tmdb.org/t/p/w300/gBbFcgl1LBfVbjszrhRTeFqgWCb.jpg"},{"title":"Episodio 7","episodeNumber":7,"sourceEpisodeNumber":7,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"14112","scope":"R","episodeNumbers":[7]},{"provider":"anilist","id":"101981","episodeNumbers":[7]},{"provider":"mal","id":"37281","episodeNumbers":[7]},{"provider":"tmdb_show","id":"81044","scope":"s1","seasonNumber":1,"episodeNumbers":[7]},{"provider":"tvdb_show","id":"349640","scope":"s1","seasonNumber":1,"episodeNumbers":[7]}],"link":"88420","synopsis":"由紀さんと一緒に、砂生が主演の舞台を観に行くことに。\n\nいきなり結構な濡れ場を演じる砂生に、目が釘付けになる俺。\n\n隣を見ると、由紀さんも頬を赤らめてて…可愛い。\n\n我慢できずに手を出しちゃう俺だが、由紀さんもなぜか受け入れてくれて…まさか砂生に嫉妬してる…？\n\nバレないように声を抑え、砂生の演技と盛り上がりが重なるように…由紀さんと俺も高まっていき…。","thumbnail":"https://image.tmdb.org/t/p/w300/kaIr21pt0z7PnW3vz0w9PNDTAVb.jpg"},{"title":"Episodio 8","episodeNumber":8,"sourceEpisodeNumber":8,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"14112","scope":"R","episodeNumbers":[8]},{"provider":"anilist","id":"101981","episodeNumbers":[8]},{"provider":"mal","id":"37281","episodeNumbers":[8]},{"provider":"tmdb_show","id":"81044","scope":"s1","seasonNumber":1,"episodeNumbers":[8]},{"provider":"tvdb_show","id":"349640","scope":"s1","seasonNumber":1,"episodeNumbers":[8]}],"link":"88421","synopsis":"俺の幼なじみ・柚子の登場で、ますますカオスになっていく俺の生活…！\n\nしかも俺を取り合うために、４人で海水浴に行くことに！？美女3人の水着姿なんて…我慢できるわけねぇ…。\n\nさっそく柚子とは一緒の浮輪に入ることになってしまい…ぎゅうぎゅうに密着して、たまらん…っ！\n\nそれに嫉妬した砂生には、小屋に連れ込まれ…迫られてっ！？\n\nエロすぎて最高なんだけど…もう俺のカラダもたねぇよーっ！","thumbnail":"https://image.tmdb.org/t/p/w300/oSuJ7nN94KjwYs1VRPUCGpH8QUv.jpg"},{"title":"Episodio 9","episodeNumber":9,"sourceEpisodeNumber":9,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"14112","scope":"R","episodeNumbers":[9]},{"provider":"anilist","id":"101981","episodeNumbers":[9]},{"provider":"mal","id":"37281","episodeNumbers":[9]},{"provider":"tmdb_show","id":"81044","scope":"s1","seasonNumber":1,"episodeNumbers":[9]},{"provider":"tvdb_show","id":"349640","scope":"s1","seasonNumber":1,"episodeNumbers":[9]}],"link":"88422","synopsis":"他の２人とエロいことしたのバレちゃって…由紀さんにシャワー室へ連れ込まれた俺。\n\nいつになく積極的に迫る由紀さんにタジタジ…っ！だけど他の個室に砂生と柚子も入ってきて…！？\n\n壁越しの女子トークの中、砂生に俺への気持ちを聞かれた由紀さんはつい「あ…あんな人、大っ嫌い！」と答えて…。\n\nもう怒った！今度は俺から迫ってやるっ！皆にバレないよう耐える由紀さんを、激しく攻めて責めまくる！","thumbnail":"https://image.tmdb.org/t/p/w300/yQYlVoOSkbu300zzFevAw0QwBO8.jpg"}],"sourceIds":{"anilistId":101981,"malId":37281},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-29T07:54:59Z","sourceDescriptors":["anilist:101981","mal:37281"],"targets":[{"provider":"anidb","id":"14112","scope":"R","ranges":{"1-9":"1-9"}},{"provider":"anilist","id":"101981","ranges":{"1-9":"1-9"}},{"provider":"mal","id":"37281","ranges":{"1-9":"1-9"}},{"provider":"tmdb_show","id":"81044","scope":"s1","ranges":{"1-9":"1-9"}},{"provider":"tvdb_show","id":"349640","scope":"s1","ranges":{"1-9":"1-9"}}]},"sourceMetadata":{"info":{"id":5945,"title":"What She Fell on Was the Tip of My Dick","title_eng":"Joshiochi! 2-kai kara Onnanoko ga... Futtekita!?","slug":"joshiochi-2-kai-kara-onnanoko-ga-futtekita","plot":"Improvvisamente il precario soffitto cede e la bellissima ragazza del piano di sopra atterra proprio sul futon del (s)fortunato protagonista.","type":"TV Short","status":"Terminato","date":"2018","studio":"ark","dub":0,"mal_id":37281,"anilist_id":101981,"imageurl":"https://img.animeunity.co/anime/bx101981-f4nDbUB9GWv