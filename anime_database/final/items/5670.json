://image.tmdb.org/t/p/w300/rmkWDUQP5Afa3TLVNkH70OeAjWf.jpg"},{"title":"Tu vuoi scoprirlo","episodeNumber":2,"sourceEpisodeNumber":2,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"18344","scope":"R","episodeNumbers":[2]},{"provider":"anilist","id":"172190","episodeNumbers":[2]},{"provider":"mal","id":"57611","episodeNumbers":[2]},{"provider":"tmdb_show","id":"242143","scope":"s1","seasonNumber":1,"episodeNumbers":[2]},{"provider":"tvdb_show","id":"443726","scope":"s1","seasonNumber":1,"episodeNumbers":[2]}],"link":"86015","synopsis":"Un cucciolo di cane viene abbandonato davanti alla porta di Hitoyoshi, che nonostante le riserve della cameriera decide di adottarlo e prendersene cura.","thumbnail":"https://image.tmdb.org/t/p/w300/rbOxBDalSOU9jRYDAvb387K9UBw.jpg"},{"title":"Tu sei Yuki","episodeNumber":3,"sourceEpisodeNumber":3,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"18344","scope":"R","episodeNumbers":[3]},{"provider":"anilist","id":"172190","episodeNumbers":[3]},{"provider":"mal","id":"57611","episodeNumbers":[3]},{"provider":"tmdb_show","id":"242143","scope":"s1","seasonNumber":1,"episodeNumbers":[3]},{"provider":"tvdb_show","id":"443726","scope":"s1","seasonNumber":1,"episodeNumbers":[3]}],"link":"86232","synopsis":"Riko, la sorella di Hitoyoshi, si presenta a casa da lui per conoscere Agemochitaro e rimane estasiata da Yuki, che vuole rendere il soggetto della sua ricerca estiva!","thumbnail":"https://image.tmdb.org/t/p/w300/hTdGzmzLHCLEGDrpC8WJcDqi7xG.jpg"},{"title":"Episodio 4","episodeNumber":4,"sourceEpisodeNumber":4,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"18344","scope":"R","episodeNumbers":[4]},{"provider":"anilist","id":"172190","episodeNumbers":[4]},{"provider":"mal","id":"57611","episodeNumbers":[4]},{"provider":"tmdb_show","id":"242143","scope":"s1","seasonNumber":1,"episodeNumbers":[4]},{"provider":"tvdb_show","id":"443726","scope":"s1","seasonNumber":1,"episodeNumbers":[4]}],"link":"86354","synopsis":"To experience a \"normal\" school life, Yuki enrolls at the same school as Hitoyoshi. Seeing boys rush off, she finds out the school store sells a rare yakisoba bread. Yuki heads out the window, leaving Hitoyoshi to worry whether she'll fit in or not.","thumbnail":"https://image.tmdb.org/t/p/w300/4JovlqhzpQnmBw7OagqPNkXEYoH.jpg"},{"title":"Episodio 5","episodeNumber":5,"sourceEpisodeNumber":5,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"18344","scope":"R","episodeNumbers":[5]},{"provider":"anilist","id":"172190","episodeNumbers":[5]},{"provider":"mal","id":"57611","episodeNumbers":[5]},{"provider":"tmdb_show","id":"242143","scope":"s1","seasonNumber":1,"episodeNumbers":[5]},{"provider":"tvdb_show","id":"443726","scope":"s1","seasonNumber":1,"episodeNumbers":[5]}],"link":"86441","synopsis":"After the Nitta incident, Yuki decides to become Hitoyoshi's bodyguard, sticking to him 24/7. When she is distracted for a moment, a woman named Grace appears and takes Hitoyoshi hostage, seeking to kill Yuki for prestige and revealing her dark past.","thumbnail":"https://image.tmdb.org/t/p/w300/7CBrjgt18eYDjzZU6APBhvnZ50G.jpg"},{"title":"Episodio 6","episodeNumber":6,"sourceEpisodeNumber":6,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"18344","scope":"R","episodeNumbers":[6]},{"provider":"anilist","id":"172190","episodeNumbers":[6]},{"provider":"mal","id":"57611","episodeNumbers":[6]},{"provider":"tmdb_show","id":"242143","scope":"s1","seasonNumber":1,"episodeNumbers":[6]},{"provider":"tvdb_show","id":"443726","scope":"s1","seasonNumber":1,"episodeNumbers":[6]}],"link":"86542","synopsis":"Finding enjoyment in teasing the former assassin, Grace returns as a gym teacher. After much harassment, she clues in Hitoyoshi of the changes occurring to Yuki. He now wants to know more about the maid as he sees her working hard to be normal.","thumbnail":"https://image.tmdb.org/t/p/w300/faSFL14lRbDzO03m3eJDXrPnHyQ.jpg"},{"title":"Episodio 7","episodeNumber":7,"sourceEpisodeNumber":7,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"18344","scope":"R","episodeNumbers":[7]},{"provider":"anilist","id":"172190","episodeNumbers":[7]},{"provider":"mal","id":"57611","episodeNumbers":[7]},{"provider":"tmdb_show","id":"242143","scope":"s1","seasonNumber":1,"episodeNumbers":[7]},{"provider":"tvdb_show","id":"443726","scope":"s1","seasonNumber":1,"episodeNumbers":[7]}],"link":"86632","synopsis":"Yuki is shocked to discover that maid outfits aren't considered normal. To make her feel better, Hitoyoshi takes her shopping for normal clothes. With the town decorated for Halloween, Yuki's world opens to new experiences, such as finding out her fears.","thumbnail":"https://image.tmdb.org/t/p/w300/aUfWVb2sFmZHDO60VDjnVqJdlDu.jpg"},{"title":"Episodio 8","episodeNumber":8,"sourceEpisodeNumber":8,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"18344","scope":"R","episodeNumbers":[8]},{"provider":"anilist","id":"172190","episodeNumbers":[8]},{"provider":"mal","id":"57611","episodeNumbers":[8]},{"provider":"tmdb_show","id":"242143","scope":"s1","seasonNumber":1,"episodeNumbers":[8]},{"provider":"tvdb_show","id":"443726","scope":"s1","seasonNumber":1,"episodeNumbers":[8]}],"link":"86718","synopsis":"Yuki runs into misfortune as she finds out she won't be able to buy her favorite sauce for one week. With nightmares of the sauce and her sister, she must overcome challenges, including keeping her grades up to take part in the festivities at school.","thumbnail":"https://image.tmdb.org/t/p/w300/tJpkcNj4WzOdQA8BaEqTkj8CMWN.jpg"},{"title":"Episodio 9","episodeNumber":9,"sourceEpisodeNumber":9,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"18344","scope":"R","episodeNumbers":[9]},{"provider":"anilist","id":"172190","episodeNumbers":[9]},{"provider":"mal","id":"57611","episodeNumbers":[9]},{"provider":"tmdb_show","id":"242143","scope":"s1","seasonNumber":1,"episodeNumbers":[9]},{"provider":"tvdb_show","id":"443726","scope":"s1","seasonNumber":1,"episodeNumbers":[9]}],"link":"86814","synopsis":"A Cops and Robbers event is to take place at the Katsuda Festival at Hitoyoshi’s school. The prideful President Hikage aims to win 2 years in a row. However, Naka decides to help Yuki beat her brother for acknowledgement, but also to make a friend.","thumbnail":"https://image.tmdb.org/t/p/w300/mqgRdFguD9S7bM7ukwOxOdxNUMP.jpg"},{"title":"Episodio 10","episodeNumber":10,"sourceEpisodeNumber":10,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"18344","scope":"R","episodeNumbers":[10]},{"provider":"anilist","id":"172190","episodeNumbers":[10]},{"provider":"mal","id":"57611","episodeNumbers":[10]},{"provider":"tmdb_show","id":"242143","scope":"s1","seasonNumber":1,"episodeNumbers":[10]},{"provider":"tvdb_show","id":"443726","scope":"s1","seasonNumber":1,"episodeNumbers":[10]}],"link":"86947","synopsis":"Hitoyoshi is pleased to see Yuki has made a new friend, Naka, but receives unfortunate news from his father that makes him upset. To make him feel better, Riko and Yuki both plan something special for Christmas that's sure to cheer him up… or maybe not?","thumbnail":"https://image.tmdb.org/t/p/w300/yMVIfVPHH21lwkDjJg4AszktKt.jpg"},{"title":"Episodio 11","episodeNumber":11,"sourceEpisodeNumber":11,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"18344","scope":"R","episodeNumbers":[11]},{"provider":"anilist","id":"172190","episodeNumbers":[11]},{"provider":"mal","id":"57611","episodeNumbers":[11]},{"provider":"tmdb_show","id":"242143","scope":"s1","seasonNumber":1,"episodeNumbers":[11]},{"provider":"tvdb_show","id":"443726","scope":"s1","seasonNumber":1,"episodeNumbers":[11]}],"link":"87057","synopsis":"After realizing his feelings for Yuki, Hitoyoshi places a distance between himself and the Maid. Yuki finds herself crying nonstop, feeling rejected and incompetent with everything she does. With Naka's help, will Yuki be able to sort out her feelings?","thumbnail":"https://image.tmdb.org/t/p/w300/3WZoU2MP03ZflkTfFDU44oELlWk.jpg"},{"title":"Episodio 12","episodeNumber":12,"sourceEpisodeNumber":12,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"18344","scope":"R","episodeNumbers":[12]},{"provider":"anilist","id":"172190","episodeNumbers":[12]},{"provider":"mal","id":"57611","episodeNumbers":[12]},{"provider":"tmdb_show","id":"242143","scope":"s1","seasonNumber":1,"episodeNumbers":[12]},{"provider":"tvdb_show","id":"443726","scope":"s1","seasonNumber":1,"episodeNumbers":[12]}],"link":"87179","synopsis":"Consulting Naka, Yuki decides to select a birthday gift for Hitoyoshi. Meanwhile, Riko manages to wake up Hitoyoshi. Filled with fear and anxiety, he worries about what his dad would think of the real Yuki as he's about to face his biggest challenge.","thumbnail":"https://image.tmdb.org/t/p/w300/4NIpuEk4iyWrriWYQCfpsURkBPW.jpg"}],"sourceIds":{"anilistId":172190,"malId":57611},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-29T07:54:59Z","sourceDescriptors":["anilist:172190","mal:57611"],"imdbSource":"plexanibridge-v2","targets":[{"provider":"anidb","id":"18344","scope":"R","ranges":{"1-12":"1-12"}},{"provider":"anilist","id":"172190","ranges":{"1-12":"1-12"}},{"provider":"mal","id":"57611","ranges":{"1-12":"1-12"}},{"provider":"tmdb_show","id":"242143","scope":"s1","ranges":{"1-12":"1-12"}},{"provider":"tvdb_show","id":"443726","scope":"s1","ranges":{"1-12":"1-12"}}]},"sourceMetadata":{"info":{"id":5670,"title":"Kimi wa Meido-sama","title_eng":"You Are Ms. Servant","slug":"you-are-ms-servant","plot":"Una ragazza vestita da cameriera arriva alla casa di Hitoyoshi in cerca di un lavoro. Precedentemente era impiegata come assassina, perciò è molto capace in tutte le tecniche di omicidio ma come cameriera non ha alcuna esperienza. Hitoyoshi è confuso dalla strana richiesta dalla ragazza e si rifiuta di assumerla, ma quando lei lo salva da un incidente mortale è costr