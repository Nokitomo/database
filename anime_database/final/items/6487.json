":"376729","scope":"s2","seasonNumber":2,"episodeNumbers":[6]}],"link":"94473","synopsis":"The team with Viole and Wangnan faces the next test on their journey to the top of the tower. But before that, they are evaluated by Viole's friends from FUG.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/10563861/screencap/66b8cb70bcd44.jpg"},{"title":"Mazino Magic","episodeNumber":7,"sourceEpisodeNumber":7,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"17559","scope":"R","episodeNumbers":[7]},{"provider":"tmdb_show","id":"97860","scope":"s2","seasonNumber":2,"episodeNumbers":[7]},{"provider":"tvdb_show","id":"376729","scope":"s2","seasonNumber":2,"episodeNumbers":[7]}],"link":"94474","synopsis":"The battle against Urek continues in Zygaena. In a deadly game between Urek and Viole, the stakes are Zygaena's flower. But then, everything takes an unexpected turn.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/10563862/screencap/66c1fea664584.jpg"},{"title":"Her Name Is Emily","episodeNumber":8,"sourceEpisodeNumber":8,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"17559","scope":"R","episodeNumbers":[8]},{"provider":"tmdb_show","id":"97860","scope":"s2","seasonNumber":2,"episodeNumbers":[8]},{"provider":"tvdb_show","id":"376729","scope":"s2","seasonNumber":2,"episodeNumbers":[8]}],"link":"94475","synopsis":"Both Khun's team and the team of Wangnan and Viole continue to climb the tower, facing the necessary trials along the way. In the process, they discover a new tool: the increasingly popular chat AI, Emile.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/10563863/screencap/66cb4d873f1b7.jpg"},{"title":"One-Winged Devil","episodeNumber":9,"sourceEpisodeNumber":9,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"17559","scope":"R","episodeNumbers":[9]},{"provider":"tmdb_show","id":"97860","scope":"s2","seasonNumber":2,"episodeNumbers":[9]},{"provider":"tvdb_show","id":"376729","scope":"s2","seasonNumber":2,"episodeNumbers":[9]}],"link":"94476","synopsis":"Kang Horyang shares his past with his teammates and asks Viole about the source of his power.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/10563864/screencap/66d47454217d2.jpg"},{"title":"The Hand of Arlen","episodeNumber":10,"sourceEpisodeNumber":10,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"17559","scope":"R","episodeNumbers":[10]},{"provider":"tmdb_show","id":"97860","scope":"s2","seasonNumber":2,"episodeNumbers":[10]},{"provider":"tvdb_show","id":"376729","scope":"s2","seasonNumber":2,"episodeNumbers":[10]}],"link":"94477","synopsis":"Kang Horyang leaves to look for Cassano alone. Unable to abandon their teammate, Viole and the others go after him.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/10563865/screencap/66ddae538a496.jpg"},{"title":"A Thick and Distant Wall","episodeNumber":11,"sourceEpisodeNumber":11,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"17559","scope":"R","episodeNumbers":[11]},{"provider":"tmdb_show","id":"97860","scope":"s2","seasonNumber":2,"episodeNumbers":[11]},{"provider":"tvdb_show","id":"376729","scope":"s2","seasonNumber":2,"episodeNumbers":[11]}],"link":"94478","synopsis":"Viole witnesses Kang Horyang's defeat and unleashes an incredible power. Meanwhile, Khun realizes he has been betrayed and rushes to save his teammates.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/10563866/screencap/66e6c25d38add.jpg"},{"title":"A New Trial","episodeNumber":12,"sourceEpisodeNumber":12,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"17559","scope":"R","episodeNumbers":[12]},{"provider":"tmdb_show","id":"97860","scope":"s2","seasonNumber":2,"episodeNumbers":[12]},{"provider":"tvdb_show","id":"376729","scope":"s2","seasonNumber":2,"episodeNumbers":[12]}],"link":"94479","synopsis":"The Hand of Arlen is destroyed by FUG. Wangnan's team rescues Khun from the rubble, who explain that the long-haired man he saw is FUG Slayer Candidate Jue Viole Grace. While contemplating recent events, Khun encounters a familiar face...","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/10563867/screencap/66f02a410f1a3.jpg"},{"title":"Archimedes","episodeNumber":13,"sourceEpisodeNumber":13,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"17559","scope":"R","episodeNumbers":[13]},{"provider":"tmdb_show","id":"97860","scope":"s2","seasonNumber":2,"episodeNumbers":[13]},{"provider":"tvdb_show","id":"376729","scope":"s2","seasonNumber":2,"episodeNumbers":[13]}],"link":"94480","synopsis":"Khun learns the truth from Hwaryun and decides to join Wangnan's team in the Workshop Battle. Meanwhile, Bam remains on Team FUG as Viole.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/10563868/screencap/66f94db301d3f.jpg"},{"title":"Meeting the Traveler","episodeNumber":14,"sourceEpisodeNumber":14,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"17559","scope":"R","episodeNumbers":[14]},{"provider":"tmdb_show","id":"97860","scope":"s2","seasonNumber":2,"episodeNumbers":[14]},{"provider":"tvdb_show","id":"376729","scope":"s2","seasonNumber":2,"episodeNumbers":[14]}],"link":"97787","synopsis":"Workshop Manager Io announces a game in which all participants will compete for a spot on the floating ship. As each team prepares for the start of the game, Viole rescues a Traveler being chased by a security robot in a back alley.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/10684068/screencap/670299071a970.jpg"},{"title":"The Promise of That Day","episodeNumber":15,"sourceEpisodeNumber":15,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"17559","scope":"R","episodeNumbers":[15]},{"provider":"tmdb_show","id":"97860","scope":"s2","seasonNumber":2,"episodeNumbers":[15]},{"provider":"tvdb_show","id":"376729","scope":"s2","seasonNumber":2,"episodeNumbers":[15]}],"link":"97788","synopsis":"Unaware that FUG agent Viole is actually Bam, Endorsi Jahad attempts to capture him. Meanwhile, Team Shibisu launches a surprise attack on the hotel where Team FUG is staying and Wangnan and Team Khun face off against Chang and Quaetro.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/10684069/screencap/670bb874307fd.jpg"},{"title":"The 25th Bam","episodeNumber":16,"sourceEpisodeNumber":16,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"17559","scope":"R","episodeNumbers":[16]},{"provider":"tmdb_show","id":"97860","scope":"s2","seasonNumber":2,"episodeNumbers":[16]},{"provider":"tvdb_show","id":"376729","scope":"s2","seasonNumber":2,"episodeNumbers":[16]}],"link":"97789","synopsis":"Team Shibisu arrives to confront FUG member Jue Viole Grace. In order to prevent his former teammates from discovering that he is the 25th Bam, Viole takes on Team Shibisu.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/10684070/screencap/6714f75724c78.jpg"},{"title":"Funky!","episodeNumber":17,"sourceEpisodeNumber":17,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"17559","scope":"R","episodeNumbers":[17]},{"provider":"tmdb_show","id":"97860","scope":"s2","seasonNumber":2,"episodeNumbers":[17]},{"provider":"tvdb_show","id":"376729","scope":"s2","seasonNumber":2,"episodeNumbers":[17]}],"link":"97790","synopsis":"The participants that acquired boarding passes enjoy a moment’s rest aboard the Archimedes. Khun is reunited with Rak on the floating ship. With their determination to take back Viole (Bam) from FUG, the “Flag” Workshop Battle finally begins!","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/10684071/screencap/671e45a706eef.jpg"},{"title":"The Mad Dog and the Lizard","episodeNumber":18,"sourceEpisodeNumber":18,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"17559","scope":"R","episodeNumbers":[18]},{"provider":"tmdb_show","id":"97860","scope":"s2","seasonNumber":2,"episodeNumbers":[18]},{"provider":"tvdb_show","id":"376729","scope":"s2","seasonNumber":2,"episodeNumbers":[18]}],"link":"97792","synopsis":"As soon as the game begins, Wangnan, Prince, and Akraptor are forced to fight against Miseng, who has been driven mad by Verdi’s ability. Unable to communicate with Miseng, how will they stop her rampage?","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/10684072/screencap/67278b09d66d3.jpg"},{"title":"All In","episodeNumber":19,"sourceEpisodeNumber":19,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"17559","scope":"R","episodeNumbers":[19]},{"provider":"tmdb_show","id":"97860","scope":"s2","seasonNumber":2,"episodeNumbers":[19]},{"provider":"tvdb_show","id":"376729","scope":"s2","seasonNumber":2,"episodeNumbers":[19]}],"link":"97791","synopsis":"Special rules are applied to Anaak and Ran’s match, and they face off against each other one-on-one. As both combatants fight fiercely with all their strength, the gamblers become excited, and the battle finally nears its end! Meanwhile, Beta, who was created in the workshop, appears before Viole...","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/10684073/screencap/6730c901e3e72.jpg"},{"title":"Like a Flame in the Wind","episodeNumber":20,"sourceEpisodeNumber":20,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"17559","scope":"R","episodeNumbers":[20]},{"provider":"tmdb_show","id":"97860","scope":"s2","seasonNumber":2,"episodeNumbers":[20]},{"provider":"tvdb_show","id":"376729","scope":"s2","seasonNumber":2,"episodeNumbers":[20]}],"link":"97793","synopsis":"The results of the individual tournament pit the two winning teams, Team Mad Dog and Team FUG, against each other in the Workshop Battle, while the losing teams advance to the training tournament. As their respective battles begin, Khun and Wangnan begin summoning their teammates.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/10684074/screencap/6739ef82cad02.jpg"},{"title":"The Beginning of Dawn","episodeNumber":21,"sourceEpisodeNumber":21,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"17559","scope":"R","episodeNumbers":[21]},{"provider":"tmdb_show","id":"97860","scope":"s2","seasonNumber":2,"episodeNumbers":[21]},{"provider":"tvdb_show","id":"376729","scope":"s2","seasonNumber":2,"episodeNumbers":[21]}],"link":"97794","synopsis":"Viole is sent to the bottom by Beta where the Thorn can be found. Reflejo appears before the massive Thorn to reveal the truth to Viole. Meanwhile, Team Khun is reunited with Team Shibisu, and they learn FUG’s true goal hidden within the Workshop Battle...","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/10684075/screencap/6743354d91567.jpg"},{"title":"Their Workshop","episodeNumber":22,"sourceEpisodeNumber":22,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"17559","scope":"R","episodeNumbers":[22]},{"provider":"tmdb_show","id":"97860","scope":"s2","seasonNumber":2,"episodeNumbers":[22]},{"provider":"tvdb_show","id":"376729","scope":"s2","seasonNumber":2,"episodeNumbers":[22]}],"link":"97796","synopsis":"Khun and the others learn Viole is in trouble and head to the summoning station so they can rescue him. Meanwhile, Beta receives Medina the Regular as a teammate from the gambler sent by FUG. Beta allows Medina to enter his body and becomes its host, making him a legitimate competitor, as he sets out to eliminate all of Viole’s friends!","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/10684076/screencap/674c64a083c2b.jpg"},{"title":"The End of Dawn","episodeNumber":23,"sourceEpisodeNumber":23,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"17559","scope":"R","episodeNumbers":[23]},{"provider":"tmdb_show","id":"97860","scope":"s2","seasonNumber":2,"episodeNumbers":[23]},{"provider":"tvdb_show","id":"376729","scope":"s2","seasonNumber":2,"episodeNumbers":[23]}],"link":"97795","synopsis":"Viole finally acquires Enryu’s “Thorn.” Reflejo, who has been trying to acquire the Thorn along with Viole, even if it means involving the entire Workshop Battle, desperately tries to prevent him from escaping. They attempt to outsmart him by summoning Viole, who is currently an item, from the shop’s summoning station, but...!","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/10684077/screencap/675597497ab62.jpg"},{"title":"The Cost of Battle","episodeNumber":24,"sourceEpisodeNumber":24,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"17559","scope":"R","episodeNumbers":[24]},{"provider":"tmdb_show","id":"97860","scope":"s2","seasonNumber":2,"episodeNumbers":[24]},{"provider":"tvdb_show","id":"376729","scope":"s2","seasonNumber":2,"episodeNumbers":[24]}],"link":"97798","synopsis":"Viole (Bam), Khun, and Rak, who once thought each other dead, are reunited. Khun’s team makes an enemy of FUG and the Workshop, but at the suggestion of former 2nd Floor Test Admin Lero Ro, who has been secretly working to help Viole escape, they decide to leave the arena with the losers before the final begins. Reflejo uses the dying Hwaryun as a hostage to force Viole into a final confrontation.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/10730762/screencap/675ed0e4e5419.jpg"},{"title":"Return of the King","episodeNumber":25,"sourceEpisodeNumber":25,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"17559","scope":"R","episodeNumbers":[25]},{"provider":"tmdb_show","id":"97860","scope":"s2","seasonNumber":2,"episodeNumbers":[25]},{"provider":"tvdb_show","id":"376729","scope":"s2","seasonNumber":2,"episodeNumbers":[25]}],"link":"97797","synopsis":"While Reflejo, Viole (Bam), Khun, and Rak are engaged in their final showdown, FUG and the Workshop attempt to pour a solution capable of melting everything into the area... Lero Ro and Endorsi rush to their three companions in order to save them, but FUG Rankers and Team Mad Dog stand in their way! Will Viole and the others be able to escape safely?!","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/10730763/screencap/67681983b399f.jpg"},{"title":"The Dawn of Departure","episodeNumber":26,"sourceEpisodeNumber":26,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"17559","scope":"R","episodeNumbers":[26]},{"provider":"tmdb_show","id":"97860","scope":"s2","seasonNumber":2,"episodeNumbers":[26]},{"provider":"tvdb_show","id":"376729","scope":"s2","seasonNumber":2,"episodeNumbers":[26]}],"link":"97799","synopsis":"Reflejo is brought to the brink of death using the unleashed power of the Thorn. Viole (Bam) finds himself in a difficult position. But thanks to quick thinking from Khun and Rak and Endorsi’s Bongbong, they successfully escape. Their companions gather one after another and all leave the arena on the Wolhaiksong floating ship as the turbulent Workshop Battle finally comes to a close...","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/10730764/screencap/6771496775681.jpg"}],"sourceIds":{"anilistId":153406,"malId":52635},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-28T07:48:11Z","sourceDescriptors":["anilist:153406","mal:52635"],"targets":[{"provider":"anidb","id":"17559","scope":"R","ranges":{"1-26":"1-26"}},{"provider":"anilist","id":"153406"},{"provider":"mal","id":"52635"},{"provider":"mal","id":"59989"},{"provider":"tmdb_show","id":"97860","scope":"s2","ranges":{"1-26":"1-26"}},{"provider":"tvdb_show","id":"376729","scope":"s2","ranges":{"1-26":"1-26","1-13":"1-13"}}]},"sourceMetadata":{"info":{"id":6487,"title":"Kami no Tou: Ouji no Kikan (ITA)","title_eng":"Tower of God 2 (ITA)","slug":"tower-of-god-2-ita","plot":"Seconda stagione di Tower of God","type":"TV","status":"Terminato","date":"2024","studio":"The Answer Studio","dub":1,"mal_id":52635,"anilist_id":153406,"imageurl":"https://img.animeunity.co/anime/145819.jpg","imageurl_cover":"https://img.animeunity.co/anime/153406-wP0TEqBVxY0V.jpg","cover":"https://img.animeunity.co/anime/Qckw1A.jpg","score":"7.98","episo