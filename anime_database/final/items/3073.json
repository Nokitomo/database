ricolo deciderà di schierarsi con i \"Draghi del Cielo\".","date":"1996","episodes_count":1,"episodes_length":93,"author":" ","created_at":"2025-02-09 14:47:36","status":"Terminato","imageurl_cover":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/155-Pk1r5ot2MitT.jpg","type":"Movie","slug":"x-the-movie-ita","title_eng":"X - The Movie (ITA)","day":"Indeterminato","favorites":43,"score":"7.07","visite":13264,"studio":"MADHOUSE","dub":1,"always_home":0,"members":170,"cover":null,"anilist_id":155,"season":"Estate","title_it":null,"mal_id":155,"crunchy_id":null,"netflix_id":null,"prime_id":null,"disney_id":null,"pivot":{"anime_id":3073,"related_id":6108,"number":1}},{"id":3073,"user_id":2,"title":"X: An Omen","imageurl":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/595.jpg","plot":"OVA Prequel di X/1999","date":"2001","episodes_count":1,"episodes_length":22,"author":" ","created_at":"2021-05-22 07:27:39","status":"Terminato","imageurl_cover":"","type":"OVA","slug":"x-ova-ita","title_eng":"X OVA (ITA)","day":"Indeterminato","favorites":41,"score":"7.22","visite":20124,"studio":"Madhouse","dub":1,"always_home":0,"members":175,"cover":null,"anilist_id":595,"season":"Estate","title_it":null,"mal_id":595,"crunchy_id":null,"netflix_id":null,"prime_id":null,"disney_id":null,"pivot":{"anime_id":3073,"related_id":3073,"number":1}},{"id":2448,"user_id":2,"title":"X","imageurl":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/b156-MSqEz70iYng4.png","plot":"L’opera è organizzata in due parti: i primi dieci volumi si occupano della preparazione alla trama vera e propria, introducendo i molti personaggi e descrivendo tutto ciò che c’è da sapere per andare poi avanti nella storia. I 10 volumi successivi (ma per ora ne sono usciti solo 8 seguiti da 5 capitoli non ancora raccolti in tankōbon) sono invece la cronaca della battaglia vera e propria.\r\nKamui Shiro è un ragazzo di sedici anni e torna a Tokyo dopo una lunga assenza durata sei anni; la madre è morta in un incendio e fra le fiamme lo ha scongiurato di recarsi nella capitale perché lì si compirà il suo destino. E così infatti è, visto che ad aspettarlo ci sono due profetesse sorelle, Hinoto e Kanoe, che lo identificano come l’ago della bilancia per la battaglia finale fra due schiere di combattenti dotati di poteri ESP chiamati Draghi del Cielo (o Sigilli) e Draghi della Terra (o Angeli). Kamui ritrova inoltre a Tokyo i suoi vecchi amici d’infanzia e compagni di giochi Fuuma e Kotori Mono, che però tratta con scontrosità (poi scopriremo che si comporta così per tenerli alla larga dalle sue pericolose questioni).","date":"2001","episodes_count":24,"episodes_length":24,"author":" ","created_at":"2020-07-04 22:15:02","status":"Terminato","imageurl_cover":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/156-dmhwnFzUK8kR.jpg","type":"TV","slug":"x1999-tv-ita","title_eng":"X/1999 (TV) (ITA)","day":"Indeterminato","favorites":133,"score":"7.84","visite":94623,"studio":"Madhouse","dub":1,"always_home":0,"members":618,"cover":null,"anilist_id":156,"season":"Autunno","title_it":null,"mal_id":156,"crunchy_id":null,"netflix_id":null,"prime_id":null,"disney_id":null,"pivot":{"anime_id":3073,"related_id":2448,"number":1}}]},"archive":null},"sourceEpisodes":[{"id":51851,"anime_id":3073,"user_id":2,"number":"1","created_at":"2021-05-22 07:28:09","link":"https://server21.streamingaw.online/DDL/ANIME/X1999/X1999_Ep_00_ITA.mp4","visite":20124,"hidden":0,"public":1,"scws_id":109548,"file_name":"X1999_Ep_00_ITA.mp4","tg_post":0}],"artworkInventory":{"logo":[{"source":"tmdb","url":"https://image.tmdb.org/t/p/original/aCXJn7QiZqDZoJJEVdpxaeIQ27j.png"},{"source":"anizip","url":"https://artworks.thetvdb.com/banners/v4/series/70865/clearlogo/611c4841a7a55.png"}],"poster":[{"source":"tmdb","url":"https://image.tmdb.org/t/p/original/lS2iTRhpXiyZyXLHlXT2B3b8eaw.jpg"},{"source":"anizip","url":"https://artworks.thetvdb.com/banners/posters/70865-8.jpg"},{"source":"provi