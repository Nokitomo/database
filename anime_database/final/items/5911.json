db.org/t/p/w300/475LaZQUy7C4ZyfDXzhuYeXriYH.jpg"},{"title":"Episodio 2","episodeNumber":2,"sourceEpisodeNumber":2,"seasonNumber":0,"externalMappings":[{"provider":"anilist","id":"102946","episodeNumbers":[2]},{"provider":"mal","id":"37045","episodeNumbers":[2]},{"provider":"tmdb_show","id":"74092","scope":"s0","seasonNumber":0,"episodeNumbers":[2]},{"provider":"tvdb_show","id":"332994","scope":"s0","seasonNumber":0,"episodeNumbers":[2]}],"link":"88137","synopsis":"Nayuta and Miyako reflect on how they met Itsuki and how their friendship developed. Some cute or comedic character build‑up.","thumbnail":"https://image.tmdb.org/t/p/w300/v59p7rLkFSQwBrSjC1TvJOcDQ0F.jpg"},{"title":"Episodio 3","episodeNumber":3,"sourceEpisodeNumber":3,"seasonNumber":0,"externalMappings":[{"provider":"anilist","id":"102946","episodeNumbers":[3]},{"provider":"mal","id":"37045","episodeNumbers":[3]},{"provider":"tmdb_show","id":"74092","scope":"s0","seasonNumber":0,"episodeNumbers":[3]},{"provider":"tvdb_show","id":"332994","scope":"s0","seasonNumber":0,"episodeNumbers":[3]}],"link":"88138","synopsis":"Itsuki travels for inspiration with Nayuta and Miyako, then is dragged along by some other friends (like illustrator Setsuna) to places like Okinawa, Hokkaido. Small adventure vibes.","thumbnail":"https://image.tmdb.org/t/p/w300/atjQPA1kBkpP2XnRjBDwuC6vQvm.jpg"},{"title":"Episodio 4","episodeNumber":4,"sourceEpisodeNumber":4,"seasonNumber":0,"externalMappings":[{"provider":"anilist","id":"102946","episodeNumbers":[4]},{"provider":"mal","id":"37045","episodeNumbers":[4]},{"provider":"tmdb_show","id":"74092","scope":"s0","seasonNumber":0,"episodeNumbers":[4]},{"provider":"tvdb_show","id":"332994","scope":"s0","seasonNumber":0,"episodeNumbers":[4]}],"link":"88139","synopsis":"After work/manuscripts are submitted, the friends gather for a board game session. Itsuki reveals his feelings for Nayuta to Haruto (not knowing she heard). Ends with a reveal that one of his novels is going to be adapted in