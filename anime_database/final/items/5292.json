itle_eng":"Dirty Pair: Project Eden","day":"Indeterminato","favorites":12,"score":"8.38","visite":4866,"studio":"Sunrise","dub":0,"always_home":0,"members":38,"cover":null,"anilist_id":1796,"season":"Primavera","title_it":null,"mal_id":1796,"crunchy_id":null,"netflix_id":null,"prime_id":null,"disney_id":null,"genres":[{"id":51,"name":"Action","pivot":{"anime_id":5292,"genre_id":51}},{"id":21,"name":"Adventure","pivot":{"anime_id":5292,"genre_id":21}},{"id":37,"name":"Comedy","pivot":{"anime_id":5292,"genre_id":37}},{"id":5,"name":"Ecchi","pivot":{"anime_id":5292,"genre_id":5}},{"id":40,"name":"Sci-fi","pivot":{"anime_id":5292,"genre_id":40}}],"related":[{"id":5290,"user_id":2,"title":null,"imageurl":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/nx424-glWcP372XnPT.jpg","plot":"Anno 2141. Gli esseri umani si sono sparpagliati per l'universo e hanno colonizzato migliaia sistemi solari. La World Welfare Work Agency è una società che lavora per i pianeti che fanno parte dell'Unione Galattica e, dietro lauto compenso, si presta a risolvere qualsiasi tipo di caso, dalle indagini sui crimini più disparati, fino alla soluzione di problemi su scala planetaria. Lo svolgimento di questi incarichi viene affidato a degli agenti altamente specializzati chiamati Trouble Consultant. Se c'è un problema che nessuno può risolvere, la 3WA metterà a vostra disposizione due consulenti di prim'ordine: Kei e Yuri, nome in codice Lovely Angels. Nelle loro missioni vengono aiutate da Namu, un robot costruito dalle ragazze, e Mughi, una creatura con l'aspetto di un grosso e tranquillo gattone. Ben presto però le ragazze vengono soprannominate Dirty Pair (in italiano \"le pestifere due\") a causa del fatto che ogni missione a loro affidata si conclude con successo, ma con enormi danni collaterali.","date":"1985","episodes_count":24,"episodes_length":25,"author":" ","created_at":"2024-05-13 11:11:39","status":"Terminato","imageurl_cover":"https://s4.anilist.co/file/anilistcdn/m