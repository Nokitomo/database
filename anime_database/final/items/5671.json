11","episodeNumbers":[1]},{"provider":"mal","id":"58516","episodeNumbers":[1]},{"provider":"tmdb_show","id":"38464","scope":"s4","seasonNumber":4,"episodeNumbers":[1]},{"provider":"tvdb_show","id":"248035","scope":"s4","seasonNumber":4,"episodeNumbers":[1]}],"link":"85900","synopsis":"L'attività demoniaca crescente è un problema sempre più pressante. Per quresto, l'Ordine decide di anticipare l'esame di qualifica e accoglie un nuovo professore: Lightning. Affascinato dalla sua tecnica, Suguro gli avanzerà una richiesta.","thumbnail":"https://image.tmdb.org/t/p/w300/xzsfnVfeRqvknbeTUQdC27AntAq.jpg"},{"title":"Sofferenza","episodeNumber":2,"sourceEpisodeNumber":2,"seasonNumber":4,"externalMappings":[{"provider":"anidb","id":"18561","scope":"R","episodeNumbers":[2]},{"provider":"anilist","id":"176311","episodeNumbers":[2]},{"provider":"mal","id":"58516","episodeNumbers":[2]},{"provider":"tmdb_show","id":"38464","scope":"s4","seasonNumber":4,"episodeNumbers":[2]},{"provider":"tvdb_show","id":"248035","scope":"s4","seasonNumber":4,"episodeNumbers":[2]}],"link":"86011","synopsis":"Yukio cerca di affrontare di petto il mistero sui suoi occhi. Nel frattempo, una missione di Rin e Shiemi li porterà a parlare del loro rapporto.","thumbnail":"https://image.tmdb.org/t/p/w300/6k8ehubn2LHA0BvEc8UR0ut7dwY.jpg"},{"title":"Città natale","episodeNumber":3,"sourceEpisodeNumber":3,"seasonNumber":4,"externalMappings":[{"provider":"anidb","id":"18561","scope":"R","episodeNumbers":[3]},{"provider":"anilist","id":"176311","episodeNumbers":[3]},{"provider":"mal","id":"58516","episodeNumbers":[3]},{"provider":"tmdb_show","id":"38464","scope":"s4","seasonNumber":4,"episodeNumbers":[3]},{"provider":"tvdb_show","id":"248035","scope":"s4","seasonNumber":4,"episodeNumbers":[3]}],"link":"86229","synopsis":"Shura scompare all'improvviso ma, sulla base delle tracce che ha lasciato. Mephisto deduce che sia tornata nella sua città natale nella prefettura di Aomori. Quindi ordina a Rin e Yukio di andare lì per cercarla. Dopo aver indagato, i gemelli arrivano al lago Towada ad Aomori.","thumbnail":"https://image.tmdb.org/t/p/w300/ySJKdKsgl00y2I3G4MhrKwRKpTD.jpg"},{"title":"Addio a te","episodeNumber":4,"sourceEpisodeNumber":4,"seasonNumber":4,"externalMappings":[{"provider":"anidb","id":"18561","scope":"R","episodeNumbers":[4]},{"provider":"anilist","id":"176311","episodeNumbers":[4]},{"provider":"mal","id":"58516","episodeNumbers":[4]},{"provider":"tmdb_show","id":"38464","scope":"s4","seasonNumber":4,"episodeNumbers":[4]},{"provider":"tvdb_show","id":"248035","scope":"s4","seasonNumber":4,"episodeNumbers":[4]}],"link":"86351","synopsis":"Secondo il contratto stipulato tra Hachiro e l'antenata di Shura, Tatsuko Kirigakure, ogni generazione di discendenti è destinata a morire all'età di 30 anni in cambio dell'acquisizione del potere. Shura informa Rin e Yukio del suo destino. Afferma di non avere rimpianti, ma Rin non è convinto e suggerisce di sconfiggere Hachiro. Tuttavia, Hachiro rapisce Shura. Rin e Yukio si dirigono verso Hachiro per salvarla, ma arrivano e trovano Shura controllata dai poteri ipnotici di Hachiro.","thumbnail":"https://image.tmdb.org/t/p/w300/9WvCVGSOlWcL1sG7zdrWd9KNvBq.jpg"},{"title":"Come se potessi piangere","episodeNumber":5,"sourceEpisodeNumber":5,"seasonNumber":4,"externalMappings":[{"provider":"anidb","id":"18561","scope":"R","episodeNumbers":[5]},{"provider":"anilist","id":"176311","episodeNumbers":[5]},{"provider":"mal","id":"58516","episodeNumbers":[5]},{"provider":"tmdb_show","id":"38464","scope":"s4","seasonNumber":4,"episodeNumbers":[5]},{"provider":"tvdb_show","id":"248035","scope":"s4","seasonNumber":4,"episodeNumbers":[5]}],"link":"86438","synopsis":"Con l'arguta astuzia di Yukio, Rin e i suoi amici riescono a ingannare Hachiro e a convincerlo a rompere il suo contratto con Shura. Tuttavia, Hachiro perde ogni controllo in preda alla rabbia, catturando di nuovo Shura e dirigendosi verso il lago ghiacciato. Quando l'immortale Hachiro esprime il suo desiderio di morire, Shura gli dice che dormiranno insieme per sempre sul fondo del lago e lo abbraccia. Ma mentre sprofondano nel lago, i ricordi dei giorni che una volta aveva trascorso con Shiro balenano nella mente di Shura.","thumbnail":"https://image.tmdb.org/t/p/w300/zsfQ40IVAYCUXYbzfgm72SNT5M5.jpg"},{"title":"Risveglio","episodeNumber":6,"sourceEpisodeNumber":6,"seasonNumber":4,"externalMappings":[{"provider":"anidb","id":"18561","scope":"R","episodeNumbers":[6]},{"provider":"anilist","id":"176311","episodeNumbers":[6]},{"provider":"mal","id":"58516","episodeNumbers":[6]},{"provider":"tmdb_show","id":"38464","scope":"s4","seasonNumber":4,"episodeNumbers":[6]},{"provider":"tvdb_show","id":"248035","scope":"s4","seasonNumber":4,"episodeNumbers":[6]}],"link":"86540","synopsis":"Concluso l'incidente ad Aomori, le cose cominciano a calmarsi alla filiale giapponese dei Cavalieri della Vera Croce. Lightning inizia la sua indagine sugli Illuminati con Suguro. Lightning sospetta che ci fosse qualcosa all'interno della filiale giapponese che fosse collegato agli Illuminati e alla \"Notte Blu\". Nel frattempo, dopo aver ricevuto la confessione di Rin, Shiemi teme che lei non capisca la differenza tra \"amore romantico\" e \"amore di amicizia\". Incapace di rimanere ferma a guardare, Izumo fa un suggerimento.","thumbnail":"https://image.tmdb.org/t/p/w300/6qig0K8ywmwWrhiEYWH3beTgJqm.jpg"},{"title":"Foglie anomale","episodeNumber":7,"sourceEpisodeNumber":7,"seasonNumber":4,"externalMappings":[{"provider":"anidb","id":"18561","scope":"R","episodeNumbers":[7]},{"provider":"anilist","id":"176311","episodeNumbers":[7]},{"provider":"mal","id":"58516","episodeNumbers":[7]},{"provider":"tmdb_show","id":"38464","scope":"s4","seasonNumber":4,"episodeNumbers":[7]},{"provider":"tvdb_show","id":"248035","scope":"s4","seasonNumber":4,"episodeNumbers":[7]}],"link":"86630","synopsis":"Mentre Lightning continua a investigare sulla \"Notte Blu\", nota i nomi di tre persone. Dopo la Notte Blu, tre uomini lasciarono i Cavalieri della Vera Croce, ramo giapponese, e divennero sacerdoti che vivevano al Monastero della Croce del Sud, il luogo in cui crebbero i Fratelli Okumura. Lightning e Suguro visitano il monastero per avere un resoconto diretto di ciò che accadde allora. Lightning, disposto a prendere misure severe contro coloro che rimangono in silenzio, si avvicina al mistero della Notte Blu...","thumbnail":"https://image.tmdb.org/t/p/w300/uHFMWcFLEtedNGQMsErB3fgVORP.jpg"},{"title":"Happy (Merry Christmas) Birthday!","episodeNumber":8,"sourceEpisodeNumber":8,"seasonNumber":4,"externalMappings":[{"provider":"anidb","id":"18561","scope":"R","episodeNumbers":[8]},{"provider":"anilist","id":"176311","episodeNumbers":[8]},{"provider":"mal","id":"58516","episodeNumbers":[8]},{"provider":"tmdb_show","id":"38464","scope":"s4","seasonNumber":4,"episodeNumbers":[8]},{"provider":"tvdb_show","id":"248035","scope":"s4","seasonNumber":4,"episodeNumbers":[8]}],"link":"86716","synopsis":"Lightning e Suguro assistono alla Sezione 13 così come appariva subito dopo la Notte Blu, e Mephisto rivela la verità sulla ricerca che vi veniva condotta. Nel frattempo, Shiemi ha improvvisamente espresso la sua intenzione di rifiutare di sostenere l'esame di certificazione da esorcista e di lasciare la scuola.","thumbnail":"https://image.tmdb.org/t/p/w300/8iBesoZCDsSmiq5em3FQ2Y4tkVe.jpg"},{"title":"Felicitazioni","episodeNumber":9,"sourceEpisodeNumber":9,"seasonNumber":4,"externalMappings":[{"provider":"anidb","id":"18561","scope":"R","episodeNumbers":[9]},{"provider":"anilist","id":"176311","episodeNumbers":[9]},{"provider":"mal","id":"58516","episodeNumbers":[9]},{"provider":"tmdb_show","id":"38464","scope":"s4","seasonNumber":4,"episodeNumbers":[9]},{"provider":"tvdb_show","id":"248035","scope":"s4","seasonNumber":4,"episodeNumbers":[9]}],"link":"86811","synopsis":"Yukio vuole conoscere il segreto della loro nascita mentre Rin crede che non ci sia bisogno di saperlo. Mentre le loro idee si scontrano, Rin e gli altri si dirigono a Kyoto per partecipare al matrimonio di Juzo Shima e Mamushi Hojo.","thumbnail":"https://image.tmdb.org/t/p/w300/d5z05wPIK1YpWG1l8TrOL7bFPu6.jpg"},{"title":"Sotto la neve che cade","episodeNumber":10,"sourceEpisodeNumber":10,"seasonNumber":4,"externalMappings":[{"provider":"anidb","id":"18561","scope":"R","episodeNumbers":[10]},{"provider":"anilist","id":"176311","episodeNumbers":[10]},{"provider":"mal","id":"58516","episodeNumbers":[10]},{"provider":"tmdb_show","id":"38464","scope":"s4","seasonNumber":4,"episodeNumbers":[10]},{"provider":"tvdb_show","id":"248035","scope":"s4","seasonNumber":4,"episodeNumbers":[10]}],"link":"86937","synopsis":"Gli esorcisti sono impegnati a gestire i demoni di alto rango che iniziano ad apparire nelle aree urbane. Shura guida la prima linea a Ikebukuro. Il numero di persone in grado di vedere i demoni aumenta a seguito dell'acquisizione di un Temptaint e il mondo sprofonda nel caos. Allo stesso tempo, Yukio minaccia Suguro con la sua pistola e cerca di convincerlo a svelargli i dettagli delle indagini di Lightning. Yukio si rifiuta di dare ascolto agli avvertimenti di Shima e diventa sempre più isolato. Ritorna a Tokyo per una missione e incontra Lightning.","thumbnail":"https://image.tmdb.org/t/p/w300/nzA61L8IeBrz5OUPBYq7lN8ZtPr.jpg"},{"title":"Oltre la neve","episodeNumber":11,"sourceEpisodeNumber":11,"seasonNumber":4,"externalMappings":[{"provider":"anidb","id":"18561","scope":"R","episodeNumbers":[11]},{"provider":"anilist","id":"176311","episodeNumbers":[11]},{"provider":"mal","id":"58516","episodeNumbers":[11]},{"provider":"tmdb_show","id":"38464","scope":"s4","seasonNumber":4,"episodeNumbers":[11]},{"provider":"tvdb_show","id":"248035","scope":"s4","seasonNumber":4,"episodeNumbers":[11]}],"link":"87055","synopsis":"Sopraffatto dalle sue emozioni contrastanti, Yukio adotta misure drastiche, ma Satana lo blocca. Dopo aver sentito parlare di Yukio da Shiemi, Rin corre fuori dal dormitorio per cercarlo. Assiah, il mondo materiale, viene gettato nel caos mentre i demoni diventano più attivi. Mefisto viene convocato nell'ufficio del primo ministro e partecipa a una conferenza stampa con il primo ministro e tutte le parti interessate per annunciare l'esistenza dei demoni, che non è mai stata pubblicamente riconosciuta fino ad ora. Ma chi appare lì è...","thumbnail":"https://image.tmdb.org/t/p/w300/vdEn8F1vtQVvnT9o8Lz3ABIEMFJ.jpg"},{"title":"Addio","episodeNumber":12,"sourceEpisodeNumber":12,"seasonNumber":4,"externalMappings":[{"provider":"anidb","id":"18561","scope":"R","episodeNumbers":[12]},{"provider":"anilist","id":"176311","episodeNumbers":[12]},{"provider":"mal","id":"58516","episodeNumbers":[12]},{"provider":"tmdb_show","id":"38464","scope":"s4","seasonNumber":4,"episodeNumbers":[12]},{"provider":"tvdb_show","id":"248035","scope":"s4","seasonNumber":4,"episodeNumbers":[12]}],"link":"87177","synopsis":"Yukio viene arrestato con l'accusa di aver sparato a Mefisto. Dopo aver scoperto dell'occhio di Yukio, Rin decide di scappare dall'Ordine con suo fratello. Con l'aiuto degli Exwires e di Amaimon, si dirige a salvare Yukio. Gravemente ferito dal colpo di pistola, Mefisto decide di abbandonare la barriera che aveva piazzato sul cancello artificiale della Gehenna per mantenere il suo corpo posseduto. Di conseguenza, il cancello si apre completamente e un'orda di demoni emerge. L'atmosfera della Gehenna avvolge completamente Assiah...","thumbnail":"https://image.tmdb.org/t/p/w300/7WLpek5woeWjNTXDISCeSwZ8tpx.jpg"}],"sourceIds":{"anilistId":176311,"malId":58516},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-28T07:48:11Z","sourceDescriptors":["anilist:176311","mal:58516"],"imdbSource":"plexanibridge-v2","targets":[{"provider":"anidb","id":"18561","scope":"R","ranges":{"1-12":"1-12"}},{"provider":"anilist","id":"176311","ranges":{"1-12":"1-12"}},{"provider":"mal","id":"58516","ranges":{