rks.thetvdb.com/banners/fanart/original/304106-4.jpg"},{"source":"provider","url":"https://img.animeunity.co/anime/21471-6FlI4z7yKU4u.jpg"},{"source":"anilist","url":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/21471-6FlI4z7yKU4u.jpg"}]}},"related":[{"title":"Bubuki Buranki","link":"/anime/4498-bubuki-buranki","image":"https://img.animeunity.co/anime/bx21471-cG8JwPn9v1d3.png","type":"TV","year":"2016","dubStatus":"subbed","dubStatusKey":"Subbed","variants":[{"status":"subbed","statusKey":"Subbed","title":"Bubuki Buranki","link":"/anime/4498-bubuki-buranki","image":"https://img.animeunity.co/anime/bx21471-cG8JwPn9v1d3.png"}]},{"title":"Bubuki Buranki: Hoshi no Kyojin","link":"/anime/4499-bubuki-buranki-hoshi-no-kyojin","image":"https://img.animeunity.co/anime/bx21740-5EDdxaQZGznt.png","type":"TV","year":"2016","dubStatus":"subbed","dubStatusKey":"Subbed","variants":[{"status":"subbed","statusKey":"Subbed","title":"Bubuki Buranki: Hoshi no Kyojin","link":"/anime/4499-bubuki-buranki-hoshi-no-kyojin","image":"https://img.animeunity.co/anime/bx21740-5EDdxaQZGznt.png"}]}],"linkList":[{"title":"Stagione 1","seasonNumber":1,"availabilityStatus":"available","episodesLink":"4498|1|12|tmdb_show%3A65210%3As1"}]},"episodes":[{"title":"Episodio 1","episodeNumber":1,"sourceEpisodeNumber":1,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"11761","scope":"R","episodeNumbers":[1]},{"provider":"anilist","id":"21471","episodeNumbers":[1]},{"provider":"mal","id":"32023","episodeNumbers":[1]},{"provider":"tmdb_show","id":"65210","scope":"s1","seasonNumber":1,"episodeNumbers":[1]},{"provider":"tvdb_show","id":"304106","scope":"s1","seasonNumber":1,"episodeNumbers":[1]}],"link":"69637","synopsis":"Kazuki Azuma returns to Japan after ten years away, only to be chased down by the Bubuki police. He's saved by a childhood friend, Asabuki Kogane, and her right-hand-shaped Bubuki. He then meets the Bubuki users Nono Hiiragi, Ougi Kinoa, and Taneomi Shizuru. Azuma has never even heard of Bubuki, but after learning that he's the user of the \"heart\" Bubuki, he makes his way to the Buranki prison in Shinjuku's underground to awaken the sleeping Buranki called Oubu.","thumbnail":"https://image.tmdb.org/t/p/w300/7lMWDwvdAUXK0xX6NUJBWsTRTR1.jpg"},{"title":"Episodio 2","episodeNumber":2,"sourceEpisodeNumber":2,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"11761","scope":"R","episodeNumbers":[2]},{"provider":"anilist","id":"21471","episodeNumbers":[2]},{"provider":"mal","id":"32023","episodeNumbers":[2]},{"provider":"tmdb_show","id":"65210","scope":"s1","seasonNumber":1,"episodeNumbers":[2]},{"provider":"tvdb_show","id":"304106","scope":"s1","seasonNumber":1,"episodeNumbers":[2]}],"link":"69638","synopsis":"Azuma stares in stunned shock at Oubu, now reduced to bones, as Hiiragi, Kogane, and the others successfully hold off Matobai. Hiiragi realizes this is the best chance to awaken Oubu and demands the heart Bubuki from Azuma, but Azuma insists he has no such thing. Believing that the heart Bubuki will react if its owner is in danger, he attacks Azuma with Iwatooshi!","thumbnail":"https://image.tmdb.org/t/p/w300/bsg5nal7mpA9YK3nbQ31BcPjNhr.jpg"},{"title":"Episodio 3","episodeNumber":3,"sourceEpisodeNumber":3,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"11761","scope":"R","episodeNumbers":[3]},{"provider":"anilist","id":"21471","episodeNumbers":[3]},{"provider":"mal","id":"32023","episodeNumbers":[3]},{"provider":"tmdb_show","id":"65210","scope":"s1","seasonNumber":1,"episodeNumbers":[3]},{"provider":"tvdb_show","id":"304106","scope":"s1","seasonNumber":1,"episodeNumbers":[3]}],"link":"69640","synopsis":"Ten years ago, many Buranki fell to Earth and were destroyed by Banryuu Reoko and her Buranki, Entei. That was the day Reoko and Entei's reign of terror began. In the present, Azuma and his companions flee Shinjuku and meet a woman named Horino, who tells Azuma that his mother was the only person who ever defeated Reoko. She then tells him there's more he should know, and leads him to the \"Kazuki library.\"","thumbnail":"https://image.tmdb.org/t/p/w300/oeZYdwOmpoHa5skJTq8OMInPqFA.jpg"},{"title":"Episodio 4","episodeNumber":4,"sourceEpisodeNumber":4,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"11761","scope":"R","episodeNumbers":[4]},{"provider":"anilist","id":"21471","episodeNumbers":[4]},{"provider":"mal","id":"32023","episodeNumbers":[4]},{"provider":"tmdb_show","id":"65210","scope":"s1","seasonNumber":1,"episodeNumbers":[4]},{"provider":"tvdb_show","id":"304106","scope":"s1","seasonNumber":1,"episodeNumbers":[4]}],"link":"69639","synopsis":"Kogane's enraged cry of \"I'll gouge out your everything!\" rings out as she engages Matobai in battle, but her opponent's attack power overwhelms her. When Azuma tries to help her, Matobai mercilessly fires his Bubuki gun at him, but the heart Bubuki shields him. Azuma tries to use the heart to call Oubu to fight, but it doesn't respond... and Matobai sneers at their confusion as he takes out Entei's heart Bubuki.","thumbnail":"https://image.tmdb.org/t/p/w300/ckOVznhCjDaOltGLrnaOLWFIl3b.jpg"},{"title":"Episodio 5","episodeNumber":5,"sourceEpisodeNumber":5,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"11761","scope":"R","episodeNumbers":[5]},{"provider":"anilist","id":"21471","episodeNumbers":[5]},{"provider":"mal","id":"32023","episodeNumbers":[5]},{"provider":"tmdb_show","id":"65210","scope":"s1","seasonNumber":1,"episodeNumbers":[5]},{"provider":"tvdb_show","id":"304106","scope":"s1","seasonNumber":1,"episodeNumbers":[5]}],"link":"69641","synopsis":"The Bubuki battle continues aboard the train that's carrying Oubu toward Treasure Island. A beam fired from Arabashiri's Bubuki ring hits Kinoa, causing her own past to replay in her mind and slow her down. Azuma tries to help, but Kinoa stops him, saying she must settle her own score with Arabashiri. So Azuma agrees to just watch, but Hiiragi can't help wondering what Kinoa's relationship with Arabashiri is. What really happened in their past?","thumbnail":"https://image.tmdb.org/t/p/w300/jCHLnxzmMouTzFpbFcWAjrOgcCz.jpg"},{"title":"Episodio 6","episodeNumber":6,"sourceEpisodeNumber":6,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"11761","scope":"R","episodeNumbers":[6]},{"provider":"anilist","id":"21471","episodeNumbers":[6]},{"provider":"mal","id":"32023","episodeNumbers":[6]},{"provider":"tmdb_show","id":"65210","scope":"s1","seasonNumber":1,"episodeNumbers":[6]},{"provider":"tvdb_show","id":"304106","scope":"s1","seasonNumber":1,"episodeNumbers":[6]}],"link":"69642","synopsis":"Azuma's companions have won their second Bubuki battle, but the next opponent is one of Reoko's Four Gods who was in disguise as their friend Horino. Hiiragi and the others are shocked to learn that their trusted friend is actually working for their mortal enemy. Kinoa demands to know why she betrayed them, but Zetsubi easily dodges the question; Hiiragi attacks her in rage, but he's no match for the power of Zetsubi's Bubuki. Azuma's suggestion of figuring out what the opponent's Bubuki's power is momentarily calms Hiiragi, but soon enough...","thumbnail":"https://image.tmdb.org/t/p/w300/lgZUFABHOWE4v7mdPu4e2H84qxL.jpg"},{"title":"Episodio 7","episodeNumber":7,"sourceEpisodeNumber":7,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"11761","scope":"R","episodeNumbers":[7]},{"provider":"anilist","id":"21471","episodeNumbers":[7]},{"provider":"mal","id":"32023","episodeNumbers":[7]},{"provider":"tmdb_show","id":"65210","scope":"s1","seasonNumber":1,"episodeNumbers":[7]},{"provider":"tvdb_show","id":"304106","scope":"s1","seasonNumber":1,"episodeNumbers":[7]}],"link":"69644","synopsis":"When Azuma sees the Buranki approaching the train that's transporting Oubu, he recognizes it as the headless Buranki that attacked his family on Treasure Island ten years ago. Frozen in place, it seems Azuma is about to be trampled underfoot, but Kinoa saves him in the nick of time with Hoemaru and Himekiri. The relieved Kogane joins them along with Hiiragi and Shizuru, when the four Bubuki come together, the heart in Azuma's hand radiates an intense light in concert with a shining beam emitted by the skeleton of Oubu.","thumbnail":"https://image.tmdb.org/t/p/w300/8Wm7pgS2QkbT4PmVIeJDxzIMdvi.jpg"},{"title":"Episodio 8","episodeNumber":8,"sourceEpisodeNumber":8,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"11761","scope":"R","episodeNumbers":[8]},{"provider":"anilist","id":"21471","episodeNumbers":[8]},{"provider":"mal","id":"32023","episodeNumbers":[8]},{"provider":"tmdb_show","id":"65210","scope":"s1","seasonNumber":1,"episodeNumbers":[8]},{"provider":"tvdb_show","id":"304106","scope":"s1","seasonNumber":1,"episodeNumbers":[8]}],"link":"69643","synopsis":"The only two Buranki currently on Earth that possess a beating heart are Oubu and Entei. What's more, Reoko has defeated the headless Buranki, also called the \"déraciné,\" and obtained its heart. One man declares this a situation that cannot be overlooked, and sends several Bubuki users to Japan in order to reclaim the stolen heart. Meanwhile, as Azuma and his companions continue to ride the Buranki transport train, a man carrying a guitar shows up in front of them and forces Hiiragi to slam on the brakes. Just who is this man?","thumbnail":"https://image.tmdb.org/t/p/w300/gtEY97o3IE7s29kn1YHjNUl6PkX.jpg"},{"title":"Episodio 9","episodeNumber":9,"sourceEpisodeNumber":9,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"11761","scope":"R","episodeNumbers":[9]},{"provider":"anilist","id":"21471","episodeNumbers":[9]},{"provider":"mal","id":"32023","episodeNumbers":[9]},{"provider":"tmdb_show","id":"65210","scope":"s1","seasonNumber":1,"episodeNumbers":[9]},{"provider":"tvdb_show","id":"304106","scope":"s1","seasonNumber":1,"episodeNumbers":[9]}],"link":"69645","synopsis":"Azuma does everything he can to restart the heart of Oubu, which stopped beating during the battle with the American Bubuki users. Hiiragi tries to protect Azuma from a vicious attack, but ends up sent flying and crashes to the ground. The American Bubuki user Luis commends Hiiragi for risking himself to save his comrade, and criticizes Azuma for just letting his friend protect him. Epizo stops Luis and declares that the two team leaders should settle this score together, and faces Azuma with fists at the ready.","thumbnail":"https://image.tmdb.org/t/p/w300/ny87PCho5Ne4ue0HyTDFx3ESNP2.jpg"},{"title":"Episodio 10","episodeNumber":10,"sourceEpisodeNumber":10,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"11761","scope":"R","episodeNumbers":[10]},{"provider":"anilist","id":"21471","episodeNumbers":[10]},{"provider":"mal","id":"32023","episodeNumbers":[10]},{"provider":"tmdb_show","id":"65210","scope":"s1","seasonNumber":1,"episodeNumbers":[10]},{"provider":"tvdb_show","id":"304106","scope":"s1","seasonNumber":1,"episodeNumbers":[10]}],"link":"69646","synopsis":"As Oubu finally achieves its complete form, Entei stands before it controlled not by Reoko, but by Zetsubi. Laughing boldly, she tells the shocked Azuma that he can't beat Entei, but Kinoa insists that they and Oubu are different from before. Zetsubi is cornered by Oubu's ferocious attack, so she takes the Russian team's Bubuki to use as Entei's limbs, and Oubu is overwhelmed again. Can Azuma and his party win this fight?","thumbnail":"https://image.tmdb.org/t/p/w300/5pwhyTczJwdsawGxbPHIAy5FWYY.jpg"},{"title":"Episodio 11","episodeNumber":11,"sourceEpisodeNumber":11,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"11761","scope":"R","episodeNumbers":[11]},{"provider":"anilist","id":"21471","episodeNumbers":[11]},{"provider":"mal","id":"32023","episodeNumbers":[11]},{"provider":"tmdb_show","id":"65210","scope":"s1","seasonNumber":1,"episodeNumbers":[11]},{"provider":"tvdb_show","id":"304106","scope":"s1","seasonNumber":1,"episodeNumbers":[11]}],"link":"69647","synopsis":"The foreign teams continue to hunt the headless déraciné Buranki, so they can take its heart and use it to awaken Buranki in their home countries. Meanwhile, Arabashiri is fighting his own battle for Reoko's sake. He has watched Reoko endure the ceaseless pain of fighting déraciné Buranki one after another with the incomplete Entei, and now his rage explodes on Azuma's mother, Migiwa.","thumbnail":"https://image.tmdb.org/t/p/w300/6s5278EyplecponN6ztjraanAEt.jpg"},{"title":"Episodio 12","episodeNumber":12,"sourceEpisodeNumber":12,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"11761","scope":"R","episodeNumbers":[12]},{"provider":"anilist","id":"21471","episodeNumbers":[12]},{"provider":"mal","id":"32023","episodeNumbers":[12]},{"provider":"tmdb_show","id":"65210","scope":"s1","seasonNumber":1,"episodeNumbers":[12]},{"provider":"tvdb_show","id":"304106","scope":"s1","seasonNumber":1,"episodeNumbers":[12]}],"link":"69648","synopsis":"As Reoko, full of bitter resentment, grasps Migiwa in Entei's hand to try to crush her, both women look back to when they were sixteen years old and best friends. Reoko called forth Entei in Ueno to bring the long-buried existence of Buranki to light, but Migiwa burned Entei's limbs to stop this uprising, which left Reoko's body with the curse it still bears today. Why did Reoko decide to walk a path of blood after she was released from her years of confinement? Their hidden past is finally revealed.","thumbnail":"https://image.tmdb.org/t/p/w300/63gLFpZDawiP2z2XNqemEdrM9ew.jpg"}],"sourceIds":{"anilistId":21471,"malId":32023},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-29T07:54:59Z","sourceDescriptors":["anilist:21471","mal:32023"],"targets":[{"provider":"anidb","id":"11761","scope":"R","ranges":{"1-12":"1-12"}},{"provider":"anilist","id":"21471","ranges":{"1-12":"1-12"}},{"provider":"mal","id":"32023","ranges":{"1-12":"1