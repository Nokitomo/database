thetvdb.com/banners/posters/78972-4.jpg"},{"source":"provider","url":"https://img.animeunity.co/anime/bx198-11hkVkT4h4Im.png"},{"source":"cinemeta","url":"https://images.metahub.space/poster/small/tt0805960/img"},{"source":"anizip","url":"https://artworks.thetvdb.com/banners/posters/78972-3.jpg"},{"source":"anilist","url":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/large/bx198-11hkVkT4h4Im.png"}],"background":[{"source":"tmdb","url":"https://image.tmdb.org/t/p/original/zf1TGjNDpqmd12AiCKg2LQlRXa.jpg"},{"source":"cinemeta","url":"https://images.metahub.space/background/medium/tt0805960/img"},{"source":"tvdb","url":"https://artworks.thetvdb.com/banners/fanart/original/78972-4.jpg"},{"source":"anizip","url":"https://artworks.thetvdb.com/banners/fanart/original/78972-2.jpg"},{"source":"provider","url":"https://img.animeunity.co/anime/198-kF0xLn7nqAHj.jpg"},{"source":"anilist","url":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/198-kF0xLn7nqAHj.jpg"}]}},"related":[{"title":"Speed Grapher","link":"/anime/6110-speed-grapher","image":"https://img.animeunity.co/anime/bx198-11hkVkT4h4Im.png","type":"TV","year":"2005","dubStatus":"both","dubStatusKey":"Subbed and dubbed","variants":[{"status":"subbed","statusKey":"Subbed","title":"Speed Grapher","link":"/anime/6110-speed-grapher","image":"https://img.animeunity.co/anime/bx198-11hkVkT4h4Im.png"},{"status":"dubbed","statusKey":"Dubbed","title":"Speed Grapher","link":"/anime/4756-speed-grapher-ita","image":"https://img.animeunity.co/anime/bx198-11hkVkT4h4Im.png"}]}],"linkList":[{"title":"Episodes 1-24","titleKey":"Episodes {{start}}-{{end}}","titleParams":{"start":1,"end":24},"availabilityStatus":"available","episodesLink":"6110|1|24"}]},"episodes":[{"title":"Episodio 1","episodeNumber":1,"sourceEpisodeNumber":1,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"2696","scope":"R","episodeNumbers":[1]},{"provider":"anilist","id":"198","episodeNumbers":[1]},{"provider":"mal","id":"198","episodeNumbers":[1]},{"provider":"tmdb_show","id":"20432","scope":"s1","seasonNumber":1,"episodeNumbers":[1]},{"provider":"tvdb_show","id":"78972","scope":"s1","seasonNumber":1,"episodeNumbers":[1]}],"link":"90432","synopsis":"A decade after a global economic collapse, the gap between the rich and the poor has widened even more. Tokyo is a nexus of corruption and decadence where the winners have gathered to spend their fortune. When Saiga, a former war photographer, infiltrates a secret pleasure-club for Tokyo's elite, he will ignite a chain of events that could force the entire ruling class to their knees.","thumbnail":"https://image.tmdb.org/t/p/w300/xY3uL6wHxDajz9ZBy3D2iFL7xhv.jpg"},{"title":"Episodio 2","episodeNumber":2,"sourceEpisodeNumber":2,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"2696","scope":"R","episodeNumbers":[2]},{"provider":"anilist","id":"198","episodeNumbers":[2]},{"provider":"mal","id":"198","episodeNumbers":[2]},{"provider":"tmdb_show","id":"20432","scope":"s1","seasonNumber":1,"episodeNumbers":[2]},{"provider":"tvdb_show","id":"78972","scope":"s1","seasonNumber":1,"episodeNumbers":[2]}],"link":"90433","synopsis":"In many ways Kagura is like any other teenage girl. She wears her uniform, goes to school and endures the daily lectures. But she is haunted by nightmares where she participates in darkly twisted rituals in Tokyo's secret catacombs, playing the part of a powerful Divine Goddess. In truth, Kagura is living a double life unbeknownst to her, and her terrifying nightmares are far from imagination.","thumbnail":"https://image.tmdb.org/t/p/w300/kpsigZ4l8xNR6w2EwmbAPfuvXQ3.jpg"},{"title":"Episodio 3","episodeNumber":3,"sourceEpisodeNumber":3,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"2696","scope":"R","episodeNumbers":[3]},{"provider":"anilist","id":"198","episodeNumbers":[3]},{"provider":"mal","id":"198","episodeNumbers":[3]},{"provider":"tmdb_show","id":"20432","scope":"s1","seasonNumber":1,"episodeNumbers":[3]},{"provider":"tvdb_show","id":"78972","scope":"s1","seasonNumber":1,"episodeNumbers":[3]}],"link":"90434","synopsis":"In a depraved ceremony beneath the streets of Tokyo, Saiga has been exposed as an intruder and is at the mercy of the sadistic club members. But a kiss from the young Kagura has awoken a strange power within him. Suddenly able to use his camera as a weapon, can Saiga rescue the unwilling Divine Goddess and get them to the surface alive?","thumbnail":"https://image.tmdb.org/t/p/w300/wLdC5CaRNhFOmdIHlmOSj921kr3.jpg"},{"title":"Episodio 4","episodeNumber":4,"sourceEpisodeNumber":4,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"2696","scope":"R","episodeNumbers":[4]},{"provider":"anilist","id":"198","episodeNumbers":[4]},{"provider":"mal","id":"198","episodeNumbers":[4]},{"provider":"tmdb_show","id":"20432","scope":"s1","seasonNumber":1,"episodeNumbers":[4]},{"provider":"tvdb_show","id":"78972","scope":"s1","seasonNumber":1,"episodeNumbers":[4]}],"link":"90435","synopsis":"A lethal game of cat and mouse ensues as Suitengu and Saiga hunt each other down, searching for clues and interrogating everyone they meet. When the photographer slips under Suitengu's nose to free Kagura, her captor is not pleased. He sends Shirogane to ensnare Saiga in a deadly dance under the night's sky.","thumbnail":"https://image.tmdb.org/t/p/w300/aPlgIqsYPajCmDbUo1hgYIDwhx8.jpg"},{"title":"Episodio 5","episodeNumber":5,"sourceEpisodeNumber":5,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"2696","scope":"R","episodeNumbers":[5]},{"provider":"anilist","id":"198","episodeNumbers":[5]},{"provider":"mal","id":"198","episodeNumbers":[5]},{"provider":"tmdb_show","id":"20432","scope":"s1","seasonNumber":1,"episodeNumbers":[5]},{"provider":"tvdb_show","id":"78972","scope":"s1","seasonNumber":1,"episodeNumbers":[5]}],"link":"90436","synopsis":"It's a dangerous race across Tokyo as Saiga tries to find a safe place to hide Kagura, settling on a small night club in the seedy entertainment district. Meanwhile, another gifted Euphoric is called to bring Kagura home: Madam Koganei. A high-class woman who fuels her power by swallowing priceless diamonds.","thumbnail":"https://image.tmdb.org/t/p/w300/tF80aOy5mp9xwqBxO3wgOvSrePk.jpg"},{"title":"Episodio 6","episodeNumber":6,"sourceEpisodeNumber":6,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"2696","scope":"R","episodeNumbers":[6]},{"provider":"anilist","id":"198","episodeNumbers":[6]},{"provider":"mal","id":"198","episodeNumbers":[6]},{"provider":"tmdb_show","id":"20432","scope":"s1","seasonNumber":1,"episodeNumbers":[6]},{"provider":"tvdb_show","id":"78972","scope":"s1","seasonNumber":1,"episodeNumbers":[6]}],"link":"90437","synopsis":"With the ability to turn her body into solid diamond, Madam Koganei seems impervious to Saiga's attacks. Not only is she virtually unbreakable, but the diamond's reflective quality makes it impossible for Saiga's camera to focus. After a high-speed chase through the city the photographer will have to think fast to keep Kagura out of the enemy's hands.","thumbnail":"https://image.tmdb.org/t/p/w300/7vnwXDPpqIIGzk9eUomMV9ONCTm.jpg"},{"title":"Episodio 7","episodeNumber":7,"sourceEpisodeNumber":7,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"2696","scope":"R","episodeNumbers":[7]},{"provider":"anilist","id":"198","episodeNumbers":[7]},{"provider":"mal","id":"198","episodeNumbers":[7]},{"provider":"tmdb_show","id":"20432","scope":"s1","seasonNumber":1,"episodeNumbers":[7]},{"provider":"tvdb_show","id":"78972","scope":"s1","seasonNumber":1,"episodeNumbers":[7]}],"link":"90438","synopsis":"Saiga and Kagura make their way beyond Tokyo's city limits, desperate to leave the dangers of their ordeal behind them. They visit Saiga's old friend, Doctor Ryogoku, hoping he can find a medical explanation for these strange Euphoric powers. And as Saiga gets lost in disturbing memories of war, the doctor makes a startling diagnosis!","thumbnail":"https://image.tmdb.org/t/p/w300/1WxuZZQnhe3k7UWuThPoNUvlYHH.jpg"},{"title":"Episodio 8","episodeNumber":8,"sourceEpisodeNumber":8,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"2696","scope":"R","episodeNumbers":[8]},{"provider":"anilist","id":"198","episodeNumbers":[8]},{"provider":"mal","id":"198","episodeNumbers":[8]},{"provider":"tmdb_show","id":"20432","scope":"s1","seasonNumber":1,"episodeNumbers":[8]},{"provider":"tvdb_show","id":"78972","scope":"s1","seasonNumber":1,"episodeNumbers":[8]}],"link":"90439","synopsis":"When health fails, everyone is in search of answers... and a cure. As Saiga is left with a most difficult dilemma, an unexpected house call from the demented Dentist is the last thing he needs. The photographer will have to perfect his shooting skills to pass this sadistic drill.","thumbnail":"https://image.tmdb.org/t/p/w300/chDJUCj3pA4Q5wxzBrK3aG4rVqg.jpg"},{"title":"Episodio 9","episodeNumber":9,"sourceEpisodeNumber":9,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"2696","scope":"R","episodeNumbers":[9]},{"provider":"anilist","id":"198","episodeNumbers":[9]},{"provider":"mal","id":"198","episodeNumbers":[9]},{"provider":"tmdb_show","id":"20432","scope":"s1","seasonNumber":1,"episodeNumbers":[9]},{"provider":"tvdb_show","id":"78972","scope":"s1","seasonNumber":1,"episodeNumbers":[9]}],"link":"90440","synopsis":"Saiga and Kagura hit the road, with Ginza and Tsujido each tracking them using their own unique talents. Making a detour at a remote spa, Kagura learns some shocking truths about her own origins. But the most startling revelation is a glimpse into the human side of Shinsen. What secrets is the powerful woman hiding, and how will the past play out into their future?","thumbnail":"https://image.tmdb.org/t/p/w300/mWhV1SzF2hohqpMvm61phqNwJj4.jpg"},{"title":"Episodio 10","episodeNumber":10,"sourceEpisodeNumber":10,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"2696","scope":"R","episodeNumbers":[10]},{"provider":"anilist","id":"198","episodeNumbers":[10]},{"provider":"mal","id":"198","episodeNumbers":[10]},{"provider":"tmdb_show","id":"20432","scope":"s1","seasonNumber":1,"episodeNumbers":[10]},{"provider":"tvdb_show","id":"78972","scope":"s1","seasonNumber":1,"episodeNumbers":[10]}],"link":"90441","synopsis":"Saiga and Kagura snoop around an abandoned research lab, searching for insight into the Divine Goddess' true nature. But Suitengu knows exactly where they're headed and arrives just in time to unleash his power on the photographer. Back in the city, Ginza makes a shady pact with Kagura's mother and prepares to join the party.","thumbnail":"https://image.tmdb.org/t/p/w300/6M9HnvHG8XXee7ZAUhzi2l0zdSS.jpg"},{"title":"Episodio 11","episodeNumber":11,"sourceEpisodeNumber":11,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"2696","scope":"R","episodeNumbers":[11]},{"provider":"anilist","id":"198","episodeNumbers":[11]},{"provider":"mal","id":"198","episodeNumbers":[11]},{"provider":"tmdb_show","id":"20432","scope":"s1","seasonNumber":1,"episodeNumbers":[11]},{"provider":"tvdb_show","id":"78972","scope":"s1","seasonNumber":1,"episodeNumbers":[11]}],"link":"90442","synopsis":"After narrowly surviving his confrontation with Suitengu, Saiga has fallen unconscious into Ginza's welcoming hands - but not before telling the detective where Kagura is hiding. Yet the rogue police captain has no intention of playing the hero. She's come for Saiga, and she'll do anything to claim her prize - even if it means turning Kagura over to the enemy!","thumbnail":"https://image.tmdb.org/t/p/w300/rV4UrUMkN4UBsrEpboq3x7Cd6bY.jpg"},{"title":"Episodio 12","episodeNumber":12,"sourceEpisodeNumber":12,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"2696","scope":"R","episodeNumbers":[12]},{"provider":"anilist","id":"198","episodeNumbers":[12]},{"provider":"mal","id":"198","episodeNumbers":[12]},{"provider":"tmdb_show","id":"20432","scope":"s1","seasonNumber":1,"episodeNumbers":[12]},{"provider":"tvdb_show","id":"78972","scope":"s1","seasonNumber":1,"episodeNumbers":[12]}],"link":"90443","synopsis":"Suitengu has put his bold plan to seize control of the Tennozu Group into action, and he is moments away from completing the most important step -- marrying Shinsen, thus tying himself to the company's assets. But Kagura has learned of his intentions and breaks out of the floating research facility, with the goal of warning her mother before it's too late.","thumbnail":"https://image.tmdb.org/t/p/w300/vnytuGLbnA54QwQlOYzwETUuxFf.jpg"},{"title":"Episodio 13","episodeNumber":13,"sourceEpisodeNumber":13,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"2696","scope":"R","episodeNumbers":[13]},{"provider":"anilist","id":"198","episodeNumbers":[13]},{"provider":"mal","id":"198","episodeNumbers":[13]},{"provider":"tmdb_show","id":"20432","scope":"s1","seasonNumber":1,"episodeNumbers":[13]},{"provider":"tvdb_show","id":"78972","scope":"s1","seasonNumber":1,"episodeNumbers":[13]}],"link":"90444","synopsis":"With the latest assassin on the loose, Saiga convinces Ginza to drive him from his hiding place to see Dr. Ryogoku. The samples from Saiga and Kagura have been analyzed and an eccentric DNA specialist sheds new light on the Euphoria Syndrome. Meanwhile, Suitengu continues his plan to seize control -- by marrying Kagura instead.","thumbnail":"https://image.tmdb.org/t/p/w300/qBftq7sdx2dRGsayw4vlrkSFgKV.jpg"},{"title":"Episodio 14","episodeNumber":14,"sourceEpisodeNumber":14,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"2696","scope":"R","episodeNumbers":[14]},{"provider":"anilist","id":"198","episodeNumbers":[14]},{"provider":"mal","id":"198","episodeNumbers":[14]},{"provider":"tmdb_show","id":"20432","scope":"s1","seasonNumber":1,"episodeNumbers":[14]},{"provider":"tvdb_show","id":"78972","scope":"s1","seasonNumber":1,"episodeNumbers":[14]}],"link":"90445","synopsis":"Everything is in place for the wedding of the century: A star-studded turnout, a beautiful church, a maniacal priest with a god complex, a power-hungry groom and a hypnotized bride. The only thing missing is a photographer... And if the one uninvited guest can crash this party, he might just run away with the bride.","thumbnail":"https://image.tmdb.org/t/p/w300/yIcVQkQ0HwhTeJI29XQEppnBU8u.jpg"},{"title":"Episodio 15","episodeNumber":15,"sourceEpisodeNumber":15,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"2696","scope":"R","episodeNumbers":[15]},{"provider":"anilist","id":"198","episodeNumbers":[15]},{"provider":"mal","id":"198","episodeNumbers":[15]},{"provider":"tmdb_show","id":"20432","scope":"s1","seasonNumber":1,"episodeNumbers":[15]},{"provider":"tvdb_show","id":"78972","scope":"s1","seasonNumber":1,"episodeNumbers":[15]}],"link":"90446","synopsis":"Saiga and Kagura are running blind, with the whole country on the look-out for them. But it's one mysterious woman with a tragic past who threatens to drag the photographer to his watery doom. With Saiga in danger, can Kagura face the ghosts of the past to save them both?","thumbnail":"https://image.tmdb.org/t/p/w300/8sl5itrrXTW13cgw9vpI8XSDZZR.jpg"},{"title":"Episodio 16","episodeNumber":16,"sourceEpisodeNumber":16,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"2696","scope":"R","episodeNumbers":[16]},{"provider":"anilist","id":"198","episodeNumbers":[16]},{"provider":"mal","id":"198","episodeNumbers":[16]},{"provider":"tmdb_show","id":"20432","scope":"s1","seasonNumber":1,"episodeNumbers":[16]},{"provider":"tvdb_show","id":"78972","scope":"s1","seasonNumber":1,"episodeNumbers":[16]}],"link":"90447","synopsis":"Kagura is still free, but Suitengu has all he needs to initiate the next phase of his plan: Releasing a new drug that simulates the Goddess' kiss, ultimately making the public unable to control their desires. Meanwhile it's time for the Tennozu Group's semiannual audit, when value must be assigned to even the most violent acts and inked in the books.","thumbnail":"https://image.tmdb.org/t/p/w300/3ONMc1aLuGwLA5MEmDJfMjwFx37.jpg"},{"title":"Episodio 17","episodeNumber":17,"sourceEpisodeNumber":17,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"2696","scope":"R","episodeNumbers":[17]},{"provider":"anilist","id":"198","episodeNumbers":[17]},{"provider":"mal","id":"198","episodeNumbers":[17]},{"provider":"tmdb_show","id":"20432","scope":"s1","seasonNumber":1,"episodeNumbers":[17]},{"provider":"tvdb_show","id":"78972","scope":"s1","seasonNumber":1,"episodeNumbers":[17]}],"link":"90448","synopsis":"A haunting melody inspires Suitengu to reflect on the tragic events of his childhood, events that have shaped him into the man he has become. It's a strange, sordid journey to the top and he has sacrificed everything to get there. But in recalling the ghosts of his past, the motives for his future endgame come into focus.","thumbnail":"https://image.tmdb.org/t/p/w300/eEbvbMWzty9Wtl5HUX978mds5fN.jpg"},{"title":"Episodio 18","episodeNumber":18,"sourceEpisodeNumber":18,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"2696","scope":"R","episodeNumbers":[18]},{"provider":"anilist","id":"198","episodeNumbers":[18]},{"provider":"mal","id":"198","episodeNumbers":[18]},{"provider":"tmdb_show","id":"20432","scope":"s1","seasonNumber":1,"episodeNumbers":[18]},{"provider":"tvdb_show","id":"78972","scope":"s1","seasonNumber":1,"episodeNumbers":[18]}],"link":"90449","synopsis":"As the Tennouzu Group gets rich off of their new product line, Saiga and Kagura set sail for a fresh start in a new land. But before they can vanish in the wind, they're dragged back to Tokyo by a powerful new ally. Everyone's working their own angle... but are they all working towards the same goal?","thumbnail":"https://image.tmdb.org/t/p/w300/xCglGrwnGCxkIgAcyA779Y955aL.jpg"},{"title":"Episodio 19","episodeNumber":19,"sourceEpisodeNumber":19,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"2696","scope":"R","episodeNumbers":[19]},{"provider":"anilist","id":"198","episodeNumbers":[19]},{"provider":"mal","id":"198","episodeNumbers":[19]},{"provider":"tmdb_show","id":"20432","scope":"s1","seasonNumber":1,"episodeNumbers":[19]},{"provider":"tvdb_show","id":"78972","scope":"s1","seasonNumber":1,"episodeNumbers":[19]}],"link":"90450","synopsis":"Allied with Representative Ochiai, Saiga agrees to testify at the Parliamentary hearing if his conditions are met. Kagura must be flown out of the country to safety and there get the treatment that could save her life. After a chance meeting at a bar with a young idealist named Joe, Saiga questions the selfishness of his motives and resolves to bring down Suitengu himself.","thumbnail":"https://image.tmdb.org/t/p/w300/nC9qRgBxIuMAShHI2xqOs6ScRNo.jpg"},{"title":"Episodio 20","episodeNumber":20,"sourceEpisodeNumber":20,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"2696","scope":"R","episodeNumbers":[20]},{"provider":"anilist","id":"198","episodeNumbers":[20]},{"provider":"mal","id":"198","episodeNumbers":[20]},{"provider":"tmdb_show","id":"20432","scope":"s1","seasonNumber":1,"episodeNumbers":[20]},{"provider":"tvdb_show","id":"78972","scope":"s1","seasonNumber":1,"episodeNumbers":[20]}],"link":"90451","synopsis":"Betrayal is in the air. As Saiga fights for his life against a ruthless Euphoric posing as a friend, Kagura is attacked by the one who was supposed to cure her. Meanwhile, on a stage littered with corpses, Ginza discovers the blood-stained roll call of Suitengu's club members, finding a shocking name on the list.","thumbnail":"https://image.tmdb.org/t/p/w300/d0BDuNS9iBtFwQcbpehtmwpuVwJ.jpg"},{"title":"Episodio 21","episodeNumber":21,"sourceEpisodeNumber":21,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"2696","scope":"R","episodeNumbers":[21]},{"provider":"anilist","id":"198","episodeNumbers":[21]},{"provider":"mal","id":"198","episodeNumbers":[21]},{"provider":"tmdb_show","id":"20432","scope":"s1","seasonNumber":1,"episodeNumbers":[21]},{"provider":"tvdb_show","id":"78972","scope":"s1","seasonNumber":1,"episodeNumbers":[21]}],"link":"90452","synopsis":"On the eve of the Club's grand reopening all hell breaks loose. A sick killer with a depraved fetish holds Ginza captive. Prime Minister Kamiya reveals his plans - and his true face -- to Kagura, as war breaks out in the skyscrapers of Tokyo between two powerful Euphorics.","thumbnail":"https://image.tmdb.org/t/p/w300/z6D57tAwJ6WsxFd4v37K2Jw8OUg.jpg"},{"title":"Episodio 22","episodeNumber":22,"sourceEpisodeNumber":22,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"2696","scope":"R","episodeNumbers":[22]},{"provider":"anilist","id":"198","episodeNumbers":[22]},{"provider":"mal","id":"198","episodeNumbers":[22]},{"provider":"tmdb_show","id":"20432","scope":"s1","seasonNumber":1,"episodeNumbers":[22]},{"provider":"tvdb_show","id":"78972","scope":"s1","seasonNumber":1,"episodeNumbers":[22]}],"link":"90453","synopsis":"As Suitengu continues his assault on the Prime Minister's mansion, Saiga races to Kagura's aid. Loyalties are tested and not everyone rises to the occasion. And old wounds refuse to heal when, many years after Kamiya killed his parents and took his sister away, Suitengu finally exacts his bloody revenge.","thumbnail":"https://image.tmdb.org/t/p/w300/qevcRAa7wnhRPcgRtWdhmEdQDPB.jpg"},{"title":"Episodio 23","episodeNumber":23,"sourceEpisodeNumber":23,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"2696","scope":"R","episodeNumbers":[23]},{"provider":"anilist","id":"198","episodeNumbers":[23]},{"provider":"mal","id":"198","episodeNumbers":[23]},{"provider":"tmdb_show","id":"20432","scope":"s1","seasonNumber":1,"episodeNumbers":[23]},{"provider":"tvdb_show","id":"78972","scope":"s1","seasonNumber":1,"episodeNumbers":[23]}],"link":"90454","synopsis":"Saiga emerges from the Prime Minister's house to find Tokyo in chaos. With all the country's leaders locked away deep within the secret club, Japan is without a government. Intent on destroying Suitengu and claiming the spoils, outside forces step into the vacuum and invade. Can Saiga, on the verge of blindness, save Kagura from what Suitengu deems her destiny?","thumbnail":"https://image.tmdb.org/t/p/w300/j2VE5gKwC6WBE6FvDfPOSY1NaTl.jpg"},{"title":"Episodio 24","episodeNumber":24,"sourceEpisodeNumber":24,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"2696","scope":"R","episodeNumbers":[24]},{"provider":"anilist","id":"198","episodeNumbers":[24]},{"provider":"mal","id":"198","episodeNumbers":[24]},{"provider":"tmdb_show","id":"20432","scope":"s1","seasonNumber":1,"episodeNumbers":[24]},{"provider":"tvdb_show","id":"78972","scope":"s1","seasonNumber":1,"episodeNumbers":[24]}],"link":"90455","synopsis":"With Ginza locked in a gun-blazing battle against Tsujido and Makabe, and as foreign missiles threaten to destroy the building at any moment, the final showdown between Suitengu and Saiga reaches its bloody climax. If Suitengu executes his plan, the streets of Tokyo will be paved with fire and the global economy will be forever changed.","thumbnail":"https://image.tmdb.org/t/p/w300/bfSWFXpTEe8D5ysRGjuNoSqotwi.jpg"}],"sourceIds":{"anilistId":198,"malId":198},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-29T07:54:59Z","sourceDescriptors":["anilist:198","mal:198"],"imdbSource":"plexanibridge-v2","targets":[{"provider":"anidb","id":"2696","scope":"R","ranges":{"1-24":"1-24"}},{"provider":"anilist","id":"198","ranges":{"1-24":"1-24"}},{"provider":"mal","id":"198","ranges":{"1-24":"1-24"}},{"provider":"tmdb_show","id":"20432","scope":"s1","ranges":{"1-24":"1-24"}},{"provider":"tvdb_show","id":"78972","scope":"s1","ranges":{"1-24":"1-24"}}]},"sourceMetadata":{"info":{"id":6110,"title":null,"title_eng":"Speed Grapher","slug":"speed-grapher","plot":"Sono passati dieci anni dalla fine della 