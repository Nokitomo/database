{"id":6110,"path":"/anime/6110-speed-grapher","linkSchemaVersion":2,"updatedAt":"2026-10-29T16:19:00.604Z","info":{"title":"Speed Grapher","synopsis":"Sono passati dieci anni dalla fine della Bubble War e in tutto il mondo i ricchi e i poveri sono divisi da un abisso che si allarga sempre più. Saiga, un tempo fotoreporter di guerra, lavora ora nello stato capitalista di Tokyo come freelance. Occasionalmente collabora con una sezione segreta della polizia di Shinjuku e accetta una missione impegnativa: infiltrarsi nel misterioso Roppongi Club.","image":"https://image.tmdb.org/t/p/original/zf1TGjNDpqmd12AiCKg2LQlRXa.jpg","poster":"https://image.tmdb.org/t/p/original/8Q9CzMsjMTh7h5pkDXBm3HyrUDE.jpg","logo":"https://image.tmdb.org/t/p/original/qas9W46avLeXb0GDP0Iswf3cmYe.png","background":"https://image.tmdb.org/t/p/original/zf1TGjNDpqmd12AiCKg2LQlRXa.jpg","imdbId":"tt0805960","type":"series","tags":["TV","Terminato","Primavera","2005"],"tagKeys":{"TV":"TV","Terminato":"Completed","Primavera":"Spring"},"genres":["Action","Drama","Ecchi","Gore","Mystery","Psychological","Super Power","Supernatural"],"rating":"6.9","studio":"GONZO","episodesCount":24,"extra":{"ids":{"malId":198,"anilistId":198,"crunchyId":null,"disneyId":null,"netflixId":null,"primeId":null,"anilistIds":[198],"malIds":[198],"anidbIds":[2696],"imdbMovieIds":[],"imdbShowIds":[],"tmdbMovieIds":[],"tmdbShowIds":[20432],"tvdbMovieIds":[],"tvdbShowIds":[78972]},"stats":{"scoreRaw":"6.89","favorites":26,"members":176,"views":13787,"episodesCountRaw":24,"episodesLength":23},"flags":{"dub":0,"alwaysHome":0},"meta":{"day":"Indeterminato","season":"Primavera","status":"Terminato","type":"TV","createdAt":"2025-02-09 16:05:48","userId":2},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-29T07:54:59Z","sourceDescriptors":["anilist:198","mal:198"],"imdbSource":"plexanibridge-v2","targets":[{"provider":"anidb","id":"2696","scope":"R","ranges":{"1-24":"1-24"}},{"provider":"anilist","id":"