 giornalista assume Sotarō per indagare, suggerendogli che le risposte potrebbero trovarsi a Kuragiri, una misteriosa città labirinto situata nel sottosuolo dove è presente un diverso concetto morale e sociale. L'investigatore decide di subappaltare il caso a Saki, ma ben presto se ne pente a causa della sparizione della ragazza. Sotarō ora è costretto a scendere a Kuragiri alla ricerca della verità, confrontandosi con gli strani abitanti del luogo, che comprendono una banda di criminali chiamata \"Laughing Masks\", e una squadra di poliziotti rinnegati a bordo di un treno blindato, comandati dalla misteriosa Tanne.","date":"2024","episodes_count":1,"episodes_length":64,"author":" ","created_at":"2024-04-12 13:03:54","status":"Terminato","imageurl_cover":"","type":"Movie","slug":"kurayukaba","title_eng":"Kurayukaba","day":"Giovedì","favorites":19,"score":"7.27","visite":13051,"studio":"Team OneOne","dub":0,"always_home":1,"members":135,"cover":"https://img.animeworld.so/copertine/Z6Rbm.png","anilist_id":169778,"season":"Primavera","title_it":null,"mal_id":56553,"crunchy_id":null,"netflix_id":null,"prime_id":null,"disney_id":null,"pivot":{"anime_id":5221,"related_id":5222,"number":1}}]},"archive":null},"sourceEpisodes":[{"id":78862,"anime_id":5221,"user_id":2,"number":"1","created_at":"2024-04-12 13:03:18","link":"https://srv16-rika.sweetpixel.org/DDL/ANIME/Kuramerukagari/Kuramerukagari_Movie_SUB_ITA.mp4","visite":11835,"hidden":0,"public":1,"scws_id":220583,"file_name":"Kuramerukagari_Movie_SUB_ITA.mp4","tg_post":0}],"artworkInventory":{"logo":[{"source":"tmdb","url":"https://image.tmdb.org/t/p/original/3RLVAp8ASqPZjEsEcoMdRnL9Lss.png"}],"poster":[{"source":"tmdb","url":"https://image.tmdb.org/t/p/original/jr59za0cZFzt3mHt4VfIfoOxzEC.jpg"},{"source":"tvdb","url":"https://artworks.thetvdb.com/banners/v4/movie/352082/posters/69f3d46ac3bb1.jpg"},{"source":"provider","url":"https://img.animeunity.co/anime/bx171608-ptzZZt2djIkL.jpg"},{"source":"anilist","url":"https://s4