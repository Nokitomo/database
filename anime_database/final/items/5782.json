start}}-{{end}}","titleParams":{"start":1,"end":24},"availabilityStatus":"available","episodesLink":"5782|1|24"}]},"episodes":[{"title":"Maomao","episodeNumber":1,"sourceEpisodeNumber":1,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"17870","scope":"R","episodeNumbers":[1]},{"provider":"anilist","id":"161645","episodeNumbers":[1]},{"provider":"mal","id":"54492","episodeNumbers":[1]},{"provider":"tmdb_show","id":"220542","scope":"s1","seasonNumber":1,"episodeNumbers":[1]},{"provider":"tvdb_show","id":"431162","scope":"s1","seasonNumber":1,"episodeNumbers":[1]}],"link":"86857","synopsis":"After being kidnapped and forced to work as a servant in the rear palace, former apothecary Maomao inadvertently draws the attention of the higher ranks when she investigates what's causing the emperor's infant heirs to fall mysteriously ill.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/9620307/screencap/65330cbfbfed5.jpg"},{"title":"Chilly Apothecary","episodeNumber":2,"sourceEpisodeNumber":2,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"17870","scope":"R","episodeNumbers":[2]},{"provider":"anilist","id":"161645","episodeNumbers":[2]},{"provider":"mal","id":"54492","episodeNumbers":[2]},{"provider":"tmdb_show","id":"220542","scope":"s1","seasonNumber":1,"episodeNumbers":[2]},{"provider":"tvdb_show","id":"431162","scope":"s1","seasonNumber":1,"episodeNumbers":[2]}],"link":"86858","synopsis":"Maomao tries to settle into her promotion to lady-in-waiting and food taster, but struggles to fend off both boredom and the overly-familiar Jinshi. That is, until she gets an assignment of her dreams: to concoct an aphrodisiac.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/9973394/screencap/65349d195c26b.jpg"},{"title":"The Unsettling Matter of the Spirit","episodeNumber":3,"sourceEpisodeNumber":3,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"17870","scope":"R","episodeNumbers":[3]},{"provider":"anilist","id":"161645","episodeNumbers":[3]},{"provider":"mal","id":"54492","episodeNumbers":[3]},{"provider":"tmdb_show","id":"220542","scope":"s1","seasonNumber":1,"episodeNumbers":[3]},{"provider":"tvdb_show","id":"431162","scope":"s1","seasonNumber":1,"episodeNumbers":[3]}],"link":"86859","synopsis":"Tasked with investigating a ghostly woman dancing nightly on the palace walls, Maomao finds a sleepwalking Concubine Fuyou. But with no medicinal cure for sleepwalking, she's forced to dig deeper to find the real reason behind Fuyou's affliction.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/9973395/screencap/65349da5c7542.jpg"},{"title":"The Threat","episodeNumber":4,"sourceEpisodeNumber":4,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"17870","scope":"R","episodeNumbers":[4]},{"provider":"anilist","id":"161645","episodeNumbers":[4]},{"provider":"mal","id":"54492","episodeNumbers":[4]},{"provider":"tmdb_show","id":"220542","scope":"s1","seasonNumber":1,"episodeNumbers":[4]},{"provider":"tvdb_show","id":"431162","scope":"s1","seasonNumber":1,"episodeNumbers":[4]}],"link":"86860","synopsis":"Under direct orders from the emperor himself, Maomao tries to care for an ailing Concubine Lihua, but finds her work impeded by Lihua's own ladies-in-waiting.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/9973396/screencap/653bf6ec03402.jpg"},{"title":"Covert Operations","episodeNumber":5,"sourceEpisodeNumber":5,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"17870","scope":"R","episodeNumbers":[5]},{"provider":"anilist","id":"161645","episodeNumbers":[5]},{"provider":"mal","id":"54492","episodeNumbers":[5]},{"provider":"tmdb_show","id":"220542","scope":"s1","seasonNumber":1,"episodeNumbers":[5]},{"provider":"tvdb_show","id":"431162","scope":"s1","seasonNumber":1,"episodeNumbers":[5]}],"link":"86861","synopsis":"A eunuch stricken by a curse comes begging for aid. Meanwhile, the rear palace buzzes with excitement as everyone prepares for the upcoming garden party, and Gyokuyou's ladies-in-waiting aren't about to let Maomao get away without dressing her up.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/9973397/screencap/65454913da948.jpg"},{"title":"The Garden Party","episodeNumber":6,"sourceEpisodeNumber":6,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"17870","scope":"R","episodeNumbers":[6]},{"provider":"anilist","id":"161645","episodeNumbers":[6]},{"provider":"mal","id":"54492","episodeNumbers":[6]},{"provider":"tmdb_show","id":"220542","scope":"s1","seasonNumber":1,"episodeNumbers":[6]},{"provider":"tvdb_show","id":"431162","scope":"s1","seasonNumber":1,"episodeNumbers":[6]}],"link":"86862","synopsis":"Maomao does her best to navigate the complex social situations at the garden party, including meeting the other Upper First rank concubines. But once she settles down to do her work as a food-taster, she discovers a surprise in a bowl of soup.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/9973398/screencap/654e42097994c.jpg"},{"title":"Homecoming","episodeNumber":7,"sourceEpisodeNumber":7,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"17870","scope":"R","episodeNumbers":[7]},{"provider":"anilist","id":"161645","episodeNumbers":[7]},{"provider":"mal","id":"54492","episodeNumbers":[7]},{"provider":"tmdb_show","id":"220542","scope":"s1","seasonNumber":1,"episodeNumbers":[7]},{"provider":"tvdb_show","id":"431162","scope":"s1","seasonNumber":1,"episodeNumbers":[7]}],"link":"86863","synopsis":"Gaoshun goes to Maomao to get her help in resolving the events of the garden party. Later, Xiaolan explains the purpose of the hairpins Maomao was gifted, and Maomao makes a deal with Lihaku in order to finally visit home.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/9973399/screencap/655779fb6d352.jpg"},{"title":"Wheat Stalks","episodeNumber":8,"sourceEpisodeNumber":8,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"17870","scope":"R","episodeNumbers":[8]},{"provider":"anilist","id":"161645","episodeNumbers":[8]},{"provider":"mal","id":"54492","episodeNumbers":[8]},{"provider":"tmdb_show","id":"220542","scope":"s1","seasonNumber":1,"episodeNumbers":[8]},{"provider":"tvdb_show","id":"431162","scope":"s1","seasonNumber":1,"episodeNumbers":[8]}],"link":"86864","synopsis":"Maomao's peaceful morning at home is interrupted when she's called in to investigate an apparent double suicide at one of the local brothels.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/9973400/screencap/6560c0e8d2395.jpg"},{"title":"Suicide or Murder?","episodeNumber":9,"sourceEpisodeNumber":9,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"17870","scope":"R","episodeNumbers":[9]},{"provider":"anilist","id":"161645","episodeNumbers":[9]},{"provider":"mal","id":"54492","episodeNumbers":[9]},{"provider":"tmdb_show","id":"220542","scope":"s1","seasonNumber":1,"episodeNumbers":[9]},{"provider":"tvdb_show","id":"431162","scope":"s1","seasonNumber":1,"episodeNumbers":[9]}],"link":"86865","synopsis":"An older acquaintance of Jinshi's dies while drinking at a party. A servant's body turns up in a moat. Both deaths are written off as self-inflicted, but Maomao's keen observations tell her that there's more to both stories.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/9973401/screencap/656a0833bc852.jpg"},{"title":"Honey","episodeNumber":10,"sourceEpisodeNumber":10,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"17870","scope":"R","episodeNumbers":[10]},{"provider":"anilist","id":"161645","episodeNumbers":[10]},{"provider":"mal","id":"54492","episodeNumbers":[10]},{"provider":"tmdb_show","id":"220542","scope":"s1","seasonNumber":1,"episodeNumbers":[10]},{"provider":"tvdb_show","id":"431162","scope":"s1","seasonNumber":1,"episodeNumbers":[10]}],"link":"86866","synopsis":"A tea party hosted by Lady Gyokuyou puts the politics of the rear palace at the forefront, and Maomao learns something new about Lady Lishu. His true intentions unclear, Jinshi sends Maomao to work for Lady Ah-Duo.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/9973402/screencap/65739cbf79555.jpg"},{"title":"Reducing Two to One","episodeNumber":11,"sourceEpisodeNumber":11,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"17870","scope":"R","episodeNumbers":[11]},{"provider":"anilist","id":"161645","episodeNumbers":[11]},{"provider":"mal","id":"54492","episodeNumbers":[11]},{"provider":"tmdb_show","id":"220542","scope":"s1","seasonNumber":1,"episodeNumbers":[11]},{"provider":"tvdb_show","id":"431162","scope":"s1","seasonNumber":1,"episodeNumbers":[11]}],"link":"86867","synopsis":"Maomao confronts Fengming about the dark secret she's been hiding from her noble Lady Ah-Duo.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/9973403/screencap/657c69d2871fa.jpg"},{"title":"The Eunuch and the Courtesan","episodeNumber":12,"sourceEpisodeNumber":12,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"17870","scope":"R","episodeNumbers":[12]},{"provider":"anilist","id":"161645","episodeNumbers":[12]},{"provider":"mal","id":"54492","episodeNumbers":[12]},{"provider":"tmdb_show","id":"220542","scope":"s1","seasonNumber":1,"episodeNumbers":[12]},{"provider":"tvdb_show","id":"431162","scope":"s1","seasonNumber":1,"episodeNumbers":[12]}],"link":"86868","synopsis":"Discovering that Maomao's kidnappers were connected to Fengming's family, Jinshi is faced with a choice between keeping Maomao in the rear palace where he can be near her or releasing her from her service.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/9973404/screencap/6586796173346.jpg"},{"title":"Serving in the Outer Court","episodeNumber":13,"sourceEpisodeNumber":13,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"17870","scope":"R","episodeNumbers":[13]},{"provider":"anilist","id":"161645","episodeNumbers":[13]},{"provider":"mal","id":"54492","episodeNumbers":[13]},{"provider":"tmdb_show","id":"220542","scope":"s1","seasonNumber":1,"episodeNumbers":[13]},{"provider":"tvdb_show","id":"431162","scope":"s1","seasonNumber":1,"episodeNumbers":[13]}],"link":"91827","synopsis":"To Maomao's surprise, Jinshi brings her directly to his house instead of taking her back to the rear palace, and tells her she's to work in the outer court. Not only is there much to learn, it seems there's many eyes on her as the new hire.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/9973405/screencap/6598ab4074091.jpg"},{"title":"The New Pure Consort","episodeNumber":14,"sourceEpisodeNumber":14,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"17870","scope":"R","episodeNumbers":[14]},{"provider":"anilist","id":"161645","episodeNumbers":[14]},{"provider":"mal","id":"54492","episodeNumbers":[14]},{"provider":"tmdb_show","id":"220542","scope":"s1","seasonNumber":1,"episodeNumbers":[14]},{"provider":"tvdb_show","id":"431162","scope":"s1","seasonNumber":1,"episodeNumbers":[14]}],"link":"91828","synopsis":"Ah-Duo's replacement has arrived in the rear palace, and Maomao is assigned to give a certain lecture to all four high concubines. Later, Maomao helps Lihaku investigate a warehouse explosion.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/10102917/screencap/65a11ae6addb6.jpg"},{"title":"Raw Fish","episodeNumber":15,"sourceEpisodeNumber":15,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"17870","scope":"R","episodeNumbers":[15]},{"provider":"anilist","id":"161645","episodeNumbers":[15]},{"provider":"mal","id":"54492","episodeNumbers":[15]},{"provider":"tmdb_show","id":"220542","scope":"s1","seasonNumber":1,"episodeNumbers":[15]},{"provider":"tvdb_show","id":"431162","scope":"s1","seasonNumber":1,"episodeNumbers":[15]}],"link":"91829","synopsis":"Gaoshun requests Maomao's help in solving an apparent poisoning case. Meanwhile, Jinshi deals with an unwelcome visitor who's taken to lingering in his office.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/10102918/screencap/65ac11a7f3e66.jpg"},{"title":"Lead","episodeNumber":16,"sourceEpisodeNumber":16,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"17870","scope":"R","episodeNumbers":[16]},{"provider":"anilist","id":"161645","episodeNumbers":[16]},{"provider":"mal","id":"54492","episodeNumbers":[16]},{"provider":"tmdb_show","id":"220542","scope":"s1","seasonNumber":1,"episodeNumbers":[16]},{"provider":"tvdb_show","id":"431162","scope":"s1","seasonNumber":1,"episodeNumbers":[16]}],"link":"91830","synopsis":"A shack, a chest of drawers, and a fishbowl are all that a talented metalworker leaves to his three sons upon his death. Maomao is assigned to investigate how these strange inheritances all fit together.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/10102919/screencap/65b427c7a6895.jpg"},{"title":"A Jaunt Around Town","episodeNumber":17,"sourceEpisodeNumber":17,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"17870","scope":"R","episodeNumbers":[17]},{"provider":"anilist","id":"161645","episodeNumbers":[17]},{"provider":"mal","id":"54492","episodeNumbers":[17]},{"provider":"tmdb_show","id":"220542","scope":"s1","seasonNumber":1,"episodeNumbers":[17]},{"provider":"tvdb_show","id":"431162","scope":"s1","seasonNumber":1,"episodeNumbers":[17]}],"link":"91831","synopsis":"Covering up Jinshi's otherworldly beauty is no easy task, but after Maomao takes the challenge head-on, she's surprised when she's also asked to don the disguise of a noblewoman and escort \"Jinka\" outside the palace.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/10102920/screencap/65bccc8851267.jpg"},{"title":"Lakan","episodeNumber":18,"sourceEpisodeNumber":18,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"17870","scope":"R","episodeNumbers":[18]},{"provider":"anilist","id":"161645","episodeNumbers":[18]},{"provider":"mal"