:[4]}],"link":"100372","synopsis":"Papacha decided to party it out in an Inn, but refused to pay and is now working his way to cover the fees. Aun, Photon, Pochi #1, and Keyne, decide to pay a visit to that very same Inn. Lashara also stops by.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/86921/475521.jpg"},{"title":"Papacha Turns the Key","episodeNumber":5,"sourceEpisodeNumber":5,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"139","scope":"R","episodeNumbers":[5]},{"provider":"anilist","id":"1944","episodeNumbers":[5]},{"provider":"mal","id":"1944","episodeNumbers":[5]},{"provider":"tmdb_show","id":"39383","scope":"s1","seasonNumber":1,"episodeNumbers":[5]},{"provider":"tvdb_show","id":"86921","scope":"s1","seasonNumber":1,"episodeNumbers":[5]}],"link":"100373","synopsis":"Keyne seems to have finally found the answer to her long journey on earth after discovering the devil's hot spring. Though little did she know that Sir Papacha had already arrived in the same destination.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/86921/475531.jpg"},{"title":"Photon on the Green Planet","episodeNumber":6,"sourceEpisodeNumber":6,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"139","scope":"R","episodeNumbers":[6]},{"provider":"anilist","id":"1944","episodeNumbers":[6]},{"provider":"mal","id":"1944","episodeNumbers":[6]},{"provider":"tmdb_show","id":"39383","scope":"s1","seasonNumber":1,"episodeNumbers":[6]},{"provider":"tvdb_show","id":"86921","scope":"s1","seasonNumber":1,"episodeNumbers":[6]}],"link":"100374","synopsis":"Faces are revealed, families ties are being exploited, and it seems The Galactic Emporer has won, though it's Photon who foils his plans. However, Sir Papacha comes out of nowhere with Gene's Genie, ready to visit the Anti Aho furnace.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/86921/475541.jpg"}],"sourceIds":{"anilistId":1944,"malId":1944},"mappings":{"source":"anibridge-v3","schema