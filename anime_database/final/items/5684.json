:"432476","scope":"s1","seasonNumber":1,"episodeNumbers":[3]}],"link":"86021","synopsis":"Mai starts working at a new job but gets depressed after struggling to connect with her first client. To cheer her up, Takae invites her to see a fireworks show. Keisuke decides to stop by as well and happens to bump into his coworker Moriya on the way.","thumbnail":"https://image.tmdb.org/t/p/w300/gK5MA8bLfY3mECAFDiL6OJE2t1c.jpg"},{"title":"Chiacchierando insieme","episodeNumber":4,"sourceEpisodeNumber":4,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"17911","scope":"R","episodeNumbers":[4]},{"provider":"anilist","id":"162785","episodeNumbers":[4]},{"provider":"mal","id":"54726","episodeNumbers":[4]},{"provider":"tmdb_show","id":"257603","scope":"s1","seasonNumber":1,"episodeNumbers":[4]},{"provider":"tvdb_show","id":"432476","scope":"s1","seasonNumber":1,"episodeNumbers":[4]}],"link":"86241","synopsis":"Mai is on her second date with Renji Aikawa, who then asks her to show him around Tokyo. Additionally, Chika, the mother of Marika (also known as Takae), has been seeing a man more frequently. Marika is now also supposed to get to know him.","thumbnail":"https://image.tmdb.org/t/p/w300/wU2YD8DdzyVx1iUfxbvJpfc4Vp7.jpg"},{"title":"Mother and Family","episodeNumber":5,"sourceEpisodeNumber":5,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"17911","scope":"R","episodeNumbers":[5]},{"provider":"anilist","id":"162785","episodeNumbers":[5]},{"provider":"mal","id":"54726","episodeNumbers":[5]},{"provider":"tmdb_show","id":"257603","scope":"s1","seasonNumber":1,"episodeNumbers":[5]},{"provider":"tvdb_show","id":"432476","scope":"s1","seasonNumber":1,"episodeNumbers":[5]}],"link":"86358","synopsis":"Takae is nervous to tell Keisuke and Mai about Chika's plans to move and remarry, but the two take the news fairly well since the family will still be able to meet. Takae tries to stay positive about the move and hopes it will bring her mother happiness.","thumbnail":"https://image.tmdb.org/t/p/w300/oaZ0FkkUfy9v3JI0HigrIqiETS6.jpg"},{"title":"Memories, Creaking","episodeNumber":6,"sourceEpisodeNumber":6,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"17911","scope":"R","episodeNumbers":[6]},{"provider":"anilist","id":"162785","episodeNumbers":[6]},{"provider":"mal","id":"54726","episodeNumbers":[6]},{"provider":"tmdb_show","id":"257603","scope":"s1","seasonNumber":1,"episodeNumbers":[6]},{"provider":"tvdb_show","id":"432476","scope":"s1","seasonNumber":1,"episodeNumbers":[6]}],"link":"86448","synopsis":"After seeing Marika (Takae) with Keisuke and Mai, Chika presses her daughter for an explanation. Takae's reluctance to respond sends Chika into a rage. Keisuke witnesses the outburst and starts trying to think of a way to help Takae leave her toxic home.","thumbnail":"https://image.tmdb.org/t/p/w300/slI0kHkKosvqIijKKVp4xboKCOv.jpg"},{"title":"A Sign of Happiness","episodeNumber":7,"sourceEpisodeNumber":7,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"17911","scope":"R","episodeNumbers":[7]},{"provider":"anilist","id":"162785","episodeNumbers":[7]},{"provider":"mal","id":"54726","episodeNumbers":[7]},{"provider":"tmdb_show","id":"257603","scope":"s1","seasonNumber":1,"episodeNumbers":[7]},{"provider":"tvdb_show","id":"432476","scope":"s1","seasonNumber":1,"episodeNumbers":[7]}],"link":"86551","synopsis":"Mai and Keisuke receive a surprise visit from Renji. Keisuke is shocked to learn that Mai has a boyfriend and depressed to realize that she might eventually move out. Moriya notices Keisuke's mood at work and tries to think of a way to help cheer him up.","thumbnail":"https://image.tmdb.org/t/p/w300/154Iib1i7bamcE9s7lMC6roC9c3.jpg"},{"title":"Who Are You?","episodeNumber":8,"sourceEpisodeNumber":8,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"17911","scope":"R","episodeNumbers":[8]},{"provider":"anilist","id":"162785","episodeNumbers":[8]},{"provider":"mal","id":"54726","episodeNumbers":[8]},{"provider":"tmdb_show","id":"257603","scope":"s1","seasonNumber":1,"episodeNumbers":[8]},{"provider":"tvdb_show","id":"432476","scope":"s1","seasonNumber":1,"episodeNumbers":[8]}],"link":"86637","synopsis":"Chika and the Niijimas work together to support Marika after her memory loss. Mai tutors Marika to help her with school while Chika continues to work toward becoming a better mother. Meanwhile, Keisuke is worried that he may have lost his wife yet again.","thumbnail":"https://image.tmdb.org/t/p/w300/iXxxeGlfH3MjbSpEl4BVpRemPmO.jpg"},{"title":"I Want to Share How I Feel","episodeNumber":9,"sourceEpisodeNumber":9,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"17911","scope":"R","episodeNumbers":[9]},{"provider":"anilist","id":"162785","episodeNumbers":[9]},{"provider":"mal","id":"54726","episodeNumbers":[9]},{"provider":"tmdb_show","id":"257603","scope":"s1","seasonNumber":1,"episodeNumbers":[9]},{"provider":"tvdb_show","id":"432476","scope":"s1","seasonNumber":1,"episodeNumbers":[9]}],"link":"86727","synopsis":"Takae regains her memories and discovers the truth. Takae asks Chika to call her \"Marika\" to make things easier for when Marika eventually returns. When Keisuke hears about this, he suspects the same, but he still finds the idea very difficult to accept.","thumbnail":"https://image.tmdb.org/t/p/w300/1Hdwgxx61CIqBrUTTQDbMo171RW.jpg"},{"title":"If That Is Your Wish","episodeNumber":10,"sourceEpisodeNumber":10,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"17911","scope":"R","episodeNumbers":[10]},{"provider":"anilist","id":"162785","episodeNumbers":[10]},{"provider":"mal","id":"54726","episodeNumbers":[10]},{"provider":"tmdb_show","id":"257603","scope":"s1","seasonNumber":1,"episodeNumbers":[10]},{"provider":"tvdb_show","id":"432476","scope":"s1","seasonNumber":1,"episodeNumbers":[10]}],"link":"86821","synopsis":"Keisuke explains the situation with his wife to Moriya, who is upset to hear that Keisuke wants to stay away from Takae for her own sake. Meanwhile, Takae joins Mai and Renji on a tour of the wedding venue and uses the occasion to make a special request.","thumbnail":"https://image.tmdb.org/t/p/w300/wBDMyvN9sXt31bzSgkdYLPb2NMZ.jpg"},{"title":"Love You More Than Anyone","episodeNumber":11,"sourceEpisodeNumber":11,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"17911","scope":"R","episodeNumbers":[11]},{"provider":"anilist","id":"162785","episodeNumbers":[11]},{"provider":"mal","id":"54726","episodeNumbers":[11]},{"provider":"tmdb_show","id":"257603","scope":"s1","seasonNumber":1,"episodeNumbers":[11]},{"provider":"tvdb_show","id":"432476","scope":"s1","seasonNumber":1,"episodeNumbers":[11]}],"link":"86951","synopsis":"Mai becomes very distraught when Keisuke tells her that he and Moriya plan to marry. Keisuke explains that Takae has merely possessed Marika and is eager to return the body to its owner. Mai refuses to accept this and turns to her mother for reassurance.","thumbnail":"https://image.tmdb.org/t/p/w300/5dhbZoebuzrwWsfbPbkb450Cd09.jpg"},{"title":"One Moment","episodeNumber":12,"sourceEpisodeNumber":12,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"17911","scope":"R","episodeNumbers":[12]},{"provider":"anilist","id":"162785","episodeNumbers":[12]},{"provider":"mal","id":"54726","episodeNumbers":[12]},{"provider":"tmdb_show","id":"257603","scope":"s1","seasonNumber":1,"episodeNumbers":[12]},{"provider":"tvdb_show","id":"432476","scope":"s1","seasonNumber":1,"episodeNumbers":[12]}],"link":"87065","synopsis":"Mai takes Takae to the amusement park where Keisuke first ate one of Takae's bentos. On the Ferris wheel, Takae thanks Mai for her kindness and then notices Keisuke and Moriya walking below. Takae then witnesses as Keisuke makes a life-changing decision.","thumbnail":"https://image.tmdb.org/t/p/w300/coA4o9us9rEKPikvbIfA5mpwblQ.jpg"}],"sourceIds":{"anilistId":162785,"malId":54726},"mappings":{"source":"anibridge-v3","schem