[2]},{"provider":"mal","id":"51191","episodeNumbers":[2]},{"provider":"tmdb_show","id":"67063","scope":"s5","seasonNumber":5,"episodeNumbers":[2]},{"provider":"tvdb_show","id":"313488","scope":"s5","seasonNumber":5,"episodeNumbers":[2]}],"link":"103343","synopsis":"肖自在找到碧游村上根器赵归真，赵归真修炼野茅山邪术杀害无辜，肖自在因瞧不起其行径，将他切碎。黑管与一名蒙古人战斗，此前他曾用马仙洪炼制的球控制童男童女，这对童男童女因命格特殊，妹妹为治哥哥的腿来到碧游村。","thumbnail":"https://image.tmdb.org/t/p/w300/at47ZzKJXxnbIdqqfHmLud2zr3N.jpg"},{"title":"Episodio 3","episodeNumber":3,"sourceEpisodeNumber":3,"seasonNumber":5,"externalMappings":[{"provider":"anidb","id":"17095","scope":"R","episodeNumbers":[3]},{"provider":"anilist","id":"142298","episodeNumbers":[3]},{"provider":"mal","id":"51191","episodeNumbers":[3]},{"provider":"tmdb_show","id":"67063","scope":"s5","seasonNumber":5,"episodeNumbers":[3]},{"provider":"tvdb_show","id":"313488","scope":"s5","seasonNumber":5,"episodeNumbers":[3]}],"link":"103344","synopsis":"宝儿姐在村中敲晕部分村民，用三轮车运往山下，途中遇到遁地的异人，不过宝儿姐已能运用身体呼吸，成功将其解决。黑管让宝儿姐将马仙洪引至村中心，以便临时工们合力将其解决。","thumbnail":"https://image.tmdb.org/t/p/w300/ybYTIwM9AOWdewbwIAWFPzuQ8Ta.jpg"},{"title":"Episodio 4","episodeNumber":4,"sourceEpisodeNumber":4,"seasonNumber":5,"externalMappings":[{"provider":"anidb","id":"17095","scope":"R","episodeNumbers":[4]},{"provider":"anilist","id":"142298","episodeNumbers":[4]},{"provider":"mal","id":"51191","episodeNumbers":[4]},{"provider":"tmdb_show","id":"67063","scope":"s5","seasonNumber":5,"episodeNumbers":[4]},{"provider":"tvdb_show","id":"313488","scope":"s5","seasonNumber":5,"episodeNumbers":[4]}],"link":"103345","synopsis":"王震球凭借异能 “爱之马杀鸡” 轻松解决一些对手，后期面对众多敌人时，施展全性妖人夏柳青的戏曲能力，扮成哪吒战斗。老孟则利用生物技术，使上根器体内细菌飙升，令其全身发红发热。","thumbnail":"https://image.tmdb.org/t/p/w300/zrIzxzDWojSYOor7ZNfjBMTSjC5.jpg"},{"title":"Episodio 5","episodeNumber":5,"sourceEpisodeNumber":5,"seasonNumber":5,"externalMappings":[{"provider":"anidb","id":"17095","scope":"R","episodeNumbers":[5]},{"provider":"anilist","id":"142298","episodeNumbers":[5]},{"provider":"mal","id":"51191","episodeNumbers":[5]},{"provider":"tmdb_show","id":"67063","scope":"s5","seasonNumber":5,"episodeNumbers":[5]},{"provider":"tvdb_show","id":"313488","scope":"s5","seasonNumber":5,"episodeNumbers":[5]}],"link":"103346","synopsis":"负责操控电磁波的东北临时工，为众人找出敌人精确位置。张楚岚在破坏修身炉时，遭遇马仙洪炼制的 “如花” 和 “松花蛋” 攻击，“松花蛋” 拥有三种异人的异能，其中陈朵的毒险些让张楚岚丧命，好在他凭借爷爷张怀义所教之法，将炁凝聚到肚子里，才得以化险为夷。","thumbnail":"https://image.tmdb.org/t/p/w300/qBXefWebagpOC5L1SH4nVFr9t0k.jpg"},{"title":"Episodio 6","episodeNumber":6,"sourceEpisodeNumber":6,"seasonNumber":5,"externalMappings":[{"provider":"anidb","id":"17095","scope":"R","episodeNumbers":[6]},{"provider":"anilist","id":"142298","episodeNumbers":[6]},{"provider":"mal","id":"51191","episodeNumbers":[6]},{"provider":"tmdb_show","id":"67063","scope":"s5","seasonNumber":5,"episodeNumbers":[6]},{"provider":"tvdb_show","id":"313488","scope":"s5","seasonNumber":5,"episodeNumbers":[6]}],"link":"103347","synopsis":"宝儿姐遇到黑管和王震球，马仙洪在赶来救村途中，被众人阻碍。肖自在拖着赵归真的尸块出现，吓到了马仙洪，随后肖哥、宝儿姐、王震球和黑管四人一同攻击马仙洪，将其逼至炉子附近。","thumbnail":"https://image.tmdb.org/t/p/w300/yMewW6Ti3Z6O90TbyhUNG46rWSx.jpg"},{"title":"Episodio 7","episodeNumber":7,"sourceEpisodeNumber":7,"seasonNumber":5,"externalMappings":[{"provider":"anidb","id":"17095","scope":"R","episodeNumbers":[7]},{"provider":"anilist","id":"142298","episodeNumbers":[7]},{"provider":"mal","id":"51191","episodeNumbers":[7]},{"provider":"tmdb_show","id":"67063","scope":"s5","seasonNumber":5,"episodeNumbers":[7]},{"provider":"tvdb_show","id":"313488","scope":"s5","seasonNumber":5,"episodeNumbers":[7]}],"link":"103348","synopsis":"马仙洪凭借炼制的法器顽强抵抗，临时工们一时难以将其拿下。关键时刻，王也赶来助阵，他施展风后奇门，将自己和马仙洪错位到上一个时间里，放慢时间流速，成功拿到马仙洪脖子上的珠子。","thumbnail":"https://image.tmdb.org/t/p/w300/v2FS4wx7g2zSY3JuukoEM3DoVFm.jpg"},{"title":"Episodio 8","episodeNumber":8,"sourceEpisodeNumber":8,"seasonNumber":5,"externalMappings":[{"provider":"anidb","id":"17095","scope":"R","episodeNumbers":[8]},{"provider":"anilist","id":"142298","episodeNumbers":[8]},{"provider":"mal","id":"51191","episodeNumbers":[8]},{"provider":"tmdb_show","id":"67063","scope":"s5","seasonNumber":5,"episodeNumbers":[8]},{"provider":"tvdb_show","id":"313488","scope":"s5","seasonNumber":5,"episodeNumbers":[8]}],"link":"103349","synopsis":"马仙洪最终被临时工们制服，被送到山下交给公司同事。众人意识到陈朵的内心诉求是拥有自主选择的权利，张楚岚让宝儿姐带着耳机找到陈朵，让她重新讲述与廖忠的过往，希望能找到解决问题的办法。","thumbnail":"https://image.tmdb.org/t/p/w300/3HbOaI0YBpRfc0rkSyenhC2Faii.jpg"},{"title":"Episodio 9","episodeNumber":9,"sourceEpisodeNumber":9,"seasonNumber":5,"externalMappings":[{"provider":"anidb","id":"17095","scope":"R","episodeNumbers":[9]},{"provider":"anilist","id":"142298","episodeNumbers":[9]},{"provider":"mal","id":"51191","episodeNumbers":[9]},{"provider":"tmdb_show","id":"67063","scope":"s5","seasonNumber":5,"episodeNumbers":[9]},{"provider":"tvdb_show","id":"313488","scope":"s5","seasonNumber":5,"episodeNumbers":[9]}],"link":"103350","synopsis":"陈朵渴望能掌控自己的命运，她想将蛊毒压制在体内，脱掉防护衣去逛街。张楚岚虽明白她的想法，但从公司立场和长远考虑，不得不拒绝，他希望通过此举，让众人记住陈朵的遭遇，以便未来能帮助冯宝宝。","thumbnail":"https://image.tmdb.org/t/p/w300/64gqDTCbeVGRauEfzMoKFuXaHzl.jpg"},{"title":"Episodio 10","episodeNumber":10,"sourceEpisodeNumber":10,"seasonNumber":5,"externalMappings":[{"provider":"anidb","id":"17095","scope":"R","episodeNumbers":[10]},{"provider":"anilist","id":"142298","episodeNumbers":[10]},{"provider":"mal","id":"51191","episodeNumbers":[10]},{"provider":"tmdb_show","id":"67063","scope":"s5","seasonNumber":5,"episodeNumbers":[10]},{"provider":"tvdb_show","id":"313488","scope":"s5","seasonNumber":5,"episodeNumbers":[10]}],"link":"103351","synopsis":"张楚岚等人带着陈朵来到热闹的街市，陈朵感受着从未有过的自由。与此同时，公司对碧游村的后续处理工作也在进行，十二上根器中部分人员通过审查，即将成为哪都通员工。","thumbnail":"https://image.tmdb.org/t/p/w300/ldarKgYRqxoctXXE1SjYlizymfK.jpg"},{"title":"Episodio 11","episodeNumber":11,"sourceEpisodeNumber":11,"seasonNumber":5,"externalMappings":[{"provider":"anidb","id":"17095","scope":"R","episodeNumbers":[11]},{"provider":"anilist","id":"142298","episodeNumbers":[11]},{"provider":"mal","id":"51191","episodeNumbers":[11]},{"provider":"tmdb_show","id":"67063","scope":"s5","seasonNumber":5,"episodeNumbers":[11]},{"provider":"tvdb_show","id":"313488","scope":"s5","seasonNumber":5,"episodeNumbers":[11]}],"link":"103352","synopsis":"王也协助临时工们完成了对马仙洪的抓捕，马仙洪被顺利带走。碧游村之战接近尾声，临时工们出色地完成了任务，公司对他们的表现表示认可。","thumbnail":"https://image.tmdb.org/t/p/w300/xvbVJP722euOTFH5abIOAaY8KrJ.jpg"},{"title":"Episodio 12","episodeNumber":12,"sourceEpisodeNumber":12,"seasonNumber":5,"externalMappings":[{"provider":"anidb","id":"17095","scope":"R","episodeNumbers":[12]},{"provider":"anilist","id":"142298","episodeNumbers":[12]},{"provider":"mal","id":"51191","episodeNumbers":[12]},{"provider":"tmdb_show","id":"67063","scope":"s5","seasonNumber":5,"episodeNumbers":[12]},{"provider":"tvdb_show","id":"313488","scope":"s5","seasonNumber":5,"episodeNumbers":[12]}],"link":"103353","synopsis":"诸葛青接受哪都通公司审讯，陷入碧游村回忆，讲述与马仙洪、王也之间的遗产纠葛。他曾因被王也击败而觊觎风后奇门产生心魔，马仙洪赠送神机百炼后内心纠结，在傅蓉开导下战胜心魔通过审核。冯宝宝接受板凳审查，因心思单纯顺利过关。碧游村事件结束，十二上根器中通过审查者成为哪都通员工，临时工们也顺利过关，但马仙洪在押运途中被其姐姐曲彤救走，曲彤帮他易容并计划重新打造修身炉。","thumbnail":"https://image.tmdb.org/t/p/w300/z6yEm5JJB2opU13EcrKXjCzsQOJ.jpg"}],"sourceIds":{"anilistId":142298,"malId":51191},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-29T07:54:59Z","sourceDescriptors":["anilist:142298","mal:51191"],"targets":[{"provider":"anidb","id":"17095","scope":"R","ranges":{"1-12":"1-12"}},{"provider":"anilist","id":"142298","ranges":{"1-12":"1-12"}},{"provider":"mal","id":"51191","ranges":{"1-12":"1-12"}},{"provider":"tmdb_show","id":"67063","scope":"s5","ranges":{"1-12":"1-12"}},{"provider":"tvdb_show","id":"313488","scope":"s5","ranges":{"1-12":"1-12"}}]},"sourceMetadata":{"info":{"id":7296,"title":"Yi Ren Zhi Xia 5","title_eng":"Hitori no Shita: The Outcast 5","slug":"hitori-no-shita-the-outcast-5","plot":"Quinta stagione di Hitori no Shita: The Outcast","type":"ONA","status":"Terminato","date":"2022","studio":"Qiyuan Yinghua","dub":0,"mal_id":51191,"anilist_id":142298,"image