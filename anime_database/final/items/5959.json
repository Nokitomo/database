{"id":5959,"path":"/anime/5959-two-car","linkSchemaVersion":2,"updatedAt":"2026-10-29T08:14:23.933Z","info":{"title":"Two Car","synopsis":"Yuri Miyata e Megumi Meguro sono due liceali diversissime, ma sono un duo eccezionale nelle corse di side-car che si svolgono sulla piccola isola di Miyake, a sud di Tokyo. Yuri, la pilota, è femminile e mantiene sempre il sangue freddo. Megumi invece è un maschiaccio ed è impulsiva. Insieme prendono parte a gare, i cui partecipanti sono uno più atipico dell'altro.","image":"https://image.tmdb.org/t/p/original/u30Xaw7d9rVplpzu0noOOGf923A.jpg","poster":"https://image.tmdb.org/t/p/original/59wxlN8WkOXdV49POCiJiCQPMHt.jpg","logo":"https://image.tmdb.org/t/p/original/5htRaJNR25Uec87f41TJJPPCZdf.png","background":"https://image.tmdb.org/t/p/original/u30Xaw7d9rVplpzu0noOOGf923A.jpg","trailers":["https://www.youtube.com/watch?v=zpdH4fOyCfw"],"imdbId":"tt7545002","type":"series","tags":["TV","Terminato","Autunno","2017"],"tagKeys":{"TV":"TV","Terminato":"Completed","Autunno":"Autumn"},"genres":["Drama","Racing","Sports"],"rating":"7.7","studio":"SILVER LINK.","episodesCount":12,"extra":{"ids":{"malId":36009,"anilistId":99672,"crunchyId":null,"disneyId":null,"netflixId":null,"primeId":null,"anilistIds":[99672],"malIds":[36009],"anidbIds":[13322],"imdbMovieIds":[],"imdbShowIds":[],"tmdbMovieIds":[],"tmdbShowIds":[74188],"tvdbMovieIds":[],"tvdbShowIds":[332978]},"stats":{"scoreRaw":"7.67","favorites":3,"members":47,"views":3181,"episodesCountRaw":12,"episodesLength":24},"flags":{"dub":0,"alwaysHome":0},"meta":{"day":"Sabato","season":"Autunno","status":"Terminato","type":"TV","createdAt":"2025-01-27 17:03:15","userId":2},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-28T07:48:11Z","sourceDescriptors":["anilist:99672","mal:36009"],"imdbSource":"plexanibridge-v2","targets":[{"provider":"anidb","id":"13322","scope":"R","ranges":{"1-12":"1-12"}},{"provider":"anilist","id":"99672","ranges":{"1-12":"1-12"}},{"p