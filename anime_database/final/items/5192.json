w300/yhomRvNuPQtXqq9J4zFbhU76sQN.jpg"},{"title":"Episodio 7","episodeNumber":7,"sourceEpisodeNumber":7,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"18058","scope":"R","episodeNumbers":[7]},{"provider":"anilist","id":"165855","episodeNumbers":[7]},{"provider":"mal","id":"55597","episodeNumbers":[7]},{"provider":"tmdb_show","id":"239214","scope":"s1","seasonNumber":1,"episodeNumbers":[7]},{"provider":"tvdb_show","id":"435815","scope":"s1","seasonNumber":1,"episodeNumbers":[7]}],"link":"80678","synopsis":"Hotaru, at long last, is able to tell Hanaoi-kun how she feels. But his reaction isn't exactly what she was expecting, leading her to contemplate what they're both looking for in a relationship.","thumbnail":"https://image.tmdb.org/t/p/w300/m8Qtu1J4gF07eHCVJIuRRzuiGRL.jpg"},{"title":"Episodio 8","episodeNumber":8,"sourceEpisodeNumber":8,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"18058","scope":"R","episodeNumbers":[8]},{"provider":"anilist","id":"165855","episodeNumbers":[8]},{"provider":"mal","id":"55597","episodeNumbers":[8]},{"provider":"tmdb_show","id":"239214","scope":"s1","seasonNumber":1,"episodeNumbers":[8]},{"provider":"tvdb_show","id":"435815","scope":"s1","seasonNumber":1,"episodeNumbers":[8]}],"link":"81079","synopsis":"Hotaru and Hananoi-kun are closer than ever, but in many ways, they're still navigating the twists and turns of their new relationship. Thankfully, an adorable dog just may help them see new sides to each other!","thumbnail":"https://image.tmdb.org/t/p/w300/dqUIVUW5p4NJWr1D1o01ZI0XcQy.jpg"},{"title":"Episodio 9","episodeNumber":9,"sourceEpisodeNumber":9,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"18058","scope":"R","episodeNumbers":[9]},{"provider":"anilist","id":"165855","episodeNumbers":[9]},{"provider":"mal","id":"55597","episodeNumbers":[9]},{"provider":"tmdb_show","id":"239214","scope":"s1","seasonNumber":1,"episodeNumbers":[9]},{"provider":"tvdb_show","id":"435815","scope":"s1",