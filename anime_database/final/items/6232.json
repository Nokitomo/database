bx565-2ANuvDHG7SHf.png","plot":"1866, Inghilterra vittoriana alternativa. Alla vigilia della prima Esposizione Universale, Ray Steam, figlio di una famiglia di scienziati di Manchester, trascorre giorni e notti a escogitare nuove invenzioni. Ray aspetta con impazienza il ritorno del padre e del nonno, partiti per l’America per proseguire le proprie ricerche. Un giorno il ragazzo riceve una misteriosa sfera metallica inviatagli dal nonno. Ma l’Ohara Foundation vuole impossessarsi della sfera e rapisce Ray portandolo a Londra, nel padiglione della Ohara Foundation. Qui il ragazzo scopre i poteri della sfera: si tratta di un contenitore di vapore compresso ad alta densità, che può generare un’energia di proporzioni incredibili. Ray dovrà impedire in ogni modo che la sfera venga usata per scopi malvagi.","date":"2004","episodes_count":1,"episodes_length":126,"author":" ","created_at":"2022-06-14 16:23:27","status":"Terminato","imageurl_cover":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/565-0fk7u9S1hI4z.jpg","type":"Movie","slug":"steamboy-ita","title_eng":"Steamboy (ITA)","day":"Indeterminato","favorites":68,"score":"7.87","visite":14675,"studio":"Sunrise","dub":1,"always_home":0,"members":349,"cover":null,"anilist_id":565,"season":"Estate","title_it":null,"mal_id":565,"crunchy_id":null,"netflix_id":null,"prime_id":null,"disney_id":null,"pivot":{"anime_id":6232,"related_id":3806,"number":1}}]},"archive":null},"sourceEpisodes":[{"id":91819,"anime_id":6232,"user_id":2,"number":"1","created_at":"2025-03-05 03:19:07","link":"Steamboy.2005.1080p.AMZN.WEB-DL.JPN.DDP5.1.H.264.mkv","visite":4547,"hidden":0,"public":1,"scws_id":291549,"file_name":"Steamboy.2005.1080p.AMZN.WEB-DL.JPN.DDP5.1.H.264.mkv","tg_post":0}],"artworkInventory":{"logo":[{"source":"tmdb","url":"https://image.tmdb.org/t/p/original/vJFW0dTb35yFXMkPdHojHplORjy.png"},{"source":"cinemeta","url":"https://images.metahub.space/logo/medium/tt0348121/img"}],"poster":[{"source":"tmdb","url":"https://image