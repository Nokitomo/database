nNumber":2,"episodeNumbers":[5]}],"link":"106870","synopsis":"Tsukasa finds himself in an unexpected situation skating alongside legends Jun Yodaka and Shinichiro Sonidori. As he watches Jun move across the ice with breathtaking skill, something stirs within him.","thumbnail":"https://image.tmdb.org/t/p/w300/jUVd0GcZGuXfjjpQ7pZAiy4Phsw.jpg"},{"title":"Episodio 6","episodeNumber":6,"sourceEpisodeNumber":6,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"19260","scope":"R","episodeNumbers":[6]},{"provider":"anilist","id":"189275","episodeNumbers":[6]},{"provider":"mal","id":"61335","episodeNumbers":[6]},{"provider":"tmdb_show","id":"237529","scope":"s2","seasonNumber":2,"episodeNumbers":[6]},{"provider":"tvdb_show","id":"433953","scope":"s2","seasonNumber":2,"episodeNumbers":[6]}],"link":"106871","synopsis":"Inori joins an intensive training session with the Chubu Block competitors heading to the All-Japans. Reuniting with Hikaru and the other skaters, she quickly realises there is a gap in her abilities that she had not anticipated.","thumbnail":"https://image.tmdb.org/t/p/w300/7Z1I9gE1cCZi24e2rB0GEImjM3g.jpg"},{"title":"Episodio 7","episodeNumber":7,"sourceEpisodeNumber":7,"seasonNumber":2,"externalMappings":[{"provider":"anidb","id":"19260","scope":"R","episodeNumbers":[7]},{"provider":"anilist","id":"189275","episodeNumbers":[7]},{"provider":"mal","id":"61335","episodeNumbers":[7]},{"provider":"tmdb_show","id":"237529","scope":"s2","seasonNumber":2,"episodeNumbers":[7]},{"provider":"tvdb_show","id":"433953","scope":"s2","seasonNumber":2,"episodeNumbers":[7]}],"link":"107155","synopsis":"A training session with jump specialist Kakeru Uobuchi brings remarkable results, and Tsukasa is so impressed he decides to invest in his own harness equipment. He brings it to the ice rink intending to help Inori master jumps.","thumbnail":"https://image.tmdb.org/t/p/w300/fBEkKG7jmTTFVDdE8a7EXdnT14G.jpg"},{"title":"Episodio 8","episodeNumber":8,"sourceEpisodeNumber":