nwWbcLEKQqUzwjXZTV.jpg"},{"source":"cinemeta","url":"https://images.metahub.space/background/medium/tt0989781/img"},{"source":"anizip","url":"https://artworks.thetvdb.com/banners/fanart/original/80206-1.jpg"}]}},"related":[],"linkList":[{"title":"Episodes 1-12","titleKey":"Episodes {{start}}-{{end}}","titleParams":{"start":1,"end":12},"availabilityStatus":"available","episodesLink":"6713|1|12"}]},"episodes":[{"title":"Episodio 1","episodeNumber":1,"sourceEpisodeNumber":1,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"3444","scope":"R","episodeNumbers":[1]},{"provider":"anilist","id":"860","episodeNumbers":[1]},{"provider":"mal","id":"860","episodeNumbers":[1]},{"provider":"tmdb_show","id":"35897","scope":"s1","seasonNumber":1,"episodeNumbers":[1]},{"provider":"tvdb_show","id":"80206","scope":"s1","seasonNumber":1,"episodeNumbers":[1]}],"link":"98162","synopsis":"Angel Trainee Flonne is sent to the Netherworld to assassinate the Overlord, King Krichevskoy. Flonne spends two years searching for Krichevskoy, and eventually wakes his son, Prince Laharl, who doesn't beleive in love. After learning his father has died, Laharl sets out to claim his rightful title of Overlord as heir to the throne, and Flonne decides that she will stay in the netherworld even though her target is already dead to learn the true nature of demons... and possibly carry out the mission with a new target.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/80206/329965.jpg"},{"title":"Episodio 2","episodeNumber":2,"sourceEpisodeNumber":2,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"3444","scope":"R","episodeNumbers":[2]},{"provider":"anilist","id":"860","episodeNumbers":[2]},{"provider":"mal","id":"860","episodeNumbers":[2]},{"provider":"tmdb_show","id":"35897","scope":"s1","seasonNumber":1,"episodeNumbers":[2]},{"provider":"tvdb_show","id":"80206","scope":"s1","seasonNumber":1,"episodeNumbers":[2]}],"link":"98163","synopsis":"Weak without her pendant, Flonne is unable to continue her battle with Laharl. Laharl is soon greeted by his father's old vassal, Etna, and the two leave the poor Angel Trainee to die. Help soon comes in the form of Vyers, the Dark Adonis, but what is his true motives? And what about the Defenders of Earth?","thumbnail":"https://artworks.thetvdb.com/banners/episodes/80206/329966.jpg"},{"title":"Episodio 3","episodeNumber":3,"sourceEpisodeNumber":3,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"3444","scope":"R","episodeNumbers":[3]},{"provider":"anilist","id":"860","episodeNumbers":[3]},{"provider":"mal","id":"860","episodeNumbers":[3]},{"provider":"tmdb_show","id":"35897","scope":"s1","seasonNumber":1,"episodeNumbers":[3]},{"provider":"tvdb_show","id":"80206","scope":"s1","seasonNumber":1,"episodeNumbers":[3]}],"link":"98164","synopsis":"When Laharl demands a place to spend the night in the middle of the desert, he, Flonne, and Etna are guided by the Prinnies to the Netherworld Hall of Treasures. But when Vulcanus causes Flonne and Etna to switch personalities, chaos and hilarity ensue.","thumbnail":"https://artworks.thetvdb.com/banners/episodes/80206/329967.jpg"},{"title":"Episodio 4","episodeNumber":4,"sourceEpisodeNumber":4,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"3444","scope":"R","episodeNumbers":[4]},{"provider":"anilist","id":"860","episodeNumbers":[4]},{"provider":"mal","id":"860","episodeNumbers":[4]},{"provider":"tmdb_show","id":"35897","scope":"s1","seasonNumber":1,"episodeNumbers":[4]},{"provider":"tvdb_show","id":"80206","scope":"s1","seasonNumber":1,"episodeNumbers":[4]}],"link":"98165","synopsis":"When the Prinnies go on strike, Laharl begins pillaging local castles in an attempt to get them some money. However, when his father's old butler, Zenisuky, poses as the Overlord and abuses his power to tax everyone, his son, Koganesky, hires Laharl to kill his father. Will Laharl kill Zenisuky, or will Koganesky have a change of heart?","thumbnail":"https://artworks.thetvdb.com/banners/episodes/80206/329968.jpg"},{"title":"Episodio 5","episodeNumber":5,"sourceEpisodeNumber":5,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"3444","scope":"R","episodeNumbers":[5]},{"provider":"anilist","id":"860","episodeNumbers":[5]},{"provider":"mal","id":"860","episodeNumbers":[5]},{"provider":"tmdb_show","id":"35897","scope":"s1","seasonNumber":1,"episodeNumbers":[5]},{"provider":"tvdb_show","id":"80206","scope":"s1","seasonNumber":1,"episodeNumbers":[5]}],"link":"98166","synopsis":"Laharl and Etna stop at mansion after getting lost in a forest, except for Flonne, whom was ditched in the desert, where they encounter a woman named Sardia. Sardia offers food and hospitality to the two, but when she attacks them at dinner, it becomes apparent that she's an assassin after his life. Can Laharl defeat an assassin that has slain over 2,000 demons? Maybe... Maybe not!","thumbnail":"https://artworks.thetvdb.com/banners/episodes/80206/329969.jpg"},{"title":"Episodio 6","episodeNumber":6,"sourceEpisodeNumber":6,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"3444","scope":"R","episodeNumbers":[6]},{"provider":"anilist","id":"860","episodeNumbers":[6]},{"provider":"mal","id":"860","episodeNumbers":[6]},{"provider":"tmdb_show","id":"35897","scope":"s1","seasonNumber":1,"episodeNumbers":[6]},{"provider":"tvdb_show","id":"80206","scope":"s1","seasonNumber":1,"episodeNumbers":[6]}],"link":"98167","synopsis":"Laharl, Flonne, and Etna arrive at the castle of Maderas, the demon who placed the bounty on Laharl's head. However, after he reveals that Etna is the one who poisoned him and tried to kill him, Laharl and Flonne become trapped in a board game full of embarrassing traps. When Maderas goes back on his promise to restore Etna's memories, Etna becomes to determined to find them for herself, but what about Laharl and Flonne?","thumbnail":"https://artworks.thetvdb.com/banners/episodes/80206/329970.jpg"},{"title":"Episodio 7","episodeNumber":7,"sourceEpisodeNumber":7,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"3444","scope":"R","episodeNumbers":[7]},{"provider":"anilist","id":"860","episodeNumbers":[7]},{"provider":"mal","id":"860","episodeNumbers":[7]},{"provider":"tmdb_show","id":"35897","scope":"s1","seasonNumber":1,"episodeNumbers":[7]},{"provider":"tvdb_show","id":"80206","scope":"s1","seasonNumber":1,"episodeNumbers":[7]}],"link":"98168","synopsis":"Now free of assassins, Laharl, Flonne, and Etna stop for lunch at a saloon. The trio soon meets up with a strange girl named Maharl claiming to be Laharl's sister, but Laharl questions her relation to him. Could this strange girl really be Laharl's younger sister?","thumbnail":"https://artworks.thetvdb.com/banners/episodes/80206/329971.jpg"},{"title":"Episodio 8","episodeNumber":8,"sourceEpisodeNumber":8,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"3444","scope":"R","episodeNumbers":[8]},{"provider":"anilist","id":"860","episodeNumbers":[8]},{"provider":"mal","id":"860","episodeNumbers":[8]},{"provider":"tmdb_show","id":"35897","scope":"s1","seasonNumber":1,"episodeNumbers":[8]},{"provider":"tvdb_show","id":"80206","scope":"s1","seasonNumber":1,"episodeNumbers":[8]}],"link":"98169","synopsis":"All the Prinnies suddenly vanish, and without anyone to do his chores, Laharl becomes bent on finding them. He, Flonne, and Etna manage to locate them and uncover a plot to take over the Netherworld. Will Laharl thwart their plans? And who is this strange pink Prinny that has appeared before the group?","thumbnail":"https://artworks.thetvdb.com/banners/episodes/80206/329972.jpg"},{"title":"Episodio 9","episodeNumber":9,"sourceEpisodeNumber":9,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"3444","scope":"R","episodeNumbers":[9]},{"provider":"anilist","id":"860","episodeNumbers":[9]},{"provider":"mal","id":"860","episodeNumbers":[9]},{"provider":"tmdb_show","id":"35897","scope":"s1","seasonNumber":1,"episodeNumbers":[9]},{"provider":"tvdb_show","id":"80206","scope":"s1","seasonNumber":1,"episodeNumbers":[9]}],"link":"98170","synopsis":"Their spaceship finally repaired, the Earth Defense Force challenges Laharl to rematch. Laharl accepts Gordon's challenge on the condition that he takes him to his castle. As Laharl prepares to begin his newfound Overlord rule, the Netherworld is invaded by Earth without Gordon's prior knowledge. Will Laharl be able to stop this invasion?","thumbnail":"https://artworks.thetvdb.com/banners/episodes/80206/329973.jpg"},{"title":"Episodio 10","episodeNumber":10,"sourceEpisodeNumber":10,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"3444","scope":"R","episodeNumbers":[10]},{"provider":"anilist","id":"860","episodeNumbers":[10]},{"provider":"mal","id":"860","episodeNumbers":[10]},{"provider":"tmdb_show","id":"35897","scope":"s1","seasonNumber":1,"episodeNumbers":[10]},{"provider":"tvdb_show","id":"80206","scope":"s1","seasonNumber":1,"episodeNumbers":[10]}],"link":"98171","synopsis":"Laharl and Gordon team up to rescue Jennifer, Etna, and Flonne from the Earth Defense Force, but Kurtis refuses to allow Gordon to do such a thing. After defeating him, Gordon proceeds to where Jennifer and her father are, and discovers that Jennifer had been \"modified\". To make matters worse, a bomb is set to destroy everyone on-board the ship. Is there any way to save the girls and make it off the ship in time?","thumbnail":"https://artworks.thetvdb.com/banners/episodes/80206/329974.jpg"},{"title":"Episodio 11","episodeNumber":11,"sourceEpisodeNumber":11,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"3444","scope":"R","episodeNumbers":[11]},{"provider":"anilist","id":"860","episodeNumbers":[11]},{"provider":"mal","id":"860","episodeNumbers":[11]},{"provider":"tmdb_show","id":"35897","scope":"s1","seasonNumber":1,"episodeNumbers":[11]},{"provider":"tvdb_show","id":"80206","scope":"s1","seasonNumber":1,"episodeNumbers":[11]}],"link":"98172","synopsis":"On their way to Celestia, Laharl, Flonne, and Etna find themselves in a ice-filled land lit up by a red moon. When the Prinnies starts acting strange, the reason behind Laharl's hatred for love is finally revealed. And who is Big Sis Prinny?","thumbnail":"https://artworks.thetvdb.com/banners/episodes/80206/329975.jpg"},{"title":"Episodio 12","episodeNumber":12,"sourceEpisodeNumber":12,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"3444","scope":"R","episodeNumbers":[12]},{"provider":"anilist","id":"860","episodeNumbers":[12]},{"provider":"mal","id":"860","episodeNumbers":[12]},{"provider":"tmdb_show","id":"35897","scope":"s1","seasonNumber":1,"episodeNumbers":[12]},{"provider":"tvdb_show","id":"80206","scope":"s1","seasonNumber":1,"episodeNumbers":[12]}],"link":"98173","synopsis":"Having finally arrived in Celestia, our heroes discover that Vulcanus was responsible for the attack on the Netherworld. Upon meeting with Seraph Lammington, the trio learns why Flonne was sent to kill Laharl's father and wake Laharl. However, despite the Seraph's kindness, Flonne is still punished for her sins of hurting Angelic Soldiers. In order to save her life, Laharl performs an act of love so amazing that it is viewed by not only all of Celestia, but Earth and the Netherworld as well!","thumbnail":"https://artworks.thetvdb.com/banners/episodes/80206/329976.jpg"}],"sourceIds":{"anilistId":860,"malId":860},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-28T07:48:11Z","sourceDescriptors":["anilist:860","mal:860"],"imdbSource":"plexanibridge-v2","targets":[{"provider":"anidb","id":"3444","scope":"R","ranges":{"1-12":"1-12"}},{"provider":"anilist","id":"860","ranges":{"1-12":"1-12"}},{"provider":"mal","id":"860","ranges":{"1-12":"1-12"}},{"provider":"tmdb_show","id":"35897","scope":"s1","ranges":{"1-12":"1-12"}},{"provider":"tvdb_show","id":"80206","scope":"s1","ranges":{"1-12":"1-12"}}]