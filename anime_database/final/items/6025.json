jpg"},{"source":"anilist","url":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/large/nx2602-CTeDdPqUCQyQ.jpg"}],"background":[{"source":"tmdb","url":"https://image.tmdb.org/t/p/original/7KEpk8FG2FkDruOs1VHeGKxN1ub.jpg"},{"source":"cinemeta","url":"https://live.metahub.space/background/medium/tt1190620/img"},{"source":"anizip","url":"https://artworks.thetvdb.com/banners/fanart/original/82168-6.jpg"}]}},"related":[],"linkList":[{"title":"Episodes 1-13","titleKey":"Episodes {{start}}-{{end}}","titleParams":{"start":1,"end":13},"availabilityStatus":"available","episodesLink":"6025|1|13"}]},"episodes":[{"title":"Episodio 1","episodeNumber":1,"sourceEpisodeNumber":1,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"5147","scope":"R","episodeNumbers":[1]},{"provider":"anilist","id":"2602","episodeNumbers":[1]},{"provider":"mal","id":"2602","episodeNumbers":[1]},{"provider":"tmdb_show","id":"79041","scope":"s1","seasonNumber":1,"episodeNumbers":[1]},{"provider":"tvdb_show","id":"82168","scope":"s1","seasonNumber":1,"episodeNumbers":[1]}],"link":"89492","synopsis":"This introduces the characters and the setting. On the beach, Momoko Orizuka and Kaname Okiura are relaxing when a houseboat comes in. On that houseboat is Amuro Ninagawa. She is holding a three-foot long shark in her hand. She comes in and offers the shark to Momoko. Momoko refuses, saying she doesn't like a dead shark. Amuro says the shark is still alive. It then springs to life in Amuro's hand and tries to bite Momoko, but ends up tearing Momoko's bikini top off.","thumbnail":"https://image.tmdb.org/t/p/w300/ye9xL4LcfxIqSOw98NwLjHDGh4f.jpg"},{"title":"Episodio 2","episodeNumber":2,"sourceEpisodeNumber":2,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"5147","scope":"R","episodeNumbers":[2]},{"provider":"anilist","id":"2602","episodeNumbers":[2]},{"provider":"mal","id":"2602","episodeNumbers":[2]},{"provider":"tmdb_show","id":"79041","scope":"s1","seasonNumber":1,"episodeNumbers":[2]},{"provider":"tvdb_show","id":"82168","scope":"s1","seasonNumber":1,"episodeNumbers":[2]}],"link":"89493","synopsis":"Amuro is introduced to the swim team. Captain welcomes the newcomer by throwing a shaving party. Swim practice is show to be, at best, unproductive. On the way home that day, Amuro discovers a new local celebrity by accident.","thumbnail":"https://image.tmdb.org/t/p/w300/dex4yrjaGsyFAsyzNAp2FaO8K2i.jpg"},{"title":"Episodio 3","episodeNumber":3,"sourceEpisodeNumber":3,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"5147","scope":"R","episodeNumbers":[3]},{"provider":"anilist","id":"2602","episodeNumbers":[3]},{"provider":"mal","id":"2602","episodeNumbers":[3]},{"provider":"tmdb_show","id":"79041","scope":"s1","seasonNumber":1,"episodeNumbers":[3]},{"provider":"tvdb_show","id":"82168","scope":"s1","seasonNumber":1,"episodeNumbers":[3]}],"link":"89495","synopsis":"The team attends the local swim competition and ends up in last place. The team captain can't concentrate on the swim meet that they're at because his father's restaurant is in financial trouble. To help his family out, Amuro and the other swim team girls spend a few days serving customers wearing only aprons and swimsuits. Naturally, this attracts a lot of men.","thumbnail":"https://image.tmdb.org/t/p/w300/daDR14cXuLQ7Gjc751G4xKeaTt9.jpg"},{"title":"Episodio 4","episodeNumber":4,"sourceEpisodeNumber":4,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"5147","scope":"R","episodeNumbers":[4]},{"provider":"anilist","id":"2602","episodeNumbers":[4]},{"provider":"mal","id":"2602","episodeNumbers":[4]},{"provider":"tmdb_show","id":"79041","scope":"s1","seasonNumber":1,"episodeNumbers":[4]},{"provider":"tvdb_show","id":"82168","scope":"s1","seasonNumber":1,"episodeNumbers":[4]}],"link":"89494","synopsis":"After the team's poor showing at the Tri-Meet, vice-captain Orizuka decides that what the team needs to succeed is teamwork, and a training camp is just the thing. Typically, the training itself starts out like just another practice with much goofing-off and little actual practice.","thumbnail":"https://image.tmdb.org/t/p/w300/4K0JOwniLh2cee2aXityM7TlcOg.jpg"},{"title":"Episodio 5","episodeNumber":5,"sourceEpisodeNumber":5,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"5147","scope":"R","episodeNumbers":[5]},{"provider":"anilist","id":"2602","episodeNumbers":[5]},{"provider":"mal","id":"2602","episodeNumbers":[5]},{"provider":"tmdb_show","id":"79041","scope":"s1","seasonNumber":1,"episodeNumbers":[5]},{"provider":"tvdb_show","id":"82168","scope":"s1","seasonNumber":1,"episodeNumbers":[5]}],"link":"89496","synopsis":"With their houseraft wrecked by the storm, Amuro and her father are invited by Kaname's parents to stay at their house until repairs can be made. While initially interested in having a girl living at his place, Kaname soon becomes infuriated at Amuro's lack of understanding about privacy and her total lack of modesty.","thumbnail":"https://image.tmdb.org/t/p/w300/pJRequCZdT5BUsvUgQBUHntYBEY.jpg"},{"title":"Episodio 6","episodeNumber":6,"sourceEpisodeNumber":6,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"5147","scope":"R","episodeNumbers":[6]},{"provider":"anilist","id":"2602","episodeNumbers":[6]},{"provider":"mal","id":"2602","episodeNumbers":[6]},{"provider":"tmdb_show","id":"79041","scope":"s1","seasonNumber":1,"episodeNumbers":[6]},{"provider":"tvdb_show","id":"82168","scope":"s1","seasonNumber":1,"episodeNumbers":[6]}],"link":"89497","synopsis":"The Ninogawa houseraft reconstruction is proceeding smoothly. On the way to school, Amuro meets Maaya Nanako, a model and competitive swimmer. They are soon surrounded by a crowd which includes Kaname, who apparently was childhood friends with Maaya. She has transferred to Umishou and will be on the swim team.","thumbnail":"https://image.tmdb.org/t/p/w300/obCVFquyZTMywJYbF39hAvo6iqt.jpg"},{"title":"Episodio 7","episodeNumber":7,"sourceEpisodeNumber":7,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"5147","scope":"R","episodeNumbers":[7]},{"provider":"anilist","id":"2602","episodeNumbers":[7]},{"provider":"mal","id":"2602","episodeNumbers":[7]},{"provider":"tmdb_show","id":"79041","scope":"s1","seasonNumber":1,"episodeNumbers":[7]},{"provider":"tvdb_show","id":"82168","scope":"s1","seasonNumber":1,"episodeNumbers":[7]}],"link":"89499","synopsis":"There's only one week left until the Prefectural swim tournament. But there's a problem; Amuro has lost one of the \"X\"s she wears on her head. Given to her by her grandmother, Amuro was warned that she was to wear them all the time and Amuro would be cursed if they were lost.","thumbnail":"https://image.tmdb.org/t/p/w300/pOtuGyLeleO4a6BNelnKtosplh3.jpg"},{"title":"Episodio 8","episodeNumber":8,"sourceEpisodeNumber":8,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"5147","scope":"R","episodeNumbers":[8]},{"provider":"anilist","id":"2602","episodeNumbers":[8]},{"provider":"mal","id":"2602","episodeNumbers":[8]},{"provider":"tmdb_show","id":"79041","scope":"s1","seasonNumber":1,"episodeNumbers":[8]},{"provider":"tvdb_show","id":"82168","scope":"s1","seasonNumber":1,"episodeNumbers":[8]}],"link":"89498","synopsis":"The Prefectural tournament is the next day. Orizuka orders the team to have a good rest in preparation, and the team breaks for the day. On the day of the tournament, Orizuka is challenged by her old rival Nanjou Karena from Shinomiya University High School who has bested Orizuka at all their previous meetings.","thumbnail":"https://image.tmdb.org/t/p/w300/ei4TPHLOThEpSutTeKxFDYAVONg.jpg"},{"title":"Episodio 9","episodeNumber":9,"sourceEpisodeNumber":9,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"5147","scope":"R","episodeNumbers":[9]},{"provider":"anilist","id":"2602","episodeNumbers":[9]},{"provider":"mal","id":"2602","episodeNumbers":[9]},{"provider":"tmdb_show","id":"79041","scope":"s1","seasonNumber":1,"episodeNumbers":[9]},{"provider":"tvdb_show","id":"82168","scope":"s1","seasonNumber":1,"episodeNumbers":[9]}],"link":"89501","synopsis":"The Umishou team had a good showing at the Prefectural tournament, with seven swimmers progressing to the Kantou tournament. However, Orizuka is forced to go to the student council to have the swim team's budget increased for the trip.","thumbnail":"https://image.tmdb.org/t/p/w300/3wGHNZTyvmIAvJbIWpQ2LOck1OC.jpg"},{"title":"Episodio 10","episodeNumber":10,"sourceEpisodeNumber":10,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"5147","scope":"R","episodeNumbers":[10]},{"provider":"anilist","id":"2602","episodeNumbers":[10]},{"provider":"mal","id":"2602","episodeNumbers":[10]},{"provider":"tmdb_show","id":"79041","scope":"s1","seasonNumber":1,"episodeNumbers":[10]},{"provider":"tvdb_show","id":"82168","scope":"s1","seasonNumber":1,"episodeNumbers":[10]}],"link":"89500","synopsis":"It's the summer festival and the team is there. Maki Ikuta and Maaya Nanako are in the women's room. Maki tells Maaya that she heard that massaging the breast will make it grow. Mutual groping ensues.","thumbnail":"https://image.tmdb.org/t/p/w300/mUsDDrudV4poooifDljiT46KSbA.jpg"},{"title":"Episodio 11","episodeNumber":11,"sourceEpisodeNumber":11,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"5147","scope":"R","episodeNumbers":[11]},{"provider":"anilist","id":"2602","episodeNumbers":[11]},{"provider":"mal","id":"2602","episodeNumbers":[11]},{"provider":"tmdb_show","id":"79041","scope":"s1","seasonNumber":1,"episodeNumbers":[11]},{"provider":"tvdb_show","id":"82168","scope":"s1","seasonNumber":1,"episodeNumbers":[11]}],"link":"89502","synopsis":"It's a week to the Kantou tournament. Maaya gives the team an idea: if they win, Kaname is to do anything the swimmers tell him to do because, after all, \"managers have it easy\". While initially reluctant, Kaname eventually agrees as it will help with team morale.","thumbnail":"https://image.tmdb.org/t/p/w300/w15xptbK4JWeELgPEgHDztX9LtZ.jpg"},{"title":"Episodio 12","episodeNumber":12,"sourceEpisodeNumber":12,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"5147","scope":"R","episodeNumbers":[12]},{"provider":"anilist","id":"2602","episodeNumbers":[12]},{"provider":"mal","id":"2602","episodeNumbers":[12]},{"provider":"tmdb_show","id":"79041","scope":"s1","seasonNumber":1,"episodeNumbers":[12]},{"provider":"tvdb_show","id":"82168","scope":"s1","seasonNumber":1,"episodeNumbers":[12]}],"link":"89503","synopsis":"It's the Kantou prefecture swimming tournament, and the Umisho swim club is there. After doing poorly in the preliminaries due to a bet, the girl's team pours things on in the middle. In the relay race, the team discovers another team is cheating when they use a song to help the swimmer along.","thumbnail":"https://image.tmdb.org/t/p/w300/qltkxjhRb5wcVpQhPNmmSJabOpI.jpg"},{"title":"Episodio 13","episodeNumber":13,"sourceEpisodeNumber":13,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"5147","scope":"R","episodeNumbers":[13]},{"provider":"anilist","id":"2602","episodeNumbers":[13]},{"provider":"mal","id":"2602","episodeNumbers":[13]},{"provider":"tmdb_show","id":"79041","scope":"s1","seasonNumber":1,"episodeNumbers":[13]},{"provider":"tvdb_show","id":"82168","scope":"s1","seasonNumber":1,"episodeNumbers":[13]}],"link":"89504","synopsis":"Amuro gets chosen to replace Momoko in the relay squad. Masa attempts to replace Momoko by dressing in drag, but the team tells him no. The rest of the races are run.","thumbnail":"https://image.tmdb.org/t/p/w300/nlcYlCcZGxwm9Xo92VDH2qDigAe.jpg"}],"sourceIds":{"anilistId":2602,"malId":2602},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-29T07:54:59Z","sourceDescriptors":["anilist:2602","mal:2602"],"imdbSource":"plexanibridge-v2","targets":[{"provider":"anidb","id":"5147","scope":"R","ranges":{"1-13":"1-13"}},{"provider":"anilist",