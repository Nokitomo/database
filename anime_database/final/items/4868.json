O.jpg"}]}],"linkList":[{"title":"Episodes 1-12","titleKey":"Episodes {{start}}-{{end}}","titleParams":{"start":1,"end":12},"availabilityStatus":"available","episodesLink":"4868|1|12"}]},"episodes":[{"title":"La mia vita nell'altro mondo è turbolenta","episodeNumber":1,"sourceEpisodeNumber":1,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"17766","scope":"R","episodeNumbers":[1]},{"provider":"anilist","id":"158704","episodeNumbers":[1]},{"provider":"mal","id":"53833","episodeNumbers":[1]},{"provider":"tmdb_show","id":"216269","scope":"s1","seasonNumber":1,"episodeNumbers":[1]},{"provider":"tvdb_show","id":"428350","scope":"s1","seasonNumber":1,"episodeNumbers":[1]}],"link":"74048","synopsis":"La dipendente oberata di lavoro Oohashi Rei si ritrova improvvisamente nel mondo del suo gioco otome preferito nei panni della protagonista, Rae Taylor. Ma non è qui per innamorarsi dei protagonisti maschili del gioco: è innamorata dellla cattiva!","thumbnail":"https://image.tmdb.org/t/p/w300/7WP8CbkK5344IpUYc37wtfMcGos.jpg"},{"title":"Il lavoro di cameriera è un servizio d'amore","episodeNumber":2,"sourceEpisodeNumber":2,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"17766","scope":"R","episodeNumbers":[2]},{"provider":"anilist","id":"158704","episodeNumbers":[2]},{"provider":"mal","id":"53833","episodeNumbers":[2]},{"provider":"tmdb_show","id":"216269","scope":"s1","seasonNumber":1,"episodeNumbers":[2]},{"provider":"tvdb_show","id":"428350","scope":"s1","seasonNumber":1,"episodeNumbers":[2]}],"link":"74219","synopsis":"Rae punta sul lavoro dei suoi sogni,  ovvero entrare a far parte della servitù di Claire, e farà di tutto per ottenerlo.","thumbnail":"https://image.tmdb.org/t/p/w300/eqqih7kZ9EUEEGTjSeUYGyuDiWn.jpg"},{"title":"Il mio amore si rialza dopo ogni batosta","episodeNumber":3,"sourceEpisodeNumber":3,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"17766","scope":"R","episodeNumbers":[3]},{"provider":"anilist","id":"158704","episodeNumbers":[3]},{"provider":"mal","id":"53833","episodeNumbers":[3]},{"provider":"tmdb_show","id":"216269","scope":"s1","seasonNumber":1,"episodeNumbers":[3]},{"provider":"tvdb_show","id":"428350","scope":"s1","seasonNumber":1,"episodeNumbers":[3]}],"link":"74359","synopsis":"Rendendosi conto che Claire è innamorata di Thane, Rae  conoscendo gli eventi del gioco, cerca di far unire Thane e Claire, nonostante i suoi sentimenti per Claire.","thumbnail":"https://image.tmdb.org/t/p/w300/5LqVplYNaXrLq0dyarR4jue7Hoj.jpg"},{"title":"Non essere pronti a un attacco dei mostri può rivelarsi fatale","episodeNumber":4,"sourceEpisodeNumber":4,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"17766","scope":"R","episodeNumbers":[4]},{"provider":"anilist","id":"158704","episodeNumbers":[4]},{"provider":"mal","id":"53833","episodeNumbers":[4]},{"provider":"tmdb_show","id":"216269","scope":"s1","seasonNumber":1,"episodeNumbers":[4]},{"provider":"tvdb_show","id":"428350","scope":"s1","seasonNumber":1,"episodeNumbers":[4]}],"link":"74462","synopsis":"Rae impressiona la sua insegnante e i suoi compagni di classe all'accademia con la sua competenza nella magia... ed è presto costretta a mettere in pratica le sue abilità quando un enorme mostro attacca.","thumbnail":"https://image.tmdb.org/t/p/w300/5fHQgRzNfIpKvCOeIZGLlFsmu3x.jpg"},{"title":"L'esame dell'Ordine è una tragicommedia","episodeNumber":5,"sourceEpisodeNumber":5,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"17766","scope":"R","episodeNumbers":[5]},{"provider":"anilist","id":"158704","episodeNumbers":[5]},{"provider":"mal","id":"53833","episodeNumbers":[5]},{"provider":"tmdb_show","id":"216269","scope":"s1","seasonNumber":1,"episodeNumbers":[5]},{"provider":"tvdb_show","id":"428350","scope":"s1","seasonNumber":1,"episodeNumbers":[5]}],"link":"74566","synopsis":"Rae e Claire superano entrambi l'esame scritto per l'ingresso nell'Academia dei Cavalieri. Il passo successivo è l'esame pratico, che mette gli esaminandi l'uno contro l'altro in finte battaglie per determinare chi è veramente degno di unirsi ai Cavalieri.","thumbnail":"https://image.tmdb.org/t/p/w300/504IkH4SCkvWP26LrUzyOAjVzfZ.jpg"},{"title":"La ragione segreta deve restare segretissima","episodeNumber":6,"sourceEpisodeNumber":6,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"17766","scope":"R","episodeNumbers":[6]},{"provider":"anilist","id":"158704","episodeNumbers":[6]},{"provider":"mal","id":"53833","episodeNumbers":[6]},{"provider":"tmdb_show","id":"216269","scope":"s1","seasonNumber":1,"episodeNumbers":[6]},{"provider":"tvdb_show","id":"428350","scope":"s1","seasonNumber":1,"episodeNumbers":[6]}],"link":"74690","synopsis":"Si avvicina la Fiera del Giorno della Fondazione e i Cavalieri dell'Accademia discutono sul tipo di negozio che dovrebbero aprire. Un commento disinvolto di Rae porta alla proposta di un cafè bar a ruoli invertiti.","thumbnail":"https://image.tmdb.org/t/p/w300/te0Rt3106tmzZNLqv7uBGlsYubv.jpg"},{"title":"L'asso nella manica per il festival è il café a ruoli invertiti","episodeNumber":7,"sourceEpisodeNumber":7,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"17766","scope":"R","episodeNumbers":[7]},{"provider":"anilist","id":"158704","episodeNumbers":[7]},{"provider":"mal","id":"53833","episodeNumbers":[7]},{"provider":"tmdb_show","id":"216269","scope":"s1","seasonNumber":1,"episodeNumbers":[7]},{"provider":"tvdb_show","id":"428350","scope":"s1","seasonNumber":1,"episodeNumbers":[7]}],"link":"74910","synopsis":"Rae sfrutta al massimo la Fiera del Giorno della Fondazione, lavorando sodo al bar cfé dei ruoli invertiti e convincendo persino Claire a fare un giro per la fiera con lei. Ma un incidente con un gruppo di popolani amareggiati getta un'ombra sul clima di festa.","thumbnail":"https://image.tmdb.org/t/p/w300/hY8LBzapQWDvdYnmi9HLhNsAqqP.jpg"},{"title":"Le impetuose correnti sono una trappola machiavellica","episodeNumber":8,"sourceEpisodeNumber":8,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"17766","scope":"R","episodeNumbers":[8]},{"provider":"anilist","id":"158704","episodeNumbers":[8]},{"provider":"mal","id":"53833","episodeNumbers":[8]},{"provider":"tmdb_show","id":"216269","scope":"s1","seasonNumber":1,"episodeNumbers":[8]},{"provider":"tvdb_show","id":"428350","scope":"s1","seasonNumber":1,"episodeNumbers":[8]}],"link":"75113","synopsis":"L'Accademia Reale è scossa dallo scandalo quando uno studente nobile presumibilmente attacca uno studente plebeo con la magia. La situazione peggiora quando l'aggressore riceve una punizione minima, spingendo i cittadini comuni a protestare così violentemente che la scuola deve essere chiusa.","thumbnail":"https://image.tmdb.org/t/p/w300/w4qRrwauf8cMjnYVI34sPTNZq1.jpg"},{"title":"La mia fedeltà è eterna e infinita","episodeNumber":9,"sourceEpisodeNumber":9,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"17766","scope":"R","episodeNumbers":[9]},{"provider":"anilist","id":"158704","episodeNumbers":[9]},{"provider":"mal","id":"53833","episodeNumbers":[9]},{"provider":"tmdb_show","id":"216269","scope":"s1","seasonNumber":1,"episodeNumbers":[9]},{"provider":"tvdb_show","id":"428350","scope":"s1","seasonNumber":1,"episodeNumbers":[9]}],"link":"75288","synopsis":"Quando dietro la rivolta popolare viene svelato un complotto oscuro, l'accademia si trova in pericolo. Riusciranno Rae e Claire a sconfiggere i cospiratori e ad affrontare le conseguenze che ne derivano?","thumbnail":"https://image.tmdb.org/t/p/w300/j72Sc1jlRRRJhZ7ssfSLi6W7bRc.jpg"},{"title":"La mia nuova rivale in amore è semplicemente troppo perfetta","episodeNumber":10,"sourceEpisodeNumber":10,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"17766","scope":"R","episodeNumbers":[10]},{"provider":"anilist","id":"158704","episodeNumbers":[10]},{"provider":"mal","id":"53833","episodeNumbers":[10]},{"provider":"tmdb_show","id":"216269","scope":"s1","seasonNumber":1,"episodeNumbers":[10]},{"provider":"tvdb_show","id":"428350","scope":"s1","seasonNumber":1,"episodeNumbers":[10]}],"link":"75588","synopsis":"La Principessa Manaria del Regno di Sousse, una vecchia amica d'infanzia di Claire, si presenta a farle visita. Manaria ha tutto: bell'aspetto, carisma, straordinaria abilità magica e, per finire, Claire è piuttosto presa da lei. Sembra che Rae abbia un nuovo rivale.","thumbnail":"https://image.tmdb.org/t/p/w300/i70E4enuYS10j6GNLLTihrbdyi0.jpg"},{"title":"Una disputa amorosa è una trappola senza uscita","episodeNumber":11,"sourceEpisodeNumber":11,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"17766","scope":"R","episodeNumbers":[11]},{"provider":"anilist","id":"158704","episodeNumbers":[11]},{"provider":"mal","id":"53833","episodeNumbers":[11]},{"provider":"tmdb_show","id":"216269","scope":"s1","seasonNumber":1,"episodeNumbers":[11]},{"provider":"tvdb_show","id":"428350","scope":"s1","seasonNumber":1,"episodeNumbers":[11]}],"link":"75743","synopsis":"Rae insiste che vuole solo che Claire sia felice, anche se non può stare con lei. Manaria le dice che sta semplicemente scappando, e se i suoi sentimenti per Claire sono veri, combatterà per lei. Inizia così il loro duello per determinare chi resterà al fianco di Claire.","thumbnail":"https://image.tmdb.org/t/p/w300/tFCjastvaFbypsmkaaDedU3GfF.jpg"},{"title":"Io e il mio personaggio preferito ci amiamo","episodeNumber":12,"sourceEpisodeNumber":12,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"17766","scope":"R","episodeNumbers":[12]},{"provider":"anilist","id":"158704","episodeNumbers":[12]},{"provider":"mal","id":"53833","episodeNumbers":[12]},{"provider":"tmdb_show","id":"216269","scope":"s1","seasonNumber":1,"episodeNumbers":[12]},{"provider":"tvdb_show","id":"428350","scope":"s1","seasonNumber":1,"episodeNumbers":[12]}],"link":"75945","synopsis":"Manaria challenges Rae to prove her feelings for Claire at the Amour Ceremony. Both Rae and Manaria