":"s1","seasonNumber":1,"episodeNumbers":[9]},{"provider":"tvdb_show","id":"467414","scope":"s1","seasonNumber":1,"episodeNumbers":[9]}],"link":"107911","synopsis":"Juzo races to Noren's side. Meanwhile, Tenma and Eiji clash in an outrageous soccer-vs.-explosive-golf battle. Tenma prepares to end the fight with a move he developed in practice. But at the end of the life-or-death struggle against Kazuma and Eiji, the unconscious Noren awakens, and the first thing she sees is...","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/11704245/screencap/6a22c4783d622.jpg"},{"title":"Death or Kiss","episodeNumber":10,"sourceEpisodeNumber":10,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"19546","scope":"R","episodeNumbers":[10]},{"provider":"anilist","id":"198113","episodeNumbers":[10]},{"provider":"mal","id":"62391","episodeNumbers":[10]},{"provider":"tmdb_show","id":"300131","scope":"s1","seasonNumber":1,"episodeNumbers":[10]},{"provider":"tvdb_show","id":"467414","scope":"s1","seasonNumber":1,"episodeNumbers":[10]}],"link":"108023","synopsis":"After Kazuma’s hypnosis makes Noren fall deeply for Juzo, she launches an all-out attack on his heart. But when Juzo gently turns her down, she tries to jump from the roof! Desperate to undo the spell, Juzo takes Noren to meet Kazuma at an amusement park, only to end up alone with her on a Ferris wheel, where things take a dangerously romantic turn?!","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/11704246/screencap/6a2c01561259a.jpg"},{"title":"The First Hitman Summit","episodeNumber":11,"sourceEpisodeNumber":11,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"19546","scope":"R","episodeNumbers":[11]},{"provider":"anilist","id":"198113","episodeNumbers":[11]},{"provider":"mal","id":"62391","episodeNumbers":[11]},{"provider":"tmdb_show","id":"300131","scope":"s1","seasonNumber":1,"episodeNumbers":[11]},{"provider":"tvdb_show","id":"467414","scope":"s1","seasonNumber":1,"episodeNumbers":[11]}],"link":"108175","synopsis":"Juzo has been enjoying a peaceful school life, but that ends when Kazuma and Eiji transfer in, bringing the total number of assassins infiltrating his middle school to four. Meanwhile, the Home Ec Club holds a serious ramen-making contest. Paired with Noren, Juzo heads out to research ramen shops and saves a girl from being hit by a truck. But just who is she?","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/11704247/screencap/6a352618a7e0b.jpg"},{"title":"Life Paths","episodeNumber":12,"sourceEpisodeNumber":12,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"19546","scope":"R","episodeNumbers":[12]},{"provider":"anilist","id":"198113","episodeNumbers":[12]},{"provider":"mal","id":"62391","episodeNumbers":[12]},{"provider":"tmdb_show","id":"300131","scope":"s1","seasonNumber":1,"episodeNumbers":[12]},{"provider":"tvdb_show","id":"467414","scope":"s1","seasonNumber":1,"episodeNumbers":[12]}],"link":"108253","synopsis":"Unicorn Mai Otohime is a marine-sports prodigy with expert-level ocean knowledge. She has come for a Mitsuoka Duel too, but her target is Juzo. This leads to Noren challenging Mai herself. As the duel nears, Juzo and the others face parent-teacher conferences and questions about their futures, leading Juzo to reflect on his school life, the friends he’s made, and the possibilities ahead.","thumbnail":"https://artworks.thetvdb.com/banners/v4/episode/11704248/screencap/6a3ec3b394342.jpg"}],"sourceIds":{"anilistId":198113,"malId":62391},"mappings":{"source":"anibridge-v3","schemaVersion":"3.0.3","generatedOn":"2026-10-28T07:48:11Z","sourceDescriptors":["anilist:198113","mal:62391"],"targets":[{"provider":"anidb","id":"19546","scope":"R","ranges":{"1-12":"1-12"}},{"provider":"anilist","id":"198113","ranges":{"1-12":"1-12"}},{"provider":"mal","id":"62391","ranges":{"1-12":"1-12"}},{"provider":"tmdb_show","id":"300131","scope":"s1","ranges":{"1-12":"1-12"}},{"provider":"tvdb_show","id":"46