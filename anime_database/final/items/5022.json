6xdK8UTLVZaDI4vneZSaBaxK.jpg"},{"title":"Appropriate Gear","episodeNumber":7,"sourceEpisodeNumber":7,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"17926","scope":"R","episodeNumbers":[7]},{"provider":"anilist","id":"162985","episodeNumbers":[7]},{"provider":"mal","id":"54794","episodeNumbers":[7]},{"provider":"tmdb_show","id":"222787","scope":"s1","seasonNumber":1,"episodeNumbers":[7]},{"provider":"tvdb_show","id":"432747","scope":"s1","seasonNumber":1,"episodeNumbers":[7]}],"link":"77256","synopsis":"Naomi incontra Gene Junghardt mentre vengono rivelati altri pezzi del puzzle. Nel frattempo, Rouge ha un incontro inaspettato.","thumbnail":"https://image.tmdb.org/t/p/w300/jMYJcK8A5ZbOKQQwUtv9mPBOKx.jpg"},{"title":"Nowhere House","episodeNumber":8,"sourceEpisodeNumber":8,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"17926","scope":"R","episodeNumbers":[8]},{"provider":"anilist","id":"162985","episodeNumbers":[8]},{"provider":"mal","id":"54794","episodeNumbers":[8]},{"provider":"tmdb_show","id":"222787","scope":"s1","seasonNumber":1,"episodeNumbers":[8]},{"provider":"tvdb_show","id":"432747","scope":"s1","seasonNumber":1,"episodeNumbers":[8]}],"link":"77680","synopsis":"Rouge si riunisce con Gene e i due visitano la Biblioteca della memoria del dottor Junghardt. Rouge ripercorre i suoi ricordi per conoscere se stessa, Code Eve e gli obiettivi del dottor Jung.","thumbnail":"https://image.tmdb.org/t/p/w300/s8NOCIGktUwmvauS8WfVYqfHmXn.jpg"},{"title":"The Ones Who Visited","episodeNumber":9,"sourceEpisodeNumber":9,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"17926","scope":"R","episodeNumbers":[9]},{"provider":"anilist","id":"162985","episodeNumbers":[9]},{"provider":"mal","id":"54794","episodeNumbers":[9]},{"provider":"tmdb_show","id":"222787","scope":"s1","seasonNumber":1,"episodeNumbers":[9]},{"provider":"tvdb_show","id":"432747","scope":"s1","seasonNumber":1,"episodeNumbers":[9]}],"link":"77884","synopsis":"Mentre Rouge lotta contro Aerkos, Silvia e Graupon, Eden si presenta per salvarla, ma si scopre che anche lui fa parte dei Nove Immortali. Arrivano una nave usurpatrice e la Cyan e la situazione precipita nel caos. Potrebbe Cyan essere davvero la sorella di Rouge?","thumbnail":"https://image.tmdb.org/t/p/w300/iXyfdED3mnqFqGzJvxzcGG3sNb6.jpg"},{"title":"Family Portrait","episodeNumber":10,"sourceEpisodeNumber":10,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"17926","scope":"R","episodeNumbers":[10]},{"provider":"anilist","id":"162985","episodeNumbers":[10]},{"provider":"mal","id":"54794","episodeNumbers":[10]},{"provider":"tmdb_show","id":"222787","scope":"s1","seasonNumber":1,"episodeNumbers":[10]},{"provider":"tvdb_show","id":"432747","scope":"s1","seasonNumber":1,"episodeNumbers":[10]}],"link":"78057","synopsis":"In viaggio verso Venere, Rouge e Naomi scoprono che Cyan si è nascosto sulla loro nave. È convinta che Rouge sia sua sorella maggiore e insiste per viaggiare con lei, nonostante le proteste di Naomi. Davanti a loro, Gene raggiunge Venere e incontra il Burattinaio.","thumbnail":"https://image.tmdb.org/t/p/w300/utJfwt1ZmAktLa2Y2OQtQBoYNyK.jpg"},{"title":"Target Planet","episodeNumber":11,"sourceEpisodeNumber":11,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"17926","scope":"R","episodeNumbers":[11]},{"provider":"anilist","id":"162985","episodeNumbers":[11]},{"provider":"mal","id":"54794","episodeNumbers":[11]},{"provider":"tmdb_show","id":"222787","scope":"s1","seasonNumber":1,"episodeNumbers":[11]},{"provider":"tvdb_show","id":"432747","scope":"s1","seasonNumber":1,"episodeNumbers":[11]}],"link":"78202","synopsis":"Dopo aver effettuato un atterraggio di emergenza su Venere, il gruppo di Rouge entra nella Cloud Plant per trovare Gene, ma Silvia rileva i loro movimenti. Mentre Gene guarda, il burattinaio inizia a parlare di sua madre, Eva Kristella, e della sua creazione, Code Eve.","thumbnail":"https://image.tmdb.org/t/p/w300/cAdrLS0w