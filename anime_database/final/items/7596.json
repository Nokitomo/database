o stress. Una sera, però, Yamada ha già finito il turno e l'uomo, deluso, si rifugia dietro il negozio per fumare. Lì incontra Tayama: una donna misteriosa, schietta e diretta, molto diversa dalla dolce Yamada... eppure, qualcosa in lei gli sembra stranamente familiare. Tra una sigaretta e l’altra, Sasaki scopre in Tayama una nuova compagna di silenzi e parole non dette. E così, tra i corridoi illuminati del supermercato e l’ombra tranquilla dell’area fumatori, la sua vita inizia lentamente a cambiare...","date":"2026","episodes_count":12,"episodes_length":23,"author":" ","created_at":"2026-07-09 18:47:16","status":"Terminato","imageurl_cover":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/196187-Z9dV6uotmKjM.jpg","type":"TV","slug":"smoking-behind-the-supermarket-with-you","title_eng":"Smoking Behind the Supermarket with You","day":"Giovedì","favorites":465,"score":"8.58","visite":275987,"studio":"Asahi Production","dub":0,"always_home":1,"members":2929,"cover":"https://img.animeworld.ac/copertine/pqae4.png","anilist_id":196187,"season":"Estate","title_it":null,"mal_id":62076,"crunchy_id":"GT00378116","netflix_id":null,"prime_id":null,"disney_id":null,"pivot":{"anime_id":7596,"related_id":7697,"number":2}}]},"archive":null},"sourceEpisodes":[{"id":107925,"anime_id":7596,"user_id":2,"number":"1","created_at":"2026-06-06 21:21:04","link":"Smoking.Behind.the.Supermarket.with.You.S01E01.Mini.episodio.1.1080p.CR.WEB-DL.JPN.AAC2.0.H.264.mkv","visite":88818,"hidden":0,"public":1,"scws_id":740101,"file_name":"Smoking.Behind.the.Supermarket.with.You.S01E01.Mini.episodio.1.1080p.CR.WEB-DL.JPN.AAC2.0.H.264.mkv","tg_post":0},{"id":107926,"anime_id":7596,"user_id":2,"number":"2","created_at":"2026-06-06 21:21:07","link":"Smoking.Behind.the.Supermarket.with.You.S01E02.Mini.episodio.2.1080p.CR.WEB-DL.JPN.AAC2.0.H.264.mkv","visite":25757,"hidden":1,"public":1,"scws_id":740102,"file_name":"Smoking.Behind.the.Supermarket.with.You.S01E02.Mini.episodio.2.1080p.CR.WEB-DL.JPN