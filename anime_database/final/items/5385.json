/i7DJVdYwCgjRi61ecDvwEKJ7hyv.png"},{"source":"cinemeta","url":"https://live.metahub.space/logo/medium/tt30326044/img"}],"poster":[{"source":"tmdb","url":"https://image.tmdb.org/t/p/original/6bQKMlHwRmGnvIRxDahl1r8WJkE.jpg"},{"source":"tvdb","url":"https://artworks.thetvdb.com/banners/v4/series/425244/posters/6aa018107e33d.jpg"},{"source":"provider","url":"https://img.animeunity.co/anime/bx154963-Ju6Ey3P5YHs2.jpg"},{"source":"cinemeta","url":"https://live.metahub.space/poster/small/tt30326044/img"},{"source":"anizip","url":"https://artworks.thetvdb.com/banners/v4/series/425244/posters/6669aaea129c9.jpg"},{"source":"anilist","url":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/large/bx154963-Ju6Ey3P5YHs2.jpg"}],"background":[{"source":"tmdb","url":"https://image.tmdb.org/t/p/original/foprlhdAS9IBy7nIx9YF627Py6Q.jpg"},{"source":"cinemeta","url":"https://live.metahub.space/background/medium/tt30326044/img"},{"source":"tvdb","url":"https://artworks.thetvdb.com/banners/v4/series/425244/backgrounds/6692afafc0467.jpg"},{"source":"anizip","url":"https://artworks.thetvdb.com/banners/v4/series/425244/backgrounds/6691a9bf1ad93.jpg"},{"source":"provider","url":"https://img.animeunity.co/anime/154963-v8wYFPlpdOZm.jpg"},{"source":"anilist","url":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/154963-sDMgZTrrsT70.jpg"}]}},"related":[],"linkList":[{"title":"Episodes 1-13","titleKey":"Episodes {{start}}-{{end}}","titleParams":{"start":1,"end":13},"availabilityStatus":"available","episodesLink":"5385|1|13"}]},"episodes":[{"title":"Episodio 1","episodeNumber":1,"sourceEpisodeNumber":1,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"17635","scope":"R","episodeNumbers":[1]},{"provider":"anilist","id":"154963","episodeNumbers":[1]},{"provider":"mal","id":"53128","episodeNumbers":[1]},{"provider":"tmdb_show","id":"210875","scope":"s1","seasonNumber":1,"episodeNumbers":[1]},{"provider":"tvdb_show","id":"425244","scope":"s1","seasonNumber":1,"episodeNumbers":[1]}],"link":"82601","synopsis":"In the near future, much of the world has been forgotten at the bottom of the ocean due to rising sea levels. Natsuki Ikaruga, who lives in a small town surrounded and stranded by the sea, is invited by a mysterious woman, Catherine, to search for a treasure in his grandmother's house who was a marine geologist. One day, he dives to the bottom of the ocean in a submarine and encounters a mysterious capsule with a girl sleeping inside. The girl was a humanoid so sophisticated that she could be mistaken for a human.","thumbnail":"https://image.tmdb.org/t/p/w300/A07TTBnPSplU2EJjQuU6udfEi0Z.jpg"},{"title":"Episodio 2","episodeNumber":2,"sourceEpisodeNumber":2,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"17635","scope":"R","episodeNumbers":[2]},{"provider":"anilist","id":"154963","episodeNumbers":[2]},{"provider":"mal","id":"53128","episodeNumbers":[2]},{"provider":"tmdb_show","id":"210875","scope":"s1","seasonNumber":1,"episodeNumbers":[2]},{"provider":"tvdb_show","id":"425244","scope":"s1","seasonNumber":1,"episodeNumbers":[2]}],"link":"83129","synopsis":"\"I'll be your leg, Master!\" Atri, who was supposed to be with Cathrine, has come back to Natsuki. Although she was pumped to be of assistance to her new master, she fell into the ocean while carrying him and failed at cooking… It's as if she is a piece of scrap. Atri seems to have received a very important order from Nonko and tries to remember what it is, but...","thumbnail":"https://image.tmdb.org/t/p/w300/uZAfWtDureWk4M6M2Hk2QRisEIv.jpg"},{"title":"Episodio 3","episodeNumber":3,"sourceEpisodeNumber":3,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"17635","scope":"R","episodeNumbers":[3]},{"provider":"anilist","id":"154963","episodeNumbers":[3]},{"provider":"mal","id":"53128","episodeNumbers":[3]},{"provider":"tmdb_show","id":"210875","scope":"s1","seasonNumber":1,"episodeNumbers":[3]},{"provider":"tvdb_show","id":"425244","scope":"s1","seasonNumber":1,"episodeNumbers":[3]}],"link":"83569","synopsis":"Natsuki accompanies Atri who is on her way to school. However, when they arrive, they find that most of the school is underwater. Although they managed to get into the school building, inside it was full of empty classrooms and an unexpected teacher. There, Natsuki is faced with the saddening reality of the lives of the people who remained in their town.","thumbnail":"https://image.tmdb.org/t/p/w300/8ceTO85IvEfaqNvBa1kJ9WzqDob.jpg"},{"title":"Episodio 4","episodeNumber":4,"sourceEpisodeNumber":4,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"17635","scope":"R","episodeNumbers":[4]},{"provider":"anilist","id":"154963","episodeNumbers":[4]},{"provider":"mal","id":"53128","episodeNumbers":[4]},{"provider":"tmdb_show","id":"210875","scope":"s1","seasonNumber":1,"episodeNumbers":[4]},{"provider":"tvdb_show","id":"425244","scope":"s1","seasonNumber":1,"episodeNumbers":[4]}],"link":"83646","synopsis":"Natsuki sets his heart on creating a tidal power generator that utilizes the ebb and flow of the ocean's tides. He dives back into the ocean to find some materials and salvages some resin from the ruins of Ryuuji's family's factory. As soon as he gets back he gets to work. As they are working, Natsuki and Ryuuji exchange heated opinions over how the generator should be built. Atri intervenes and the two guys become closer friends. Meanwhile, a suspicious-looking character peeks at them from outside of the school...","thumbnail":"https://image.tmdb.org/t/p/w300/rCB0VwjDwcKbPKxCu96sPavghcs.jpg"},{"title":"Episodio 5","episodeNumber":5,"sourceEpisodeNumber":5,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"17635","scope":"R","episodeNumbers":[5]},{"provider":"anilist","id":"154963","episodeNumbers":[5]},{"provider":"mal","id":"53128","episodeNumbers":[5]},{"provider":"tmdb_show","id":"210875","scope":"s1","seasonNumber":1,"episodeNumbers":[5]},{"provider":"tvdb_show","id":"425244","scope":"s1","seasonNumber":1,"episodeNumbers":[5]}],"link":"84369","synopsis":"If Natsuki sells Atri, he can get batteries. However, he can no longer think of Atri as just an average humanoid. While he's deep in thought on the dock, looking out at the ocean, Natsuki finds Catherine floating in the water. She is completely intoxicated, and Natsuki and Atri take her in. But right at that time, the sound of a gunshot echoes within the silent ship.","thumbnail":"https://image.tmdb.org/t/p/w300/yp4YyO4Ma6uaYRl304SlFH2wFbq.jpg"},{"title":"Episodio 6","episodeNumber":6,"sourceEpisodeNumber":6,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"17635","scope":"R","episodeNumbers":[6]},{"provider":"anilist","id":"154963","episodeNumbers":[6]},{"provider":"mal","id":"53128","episodeNumbers":[6]},{"provider":"tmdb_show","id":"210875","scope":"s1","seasonNumber":1,"episodeNumbers":[6]},{"provider":"tvdb_show","id":"425244","scope":"s1","seasonNumber":1,"episodeNumbers":[6]}],"link":"84617","synopsis":"Natsuki's life experiences a big shift after becoming a teacher and starting a salvaging service. Rumors of a school lit with electricity attracts new students, and activities around the school regain a sense of liveliness.","thumbnail":"https://image.tmdb.org/t/p/w300/cLOsJcntx1fnDbRXi0JFdKLRlGN.jpg"},{"title":"Episodio 7","episodeNumber":7,"sourceEpisodeNumber":7,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"17635","scope":"R","episodeNumbers":[7]},{"provider":"anilist","id":"154963","episodeNumbers":[7]},{"provider":"mal","id":"53128","episodeNumbers":[7]},{"provider":"tmdb_show","id":"210875","scope":"s1","seasonNumber":1,"episodeNumbers":[7]},{"provider":"tvdb_show","id":"425244","scope":"s1","seasonNumber":1,"episodeNumbers":[7]}],"link":"84742","synopsis":"Was Natsuki's first love, Atri? His beautiful childhood memories are gradually being overwritten. Despite his unwillingness to admit it was her the facts around him are lining up to force him to, but he continues to deny it.","thumbnail":"https://image.tmdb.org/t/p/w300/gIzCZ5MJTFhNYKwhsrmmsrP69xf.jpg"},{"title":"Episodio 8","episodeNumber":8,"sourceEpisodeNumber":8,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"17635","scope":"R","episodeNumbers":[8]},{"provider":"anilist","id":"154963","episodeNumbers":[8]},{"provider":"mal","id":"53128","episodeNumbers":[8]},{"provider":"tmdb_show","id":"210875","scope":"s1","seasonNumber":1,"episodeNumbers":[8]},{"provider":"tvdb_show","id":"425244","scope":"s1","seasonNumber":1,"episodeNumbers":[8]}],"link":"84904","synopsis":"Natsuki has been acting strange and seems to have his head in the clouds through everything he does. After being interrogated by Minamo and the others, he reluctantly confesses to them that he kissed Atri in the ocean.","thumbnail":"https://image.tmdb.org/t/p/w300/6t11yWpRKl8viPlP0gUKjAfhd5N.jpg"},{"title":"Episodio 9","episodeNumber":9,"sourceEpisodeNumber":9,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"17635","scope":"R","episodeNumbers":[9]},{"provider":"anilist","id":"154963","episodeNumbers":[9]},{"provider":"mal","id":"53128","episodeNumbers":[9]},{"provider":"tmdb_show","id":"210875","scope":"s1","seasonNumber":1,"episodeNumbers":[9]},{"provider":"tvdb_show","id":"425244","scope":"s1","seasonNumber":1,"episodeNumbers":[9]}],"link":"85011","synopsis":"Natsuki happens to see Atri's log that was left open. What was written there was an emotionless record of how she carried out her actions to fulfill Natsuki's desires. Natsuki instinctively rejects Atri and is no longer able to trust anything. Meanwhile, a single letter arrives, and inside there is a report describing the truth behind the Humanoid called Atri.","thumbnail":"https://image.tmdb.org/t/p/w300/x600P1bhUxCdv4w7pytoiWw6psU.jpg"},{"title":"Episodio 10","episodeNumber":10,"sourceEpisodeNumber":10,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"17635","scope":"R","episodeNumbers":[10]},{"provider":"anilist","id":"154963","episodeNumbers":[10]},{"provider":"mal","id":"53128","episodeNumbers":[10]},{"provider":"tmdb_show","id":"210875","scope":"s1","seasonNumber":1,"episodeNumbers":[10]},{"provider":"tvdb_show","id":"425244","scope":"s1","seasonNumber":1,"episodeNumbers":[10]}],"link":"85352","synopsis":"When Natsuki comes to the rescue for the now-beaten-up Atri, he becomes the next target of Yasuda’s acts of violence. With the onslaught of consecutive attacks, he finds himself also beaten up, just like Atri. Before Yasuda can inflict any more pain, Atri, unable to tolerate watching any longer, raises her fist against a human once more.","thumbnail":"https://image.tmdb.org/t/p/w300/jVG3inhoHVus3XPGYlvWqVgBbNq.jpg"},{"title":"Episodio 11","episodeNumber":11,"sourceEpisodeNumber":11,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"17635","scope":"R","episodeNumbers":[11]},{"provider":"anilist","id":"154963","episodeNumbers":[11]},{"provider":"mal","id":"53128","episodeNumbers":[11]},{"provider":"tmdb_show","id":"210875","scope":"s1","seasonNumber":1,"episodeNumbers":[11]},{"provider":"tvdb_show","id":"425244","scope":"s1","seasonNumber":1,"episodeNumbers":[11]}],"link":"85764","synopsis":"Natsuki decides to head back to the Academy on the mainland to study humanoids. He decides to leave the salvaging service in Ryuuji's hands, and while he’s tidying up the ship in order to pass it on to him.","thumbnail":"https://image.tmdb.org/t/p/w300/gWX0jenhhSRklbI6cKzScITrsYT.jpg"},{"title":"Episodio 12","episodeNumber":12,"sourceEpisodeNumber":12,"seasonNumber":1,"externalMappings":[{"provider":"anidb","id":"17635","scope":"R","episodeNumbers":[12]},{"provider":"anilist","id":"154963","episodeNumbers":[12]},{"provider":"mal","id":"53128","episodeNumbers":[12]},{"provider":"tmdb_show","id":"210875","scope":"s1","seasonNumber":1,"episodeNumbers":[12]},{"provider":"tvdb_show","id":"425244","scope":"s1","seasonNumber":1,"episodeNumbers":[12]}],"link":"85826","s